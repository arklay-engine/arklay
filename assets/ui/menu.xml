<?xml version="1.0" encoding="utf-8"?>
<!-- The in-game menu. -->
<screen use="standard-screen" title="@menu.title" backdrop="light">
  <list width="560">
    <item variant="menu" text="@menu.restart" action="restart" confirm="@menu.restart_question" note="@menu.unsaved_note"/>
    <item variant="menu" text="@menu.load_game" action="load_game"/>
    <item variant="menu" text="@menu.options" action="open:options"/>
    <item variant="menu" text="@menu.quit" action="quit" confirm="@menu.quit_question" note="@menu.unsaved_note"/>
  </list>
</screen>
