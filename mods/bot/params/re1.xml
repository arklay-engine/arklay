<?xml version="1.0" encoding="UTF-8"?>
<!-- The bot's story parameters for RE1: decisions the game leaves to the
     player, so runs can be steered down each branch of the story.

     Each <param> lists its `values` (separated by `|`) and its `default`,
     the bot's usual choice. The bot-param option (NAME=VALUE) picks another value for
     one run; a room fact in room/<id>/bot.xml with `when="NAME=VALUE"` holds
     only while the parameter has that value (`NAME!=VALUE` and `a|b`
     alternatives work too, and several conditions separated by spaces must
     all hold); Lua reads the value as `bot:param(NAME)`. An undeclared name
     or value is an error, on the command line and in a `when`. -->
<params format="1">
  <!-- 20D: Richard, poisoned by Yawn, waits for the serum from 100. `save`
       brings it within his seven minutes; `leave` never does, so he dies
       and the door to 20E opens once the timer runs out. In Chris's game
       only after rebecca_meet=richard (Richard is found dead otherwise):
       his death arms the upstairs call, and 206's hunter attack (see
       `rebecca`). -->
  <param name="richard" values="save|leave" default="save"
         label="bring poisoned Richard the serum in 20D"/>
  <!-- The guardhouse's Plant 42. `no` takes the bookcase passage in 40A
       to 40C and fights the full plant there. `yes` solves 408's number
       panel (scenario 0x21 opens the door to 409), mixes V-JOLT in 409's
       drug store, pours it on the root in 40F (scenario 0x13) and only then
       opens 40A's bookcase: 40C's init then loads the plant already
       weakened (scenario 0x29) and Barry's rescue is skipped. -->
  <param name="vjolt" values="no|yes" default="no"
         label="make V-JOLT in 409 and pour it on Plant 42's root in 40F"/>
  <!-- 308: Barry's two prompts (room/308/bot.xml). cave_q1 answers "Will
       you go with him?" (message 23); cave_q2 answers the second prompt,
       "Do you want him to go first?" (24) after Yes or "Will you stay
       here?" (25) after No. Yes, Yes and No, No send Barry ahead; Yes, No
       is Barry's branch; No, Yes sends him off alone, and 502 plays "Tell
       my family" (lab). -->
  <param name="cave_q1" values="yes|no" default="yes"
         label="308: go with Barry (message 23)"/>
  <param name="cave_q2" values="yes|no" default="yes"
         label="308: the second prompt (message 24 or 25)"/>
  <!-- 308, after Barry goes ahead (Yes, Yes or No, No): `follow` keeps
       off doors 0 and 2 while he is ahead, so the bot leaves by door 1
       after him, through AOT 3's gunshot (Barry's branch); `backtrack`
       keeps off door 1, so 307 plays "Tell my family" (cave) and Barry is
       gone. No effect after Yes, No or No, Yes, or without 308's scene
       (rope=leave). -->
  <param name="cave_exit" values="follow|backtrack" default="follow"
         label="308: follow Barry through door 1, or backtrack"/>
  <!-- Barry's first meeting after the lockpick. `forest` is the bot's own
       order: 212 early, where Barry stands at Forest's body and gives the
       acid launcher (common 0x0A). `chemical` holds 211's door to 212
       (room/211/bot.xml) until Barry's acid-rounds scene has played: the
       herbicide taken from 118 and 106 or 203 entered again sets common
       0x07, which also blocks the sandwich rescue, 20A's "page missing"
       and 405's family door, and has Barry burn Plant 42 in 40C. -->
  <param name="barry_early" values="forest|chemical" default="forest"
         label="Barry's acid rounds (herbicide first) or Barry at Forest"/>
  <!-- 116/115: `yes` lifts the shotgun from 116's rack without the broken
       one (room/116/bot.xml), so 115's ceiling trap springs on the way
       out, and holds 211's door to 212 until it has (common 0x21): with
       common 0x07 and 0x5F clear, Barry kicks the 109 door in (common
       0x20). `no` hangs the broken shotgun in its place. -->
  <param name="sandwich" values="no|yes" default="no"
         label="spring 115's ceiling trap before 212 (Barry's rescue)"/>
  <!-- 20C on the second mansion visit, after the rope snaps. `wait` stays
       in the pit until Barry is back with the rope and the pass number
       (common 0x25). `leave` pushes the switch below and climbs down the
       ladder to 21A before then, so 0x25 stays clear: Barry skips 308 and
       plays "Tell my family" in 502. The way on is 21A, 21B, 21C and the
       200 lift up to 213 (room/200/bot.xml), since 201's key panel needs
       the pass number. -->
  <param name="rope" values="wait|leave" default="wait"
         label="20C: wait in the pit for Barry's rope, or leave first"/>
  <!-- The lab: `save` keeps off 50C's elevator switch, the ride down to
       the Tyrant, until 508's pass-code lamps are lit (scenario 0x50,
       room/50C/bot.xml), and holds 501's escape battery until
       512's cell has freed Chris (common 0x4B, room/501/bot.xml); `leave` keeps off
       50B's door to 512, so Chris stays locked up: with Barry (common 0xC0
       clear) the Barry ending, without him the Bad ending. -->
  <param name="chris" values="save|leave" default="save"
         label="Jill: free Chris from 512's cell before the Tyrant"/>

  <!-- Chris's game. Two flags decide his ending: common 0xC0 (Rebecca
       lost) and 0x4B (Jill freed from 512's cell). Rebecca is lost only to
       a hunter attack the player abandons, in 101 or 206, and both are
       settled before the caves; nothing later sets 0xC0 for Chris. -->
  <!-- Whom Chris meets first. `save_room` holds the doors into 20D (204's
       and 20E's) until Rebecca is met in 100 (common 0x24): Richard is
       then found dead, with no serum to bring. `richard` holds 101's door
       to 100 until Richard is found in 20D (common 0x62): Rebecca is with
       him, the 100 meeting never plays, and `richard` decides whether he
       lives. -->
  <param name="rebecca_meet" values="save_room|richard" default="save_room"
         label="Chris: meet Rebecca in 100 before Richard in 20D, or Richard first"/>
  <!-- 100, after rebecca_meet=save_room: "Will you take Rebecca with you?"
       (message 16) as Chris leaves by door 0. `yes` takes her along: no
       hunter is ever sent after her. `no` leaves her in the save room
       (common 0x22): after 10A's hunter film her radio call plays, and the
       first 101 entry past 180 seconds plays the hunter attack there
       (common 0x2F). No effect after rebecca_meet=richard. -->
  <param name="rebecca_along" values="yes|no" default="yes"
         label="Chris: take Rebecca along from the save room (message 16)"/>
  <!-- A hunter attack on Rebecca: in 101 (rebecca_along=no, Chris back past
       180 seconds after her call) or in 206 (common 0x36, the upstairs
       call: Richard dead, or a slow serum run after Yawn's bite). `save`
       comes back to the room once the call is due and fights its hunter
       there; `leave` walks out during the attack, and keeps out of 206
       after the upstairs call, so she dies (common 0xC0). 206's attack is
       lost whatever the timing; 101's plays only if Chris comes back late,
       so leaving her there is not certain: a route that must lose Rebecca
       takes 206's (rebecca_meet=richard richard=leave). -->
  <param name="rebecca" values="save|leave" default="save"
         label="Chris: answer the hunter attacks on Rebecca (101, 206)"/>
  <!-- The lab, Chris's game: as `chris` for Jill. `save` keeps off 50C's
       elevator switch until 508's pass-code lamps are lit (scenario 0x50),
       comes back to 50B for the cell door (after the Tyrant, or in the
       self-destruct with Rebecca alive) and holds 501's escape battery
       until 512 has freed Jill (common 0x4B); `leave` keeps off 50B's door
       to 512. -->
  <param name="jill" values="save|leave" default="save"
         label="Chris: free Jill from 512's cell before the escape"/>
</params>
