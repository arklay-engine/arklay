<!-- 50F. The power panel at AOT 2 asks to power the blacked-out areas;
     Yes sets scenario 46 (0x2E), the supply half of 50C's elevator power.
     That power leads to 50C's elevator switch, which rides straight down
     to 514 and the Tyrant, whose death starts the self-destruct; the
     countdown leaves no time to read the three MO disks for 508's
     pass-code lamps. So under chris=save the panel waits until all three
     lamps are lit and 508's door to 50B opens (scenario 0x50). The lamps
     do not need this power. -->
<bot format="2">
  <interact slot="2" bank="0" bit="46" after_bank="0" after_bit="0x50" when="chris=save"
            label="the power panel: power the blacked-out areas"/>
  <interact slot="2" bank="0" bit="46" when="chris=leave"
            label="the power panel: power the blacked-out areas"/>
  <answer choice="yes" slot="2" label="activate the blacked-out areas"/>
</bot>
