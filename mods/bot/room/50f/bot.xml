<?xml version="1.0" encoding="UTF-8"?>
<!-- 50F. The power panel at AOT 2 asks to power the blacked-out areas;
     Yes sets scenario 46 (0x2E), the supply half of 50C's elevator power.
     That power is the first link to 50C's elevator switch, which rides
     straight down to 514 and the Tyrant, whose death starts the
     self-destruct and turns 508's door to 50B into a message (133). So
     under chris=save the panel waits until 512's cell has freed Chris
     (common 0x4B). -->
<bot format="2">
  <interact slot="2" bank="0" bit="46" after_bank="1" after_bit="0x4B" when="chris=save"
            label="the power panel: power the blacked-out areas"/>
  <interact slot="2" bank="0" bit="46" when="chris=leave"
            label="the power panel: power the blacked-out areas"/>
  <answer choice="yes" slot="2" label="activate the blacked-out areas"/>
</bot>
