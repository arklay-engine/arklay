<?xml version="1.0" encoding="UTF-8"?>
<!-- 116 shotgun rack. Item AOT 1 is the shotgun on the rack (item flag
     0x00, set while it hangs there). Lifting it plays the rack's lift and
     turns AOT 5 into an SCE_USEITEM probe that arms the broken shotgun's
     (0x1C) use flag (bank 9, selector 1) while the player stands in it.
     USE the broken shotgun there: room main sets item flag 0x01 (the broken
     one hangs on the rack), clears common 0x20 and gives the door back.
     With both item flags clear (the rack left empty), entering 115 springs
     its ceiling trap. So the rack is lifted only while the broken shotgun is
     held, and the swap follows at once. With sandwich=yes the rack is
     lifted bare to spring the trap, and the bot never comes back (109
     holds the door to 115 shut once the trap has sprung), so the broken
     shotgun is not wanted here. -->
<bot format="2">
  <use slot="5" item="0x1C" bank="7" bit="0x01" when="sandwich=no"
       label="broken shotgun on the rack"/>
  <avoid slot="1" unless_held="0x1C" when="sandwich=no"
         reason="the shotgun rack springs the 115 ceiling trap"/>
</bot>
