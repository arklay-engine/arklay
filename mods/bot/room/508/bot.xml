<!-- 508. The door to 50B (door 3) is an event message until scenario 80
     is set. One press of the reader at AOT 4 enters every pass code
     already taken (item bits 82, 98 and 90 clear) and lights its lamp
     (scenario 52, 53, 54); with all three lit, it sets 80. Each lamp step
     waits for its code's file, so the bot presses the reader only when a
     press lights something. The lamps are mark="no": one press lights
     every code taken so far, and lamp 3 lit by lamp 1's press moved the
     sequence past lamp 2's hold to the last step, which a press cannot
     finish until lamp 2 is lit. Its every approach failed, the mark held
     the reader, and 507's pass code 02 came too late to be entered. -->
<bot format="2">
  <interact slot="4" bank="0" bit="52" after_bank="7" after_bit="82" after_while="clear" mark="no" label="the reader: pass code 01's lamp"/>
  <interact slot="4" bank="0" bit="53" after_bank="7" after_bit="98" after_while="clear" mark="no" label="the reader: pass code 02's lamp"/>
  <interact slot="4" bank="0" bit="54" after_bank="7" after_bit="90" after_while="clear" mark="no" label="the reader: pass code 03's lamp"/>
  <interact slot="4" bank="0" bit="80" label="the reader: the door to 50B"/>
</bot>
