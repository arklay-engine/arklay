<?xml version="1.0" encoding="UTF-8"?>
<!-- 200, the old lift between 21C (under the kitchen) and 213. Both doors
     are parked at the room origin: entered from 213 the lift rides down
     and its event turns on door 1 to 21C; entered from anywhere else it
     rides up and turns on door 0 to 213 (on_enter / on_enter_2). Only the
     rope=leave branch needs it, to reach 213 without 201's key panel, so
     the facts hold only then and the default route stays as it was. -->
<bot format="2">
  <ride slot="0" from="21C" when="rope=leave" label="up to 213"/>
  <ride slot="1" from="213" when="rope=leave" label="down to 21C"/>
</bot>
