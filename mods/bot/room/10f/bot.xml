<?xml version="1.0" encoding="UTF-8"?>
<!-- 10F bar. After the gold emblem pickup (common 0xA6) the bar counter closes
     the north passage, and the hollow's SCE_USEITEM probe AOT 6 arms the wood
     emblem. USE it there: the room swaps the emblems, sets common 0xA7 and
     reopens the passage. AOT 6 is deleted until the pickup, so the planner
     only sees this step once it applies. -->
<bot format="2">
  <use slot="6" item="0x1F" bank="1" bit="0xA7" label="wood emblem in the hollow"/>
</bot>
