<!-- 100 the storeroom off the main hall: typewriter, item box and the
     serum shelf. The shelf event (AOT 5, event_02) turns on the serum pickup
     (AOT 3, a zone at the room origin) while common 0x23 is set, and taking
     the serum clears 0x23. Richard's scene in 20D sets 0x23, so a serum is
     on offer here whenever he waits for one. The shelf's second serum (AOT
     4) is on offer while common 0x24 is set: 20E's collapse scene sets it
     after Yawn's bite (serious poison), and the bot fetches it as the cure
     it needs.

     Chris's game: Richard's scene sets common 0x2D instead, and 20E's
     poison collapse 0x2E when Chris must fetch his own serum. Leaving by
     door 0 after meeting Rebecca asks "Will you take Rebecca with you?"
     (message 16): rebecca_along picks the answer. -->
<bot format="2">
  <fetch slot="5" item="0x42" bank="1" bit="0x23" character="jill"
         label="the serum from the shelf"/>
  <fetch slot="5" item="0x42" bank="1" bit="0x24" character="jill"
         label="the second serum from the shelf"/>
  <fetch slot="5" item="0x42" bank="1" bit="0x2D" character="chris"
         label="the serum from the shelf"/>
  <fetch slot="5" item="0x42" bank="1" bit="0x2E" character="chris"
         label="the second serum from the shelf"/>
  <answer message="16" choice="yes" character="chris" when="rebecca_along=yes"
          label="take Rebecca along"/>
  <answer message="16" choice="no" character="chris" when="rebecca_along=no"
          label="leave Rebecca in the save room"/>
</bot>
