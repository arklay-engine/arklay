#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_505 0x00
#define AOT_01_DOOR_50C 0x01
#define AOT_02_ITEM_HEAL_HERB_RED_0 0x02
#define AOT_03_ITEM_AMMO_MAGNUM_1 0x03
#define AOT_04_MESSAGE_OPERATING_TABLE 0x04
#define AOT_05_MESSAGE_INSTRUMENTS 0x05
#define AOT_06_USEITEM_VENT_A_COVER 0x06                    // Raises F_ROOM_VENT_A_COVERED while an object stands on the first gas vent.
#define AOT_07_USEITEM_VENT_B_COVER 0x07                    // Raises F_ROOM_VENT_B_COVERED while an object stands on the second gas vent.
#define AOT_08_USEITEM_TRAP_SWITCH 0x08                     // Raises F_ROOM_TRAP_SWITCH_PRESSED when the player or an object stands on it.
#define AOT_09_EVENT_AIR_SHAFT 0x09
#define AOT_0A_MESSAGE_CORPSE 0x0A
#define AOT_0B_MESSAGE_MORGUE 0x0B
#define AOT_0C_USEITEM_PASS_CODE_MACHINE 0x0C
#define AOT_0D_MESSAGE_PASS_CODE_MACHINE 0x0D
#define AOT_0E_ITEM_FILE_PASS_CODE_02_2 0x0E                // Handed over by the pass code machine.
#define AOT_0F_ITEM_AMMO_SHOTGUN_3 0x0F
#define CAM_00 0x00
#define FX_09 0x09
#define F_ROOM_ESCAPED_INTO_SHAFT 0x07                      // The player went into the air shaft.
#define F_ROOM_GAS_BGM_ON 0x00                              // A vent is releasing gas; its music is playing.
#define F_ROOM_GAS_STOPPED 0x08                             // Main stopped the gas tasks after the escape.
#define F_ROOM_GAS_TINT_ON 0x0A                             // The room light is tinted by the gas.
#define F_ROOM_GAS_TRAP_SPRUNG 0x03                         // The trap switch was pressed; the gas is escaping.
#define F_ROOM_PLAYER_ANIM_DONE 0x21                        // The player's animation finished; nothing waits on it.
#define F_ROOM_SHAFT_PROMPT_OPEN 0x0C                       // The air shaft prompt is up; the gas countdown pauses.
#define F_ROOM_TRAP_SWITCH_PRESSED 0x24                     // The player or an object stands on the trap switch (one frame).
#define F_ROOM_TRAP_TASK_STARTED 0x04                       // Main started the gas trap task this visit.
#define F_ROOM_VENT_A_COVERED 0x22                          // An object stands on the first gas vent (one frame).
#define F_ROOM_VENT_A_GAS_ON 0x01                           // The first vent's gas effect is running.
#define F_ROOM_VENT_A_TASK_STARTED 0x05                     // Main started the first vent's cover watch this visit.
#define F_ROOM_VENT_B_COVERED 0x23                          // An object stands on the second gas vent (one frame).
#define F_ROOM_VENT_B_GAS_ON 0x02                           // The second vent's gas effect is running.
#define F_ROOM_VENT_B_TASK_STARTED 0x06                     // Main started the second vent's cover watch this visit.
#define IMDL_00_HEAL_HERB_RED 0x00
#define IMDL_01_AMMO_MAGNUM 0x01
#define IMDL_02_FILE_PASS_CODE_02 0x02
#define IMDL_03_AMMO_SHOTGUN 0x03
#define MSG_POISON_GAS_IS_ESCAPING 0x03
#define MSG_THERE_IS_AN_AIR_SHAFTWILL_YOU 0x02
#define OBJ_00_BOX_A 0x00                                   // Guess: a box that can be pushed onto a gas vent.
#define OBJ_01_BOX_B 0x01                                   // Guess: a box that can be pushed onto a gas vent.
#define OBJ_02_CLIMB_BOX 0x02                               // A pushable box that can be climbed.
#define SE_19_CHAKUCHI 0x19
#define SE_1A_SW_PUSH3 0x1A
#define SE_PL_02 0x02

proc init
{
    door_aot_set(AOT_00_DOOR_505, 10800, 0, 2200, 2200, 6, DOOR_SND_01_DR_MTL, DOOR_0D_DOOR13, 6, DOOR_LOCKED | F_LOCK_505_507, ROOM_505_O_PASSAGE, 16600, 0, 4200, 1024, LOCK, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_50C, 20000, 0, 2600, 2700, 9, DOOR_SND_01_DR_MTL, DOOR_0D_DOOR13, 6, 0, ROOM_50C_FRONT_OF_ELEVATOR, 6100, 0, 18000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_ITEM, F_ITEM_507_HEAL_HERB_RED_0, TRUE))
    {
        item_aot_set(AOT_02_ITEM_HEAL_HERB_RED_0, 23930, 1380, 1800, 1800, IT_43_HEAL_HERB_RED, 1, IMDL_00_HEAL_HERB_RED, SCA_NONE, 24830, -1500, 2280, 0, F_ITEM_507_HEAL_HERB_RED_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    if (ck(FG_ITEM, F_ITEM_507_AMMO_MAGNUM_1, TRUE))
    {
        item_aot_set(AOT_03_ITEM_AMMO_MAGNUM_1, 13200, 9860, 1800, 1800, IT_0E_AMMO_MAGNUM, 6, IMDL_01_AMMO_MAGNUM, SCA_NONE, 14100, -2890, 10760, 0, F_ITEM_507_AMMO_MAGNUM_1, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4);
    }
    aot_set(AOT_04_MESSAGE_OPERATING_TABLE, 25000, 6000, 1100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 1, 1, 0, 0);
    aot_set(AOT_05_MESSAGE_INSTRUMENTS, 16600, 11900, 1380, 820, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 1, 1, 0, 0);
    aot_set(AOT_06_USEITEM_VENT_A_COVER, 16680, 9820, 1090, 1190, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 34, 0, 1, 0);
    aot_set(AOT_07_USEITEM_VENT_B_COVER, 16680, 6430, 1090, 1020, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 35, 0, 1, 0);
    aot_set(AOT_08_USEITEM_TRAP_SWITCH, 17000, 8000, 900, 1000, SCE_USEITEM, SAT_UNDER | SAT_OBJECT | SAT_PLAYER, 4, 0, 36, 0, 1, 0);
    aot_set(AOT_09_EVENT_AIR_SHAFT, 15000, 8200, 1800, 500, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE_CORPSE, 9600, 10800, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 1, 1, 0, 0);
    aot_set(AOT_0B_MESSAGE_MORGUE, 2300, 9100, 8700, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 1, 1, 0, 0);
    aot_set(AOT_0C_USEITEM_PASS_CODE_MACHINE, 2520, 5720, 2300, 1800, SCE_USEITEM, SAT_PLAYER, 9, 0, 20, 0, 1, 0);
    aot_set(AOT_0D_MESSAGE_PASS_CODE_MACHINE, 2520, 5720, 2300, 1800, SCE_NONE, SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    if (ck(FG_ITEM, F_ITEM_507_FILE_PASS_CODE_02_2, TRUE))
    {
        item_aot_set(AOT_0E_ITEM_FILE_PASS_CODE_02_2, 0, 0, 1, 1, IT_6C_FILE_PASS_CODE_02, 1, IMDL_02_FILE_PASS_CODE_02, SCA_NONE, 0, 0, 0, 0, F_ITEM_507_FILE_PASS_CODE_02_2, SAT_MANUAL | SAT_PLAYER, 0);
    }
    if (ck(FG_ITEM, F_ITEM_507_AMMO_SHOTGUN_3, TRUE))
    {
        item_aot_set(AOT_0F_ITEM_AMMO_SHOTGUN_3, 23540, 7100, 1900, 1500, IT_0C_AMMO_SHOTGUN, 7, IMDL_03_AMMO_SHOTGUN, SCA_NONE, 24280, -1630, 7540, 2270, F_ITEM_507_AMMO_SHOTGUN_3, SAT_MANUAL | SAT_PLAYER, 0);
    }
    obj(OBJ_00_BOX_A, OF_10 | OF_ACTIVE, SCA_NONE, 22226, -500, 9880, 0, 0, 0, 0, 0, 650, 900, 900, 900);
    obj(OBJ_01_BOX_B, OF_10 | OF_ACTIVE, SCA_NONE, 22210, -500, 7780, 0, 0, 0, 0, 0, 650, 900, 900, 900);
    obj(OBJ_PUSH_GRUNT | OBJ_02_CLIMB_BOX, OF_CLIMBABLE | OF_10 | OF_ACTIVE, SCA_NONE, 19970, 0, 7930, 0, -650, 0, 350, 0, 300, 900, 1100, 550);
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_TRAP_TASK_STARTED, FALSE))
    {
        set(FG_ROOM, F_ROOM_TRAP_TASK_STARTED, TRUE);
        evt_exec(0, TASK_00, poison_gas_trap);
    }
    if (ck(FG_ROOM, F_ROOM_VENT_A_TASK_STARTED, FALSE))
    {
        set(FG_ROOM, F_ROOM_VENT_A_TASK_STARTED, TRUE);
        evt_exec(0, TASK_01, watch_vent_a_cover);
    }
    if (ck(FG_ROOM, F_ROOM_VENT_B_TASK_STARTED, FALSE))
    {
        set(FG_ROOM, F_ROOM_VENT_B_TASK_STARTED, TRUE);
        evt_exec(0, TASK_02, watch_vent_b_cover);
    }
    if (ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_STATUS, F_STATUS_DOOR_TRANSITION, TRUE))
    {
        aot_reset(AOT_09_EVENT_AIR_SHAFT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 5, air_shaft_prompt, 0);
    }
    else
    {
        aot_reset(AOT_09_EVENT_AIR_SHAFT, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_COMMON, F_COMMON_C_MORGUE_VENT_A_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_VENT_A_GAS_ON, TRUE);
            evt_exec(0, TASK_03, vent_a_gas_effect);
        }
        if (ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_COMMON, F_COMMON_C_MORGUE_VENT_B_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_VENT_B_GAS_ON, TRUE);
            evt_exec(0, TASK_04, vent_b_gas_effect);
        }
        if (ck(FG_COMMON, F_COMMON_C_MORGUE_VENT_A_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, TRUE) && ck(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_GAS_BGM_ON, TRUE);
            if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, FALSE))
            {
                bgm_play(BGM_SUB_1);
            }
        }
        if (ck(FG_COMMON, F_COMMON_C_MORGUE_VENT_B_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, TRUE) && ck(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_GAS_BGM_ON, TRUE);
            if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, FALSE))
            {
                bgm_play(BGM_SUB_1);
            }
        }
        if (ck(FG_COMMON, F_COMMON_C_MORGUE_VENT_A_COVERED, TRUE) && ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, TRUE))
        {
            set(FG_COMMON, F_COMMON_C_MORGUE_VENT_A_COVERED, FALSE);
            set(FG_ROOM, F_ROOM_VENT_A_GAS_ON, FALSE);
            task_kill(TASK_03);
        }
        if (ck(FG_COMMON, F_COMMON_C_MORGUE_VENT_B_COVERED, TRUE) && ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, TRUE))
        {
            set(FG_COMMON, F_COMMON_C_MORGUE_VENT_B_COVERED, FALSE);
            set(FG_ROOM, F_ROOM_VENT_B_GAS_ON, FALSE);
            task_kill(TASK_04);
        }
    }
    else
    {
        if (ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_COMMON, F_COMMON_J_GAS_HOLE_1_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_VENT_A_GAS_ON, TRUE);
            evt_exec(0, TASK_03, vent_a_gas_effect);
        }
        if (ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_COMMON, F_COMMON_J_GAS_HOLE_2_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_VENT_B_GAS_ON, TRUE);
            evt_exec(0, TASK_04, vent_b_gas_effect);
        }
        if (ck(FG_COMMON, F_COMMON_J_GAS_HOLE_1_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, TRUE) && ck(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_GAS_BGM_ON, TRUE);
            if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, FALSE))
            {
                bgm_play(BGM_SUB_1);
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_GAS_HOLE_2_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, TRUE) && ck(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE))
        {
            set(FG_ROOM, F_ROOM_GAS_BGM_ON, TRUE);
            if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, FALSE))
            {
                bgm_play(BGM_SUB_1);
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_GAS_HOLE_1_COVERED, TRUE) && ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, TRUE))
        {
            set(FG_COMMON, F_COMMON_J_GAS_HOLE_1_COVERED, FALSE);
            set(FG_ROOM, F_ROOM_VENT_A_GAS_ON, FALSE);
            task_kill(TASK_03);
        }
        if (ck(FG_COMMON, F_COMMON_J_GAS_HOLE_2_COVERED, TRUE) && ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, TRUE))
        {
            set(FG_COMMON, F_COMMON_J_GAS_HOLE_2_COVERED, FALSE);
            set(FG_ROOM, F_ROOM_VENT_B_GAS_ON, FALSE);
            task_kill(TASK_04);
        }
    }
    if (ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, FALSE) && ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, FALSE) && ck(FG_ROOM, F_ROOM_GAS_BGM_ON, TRUE))
    {
        set(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE);
        if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, FALSE))
        {
            bgm_stop(BGM_SUB_1);
        }
    }
    if (ck(FG_ROOM, F_ROOM_ESCAPED_INTO_SHAFT, TRUE) && ck(FG_ROOM, F_ROOM_GAS_STOPPED, FALSE))
    {
        set(FG_ROOM, F_ROOM_GAS_STOPPED, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, FALSE))
        {
            bgm_stop(BGM_SUB_1);
        }
        task_kill(TASK_01);
        task_kill(TASK_02);
        task_kill(TASK_03);
        task_kill(TASK_04);
    }
    if (testitem(IT_45_HEAL_HERB_BLUE) && ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_ROOM, F_ROOM_ESCAPED_INTO_SHAFT, FALSE))
    {
        evt_exec(0, TASK_07, event_07);
    }
    if (testitem(IT_48_HEAL_HERB_MIX_GB) && ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_ROOM, F_ROOM_ESCAPED_INTO_SHAFT, FALSE))
    {
        evt_exec(0, TASK_07, event_07);
    }
    if (testitem(IT_49_HEAL_HERB_MIX_GRB) && ck(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE) && ck(FG_ROOM, F_ROOM_ESCAPED_INTO_SHAFT, FALSE))
    {
        evt_exec(0, TASK_07, event_07);
    }
    if (ck(FG_ITEM, F_ITEM_507_FILE_PASS_CODE_02_2, TRUE))
    {
        aot_reset(AOT_0D_MESSAGE_PASS_CODE_MACHINE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 134, 257, 0);
        aot_reset(AOT_0C_USEITEM_PASS_CODE_MACHINE, SCE_USEITEM, SAT_PLAYER, 9, 13, 1);
    }
    else
    {
        aot_reset(AOT_0D_MESSAGE_PASS_CODE_MACHINE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 135, 257, 0);
        aot_reset(AOT_0C_USEITEM_PASS_CODE_MACHINE, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    }
    if (testitem(IT_28_KEY_MO_DISK))
    {
        aot_on(AOT_0E_ITEM_FILE_PASS_CODE_02_2, SCE_DOCUMENT, 0);
    }
}

event poison_gas_trap
{
    do
    {
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_TRAP_SWITCH_PRESSED, FALSE));
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_DOOR_TRANSITION, TRUE));
    }
    while (ck(FG_ROOM, F_ROOM_TRAP_SWITCH_PRESSED, FALSE));
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_1A_SW_PUSH3, 0, SND_AT_POINT, 0, 17000, 8400);
        set(FG_ROOM, F_ROOM_GAS_TRAP_SPRUNG, TRUE);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE));
    message(MSG_POISON_GAS_IS_ESCAPING | MSG_FAST, RUN_CONTROLS | RUN_PLAYER); // "Poison gas is escaping...!"
    sleep(20);
    timer_setup(LIGHT_FADE_HALF, 600, FADE_R | FADE_G);
    set(FG_ROOM, F_ROOM_GAS_TINT_ON, TRUE);
    sleep(40);
    single(4) setw(W_LIGHT_DELTA, 0);
    evt_nop();
    evt_nop();
    for (15)
    {
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_SHAFT_PROMPT_OPEN, TRUE));
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_DOOR_ANGLE_STEP, TRUE));
        do
        {
            evt_next();
        }
        while (ck(FG_RUN, F_RUN_CONTROLS, FALSE));
    }
    evt_nop();
    run
    {
        sys_multi(SYS_HEALTH_STATUS, SYS_OR | HS_40);
        se_play_3d(SND_BANK_PLAYER, SE_PL_02, 0, SND_AT_PLAYER, 0, 0, 0);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_READY, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_01, F_ROOM_PLAYER_ANIM_DONE, 0);
    sleep(20);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    single(4) set(FG_RUN, 0, 0);
    raw(0x17, 0x00, 0x07, 0x04, 0x05, 0x06, 0x19, 0x00, 0xFF, 0x00, 0x00, 0x00);
}

event watch_vent_a_cover
{
    do
    {
        run
        {
            if (ck(FG_ROOM, F_ROOM_VENT_A_COVERED, TRUE))
            {
                if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
                {
                    set(FG_COMMON, F_COMMON_C_MORGUE_VENT_A_COVERED, TRUE);
                }
                else
                {
                    set(FG_COMMON, F_COMMON_J_GAS_HOLE_1_COVERED, TRUE);
                }
            }
            else
            {
                if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
                {
                    set(FG_COMMON, F_COMMON_C_MORGUE_VENT_A_COVERED, FALSE);
                }
                else
                {
                    set(FG_COMMON, F_COMMON_J_GAS_HOLE_1_COVERED, FALSE);
                }
            }
        }
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_VENT_A_TASK_STARTED, TRUE));
    evt_finish();
}

event watch_vent_b_cover
{
    do
    {
        run
        {
            if (ck(FG_ROOM, F_ROOM_VENT_B_COVERED, TRUE))
            {
                if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
                {
                    set(FG_COMMON, F_COMMON_C_MORGUE_VENT_B_COVERED, TRUE);
                }
                else
                {
                    set(FG_COMMON, F_COMMON_J_GAS_HOLE_2_COVERED, TRUE);
                }
            }
            else
            {
                if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
                {
                    set(FG_COMMON, F_COMMON_C_MORGUE_VENT_B_COVERED, FALSE);
                }
                else
                {
                    set(FG_COMMON, F_COMMON_J_GAS_HOLE_2_COVERED, FALSE);
                }
            }
        }
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_VENT_B_TASK_STARTED, TRUE));
    evt_finish();
}

event vent_a_gas_effect
{
    do
    {
        for (10)
        {
            evt_next();
        }
        single(12) effect(FX_09, FX_ROW_18, FX_AT_WORLD, 17320, 0, 10500, 0);
    }
    while (ck(FG_ROOM, F_ROOM_VENT_A_GAS_ON, TRUE));
    evt_finish();
}

event vent_b_gas_effect
{
    do
    {
        for (10)
        {
            evt_next();
        }
        single(12) effect(FX_09, FX_ROW_18, FX_AT_WORLD, 17320, 0, 7060, 0);
    }
    while (ck(FG_ROOM, F_ROOM_VENT_B_GAS_ON, TRUE));
    evt_finish();
}

event air_shaft_prompt
{
    message(MSG_THERE_IS_AN_AIR_SHAFTWILL_YOU | MSG_FAST, RUN_CONTROLS | RUN_PLAYER); // "There's an air shaft.Will you enter it? Poison gas is escaping...!"
    set(FG_ROOM, F_ROOM_SHAFT_PROMPT_OPEN, TRUE);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_06, enter_air_shaft);
        }
        else
        {
            set(FG_ROOM, F_ROOM_SHAFT_PROMPT_OPEN, FALSE);
        }
    }
    evt_finish();
}

event enter_air_shaft
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    timer_setup(LIGHT_FADE_VEIL, -2000, FADE_R | FADE_G | FADE_B);
    sleep(1);
    setw(W_LIGHT_DELTA, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        spd_set(ENT_PLAYER, 0);
        dir_set(0, 0, 2048, 0, 11800, 0, 6800);
        set(FG_STATUS, F_STATUS_DOOR_TRANSITION, FALSE);
        msg_list(0, 8760, -2500, 9040, 130, 130, 130, LIGHT_KIND_00, 10495, 6680, -2600, 9240, 130, 130, 130, LIGHT_KIND_00, 10895, 7600, -2800, 9240, 130, 130, 130, LIGHT_KIND_00, 9935, 1135, 1135, 1120);
    }
    sleep(20);
    timer_setup(LIGHT_FADE_VEIL, -2000, FADE_R | FADE_G | FADE_B);
    cutnext(CAM_00);
    sleep(10);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        se_play_3d(SND_BANK_ROOM, SE_19_CHAKUCHI, 0, SND_AT_POINT, 0, -13072, 6800);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    act_reset();
    evt_nop();
    sleep(7);
    se_play_3d(SND_BANK_ROOM, SE_19_CHAKUCHI, 0, SND_AT_POINT, 0, -13072, 6800);
    sleep(18);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ROOM, F_ROOM_GAS_TINT_ON, TRUE))
        {
            timer_setup(LIGHT_FADE_HALF, 600, FADE_R | FADE_G);
        }
    }
    sleep(45);
    run
    {
        if (ck(FG_ROOM, F_ROOM_GAS_TINT_ON, TRUE))
        {
            setw(W_LIGHT_DELTA, 0);
        }
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_ROOM, F_ROOM_ESCAPED_INTO_SHAFT, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_ROOM, F_ROOM_SHAFT_PROMPT_OPEN, FALSE);
        set(FG_MAP, F_MAP_VISITED_516, TRUE);
    }
    evt_finish();
}
