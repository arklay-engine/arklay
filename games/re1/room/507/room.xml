  <strings>
    <language lang="en-US">
      <string key="name">MORTUARY</string>
      <string key="save_name">Laboratory B3</string>
      <string key="0">{scroll 2}There's an operating\ntable.{scroll 10}</string>
      <string key="1">{scroll 2}Instruments for operation.\nSome are bloodstained.{scroll 10}</string>
      <string key="2">{scroll 2}There's an air shaft.Will\nyou enter it? {branch 0 1 0}{scroll 2}\nPoison gas is escaping...!{scroll 10}</string>
      <string key="3">{scroll 2}\nPoison gas is escaping...!{scroll 10}</string>
      <string key="4">{scroll 2}\nA corpse is laid here.{scroll 10}</string>
      <string key="5">{scroll 2}This place seems to be a\nmorgue.{scroll 10}</string>
      <string key="6">{scroll 2}It's a pass code output\nmachine.{scroll 10}{clear 0}{scroll 2}If I had a MO DISK,\nI could get the code...{scroll 10}</string>
      <string key="7">{scroll 2}I already have the pass\ncode.{scroll 10}</string>
      <string key="8">{scroll 2}You've obtained the pass\ncode.{scroll 10}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}研究所 {s}/{s}B{s}3{s}</string>
      <string key="0">{scroll 2}\n      手術台がある{scroll 10}</string>
      <string key="1">{scroll 2}  手術に使う器具が並んでいる\n  血がついたままのものもある{scroll 10}</string>
      <string key="2">{scroll 2}      通風孔がある\n入りますか?    {branch 0 1 0}{scroll 2}\n  毒ガスがもれている・・・!{scroll 10}</string>
      <string key="3">{scroll 2}\n  毒ガスがもれている・・・!{scroll 10}</string>
      <string key="4">{scroll 2}\n  死体が安置されている・・・{scroll 10}</string>
      <string key="5">{scroll 2}\n どうやらここは死体置場のようだ{scroll 10}</string>
      <string key="6">{scroll 2}\n   パスコードの出力装置だ{scroll 10}{clear 0}{scroll 2} MOディスクがあれば、\n コードを入手できるのだが・・・{scroll 10}</string>
      <string key="7">{scroll 2}\nここのパスコードはもう入手している{scroll 10}</string>
      <string key="8">{scroll 2}\n    パスコードを入手した{scroll 10}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Laboratoire SS3</string>
      <string key="0">{scroll 2}\nIl y a une table d'opération.{scroll 10}</string>
      <string key="1">{scroll 2}Instruments chirurgicaux.\nCertains ont des traces de sang.{scroll 10}</string>
      <string key="2">{scroll 2}Il y a un conduit d'aération.\nY entrer?{branch 0 6 0}</string>
      <string key="3">{scroll 2}\nUn gaz nocif s'échappe...!{scroll 10}</string>
      <string key="4">{scroll 2}\nUn corps est étendu ici.{scroll 10}</string>
      <string key="5">{scroll 2}\nOn dirait une morgue.{scroll 10}</string>
      <string key="6">{scroll 2}C'est une machine pour\ncodes d'accès.{scroll 10}{clear 0}{scroll 2}Si j'avais un disque M.O., je\npourrais avoir le code...{scroll 10}</string>
      <string key="7">{scroll 2}\nJ'ai déjà le code d'accès.{scroll 10}</string>
      <string key="8">{scroll 2}Vous avez obtenu le code \nd'accès.{scroll 10}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}\nDa ist ein Operationstisch.{scroll 10}</string>
      <string key="1">{scroll 2}Instrumente für die Operation.\nEinige sind blutbefleckt.{scroll 10}</string>
      <string key="2">{scroll 2}Dort ist ein Luftschacht.\nMöchten Sie ihn betreten?{branch 0 6 0}</string>
      <string key="3">{scroll 2}\nEs entweicht giftiges Gas!{scroll 10}</string>
      <string key="4">{scroll 2}Ein Leichnam wurde\nhier abgelegt.{scroll 10}</string>
      <string key="5">{scroll 2}Dieser Raum scheint\neine Leichenhalle zu sein.{scroll 10}</string>
      <string key="6">{scroll 2}Das ist ein Gerät,\ndas Passcodes ausgibt.{scroll 10}{clear 0}{scroll 2}Mit einer MO-DISKETTE könnte\nich den Code aufzeichnen...{scroll 10}</string>
      <string key="7">{scroll 2}\nIch habe schon einen Passcode.{scroll 10}</string>
      <string key="8">{scroll 2}Sie haben einen Passcode\nerhalten.{scroll 10}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Laboratorio S3</string>
      <string key="0">{scroll 2}\nUn tavolo operatorio.{scroll 10}</string>
      <string key="1">{scroll 2}Strumenti chirurgici.Alcuni \nhanno tracce di sangue.{scroll 10}</string>
      <string key="2">{scroll 2}C'è un condotto di aerazione.\nVuoi entrarci?{branch 0 6 0}</string>
      <string key="3">{scroll 2}\nFuoriesce del gas velenoso!{scroll 10}</string>
      <string key="4">{scroll 2}Qui c'è disteso un \ncadavere.{scroll 10}</string>
      <string key="5">{scroll 2}Questo posto sembra \nessere un obitorio.{scroll 10}</string>
      <string key="6">{scroll 2}È una macchina che \nemette codici d'accesso.{clear 0}Se avessi un DISCO MO\npotrei ottenerlo...{scroll 2}</string>
      <string key="7">{scroll 2}Ho già il codice di\naccesso.{scroll 10}</string>
      <string key="8">{scroll 2}Hai ottenuto il codice \ndi accesso.{scroll 10}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}Hay una mesa de\noperaciones...{scroll 10}</string>
      <string key="1">{scroll 2}Instrumental para operaciones.\nAlgunos tienen sangre...{scroll 10}</string>
      <string key="2">{scroll 2}Hay un conducto de aire...\n¿Quieres entrar? {branch 0 6 0}</string>
      <string key="3">{scroll 2}\n¡Sale gas venenoso...!{scroll 10}</string>
      <string key="4">{scroll 2}Hay cadáveres colocados\nsobre los catres...{scroll 10}</string>
      <string key="5">{scroll 2}Este sitio parece un\ndepósito de cadáveres...{scroll 10}</string>
      <string key="6">{scroll 2}Es una máquina de\ncontraseñas...{scroll 10}{clear 0}{scroll 2}Si tuviera un DISCO MO podría\nconseguir la contraseña...{scroll 10}</string>
      <string key="7">{scroll 2}Ya tengo el\npase...{scroll 10}</string>
      <string key="8">{scroll 2}Has conseguido el\npase...{scroll 10}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Лаборатория Б3</string>
      <string key="0">{scroll 2}Это операционный стол.{scroll 10}</string>
      <string key="1">{scroll 2}Инструменты для операций.\nНекоторые из них в крови.{scroll 10}</string>
      <string key="2">{scroll 2}Здесь вентиляционная шахта.\nВойти в неё?{branch 0 1 0}{scroll 2}\nПошёл ядовитый газ...!{scroll 10}</string>
      <string key="3">{scroll 2}\nПошёл ядовитый газ...!{scroll 10}</string>
      <string key="4">{scroll 2}\nЧей-то труп.{scroll 10}</string>
      <string key="5">{scroll 2}Это место похоже\nна морг.{scroll 10}</string>
      <string key="6">{scroll 2}Устройство\nдля печати паролей.{scroll 10}{clear 0}{scroll 2}Если бы у меня был МО ДИСК,\nя мог бы получить код...{scroll 10}</string>
      <string key="7">{scroll 2}У меня уже\nесть пароль.{scroll 10}</string>
      <string key="8">{scroll 2}\nВы получили пароль.{scroll 10}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Laboratorion olohuone -2 krs</string>
      <string key="0">{scroll 2}Siinä on leikkauspöytä...{scroll 10}</string>
      <string key="1">{scroll 2}Operointivälineitä...\nJotkut niistä ovat verisiä...{scroll 10}</string>
      <string key="2">{scroll 2}Siinä on tuuletuskuilu...\nKiipeätkö sinne? {branch 0 6 0}</string>
      <string key="3">{scroll 2}Myrkkykaasua vapautuu...!{scroll 10}</string>
      <string key="4">{scroll 2}Siihen on laskettu ruumis...{scroll 10}</string>
      <string key="5">{scroll 2}Tämän on oltava ruumishuone...{scroll 10}</string>
      <string key="6">{scroll 2}Se on kulkukoodien tulostin...{scroll 10}{clear 0}{scroll 2}Jos minulla olisi MO-levyke,\nvoisin tulostaa sellaisen...{scroll 10}</string>
      <string key="7">{scroll 2}Olen jo saanut siitä\nkulkukoodin...{scroll 10}</string>
      <string key="8">{scroll 2}Poimit kulkukoodin...{scroll 10}</string>
    </language>
  </strings>
