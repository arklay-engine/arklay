#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define FLAG_ROOM_23 0x23

proc init
{
    door_aot_set(0, 4600, 1200, 900, 1300, 3, 0, 0, 1, 0, ROOM_216_LIBRARY_A, 5200, 0, 15200, 1024, UNLOCKED, 129);
    aot_set(1, 4500, 8500, 2200, 1000, SCE_EVENT, 1, 0, 0, event_01, 0, 0, 0);
    item_aot_set(2, 7100, 2000, 1000, 1000, ITEM_0B_AMMO_HANDGUN, 15, 0, 255, 132, 28, 48, 248, 196, 9, 0, 12, 199, 129, 0, 0);
    item_aot_set(3, 4200, 4600, 2400, 1800, ITEM_2F_TOOL_INK_RIBBON, 2, 1, 255, 152, 18, 48, 248, 112, 23, 0, 4, 91, 129, 0, 0);
    set(FG_SCENARIO, FLAG_SCENARIO_4F, TRUE);
}

proc main
{
    if (ck(FG_ITEM, FLAG_ITEM_C7, FALSE))
    {
        aot_delete(5, SCE_NONE, 129);
    }
}

event event_00
{
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        aot_delete(1, SCE_NONE, 129);
        message(128, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        cutnext(2);
        dir_set(0, 0, 2920, 0, 5000, 0, 7850);
        if (ck(FG_SCENARIO, FLAG_SCENARIO_60, FALSE))
        {
            set(FG_SCENARIO, FLAG_SCENARIO_60, TRUE);
        }
    }
    message(129, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_6, FLAG_6_17, TRUE);
    do
    {
        evt_next();
    }
    while (ck_bits(1, 255, 255));
    set(FG_6, FLAG_6_17, FALSE);
    cutnext(1);
    sleep(5);
    run
    {
        aot_delete(1, SCE_EVENT, 1);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event event_02
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        message(130, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 3, 0 | 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_23, FALSE));
    aot_on(4, SCE_ITEM, 0);
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}
