#define AOT_01_ITEM 0x01
#define AOT_02_MESSAGE 0x02
#define AOT_03_MESSAGE 0x03
#define AOT_04_MESSAGE 0x04

proc init
{
    door_aot_set(AOT_00_DOOR, 2100, 4300, 2700, 1800, 2, 0, 33, 1, 0, ROOM_40A_ROOM_003, 3400, 0, 3500, 1024, UNLOCKED, 129);
