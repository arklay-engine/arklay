#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_MESSAGE 0x02
#define AOT_03_MESSAGE 0x03
#define AOT_04_MESSAGE 0x04
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define IMDL_00 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 2100, 4300, 2700, 1800, 2, DOOR_SND_00_DR_WD, DOOR_21_DOOR15, 1, 0, ROOM_40A_ROOM_003, 3400, 0, 3500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    item_aot_set(AOT_01_ITEM, 5100, 7600, 1000, 600, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 5600, 0, 7900, -500, F_ITEM_A8, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
#else
    item_aot_set(AOT_01_ITEM, 5100, 7600, 1000, 600, IT_12_AMMO_GRENADE_FLAME, 6, IMDL_00, SCA_NONE, 5600, 0, 7900, -500, F_ITEM_A8, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
#endif
    aot_set(AOT_02_MESSAGE, 1900, 8700, 4000, 2100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 69, 0, 0, 0);
    aot_set(AOT_03_MESSAGE, 7000, 5600, 1000, 1300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 69, 0, 0, 0);
    aot_set(AOT_04_MESSAGE, 6500, 8800, 1700, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 69, 0, 0, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_B9, SPAWN_FORCE, 1, 0, 1483, 0, 5509, 0, 8870, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
    scene_setup(2, 6100, 7700, 8500);
    set(FG_STATUS, F_STATUS_1F, TRUE);
}
