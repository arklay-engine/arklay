event tyrant_awakens
{
    evt_next();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_WESKER, 0, 192, 64);
    }
    else
    {
        act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_WESKER_OR_BARRY, 0, 192, 64);
    }
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER_OR_BARRY);
    }
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 192, 64);
    act_reset();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(10);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    sleep(10);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER_OR_BARRY);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_34, F_ROOM_NPC_ANIM_DONE, 0);
    sleep(5);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 9646, 6370, F_ROOM_PLAYER_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    sleep(3);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER_OR_BARRY);
    }
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_motion(MOTION_10);
    act_anim_flags(ANIM_2B, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0002);
    sleep(30);
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER_OR_BARRY);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_34, F_ROOM_NPC_ANIM_DONE, 0);
    sleep(8);
    act_idle();
    act_reset();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0080 | EF_0001);
    sleep(10);
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        cutnext(CAM_05_TANK);
        evt_fork(TASK_07, hide_props, 0);
    }
    else
    {
        evt_fork(TASK_07, hide_props, 0);
    }
    evt_next();
    evt_nop();
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            pos_set(ENEMY_00_WESKER, 0, 491, 0, 6763, 0, 9632);
        }
        else
        {
            cutnext(CAM_05_TANK);
            pos_set(ENEMY_00_WESKER_OR_BARRY, 0, 491, 0, 6763, 0, 9632);
        }
        dir_set(0, 0, 683, 0, 8507, 0, 8346);
        setw(W_LIGHT_STATE, 6144);
        timer_setup(LIGHT_FADE_01, 0, FADE_G);
    }
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 9646, 6370, F_ROOM_PLAYER_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        effect(FX_25, FX_ROW_02, FX_AT_WORLD, 11260, -4600, 4844, 0);
        effect(FX_25, FX_ROW_00, FX_AT_WORLD, 11245, -4750, 4833, 0);
        effect(FX_25, FX_ROW_00, FX_AT_WORLD, 11245, -4800, 4833, 0);
