#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_514 0x00
#define AOT_01_MESSAGE_CONTROL_DEVICE 0x01                  // The room's control device; unlocks the door once the Tyrant is dead.
#define AOT_02_ITEM_KEY_LAB_MASTER_0 0x02
#define AOT_03_EVENT_BARRY_TALK 0x03                        // Jill with Barry: Barry's talk after the Tyrant.
#define AOT_03_MESSAGE_WESKER_BODY 0x03                     // "What a miserable death..."
#define AOT_04_ITEM_AMMO_HANDGUN_1 0x04
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05_TANK 0x05                                    // The Tyrant's tank; its bubbles show only on this camera.
#define CAM_06 0x06
#define CAM_07 0x07
#define ENEMY_00_WESKER 0x00
#define ENEMY_00_WESKER_OR_BARRY 0x00                       // Jill: Wesker, or Barry when he is with her (F_COMMON_5B).
#define ENEMY_01_TYRANT_1 0x01
#define FX_25 0x25
#define F_ROOM_BUBBLE_DUE 0x24                              // A bubble burst is due in the tank this frame.
#define F_ROOM_BUBBLE_ECHO 0x0A                             // Plays a second bubble sound the next frame.
#define F_ROOM_DEVICE_SEEN_AFTER 0x05                       // The control device was examined after the Tyrant died; it now offers the shorter prompt.
#define F_ROOM_DEVICE_TRIED_EARLY 0x04                      // The control device was examined while the Tyrant lived.
#define F_ROOM_DOOR_UNLOCKED 0x06                           // The door was unlocked at the control device.
#define F_ROOM_J_BARRY_SCENE_ANIM_DONE 0x23                 // Jill with Barry: an animation in the Barry scenes finished (one frame).
#define F_ROOM_J_PLAYER_WALK_DONE 0x00                      // Jill: her walk into the room finished (one frame).
#define F_ROOM_KEY_TAKEN 0x02                               // The master key was taken; its model is hidden.
#define F_ROOM_NPC_ANIM_DONE 0x21                           // Wesker's (or Barry's) animation finished (one frame); a few player moves raise it too.
#define F_ROOM_PLAYER_ANIM_DONE 0x20                        // The player's animation finished (one frame).
#define F_ROOM_TANK_LID_HALFWAY 0x1F                        // Guess: the tank lid is halfway up; never read.
#define F_ROOM_TANK_OPENED 0x09                             // The tank opened; its bubbles stop.
#define F_ROOM_TYRANT_ANIM_DONE 0x00                        // The Tyrant's animation finished (one frame).
#define F_ROOM_TYRANT_DEAD_MUSIC 0x08                       // The music change after the Tyrant's death started.
#define F_ROOM_TYRANT_DEATH_HANDLED 0x03                    // The Tyrant's death was handled (door and control device reset).
#define F_ROOM_TYRANT_SCENE_OVER 0x07                       // The Tyrant scene already happened (F_SCENARIO_TYRANT_1_DEAD on entry).
#define F_ROOM_TYRANT_STRIKE_DONE 0x1E                      // Guess: raised by the Tyrant's scripted attack; the script only waits for it.
#define F_ROOM_TYRANT_WALK_DONE 0x22                        // The Tyrant's forked walk finished (one frame).
#define IMDL_00_KEY_LAB_MASTER 0x00
#define IMDL_01_AMMO_HANDGUN 0x01
#define MSG_IT_LOOKS_LIKE_THE_CONTROL_DEVICE_A_DOOR_LOCK_DEVICE 0x1E
#define MSG_IT_LOOKS_LIKE_THE_CONTROL_DEVICE_FOUND_A_DOOR_LOCK_SWITCH 0x1D
#define MSG_VO_013_00 0x05
#define MSG_VO_013_01 0x06
#define MSG_VO_013_02 0x07
#define MSG_VO_013_03 0x08
#define MSG_VO_013_04 0x09
#define MSG_VO_013_05 0x0A
#define MSG_VO_013_06 0x0B
#define MSG_VO_013_07 0x0C
#define MSG_VO_013_08 0x0D
#define MSG_VO_013_09 0x0E
#define MSG_VO_116_00 0x0F
#define MSG_VO_116_01 0x10
#define MSG_VO_116_02 0x11
#define MSG_VO_116_03 0x12
#define MSG_VO_116_04 0x13
#define MSG_VO_116_05 0x14
#define MSG_VO_117_00 0x15
#define MSG_VO_117_01 0x16
#define MSG_VO_117_02 0x17
#define MSG_VO_117_03 0x18
#define MSG_VO_117_04 0x19
#define MSG_VO_117_05 0x1A
#define MSG_VO_117_10 0x21
#define MSG_VO_117_11 0x22
#define MSG_VO_117_12 0x23
#define MSG_VO_A09_0B_AB 0x24
#define OBJ_00_CAMERA_PROP_A 0x00                           // Guess: a scenery prop the place_props_* events move for each camera.
#define OBJ_01_CAMERA_PROP_B 0x01                           // Guess: a scenery prop the place_props_* events move for each camera.
#define OBJ_02_CAMERA_PROP_C 0x02                           // Guess: a scenery prop the place_props_* events move for each camera.
#define OBJ_03_CAMERA_PROP_D 0x03                           // Guess: a scenery prop the place_props_* events move for each camera.
#define OBJ_04_TANK_LID_OPENING 0x04                        // Guess: the tank lid that rises when the Tyrant wakes.
#define OBJ_05_TANK_LID_CLOSED 0x05                         // Guess: the closed tank lid, swapped for OBJ_04 when it opens.
#define OBJ_06_KEY_LAB_MASTER 0x06                          // The master key's model; it falls to the floor in the cutscene.
#define SE_17_BUBBLE_S 0x17
#define SE_18_BUBBLE_L 0x18
#define SE_1D_CONPANE 0x1D
#define SE_1E_KEY_LOST 0x1E
#define VO_013_00 0x47
#define VO_013_01 0x48
#define VO_013_02 0x49
#define VO_013_03 0x4A
#define VO_013_04 0x4B
#define VO_013_05 0x4C
#define VO_013_06 0x4D
#define VO_013_07 0x4E
#define VO_013_08 0x4F
#define VO_013_09 0x50
#define VO_116_00 0xAC
#define VO_116_01 0xAD
#define VO_116_02 0xAE
#define VO_116_03 0xAF
#define VO_116_04 0xB0
#define VO_116_05 0xB1
#define VO_117_00 0xA0
#define VO_117_01 0xA1
#define VO_117_02 0xA2
#define VO_117_03 0xA3
#define VO_117_04 0xA4
#define VO_117_05 0xA5
#define VO_117_10 0xA6
#define VO_117_11 0xA7
#define VO_117_12 0xA8
#define VO_A09_0B_AB 0xAB
#define VO_B00_11_51 0x51
#define VO_B00_11_AA 0xAA
#define VO_B00_11_B4 0xB4

proc init
{
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
    set(FG_STATUS, F_STATUS_SCRIPT_ONLY_1C, TRUE);
    if (ck(FG_SCENARIO, F_SCENARIO_TYRANT_1_DEAD, TRUE))
    {
        set(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, TRUE);
    }
    door_aot_set(AOT_00_DOOR_514, 2200, 26000, 3000, 2500, 10, DOOR_SND_0C_DR_AIR, DOOR_0D_DOOR13, 64, 0, ROOM_514_FRONT_OF_TYRANT, 3500, 0, 2500, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            aot_reset(AOT_00_DOOR_514, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 156, 255, 0);
            aot_set(AOT_01_MESSAGE_CONTROL_DEVICE, 5900, 3800, 3500, 2300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 155, 0, 255, 0, 0, 0);
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE))
            {
                aot_reset(AOT_00_DOOR_514, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 156, 255, 0);
                aot_set(AOT_01_MESSAGE_CONTROL_DEVICE, 5900, 3800, 3500, 2300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 155, 0, 255, 0, 0, 0);
            }
            else
            {
                aot_reset(AOT_00_DOOR_514, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 255, 0);
                aot_set(AOT_01_MESSAGE_CONTROL_DEVICE, 5900, 3800, 3500, 2300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 160, 0, 255, 0, 0, 0);
            }
        }
    }
    else
    {
        aot_set(AOT_01_MESSAGE_CONTROL_DEVICE, 5900, 3800, 3500, 2300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 160, 0, 255, 0, 0, 0);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE))
        {
            item_aot_set(AOT_02_ITEM_KEY_LAB_MASTER_0, 9975, 7464, 2000, 2000, IT_37_KEY_LAB_MASTER, 2, IMDL_00_KEY_LAB_MASTER, OBJ_06_KEY_LAB_MASTER, 0, 0, 0, 0, F_ITEM_513_KEY_LAB_MASTER_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_5 | 16 | ITEM_REACH);
        }
        aot_set(AOT_03_MESSAGE_WESKER_BODY, 8600, 6500, 1600, 3200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE))
        {
            item_aot_set(AOT_02_ITEM_KEY_LAB_MASTER_0, 9975, 7464, 2000, 2000, IT_37_KEY_LAB_MASTER, 2, IMDL_00_KEY_LAB_MASTER, OBJ_06_KEY_LAB_MASTER, 0, 0, 0, 0, F_ITEM_513_KEY_LAB_MASTER_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_5 | 16 | ITEM_REACH);
            aot_set(AOT_03_MESSAGE_WESKER_BODY, 8600, 6500, 1600, 3200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
        }
        else
        {
            aot_reset(AOT_02_ITEM_KEY_LAB_MASTER_0, SCE_NONE, 0, 0, 0, 0);
            if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
            {
                aot_set(AOT_03_EVENT_BARRY_TALK, 4166, 6696, 2000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, barry_talk_after_tyrant, 0, 0, 0);
                aot_reset(AOT_03_EVENT_BARRY_TALK, SCE_NONE, 0, 0, 0, 0);
            }
        }
    }
    item_aot_set(AOT_04_ITEM_AMMO_HANDGUN_1, 6000, 30000, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_01_AMMO_HANDGUN, SCA_NONE, 6668, 0, 30866, 2688, F_ITEM_513_AMMO_HANDGUN_1, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_2 | ITEM_REACH);
    obj(OBJ_00_CAMERA_PROP_A, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 8180, -520, 22320, 0, 1, 1, 1, 1, 1, 1, 1, 1);
    obj(OBJ_01_CAMERA_PROP_B, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 8180, -520, 19080, 0, 1, 1, 1, 1, 1, 1, 1, 1);
    obj(OBJ_02_CAMERA_PROP_C, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 8180, -520, 15840, 0, 1, 1, 1, 1, 1, 1, 1, 1);
    obj(OBJ_03_CAMERA_PROP_D, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 8180, -520, 12600, 0, 1, 1, 1, 1, 1, 1, 1, 1);
    obj(OBJ_04_TANK_LID_OPENING, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 10820, -20000, 4170, 3072, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_05_TANK_LID_CLOSED, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 11100, -20000, 4170, 3192, 0, 0, 0, 0, 0, 0, 0, 0);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
            {
                obj(OBJ_06_KEY_LAB_MASTER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 10060, -20000, 8080, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            }
            else
            {
                obj(OBJ_06_KEY_LAB_MASTER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 10975, 0, 8464, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            }
            eml_rot(IMDL_00_KEY_LAB_MASTER, 2048, 0);
            eml_rot(ROT_OBJ | OBJ_06_KEY_LAB_MASTER, 2048, 0);
            if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
            {
                objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, 0);
                objtbl_b_set(TBL_ITEM, IMDL_00_KEY_LAB_MASTER, 0);
            }
            else if (ck(FG_ITEM, F_ITEM_513_KEY_LAB_MASTER_0, TRUE))
            {
                objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, OF_ACTIVE);
                objtbl_b_set(TBL_ITEM, IMDL_00_KEY_LAB_MASTER, OF_ACTIVE);
            }
            else
            {
                objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, 0);
                objtbl_b_set(TBL_ITEM, IMDL_00_KEY_LAB_MASTER, 0);
            }
        }
        if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
        {
            enemy(EM_2E_NPC_WESKER_2, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 565, 0, 7340, 0, 10250, ENEMY_00_WESKER, ANIM_32, 14, EVAR_00);
            enemy(EM_0C_TYRANT_1, EB_40, F_ENEMY_513_TYRANT_1_1, SPAWN_FORCE, 2, 0, 3072, 0, 10700, 0, 7000, ENEMY_01_TYRANT_1, ANIM_00, 0, EVAR_00);
            eml_state(0, ENEMY_00_WESKER, EML_ACTION, AB_0B);
            dir_set(0, 0, 613, 0, 8139, 0, 8994);
            sys_multi(SYS_UNEQUIP);
            plw_anim(PLW_00, ANIM_00, 0);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_02, 0);
            evt_exec(0, TASK_07, place_props_cam_02);
            evt_exec(0, TASK_06, tank_lid_closed);
            evt_exec(0, TASK_00, tyrant_awakens);
        }
        else
        {
            enemy(EM_2E_NPC_WESKER_2, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 1155, 0, 9627, 0, 8092, ENEMY_00_WESKER, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_07, place_props_cam_00);
        }
    }
    else
    {
        if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
        {
            obj(OBJ_06_KEY_LAB_MASTER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 10060, -20000, 8080, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        }
        else
        {
            obj(OBJ_06_KEY_LAB_MASTER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 10975, 0, 8464, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        }
        eml_rot(IMDL_00_KEY_LAB_MASTER, 2048, 0);
        eml_rot(ROT_OBJ | OBJ_06_KEY_LAB_MASTER, 2048, 0);
        if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE))
        {
            if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
            {
                objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, 0);
                objtbl_b_set(TBL_ITEM, IMDL_00_KEY_LAB_MASTER, 0);
            }
            else if (ck(FG_ITEM, F_ITEM_513_KEY_LAB_MASTER_0, TRUE))
            {
                objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, OF_ACTIVE);
                objtbl_b_set(TBL_ITEM, IMDL_00_KEY_LAB_MASTER, OF_ACTIVE);
            }
            else
            {
                objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, 0);
                objtbl_b_set(TBL_ITEM, IMDL_00_KEY_LAB_MASTER, 0);
            }
        }
        else
        {
            objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, 0);
            objtbl_b_set(TBL_ITEM, IMDL_00_KEY_LAB_MASTER, 0);
        }
        if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE))
            {
                enemy(EM_2E_NPC_WESKER_2, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 565, 0, 7340, 0, 10250, ENEMY_00_WESKER_OR_BARRY, ANIM_32, 14, EVAR_00);
                enemy(EM_0C_TYRANT_1, EB_40, F_ENEMY_513_TYRANT_1_1, SPAWN_FORCE, 2, 0, 3072, 0, 10700, 0, 7000, ENEMY_01_TYRANT_1, ANIM_00, 0, EVAR_00);
                eml_state(0, ENEMY_00_WESKER_OR_BARRY, EML_ACTION, AB_0B);
            }
            else
            {
                enemy(EM_2D_NPC_BARRY_3, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 3470, 0, 14555, ENEMY_00_WESKER_OR_BARRY, ANIM_00, 0, EVAR_00);
                enemy(EM_0C_TYRANT_1, EB_41, F_ENEMY_513_TYRANT_1_1, SPAWN_FORCE, 2, 0, 3072, 0, 10700, 0, 7000, ENEMY_01_TYRANT_1, ANIM_00, 0, EVAR_00);
                eml_state(0, ENEMY_00_WESKER_OR_BARRY, EML_ACTION, AB_0B);
            }
        }
        else if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE))
        {
            enemy(EM_2E_NPC_WESKER_2, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 1155, 0, 9627, 0, 8092, ENEMY_00_WESKER_OR_BARRY, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE))
            {
                dir_set(0, 0, 613, 0, 8139, 0, 8994);
                sys_multi(SYS_UNEQUIP);
                plw_anim(PLW_00, ANIM_00, 0);
                cut_auto(CUT_LOCKED);
                setb(B_CAMERA, CAM_02, 0);
                evt_exec(0, TASK_07, place_props_cam_02);
                evt_exec(0, TASK_06, tank_lid_closed);
                evt_exec(0, TASK_00, tyrant_awakens);
            }
            else
            {
                dir_set(0, 0, 960, 0, 6161, 0, 13377);
                cut_auto(CUT_LOCKED);
                setb(B_CAMERA, CAM_01, 0);
                evt_exec(0, TASK_07, place_props_cam_01);
                evt_exec(0, TASK_06, tank_lid_closed);
                evt_exec(0, TASK_00, tyrant_awakens_with_barry);
                evt_exec(0, TASK_01, with_barry_player_walks_in);
                evt_exec(0, TASK_03, with_barry_barry_walks_in);
            }
        }
        else
        {
            evt_exec(0, TASK_07, place_props_cam_00);
        }
    }
}

proc main
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_ITEM, F_ITEM_513_KEY_LAB_MASTER_0, FALSE) && ck(FG_ROOM, F_ROOM_KEY_TAKEN, FALSE))
        {
            set(FG_ROOM, F_ROOM_KEY_TAKEN, TRUE);
            objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, 0);
        }
        if (ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
        {
            if (ck(FG_ENEMY, F_ENEMY_513_TYRANT_1_1, TRUE))
            {
                if (ck(FG_ROOM, F_ROOM_TYRANT_DEATH_HANDLED, FALSE))
                {
                    set(FG_ROOM, F_ROOM_TYRANT_DEATH_HANDLED, TRUE);
                    set(FG_SCENARIO, F_SCENARIO_TYRANT_1_DEAD, TRUE);
                    aot_reset(AOT_00_DOOR_514, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 159, 255, 0);
                    if (ck(FG_ROOM, F_ROOM_DEVICE_TRIED_EARLY, FALSE))
                    {
                        aot_reset(AOT_01_MESSAGE_CONTROL_DEVICE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, door_lock_switch, 0);
                    }
                    else
                    {
                        aot_reset(AOT_01_MESSAGE_CONTROL_DEVICE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, door_lock_device, 0);
                    }
                }
            }
            else if (cmpb(B_FWD_AOT, CMP_EQ, 1))
            {
                set(FG_ROOM, F_ROOM_DEVICE_TRIED_EARLY, TRUE);
            }
            if (ck(FG_ROOM, F_ROOM_TYRANT_DEATH_HANDLED, TRUE) && ck(FG_ROOM, F_ROOM_DEVICE_TRIED_EARLY, FALSE) && ck(FG_ROOM, F_ROOM_DEVICE_SEEN_AFTER, FALSE) && ck(FG_ROOM, F_ROOM_DOOR_UNLOCKED, FALSE) && cmpb(B_FWD_AOT, CMP_EQ, 1))
            {
                set(FG_ROOM, F_ROOM_DEVICE_SEEN_AFTER, TRUE);
                aot_reset(AOT_01_MESSAGE_CONTROL_DEVICE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, door_lock_device, 0);
            }
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_513_KEY_LAB_MASTER_0, FALSE) && ck(FG_ROOM, F_ROOM_KEY_TAKEN, FALSE))
            {
                set(FG_ROOM, F_ROOM_KEY_TAKEN, TRUE);
                objtbl_b_set(TBL_OBJ, OBJ_06_KEY_LAB_MASTER, 0);
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE) && ck(FG_ROOM, F_ROOM_TYRANT_SCENE_OVER, FALSE))
        {
            if (ck(FG_ENEMY, F_ENEMY_513_TYRANT_1_1, TRUE))
            {
                if (ck(FG_ROOM, F_ROOM_TYRANT_DEATH_HANDLED, FALSE))
                {
                    set(FG_ROOM, F_ROOM_TYRANT_DEATH_HANDLED, TRUE);
                    set(FG_SCENARIO, F_SCENARIO_TYRANT_1_DEAD, TRUE);
