        se_play_3d(SND_BANK_ROOM, SE_18_BUBBLE_L, 0, SND_AT_POINT, 0, 11260, 4844);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    sleep(4);
    act_idle();
    act_nop();
    act_motion_path(MOTION_32, 0, -300, 0, 192, 20);
    sleep(15);
    act_anim_flags(ANIM_02, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0002);
    sleep(4);
    act_reset();
    evt_nop();
