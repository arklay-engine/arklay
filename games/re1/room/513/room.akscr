    act_motion_path(MOTION_31, 600, 0, 0, 192, 64);
    act_reset();
    evt_nop();
    sleep(50);
    evt_work_set(WK_ENEMY, ENEMY_01_TYRANT_1);
    evt_actor_begin();
    act_motion_path(MOTION_11, 700, 0, 0, 50, 64);
    sleep(25);
    act_reset();
    evt_nop();
    sleep(10);
    evt_work_set(WK_ENEMY, ENEMY_01_TYRANT_1);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 50, 64);
    sleep(25);
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, F_STATUS_VOICE_PLAYING, TRUE));
    cutnext(CAM_02);
    evt_fork(TASK_07, place_props_cam_02, 0);
    evt_next();
    evt_nop();
    voice_play(VOICE_PLAY, VO_116_05);
    message(MSG_VO_116_05, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_PLAYER_ANIM_DONE, 0);
    sleep(15);
    act_anim_flags(ANIM_31, F_ROOM_PLAYER_ANIM_DONE, 0);
    sleep(30);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    wait_message();
    sleep(10);
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    sleep(20);
    eml_state(0, ENEMY_01_TYRANT_1, EML_BEHAVIOUR, EB_00);
    evt_finish();
}

