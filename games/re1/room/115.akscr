        se_play_3d(SND_BANK_ROOM, SE_1A, 0, SND_AT_PLAYER, 0, 0, 0);
        se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_PLAYER, 0, 0, 0);
        se_play_3d(SND_BANK_ROOM, SE_1C, 0, SND_AT_PLAYER, 0, 0, 0);
    }
