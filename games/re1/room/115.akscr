#if CHRIS
event event_04
#else
event event_0C
#endif
{
    run
    {
        if (cmpw(0, 3, 1, 10000))
        {
            if (cmpw(0, 3, 3, 20000))
            {
                effect(8, 20, 128, 208, 253, 20, 0, 62, 244, 0, 0);
            }
            else
            {
                effect(8, 20, 128, 178, 2, 20, 0, 62, 244, 0, 0);
            }
        }
        else
        {
            effect(8, 20, 128, 238, 248, 20, 0, 62, 244, 0, 0);
        }
    }
    sleep(1);
    run
    {
        if (cmpw(0, 3, 1, 10000))
        {
            if (cmpw(0, 3, 3, 20000))
            {
                effect(8, 20, 128, 208, 253, 20, 0, 68, 12, 0, 0);
            }
            else
            {
                effect(8, 20, 128, 178, 2, 20, 0, 68, 12, 0, 0);
            }
        }
        else
        {
            effect(8, 20, 128, 238, 248, 20, 0, 68, 12, 0, 0);
        }
    }
    sleep(1);
    run
    {
        if (cmpw(0, 3, 1, 10000))
        {
            if (cmpw(0, 3, 3, 20000))
            {
                effect(8, 20, 128, 12, 244, 20, 0, 242, 249, 0, 0);
            }
            else
            {
                effect(8, 20, 128, 12, 244, 20, 0, 0, 0, 0, 0);
            }
        }
        else
        {
            effect(8, 20, 128, 12, 244, 20, 0, 14, 6, 0, 0);
        }
    }
    sleep(1);
    run
    {
        if (cmpw(0, 3, 1, 10000))
        {
            if (cmpw(0, 3, 3, 20000))
            {
                effect(8, 20, 128, 104, 11, 20, 0, 242, 249, 0, 0);
            }
            else
            {
                effect(8, 20, 128, 104, 11, 20, 0, 0, 0, 0, 0);
            }
        }
        else
        {
            effect(8, 20, 128, 104, 11, 20, 0, 14, 6, 0, 0);
        }
    }
    sleep(10);
#if CHRIS
    evt_chain(3);
#else
    evt_chain(12);
#endif
    evt_nop();
    evt_nop();
}
