event event_09
{
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    evt_actor_begin();
    sleep(1);
    act_anim_flags(ANIM_32, F_ROOM_3F, AFL_01);
    sleep(40);
    act_motion_path(MOTION_13, 4900, -8000, 4900, 100, 100);
    sleep(20);
    act_motion(MOTION_10);
    act_anim_flags(ANIM_30, F_ROOM_3F, 0);
