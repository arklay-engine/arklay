event on_enter
#else
event event_00
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    set(FG_6, F_6_17, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 2, 32 | 31, 0 | 0);
    act_reset();
    evt_nop();
    sleep(10);
    voice_play(1, 48, 0);
    message(0, 0);
    wait_message();
    dir_set(0, 0, 1648, 0, 12700, 0, 15500);
    cutnext(4);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_reset();
    evt_nop();
    voice_play(1, 49, 0);
    message(1, 0);
    evt_fork(9, event_0D, 0);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 6, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 0, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 6, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 0, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 3, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 2, 32 | 31, 0 | 3);
    sleep(30);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        dir_set(0, 0, 1648, 0, 2700, 0, 5500);
        cutnext(1);
        voice_play(1, 50, 0);
        message(2, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 1, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 0, 32 | 31, 0 | 0);
    sleep(14);
    act_anim_flags(32 | 3, 32 | 31, 0 | 0);
    sleep(8);
    act_anim_flags(32 | 1, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 4, 32 | 31, 0 | 0);
    sleep(15);
    act_anim_flags(32 | 3, 32 | 31, 0 | 0);
    sleep(10);
    act_anim_flags(32 | 1, 32 | 31, 0 | 0);
    sleep(10);
    act_anim_flags(32 | 0, 32 | 31, 0 | 0);
    act_reset();
    evt_nop();
    wait_message();
    evt_chain(1);
}

