    tw_set_sel(TW_POS_X, 4860);
    tw_set_sel(TW_POS_Z, 4860);
    tw_end();
    evt_nop();
    set(FG_STATUS, F_STATUS_07, TRUE);
    evt_work_set(WK_OBJ, OBJ_00);
