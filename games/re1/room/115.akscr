event on_enter
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -8690, 4860);
    tw_end();
    evt_nop();
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_STATUS, F_STATUS_0F, TRUE);
    evt_nop();
    evt_nop();
}

event event_03
{
    set(FG_LOCK, F_LOCK_02, FALSE);
    sleep(15);
    se_play_3d(SND_BANK_ROOM, SE_18_LOCK_MIX, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 6600, 0, 2300, 100, 100);
    act_reset();
    evt_nop();
    snd_pan_vol_set(BGM_MAIN, 30, 30);
    bgm_play(BGM_SUB_1);
    sleep(45);
    snd_pan_vol_set(BGM_MAIN, 110, 110);
    bgm_play(BGM_MAIN);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_exec(0, TASK_09, event_07);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 4900, -8000, 4900, 100, 100);
    sleep(40);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    sleep(10);
    evt_nop();
    evt_nop();
}

event event_04
{
    run
    {
        dir_set(0, 0, 3072, 0, 5200, 0, 2500);
        cutnext(CAM_02);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -10500, 4860);
    tw_end();
    evt_nop();
    run
    {
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        evt_exec(0, TASK_09, event_08);
    }
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(0, 7, 0);
    for (450)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_fork(TASK_09, event_00, 0);
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(0, 5, 0);
    for (10000)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

