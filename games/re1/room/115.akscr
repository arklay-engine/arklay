event on_enter_2_sub1
{
    snd_pan_vol_set(BGM_MAIN, 30, 30);
    bgm_play(BGM_SUB_1);
    sleep(45);
    snd_pan_vol_set(BGM_MAIN, 110, 110);
    bgm_play(BGM_MAIN);
    evt_fork(TASK_06, on_enter_2_sub1_sub1, 0);
    evt_fork(TASK_07, on_enter_2_sub1_sub2, 0);
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(0, 7, 0);
    for (140)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_finish();
}
