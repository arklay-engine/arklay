    bgm_play(1);
    sleep(45);
    snd_pan_vol_set(0, 110, 110);
    bgm_play(0);
    evt_fork(6, on_enter_2_sub1_sub1, 0);
    evt_fork(7, on_enter_2_sub1_sub2, 0);
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 7, 0);
    for (140)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_finish();
}
#endif
