event on_enter
{
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -8690, 4860);
    tw_end();
    evt_nop();
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    set(FG_STATUS, F_STATUS_0F, TRUE);
    evt_nop();
    evt_nop();
}

