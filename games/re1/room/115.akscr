#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define ENEMY_00_NPC_BARRY 0x00
#define ENEMY_01_NPC_BARRY 0x01
#define FX_08 0x08
#define F_ROOM_03 0x03
#define F_ROOM_04 0x04
#define F_ROOM_3F 0x3F
#define MSG_VO_105_00 0x00
#define MSG_VO_105_01 0x01
#define MSG_VO_105_02 0x02
#define MSG_VO_105_03 0x03
#define MSG_VO_105_04 0x04
#define OBJ_00 0x00
#define OBJ_01 0x01
#define OBJ_02 0x02
#define SE_17_KICKDOOR 0x17
#define SE_18_LOCK_MIX 0x18
#define SE_19_CEILPRES 0x19
#define SE_1A 0x1A
#define SE_1B 0x1B
#define SE_1C 0x1C
#define SE_1D_TAO_WALL 0x1D
#define VO_105_00 0x30
#define VO_105_01 0x31
#define VO_105_02 0x32
#define VO_105_03 0x33
#define VO_105_04 0x34

proc init
{
    door_aot_set(AOT_00_DOOR, 900, 4000, 1350, 2500, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCKED | F_LOCK_00, ROOM_109_TRAP_PASSAGE, 6700, 0, 9800, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 5300, 1400, 2400, 1000, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, DOOR_LOCKED | F_LOCK_01, ROOM_116_LIVING_ROOM, 4850, 0, 10250, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    obj(OBJ_00, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 4860, -10280, 4860, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_01, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 1760, 0, 3960, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_02, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 7590, 0, 8680, 0, 0, 0, 0, 0, 0, 0, 0, 0);
#if CHRIS
    set(FG_LOCK, F_LOCK_01, TRUE);
    if (ck(FG_ITEM, F_ITEM_00, FALSE) && ck(FG_ITEM, F_ITEM_01, FALSE) && ck(FG_COMMON, F_COMMON_20, FALSE))
    {
        set(FG_LOCK, F_LOCK_00, FALSE);
        set(FG_LOCK, F_LOCK_02, FALSE);
        cut_auto(CUT_LOCKED);
        setb(B_CAMERA, CAM_03, 0);
        evt_exec(0, TASK_09, on_enter);
        dir_set(0, 0, 3072, 0, 5200, 0, 2500);
    }
    else
    {
        set(FG_LOCK, F_LOCK_00, TRUE);
        set(FG_LOCK, F_LOCK_02, TRUE);
    }
#else
    enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 6900, 0, 9600, ENEMY_00_NPC_BARRY, ANIM_00, 0, EVAR_00);
    enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 450, 0, 5000, ENEMY_01_NPC_BARRY, ANIM_00, 0, EVAR_00);
    if (ck(FG_COMMON, F_COMMON_07, TRUE))
    {
        set(FG_COMMON, F_COMMON_21, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_5F, TRUE))
    {
        set(FG_COMMON, F_COMMON_21, TRUE);
    }
    if (ck(FG_ITEM, F_ITEM_00, FALSE) && ck(FG_ITEM, F_ITEM_01, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_07, FALSE) && ck(FG_COMMON, F_COMMON_5F, FALSE))
        {
            set(FG_LOCK, F_LOCK_00, FALSE);
            set(FG_LOCK, F_LOCK_01, FALSE);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_03, 0);
            dir_set(0, 0, 3072, 0, 5200, -400, 2500);
            evt_exec(0, TASK_09, on_enter);
        }
        else if (ck(FG_COMMON, F_COMMON_29, FALSE))
        {
            set(FG_LOCK, F_LOCK_00, FALSE);
            set(FG_LOCK, F_LOCK_01, FALSE);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_03, 0);
            dir_set(0, 0, 3072, 0, 5200, -400, 2500);
            set(FG_LOCK, F_LOCK_01, TRUE);
            evt_exec(0, TASK_09, on_enter_2);
        }
        else
        {
            set(FG_LOCK, F_LOCK_00, TRUE);
            set(FG_LOCK, F_LOCK_01, TRUE);
        }
    }
    else
    {
        set(FG_LOCK, F_LOCK_00, TRUE);
        set(FG_LOCK, F_LOCK_01, TRUE);
    }
#endif
}

#if CHRIS
event on_enter
#else
event event_00
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_3F, 0);
    act_reset();
    evt_nop();
    sleep(10);
    voice_play(VOICE_PLAY, VO_105_00);
    message(MSG_VO_105_00, 0);
    wait_message();
    dir_set(0, 0, 1648, 0, 12700, 0, 15500);
    cutnext(CAM_04);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_reset();
    evt_nop();
    voice_play(VOICE_PLAY, VO_105_01);
    message(MSG_VO_105_01, 0);
    evt_fork(TASK_09, event_0D, 0);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_20, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_26, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_20, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_23, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_22, F_ROOM_3F, AFL_02 | AFL_01);
    sleep(30);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        dir_set(0, 0, 1648, 0, 2700, 0, 5500);
        cutnext(CAM_01);
        voice_play(VOICE_PLAY, VO_105_02);
        message(MSG_VO_105_02, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_20, F_ROOM_3F, 0);
    sleep(14);
    act_anim_flags(ANIM_23, F_ROOM_3F, 0);
    sleep(8);
    act_anim_flags(ANIM_21, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_24, F_ROOM_3F, 0);
    sleep(15);
    act_anim_flags(ANIM_23, F_ROOM_3F, 0);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_3F, 0);
    sleep(10);
    act_anim_flags(ANIM_20, F_ROOM_3F, 0);
    act_reset();
    evt_nop();
    wait_message();
    evt_chain(1);
}

event event_01
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        voice_play(VOICE_PLAY, VO_105_03);
        message(MSG_VO_105_03, 0);
    }
    sleep(50);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_04, 4900, 6900, F_ROOM_04);
