#endif
{
    run
    {
        effect(FX_08, 20, 128, 12, 244, 20, 0, 62, 244, 0, 0);
        effect(FX_08, 20, 128, 12, 244, 20, 0, 68, 12, 0, 0);
        effect(FX_08, 20, 128, 124, 11, 20, 0, 68, 12, 0, 0);
        effect(FX_08, 20, 128, 124, 11, 20, 0, 62, 244, 0, 0);
    }
    sleep(20);
