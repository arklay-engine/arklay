event event_03
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 0 | 2, 0 | 0);
    act_flag_op(1, 2, 0);
    act_param_set(0, 8);
    for (41)
    {
        evt_next();
    }
    act_idle();
    act_reset();
    evt_finish();
}

event event_04
{
    bgm_volume_ramp(2, 161, 30);
    sleep(30);
    bgm_stop(2);
    sleep(5);
    bgm_play(0);
    evt_finish();
}

event event_05
{
    run
    {
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
        set(FG_6, 28, 1);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    sleep(26);
    act_reset();
    evt_nop();
    message(129, 383);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            aot_reset(2, SCE_F, 129, 0, 1, 0);
            aot_on(2, SCE_F, 0);
            message(132, 511);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        set(FG_6, 28, 0);
    }
    evt_finish();
}

event event_06
{
    aot_reset(3, SCE_DOCUMENT, 129, 0, 0, 0);
    aot_on(3, SCE_DOCUMENT, 0);
    evt_finish();
}
