event slide_wall_across
{
    se_play_3d(SND_BANK_ROOM, SE_19_R_PASS, 0, SND_AT_POINT, 0, 9150, 10000);
    evt_work_set(WK_OBJ, OBJ_01_SLIDING_WALL);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, -28);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, F_SCENARIO_ITEM_PASSAGE_WALL_MOVED, TRUE);
    inst_cfg(COL_LIST_00, COL_02, 0, 7182, 8280, 9144, 11322);
    evt_finish();
}

event slide_wall_back
{
    se_play_3d(SND_BANK_ROOM, SE_19_R_PASS, 0, SND_AT_POINT, 0, 9150, 10000);
    evt_work_set(WK_OBJ, OBJ_01_SLIDING_WALL);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 28);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, F_SCENARIO_ITEM_PASSAGE_WALL_MOVED, FALSE);
    inst_cfg(COL_LIST_00, COL_02, 0, 0, 0, 2, 2);
    evt_finish();
}

event raise_book_cover
{
    evt_work_set(WK_OBJ, OBJ_03_BOOK_COVER);
    evt_tween_begin_alt();
    tw_set_pos(0, -80, 0);
    for (10)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, F_ROOM_BOOK_COVER_MOVING, FALSE);
    evt_finish();
}

event lower_book_cover
{
    evt_work_set(WK_OBJ, OBJ_03_BOOK_COVER);
    evt_tween_begin_alt();
    tw_set_pos(0, 80, 0);
    for (10)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, F_ROOM_BOOK_COVER_MOVING, FALSE);
    evt_finish();
}

event crank_blocked_by_statue
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_I_CANNOT_USE_THE_CRANK_BECAUSE | MSG_FAST, 0); // "I can't use the crank because of the statue."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
}
