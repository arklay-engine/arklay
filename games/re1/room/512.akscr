#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define FLAG_ROOM_16 0x16

proc init
{
    door_aot_set(0, 4800, 10400, 1300, 1200, 3, 1, 14, 3, 0, ROOM_50B_FRONT_OF_CELL, 9800, 0, 15800, 3072, UNLOCKED, 129);
    room_bgm_state_set(4, 18, 255);
    if (ck(FG_SCENARIO, FLAG_SCENARIO_2B, TRUE))
    {
        room_bgm_state_set(4, 18, 57);
    }
    if (ck(FG_COMMON, FLAG_COMMON_4B, FALSE))
    {
#if CHRIS
        enemy(ENEMY_21_NPC_JILL, 0, 255, 1, 2, 0, 0, 3000, 0, 0, 5680, 0, 2930, 0, 0, 0, 0);
        sys_multi(0);
        plw_anim(0, 0, 0);
        eml_state(0, 0, 3, 258);
        dir_set(0, 0, 1024, 0, 5670, 0, 9100);
#else
        enemy(ENEMY_20_NPC_CHRIS, 0, 255, 1, 2, 0, 0, 3000, 0, 0, 5680, 0, 2930, 0, 0, 0, 0);
#endif
        evt_exec(0, 9, event_00);
        set(FG_COMMON, FLAG_COMMON_4B, TRUE);
        room_bgm_state_set(4, 18, 16);
    }
    aot_set(1, 1800, 3100, 900, 1400, SCE_MESSAGE, 129, 139, 0, 255, 0, 0, 0);
    aot_set(2, 7000, 2000, 1800, 3600, SCE_MESSAGE, 129, 138, 0, 255, 0, 0, 0);
}

event event_00
{
    sleep(1);
#if CHRIS
    run
    {
        pos_set(0, 0, 0, 0, 5680, 0, 2930);
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        if (ck(FG_SCENARIO, FLAG_SCENARIO_65, TRUE))
        {
            evt_exec(0, 9, event_01);
        }
        else
        {
            evt_exec(0, 9, event_02);
        }
    }
#else
    run
    {
        dir_set(0, 0, 1024, 0, 5670, 0, 9200);
    }
    set(FG_6, FLAG_6_17, FALSE);
    set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    sleep(20);
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_65, TRUE))
        {
            evt_exec(0, 9, event_01);
        }
        else
        {
            evt_exec(0, 9, event_02);
        }
    }
#endif
    evt_finish();
}

