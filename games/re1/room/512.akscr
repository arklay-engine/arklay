    evt_nop();
    sleep(25);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 6, 0 | 20, 0 | 1);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 0 | 20, 0 | 0);
    act_param_set(0, 8);
    act_reset();
    evt_nop();
    sleep(45);
    run
    {
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        set(FG_6, FLAG_6_17, TRUE);
        cut_auto(0);
        aot_on(0, SCE_DOOR, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
#else
    act_anim_flags(32 | 10, 0 | 20, 0 | 3);
    act_flag_op(0, 16, 0);
#endif
    act_reset();
    evt_nop();
    evt_finish();
}
