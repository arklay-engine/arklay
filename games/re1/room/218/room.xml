  <strings>
    <language lang="en-US">
      <string key="save_name">Hall 1F</string>
      <string key="0">I can look over the\ncourtyard from here.</string>
      <string key="1">\nIt's a helicopter port!{clear 0}If I could contact the\nother members from there...</string>
      <string key="2">\nA battery.{clear 0}Now I can move the\nelevator in the courtyard.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}ホ{s}ー{s}ル{s}/{s}1{s}F{s}</string>
      <string key="0">\n     中庭が見わたせる</string>
      <string key="1">\n     ヘリポートがある!{clear 0}  あそこで仲間と連絡が取れれば\n  ここから脱出できるのだが・・・</string>
      <string key="2">\n     バッテリーがある{clear 0}  これで中庭のエレベーターを\n  動かせそうだ…</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Hall RdC</string>
      <string key="0">\nD'ici je surplombe la cour.</string>
      <string key="1">\nC'est un héliport!{clear 0}Si je pouvais contacter les\nautres membres de là.</string>
      <string key="2">\nUne batterie.{clear 0}A présent, je peux actionner\nl'ascenseur dans la cour.</string>
    </language>
    <language lang="de-DE">
      <string key="0">Von hier aus kann ich\nden Hof überblicken.</string>
      <string key="1">\nEin Helikopter-Landeplatz!{clear 0}Vielleicht kann ich die\nanderen von dort erreichen...</string>
      <string key="2">\nEine Batterie.{clear 0}Jetzt kann ich den Aufzug\nim Hof in Betrieb setzen.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Atrio 1P</string>
      <string key="0">Da qui riesco a vedere \nil cortile.</string>
      <string key="1">\nÈ un eliporto!{clear 0}Se riuscissi a contattare \ngli altri da qui...</string>
      <string key="2">\nUna batteria.{clear 0}Adesso posso azionare \nl'ascensore nel cortile.</string>
    </language>
    <language lang="es-ES">
      <string key="0">\nDesde aquí puedo ver el patio...</string>
      <string key="1">\n¡Hay un helipuerto!{clear 0}Si pudiera contactar a Brad,\npodríamos escapar desde allí...</string>
      <string key="2">\nUna batería...{clear 0}Ahora puedo hacer funcionar\nel ascensor del patio...</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Зал 1-эт.</string>
      <string key="0">Отсюда можно увидеть\nвнутренний двор.</string>
      <string key="1">\nЭто вертолетная площадка!{clear 0}Если бы я мог связаться с другими\nчленами команды отсюда...</string>
      <string key="2">\nБатарея.{clear 0}Теперь я могу\nперемещаться на лифте.</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Pääaula 1 krs</string>
      <string key="0">Nään täältä sisäpihan yli...</string>
      <string key="1">Tuolla on helikopterikenttä!{clear 0}Jos tuolta saisin muihin\nyhteyttä...</string>
      <string key="2">Akku...{clear 0}Tällä saan sisäpihan hissin\ntoimimaan...</string>
    </language>
  </strings>
