#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_216 0x00
#define AOT_01_EVENT_WINDOW 0x01
#define AOT_02_ITEM_AMMO_HANDGUN_0 0x02
#define AOT_03_ITEM_INK_1 0x03
#define AOT_04 0x04
#define AOT_05 0x05
#define CAM_01_TOWARD_WINDOW 0x01                           // Likely.
#define CAM_02_HELIPORT_VIEW 0x02                           // Likely: a placeholder camera for the heliport view.
#define F_ROOM_PLAYER_ANIM_DONE 0x23                        // The player's animation finished (one frame); only the unused battery event raises it.
#define IMDL_00_AMMO_HANDGUN 0x00
#define IMDL_01_INK 0x01
#define MSG_A_BATTERY 0x02
#define MSG_IT_IS_A_HELICOPTER_PORT 0x01
#define MSG_I_CAN_LOOK_OVER_THE_COURTYARD 0x00

proc init
{
    if (MANSION2)
    {
        door_aot_set(AOT_00_DOOR_216, 4600, 1200, 900, 1300, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_216_LIBRARY_A, 5200, 0, 15200, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        aot_set(AOT_01_EVENT_WINDOW, 4500, 8500, 2200, 1000, SCE_EVENT, SAT_PLAYER, 0, 0, look_at_heliport, 0, 0, 0);
        item_aot_set(AOT_02_ITEM_AMMO_HANDGUN_0, 7100, 2000, 1000, 1000, IT_0B_AMMO_HANDGUN, 15, IMDL_00_AMMO_HANDGUN, SCA_NONE, 7300, -2000, 2500, 3072, F_ITEM_218_AMMO_HANDGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
        if (USA)
        {
            item_aot_set(AOT_03_ITEM_INK_1, 4200, 4600, 2400, 1800, IT_2F_KEY_INK_RIBBON, 2, IMDL_01_INK, SCA_NONE, 4760, -2000, 6000, 1024, F_ITEM_218_INK_1, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_03_ITEM_INK_1, 4200, 4600, 2400, 1800, IT_2F_KEY_INK_RIBBON, 3, IMDL_01_INK, SCA_NONE, 4760, -2000, 6000, 1024, F_ITEM_218_INK_1, SAT_MANUAL | SAT_PLAYER, 0);
        }
        set(FG_SCENARIO, F_SCENARIO_HIDDEN_LIBRARY_ENTERED, TRUE);
    }
}

proc main
{
    if (MANSION2)
    {
        if (ck(FG_ITEM, F_ITEM_218_AMMO_HANDGUN_0, FALSE))
        {
            aot_delete(AOT_05, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
    }
}

event unused_empty
{
    evt_finish();
}

event look_at_heliport
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        aot_delete(AOT_01_EVENT_WINDOW, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        message(MSG_I_CAN_LOOK_OVER_THE_COURTYARD | MSG_FAST, 0); // "I can look over the courtyard from here."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        cutnext(CAM_02_HELIPORT_VIEW);
        dir_set(0, 0, 2920, 0, 5000, 0, 7850);
        if (ck(FG_SCENARIO, F_SCENARIO_HELIPORT_SEEN, FALSE))
        {
            set(FG_SCENARIO, F_SCENARIO_HELIPORT_SEEN, TRUE);
        }
    }
    message(MSG_IT_IS_A_HELICOPTER_PORT | MSG_FAST, 0); // "It's a helicopter port! If I could contact the other members from there..."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    do
    {
        evt_next();
    }
    while (ck_bits(FALSE, PAD_8000 | PAD_4000 | PAD_2000 | PAD_1000 | PAD_0800 | PAD_0400 | PAD_0200 | PAD_0100 | PAD_0080 | PAD_0040 | PAD_0020 | PAD_0010 | PAD_0008 | PAD_0004 | PAD_0002 | PAD_0001));
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cutnext(CAM_01_TOWARD_WINDOW);
    sleep(5);
    run
    {
        aot_delete(AOT_01_EVENT_WINDOW, SCE_EVENT, SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event unused_battery_message
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_A_BATTERY | MSG_FAST, 0); // "A battery. Now I can move the elevator in the courtyard."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    aot_on(AOT_04, SCE_ITEM, 0);
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}
