#version 1

proc init
{
    door_aot_set(0, 19500, 4100, 2300, 1600, 0, 6, 21, 64, 0, RDT_000, 5000, 0, 11400, 0, UNLOCKED, 128);
    door_aot_set(1, 20200, 27400, 2600, 2000, 0, 6, 21, 64, 0, RDT_001, 3400, 0, 12800, 3072, UNLOCKED, 192);
    door_aot_set(2, 0, 21100, 3500, 2900, 0, 8, 15, 64, 0, RDT_004, 28600, 0, 4000, 2048, UNLOCKED, 129);
    door_aot_set(3, 13300, 27300, 2100, 2800, 1, 11, 27, 64, 0, RDT_007, 11400, 0, 4200, 3072, UNLOCKED, 128);
    aot_set(4, 17200, 1800, 1000, 500, SCE_USEITEM, 1, 9, 0, 12, 0, 1, 0);
    aot_set(5, 17200, 1800, 1000, 500, SCE_USEITEM, 1, 4, 0, 33, 0, 1, 0);
    if (ck(FG_SCENARIO, 50, 0))
    {
        aot_set(6, 17200, 1800, 1000, 500, SCE_MESSAGE, 129, 130, 0, 255, 0, 0, 0);
    }
    else
    {
        aot_set(6, 17200, 1800, 1000, 500, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, 48, 0))
    {
        aot_set(7, 22400, 27900, 1300, 900, SCE_EVENT, 193, 9, 0, event_01, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, 49, 1))
    {
        if (ck(FG_SCENARIO, 50, 0))
        {
            aot_set(8, 20000, 4200, 1000, 1200, SCE_EVENT, 193, 9, 0, event_02, 0, 0, 0);
        }
        else
