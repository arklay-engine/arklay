    {
        enemy(ENEMY_CERBERUS, 0, 172, 1, 2, 0, 0, 1024, 0, 0, 20000, 0, 19300, 2, 0, 0, 0);
    }
    return;
}

proc main
{
    if (ck(FG_SCENARIO, 50, 1))
    {
        if (testitem(ITEM_BATTERY))
        {
            if (ck(FG_ROOM, 33, 0))
            {
                evt_exec(0, 9, event_06);
            }
        }
    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 0))
        {
            if (ck(FG_ROOM, 0, 1))
            {
                snd_pan_vol_set(1, 75, 60);
                set(FG_ROOM, 0, 0);
                set(FG_ROOM, 1, 1);
                set(FG_ROOM, 2, 1);
                set(FG_ROOM, 3, 1);
                set(FG_ROOM, 4, 1);
                set(FG_ROOM, 5, 1);
                set(FG_ROOM, 6, 1);
                set(FG_ROOM, 7, 1);
            }
