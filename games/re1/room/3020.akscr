event event_0C
{
    run
    {
        set(FG_6, 29, 1);
        set(FG_6, 23, 1);
        message(131, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, event_0D);
        }
        else
        {
            evt_exec(0, 9, event_0E);
        }
    }
    evt_finish();
}

event event_0D
{
    run
    {
        if (ck(FG_STATUS, 8, 1))
        {
            setb(9, 4, 0);
        }
        else
        {
            setb(9, 5, 0);
        }
        door_aot_set(3, 13300, 25300, 5000, 5000, 1, 11, 27, 64, 0, RDT_007, 11400, 0, 4200, 3072, UNLOCKED, 65);
        set(FG_6, 29, 0);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_0E
{
    run
    {
        set(FG_6, 29, 0);
        set(FG_6, 23, 0);
    }
    evt_finish();
}
