    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 1))
        {
            if (ck(FG_ROOM, 1, 1))
            {
                snd_pan_vol_set(1, 75, 55);
                set(FG_ROOM, 0, 1);
                set(FG_ROOM, 1, 0);
                set(FG_ROOM, 2, 1);
                set(FG_ROOM, 3, 1);
                set(FG_ROOM, 4, 1);
                set(FG_ROOM, 5, 1);
                set(FG_ROOM, 6, 1);
                set(FG_ROOM, 7, 1);
            }
        }
    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 2))
        {
            if (ck(FG_ROOM, 2, 1))
            {
                snd_pan_vol_set(1, 70, 70);
                set(FG_ROOM, 0, 1);
                set(FG_ROOM, 1, 1);
                set(FG_ROOM, 2, 0);
                set(FG_ROOM, 3, 1);
                set(FG_ROOM, 4, 1);
                set(FG_ROOM, 5, 1);
                set(FG_ROOM, 6, 1);
                set(FG_ROOM, 7, 1);
            }
        }
    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 3))
        {
            if (ck(FG_ROOM, 3, 1))
            {
                set(FG_ROOM, 0, 1);
                set(FG_ROOM, 1, 1);
                set(FG_ROOM, 2, 1);
                set(FG_ROOM, 3, 0);
                set(FG_ROOM, 4, 1);
                set(FG_ROOM, 5, 1);
                set(FG_ROOM, 6, 1);
                set(FG_ROOM, 7, 1);
            }
        }
    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 4))
        {
            if (ck(FG_ROOM, 4, 1))
            {
                snd_pan_vol_set(1, 80, 80);
                set(FG_ROOM, 0, 1);
                set(FG_ROOM, 1, 1);
                set(FG_ROOM, 2, 1);
                set(FG_ROOM, 3, 1);
                set(FG_ROOM, 4, 0);
                set(FG_ROOM, 5, 1);
                set(FG_ROOM, 6, 1);
                set(FG_ROOM, 7, 1);
            }
        }
    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 5))
        {
            if (ck(FG_ROOM, 5, 1))
            {
                snd_pan_vol_set(1, 55, 75);
                set(FG_ROOM, 0, 1);
                set(FG_ROOM, 1, 1);
                set(FG_ROOM, 2, 1);
                set(FG_ROOM, 3, 1);
                set(FG_ROOM, 4, 1);
                set(FG_ROOM, 5, 0);
                set(FG_ROOM, 6, 1);
                set(FG_ROOM, 7, 1);
            }
        }
    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 6))
        {
            if (ck(FG_ROOM, 6, 1))
            {
                snd_pan_vol_set(1, 60, 60);
                set(FG_ROOM, 0, 1);
                set(FG_ROOM, 1, 1);
                set(FG_ROOM, 2, 1);
                set(FG_ROOM, 3, 1);
                set(FG_ROOM, 4, 1);
                set(FG_ROOM, 5, 1);
                set(FG_ROOM, 6, 0);
                set(FG_ROOM, 7, 1);
            }
        }
    }
    if (ck(FG_SCENARIO, 47, 0))
    {
        if (cmpb(2, 0, 7))
        {
            if (ck(FG_ROOM, 7, 1))
            {
                snd_pan_vol_set(1, 55, 40);
                set(FG_ROOM, 0, 1);
