}

event event_00
{
    evt_finish();
}

event event_01
{
    run
    {
        se_play_3d(2, 33, 0, 0, 0, 23200, 28700);
        set(FG_6, 23, 1);
        sys_multi(1, 128);
        evt_exec(0, 9, event_03);
        evt_exec(0, 9, event_05);
    }
    sleep(70);
    timer_setup(2, 128, 8, 7, 0);
    sleep(7);
    run
    {
        setw(2, 0, 0);
        aot_on(1, SCE_DOOR, 129);
        set(FG_SCENARIO, 48, 1);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_02
{
    run
    {
        se_play_3d(2, 33, 0, 0, 0, 20900, 5000);
        set(FG_6, 23, 1);
        sys_multi(1, 128);
        evt_exec(0, 9, event_04);
        evt_exec(0, 9, event_05);
    }
    sleep(70);
    timer_setup(2, 0, 4, 7, 0);
    sleep(7);
    run
    {
        setw(2, 0, 0);
        aot_on(0, SCE_DOOR, 129);
        set(FG_SCENARIO, 49, 0);
        set(FG_6, 23, 0);
        if (cmpb(9, 0, 3))
        {
            setb(9, 0, 0);
        }
        if (cmpb(9, 0, 4))
        {
            setb(9, 1, 0);
        }
        if (cmpb(9, 0, 5))
        {
            setb(9, 2, 0);
        }
    }
    evt_finish();
}

event event_03
{
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 231, 0);
    for (70)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event event_04
{
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 231, 0);
    for (70)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event event_05
{
    for (70)
    {
        spd_add(231);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 231, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    evt_finish();
}

event event_06
{
    evt_work_set(WK_OBJ, 3);
    evt_tween_begin_alt();
    tw_abs_pos(0, 17660, -1550, 1710);
    tw_end();
    evt_nop();
    run
    {
        objtbl_b_set(0, 3, 37);
        aot_reset(6, SCE_MESSAGE, 129, 130, 255, 0);
        aot_reset(8, SCE_EVENT, 193, 9, event_02, 0);
        se_play_3d(2, 23, 0, 0, 0, 17700, 2500);
        set(FG_SCENARIO, 50, 0);
    }
    evt_finish();
}

