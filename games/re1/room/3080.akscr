    tw_set_pos(0, 243, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 246, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 250, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 252, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 254, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 8, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 252, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 254, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 253, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 254, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 255, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 255, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    aot_delete(4, SCE_EVENT, 129);
    evt_finish();
}

