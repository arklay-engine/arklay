#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_ITEM 0x05
#define AOT_0A_MESSAGE 0x0A
#define AOT_0B_MESSAGE 0x0B
#define AOT_0C_MESSAGE 0x0C
#define AOT_0D_MESSAGE 0x0D
#define AOT_0E_MESSAGE 0x0E
#define AOT_0F_MESSAGE 0x0F
#define AOT_10_NONE 0x10
#define IMDL_00 0x00
#define IMDL_01 0x01
#define IMDL_02 0x02
#define IMDL_03 0x03
#define IMDL_04 0x04

proc init
{
    door_aot_set(AOT_00_DOOR, 9500, 1900, 1600, 2100, 0, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, 0, ROOM_40E_WATER_TANK, 3000, 0, 26700, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM, 1700, 4300, 1300, 1100, IT_0C_AMMO_SHOTGUN, 7, IMDL_00, SCA_NONE, 2100, -2480, 5100, 0, F_ITEM_7A, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_02_ITEM, 1700, 4300, 1300, 1100, IT_0C_AMMO_SHOTGUN, 7, IMDL_01, SCA_NONE, 2100, -2480, 4400, 0, F_ITEM_83, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(ITEM_ALT_ROT | AOT_03_ITEM, 8400, 6200, 1300, 1200, IT_0B_AMMO_HANDGUN, 15, IMDL_02, SCA_NONE, 9100, -2090, 7000, 600, F_ITEM_70, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(ITEM_ALT_ROT | AOT_04_ITEM, 8400, 6200, 1300, 1200, IT_0B_AMMO_HANDGUN, 15, IMDL_03, SCA_NONE, 8700, -2090, 7000, 600, F_ITEM_5C, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_05_ITEM, 3900, 6270, 1100, 1100, IT_3A_KEY_GUARDHOUSE_003, 1, IMDL_04, SCA_NONE, 4850, -2090, 7280, 3890, F_ITEM_72, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4);
    aot_set(AOT_0A_MESSAGE, 1700, 5700, 1300, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 79, 0, 0, 0);
    aot_set(AOT_0B_MESSAGE, 3000, 6200, 800, 1300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 79, 0, 0, 0);
    aot_set(AOT_0C_MESSAGE, 1700, 1800, 1300, 2200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 79, 0, 0, 0);
    aot_set(AOT_0D_MESSAGE, 7300, 1500, 1400, 1300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 79, 0, 0, 0);
    aot_set(AOT_0E_MESSAGE, 3000, 1400, 4400, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 79, 0, 0, 0);
    aot_set(AOT_0F_MESSAGE, 6400, 6200, 2100, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 79, 0, 0, 0);
    aot_set(AOT_10_NONE, 1700, 4300, 1300, 1100, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 129, 0, 79, 0, 0, 0);
    if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
    {
        aot_delete(AOT_01_ITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_02_ITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_10_NONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
}
