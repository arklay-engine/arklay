#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_EVENT 0x04
#define MSG_A_BATTERY 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 7800, 2000, 1000, 1800, 2, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_213_FRONT_ELEVATOR, 9800, 0, 2900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    item_aot_set(AOT_01_ITEM, 1800, 3200, 1100, 800, IT_0C_AMMO_SHOTGUN, 7, 1, 255, 192, 8, 34, 247, 86, 14, 90, 15, F_ITEM_37, 129, 0, 0);
    item_aot_set(AOT_02_ITEM, 3200, 4100, 600, 1400, IT_0C_AMMO_SHOTGUN, 7, 2, 255, 172, 13, 34, 247, 2, 18, 0, 244, F_ITEM_38, 129, 0, 0);
#else
    item_aot_set(AOT_01_ITEM, 1800, 3200, 1100, 800, IT_10_AMMO_GRENADE_EXPLOSIVE, 6, 1, 255, 192, 8, 34, 247, 86, 14, 90, 15, F_ITEM_37, 129, 0, 0);
    item_aot_set(AOT_02_ITEM, 3200, 4100, 600, 1400, IT_10_AMMO_GRENADE_EXPLOSIVE, 6, 2, 255, 172, 13, 34, 247, 2, 18, 0, 244, F_ITEM_38, 129, 0, 0);
#endif
    item_aot_set(AOT_03_ITEM, 0, 0, 1, 1, IT_27_KEY_BATTERY, 1, 0, 255, 90, 10, 124, 252, 40, 10, 0, 0, F_ITEM_39, 129, 0, 0);
    if (ck(FG_ITEM, F_ITEM_39, TRUE))
    {
        aot_set(AOT_04_EVENT, 2200, 1500, 1000, 1900, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_04, 0, 0, 0);
    }
}

proc main
{
    if (testpickup(IT_27_KEY_BATTERY))
    {
        aot_delete(AOT_04_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
}

event on_aot_04
{
    run
    {
        set(FG_6, F_6_1F, FALSE);
        set(FG_6, F_6_19, FALSE);
        set(FG_6, F_6_1D, FALSE);
        set(FG_6, F_6_1C, FALSE);
        message(MSG_A_BATTERY | MSG_FAST, 0); // "A battery. Now I can move the elevator in the courtyard."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_6, F_6_1F, TRUE);
        set(FG_6, F_6_19, TRUE);
        set(FG_6, F_6_1D, TRUE);
        set(FG_6, F_6_1C, TRUE);
        aot_on(AOT_03_ITEM, SCE_ITEM, 0);
    }
    evt_finish();
}
