#version 1

proc init
{
    door_aot_set(0, 7800, 2000, 1000, 1800, 2, 0, 6, 1, 0, RDT_013, 9800, 0, 2900, 0, UNLOCKED, 129);
#if CHRIS
    item_aot_set(1, 1800, 3200, 1100, 800, ITEM_SHELLS, 7, 1, 255, 192, 8, 34, 247, 86, 14, 90, 15, 55, 129, 0, 0);
    item_aot_set(2, 3200, 4100, 600, 1400, ITEM_SHELLS, 7, 2, 255, 172, 13, 34, 247, 2, 18, 0, 244, 56, 129, 0, 0);
#else
    item_aot_set(1, 1800, 3200, 1100, 800, ITEM_EXPLOSIVE_ROUNDS, 6, 1, 255, 192, 8, 34, 247, 86, 14, 90, 15, 55, 129, 0, 0);
    item_aot_set(2, 3200, 4100, 600, 1400, ITEM_EXPLOSIVE_ROUNDS, 6, 2, 255, 172, 13, 34, 247, 2, 18, 0, 244, 56, 129, 0, 0);
#endif
    item_aot_set(3, 0, 0, 1, 1, ITEM_BATTERY, 1, 0, 255, 90, 10, 124, 252, 40, 10, 0, 0, 57, 129, 0, 0);
    if (ck(FG_ITEM, 57, 0))
    {
        aot_set(4, 2200, 1500, 1000, 1900, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    }
}

proc main
{
    if (testpickup(ITEM_BATTERY))
    {
        aot_delete(4, SCE_NONE, 129);
    }
}

event event_00
{
    run
    {
        set(FG_6, 31, 1);
        set(FG_6, 25, 1);
        set(FG_6, 29, 1);
        set(FG_6, 28, 1);
        message(128, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, 31, 0);
        set(FG_6, 25, 0);
        set(FG_6, 29, 0);
        set(FG_6, 28, 0);
        aot_on(3, SCE_ITEM, 0);
    }
    evt_finish();
}
