#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_EVENT 0x01
#define AOT_02_USEITEM 0x02
#define AOT_03_EVENT 0x03
#define AOT_04_MESSAGE 0x04
#define AOT_05_ITEM 0x05
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08
#define AOT_09_MESSAGE 0x09
#define AOT_0A_MESSAGE 0x0A
#define AOT_0B_MESSAGE 0x0B
#define AOT_0C_MESSAGE 0x0C
#define AOT_0D_MESSAGE 0x0D
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define F_ROOM_20 0x20
#define MSG_THERE_IS_A_SWITCH_WILL_YOU_PUSH_IT_05 0x05
#define OBJ_00 0x00
#define OBJ_01 0x01
#define SE_17 0x17
#define SE_18 0x18

proc init
{
    door_aot_set(AOT_00_DOOR, 10900, 3500, 1300, 1000, 0, DOOR_SND_00_DR_WD, DOOR_1E_DOOR03K, 5, 0, ROOM_216_LIBRARY_A, 3000, 0, 3600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    set(FG_STATUS, F_STATUS_1D, TRUE);
    aot_set(AOT_01_EVENT, 400, 8200, 3200, 1900, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_01, 0, 0, 0);
    aot_set(AOT_02_USEITEM, 3600, 8200, 1700, 1900, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 32, 0, 1, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_68, FALSE))
    {
        aot_set(AOT_03_EVENT, 3400, 14130, 100, 100, SCE_EVENT, SAT_UNDER | SAT_OBJECT, 9, 0, on_aot_03, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_03_EVENT, 3400, 14130, 100, 100, SCE_EVENT, 0, 9, 0, on_aot_03, 0, 0, 0);
    }
    aot_set(AOT_04_MESSAGE, 2900, 13700, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
    item_aot_set(AOT_05_ITEM, 9780, 13010, 1800, 1800, IT_28_KEY_MO_DISK, 1, 0, 255, 202, 42, 84, 252, 238, 52, 0, 0, F_ITEM_4D, 129, 0, 0);
    aot_set(AOT_07_MESSAGE, 5700, 6100, 2600, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 6100, 2500, 2000, 1400, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 2100, 1500, 10000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 1700, 2700, 1200, 5100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_0B_MESSAGE, 1700, 10100, 1200, 5900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_0C_MESSAGE, 1300, 14300, 6600, 1300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_0D_MESSAGE, 8500, 11000, 2500, 500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_68, FALSE))
    {
        obj(OBJ_00, 1, 255, 5250, 0, 4910, 0, 0, 0, 0, 0, 0, 0, 0, 0, 184, 1, 188, 7, 32, 3, 32, 3);
        obj(OBJ_01, 33, 255, 8460, 0, 13440, 2048, 48, 253, 0, 0, 208, 2, 0, 0, 28, 2, 72, 18, 26, 4, 8, 7);
    }
    else
    {
        obj(OBJ_00, 1, 255, 3500, 0, 14210, 0, 0, 0, 0, 0, 0, 0, 0, 0, 184, 1, 188, 7, 32, 3, 32, 3);
        obj(OBJ_01, 33, 255, 8460, 0, 16150, 2048, 48, 253, 0, 0, 208, 2, 0, 0, 28, 2, 72, 18, 26, 4, 8, 7);
    }
    set(FG_STATUS, F_STATUS_3C, TRUE);
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_20, TRUE))
    {
        aot_delete(AOT_01_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_01_EVENT, SCE_NONE, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_41, TRUE) && ck(FG_SCENARIO, F_SCENARIO_68, FALSE))
    {
        aot_delete(AOT_04_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_04_MESSAGE, SCE_NONE, 0);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_02) && ck(FG_SCENARIO, F_SCENARIO_41, FALSE))
    {
        bank_bit(255);
        bank_bit(7);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_04) && ck(FG_SCENARIO, F_SCENARIO_41, FALSE))
    {
        bank_bit(255);
        bank_bit(4);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
    {
        bank_bit(255);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
    {
        bank_bit(255);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        bank_bit(255);
    }
}

event on_aot_01
{
    sleep(1);
    run
    {
        set(FG_6, F_6_17, FALSE);
        message(MSG_THERE_IS_A_SWITCH_WILL_YOU_PUSH_IT_05 | MSG_FAST, MSG_PAUSE_0080 | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "There's a switch. Will you push it?"
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_PLAYER, 0, 0, 0);
            set(FG_SCENARIO, F_SCENARIO_41, TOGGLE);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_41, FALSE))
        {
            aot_switch(0, 7, 1);
        }
        else
        {
            aot_switch(0, 7, 0);
        }
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_03
{
    run
    {
        aot_delete(AOT_03_EVENT, SCE_NONE, 0);
        objtbl_b_set(0, 0, 1);
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_SCENARIO, F_SCENARIO_68, TRUE);
    }
    sleep(30);
    evt_fork(TASK_09, on_aot_03_sub1, 0);
    sleep(65);
    cutnext(CAM_05);
    sleep(140);
    run
    {
        cutnext(CAM_04);
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        if (ck(FG_SCENARIO, F_SCENARIO_41, FALSE))
        {
            aot_switch(0, 4, 1);
        }
    }
    evt_finish();
}

event on_aot_03_sub1
{
    se_play_3d(SND_BANK_ROOM, SE_18, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 14);
    for (50)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 0, 15);
    for (100)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 0, 10);
    for (51)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_finish();
}
