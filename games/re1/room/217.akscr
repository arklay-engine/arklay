#version 1

proc init
{
    door_aot_set(0, 10900, 3500, 1300, 1000, 0, 0, 30, 5, 0, RDT_016, 3000, 0, 3600, 0, UNLOCKED, 129);
    set(FG_STATUS, 29, 0);
    aot_set(1, 400, 8200, 3200, 1900, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    aot_set(2, 3600, 8200, 1700, 1900, SCE_USEITEM, 65, 4, 0, 32, 0, 1, 0);
    if (ck(FG_SCENARIO, 104, 1))
    {
        aot_set(3, 3400, 14130, 100, 100, SCE_EVENT, 68, 9, 0, event_01, 0, 0, 0);
    }
    else
    {
        aot_set(3, 3400, 14130, 100, 100, SCE_EVENT, 0, 9, 0, event_01, 0, 0, 0);
    }
    aot_set(4, 2900, 13700, 1000, 1000, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    item_aot_set(5, 9780, 13010, 1800, 1800, ITEM_MO_DISK, 1, 0, 255, 202, 42, 84, 252, 238, 52, 0, 0, 77, 129, 0, 0);
    aot_set(7, 5700, 6100, 2600, 3000, SCE_MESSAGE, 129, 130, 0, 255, 0, 0, 0);
    aot_set(8, 6100, 2500, 2000, 1400, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(9, 2100, 1500, 10000, 1500, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(10, 1700, 2700, 1200, 5100, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(11, 1700, 10100, 1200, 5900, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    aot_set(12, 1300, 14300, 6600, 1300, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    aot_set(13, 8500, 11000, 2500, 500, SCE_MESSAGE, 129, 130, 0, 255, 0, 0, 0);
    if (ck(FG_SCENARIO, 104, 1))
    {
        obj(0, 1, 255, 5250, 0, 4910, 0, 0, 0, 0, 0, 0, 0, 0, 0, 184, 1, 188, 7, 32, 3, 32, 3);
        obj(1, 33, 255, 8460, 0, 13440, 2048, 48, 253, 0, 0, 208, 2, 0, 0, 28, 2, 72, 18, 26, 4, 8, 7);
    }
    else
    {
        obj(0, 1, 255, 3500, 0, 14210, 0, 0, 0, 0, 0, 0, 0, 0, 0, 184, 1, 188, 7, 32, 3, 32, 3);
        obj(1, 33, 255, 8460, 0, 16150, 2048, 48, 253, 0, 0, 208, 2, 0, 0, 28, 2, 72, 18, 26, 4, 8, 7);
    }
    set(FG_STATUS, 60, 0);
}

proc main
{
    if (ck(FG_ROOM, 32, 0))
    {
        aot_delete(1, SCE_EVENT, 129);
    }
    else
    {
        aot_delete(1, SCE_NONE, 0);
    }
    if (ck(FG_SCENARIO, 65, 0) && ck(FG_SCENARIO, 104, 1))
    {
        aot_delete(4, SCE_MESSAGE, 129);
    }
    else
    {
        aot_delete(4, SCE_NONE, 0);
    }
    if (cmpb(2, 0, 2) && ck(FG_SCENARIO, 65, 1))
    {
        bank_bit(255);
        bank_bit(7);
    }
    if (cmpb(2, 0, 4) && ck(FG_SCENARIO, 65, 1))
    {
        bank_bit(255);
        bank_bit(4);
    }
    if (cmpb(2, 0, 1))
    {
        bank_bit(255);
    }
    if (cmpb(2, 0, 3))
    {
        bank_bit(255);
    }
    if (cmpb(2, 0, 5))
    {
        bank_bit(255);
    }
}

event event_00
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        message(133, 255);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            se_play_3d(2, 23, 0, 1, 0, 0, 0);
            set(FG_SCENARIO, 65, 2);
        }
        if (ck(FG_SCENARIO, 65, 1))
        {
            aot_switch(0, 7, 1);
        }
        else
        {
            aot_switch(0, 7, 0);
        }
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_01
{
    run
    {
        aot_delete(3, SCE_NONE, 0);
        objtbl_b_set(0, 0, 1);
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        set(FG_SCENARIO, 104, 0);
    }
    sleep(30);
    evt_fork(9, event_02, 0);
    sleep(65);
    cutnext(5);
    sleep(140);
    run
    {
        cutnext(4);
        cut_auto(0);
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
        if (ck(FG_SCENARIO, 65, 1))
        {
            aot_switch(0, 4, 1);
        }
    }
    evt_finish();
}

event event_02
{
    se_play_3d(2, 24, 0, 1, 0, 0, 0);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 14);
    for (50)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 0, 15);
    for (100)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 0, 10);
    for (51)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_finish();
}
