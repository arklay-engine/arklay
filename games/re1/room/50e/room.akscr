#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_50C 0x00
#define AOT_01_TYPEWRITER 0x01
#define AOT_02_ITEM_HEAL_HERB_GREEN_0 0x02
#define AOT_03_ITEM_HEAL_HERB_BLUE_1 0x03
#define AOT_04_ITEM_AMMO_GRENADE_FLAME_2 0x04
#define AOT_04_ITEM_AMMO_MAGNUM_2 0x04
#define AOT_05_ITEM_INK_3 0x05
#define AOT_06_ITEMBOX 0x06
#define IMDL_00_HEAL_HERB_GREEN 0x00
#define IMDL_01_HEAL_HERB_BLUE 0x01
#define IMDL_02_AMMO_GRENADE_FLAME 0x02
#define IMDL_02_AMMO_MAGNUM 0x02
#define IMDL_03_INK 0x03
#define OBJ_00 0x00

proc init
{
    door_aot_set(AOT_00_DOOR_50C, 700, 2800, 1900, 1700, 1, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_50C_FRONT_OF_ELEVATOR, 14300, 0, 17700, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_TYPEWRITER, 2000, 8500, 1800, 2200, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    item_aot_set(AOT_02_ITEM_HEAL_HERB_GREEN_0, 8000, 8000, 1400, 1400, IT_44_HEAL_HERB_GREEN, 1, IMDL_00_HEAL_HERB_GREEN, SCA_NONE, 8700, 0, 8700, 0, F_ITEM_50E_HEAL_HERB_GREEN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_03_ITEM_HEAL_HERB_BLUE_1, 4700, 8000, 1400, 1400, IT_45_HEAL_HERB_BLUE, 1, IMDL_01_HEAL_HERB_BLUE, SCA_NONE, 5400, 0, 8700, 0, F_ITEM_50E_HEAL_HERB_BLUE_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        item_aot_set(ITEM_ALT_ROT | AOT_04_ITEM_AMMO_MAGNUM_2, 8000, 4100, 1400, 1400, IT_0E_AMMO_MAGNUM, 6, IMDL_02_AMMO_MAGNUM, SCA_NONE, 8700, -2200, 4800, 0, F_ITEM_C_50E_AMMO_MAGNUM_2, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        item_aot_set(ITEM_ALT_ROT | AOT_04_ITEM_AMMO_GRENADE_FLAME_2, 8000, 4100, 1400, 1400, IT_12_AMMO_GRENADE_FLAME, 6, IMDL_02_AMMO_GRENADE_FLAME, SCA_NONE, 8700, -2200, 4800, 0, F_ITEM_J_50E_AMMO_GRENADE_FLAME_2, SAT_MANUAL | SAT_PLAYER, 0);
    }
    if (USA)
    {
        item_aot_set(AOT_05_ITEM_INK_3, 8000, 5800, 1400, 1400, IT_2F_KEY_INK_RIBBON, 2, IMDL_03_INK, SCA_NONE, 8700, -2510, 6500, 0, F_ITEM_50E_INK_3, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        item_aot_set(AOT_05_ITEM_INK_3, 8000, 5800, 1400, 1400, IT_2F_KEY_INK_RIBBON, 3, IMDL_03_INK, SCA_NONE, 8700, -2510, 6500, 0, F_ITEM_50E_INK_3, SAT_MANUAL | SAT_PLAYER, 0);
    }
    aot_set(AOT_06_ITEMBOX, 7100, 1900, 1800, 2900, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 5, 0, 0, 0, 0, 0);
    obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 9100, -1440, 3000, 2048, 0, 0, 0, 0, 0, 0, 0, 0);
}
