#version 1

proc init
{
    door_aot_set(0, 16800, 26400, 2200, 2200, 3, 0, 6, 4, 0, RDT_011, 3000, 0, 12000, 1024, UNLOCKED, 129);
    item_aot_set(1, 23500, 19770, 1000, 1000, ITEM_BAZOOKA_ACID, 6, 0, 255, 192, 93, 0, 0, 46, 79, 6, 6, 6, 129, 1, 0);
    room_bgm_state_set(1, 18, 32);
    enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
    enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
    enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
    evt_exec(0, 9, event_00);
    evt_exec(0, 9, event_01);
}

event event_00
{
    sleep(50);
    se_play_3d(2, 24, 0, 0, 0, 3000, 3000);
    sleep(80);
    se_play_3d(2, 24, 0, 0, 0, 25000, 3000);
