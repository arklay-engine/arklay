proc init
{
    door_aot_set(AOT_00_DOOR, 1300, 12900, 3400, 2000, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 7, 0, ROOM_204_C_PASSAGE, 12500, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 12000, 1100, 2300, 3100, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_20E_FRONT_OF_ATTIC, 2700, 0, 2900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_ITEM, F_ITEM_28, TRUE))
    {
#if MANSION1
        item_aot_set(AOT_02_ITEM, 7500, 2500, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, 0, 255, 10, 0, 0, 0, 10, 0, 0, 0, F_ITEM_28, 129, 1, 0);
        aot_reset(AOT_02_ITEM, SCE_NONE, 0, 0, 0, 0);
#else
        item_aot_set(AOT_82_ITEM, 7500, 2500, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, 0, 255, 108, 32, 0, 0, 16, 14, 0, 0, F_ITEM_28, 129, 1, 0);
#endif
    }
    if (ck(FG_ITEM, F_ITEM_C5, TRUE))
    {
        item_aot_set(AOT_03_ITEM, 5800, 6000, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, 1, 255, 44, 26, 0, 0, 244, 26, 0, 0, F_ITEM_C5, 129, 1, 0);
    }
#if MANSION1
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_24, TRUE) && ck(FG_COMMON, F_COMMON_62, FALSE))
    {
        set(FG_COMMON, F_COMMON_61, TRUE);
    }
#endif
    if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, FALSE))
    {
        if (item_ck(IT_42_KEY_SERUM))
        {
            if (cmpw(0, W_04, CMP_LE, 420))
            {
                set(FG_COMMON, F_COMMON_63, TRUE);
                set(FG_COMMON, F_COMMON_64, FALSE);
                room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 1);
#if CHRIS
                aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_3, 0, 0, 0);
#else
                aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_2, 0, 0, 0);
#endif
            }
            else
            {
                set(FG_COMMON, F_COMMON_63, FALSE);
                set(FG_COMMON, F_COMMON_64, TRUE);
                set(FG_SCENARIO, F_SCENARIO_49, TRUE);
            }
        }
        else if (cmpw(0, W_04, CMP_LE, 420))
        {
            set(FG_COMMON, F_COMMON_63, FALSE);
            set(FG_COMMON, F_COMMON_64, FALSE);
#if CHRIS
            aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, on_aot_04_2, 0, 0, 0);
#else
            aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, on_aot_04_3, 0, 0, 0);
#endif
        }
        else
        {
            set(FG_COMMON, F_COMMON_63, FALSE);
            set(FG_COMMON, F_COMMON_64, TRUE);
            set(FG_SCENARIO, F_SCENARIO_49, TRUE);
        }
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_61, TRUE))
    {
        enemy(EM_27_NPC_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, 2, 39, 0);
        if (ck(FG_COMMON, F_COMMON_63, TRUE) && ck(FG_COMMON, F_COMMON_66, FALSE))
        {
            enemy(EM_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 2560, 0, 0, 9850, 0, 3000, ENEMY_01_NPC_REBECCA, 61, 0, 1);
            aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_3, 0, 0, 0);
        }
        else if (ck(FG_ITEM, F_ITEM_28, TRUE))
        {
            aot_set(AOT_04_EVENT, 7400, 2700, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04, 0, 0, 0);
        }
        if (ck(FG_COMMON, F_COMMON_65, FALSE))
        {
            room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
        }
        else
        {
            room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_MAIN_ON | 3);
        }
    }
    else if (ck(FG_COMMON, F_COMMON_64, TRUE))
    {
        room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
        aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_4, 0, 0, 0);
        enemy(EM_27_NPC_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, 2, 39, 0);
    }
    else
    {
        enemy(EM_27_NPC_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, 1, 0, 0);
        enemy(EM_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 2560, 0, 0, 9850, 0, 3000, ENEMY_01_NPC_REBECCA, 61, 0, 1);
    }
    if (ck(FG_COMMON, F_COMMON_5F, TRUE) && ck(FG_COMMON, F_COMMON_5E, FALSE))
    {
        if (item_ck(IT_42_KEY_SERUM))
        {
            aot_reset(AOT_01_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_door, 0);
        }
        else
        {
            set(FG_COMMON, F_COMMON_5F, TRUE);
            aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 148, 127, 0);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_61, TRUE))
    {
        if (ck(FG_ITEM, F_ITEM_28, TRUE))
        {
            aot_set(AOT_04_EVENT, 7400, 2700, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04, 0, 0, 0);
        }
        enemy(EM_27_NPC_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, 2, 39, 0);
        if (ck(FG_COMMON, F_COMMON_65, FALSE))
        {
            room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
        }
        else
        {
            room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_MAIN_ON | 3);
        }
    }
    else if (ck(FG_COMMON, F_COMMON_64, TRUE))
    {
        aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_4, 0, 0, 0);
        enemy(EM_27_NPC_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, 2, 39, 0);
        room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
    }
    else
    {
        enemy(EM_27_NPC_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, 1, 0, 0);
    }
#endif
#endif
    if (ck(FG_ITEM, F_ITEM_C6, TRUE))
    {
#if MANSION1
        item_aot_set(AOT_05_ITEM, 4100, 6000, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, 2, 255, 136, 19, 0, 0, 244, 26, 0, 0, F_ITEM_C6, 129, 1, 0);
#else
        item_aot_set(AOT_04_ITEM, 4100, 6000, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, 2, 255, 136, 19, 0, 0, 244, 26, 0, 0, F_ITEM_C6, 129, 1, 0);
#endif
    }
}
#if CHRIS
#if MANSION1

proc main
{
    if (ck(FG_COMMON, F_COMMON_5F, TRUE) && ck(FG_SCENARIO, F_SCENARIO_4E, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_4E, TRUE);
        set(FG_STATUS, F_STATUS_16, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_61, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_00, FALSE) && ck(FG_COMMON, F_COMMON_64, FALSE))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
            evt_exec(0, TASK_01, from_main_3);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03) && ck(FG_ROOM, F_ROOM_01, FALSE))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
            if (ck(FG_COMMON, F_COMMON_62, FALSE) && ck(FG_COMMON, F_COMMON_63, FALSE) && ck(FG_COMMON, F_COMMON_64, FALSE))
            {
                set(FG_COMMON, F_COMMON_62, TRUE);
                set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
                set(FG_STATUS, F_STATUS_0F, TRUE);
                set(FG_COMMON, F_COMMON_2D, TRUE);
                cut_auto(1);
                cutnext(CAM_04);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, TASK_00, from_main);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_63, TRUE) && ck(FG_COMMON, F_COMMON_64, FALSE))
            {
                set(FG_COMMON, F_COMMON_61, TRUE);
                set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
                set(FG_STATUS, F_STATUS_0F, TRUE);
                cut_auto(1);
                cutnext(CAM_05);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, TASK_00, from_main_2);
                remove_item(IT_42_KEY_SERUM);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_63, FALSE) && ck(FG_COMMON, F_COMMON_64, TRUE))
            {
                set(FG_COMMON, F_COMMON_61, TRUE);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, FALSE))
            {
                aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 148, 127, 0);
            }
        }
    }
    if (ck(FG_STATUS, F_STATUS_16, FALSE) && ck(FG_ROOM, F_ROOM_03, TRUE))
    {
        set(FG_MESSAGE, F_MESSAGE_18, TRUE);
        set(FG_MESSAGE, F_MESSAGE_READY, TRUE);
    }
    if (ck(FG_STATUS, F_STATUS_16, FALSE) && ck(FG_ROOM, F_ROOM_02, TRUE))
    {
        set(FG_ROOM, F_ROOM_03, TRUE);
    }
    if (ck(FG_STATUS, F_STATUS_16, TRUE))
    {
        set(FG_ROOM, F_ROOM_02, TRUE);
    }
}

event from_main
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(19, 9900, 64736, 3050, 0, 0);
    act_anim_flags(32 | 0, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(114, 2300, 300, 1, 20, 20);
    sleep(5);
    act_motion_path(19, 3990, 61536, 2930, 50, 50);
    sleep(20);
    act_reset();
    evt_nop();
    voice_play(VOICE_PLAY, VO_005_00, 0);
    message(MSG_VO_005_00, 0);
    wait_message();
    run
    {
        cutnext(CAM_03);
        voice_play(VOICE_PLAY, VO_005_01, 0);
        message(MSG_VO_005_01, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 3, 32 | 1, 0 | 0);
    sleep(15);
    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    sleep(32);
