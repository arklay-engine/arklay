    sleep(11);
    act_anim_flags(32 | 4, 32 | 1, 0 | 0);
    sleep(8);
    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    sleep(4);
    act_anim_flags(32 | 3, 32 | 1, 0 | 0);
    sleep(5);
    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    sleep(4);
    act_anim_flags(32 | 3, 32 | 1, 0 | 0);
    sleep(4);
    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    sleep(7);
    act_anim_flags(32 | 4, 32 | 1, 0 | 0);
    sleep(23);
    act_anim_flags(32 | 5, 32 | 1, 0 | 0);
