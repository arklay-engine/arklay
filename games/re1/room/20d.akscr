#version 1

proc init
{
    door_aot_set(0, 1300, 12900, 3400, 2000, 3, 0, 0, 7, 0, RDT_004, 12500, 0, 2800, 3072, UNLOCKED, 129);
    door_aot_set(1, 12000, 1100, 2300, 3100, 2, 0, 0, 1, 0, RDT_00E, 2700, 0, 2900, 0, UNLOCKED, 129);
    if (ck(FG_ITEM, 40, 0))
    {
#if MANSION1
        item_aot_set(2, 7500, 2500, 1800, 1800, ITEM_CLIP, 15, 0, 255, 10, 0, 0, 0, 10, 0, 0, 0, 40, 129, 1, 0);
        aot_reset(2, SCE_NONE, 0, 0, 0, 0);
#else
        item_aot_set(130, 7500, 2500, 1800, 1800, ITEM_CLIP, 15, 0, 255, 108, 32, 0, 0, 16, 14, 0, 0, 40, 129, 1, 0);
#endif
    }
    if (ck(FG_ITEM, 197, 0))
    {
        item_aot_set(3, 5800, 6000, 1800, 1800, ITEM_GREEN_HERB, 1, 1, 255, 44, 26, 0, 0, 244, 26, 0, 0, 197, 129, 1, 0);
    }
#if MANSION1
#if CHRIS
    if (ck(FG_COMMON, 36, 0) && ck(FG_COMMON, 98, 1))
    {
        set(FG_COMMON, 97, 0);
    }
#endif
    if (ck(FG_COMMON, 98, 0) && ck(FG_COMMON, 97, 1))
    {
        if (item_ck(ITEM_SERUM))
        {
            if (cmpw(0, 4, 4, 420))
            {
                set(FG_COMMON, 99, 0);
                set(FG_COMMON, 100, 1);
                room_bgm_state_set(1, 13, 65);
#if CHRIS
                aot_set(4, 7500, 2500, 1800, 1800, SCE_EVENT, 193, 7, 0, event_04, 0, 0, 0);
#else
                aot_set(4, 7500, 2500, 1800, 1800, SCE_EVENT, 193, 7, 0, event_07, 0, 0, 0);
#endif
            }
            else
            {
                set(FG_COMMON, 99, 1);
                set(FG_COMMON, 100, 0);
                set(FG_SCENARIO, 73, 0);
            }
        }
        else if (cmpw(0, 4, 4, 420))
        {
            set(FG_COMMON, 99, 1);
            set(FG_COMMON, 100, 1);
#if CHRIS
            aot_set(4, 7500, 2500, 1800, 1800, SCE_EVENT, 193, 0, 0, event_03, 0, 0, 0);
#else
            aot_set(4, 7500, 2500, 1800, 1800, SCE_EVENT, 193, 0, 0, event_08, 0, 0, 0);
#endif
        }
        else
        {
            set(FG_COMMON, 99, 1);
            set(FG_COMMON, 100, 0);
            set(FG_SCENARIO, 73, 0);
        }
    }
#if CHRIS
    if (ck(FG_COMMON, 97, 0))
    {
        enemy(ENEMY_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, 0, 2, 39, 0);
        if (ck(FG_COMMON, 99, 0) && ck(FG_COMMON, 102, 1))
        {
            enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 2560, 0, 0, 9850, 0, 3000, 1, 61, 0, 1);
            aot_set(4, 7500, 2500, 1800, 1800, SCE_EVENT, 193, 7, 0, event_04, 0, 0, 0);
        }
        else if (ck(FG_ITEM, 40, 0))
        {
            aot_set(4, 7400, 2700, 1800, 1800, SCE_EVENT, 129, 0, 0, event_02, 0, 0, 0);
        }
        if (ck(FG_COMMON, 101, 1))
        {
            room_bgm_state_set(1, 13, 66);
        }
        else
        {
            room_bgm_state_set(1, 13, 11);
        }
    }
    else if (ck(FG_COMMON, 100, 0))
    {
        room_bgm_state_set(1, 13, 66);
        aot_set(4, 7500, 2500, 1800, 1800, SCE_EVENT, 193, 7, 0, event_0C, 0, 0, 0);
        enemy(ENEMY_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, 0, 2, 39, 0);
    }
    else
    {
        enemy(ENEMY_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, 0, 1, 0, 0);
        enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 2560, 0, 0, 9850, 0, 3000, 1, 61, 0, 1);
    }
    if (ck(FG_COMMON, 95, 0) && ck(FG_COMMON, 94, 1))
    {
        if (item_ck(ITEM_SERUM))
        {
            aot_reset(1, SCE_EVENT, 129, 0, event_08, 0);
        }
        else
        {
            set(FG_COMMON, 95, 0);
            aot_reset(1, SCE_MESSAGE, 129, 148, 127, 0);
        }
    }
#else
    if (ck(FG_COMMON, 97, 0))
    {
        if (ck(FG_ITEM, 40, 0))
        {
            aot_set(4, 7400, 2700, 1800, 1800, SCE_EVENT, 129, 0, 0, event_05, 0, 0, 0);
        }
        enemy(ENEMY_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, 0, 2, 39, 0);
        if (ck(FG_COMMON, 101, 1))
        {
            room_bgm_state_set(1, 13, 66);
        }
        else
        {
            room_bgm_state_set(1, 13, 11);
        }
    }
    else if (ck(FG_COMMON, 100, 0))
    {
        aot_set(4, 7500, 2500, 1800, 1800, SCE_EVENT, 193, 7, 0, event_09, 0, 0, 0);
        enemy(ENEMY_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, 0, 2, 39, 0);
        room_bgm_state_set(1, 13, 66);
    }
    else
    {
        enemy(ENEMY_RICHARD, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 8300, 0, 3600, 0, 1, 0, 0);
    }
#endif
#endif
    if (ck(FG_ITEM, 198, 0))
    {
#if MANSION1
        item_aot_set(5, 4100, 6000, 1800, 1800, ITEM_GREEN_HERB, 1, 2, 255, 136, 19, 0, 0, 244, 26, 0, 0, 198, 129, 1, 0);
#else
        item_aot_set(4, 4100, 6000, 1800, 1800, ITEM_GREEN_HERB, 1, 2, 255, 136, 19, 0, 0, 244, 26, 0, 0, 198, 129, 1, 0);
#endif
    }
}
#if CHRIS
#if MANSION1

proc main
{
    if (ck(FG_COMMON, 95, 0) && ck(FG_SCENARIO, 78, 1))
    {
        set(FG_SCENARIO, 78, 0);
        set(FG_STATUS, 22, 0);
    }
    if (ck(FG_COMMON, 97, 1))
    {
        if (ck(FG_ROOM, 0, 1) && ck(FG_COMMON, 100, 1))
        {
            set(FG_ROOM, 0, 0);
            evt_exec(0, 1, event_05);
        }
        if (cmpb(2, 0, 3) && ck(FG_ROOM, 1, 1))
        {
            set(FG_ROOM, 1, 0);
            if (ck(FG_COMMON, 98, 1) && ck(FG_COMMON, 99, 1) && ck(FG_COMMON, 100, 1))
            {
                set(FG_COMMON, 98, 0);
                set(FG_6, 23, 1);
                set(FG_STATUS, 15, 0);
                set(FG_COMMON, 45, 0);
                cut_auto(1);
                cutnext(4);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, 0, event_00);
            }
            if (ck(FG_COMMON, 98, 0) && ck(FG_COMMON, 99, 0) && ck(FG_COMMON, 100, 1))
            {
                set(FG_COMMON, 97, 0);
                set(FG_6, 23, 1);
                set(FG_STATUS, 15, 0);
                cut_auto(1);
                cutnext(5);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, 0, event_01);
                remove_item(ITEM_SERUM);
            }
            if (ck(FG_COMMON, 98, 0) && ck(FG_COMMON, 99, 1) && ck(FG_COMMON, 100, 0))
            {
                set(FG_COMMON, 97, 0);
            }
            if (ck(FG_COMMON, 98, 0) && ck(FG_COMMON, 97, 1))
            {
                aot_reset(1, SCE_MESSAGE, 129, 148, 127, 0);
            }
        }
    }
    if (ck(FG_STATUS, 22, 1) && ck(FG_ROOM, 3, 0))
    {
        set(FG_6, 24, 0);
        set(FG_6, 25, 0);
    }
    if (ck(FG_STATUS, 22, 1) && ck(FG_ROOM, 2, 0))
    {
        set(FG_ROOM, 3, 0);
    }
    if (ck(FG_STATUS, 22, 0))
    {
        set(FG_ROOM, 2, 0);
    }
}

