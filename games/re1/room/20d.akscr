    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    sleep(15);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(19, 7380, 61536, 2440, 32, 32);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(54275, 34844, 8457);
    act_nop();
    act_param_set(8192, 0);
    do
    {
        evt_next();
