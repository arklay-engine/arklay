#if CHRIS
event on_aot_04_4
#else
event on_aot_04
#endif
{
    run
    {
        cut_auto(1);
        cutnext(CAM_04);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        dir_set(0, 0, 3465, 0, 8000, 0, 2440);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 1, 0 | 0);
    sleep(26);
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_COMMON, F_COMMON_65, FALSE))
        {
            bgm_play(BGM_MAIN);
            set(FG_COMMON, F_COMMON_65, TRUE);
        }
#if CHRIS
        message(MSG_RICHARD_IS_DEAD_17 | MSG_FAST, 0); // "Richard is dead."
#else
        message(MSG_RICHARD_FROM_BRAVO_TEAM_0C | MSG_FAST, 0); // "Richard from Bravo team."
#endif
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(113, 300, 128, 2, 23, 23);
    sleep(75);
    act_motion(16);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 1, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutnext(CAM_03);
        cut_auto(0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        aot_reset(AOT_02_ITEM, SCE_ITEM, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 1, 0, 0);
        aot_reset(AOT_04_EVENT, SCE_NONE, 0, 0, 0, 0);
    }
    evt_finish();
}
