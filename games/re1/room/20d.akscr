    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutnext(3);
        cut_auto(0);
        set(FG_STATUS, 15, 1);
        set(FG_6, 23, 0);
        aot_reset(2, SCE_ITEM, 193, 1, 0, 0);
        aot_reset(4, SCE_NONE, 0, 0, 0, 0);
    }
    evt_finish();
}
