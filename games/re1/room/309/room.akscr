    evt_nop();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2D, F_ROOM_J_ANIM_DONE, 0);
    act_param_set(0, 3072);
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
