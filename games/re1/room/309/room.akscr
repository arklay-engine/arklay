#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_308_N 0x00
#define AOT_01_DOOR_308_S 0x01
#define AOT_02_DOOR_30A 0x02
#define AOT_03_ITEM_AMMO_GRENADE_EXPLOSIVE_0 0x03
#define AOT_04_ITEM_AMMO_SHOTGUN_1 0x04
#define AOT_04_ITEM_HEAL_FIRST_AID_SPRAY_1 0x04
#define AOT_05_ITEM_HEAL_FIRST_AID_SPRAY_0 0x05
#define AOT_07_MESSAGE_GENERATOR 0x07
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_04 0x04
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_NPC_BARRY_3 0x00
#define ENEMY_01_HUNTER 0x01
#define ENEMY_02_HUNTER 0x02
#define F_ROOM_J_ANIM_DONE 0x00                             // Jill's, Barry's or the hunter's animation finished; nothing waits for it.
#define IMDL_00_AMMO_GRENADE_EXPLOSIVE 0x00
#define IMDL_00_HEAL_FIRST_AID_SPRAY 0x00
#define IMDL_01_AMMO_SHOTGUN 0x01
#define IMDL_01_HEAL_FIRST_AID_SPRAY 0x01
#define MSG_VO_A00_01 0x00
#define SE_07_HE_NOUT 0x07
#define SE_17_MAGNUM 0x17
#define VO_A00_01 0x30

proc init
{
    door_aot_set(AOT_00_DOOR_308_N, 1900, 25800, 2100, 1900, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_308_BRANCH_PASSAGE, 12600, 0, 27300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_308_S, 0, 3500, 2400, 1900, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_308_BRANCH_PASSAGE, 11000, 0, 3300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_30A, 13900, 0, 2100, 2600, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30A_ENRICO_ROOM, 4100, 0, 20000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        item_aot_set(ITEM_ALT_ROT | AOT_04_ITEM_AMMO_SHOTGUN_1, 25000, 19000, 1000, 1000, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN, SCA_NONE, 25500, -2130, 19500, 0, F_ITEM_309_AMMO_SHOTGUN_1, SAT_MANUAL | SAT_PLAYER, 0);
        item_aot_set(ITEM_ALT_ROT | AOT_05_ITEM_HEAL_FIRST_AID_SPRAY_0, 25000, 20900, 1000, 1000, IT_41_HEAL_FIRST_AID_SPRAY, 1, IMDL_00_HEAL_FIRST_AID_SPRAY, SCA_NONE, 25500, -2130, 21400, 0, F_ITEM_C_309_HEAL_FIRST_AID_SPRAY_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        item_aot_set(ITEM_ALT_ROT | AOT_03_ITEM_AMMO_GRENADE_EXPLOSIVE_0, 25000, 19000, 1000, 1000, IT_10_AMMO_GRENADE_EXPLOSIVE, 6, IMDL_00_AMMO_GRENADE_EXPLOSIVE, SCA_NONE, 25500, -2130, 19500, 0, F_ITEM_309_AMMO_GRENADE_EXPLOSIVE_0, SAT_MANUAL | SAT_PLAYER, 0);
        item_aot_set(ITEM_ALT_ROT | AOT_04_ITEM_HEAL_FIRST_AID_SPRAY_1, 25000, 20900, 1000, 1000, IT_41_HEAL_FIRST_AID_SPRAY, 1, IMDL_01_HEAL_FIRST_AID_SPRAY, SCA_NONE, 25500, -2130, 21400, 0, F_ITEM_J_309_HEAL_FIRST_AID_SPRAY_1, SAT_MANUAL | SAT_PLAYER, 0);
        if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE) && ck(FG_COMMON, F_COMMON_ENRICO_SHOT, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_FROM_30A, TRUE))
            {
                enemy(EM_2D_NPC_BARRY_3, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3200, 0, 12460, 0, 2570, ENEMY_00_NPC_BARRY_3, ANIM_00, 0, EVAR_00);
            }
            else if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_NORTH_DOOR, TRUE))
            {
                enemy(EM_2D_NPC_BARRY_3, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1112, 0, 6165, 0, 27740, ENEMY_00_NPC_BARRY_3, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_2D_NPC_BARRY_3, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3232, 0, 3920, 0, 2790, ENEMY_00_NPC_BARRY_3, ANIM_00, 0, EVAR_00);
            }
            set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_NORTH_DOOR, FALSE);
            set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_FROM_30A, FALSE);
            aot_reset(AOT_00_DOOR_308_N, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, north_door_with_barry, 0);
            evt_exec(0, TASK_09, barry_follows);
        }
        if (ck(FG_COMMON, F_COMMON_J_BARRY_309_HUNTER_SCENE, TRUE))
        {
            enemy(EM_06_HUNTER, EB_C0, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
            aot_reset(AOT_02_DOOR_30A, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, barry_saves_jill, 0);
        }
        if (ck(FG_COMMON, F_COMMON_J_RAN_AFTER_GUNSHOT, TRUE))
        {
            enemy(EM_2D_NPC_BARRY_3, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1112, 0, 6165, 0, 27740, ENEMY_00_NPC_BARRY_3, ANIM_00, 0, EVAR_00);
            enemy(EM_06_HUNTER, EB_C0, NO_FLAG, SPAWN_FORCE, 2, 0, 3192, 0, 4300, 0, 16300, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_09, barry_saves_jill);
            aot_reset(AOT_00_DOOR_308_N, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, north_door_with_barry, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_ENRICO_SHOT, TRUE))
    {
        if (CHRIS)
        {
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_309_HUNTER_0, SPAWN_FORCE, 2, 0, 0, 0, 7750, 0, 4760, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_309_HUNTER_1, SPAWN_FORCE, 2, 0, 0, 0, 9760, 0, 18180, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_309_HUNTER_0, SPAWN_FORCE, 2, 0, 0, 0, 7750, 0, 4760, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_309_HUNTER_1, SPAWN_FORCE, 2, 0, 0, 0, 9760, 0, 18180, ENEMY_02_HUNTER, ANIM_00, 0, EVAR_00);
        }
    }
    aot_set(AOT_07_MESSAGE_GENERATOR, 25600, 16400, 2000, 10100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
}

event barry_saves_jill
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        if (ck(FG_COMMON, F_COMMON_J_BARRY_309_HUNTER_SCENE, TRUE))
        {
            evt_exec(0, TASK_09, barry_saves_jill_at_30a_door);
        }
        if (ck(FG_COMMON, F_COMMON_J_RAN_AFTER_GUNSHOT, TRUE))
        {
            evt_exec(0, TASK_09, barry_saves_jill_at_north_door);
        }
    }
    evt_finish();
}

event barry_saves_jill_at_north_door
{
    run
    {
        set(FG_COMMON, F_COMMON_J_RAN_AFTER_GUNSHOT, FALSE);
        cutnext(CAM_04);
        dir_set(0, 0, 384, 0, 6840, 0, 26510);
        set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE);
        se_play_3d(SND_BANK_ROOM, SE_07_HE_NOUT, 0, SND_AT_ENEMY, ENEMY_01_HUNTER, 0, 0);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2E, F_ROOM_J_ANIM_DONE, 0);
    act_param_set(0, 1024);
    act_reset();
    evt_nop();
    sleep(10);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_anim_set(AB_07, ANIM_10, F_ROOM_J_ANIM_DONE);
    act_reset();
    evt_nop();
    sleep(5);
    evt_work_set(WK_ENEMY, ENEMY_01_HUNTER);
    evt_actor_begin();
    act_anim_seq(AB_03, 5940, 23540, F_ROOM_J_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    sleep(26);
    run
    {
        eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_0A);
    }
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_J_ANIM_DONE, 0);
    act_motion_path(MOTION_33, 400, 300, 0, 80, 60);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_07, ANIM_13, F_ROOM_J_ANIM_DONE);
    act_reset();
    evt_nop();
    sleep(5);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_08, ANIM_14, F_ROOM_J_ANIM_DONE);
    act_reset();
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_MAGNUM, 0, SND_AT_ENEMY, ENEMY_00_NPC_BARRY_3, 0, 0);
    }
    sleep(5);
    run
    {
        eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_0F);
    }
    sleep(5);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_07, ANIM_16, F_ROOM_J_ANIM_DONE);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_08, ANIM_17, F_ROOM_J_ANIM_DONE);
    act_reset();
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_MAGNUM, 0, SND_AT_ENEMY, ENEMY_00_NPC_BARRY_3, 0, 0);
    }
    sleep(5);
    run
    {
        eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_14);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_J_ANIM_DONE, 0);
    act_motion_path(MOTION_32, 0, 300, 0, 0, 30);
    act_flag_op(EF_SET, EF_0001);
    act_reset();
    evt_nop();
    sleep(100);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_09, ANIM_10, F_ROOM_J_ANIM_DONE);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_J_ANIM_DONE, 0);
    act_motion_path(MOTION_31, -500, 0, 0, 40, 0);
    act_reset();
    evt_nop();
    run
    {
        voice_play(VOICE_PLAY, VO_A00_01);
        message(MSG_VO_A00_01, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2C, F_ROOM_J_ANIM_DONE, 0);
    act_motion_path(MOTION_31, 200, 0, 0, 50, 0);
    act_reset();
    evt_nop();
    sleep(100);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_72, 0, 300, 1, 0, 40);
    act_reset();
    evt_nop();
    sleep(50);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, -200, 0, 0, 30);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_J_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_J_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_J_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_J_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        eml_state(0, ENEMY_00_NPC_BARRY_3, EML_08);
    }
    evt_finish();
}

event barry_saves_jill_at_30a_door
{
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_309_HUNTER_SCENE, FALSE);
        cutnext(CAM_00);
        dir_set(0, 0, 2048, 0, 13940, 0, 3120);
        pos_set(ENEMY_00_NPC_BARRY_3, 0, 2200, 0, 15400, 0, 4000);
        pos_set(ENEMY_01_HUNTER, 0, 0, 0, 4100, -3000, 5000);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_J_ANIM_DONE, 0);
    act_motion_path(MOTION_33, 400, 300, 0, 80, 60);
