event north_door_with_barry
{
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_NORTH_DOOR, TRUE);
        aot_on(AOT_00_DOOR_308_N, SCE_DOOR, 0);
    }
    evt_finish();
}

event barry_follows
{
    sleep(5);
    run
    {
        eml_state(0, ENEMY_00_NPC_BARRY_3, EML_08);
    }
    evt_finish();
}
