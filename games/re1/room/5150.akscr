#version 1

proc init
{
    set(FG_STATUS, 61, 0);
    door_aot_set(0, 0, 0, 1, 1, 1, 13, 18, 64, 0, RDT_00C, 16000, 0, 27900, 2048, UNLOCKED, 129);
    door_aot_set(1, 0, 0, 1, 1, 1, 13, 19, 64, 0, RDT_014, 13300, 0, 10000, 2048, UNLOCKED, 129);
    if (cmpb(3, 0, 12))
    {
        if (ck(FG_COMMON, 192, 1) && ck(FG_COMMON, 90, 1))
        {
            dir_set(0, 0, 1500, 0, 5000, 0, 5500);
            enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 2000, 0, 0, 4600, 0, 3500, 0, 5, 19, 0);
        }
        else
        {
            dir_set(0, 0, 2048, 0, 4500, 0, 4200);
        }
        evt_exec(0, 9, event_00);
    }
    else
    {
        if (ck(FG_COMMON, 192, 1) && ck(FG_COMMON, 90, 1))
        {
            dir_set(0, 0, 1500, 0, 5000, 0, 5500);
            enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 2500, 0, 0, 4600, 0, 3500, 0, 5, 19, 0);
        }
        else
        {
            dir_set(0, 0, 2048, 0, 4500, 0, 4200);
        }
        evt_exec(0, 9, event_01);
    }
}

event event_00
{
    sleep(1);
    set(FG_6, 23, 1);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 24, 1));
    run
    {
        set(FG_6, 23, 0);
        aot_on(1, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_01
{
    sleep(1);
    set(FG_6, 23, 1);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 24, 1));
    run
    {
        set(FG_6, 23, 0);
        aot_on(0, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_02
{
    sleep(5);
    set(FG_STATUS, 62, 0);
    sleep(10);
    set(FG_STATUS, 62, 1);
    sleep(100);
    sleep(60);
    set(FG_ROOM, 24, 0);
    evt_finish();
}
