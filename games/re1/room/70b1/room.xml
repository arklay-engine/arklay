  <strings>
    <language lang="en-US">
      <string key="save_name">Hall 1F</string>
      <string key="0">It's a map of 2ND FLOOR.\nWill you take it?{scroll 1}{branch 0 1 0}\nWood is put in the stove.{scroll 2}{clear 0}\nA paper is on the wall.{scroll 2}</string>
      <string key="1">\nWood is put in the stove.{scroll 2}{clear 0}\nA paper is on the wall.{scroll 2}</string>
      <string key="2">You got the\nmap of 2ND FLOOR.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}ホ{s}ー{s}ル{s}/{s}1{s}F{s}</string>
      <string key="0">    館2階の地図がある\n取りますか?{scroll 1}{branch 0 1 0}\n   ダンロにまきがくべてある{scroll 2}{clear 0}\n  上には白紙がはりつけてある{scroll 2}</string>
      <string key="1">\n   ダンロにまきがくべてある{scroll 2}{clear 0}\n  上には白紙がはりつけてある{scroll 2}</string>
      <string key="2">\n   館2階の地図を入手した{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Hall RdC</string>
      <string key="0">C'est un plan du 1er étage.\nLe prendre?{scroll 1}{branch 0 6 0}</string>
      <string key="1">Le bois est dans la\ncuisinière.{scroll 2}{clear 0}\nLe papier est sur le mur.{scroll 2}</string>
      <string key="2">Vous avez le plan \ndu 1er étage.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">Das ist ein Plan\ndes {color 1}1.ETAGE{color 0}.{scroll 2}{clear 0}Möchten Sie ihn mitnehmen?\n{scroll 1}{branch 0 6 0}</string>
      <string key="1">\nDa liegt Holz im Kamin.{scroll 2}{clear 0}An der Wand befinden sich\nPapierfetzen.{scroll 2}</string>
      <string key="2">Das ist ein Plan\ndes {color 1}1.ETAGE{color 0}.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Atrio 1P</string>
      <string key="0">È una mappa del PRIMO PIANO\nVuoi prenderla?{scroll 1}{branch 0 1 0}</string>
      <string key="1">\nC'è del legno nella stufa.{scroll 2}{clear 0}\nUn foglio è appeso al muro.{scroll 2}</string>
      <string key="2">Hai ottenuto la\nmappa del PRIMO PIANO{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">Es un mapa del primer piso...\n¿Te lo llevas?{scroll 1}{branch 0 6 0}</string>
      <string key="1">\nHay leña en la estufa...{scroll 2}{clear 0}\nUn papel está colgado en la pared...{scroll 2}</string>
      <string key="2">Ahora tienes el mapa\ndel primer piso...{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Зал 1-эт.</string>
