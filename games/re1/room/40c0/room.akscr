    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_06_NPC_BARRY_2_STARS, 0, 150, 75);
    act_reset();
    evt_nop();
    evt_fork(TASK_09, on_aot_07_sub1, 0);
    voice_play(VOICE_PLAY, VO_10C_06);
    message(MSG_VO_10C_06, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_07_sub2, 0);
    voice_play(VOICE_PLAY, VO_10C_07);
    message(MSG_VO_10C_07, 0);
    wait_message();
    evt_work_set(WK_ENEMY, ENEMY_06_NPC_BARRY_2_STARS);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_idle();
    act_reset();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}
