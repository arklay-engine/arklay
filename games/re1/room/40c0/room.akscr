            enemy(EM_2B_NPC_BARRY_2_STARS, EB_05, NO_FLAG, SPAWN_FORCE, 2, 0, 3873, 0, 7762, 0, 9009, ENEMY_06_NPC_BARRY_2_STARS, ANIM_2A, 0, EVAR_00);
            set(FG_ROOM, F_ROOM_0C, TRUE);
            evt_exec(0, TASK_09, on_enter);
