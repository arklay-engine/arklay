#version 1

proc init
{
    door_aot_set(0, 13700, 960, 1700, 1900, 1, 0, 31, 5, 134, RDT_004, 30700, 0, 3900, 1024, ITEM_SWORD_KEY, 129);
    aot_set(1, 8800, 7200, 1500, 1700, SCE_NONE, 193, 0, 0, 0, 0, 0, 0);
    aot_set(2, 10200, 7300, 600, 1500, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    if (ck(FG_COMMON, 167, 0))
    {
        item_aot_set(3, 0, 0, 0, 0, ITEM_WOOD_EMBLEM, 1, 0, 255, 4, 36, 208, 253, 94, 76, 0, 4, 20, 129, 0, 0);
    }
    else
    {
        item_aot_set(3, 0, 0, 0, 0, ITEM_WOOD_EMBLEM, 1, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 20, 129, 0, 0);
    }
    item_aot_set(4, 8100, 18800, 1500, 1000, ITEM_GOLD_EMBLEM, 1, 1, 255, 4, 36, 208, 253, 94, 76, 0, 4, 21, 129, 0, 0);
    item_aot_set(5, 17000, 11500, 800, 1000, ITEM_MUSIC_NOTES, 0, 2, 255, 98, 67, 72, 244, 30, 45, 226, 4, 7, 129, 0, 0);
    aot_set(6, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 9, 0, 4, 0, 1, 0);
    aot_set(7, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 4, 0, 34, 0, 1, 0);
    aot_set(8, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 9, 0, 5, 0, 1, 0);
    aot_set(9, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 4, 0, 33, 0, 1, 0);
    aot_set(10, 8100, 18800, 1500, 1000, SCE_MESSAGE, 129, 24, 0, 255, 0, 0, 0);
    aot_set(11, 7000, 14000, 3000, 1000, SCE_USEITEM, 65, 8, 0, 30, 0, 1, 0);
    aot_set(12, 9500, 8200, 500, 800, SCE_NONE, 128, 0, 0, 0, 0, 0, 0);
    aot_set(13, 10200, 7300, 600, 1500, SCE_USEITEM, 1, 9, 0, 8, 0, 1, 0);
    aot_set(14, 10200, 7300, 600, 1500, SCE_USEITEM, 1, 4, 0, 35, 0, 1, 0);
    obj(0, 53, 255, 9100, 0, 12576, 1024, 62, 254, 0, 0, 194, 1, 0, 0, 84, 6, 24, 21, 128, 62, 194, 1);
    obj(1, 1, 255, 17394, 0, 11190, 1024, 0, 0, 108, 3, 0, 0, 148, 252, 44, 1, 32, 2, 20, 5, 38, 2);
    obj(2, 35, 255, 15000, 0, 11200, 1024, 0, 0, 0, 0, 0, 0, 0, 0, 88, 2, 32, 2, 132, 3, 88, 2);
    if (ck(FG_COMMON, 165, 0))
    {
        evt_exec(0, 9, event_04);
    }
    evt_exec(0, 9, event_08);
}

proc main
{
    if (testitem(ITEM_MUSIC_NOTES))
    {
        if (ck(FG_ROOM, 35, 0))
        {
            evt_exec(0, 9, event_00);
        }
    }
    if (ck(FG_COMMON, 165, 0))
    {
        if (cmpb(2, 0, 1))
        {
            aot_switch(0, 14, 1);
        }
    }
    if (ck(FG_COMMON, 167, 1))
    {
        if (ck(FG_COMMON, 166, 0))
        {
            aot_delete(6, SCE_USEITEM, 1);
            aot_delete(7, SCE_USEITEM, 1);
        }
        else
        {
            aot_delete(6, SCE_NONE, 1);
            aot_delete(7, SCE_NONE, 1);
        }
        if (testpickup(ITEM_GOLD_EMBLEM))
        {
            set(FG_COMMON, 166, 0);
            evt_exec(0, 9, event_02);
        }
        if (testitem(ITEM_WOOD_EMBLEM))
        {
            if (ck(FG_ROOM, 34, 0))
            {
                set(FG_ITEM, 20, 0);
                set(FG_COMMON, 167, 0);
                objtbl_b_set(1, 0, 1);
                aot_delete(3, SCE_ITEM, 129);
                evt_exec(0, 9, event_03);
                evt_exec(0, 9, event_05);
            }
        }
        if (testitem(ITEM_GOLD_EMBLEM))
        {
            if (ck(FG_ROOM, 33, 0))
            {
                set(FG_ITEM, 21, 0);
                objtbl_b_set(1, 1, 1);
                aot_delete(4, SCE_ITEM, 129);
                evt_exec(0, 9, event_03);
                set(FG_COMMON, 166, 1);
            }
        }
    }
    else
    {
        aot_delete(6, SCE_NONE, 1);
        aot_delete(7, SCE_NONE, 1);
        aot_delete(8, SCE_NONE, 1);
        aot_delete(9, SCE_NONE, 1);
    }
    if (ck(FG_COMMON, 167, 0))
    {
        aot_reset(10, SCE_MESSAGE, 129, 153, 255, 0);
    }
    else if (ck(FG_COMMON, 166, 0))
    {
        aot_reset(10, SCE_MESSAGE, 129, 152, 255, 0);
    }
    else
    {
        aot_delete(10, SCE_NONE, 129);
    }
}

event event_00
{
    run
    {
        set(FG_6, 23, 1);
        message(151, 0);
        set(FG_STATUS, 15, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_chain(6);
    evt_nop();
    evt_nop();
}

event event_01
{
    se_play_3d(2, 23, 0, 0, 0, 9424, 12173);
    se_play_3d(2, 24, 0, 0, 0, 9424, 12173);
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    evt_next();
    tw_nop();
    tw_set_pos(0, 208, 0);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    evt_finish();
}

event event_02
{
    se_play_3d(2, 23, 0, 0, 0, 9424, 12173);
    se_play_3d(2, 24, 0, 0, 0, 9424, 12173);
    set(FG_6, 23, 1);
    sleep(20);
    run
    {
        set(FG_STATUS, 15, 0);
        cutnext(3);
    }
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    evt_next();
    tw_nop();
    tw_abs_pos(0, 9060, -4250, 12596);
    tw_set_pos(0, 48, 0);
    for (90)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    se_play_3d(2, 25, 0, 0, 0, 9424, 12173);
    sleep(10);
    run
    {
        cutnext(4);
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
        cut_auto(0);
    }
    evt_finish();
}

