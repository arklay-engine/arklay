#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_DOOR 0x04
#define AOT_05_ITEM 0x05
#define AOT_06_USEITEM 0x06
#define CAM_03 0x03
#define CAM_06 0x06
#define CAM_07 0x07
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_NPC_BARRY 0x00
#define F_ROOM_00 0x00
#define F_ROOM_01 0x01
#define F_ROOM_02 0x02
#define F_ROOM_3F 0x3F
#define IMDL_00 0x00
#define MSG_VO_007_0D_63 0x06
#define MSG_VO_00C_00 0x04
#define MSG_VO_00C_01 0x05
#define MSG_VO_00C_20 0x06
#define MSG_VO_00C_21 0x07
#define MSG_VO_00C_22 0x07
#define MSG_VO_105_06 0x00
#define MSG_VO_105_07 0x01
#define MSG_VO_105_08 0x02
#define MSG_VO_105_09 0x03
#define OBJ_00 0x00
#define VO_007_0D_63 0x63
#define VO_00C_00 0x54
#define VO_00C_01 0x55
#define VO_00C_20 0x64
#define VO_00C_21 0x65
#define VO_00C_22 0x66
#define VO_105_05 0x35
#define VO_105_06 0x36
#define VO_105_07 0x37
#define VO_105_08 0x38
#define VO_105_09 0x39

proc init
{
    door_aot_set(AOT_00_DOOR, 23400, 800, 2000, 1700, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_108_L_PASSAGE, 25000, 0, 25300, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if MANSION1
    door_aot_set(AOT_01_DOOR, 25000, 6800, 2000, 2300, 2, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_04, ROOM_114_BOILER, 10030, 0, 23449, 1024, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 17000, 8000, 1600, 1930, 0, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 7, DOOR_LOCK_40, ROOM_113_BATHROOM, 2800, 0, 2400, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 6850, 8500, 1650, 2500, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCK_40, ROOM_115_ALMOST_A_SANDWICH, 2500, 0, 4900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#else
    door_aot_set(AOT_01_DOOR, 25000, 6800, 2000, 2300, 2, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | F_LOCK_04, ROOM_114_BOILER, 10030, 0, 23449, 1024, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 17000, 8000, 1600, 1930, 0, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 7, 0, ROOM_113_BATHROOM, 2800, 0, 2400, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 6850, 8500, 1650, 2500, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_115_ALMOST_A_SANDWICH, 2500, 0, 4900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#endif
    door_aot_set(AOT_04_DOOR, 0, 7300, 2600, 2500, 6, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_10A_BACK_PASSAGE, 15200, 0, 3900, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_05_ITEM, 20406, 1524, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_00, SCA_NONE, 21306, 0, 2424, 0, F_ITEM_6F, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
#if MANSION2
    aot_set(AOT_06_USEITEM, 12600, 2800, 7400, 8700, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 2, 0, 1, 0);
#endif
    obj(OBJ_00, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 7590, 0, 8680, 0, 0, 0, 0, 0, 0, 0, 0, 0);
#if MANSION1
#if JILL
    enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 0, 0, 0, ENEMY_00_NPC_BARRY, ANIM_22, 24, EVAR_00);
    if (ck(FG_COMMON, F_COMMON_20, TRUE))
    {
        evt_exec(0, TASK_09, on_enter_2);
        if (ck(FG_COMMON, F_COMMON_21, FALSE))
        {
            evt_exec(0, TASK_09, on_enter);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_07, 0);
        }
    }
#endif
#else
    if (ck(FG_SCENARIO, F_SCENARIO_5E, TRUE))
    {
        enemy(EM_06_HUNTER, EB_12, F_ENEMY_76, SPAWN_FORCE, 2, 0, 1536, 0, 15565, 0, 12166, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
    }
    else
    {
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_10A_BACK_PASSAGE))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
        }
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_115_ALMOST_A_SANDWICH))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
        }
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_108_L_PASSAGE))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
        }
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_113_BATHROOM))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
        }
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_114_BOILER))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
        }
    }
    if (ck(FG_ROOM, F_ROOM_00, TRUE))
    {
        enemy(EM_06_HUNTER, EB_88, F_ENEMY_76, SPAWN_FORCE, 2, 0, 3600, 0, 20824, 0, 7524, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
    }
    if (ck(FG_ROOM, F_ROOM_01, TRUE))
    {
#if CHRIS
        enemy(EM_06_HUNTER, EB_89, F_ENEMY_76, SPAWN_FORCE, 2, 0, 0, 0, 12733, 0, 14086, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
#else
        enemy(EM_06_HUNTER, EB_99, F_ENEMY_76, SPAWN_FORCE, 2, 0, 0, 0, 12733, 0, 14086, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
#endif
    }
    room_bgm_state_set(5, 9, BGM_OFF);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_21, TRUE))
    {
        set(FG_COMMON, F_COMMON_21, FALSE);
        if (ck(FG_COMMON, F_COMMON_22, TRUE))
        {
            plw_anim(PLW_02, ANIM_28, 0);
            setw(W_04, 0);
            room_bgm_state_set(5, 9, BGM_RELOAD);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_07, 0);
            evt_exec(0, TASK_09, on_enter);
        }
        if (ck(FG_COMMON, F_COMMON_36, TRUE))
        {
            plw_anim(PLW_02, ANIM_28, 0);
            setw(W_04, 0);
            room_bgm_state_set(5, 9, BGM_RELOAD);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_07, 0);
            evt_exec(0, TASK_09, on_enter_2);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_20, TRUE))
    {
        evt_exec(0, TASK_09, on_enter);
    }
#endif
#endif
}

proc main
{
#if MANSION1
    return;
#else
    if (ck(FG_SCENARIO, F_SCENARIO_5E, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_00, TRUE) && ck(FG_ROOM, F_ROOM_02, TRUE))
        {
            set(FG_SCENARIO, F_SCENARIO_5E, TRUE);
            eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_08);
        }
        if (ck(FG_ROOM, F_ROOM_01, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_03))
        {
            set(FG_SCENARIO, F_SCENARIO_5E, TRUE);
            eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_09);
        }
    }
#endif
}

#if CHRIS
event event_00
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 1000, 0, 1000);
    tw_end();
    evt_nop();
    single(6) aot_reset(AOT_03_DOOR, SCE_NONE, 0, 0, 0, 0);
    evt_nop();
    evt_nop();
    evt_nop();
    evt_nop();
    evt_nop();
    evt_nop();
    evt_finish();
}

#if MANSION1
event event_01
#else
event on_enter
#endif
#else
#if MANSION1
event on_enter
#else
event event_00
#endif
#endif
{
#if CHRIS
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 650, 0, 5300, 0, 7160);
#else
    run
    {
        set(FG_COMMON, F_COMMON_21, TRUE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        dir_set(0, 0, 2400, 0, 6800, 0, 7300);
#if MANSION1
        pos_set(ENEMY_00_NPC_BARRY, 0, 400, 0, 4800, 0, 8900);
#else
        pos_set(ENEMY_00_HUNTER, 0, 400, 0, 4800, 0, 8900);
#endif
    }
#endif
    sleep(1);
#if JILL
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
#else
#if MANSION1
    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_NPC_BARRY, 0, 150, 75);
#else
    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_HUNTER, 0, 150, 75);
#endif
#endif
    act_reset();
    evt_nop();
#if JILL
    sleep(10);
#if MANSION1
    evt_fork(TASK_09, on_enter_sub1, 0);
#else
    evt_fork(TASK_09, event_02, 0);
#endif
    sleep(4);
    voice_play(VOICE_PLAY, VO_105_05);
    sleep(35);
    wait_message();
    sleep(30);
#if MANSION1
    evt_fork(TASK_09, on_enter_sub2, 0);
    evt_fork(TASK_09, on_enter_sub3, 0);
#else
    evt_fork(TASK_09, event_03, 0);
    evt_fork(TASK_09, event_04, 0);
#endif
    voice_play(VOICE_PLAY, VO_105_06);
    message(MSG_VO_105_06, 0);
    wait_message();
    sleep(30);
#if MANSION1
    evt_fork(TASK_09, on_enter_sub4, 0);
#else
    evt_fork(TASK_09, event_05, 0);
#endif
    sleep(20);
    voice_play(VOICE_PLAY, VO_105_07);
    message(MSG_VO_105_07, 0);
    wait_message();
    sleep(30);
#if MANSION1
    evt_fork(TASK_09, on_enter_sub5, 0);
#else
    evt_fork(TASK_09, event_06, 0);
#endif
    voice_play(VOICE_PLAY, VO_105_08);
    message(MSG_VO_105_08, 0);
    wait_message();
    cutnext(CAM_06);
#if MANSION1
    evt_fork(TASK_09, on_enter_sub6, 0);
#else
    evt_fork(TASK_09, event_07, 0);
#endif
    sleep(85);
#endif
    run
    {
#if CHRIS
#if MANSION2
        bgm_play(BGM_SUB_1);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
#endif
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
#if MANSION1
        evt_exec(0, TASK_09, event_02);
#else
        evt_exec(0, TASK_09, on_enter_sub1);
#endif
        voice_play(VOICE_PLAY, VO_00C_00);
        message(MSG_VO_00C_00, 0);
#else
        cutnext(CAM_07);
        voice_play(VOICE_PLAY, VO_105_09);
        message(MSG_VO_105_09, 0);
#endif
    }
#if JILL
#if MANSION1
    evt_fork(TASK_09, on_enter_sub7, 0);
    evt_fork(TASK_09, on_enter_sub8, 0);
#else
    evt_fork(TASK_09, event_08, 0);
    evt_fork(TASK_09, event_09, 0);
#endif
#endif
    wait_message();
#if JILL
    sleep(50);
    run
    {
        cutnext(CAM_06);
        dir_set(0, 0, 3360, 0, 5400, 0, 8400);
#if MANSION1
        pos_set(ENEMY_00_NPC_BARRY, 0, 0, 0, 0, 0, 0);
#else
        pos_set(ENEMY_00_HUNTER, 0, 0, 0, 0, 0, 0);
#endif
    }
    sleep(20);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_motion_path(MOTION_32, 0, 0, 0, 0, 50);
#else
    act_motion_path(MOTION_33, 500, 0, 0, 70, 0);
    act_motion(MOTION_10);
#endif
    act_reset();
    evt_nop();
#if CHRIS
    sleep(30);
    voice_play(VOICE_PLAY, VO_00C_01);
    message(MSG_VO_00C_01, 0);
    wait_message();
#else
    sleep(10);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
#if JILL
    act_nop();
#endif
    act_reset();
#if JILL
    evt_nop();
#endif
    run
    {
        cut_auto(CUT_FREE);
#if CHRIS
        dir_set(0, 0, 1194, 0, 5520, 0, 8360);
#else
        set(FG_STATUS, F_STATUS_0F, FALSE);
#endif
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
#if MANSION2
#if CHRIS
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
#endif
#endif
    }
#if CHRIS
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
#endif
    evt_finish();
}

