    evt_fork(9, on_enter_sub7, 0);
    evt_fork(9, on_enter_sub8, 0);
#else
    evt_fork(9, event_08, 0);
    evt_fork(9, event_09, 0);
#endif
#endif
    wait_message();
#if JILL
    sleep(50);
    run
    {
        cutnext(6);
        dir_set(0, 0, 3360, 0, 5400, 0, 8400);
        pos_set(0, 0, 0, 0, 0, 0, 0);
    }
    sleep(20);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_motion_path(50, 0, 0, 0, 0, 50);
#else
    act_motion_path(51, 500, 0, 0, 70, 0);
    act_motion(16);
#endif
    act_reset();
    evt_nop();
#if CHRIS
    sleep(30);
    voice_play(1, 85, 0);
    message(5, 0);
    wait_message();
