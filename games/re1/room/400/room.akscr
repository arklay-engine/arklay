#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_304 0x00
#define AOT_01_DOOR_401 0x01
#define AOT_02_DOOR_403 0x02
#define AOT_03_DOOR_404 0x03
#define AOT_04_DOOR_405 0x04
#define AOT_05_ITEM_HEAL_HERB_BLUE_0 0x05
#define AOT_06_USEITEM_PLANT_HOLE 0x06                      // Raises F_ROOM_BLOCK_ON_HOLE while the block is over it.
#define AOT_07_ITEM_HEAL_HERB_BLUE_1 0x07
#define AOT_08_ITEM_HEAL_HERB_BLUE_2 0x08
#define ENEMY_00_PLANT_FOUNTAIN 0x00
#define F_ROOM_BLOCK_ON_HOLE 0x18                           // The block is over the plant's hole (raised by the use spot; main clears it).
#define F_ROOM_PLANT_SUPPRESSED 0x17                        // The plant tentacle was put in its blocked behaviour (EB_80).
#define IMDL_00_HEAL_HERB_BLUE 0x00
#define IMDL_01_HEAL_HERB_BLUE 0x01
#define IMDL_02_HEAL_HERB_BLUE 0x02
#define OBJ_00_PUSH_BLOCK 0x00                              // Guess: the pushable object that blocks the plant tentacle's hole.

proc init
{
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
    door_aot_set(AOT_00_DOOR_304, 2300, 6500, 2700, 3200, 2, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, STAGE_3 | ROOM_304_SECOND_HOUSE_GATE, 4000, 0, 30000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_401, 11300, 13800, 3500, 3200, 1, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_401_ROOM_001, 9700, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_403, 10600, 8200, 2400, 3200, 3, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 4, 0, ROOM_403_SAVE_ROOM, 8600, 0, 9000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR_404, 20900, 11100, 3400, 3200, 12, DOOR_SND_00_DR_WD, DOOR_05_DOOR05, 1, 0, ROOM_404_BAR, 11600, 0, 12700, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_04_DOOR_405, 14700, 500, 3700, 2000, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 9, 0, ROOM_405_CENTER_PASSAGE, 3800, 0, 4500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_05_ITEM_HEAL_HERB_BLUE_0, 4700, 17300, 600, 600, IT_45_HEAL_HERB_BLUE, 1, IMDL_00_HEAL_HERB_BLUE, SCA_NONE, 5000, 0, 17600, 0, F_ITEM_400_HEAL_HERB_BLUE_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_07_ITEM_HEAL_HERB_BLUE_1, 4700, 16700, 600, 600, IT_45_HEAL_HERB_BLUE, 1, IMDL_01_HEAL_HERB_BLUE, SCA_NONE, 5000, 0, 17000, 0, F_ITEM_400_HEAL_HERB_BLUE_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_08_ITEM_HEAL_HERB_BLUE_2, 4700, 16100, 600, 600, IT_45_HEAL_HERB_BLUE, 1, IMDL_02_HEAL_HERB_BLUE, SCA_NONE, 5000, 0, 16400, 0, F_ITEM_400_HEAL_HERB_BLUE_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    if (ck(FG_SCENARIO, F_SCENARIO_PLANT_HOLE_BLOCKED, TRUE))
    {
        obj(OBJ_00_PUSH_BLOCK, OF_ACTIVE, SCA_NONE, 16236, 0, 8700, 3072, 0, 0, 0, 0, 450, 1980, 450, 450);
    }
    else
    {
        obj(OBJ_00_PUSH_BLOCK, OF_ACTIVE, SCA_NONE, 4622, 0, 10550, 3072, 0, 0, 0, 0, 450, 1980, 450, 450);
    }
    aot_set(AOT_06_USEITEM_PLANT_HOLE, 15711, 8221, 900, 900, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 24, 0, 1, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PLANT_HOLE_BLOCKED, TRUE))
        {
            enemy(EM_0F_PLANT_FOUNTAIN, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 16161, 0, 8671, ENEMY_00_PLANT_FOUNTAIN, ANIM_00, 0, EVAR_00);
            set(FG_ROOM, F_ROOM_BLOCK_ON_HOLE, TRUE);
            set(FG_ROOM, F_ROOM_PLANT_SUPPRESSED, TRUE);
        }
        else
        {
            enemy(EM_0F_PLANT_FOUNTAIN, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 16161, 0, 8671, ENEMY_00_PLANT_FOUNTAIN, ANIM_00, 0, EVAR_00);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_A, FALSE) && ck(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_B, FALSE))
        {
            if (cmpw(0, W_05, CMP_GE, 105))
            {
                set(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_A, TRUE);
            }
            else
            {
                set(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_B, TRUE);
            }
        }
    }
    else
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_A, FALSE) && ck(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_B, FALSE))
        {
            if (cmpw(0, W_05, CMP_GE, 72))
            {
                set(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_A, TRUE);
            }
            else
            {
                set(FG_SCENARIO, F_SCENARIO_PANEL_VARIANT_B, TRUE);
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_OVERHEARD_BARRY_WESKER, TRUE))
        {
            set(FG_COMMON, F_COMMON_J_BARRY_002_MISSED_400, TRUE);
        }
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_BLOCK_ON_HOLE, TRUE))
    {
        set(FG_SCENARIO, F_SCENARIO_PLANT_HOLE_BLOCKED, TRUE);
    }
    else
    {
        set(FG_SCENARIO, F_SCENARIO_PLANT_HOLE_BLOCKED, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_BLOCK_ON_HOLE, TRUE))
    {
        set(FG_ROOM, F_ROOM_BLOCK_ON_HOLE, FALSE);
        if (ck(FG_ROOM, F_ROOM_PLANT_SUPPRESSED, FALSE) && ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            set(FG_ROOM, F_ROOM_PLANT_SUPPRESSED, TRUE);
            eml_state(0, ENEMY_00_PLANT_FOUNTAIN, EML_BEHAVIOUR, EB_80);
        }
    }
    else if (ck(FG_ROOM, F_ROOM_PLANT_SUPPRESSED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        set(FG_ROOM, F_ROOM_PLANT_SUPPRESSED, FALSE);
        eml_state(0, ENEMY_00_PLANT_FOUNTAIN, EML_BEHAVIOUR, EB_02);
    }
    if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
    {
        aot_reset(AOT_00_DOOR_304, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 69, 0);
    }
}

event snap_block_onto_hole
{
    eml_pos(OBJ_00_PUSH_BLOCK, 0, 3072, 0, 16236, 0, 8700);
    evt_finish();
}
