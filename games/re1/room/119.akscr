#version 1

proc init
{
    door_aot_set(0, 5000, 1300, 1500, 1400, 2, 0, 1, 4, 0, RDT_00A, 8400, 0, 5000, 1024, UNLOCKED, 129);
    item_aot_set(1, 1820, 3942, 1800, 1800, ITEM_DOOM_BOOK_1_, 0, 0, 255, 160, 10, 124, 252, 234, 18, 0, 0, 67, 0, 0, 0);
    aot_set(2, 3270, 6862, 1000, 1000, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    aot_set(3, 6800, 3600, 1200, 1600, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    item_aot_set(4, 4110, 6462, 1800, 1800, ITEM_MAGNUM_ROUNDS, 6, 1, 255, 10, 20, 96, 250, 58, 29, 152, 254, 101, 0, 0, 0);
    aot_set(5, 1900, 9100, 1500, 600, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    set(FG_ROOM, 10, 0);
    cut_auto(1);
    setb(2, 2, 0);
    if (ck(FG_STATUS, 8, 1))
    {
        if (ck(FG_COMMON, 33, 0))
        {
            set(FG_COMMON, 33, 1);
            if (ck(FG_COMMON, 34, 0))
            {
                plw_anim(2, 40, 0);
                setw(4, 0, 0);
                evt_exec(0, 9, event_04);
            }
            if (ck(FG_COMMON, 54, 0))
            {
                plw_anim(2, 40, 0);
                setw(4, 0, 0);
                evt_exec(0, 9, event_06);
            }
            if (ck(FG_COMMON, 34, 1) && ck(FG_COMMON, 54, 1))
            {
                evt_exec(0, 9, event_03);
            }
        }
        else
        {
            evt_exec(0, 9, event_03);
        }
    }
    else
    {
        evt_exec(0, 9, event_03);
    }
    if (ck(FG_SCENARIO, 64, 1))
    {
        set(FG_SCENARIO, 64, 0);
    }
}

proc main
{
    if (ck(FG_ROOM, 10, 0))
    {
        aot_delete(1, SCE_NONE, 0);
        aot_reset(3, SCE_MESSAGE, 129, 130, 255, 0);
        aot_delete(4, SCE_NONE, 0);
    }
    else
    {
        if (ck(FG_ITEM, 67, 0))
        {
            aot_delete(1, SCE_ITEM, 129);
        }
        if (ck(FG_ITEM, 101, 0))
        {
            aot_delete(4, SCE_ITEM, 129);
        }
        aot_reset(3, SCE_MESSAGE, 129, 129, 255, 0);
    }
}

event event_00
{
    sleep(1);
    set(FG_6, 23, 1);
    message(128, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            se_play_3d(2, 23, 0, 1, 0, 0, 0);
            if (ck(FG_ROOM, 10, 1))
            {
                cutnext(3);
                evt_exec(0, 9, event_01);
            }
            else
            {
                cutnext(1);
                evt_exec(0, 9, event_02);
            }
        }
        else
        {
            evt_exec(0, 9, event_03);
        }
    }
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_ROOM, 10, 0);
        msg_list(0, 32, 18, 142, 249, 64, 36, 70, 70, 70, 0, 240, 35, 116, 24, 48, 248, 153, 36, 70, 70, 70, 0, 240, 35, 48, 12, 48, 248, 240, 35, 70, 70, 70, 0, 240, 35, 32, 3, 32, 3, 32, 3);
    }
    evt_chain(3);
    evt_finish();
}

event event_02
{
    set(FG_ROOM, 10, 1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    run
    {
        timer_setup(2, 240, 216, 7, 0);
        msg_list(0, 96, 14, 142, 249, 248, 27, 90, 90, 90, 0, 112, 23, 40, 15, 48, 248, 240, 30, 130, 130, 130, 0, 239, 25, 32, 13, 48, 248, 240, 30, 111, 111, 111, 0, 159, 20, 112, 4, 96, 4, 16, 4);
    }
    evt_chain(3);
    evt_finish();
}

event event_03
{
    sleep(1);
    cut_auto(0);
    sleep(1);
    set(FG_6, 23, 0);
    evt_finish();
}

event event_04
{
    set(FG_STATUS, 15, 0);
    dir_set(0, 0, 2880, 0, 5600, 0, 3246);
    sleep(1);
    bgm_play(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, 23, 1);
        evt_exec(0, 9, event_05);
        voice_play(1, 84, 0);
        message(4, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(1, 85, 0);
    message(5, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(0);
        set(FG_6, 23, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, 15, 1);
    evt_finish();
}

