#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_EVENT 0x02
#define AOT_03_MESSAGE 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_MESSAGE 0x05
#define F_ROOM_0A 0x0A
#define MSG_THERE_IS_A_SWITCH 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 5000, 1300, 1500, 1400, 2, 0, 1, 4, 0, ROOM_10A_BACK_PASSAGE, 8400, 0, 5000, 1024, UNLOCKED, 129);
    item_aot_set(AOT_01_ITEM, 1820, 3942, 1800, 1800, IT_40_KEY_BOOK_DOOM_1, 0, 0, 255, 160, 10, 124, 252, 234, 18, 0, 0, 67, 0, 0, 0);
    aot_set(AOT_02_EVENT, 3270, 6862, 1000, 1000, SCE_EVENT, 129, 9, 0, on_aot_02, 0, 0, 0);
    aot_set(AOT_03_MESSAGE, 6800, 3600, 1200, 1600, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    item_aot_set(AOT_04_ITEM, 4110, 6462, 1800, 1800, IT_0E_AMMO_MAGNUM, 6, 1, 255, 10, 20, 96, 250, 58, 29, 152, 254, 101, 0, 0, 0);
    aot_set(AOT_05_MESSAGE, 1900, 9100, 1500, 600, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    set(FG_ROOM, F_ROOM_0A, TRUE);
    cut_auto(1);
    setb(2, 2, 0);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_21, TRUE))
        {
            set(FG_COMMON, F_COMMON_21, FALSE);
            if (ck(FG_COMMON, F_COMMON_22, TRUE))
            {
                plw_anim(2, 40, 0);
                setw(4, 0, 0);
                evt_exec(0, 9, on_enter_2);
            }
            if (ck(FG_COMMON, F_COMMON_36, TRUE))
            {
                plw_anim(2, 40, 0);
                setw(4, 0, 0);
                evt_exec(0, 9, on_enter_3);
            }
            if (ck(FG_COMMON, F_COMMON_22, FALSE) && ck(FG_COMMON, F_COMMON_36, FALSE))
            {
                evt_exec(0, 9, on_enter);
            }
        }
        else
        {
            evt_exec(0, 9, on_enter);
        }
    }
    else
    {
        evt_exec(0, 9, on_enter);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_40, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_40, TRUE);
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_0A, TRUE))
    {
        aot_delete(AOT_01_ITEM, SCE_NONE, 0);
        aot_reset(AOT_03_MESSAGE, SCE_MESSAGE, 129, 130, 255, 0);
        aot_delete(AOT_04_ITEM, SCE_NONE, 0);
    }
    else
    {
        if (ck(FG_ITEM, F_ITEM_43, TRUE))
        {
            aot_delete(AOT_01_ITEM, SCE_ITEM, 129);
        }
        if (ck(FG_ITEM, F_ITEM_65, TRUE))
        {
            aot_delete(AOT_04_ITEM, SCE_ITEM, 129);
        }
        aot_reset(AOT_03_MESSAGE, SCE_MESSAGE, 129, 129, 255, 0);
    }
}

event on_aot_02
{
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    message(MSG_THERE_IS_A_SWITCH | 0x80, 255); // "There's a switch. Will you push it? Nothing uncommon."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            se_play_3d(2, 23, 0, 1, 0, 0, 0);
            if (ck(FG_ROOM, F_ROOM_0A, FALSE))
            {
                cutnext(3);
                evt_exec(0, 9, on_aot_02_sub1);
            }
            else
            {
                cutnext(1);
                evt_exec(0, 9, on_aot_02_sub2);
            }
        }
        else
        {
            evt_exec(0, 9, on_enter);
        }
    }
    evt_finish();
}

event on_aot_02_sub1
{
    run
    {
        set(FG_ROOM, F_ROOM_0A, TRUE);
        msg_list(0, 32, 18, 142, 249, 64, 36, 70, 70, 70, 0, 240, 35, 116, 24, 48, 248, 153, 36, 70, 70, 70, 0, 240, 35, 48, 12, 48, 248, 240, 35, 70, 70, 70, 0, 240, 35, 32, 3, 32, 3, 32, 3);
    }
    evt_chain(3);
    evt_finish();
}

event on_aot_02_sub2
{
    set(FG_ROOM, F_ROOM_0A, FALSE);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    run
    {
        timer_setup(2, 240, 216, 7, 0);
        msg_list(0, 96, 14, 142, 249, 248, 27, 90, 90, 90, 0, 112, 23, 40, 15, 48, 248, 240, 30, 130, 130, 130, 0, 239, 25, 32, 13, 48, 248, 240, 30, 111, 111, 111, 0, 159, 20, 112, 4, 96, 4, 16, 4);
    }
    evt_chain(3);
    evt_finish();
}

event on_enter
{
    sleep(1);
    cut_auto(0);
    sleep(1);
    set(FG_6, F_6_17, TRUE);
    evt_finish();
}

event on_enter_2
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 2880, 0, 5600, 0, 3246);
    sleep(1);
    bgm_play(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, F_6_17, FALSE);
        evt_exec(0, 9, on_enter_2_sub1);
        voice_play(1, 84, 0);
        message(4, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(1, 85, 0);
    message(5, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

event on_enter_2_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(70);
    act_motion_path(49, 1250, 0, 0, 50, 0);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_motion(16);
    act_reset();
    evt_nop();
    evt_finish();
}

event on_enter_3
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 2880, 0, 5600, 0, 3246);
    sleep(1);
    bgm_play(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, F_6_17, FALSE);
        evt_exec(0, 9, on_enter_3_sub1);
        voice_play(1, 100, 0);
        message(6, 0);
    }
    sleep(40);
    wait_message();
    sleep(10);
    voice_play(1, 101, 0);
    sleep(56);
    sleep(10);
    voice_play(1, 102, 0);
    message(7, 0);
    wait_message();
    run
    {
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 0, 0, 0, 250, 250);
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

event on_enter_3_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(40);
    act_motion_path(51, 1700, 60536, 0, 150, 50);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_motion_path(51, 63836, 60536, 0, 150, 50);
    sleep(15);
    act_motion_path(51, 1700, 60536, 0, 150, 50);
    sleep(25);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(40);
    act_anim_flags(32 | 10, 32 | 31, 0 | 0);
    sleep(40);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    act_flag_op(1, 16, 0);
    act_finish();
}
