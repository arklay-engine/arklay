event on_enter
{
    sleep(1);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_motion_path(147, 0, 0, 0, 150, 75);
    act_anim_flags(32 | 10, 32 | 31, 0 | 3);
    act_flag_op(0, 16, 0);
    act_finish();
}

event on_aot_0d
{
    run
    {
        cutnext(0);
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        set(FG_COMMON, FLAG_COMMON_3B, TRUE);
    }
    evt_fork(9, on_aot_0d_sub1, 0);
    voice_play(1, 59, 0);
    message(12, 0);
    wait_message();
    message(13, 0); // "Do you want me to heal your wounds?"
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, on_aot_0d_sub2);
        }
        else
        {
            evt_exec(0, 9, on_aot_0d_sub3);
        }
    }
    evt_finish();
}

