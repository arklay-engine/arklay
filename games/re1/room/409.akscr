event on_aot_0d_2
{
    run
    {
        cutnext(CAM_00);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    evt_fork(TASK_09, on_aot_0d_2_sub3, 0);
    voice_play(VOICE_PLAY, VO_A08_07, 0);
    message(MSG_VO_A08_07, 0);
    wait_message();
    message(MSG_DO_YOU_WANT_ME_TO_HEAL, 0); // "Do you want me to heal your wounds?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, on_aot_0d_2_sub1);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_0d_2_sub2);
        }
    }
    evt_finish();
}

