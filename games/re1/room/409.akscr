event from_main
{
    run
    {
        set(FG_ROOM, FLAG_ROOM_19, FALSE);
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_19, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 1, 0 | 25, 0 | 0);
    act_reset();
    evt_nop();
    se_play_3d(3, 0, 0, 1, 0, 0, 0);
    single(12) effect(9, 25, 1, 88, 2, 160, 246, 0, 0);
    evt_nop();
    evt_nop();
    sleep(4);
    single(12) effect(9, 25, 1, 88, 2, 160, 246, 0, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_19, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ROOM, FLAG_ROOM_02, TRUE))
        {
            timer_setup(3, 64, 6, 6, 0);
        }
        else
        {
            timer_setup(3, 176, 4, 6, 0);
        }
        set(FG_ROOM, FLAG_ROOM_19, FALSE);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_6, FLAG_6_1F, FALSE);
        set(FG_6, FLAG_6_19, FALSE);
    }
    sleep(20);
    setw(2, 0, 0);
    message(139, 0); // "Perhaps I should leave for a moment."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, FLAG_6_1F, TRUE);
        set(FG_6, FLAG_6_19, TRUE);
        set(FG_6, FLAG_6_1D, TRUE);
        sys_multi(8, 320);
    }
    evt_finish();
}

