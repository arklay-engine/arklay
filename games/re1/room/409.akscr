        }
    }
#else
    aot_set(AOT_0B_MESSAGE, 7300, 6000, 2200, 1100, SCE_MESSAGE, 129, 136, 0, 255, 0, 0, 0);
    aot_set(AOT_0C_MESSAGE, 1900, 3500, 1200, 1900, SCE_MESSAGE, 129, 137, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 5900, 1400, 1100, 1500, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 3000, 1500, 1200, 600, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 9800, 4400, 700, 1700, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
#endif
}

proc main
{
    set(FG_ITEM, FLAG_ITEM_40, TRUE);
    set(FG_ITEM, FLAG_ITEM_41, TRUE);
    set(FG_ITEM, FLAG_ITEM_42, TRUE);
#if CHRIS
    if (cmpb(9, 0, 3))
    {
        if (item_ck(ITEM_13_CHEMICAL_EMPTY_BOTTLE))
        {
            aot_reset(AOT_08_MESSAGE, SCE_EVENT, 129, 9, on_aot_08_message, 0);
            aot_reset(AOT_0B_MESSAGE, SCE_EVENT, 129, 9, on_aot_0b_message, 0);
            aot_reset(AOT_0C_MESSAGE, SCE_EVENT, 129, 9, on_aot_0c_message, 0);
        }
        else
        {
            aot_reset(AOT_08_MESSAGE, SCE_MESSAGE, 129, 132, 77, 0);
            aot_reset(AOT_0B_MESSAGE, SCE_MESSAGE, 129, 136, 77, 0);
            aot_reset(AOT_0C_MESSAGE, SCE_MESSAGE, 129, 137, 77, 0);
        }
    }
    else if (ck(FG_ITEM, FLAG_ITEM_4E, FALSE))
    {
        aot_reset(AOT_0B_MESSAGE, SCE_MESSAGE, 129, 152, 77, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_MESSAGE, 129, 153, 77, 0);
    }
    else
    {
        aot_reset(AOT_0B_MESSAGE, SCE_NONE, 129, 152, 77, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_NONE, 129, 153, 77, 0);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_16, TRUE))
    {
        if (ck(FG_ROOM, FLAG_ROOM_18, FALSE))
        {
            evt_exec(0, 9, from_main);
        }
        else if (ck(FG_ROOM, FLAG_ROOM_00, TRUE))
        {
            evt_exec(0, 9, from_main);
        }
        set(FG_SCENARIO, FLAG_SCENARIO_16, FALSE);
        set(FG_ROOM, FLAG_ROOM_18, TRUE);
    }
    if (ck(FG_ROOM, FLAG_ROOM_01, TRUE))
    {
        set(FG_ROOM, FLAG_ROOM_01, FALSE);
        evt_exec(0, 9, from_main_2);
    }
#else
    if (ck(FG_ITEM, FLAG_ITEM_4E, TRUE))
    {
        if (item_ck(ITEM_13_CHEMICAL_EMPTY_BOTTLE))
        {
            aot_reset(AOT_08_MESSAGE, SCE_EVENT, 129, 9, on_aot_08_message, 0);
        }
        else
        {
            aot_reset(AOT_08_MESSAGE, SCE_MESSAGE, 129, 132, 77, 0);
        }
        aot_delete(AOT_0B_MESSAGE, SCE_NONE, 129);
        aot_delete(AOT_0C_MESSAGE, SCE_NONE, 129);
    }
    else if (item_ck(ITEM_13_CHEMICAL_EMPTY_BOTTLE))
    {
        aot_reset(AOT_08_MESSAGE, SCE_EVENT, 129, 9, on_aot_08_message, 0);
        aot_reset(AOT_0B_MESSAGE, SCE_EVENT, 129, 9, on_aot_0b_message, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_EVENT, 129, 9, on_aot_0c_message, 0);
    }
    else
    {
        aot_reset(AOT_08_MESSAGE, SCE_MESSAGE, 129, 132, 77, 0);
        aot_reset(AOT_0B_MESSAGE, SCE_MESSAGE, 129, 136, 77, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_MESSAGE, 129, 137, 77, 0);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_16, TRUE))
    {
        if (ck(FG_ROOM, FLAG_ROOM_18, FALSE))
        {
            evt_exec(0, 9, from_main);
        }
        else if (ck(FG_ROOM, FLAG_ROOM_00, TRUE))
        {
            evt_exec(0, 9, from_main);
        }
        set(FG_SCENARIO, FLAG_SCENARIO_16, FALSE);
        set(FG_ROOM, FLAG_ROOM_18, TRUE);
    }
#endif
}

event on_aot_08_message
{
    run
    {
        set(FG_6, FLAG_6_1F, FALSE);
        set(FG_6, FLAG_6_19, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_1C, FALSE);
        message(133, 0); // "Will you put water in the empty bottle?There's a UMB.No2.Will you put UMB No.2 in the empty bottle?There's a UMB.No4.Will you put UMB No.4 in the empty bottle?There's UMB No.2. You need a container to obtain it."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            remove_item(ITEM_13_CHEMICAL_EMPTY_BOTTLE);
            give_item(5, 4, 0);
        }
        set(FG_6, FLAG_6_1F, TRUE);
        set(FG_6, FLAG_6_19, TRUE);
        set(FG_6, FLAG_6_1D, TRUE);
        set(FG_6, FLAG_6_1C, TRUE);
    }
    evt_finish();
}

