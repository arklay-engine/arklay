proc main
{
    set(FG_ITEM, 64, 0);
    set(FG_ITEM, 65, 0);
    set(FG_ITEM, 66, 0);
#if CHRIS
    if (cmpb(9, 0, 3))
    {
        if (item_ck(ITEM_EMPTY_BOTTLE))
        {
            aot_reset(8, SCE_EVENT, 129, 9, event_00, 0);
            aot_reset(11, SCE_EVENT, 129, 9, event_01, 0);
            aot_reset(12, SCE_EVENT, 129, 9, event_02, 0);
        }
        else
        {
            aot_reset(8, SCE_MESSAGE, 129, 132, 77, 0);
            aot_reset(11, SCE_MESSAGE, 129, 136, 77, 0);
            aot_reset(12, SCE_MESSAGE, 129, 137, 77, 0);
        }
    }
    else if (ck(FG_ITEM, 78, 1))
    {
        aot_reset(11, SCE_MESSAGE, 129, 152, 77, 0);
        aot_reset(12, SCE_MESSAGE, 129, 153, 77, 0);
    }
    else
    {
        aot_reset(11, SCE_NONE, 129, 152, 77, 0);
        aot_reset(12, SCE_NONE, 129, 153, 77, 0);
    }
    if (ck(FG_SCENARIO, 22, 0))
    {
        if (ck(FG_ROOM, 24, 1))
        {
            evt_exec(0, 9, event_03);
        }
        else if (ck(FG_ROOM, 0, 0))
        {
            evt_exec(0, 9, event_03);
        }
        set(FG_SCENARIO, 22, 1);
        set(FG_ROOM, 24, 0);
    }
    if (ck(FG_ROOM, 1, 0))
    {
        set(FG_ROOM, 1, 1);
        evt_exec(0, 9, event_04);
    }
#else
    if (ck(FG_ITEM, 78, 0))
    {
        if (item_ck(ITEM_EMPTY_BOTTLE))
        {
            aot_reset(8, SCE_EVENT, 129, 9, event_00, 0);
        }
        else
        {
            aot_reset(8, SCE_MESSAGE, 129, 132, 77, 0);
        }
        aot_delete(11, SCE_NONE, 129);
        aot_delete(12, SCE_NONE, 129);
    }
    else if (item_ck(ITEM_EMPTY_BOTTLE))
    {
        aot_reset(8, SCE_EVENT, 129, 9, event_00, 0);
        aot_reset(11, SCE_EVENT, 129, 9, event_01, 0);
        aot_reset(12, SCE_EVENT, 129, 9, event_02, 0);
    }
    else
    {
        aot_reset(8, SCE_MESSAGE, 129, 132, 77, 0);
        aot_reset(11, SCE_MESSAGE, 129, 136, 77, 0);
        aot_reset(12, SCE_MESSAGE, 129, 137, 77, 0);
    }
    if (ck(FG_SCENARIO, 22, 0))
    {
        if (ck(FG_ROOM, 24, 1))
        {
            evt_exec(0, 9, event_03);
        }
        else if (ck(FG_ROOM, 0, 0))
        {
            evt_exec(0, 9, event_03);
        }
        set(FG_SCENARIO, 22, 1);
        set(FG_ROOM, 24, 0);
    }
#endif
}

event event_00
{
    run
    {
        set(FG_6, 31, 1);
        set(FG_6, 25, 1);
        set(FG_6, 29, 1);
        set(FG_6, 28, 1);
        message(133, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            remove_item(ITEM_EMPTY_BOTTLE);
            give_item(5, 4, 0);
        }
        set(FG_6, 31, 0);
        set(FG_6, 25, 0);
        set(FG_6, 29, 0);
        set(FG_6, 28, 0);
    }
    evt_finish();
}

