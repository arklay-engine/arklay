event from_main
{
    run
    {
        set(FG_ROOM, F_ROOM_19, FALSE);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, FALSE);
        set(FG_MESSAGE, F_MESSAGE_READY, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 1, 0 | 25, 0 | 0);
    act_reset();
    evt_nop();
    se_play_3d(SND_BANK_PLAYER, SE_PL_00, 0, SND_AT_PLAYER, 0, 0, 0);
    single(12) effect(FX_09, 25, 1, 88, 2, 160, 246, 0, 0);
    evt_nop();
    evt_nop();
    sleep(4);
    single(12) effect(FX_09, 25, 1, 88, 2, 160, 246, 0, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ROOM, F_ROOM_02, TRUE))
        {
            timer_setup(3, 64, 6, 6, 0);
        }
        else
        {
            timer_setup(3, 176, 4, 6, 0);
        }
        set(FG_ROOM, F_ROOM_19, FALSE);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_PLAYER, FALSE);
        set(FG_MESSAGE, F_MESSAGE_READY, FALSE);
    }
    sleep(20);
    setw(W_LIGHT_DELTA, 0, 0);
    message(MSG_PERHAPS_I_SHOULD_LEAVE_FOR_A | MSG_FAST, 0); // "Perhaps I should leave for a moment."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_MESSAGE, F_MESSAGE_PLAYER, TRUE);
        set(FG_MESSAGE, F_MESSAGE_READY, TRUE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, TRUE);
        sys_multi(SYS_08, 320);
    }
    evt_finish();
}

#if CHRIS
event from_main_2
#else
event event_04
#endif
{
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 240, 216, 7, 0);
    evt_finish();
}
#if CHRIS

event on_enter
{
    sleep(1);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(147, 0, 0, 0, 150, 75);
    act_anim_flags(32 | 10, 32 | 31, 0 | 3);
    act_flag_op(0, 16, 0);
    act_finish();
}

event on_aot_0d
{
    run
    {
        cutnext(CAM_00);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_3B, TRUE);
    }
    evt_fork(TASK_09, on_aot_0d_sub1, 0);
    voice_play(VOICE_PLAY, VO_A08_00, 0);
    message(MSG_VO_A08_00, 0);
    wait_message();
    message(MSG_DO_YOU_WANT_ME_TO_HEAL, 0); // "Do you want me to heal your wounds?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, on_aot_0d_sub2);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_0d_sub3);
        }
    }
    evt_finish();
}

event on_aot_0d_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(147, 1, 0, 0, 150, 75);
    act_anim_flags(32 | 10, 32 | 31, 0 | 0);
    act_flag_op(0, 16, 0);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    sleep(30);
    act_anim_flags(32 | 3, 32 | 31, 0 | 3);
    sleep(20);
    act_anim_flags(32 | 3, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    sleep(10);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    sleep(15);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    sleep(32);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    sleep(20);
    act_anim_flags(32 | 3, 32 | 31, 0 | 3);
    sleep(10);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    sleep(7);
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    sleep(13);
    act_anim_flags(32 | 2, 32 | 31, 0 | 3);
    sleep(15);
    act_anim_flags(32 | 2, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    sleep(10);
