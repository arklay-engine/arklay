#if CHRIS
    if (cmpb(9, 5, 3))
    {
        item_aot_set(AOT_01_ITEM, 0, 0, 1, 1, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 0, 255, 132, 18, 172, 249, 196, 9, 0, 0, 60, 129, 0, 0);
        item_aot_set(AOT_02_ITEM, 0, 0, 1, 1, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 1, 255, 198, 12, 156, 244, 168, 22, 0, 0, 61, 129, 0, 0);
        item_aot_set(AOT_03_ITEM, 0, 0, 1, 1, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 2, 255, 240, 25, 62, 244, 76, 24, 132, 3, 62, 129, 0, 0);
        item_aot_set(AOT_04_ITEM, 0, 0, 1, 1, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 3, 255, 236, 9, 226, 249, 58, 12, 0, 0, 63, 129, 0, 0);
    }
    else
    {
