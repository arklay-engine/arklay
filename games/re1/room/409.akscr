        item_aot_set(AOT_02_ITEM, 1900, 5400, 1200, 1000, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 1, 255, 198, 12, 156, 244, 168, 22, 0, 0, 61, 129, 0, 132);
        item_aot_set(AOT_03_ITEM, 5100, 6000, 2200, 1100, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 2, 255, 240, 25, 62, 244, 76, 24, 132, 3, 62, 129, 0, 132);
        item_aot_set(AOT_04_ITEM, 2200, 2800, 850, 500, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 3, 255, 236, 9, 226, 249, 58, 12, 0, 0, 63, 129, 0, 132);
    }
#else
    item_aot_set(AOT_01_ITEM, 4300, 1500, 1100, 1500, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 0, 255, 132, 18, 172, 249, 196, 9, 0, 0, 60, 129, 16, 132);
    item_aot_set(AOT_02_ITEM, 1900, 5400, 1200, 1000, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 1, 255, 198, 12, 156, 244, 168, 22, 0, 0, 61, 129, 16, 132);
    item_aot_set(AOT_03_ITEM, 5100, 6000, 2200, 1100, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 2, 255, 240, 25, 62, 244, 76, 24, 132, 3, 62, 129, 16, 132);
    item_aot_set(AOT_04_ITEM, 2200, 2800, 850, 500, ITEM_13_CHEMICAL_EMPTY_BOTTLE, 1, 3, 255, 236, 9, 226, 249, 58, 12, 0, 0, 63, 129, 16, 132);
#endif
    item_aot_set(AOT_05_ITEM, 0, 0, 1, 1, ITEM_14_CHEMICAL_WATER, 1, 4, 255, 0, 0, 0, 0, 0, 0, 0, 0, 64, 129, 0, 0);
    item_aot_set(AOT_06_ITEM, 0, 0, 1, 1, ITEM_15_CHEMICAL_UMB_2, 1, 5, 255, 0, 0, 0, 0, 0, 0, 0, 0, 65, 129, 0, 0);
    item_aot_set(AOT_07_ITEM, 0, 0, 1, 1, ITEM_16_CHEMICAL_UMB_4, 1, 6, 255, 0, 0, 0, 0, 0, 0, 0, 0, 66, 129, 0, 0);
#if CHRIS
    aot_set(AOT_08_MESSAGE, 5900, 1400, 1100, 1500, SCE_MESSAGE, 129, 132, 0, 77, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 3000, 1500, 1200, 600, SCE_MESSAGE, 129, 128, 0, 77, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 9800, 4400, 700, 1700, SCE_MESSAGE, 129, 129, 0, 77, 0, 0, 0);
    aot_set(AOT_0B_MESSAGE, 7300, 6000, 2200, 1100, SCE_MESSAGE, 129, 136, 0, 77, 0, 0, 0);
    aot_set(AOT_0C_MESSAGE, 1900, 3500, 1200, 1900, SCE_MESSAGE, 129, 137, 0, 77, 0, 0, 0);
    if (ck(FG_COMMON, FLAG_COMMON_3D, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_00, TRUE) && ck(FG_COMMON, FLAG_COMMON_3A, FALSE))
    {
        enemy(ENEMY_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 1300, 0, 0, 7446, 0, 5874, 0, 42, 0, 0);
        evt_exec(0, 9, on_enter);
        if (ck(FG_COMMON, FLAG_COMMON_3B, FALSE))
        {
            aot_set(AOT_0D_EVENT, 6548, 4974, 1800, 1800, SCE_EVENT, 129, 9, 0, on_aot_0d, 0, 0, 0);
        }
        else
        {
            aot_set(AOT_0D_EVENT, 6548, 4974, 1800, 1800, SCE_EVENT, 129, 9, 0, on_aot_0d_2, 0, 0, 0);
        }
    }
    if (cmpb(9, 5, 3))
    {
