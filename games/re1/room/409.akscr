proc init
{
    door_aot_set(AOT_00_DOOR, 9600, 2300, 1800, 1700, 2, DOOR_SND_00_DR_WD, DOOR_07_DOOR07, 1, 0, ROOM_408_HONEYCOMB_PASSAGE, 8500, 0, 10200, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    if (cmpb(B_CHARACTER_MODEL, CMP_NE, 3))
    {
        item_aot_set(AOT_01_ITEM, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 0, 255, 132, 18, 172, 249, 196, 9, 0, 0, F_ITEM_3C, 129, 0, 0);
        item_aot_set(AOT_02_ITEM, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 1, 255, 198, 12, 156, 244, 168, 22, 0, 0, F_ITEM_3D, 129, 0, 0);
        item_aot_set(AOT_03_ITEM, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 2, 255, 240, 25, 62, 244, 76, 24, 132, 3, F_ITEM_3E, 129, 0, 0);
        item_aot_set(AOT_04_ITEM, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 3, 255, 236, 9, 226, 249, 58, 12, 0, 0, F_ITEM_3F, 129, 0, 0);
    }
    else
    {
        item_aot_set(AOT_01_ITEM, 4300, 1500, 1100, 1500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 0, 255, 132, 18, 172, 249, 196, 9, 0, 0, F_ITEM_3C, 129, 0, 132);
        item_aot_set(AOT_02_ITEM, 1900, 5400, 1200, 1000, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 1, 255, 198, 12, 156, 244, 168, 22, 0, 0, F_ITEM_3D, 129, 0, 132);
        item_aot_set(AOT_03_ITEM, 5100, 6000, 2200, 1100, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 2, 255, 240, 25, 62, 244, 76, 24, 132, 3, F_ITEM_3E, 129, 0, 132);
        item_aot_set(AOT_04_ITEM, 2200, 2800, 850, 500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 3, 255, 236, 9, 226, 249, 58, 12, 0, 0, F_ITEM_3F, 129, 0, 132);
    }
#else
    item_aot_set(AOT_01_ITEM, 4300, 1500, 1100, 1500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 0, 255, 132, 18, 172, 249, 196, 9, 0, 0, F_ITEM_3C, 129, 16, 132);
    item_aot_set(AOT_02_ITEM, 1900, 5400, 1200, 1000, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 1, 255, 198, 12, 156, 244, 168, 22, 0, 0, F_ITEM_3D, 129, 16, 132);
    item_aot_set(AOT_03_ITEM, 5100, 6000, 2200, 1100, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 2, 255, 240, 25, 62, 244, 76, 24, 132, 3, F_ITEM_3E, 129, 16, 132);
    item_aot_set(AOT_04_ITEM, 2200, 2800, 850, 500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, 3, 255, 236, 9, 226, 249, 58, 12, 0, 0, F_ITEM_3F, 129, 16, 132);
#endif
    item_aot_set(AOT_05_ITEM, 0, 0, 1, 1, IT_14_CHEMICAL_WATER, 1, 4, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_40, 129, 0, 0);
    item_aot_set(AOT_06_ITEM, 0, 0, 1, 1, IT_15_CHEMICAL_UMB_2, 1, 5, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_41, 129, 0, 0);
    item_aot_set(AOT_07_ITEM, 0, 0, 1, 1, IT_16_CHEMICAL_UMB_4, 1, 6, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_42, 129, 0, 0);
#if CHRIS
    aot_set(AOT_08_MESSAGE, 5900, 1400, 1100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 77, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 3000, 1500, 1200, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 77, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 9800, 4400, 700, 1700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 77, 0, 0, 0);
    aot_set(AOT_0B_MESSAGE, 7300, 6000, 2200, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 0, 77, 0, 0, 0);
    aot_set(AOT_0C_MESSAGE, 1900, 3500, 1200, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 0, 77, 0, 0, 0);
    if (ck(FG_COMMON, F_COMMON_3D, TRUE) && ck(FG_SCENARIO, F_SCENARIO_00, TRUE) && ck(FG_COMMON, F_COMMON_3A, FALSE))
    {
        enemy(EM_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 1300, 0, 0, 7446, 0, 5874, ENEMY_00_NPC_REBECCA, 42, 0, 0);
        evt_exec(0, TASK_09, on_enter);
        if (ck(FG_COMMON, F_COMMON_3B, FALSE))
        {
            aot_set(AOT_0D_EVENT, 6548, 4974, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_0d, 0, 0, 0);
        }
        else
        {
            aot_set(AOT_0D_EVENT, 6548, 4974, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_0d_2, 0, 0, 0);
        }
    }
    if (cmpb(B_CHARACTER_MODEL, CMP_NE, 3))
    {
        if (ck(FG_ITEM, F_ITEM_3C, TRUE))
        {
            aot_set(AOT_0E_MESSAGE, 4300, 1500, 1100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
        }
        if (ck(FG_ITEM, F_ITEM_3D, TRUE))
        {
            aot_set(AOT_0F_MESSAGE, 1900, 5400, 1200, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
        }
        if (ck(FG_ITEM, F_ITEM_3E, TRUE))
        {
            aot_set(AOT_10_MESSAGE, 5100, 6000, 2200, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
        }
        if (ck(FG_ITEM, F_ITEM_3F, TRUE))
        {
            aot_set(AOT_11_MESSAGE, 2200, 2800, 850, 500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
        }
    }
#else
    aot_set(AOT_0B_MESSAGE, 7300, 6000, 2200, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 0, 255, 0, 0, 0);
    aot_set(AOT_0C_MESSAGE, 1900, 3500, 1200, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 5900, 1400, 1100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 3000, 1500, 1200, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 9800, 4400, 700, 1700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
#endif
}

proc main
{
    set(FG_ITEM, F_ITEM_40, TRUE);
    set(FG_ITEM, F_ITEM_41, TRUE);
    set(FG_ITEM, F_ITEM_42, TRUE);
#if CHRIS
    if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
    {
        if (item_ck(IT_13_CHEMICAL_EMPTY_BOTTLE))
        {
            aot_reset(AOT_08_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_08_message, 0);
            aot_reset(AOT_0B_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0b_message, 0);
            aot_reset(AOT_0C_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0c_message, 0);
        }
        else
        {
            aot_reset(AOT_08_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 77, 0);
            aot_reset(AOT_0B_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 77, 0);
            aot_reset(AOT_0C_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 77, 0);
        }
    }
    else if (ck(FG_ITEM, F_ITEM_4E, FALSE))
    {
        aot_reset(AOT_0B_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 152, 77, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 77, 0);
    }
    else
    {
        aot_reset(AOT_0B_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 152, 77, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 153, 77, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_16, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_18, FALSE))
        {
            evt_exec(0, TASK_09, from_main);
        }
        else if (ck(FG_ROOM, F_ROOM_00, TRUE))
        {
            evt_exec(0, TASK_09, from_main);
        }
        set(FG_SCENARIO, F_SCENARIO_16, FALSE);
        set(FG_ROOM, F_ROOM_18, TRUE);
    }
    if (ck(FG_ROOM, F_ROOM_01, TRUE))
    {
        set(FG_ROOM, F_ROOM_01, FALSE);
        evt_exec(0, TASK_09, from_main_2);
    }
#else
    if (ck(FG_ITEM, F_ITEM_4E, TRUE))
    {
        if (item_ck(IT_13_CHEMICAL_EMPTY_BOTTLE))
        {
            aot_reset(AOT_08_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_08_message, 0);
        }
        else
        {
            aot_reset(AOT_08_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 77, 0);
        }
        aot_delete(AOT_0B_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_0C_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else if (item_ck(IT_13_CHEMICAL_EMPTY_BOTTLE))
    {
        aot_reset(AOT_08_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_08_message, 0);
        aot_reset(AOT_0B_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0b_message, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0c_message, 0);
    }
    else
    {
        aot_reset(AOT_08_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 77, 0);
        aot_reset(AOT_0B_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 77, 0);
        aot_reset(AOT_0C_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 77, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_16, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_18, FALSE))
        {
            evt_exec(0, TASK_09, from_main);
        }
        else if (ck(FG_ROOM, F_ROOM_00, TRUE))
        {
            evt_exec(0, TASK_09, from_main);
        }
        set(FG_SCENARIO, F_SCENARIO_16, FALSE);
        set(FG_ROOM, F_ROOM_18, TRUE);
    }
#endif
}

event on_aot_08_message
{
    run
    {
        set(FG_MESSAGE, F_MESSAGE_PLAYER, FALSE);
        set(FG_MESSAGE, F_MESSAGE_READY, FALSE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, FALSE);
        set(FG_MESSAGE, F_MESSAGE_EFFECTS, FALSE);
        message(MSG_WILL_YOU_PUT_WATER_IN_THE | MSG_FAST, 0); // "Will you put water in the empty bottle? There's a UMB.No2. Will you put UMB No.2 in the empty bottle? There's a UMB.No4. Will you put UMB No.4 in the empty bottle? There's UMB No.2. You need a container to obtain it."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            remove_item(IT_13_CHEMICAL_EMPTY_BOTTLE);
            give_item(AOT_05_ITEM, 4, 0);
        }
        set(FG_MESSAGE, F_MESSAGE_PLAYER, TRUE);
        set(FG_MESSAGE, F_MESSAGE_READY, TRUE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_EFFECTS, TRUE);
    }
    evt_finish();
}

