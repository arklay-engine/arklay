event on_aot_0d_2
{
    run
    {
        cutnext(0);
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    evt_fork(9, on_aot_0d_2_sub3, 0);
    voice_play(1, 66, 0);
    message(20, 0);
    wait_message();
    message(13, 0); // "Do you want me to heal your wounds?"
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, on_aot_0d_2_sub1);
        }
        else
        {
            evt_exec(0, 9, on_aot_0d_2_sub2);
        }
    }
    evt_finish();
}

