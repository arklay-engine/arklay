#version 1

proc init
{
    door_aot_set(0, 14800, 4100, 3000, 3100, 2, 0, 1, 1, 146, RDT_003, 3000, 0, 3000, 3072, LOCKED, 129);
    door_aot_set(1, 29800, 4000, 1700, 3500, 2, 0, 31, 5, 134, RDT_00F, 14000, 0, 3000, 3072, ITEM_SWORD_KEY, 129);
#if MANSION1
    door_aot_set(2, 31500, 1900, 2300, 1800, 6, 0, 0, 1, 211, RDT_010, 0, 0, 0, 0, LOCKED, 129);
#else
    door_aot_set(2, 31500, 1900, 2300, 1800, 6, 0, 0, 1, 211, RDT_010, 12700, -7200, 3300, 0, LOCKED, 129);
#endif
    door_aot_set(3, 10600, 0, 2800, 2300, 1, 0, 3, 4, 0, RDT_005, 6300, 0, 14100, 1024, UNLOCKED, 129);
#if MANSION1
    aot_set(4, 3300, 5600, 2000, 2000, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
#if CHRIS
    item_aot_set(5, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 0, 255, 54, 16, 0, 0, 0, 25, 0, 4, 41, 129, 1, 0);
    aot_set(6, 3300, 7400, 2000, 1000, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    aot_set(7, 5500, 5700, 1000, 1500, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    aot_set(8, 1000, 6900, 1000, 1600, SCE_MESSAGE, 129, 133, 0, 255, 0, 0, 0);
    item_aot_set(9, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 1, 255, 54, 16, 0, 0, 0, 25, 0, 4, 47, 129, 1, 0);
    set(FG_STATUS, 28, 0);
#else
    aot_set(5, 3300, 7400, 2000, 1000, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    aot_set(6, 5500, 5700, 1000, 1500, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    aot_set(7, 1000, 6900, 1000, 1600, SCE_MESSAGE, 129, 133, 0, 255, 0, 0, 0);
    if (ck(FG_COMMON, 180, 1))
    {
        item_aot_set(8, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 0, 255, 54, 16, 0, 0, 0, 25, 0, 4, 41, 129, 1, 0);
        item_aot_set(9, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 1, 255, 54, 16, 0, 0, 0, 25, 0, 4, 47, 129, 1, 0);
    }
    set(FG_COMMON, 172, 0);
#endif
    evt_exec(0, 9, event_01);
#if CHRIS
    if (ck(FG_COMMON, 162, 1))
    {
        if (ck(FG_COMMON, 160, 0))
        {
            if (cmpb(3, 0, 3))
            {
                snd_pan_vol_set(0, 40, 40);
                snd_pan_vol_set(1, 40, 40);
            }
            if (cmpb(3, 0, 5))
            {
                snd_pan_vol_set(0, 30, 30);
                snd_pan_vol_set(1, 30, 30);
            }
            if (cmpb(3, 0, 15))
            {
                snd_pan_vol_set(0, 60, 60);
                snd_pan_vol_set(1, 60, 60);
            }
        }
    }
#endif
    if (ck(FG_COMMON, 2, 1))
    {
        enemy(ENEMY_ZOMBIE_RESEARCHER_, 133, 28, 1, 2, 0, 0, 3072, 0, 0, 4150, 0, 6300, 0, 0, 0, 0);
    }
    else
    {
        enemy(ENEMY_ZOMBIE_RESEARCHER_, 0, 28, 1, 2, 0, 0, 3072, 0, 0, 4150, 0, 5550, 0, 0, 0, 0);
    }
#if CHRIS
    enemy(ENEMY_KENNETH_1, 0, 255, 1, 2, 0, 0, 0, 0, 0, 3550, 0, 6400, 1, 0, 0, 0);
#else
    if (ck(FG_COMMON, 173, 1))
    {
        enemy(ENEMY_KENNETH_1, 0, 255, 1, 2, 0, 0, 0, 0, 0, 3550, 0, 6400, 1, 0, 0, 0);
    }
    else if (ck(FG_COMMON, 180, 0))
    {
        enemy(ENEMY_KENNETH_2, 0, 255, 1, 2, 0, 0, 0, 0, 0, 3550, 0, 6400, 1, 0, 0, 0);
    }
    else
    {
        enemy(ENEMY_KENNETH_1, 0, 255, 1, 2, 0, 0, 0, 0, 0, 3550, 0, 6400, 1, 0, 0, 0);
    }
#endif
#else
#if CHRIS
    item_aot_set(4, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 0, 255, 54, 16, 0, 0, 0, 25, 0, 4, 41, 129, 1, 0);
#else
    if (ck(FG_COMMON, 180, 1))
    {
        item_aot_set(4, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 0, 255, 54, 16, 0, 0, 0, 25, 0, 4, 41, 129, 1, 0);
    }
#endif
    aot_set(5, 3300, 7400, 2000, 1000, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    aot_set(6, 5500, 5700, 1000, 1500, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    aot_set(7, 1000, 6900, 1000, 1600, SCE_MESSAGE, 129, 133, 0, 255, 0, 0, 0);
#if CHRIS
    item_aot_set(8, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 1, 255, 54, 16, 0, 0, 0, 25, 0, 4, 47, 129, 1, 0);
#else
    if (ck(FG_COMMON, 180, 1))
    {
        item_aot_set(8, 3300, 5600, 2000, 2000, ITEM_CLIP, 15, 1, 255, 54, 16, 0, 0, 0, 25, 0, 4, 47, 129, 1, 0);
    }
#endif
    enemy(ENEMY_HUNTER, 0, 158, 1, 2, 0, 0, 4011, 0, 0, 3616, 0, 3322, 0, 0, 0, 0);
    enemy(ENEMY_HUNTER, 0, 159, 1, 2, 0, 0, 1915, 0, 0, 23680, 0, 3370, 1, 0, 0, 0);
#endif
}
#if MANSION1

proc main
{
    if (ck(FG_COMMON, 2, 1))
    {
        if (ck(FG_STATUS, 26, 0))
        {
            if (cmpb(2, 0, 4))
            {
                evt_exec(0, 9, event_02);
            }
        }
    }
    if (ck(FG_SCENARIO, 17, 0))
    {
        aot_delete(4, SCE_NONE, 1);
    }
#if CHRIS
    if (ck(FG_COMMON, 162, 1))
    {
        if (ck(FG_COMMON, 160, 0))
        {
            if (cmpb(2, 0, 0))
            {
                snd_pan_vol_set(0, 30, 30);
                snd_pan_vol_set(1, 30, 30);
            }
            if (cmpb(2, 0, 1))
            {
                snd_pan_vol_set(0, 35, 35);
                snd_pan_vol_set(1, 35, 35);
            }
            if (cmpb(2, 0, 2))
            {
                snd_pan_vol_set(0, 40, 40);
                snd_pan_vol_set(1, 40, 40);
            }
            if (cmpb(2, 0, 3))
            {
                snd_pan_vol_set(0, 60, 60);
                snd_pan_vol_set(1, 60, 60);
            }
            if (cmpb(2, 0, 4))
            {
                snd_pan_vol_set(0, 30, 30);
                snd_pan_vol_set(1, 30, 30);
            }
        }
    }
#endif
}

event event_00
{
    run
    {
        cutnext(5);
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
        message(128, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        cutnext(4);
        aot_delete(4, SCE_NONE, 1);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event event_01
{
    sleep(1);
#if CHRIS
    run
    {
        set(FG_STATUS, 29, 0);
    }
#else
    set(FG_STATUS, 29, 0);
#endif
    evt_finish();
}

event event_02
{
    run
    {
        bgm_stop_all(0);
        movie_on(3);
    }
    sleep(1);
    run
    {
        room_bgm_state_set(0, 4, 8);
        eml_state(0, 0, 0, 5);
        set(FG_COMMON, 2, 0);
    }
    evt_finish();
}
#endif
