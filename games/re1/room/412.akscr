#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define IMDL_00 0x00
#define OBJ_00 0x00
#define OBJ_01 0x01

proc init
{
    door_aot_set(AOT_00_DOOR, 4200, 500, 1900, 2000, 0, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_3F, ROOM_400_ENTER_PASSAGE, 3000, 0, 26700, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM, 5000, 4500, 800, 2000, IT_34_KEY_MANSION_ARMOR, 1, IMDL_00, SCA_NONE, 3860, -4400, 12910, 0, 254, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4);
    obj(OBJ_PUSH_GRUNT | OBJ_00, OF_CLIMBABLE | OF_ACTIVE, SCA_NONE, 5100, 0, 9400, 1024, 285, 0, -285, 0, 725, 900, 990, 800);
    obj(OBJ_01, OF_ACTIVE, SCA_NONE, 5300, 0, 5800, 2048, 0, 540, 0, -540, 540, 1800, 1050, 1350);
}
