#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_ITEM 0x05
#define F_ROOM_20 0x20
#define F_ROOM_21 0x21
#define MSG_VOICES_ARE_HEARD_FROM_THE_OTHER 0x0E

proc init
{
    door_aot_set(AOT_00_DOOR, 2300, 4700, 2700, 3000, 2, 0, 0, 9, 0, ROOM_400_ENTER_PASSAGE, 16200, 0, 3100, 3072, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 25100, 19800, 2600, 2500, 3, 0, 6, 1, 169, ROOM_406_ROOM_002, 3000, 0, 3000, 0, IT_39_KEY_GUARDHOUSE_002, 129);
    door_aot_set(AOT_02_DOOR, 23600, 7300, 2500, 3100, 3, 0, 0, 4, 0, ROOM_408_HONEYCOMB_PASSAGE, 4200, 0, 3400, 0, UNLOCKED, 129);
    item_aot_set(AOT_03_ITEM, 23900, 27200, 800, 1000, IT_44_HEAL_HERB_GREEN, 1, 0, 255, 236, 94, 0, 0, 168, 107, 0, 4, 106, 129, 1, 0);
    item_aot_set(AOT_04_ITEM, 22700, 27000, 1000, 1000, IT_44_HEAL_HERB_GREEN, 1, 1, 255, 0, 90, 0, 0, 214, 106, 0, 4, 107, 129, 1, 0);
    item_aot_set(AOT_05_ITEM, 23000, 26000, 800, 1100, IT_44_HEAL_HERB_GREEN, 1, 2, 255, 0, 90, 0, 0, 72, 103, 0, 4, 108, 129, 1, 0);
    obj(0, 1, 255, 24390, 0, 24550, 1024, 0, 0, 200, 0, 0, 0, 56, 255, 144, 1, 108, 2, 88, 2, 88, 2);
    evt_exec(0, 9, on_enter);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_AB, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
        {
            evt_exec(0, 9, on_enter_2);
        }
    }
    if (ck(FG_COMMON, F_COMMON_AB, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
        {
            enemy(EM_24_NPC_WESKER, 2, 255, 1, 2, 0, 0, 2000, 0, 0, 16400, 0, 4500, 0, 0, 0, 0);
            enemy(EM_07_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 15000, 0, 3100, 1, 0, 0, 0);
            enemy(EM_07_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 9300, 0, 4600, 2, 0, 0, 0);
            enemy(EM_07_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 7000, 0, 3600, 3, 0, 0, 0);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_AF, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_B2, FALSE))
            {
                room_bgm_state_set(3, 5, 65);
                evt_exec(0, 9, on_enter_2);
            }
            else
            {
                room_bgm_state_set(3, 5, 65);
                evt_exec(0, 9, on_enter_3);
            }
            set(FG_COMMON, F_COMMON_27, TRUE);
        }
    }
    if (ck(FG_COMMON, F_COMMON_AF, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
        {
            enemy(EM_24_NPC_WESKER, 2, 255, 1, 2, 0, 0, 2000, 0, 0, 16400, 0, 4500, 0, 0, 0, 0);
            enemy(EM_07_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 11500, 0, 3100, 1, 0, 0, 0);
            enemy(EM_07_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 9300, 0, 4600, 2, 0, 0, 0);
            enemy(EM_07_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 7000, 0, 3600, 3, 0, 0, 0);
        }
    }
#endif
}

event on_enter
{
    run
    {
#if CHRIS
        if (ck(FG_COMMON, F_COMMON_AB, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
            {
                room_bgm_state_set(3, 5, 65);
            }
        }
#else
        if (ck(FG_COMMON, F_COMMON_07, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_AE, FALSE))
            {
                aot_reset(AOT_01_DOOR, SCE_EVENT, 129, 9, on_aot_01_door, 0);
                room_bgm_state_set(3, 5, 64);
            }
        }
        if (ck(FG_COMMON, F_COMMON_AF, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_B2, FALSE))
                {
                    room_bgm_state_set(3, 5, 65);
                }
                else
                {
                    room_bgm_state_set(3, 5, 65);
                }
            }
        }
#endif
    }
    evt_finish();
}

