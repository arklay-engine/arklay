event on_aot_01_door
{
    sleep(1);
    run
    {
        bgm_play(0);
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_AE, TRUE);
        message(MSG_VOICES_ARE_HEARD_FROM_THE_OTHER | 0x80, 0); // "Voices are heard from the other side of the door."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 14, 32 | 0, 0 | 1);
    act_param_set(0, 4);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
