#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_MESSAGE 0x02
#define AOT_03_EVENT 0x03
#define AOT_04_EVENT 0x04
#define AOT_05_ITEM 0x05
#define FLAG_ROOM_18 0x18

proc init
{
    door_aot_set(AOT_00_DOOR, 0, 0, 2500, 4200, 1, 0, 0, 1, 0, ROOM_203_HALL_2F, 31500, -2885, 8000, 2048, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 3600, 11500, 2000, 2500, 0, 0, 6, 4, 0, ROOM_212_TERRACE, 19600, 0, 27000, 0, UNLOCKED, 129);
    if (ck(FG_COMMON, FLAG_COMMON_42, TRUE))
    {
        room_bgm_state_set(1, 17, 255);
        aot_set(AOT_02_MESSAGE, 3800, 10000, 600, 1000, SCE_MESSAGE, 129, 129, 0, 69, 1, 0, 0);
        aot_set(AOT_03_EVENT, 2500, 11000, 900, 2000, SCE_EVENT, 129, 9, 0, on_aot_03, 0, 0, 0);
    }
    else
    {
        room_bgm_state_set(1, 17, 8);
        aot_set(AOT_02_MESSAGE, 3800, 10000, 600, 1000, SCE_MESSAGE, 129, 128, 0, 69, 1, 0, 0);
        aot_set(AOT_03_EVENT, 2500, 11000, 900, 2000, SCE_EVENT, 129, 9, 0, on_aot_03_2, 0, 0, 0);
    }
    aot_set(AOT_04_EVENT, 2500, 7600, 900, 2000, SCE_EVENT, 129, 9, 0, on_aot_04, 0, 0, 0);
    if (ck(FG_STATUS, FLAG_STATUS_08, FALSE))
    {
        item_aot_set(AOT_05_ITEM, 2000, 400, 1700, 1700, ITEM_3D_KEY_DESK, 1, 0, 255, 84, 11, 28, 248, 244, 6, 0, 0, 149, 129, 0, 134);
        eml_rot(0, 0, 0, 0, 8);
    }
}

event on_aot_03
{
    sleep(1);
    set(FG_6, FLAG_6_17, FALSE);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 0 | 24, 0 | 0);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, FLAG_ROOM_18, FALSE);
    message(129, 325); // "This must be Forest's..."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 0 | 24, 0 | 0);
    act_flag_op(1, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, FLAG_ROOM_18, FALSE);
    sleep(5);
    set(FG_6, FLAG_6_17, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

