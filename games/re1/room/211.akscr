#version 1

proc init
{
    door_aot_set(0, 0, 0, 2500, 4200, 1, 0, 0, 1, 0, RDT_003, 31500, -2885, 8000, 2048, UNLOCKED, 129);
    door_aot_set(1, 3600, 11500, 2000, 2500, 0, 0, 6, 4, 0, RDT_012, 19600, 0, 27000, 0, UNLOCKED, 129);
    if (ck(FG_COMMON, 66, 0))
    {
        room_bgm_state_set(1, 17, 255);
        aot_set(2, 3800, 10000, 600, 1000, SCE_MESSAGE, 129, 129, 0, 69, 1, 0, 0);
        aot_set(3, 2500, 11000, 900, 2000, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    }
    else
    {
        room_bgm_state_set(1, 17, 8);
        aot_set(2, 3800, 10000, 600, 1000, SCE_MESSAGE, 129, 128, 0, 69, 1, 0, 0);
        aot_set(3, 2500, 11000, 900, 2000, SCE_EVENT, 129, 9, 0, event_01, 0, 0, 0);
    }
    aot_set(4, 2500, 7600, 900, 2000, SCE_EVENT, 129, 9, 0, event_02, 0, 0, 0);
    if (ck(FG_STATUS, 8, 1))
    {
        item_aot_set(5, 2000, 400, 1700, 1700, ITEM_SMALL_KEY, 1, 0, 255, 84, 11, 28, 248, 244, 6, 0, 0, 149, 129, 0, 134);
        eml_rot(0, 0, 0, 0, 8);
    }
}

event event_00
{
    sleep(1);
    set(FG_6, 23, 1);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 0 | 24, 0 | 0);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, 24, 1);
    message(129, 325);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 0 | 24, 0 | 0);
    act_flag_op(1, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, 24, 1);
    sleep(5);
    set(FG_6, 23, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

