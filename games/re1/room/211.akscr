#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_MESSAGE 0x02
#define AOT_03_EVENT 0x03
#define AOT_04_EVENT 0x04
#define AOT_05_ITEM 0x05
#define F_ROOM_18 0x18
#define MSG_I_HOPE_THIS_BLOOD_IS_NOT 0x00
#define MSG_SPOTS_OF_BLOOD_ARE_HERE_AND 0x02
#define MSG_THIS_MUST_BE_FORESTS 0x01

proc init
{
    door_aot_set(AOT_00_DOOR, 0, 0, 2500, 4200, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_203_HALL_2F, 31500, -2885, 8000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 3600, 11500, 2000, 2500, 0, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 4, 0, ROOM_212_TERRACE, 19600, 0, 27000, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_COMMON, F_COMMON_42, TRUE))
    {
        room_bgm_state_set(1, ROOM_211_TERRACE_PASSAGE, BGM_OFF);
        aot_set(AOT_02_MESSAGE, 3800, 10000, 600, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 69, 1, 0, 0);
        aot_set(AOT_03_EVENT, 2500, 11000, 900, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
    }
    else
    {
        room_bgm_state_set(1, ROOM_211_TERRACE_PASSAGE, BGM_MAIN_ON);
        aot_set(AOT_02_MESSAGE, 3800, 10000, 600, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 69, 1, 0, 0);
        aot_set(AOT_03_EVENT, 2500, 11000, 900, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03_2, 0, 0, 0);
    }
    aot_set(AOT_04_EVENT, 2500, 7600, 900, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_04, 0, 0, 0);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        item_aot_set(AOT_05_ITEM, 2000, 400, 1700, 1700, IT_3D_KEY_DESK, 1, 0, 255, 84, 11, 28, 248, 244, 6, 0, 0, F_ITEM_95, 129, 0, 134);
        eml_rot(0, 0, 0, 0, 8);
    }
}

event on_aot_03
{
    sleep(1);
    set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 0 | 24, 0 | 0);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, F_ROOM_18, FALSE);
    message(MSG_THIS_MUST_BE_FORESTS | MSG_FAST, MSG_PAUSE_CONTROLS | MSG_PAUSE_0040 | MSG_PAUSE_MONSTERS | MSG_PAUSE_PLAYER); // "This must be Forest's..."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 0 | 24, 0 | 0);
    act_flag_op(1, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, F_ROOM_18, FALSE);
    sleep(5);
    set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

