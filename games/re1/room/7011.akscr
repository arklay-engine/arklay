#version 1

proc init
{
    door_aot_set(0, 17200, 900, 2000, 2000, 1, 0, 3, 4, 0, RDT_002, 6400, 0, 14000, 1024, UNLOCKED, 129);
    door_aot_set(1, 14700, 25700, 1500, 1900, 1, 0, 0, 1, 0, RDT_014, 11200, 0, 28000, 3072, UNLOCKED, 129);
    door_aot_set(2, 12900, 16500, 2100, 1800, 0, 0, 0, 4, 204, RDT_015, 8100, 0, 3800, 2048, ITEM_HELMET_KEY, 129);
    door_aot_set(3, 11345, 10300, 2605, 2500, 1, 5, 24, 96, 0, RDT_101, 4300, 0, 3100, 2048, UNLOCKED, 129);
    aot_set(4, 2000, 10300, 300, 1900, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    aot_set(5, 14700, 25700, 1500, 1900, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    enemy(ENEMY_HUNTER, 2, 60, 1, 2, 0, 0, 1976, 0, 0, 16012, 0, 20724, 0, 0, 0, 0);
    if (ck(FG_SCENARIO, 70, 1))
    {
        aot_delete(1, SCE_NONE, 129);
    }
    else
    {
        aot_delete(5, SCE_NONE, 129);
    }
}

event event_00
{
    run
    {
        set(FG_6, 23, 1);
        cutnext(7);
        message(128, 5);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (ck(FG_COMMON, 37, 1))
        {
            message(129, 5);
        }
        else
        {
            se_play_3d(2, 23, 0, 0, 0, 15500, 26000);
            message(130, 5);
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (ck(FG_COMMON, 37, 0))
        {
            aot_delete(1, SCE_DOOR, 129);
            aot_on(1, SCE_DOOR, 0);
            set(FG_SCENARIO, 70, 0);
            set(FG_6, 23, 0);
        }
        cutcurr(0);
        cut_auto(0);
        set(FG_6, 23, 0);
    }
    evt_finish();
}
