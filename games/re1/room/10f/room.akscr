event jill_wood_emblem_opens_wall when (JILL)
{
    se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_POINT, 0, 9424, 12173);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(21);
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        cutnext(CAM_03_HIDDEN_WALL);
    }
    se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_POINT, 0, 9424, 12173);
    se_play_3d(SND_BANK_ROOM, SE_18, 0, SND_AT_POINT, 0, 9424, 12173);
    evt_work_set(WK_OBJ, OBJ_00_HIDDEN_WALL);
    evt_tween_begin_alt();
    evt_next();
    tw_nop();
    tw_set_pos(0, -48, 0);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    sleep(10);
    run
    {
        cutnext(CAM_04_EMBLEM_SLOT);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event rebecca_practising_on_enter when (CHRIS)
{
    pos_set(ENEMY_00_REBECCA, 0, 100, 0, 9950, 0, 8100);
    evt_chain(rebecca_practice_loop);
    evt_nop();
    evt_nop();
}
event jill_wall_open_on_enter when (JILL)
{
    evt_work_set(WK_OBJ, OBJ_00_HIDDEN_WALL);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    evt_finish();
}

event rebecca_calls_at_door when (CHRIS)
{
    aot_delete(AOT_01_MESSAGE_REBECCA_PLAYING, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_06, 9700, 8300, F_ROOM_PLAYER_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    voice_play(VOICE_PLAY, VO_006_0D);
    message(MSG_VO_006_0D, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_25, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    wait_message();
    sleep(20);
    voice_play(VOICE_PLAY, VO_006_0E);
    message(MSG_VO_006_0E, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_3A, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    run
    {
        door_aot_set(AOT_03_DOOR_104, 11600, 760, 5800, 4400, 1, DOOR_SND_00_DR_WD, DOOR_1F_DOOR05K, 5, 0, ROOM_104_TEA_ROOM, 30700, 0, 3900, 1024, UNLOCKED, SAT_UNDER | SAT_PLAYER);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}
event jill_place_wood_emblem when (JILL)
{
    evt_work_set(WK_AOT, IMDL_00_KEY_EMBLEM_WOOD);
    evt_tween_begin_alt();
    tw_abs_pos(0, 9220, -560, 19550);
    tw_abs_rot(0, 0, 1024, 0);
    tw_end();
    evt_nop();
    se_play_3d(SND_BANK_ROOM, SE_1A, 0, SND_AT_POINT, 0, 9424, 19173);
    evt_finish();
}

event rebecca_plays_sonata_or_jill_plays
{
    if (CHRIS)
    {
        run
        {
            room_bgm_state_set(0, ROOM_10F_BAR, BGM_RELOAD | 1);
            aot_delete(AOT_02_MESSAGE_PIANO, SCE_NONE, SAT_UNDER | SAT_PLAYER);
            pos_set(ENEMY_00_REBECCA, 0, 100, 0, 9950, 0, 8100);
            bgm_play(BGM_MAIN);
        }
        sleep(1);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        sleep(10);
        run
        {
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            voice_play(VOICE_PLAY, VO_006_0F);
            message(MSG_VO_006_0F, 0);
        }
        wait_message();
        sleep(20);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_seq(AB_02, 9900, 6200, F_ROOM_PLAYER_ANIM_DONE);
        act_reset();
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
        evt_actor_begin();
        act_anim_flags(ANIM_29, F_ROOM_C_REBECCA_ANIM_DONE, 0);
