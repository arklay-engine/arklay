#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_104 0x00                                // Chris: becomes Rebecca's call event once she stays to practise.
#define AOT_01_MESSAGE_REBECCA_PLAYING 0x01                 // Chris: "Rebecca is playing the piano."
#define AOT_01_NONE_UNUSED 0x01                             // Jill: never turned on.
#define AOT_02_MESSAGE_PIANO 0x02
#define AOT_03_DOOR_104 0x03                                // Chris: replaces the wooden emblem slot after Rebecca's call at the door.
#define AOT_03_ITEM_KEY_EMBLEM_WOOD_0 0x03
#define AOT_04_ITEM_KEY_EMBLEM_GOLD_1 0x04
#define AOT_05_ITEM_KEY_MUSIC_SCORE_2 0x05
#define AOT_06_USEITEM_SLOT_WOOD_ALT 0x06                   // Data 9,0,4: arms the wooden emblem for use here.
#define AOT_07_USEITEM_SLOT_WOOD 0x07
#define AOT_08_USEITEM_SLOT_GOLD_ALT 0x08                   // Data 9,0,5: arms the gold emblem for use here.
#define AOT_09_USEITEM_SLOT_GOLD 0x09
#define AOT_0A_MESSAGE_EMBLEM_SLOT 0x0A                     // "It's the hollow..." or "An emblem is in place."
#define AOT_0B_USEITEM_MAP_HIDDEN_ROOM 0x0B                 // Data 8,0,30: marks map square 11E (the room behind the wall) visited.
#define AOT_0C_NONE_UNUSED 0x0C
#define AOT_0D_EVENT_TALK_REBECCA 0x0D
#define AOT_0D_USEITEM_PIANO_SCORE_ALT 0x0D                 // Data 9,0,8: arms the music score for use here.
#define AOT_0E_USEITEM_PIANO_SCORE 0x0E
#define AOT_0E_USEITEM_PIANO_SCORE_ALT 0x0E
#define AOT_0F_USEITEM_PIANO_SCORE 0x0F
#define CAM_01_PIANO 0x01
#define CAM_03_HIDDEN_WALL 0x03
#define CAM_04_EMBLEM_SLOT 0x04
#define CAM_05_BAR_DOOR 0x05
#define CAM_06_PIANO_CLOSEUP 0x06
#define CAM_07_WALL_FROM_PIANO 0x07
#define ENEMY_00_REBECCA 0x00
#define F_ROOM_C_GOLD_EMBLEM_USED 0x22                      // Chris: the gold emblem was used on the slot (one frame).
#define F_ROOM_C_MUSIC_SCORE_USED 0x24                      // Chris: the music score was used on the piano (one frame).
#define F_ROOM_C_REBECCA_ANIM_DONE 0x21                     // Chris: Rebecca's animation finished (one frame).
#define F_ROOM_C_WOOD_EMBLEM_USED 0x23                      // Chris: the wooden emblem was used on the slot (one frame).
#define F_ROOM_J_GOLD_EMBLEM_USED 0x21                      // Jill: the gold emblem was used on the slot (one frame).
#define F_ROOM_J_MUSIC_SCORE_USED 0x23                      // Jill: the music score was used on the piano (one frame).
#define F_ROOM_J_WOOD_EMBLEM_USED 0x22                      // Jill: the wooden emblem was used on the slot (one frame).
#define F_ROOM_PLAYER_ANIM_DONE 0x20                        // The player's animation finished (one frame); Rebecca also raises it while she plays.
#define IMDL_00_KEY_EMBLEM_WOOD 0x00
#define IMDL_01_KEY_EMBLEM_GOLD 0x01
#define IMDL_02_KEY_MUSIC_SCORE 0x02
#define MSG_CHRIS_UNFORTUNATELY_CANNOT_READ_MUSIC 0x01
#define MSG_IT_IS_MOONLIGHT_SONATA 0x17
#define MSG_THERE_IS_NO_TIME_TO_PLAY 0x1C
#define MSG_VO_006_00 0x02
#define MSG_VO_006_01 0x04
#define MSG_VO_006_02 0x03
#define MSG_VO_006_03 0x05
#define MSG_VO_006_04 0x06
#define MSG_VO_006_05 0x07
#define MSG_VO_006_06 0x08
#define MSG_VO_006_07 0x09
#define MSG_VO_006_08 0x0A
#define MSG_VO_006_09 0x0C
#define MSG_VO_006_0A 0x0D
#define MSG_VO_006_0B 0x0E
#define MSG_VO_006_0C 0x0F
#define MSG_VO_006_0D 0x10
#define MSG_VO_006_0E 0x11
#define MSG_VO_006_0F 0x13
#define MSG_VO_006_10 0x14
#define MSG_VO_006_11 0x15
#define MSG_VO_006_12 0x16
#define MSG_WILL_YOU_HAVE_REBECCA_PRACTICE 0x0B
#define OBJ_00_HIDDEN_WALL 0x00                             // The wall that rises when the sonata is played and drops while the gold emblem is out.
#define OBJ_01 0x01
#define OBJ_02 0x02
#define SE_17 0x17
#define SE_18 0x18
#define SE_19 0x19
#define SE_1A 0x1A
#define SE_1B 0x1B
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define SPR_0E 0x0E
#define VO_006_00 0x41
#define VO_006_01 0x42
#define VO_006_02 0x43
#define VO_006_03 0x44
#define VO_006_04 0x45
#define VO_006_05 0x46
#define VO_006_06 0x47
#define VO_006_07 0x48
#define VO_006_08 0x49
#define VO_006_09 0x4A
#define VO_006_0A 0x4B
#define VO_006_0B 0x4C
#define VO_006_0C 0x4D
#define VO_006_0D 0x4E
#define VO_006_0E 0x4F
#define VO_006_0F 0x50
#define VO_006_10 0x51
#define VO_006_11 0x52
#define VO_006_12 0x53
#define VO_007_08 0x6F
#define VO_008_01 0x7A

proc init
{
    door_aot_set(AOT_00_DOOR_104, 13700, 960, 1700, 1900, 1, DOOR_SND_00_DR_WD, DOOR_1F_DOOR05K, 5, DOOR_LOCKED | F_LOCK_104_10F, ROOM_104_TEA_ROOM, 30700, 0, 3900, 1024, IT_33_KEY_MANSION_SWORD, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        aot_set(AOT_01_MESSAGE_REBECCA_PLAYING, 8800, 7200, 1500, 1700, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_01_NONE_UNUSED, 8800, 7200, 1500, 1700, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    aot_set(AOT_02_MESSAGE_PIANO, 10200, 7300, 600, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_C_BAR_WOOD_EMBLEM_SET, TRUE))
        {
            item_aot_set(AOT_03_ITEM_KEY_EMBLEM_WOOD_0, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_00_KEY_EMBLEM_WOOD, SCA_NONE, 9220, -560, 19550, 1024, F_ITEM_10F_KEY_EMBLEM_WOOD_0, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_03_ITEM_KEY_EMBLEM_WOOD_0, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_00_KEY_EMBLEM_WOOD, SCA_NONE, 0, 0, 0, 0, F_ITEM_10F_KEY_EMBLEM_WOOD_0, SAT_MANUAL | SAT_PLAYER, 0);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_BAR_WOOD_EMBLEM_SET, TRUE))
        {
            item_aot_set(AOT_03_ITEM_KEY_EMBLEM_WOOD_0, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_00_KEY_EMBLEM_WOOD, SCA_NONE, 9220, -560, 19550, 1024, F_ITEM_10F_KEY_EMBLEM_WOOD_0, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_03_ITEM_KEY_EMBLEM_WOOD_0, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_00_KEY_EMBLEM_WOOD, SCA_NONE, 0, 0, 0, 0, F_ITEM_10F_KEY_EMBLEM_WOOD_0, SAT_MANUAL | SAT_PLAYER, 0);
        }
    }
    item_aot_set(AOT_04_ITEM_KEY_EMBLEM_GOLD_1, 8100, 18800, 1500, 1000, IT_20_KEY_EMBLEM_GOLD, 1, IMDL_01_KEY_EMBLEM_GOLD, SCA_NONE, 9220, -560, 19550, 1024, F_ITEM_10F_KEY_EMBLEM_GOLD_1, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_05_ITEM_KEY_MUSIC_SCORE_2, 17000, 11500, 800, 1000, IT_23_KEY_MUSIC_SCORE, 0, IMDL_02_KEY_MUSIC_SCORE, SCA_NONE, 17250, -3000, 11550, 1250, F_ITEM_10F_KEY_MUSIC_SCORE_2, SAT_MANUAL | SAT_PLAYER, 0);
    aot_set(AOT_06_USEITEM_SLOT_WOOD_ALT, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 4, 0, 1, 0);
    if (CHRIS)
    {
        aot_set(AOT_07_USEITEM_SLOT_WOOD, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 35, 0, 1, 0);
    }
    else
    {
        aot_set(AOT_07_USEITEM_SLOT_WOOD, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 34, 0, 1, 0);
    }
    aot_set(AOT_08_USEITEM_SLOT_GOLD_ALT, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 5, 0, 1, 0);
    if (CHRIS)
    {
        aot_set(AOT_09_USEITEM_SLOT_GOLD, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 34, 0, 1, 0);
    }
    else
    {
        aot_set(AOT_09_USEITEM_SLOT_GOLD, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 33, 0, 1, 0);
    }
    aot_set(AOT_0A_MESSAGE_EMBLEM_SLOT, 8100, 18800, 1500, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 24, 0, 255, 0, 0, 0);
    aot_set(AOT_0B_USEITEM_MAP_HIDDEN_ROOM, 7000, 14000, 3000, 1000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 8, 0, 30, 0, 1, 0);
    aot_set(AOT_0C_NONE_UNUSED, 9500, 8200, 500, 800, SCE_NONE, SAT_MANUAL, 0, 0, 0, 0, 0, 0);
    if (CHRIS)
    {
        aot_set(AOT_0D_EVENT_TALK_REBECCA, 9500, 8200, 500, 800, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
        aot_set(AOT_0E_USEITEM_PIANO_SCORE_ALT, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 9, 0, 8, 0, 1, 0);
        aot_set(AOT_0F_USEITEM_PIANO_SCORE, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 4, 0, 36, 0, 1, 0);
        obj(OBJ_00_HIDDEN_WALL, OF_NOT_PUSHABLE | OF_10 | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 9100, 0, 12576, 1024, -450, 0, 450, 0, 1620, 5400, 16000, 400);
    }
    else
    {
        aot_set(AOT_0D_USEITEM_PIANO_SCORE_ALT, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 9, 0, 8, 0, 1, 0);
        aot_set(AOT_0E_USEITEM_PIANO_SCORE, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 4, 0, 35, 0, 1, 0);
        obj(OBJ_00_HIDDEN_WALL, OF_NOT_PUSHABLE | OF_10 | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 9100, 0, 12576, 1024, -450, 0, 450, 0, 1620, 5400, 16000, 450);
    }
    obj(OBJ_01, OF_ACTIVE, SCA_NONE, 17394, 0, 11190, 1024, 0, 876, 0, -876, 300, 544, 1300, 550);
    obj(OBJ_02, OF_NOT_PUSHABLE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 15000, 0, 11200, 1024, 0, 0, 0, 0, 600, 544, 900, 600);
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_C_PIANO_PLAYED, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_C_MUSIC_SCORE_GIVEN, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_PRACTISED, TRUE))
                {
                    evt_exec(0, TASK_00, rebecca_plays_sonata_or_jill_plays);
                }
                else
                {
                    evt_exec(0, TASK_09, rebecca_practising_on_enter);
                    aot_reset(AOT_01_MESSAGE_REBECCA_PLAYING, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 146, 125, 0);
                }
            }
        }
        else
        {
            evt_exec(0, TASK_09, chris_wall_open_on_enter);
        }
        evt_exec(0, TASK_09, defer_camera_switch);
        if (ck(FG_COMMON, F_COMMON_C_PIANO_PLAYED, FALSE))
        {
            enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 424, 0, 200, 0, 500, ENEMY_00_REBECCA, ANIM_00, 0, EVAR_00);
        }
        else if (ck(FG_COMMON, F_COMMON_C_REBECCA_LEFT_BAR, FALSE))
        {
            enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 3224, 0, 9600, 0, 8100, ENEMY_00_REBECCA, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_PIANO_PLAYED, TRUE))
        {
            evt_exec(0, TASK_09, jill_wall_open_on_enter);
        }
        evt_exec(0, TASK_09, defer_camera_switch);
    }
}

proc main
{
    if (testitem(IT_23_KEY_MUSIC_SCORE))
    {
        if (CHRIS)
        {
            if (ck(FG_ROOM, F_ROOM_C_MUSIC_SCORE_USED, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_RICHARD_FOUND, TRUE))
                {
                    if (ck(FG_COMMON, F_COMMON_RICHARD_SCENE_OVER, TRUE))
                    {
                        if (ck(FG_COMMON, F_COMMON_C_REBECCA_MET, FALSE))
                        {
                            evt_exec(0, TASK_09, give_score_to_rebecca_or_jill_reads_score);
                        }
                        else
                        {
                            evt_exec(0, TASK_09, give_score_to_rebecca_alt);
                        }
                    }
                    else
                    {
                        evt_exec(0, TASK_09, no_time_to_play);
                    }
                }
                else if (ck(FG_COMMON, F_COMMON_C_REBECCA_MET, FALSE))
                {
                    evt_exec(0, TASK_09, give_score_to_rebecca_or_jill_reads_score);
                }
                else
                {
                    evt_exec(0, TASK_09, give_score_to_rebecca_alt);
                }
            }
        }
        else
        {
            if (ck(FG_ROOM, F_ROOM_J_MUSIC_SCORE_USED, TRUE))
            {
                evt_exec(0, TASK_09, give_score_to_rebecca_or_jill_reads_score);
            }
        }
    }
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_C_BAR_WOOD_EMBLEM_SET, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_C_BAR_GOLD_EMBLEM_TAKEN, TRUE))
            {
                aot_delete(AOT_06_USEITEM_SLOT_WOOD_ALT, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_07_USEITEM_SLOT_WOOD, SCE_USEITEM, SAT_PLAYER);
            }
            else
            {
                aot_delete(AOT_06_USEITEM_SLOT_WOOD_ALT, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_07_USEITEM_SLOT_WOOD, SCE_NONE, SAT_PLAYER);
            }
            if (testpickup(IT_20_KEY_EMBLEM_GOLD))
            {
                set(FG_COMMON, F_COMMON_C_BAR_GOLD_EMBLEM_TAKEN, TRUE);
                evt_exec(0, TASK_09, chris_gold_emblem_closes_wall);
            }
            if (testitem(IT_1F_KEY_EMBLEM_WOOD))
            {
                if (ck(FG_ROOM, F_ROOM_C_WOOD_EMBLEM_USED, TRUE))
                {
                    set(FG_ITEM, F_ITEM_10F_KEY_EMBLEM_WOOD_0, TRUE);
                    set(FG_COMMON, F_COMMON_C_BAR_WOOD_EMBLEM_SET, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_00_KEY_EMBLEM_WOOD, OF_ACTIVE);
                    aot_delete(AOT_03_ITEM_KEY_EMBLEM_WOOD_0, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                    evt_exec(0, TASK_09, chris_wood_emblem_opens_wall);
                    evt_exec(0, TASK_09, chris_place_wood_emblem);
                }
            }
            if (testitem(IT_20_KEY_EMBLEM_GOLD))
            {
                if (ck(FG_ROOM, F_ROOM_C_GOLD_EMBLEM_USED, TRUE))
                {
                    set(FG_ITEM, F_ITEM_10F_KEY_EMBLEM_GOLD_1, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_01_KEY_EMBLEM_GOLD, OF_ACTIVE);
                    aot_delete(AOT_04_ITEM_KEY_EMBLEM_GOLD_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                    evt_exec(0, TASK_09, chris_wood_emblem_opens_wall);
                    set(FG_COMMON, F_COMMON_C_BAR_GOLD_EMBLEM_TAKEN, FALSE);
                }
            }
            if (ck(FG_COMMON, F_COMMON_C_PIANO_PLAYED, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_LEFT_BAR, FALSE))
                {
                    aot_delete(AOT_01_MESSAGE_REBECCA_PLAYING, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                    aot_reset(AOT_0D_EVENT_TALK_REBECCA, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, rebecca_be_careful, 0);
                }
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_C_PIANO_PLAYED, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_LEFT_BAR, FALSE))
                {
                    aot_delete(AOT_01_MESSAGE_REBECCA_PLAYING, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                    aot_reset(AOT_0D_EVENT_TALK_REBECCA, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, rebecca_are_you_ok, 0);
                }
            }
            aot_delete(AOT_06_USEITEM_SLOT_WOOD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM_SLOT_WOOD, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_08_USEITEM_SLOT_GOLD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_09_USEITEM_SLOT_GOLD, SCE_NONE, SAT_PLAYER);
        }
        if (ck(FG_COMMON, F_COMMON_C_BAR_WOOD_EMBLEM_SET, TRUE))
        {
            aot_reset(AOT_0A_MESSAGE_EMBLEM_SLOT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 255, 0);
        }
        else if (ck(FG_COMMON, F_COMMON_C_BAR_GOLD_EMBLEM_TAKEN, TRUE))
        {
            aot_reset(AOT_0A_MESSAGE_EMBLEM_SLOT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 152, 255, 0);
        }
        else
        {
            aot_delete(AOT_0A_MESSAGE_EMBLEM_SLOT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_PIANO_PLAYED, TRUE))
        {
            if (cmpb(B_CAMERA, CMP_EQ, CAM_01_PIANO))
            {
                aot_switch(0, SPR_0E, SPR_OFF);
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_BAR_WOOD_EMBLEM_SET, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_BAR_GOLD_EMBLEM_OUT, TRUE))
            {
                aot_delete(AOT_06_USEITEM_SLOT_WOOD_ALT, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_07_USEITEM_SLOT_WOOD, SCE_USEITEM, SAT_PLAYER);
            }
            else
            {
                aot_delete(AOT_06_USEITEM_SLOT_WOOD_ALT, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_07_USEITEM_SLOT_WOOD, SCE_NONE, SAT_PLAYER);
            }
            if (testpickup(IT_20_KEY_EMBLEM_GOLD))
            {
                set(FG_COMMON, F_COMMON_J_BAR_GOLD_EMBLEM_OUT, TRUE);
                evt_exec(0, TASK_09, jill_gold_emblem_closes_wall);
            }
            if (testitem(IT_1F_KEY_EMBLEM_WOOD))
            {
                if (ck(FG_ROOM, F_ROOM_J_WOOD_EMBLEM_USED, TRUE))
                {
                    set(FG_ITEM, F_ITEM_10F_KEY_EMBLEM_WOOD_0, TRUE);
                    set(FG_COMMON, F_COMMON_J_BAR_WOOD_EMBLEM_SET, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_00_KEY_EMBLEM_WOOD, OF_ACTIVE);
                    aot_delete(AOT_03_ITEM_KEY_EMBLEM_WOOD_0, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                    evt_exec(0, TASK_09, jill_wood_emblem_opens_wall);
                    evt_exec(0, TASK_09, jill_place_wood_emblem);
                }
            }
            if (testitem(IT_20_KEY_EMBLEM_GOLD))
            {
                if (ck(FG_ROOM, F_ROOM_J_GOLD_EMBLEM_USED, TRUE))
                {
                    set(FG_ITEM, F_ITEM_10F_KEY_EMBLEM_GOLD_1, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_01_KEY_EMBLEM_GOLD, OF_ACTIVE);
                    aot_delete(AOT_04_ITEM_KEY_EMBLEM_GOLD_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                    evt_exec(0, TASK_09, jill_wood_emblem_opens_wall);
                    set(FG_COMMON, F_COMMON_J_BAR_GOLD_EMBLEM_OUT, FALSE);
                }
            }
        }
        else
        {
            aot_delete(AOT_06_USEITEM_SLOT_WOOD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM_SLOT_WOOD, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_08_USEITEM_SLOT_GOLD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_09_USEITEM_SLOT_GOLD, SCE_NONE, SAT_PLAYER);
        }
        if (ck(FG_COMMON, F_COMMON_J_BAR_WOOD_EMBLEM_SET, TRUE))
        {
            aot_reset(AOT_0A_MESSAGE_EMBLEM_SLOT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 255, 0);
        }
        else if (ck(FG_COMMON, F_COMMON_J_BAR_GOLD_EMBLEM_OUT, TRUE))
        {
            aot_reset(AOT_0A_MESSAGE_EMBLEM_SLOT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 152, 255, 0);
        }
        else
        {
            aot_delete(AOT_0A_MESSAGE_EMBLEM_SLOT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
    }
}

event chris_listens_to_sonata when (CHRIS)
{
    sleep(100);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
