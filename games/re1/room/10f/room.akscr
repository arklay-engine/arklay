}

event chris_wall_open_on_enter when (CHRIS)
{
    evt_work_set(WK_OBJ, OBJ_00_HIDDEN_WALL);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    evt_finish();
}

event chris_place_wood_emblem when (CHRIS)
{
    evt_work_set(WK_AOT, IMDL_00_KEY_EMBLEM_WOOD);
    evt_tween_begin_alt();
    tw_abs_pos(0, 9220, -560, 19550);
    tw_abs_rot(0, 0, 1024, 0);
    tw_end();
    evt_nop();
    se_play_3d(SND_BANK_ROOM, SE_1A, 0, SND_AT_POINT, 0, 9424, 19173);
    evt_finish();
}

event defer_camera_switch
{
    sleep(1);
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
    evt_finish();
}

