    else
    {
        act_anim_flags(ANIM_39, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(17);
    if (CHRIS)
    {
        act_anim_flags(ANIM_39, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_39, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(18);
    if (CHRIS)
    {
        act_anim_flags(ANIM_38, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_38, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(10);
    if (CHRIS)
    {
        act_anim_flags(ANIM_39, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_39, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(13);
    if (CHRIS)
    {
        act_anim_flags(ANIM_39, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_39, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(12);
    if (CHRIS)
    {
        act_anim_flags(ANIM_38, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_38, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(10);
    if (CHRIS)
    {
        act_anim_flags(ANIM_38, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_38, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(10);
    if (CHRIS)
    {
        act_anim_flags(ANIM_39, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_39, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    sleep(10);
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(60);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_25, F_ROOM_PLAYER_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        voice_play(VOICE_PLAY, VO_006_11);
        message(MSG_VO_006_11, 0);
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
        evt_actor_begin();
        act_anim_flags(ANIM_22, F_ROOM_C_REBECCA_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_20, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_22, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        wait_message();
    }
    sleep(20);
    cutnext(CAM_01_PIANO);
    aot_switch(0, SPR_0E, SPR_OFF);
    sleep(30);
    if (CHRIS)
    {
        evt_fork(TASK_09, chris_sonata_opens_wall, 0);
        sleep(60);
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_fork(TASK_09, jill_sonata_opens_wall, 0);
        sleep(30);
        evt_work_set(WK_PLAYER, 0);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_2D, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_2D, F_ROOM_PLAYER_ANIM_DONE, 0);
    }
    act_param_set(0, 64512);
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_seq(AB_03, 8570, 9800, F_ROOM_PLAYER_ANIM_DONE);
        act_reset();
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    cutnext(CAM_07_WALL_FROM_PIANO);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(25);
    }
    else
    {
        sleep(40);
    }
    cutnext(CAM_01_PIANO);
    aot_switch(0, SPR_0E, SPR_OFF);
    if (CHRIS)
    {
        sleep(25);
        voice_play(VOICE_PLAY, VO_006_12);
        message(MSG_VO_006_12, 0);
        wait_message();
    }
    sleep(20);
    if (CHRIS)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_idle();
        act_reset();
    }
    run
    {
        if (CHRIS)
        {
            set(FG_COMMON, F_COMMON_C_PIANO_PLAYED, TRUE);
        }
        else
        {
            aot_reset(AOT_02_MESSAGE_PIANO, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
            remove_item(IT_23_KEY_MUSIC_SCORE);
            set(FG_COMMON, F_COMMON_J_PIANO_PLAYED, TRUE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
        if (CHRIS)
        {
            room_bgm_state_set(0, ROOM_104_TEA_ROOM, BGM_MAIN_ON);
        }
        room_bgm_state_set(0, ROOM_10F_BAR, BGM_OFF);
        if (JILL)
        {
            room_bgm_state_set(0, ROOM_104_TEA_ROOM, BGM_MAIN_ON);
        }
    }
    if (JILL)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_idle();
        act_reset();
    }
    evt_finish();
}

event chris_sonata_opens_wall when (CHRIS)
{
    se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_POINT, 0, 9424, 12173);
    se_play_3d(SND_BANK_ROOM, SE_18, 0, SND_AT_POINT, 0, 9424, 12173);
    evt_work_set(WK_OBJ, OBJ_00_HIDDEN_WALL);
    evt_tween_begin_alt();
    evt_next();
    tw_nop();
    tw_set_pos(0, -48, 0);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    evt_finish();
}

event chris_gold_emblem_closes_wall
{
    if (CHRIS)
    {
        se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_POINT, 0, 9424, 12173);
        se_play_3d(SND_BANK_ROOM, SE_18, 0, SND_AT_POINT, 0, 9424, 12173);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        sleep(20);
        run
        {
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            cutnext(CAM_03_HIDDEN_WALL);
        }
        evt_work_set(WK_OBJ, OBJ_00_HIDDEN_WALL);
        evt_tween_begin_alt();
        evt_next();
        tw_nop();
        tw_abs_pos(0, 9060, -4250, 12596);
        tw_set_pos(0, 48, 0);
        for (90)
        {
            tw_pos_add();
            evt_next();
        }
        tw_nop();
        tw_end();
        evt_nop();
        se_play_3d(SND_BANK_ROOM, SE_19, 0, SND_AT_POINT, 0, 9424, 12173);
        sleep(10);
        run
        {
            cutnext(CAM_04_EMBLEM_SLOT);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
            cut_auto(CUT_FREE);
        }
    }
    else
    {
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
            cut_auto(CUT_FREE);
        }
    }
    evt_finish();
}

event chris_wood_emblem_opens_wall when (CHRIS)
