#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_20C 0x00                                // The ladder up.
#define AOT_01_DOOR_21B 0x01
#define AOT_02_EVENT_LADDER 0x02
#define AOT_03_ITEM_AMMO_SHOTGUN_0 0x03
#define ENEMY_00_ZOMBIE_GREEN 0x00
#define ENEMY_01_ZOMBIE_GREEN 0x01
#define IMDL_00_AMMO_SHOTGUN 0x00
#define MSG_THERE_IS_A_LADDER 0x00

proc init when (MANSION2)
{
    door_aot_set(AOT_00_DOOR_20C, 29300, 2900, 3000, 2100, 0, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_20C_LESSON_ROOM, 20300, 0, 3500, 0, UNLOCKED, 0);
    door_aot_set(AOT_01_DOOR_21B, 200, 2800, 1900, 1500, 2, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 7, 0, ROOM_21B_UNDER_PASSAGE_2, 27500, 0, 12600, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_02_EVENT_LADDER, 29300, 2900, 3000, 2100, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, climb_ladder_prompt, 0, 0, 0);
    item_aot_set(AOT_03_ITEM_AMMO_SHOTGUN_0, 28000, 11500, 1000, 1000, IT_0C_AMMO_SHOTGUN, 7, IMDL_00_AMMO_SHOTGUN, SCA_NONE, 28500, 0, 12000, 0, F_ITEM_21A_AMMO_SHOTGUN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    enemy(EM_11_ZOMBIE_GREEN, EB_00, F_ENEMY_21A_ZOMBIE_GREEN_0, SPAWN_FORCE, 2, 0, 1711, 0, 27742, 0, 13736, ENEMY_00_ZOMBIE_GREEN, ANIM_00, 0, EVAR_01);
    enemy(EM_11_ZOMBIE_GREEN, EB_00, F_ENEMY_21A_ZOMBIE_GREEN_1, SPAWN_FORCE, 2, 0, 3344, 0, 12764, 0, 2397, ENEMY_01_ZOMBIE_GREEN, ANIM_00, 0, EVAR_01);
}

event climb_ladder_prompt when (MANSION2)
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_THERE_IS_A_LADDER | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a ladder. Will you climb it?"
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_on(AOT_00_DOOR_20C, SCE_DOOR, 0);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
        else
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    evt_finish();
}
