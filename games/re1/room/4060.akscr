#version 1

proc init
{
    door_aot_set(0, 300, 2000, 2100, 1800, 0, 0, 6, 1, 0, RDT_005, 24700, 0, 21100, 2048, UNLOCKED, 129);
    door_aot_set(1, 2500, 3700, 1600, 1800, 1, 0, 33, 1, 0, RDT_007, 3100, 0, 6400, 3072, UNLOCKED, 129);
    door_aot_set(2, 0, 0, 1, 1, 1, 11, 26, 64, 0, RDT_00D, 3500, 0, 29000, 1024, UNLOCKED, 129);
    aot_set(3, 10500, 1600, 1100, 1600, SCE_HIKIDASHI, 129, 34, 0, 6, 0, 6, 0);
    aot_set(4, 9000, 5000, 1000, 1000, SCE_EVENT, 129, 9, 0, event_01, 0, 0, 0);
    aot_set(5, 12100, 8400, 1000, 1000, SCE_EVENT, 129, 9, 0, event_04, 0, 0, 0);
    item_aot_set(6, 0, 0, 1, 1, ITEM_SHELLS, 7, 0, 255, 22, 43, 116, 255, 168, 7, 0, 0, 25, 0, 0, 0);
    eml_rot(0, 0, 0, 0, 252);
    setbyte(0, 0, 0);
    item_aot_set(7, 12400, 3800, 1000, 1400, ITEM_64, 1, 1, 255, 88, 52, 58, 253, 76, 19, 0, 0, 134, 129, 0, 0);
    item_aot_set(8, 0, 0, 1, 10, ITEM_52, 1, 2, 255, 64, 36, 240, 246, 44, 21, 0, 0, 135, 129, 0, 0);
    if (ck(FG_SCENARIO, 69, 0))
    {
        obj(0, 17, 255, 10180, 0, 8970, 1024, 0, 0, 94, 1, 0, 0, 162, 254, 200, 0, 76, 4, 176, 4, 88, 2);
        obj(1, 17, 255, 10176, 0, 10220, 1024, 0, 0, 44, 1, 0, 0, 212, 254, 200, 0, 76, 4, 176, 4, 88, 2);
    }
    else
    {
        obj(0, 17, 255, 12907, 0, 8580, 1024, 0, 0, 94, 1, 0, 0, 162, 254, 200, 0, 76, 4, 176, 4, 88, 2);
        obj(1, 17, 255, 10176, 0, 8580, 1024, 0, 0, 44, 1, 0, 0, 212, 254, 200, 0, 76, 4, 176, 4, 88, 2);
    }
    if (cmpb(9, 0, 3))
    {
        aot_reset(3, SCE_MESSAGE, 129, 136, 255, 0);
        aot_reset(4, SCE_MESSAGE, 129, 136, 255, 0);
        aot_reset(7, SCE_MESSAGE, 129, 136, 255, 0);
    }
    if (ck(FG_SCENARIO, 62, 0))
    {
        aot_delete(4, SCE_NONE, 129);
    }
    set(FG_STATUS, 60, 0);
}

event event_00
{
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_6, 23, 1);
        message(134, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, event_02);
        }
        else
        {
            evt_exec(0, 9, event_03);
        }
    }
    evt_finish();
}

event event_02
{
    run
    {
        aot_on(8, SCE_F, 0);
        aot_delete(4, SCE_NONE, 129);
        message(137, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, 23, 0);
        set(FG_SCENARIO, 62, 0);
    }
    evt_finish();
}

event event_03
{
    single(4) set(FG_6, 0, 0);
    raw(0x17, 0x00, 0xFF, 0x00);
}

event event_04
{
    run
    {
        cutnext(0);
        set(FG_6, 23, 1);
        message(135, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, event_05);
        }
        else
        {
            evt_exec(0, 9, event_06);
        }
    }
    evt_finish();
}

event event_05
{
    run
    {
        door_aot_set(2, 10000, 6400, 5000, 5000, 1, 11, 26, 64, 0, RDT_00D, 3000, 0, 27800, 1024, UNLOCKED, 65);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_06
{
    run
    {
        set(FG_6, 23, 0);
        cut_auto(0);
    }
    evt_finish();
}
