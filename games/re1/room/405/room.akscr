proc init
{
    door_aot_set(AOT_00_DOOR, 2300, 4700, 2700, 3000, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 9, 0, ROOM_400_ENTER_PASSAGE, 16200, 0, 3100, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 25100, 19800, 2600, 2500, 3, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, DOOR_LOCKED | F_LOCK_29, ROOM_406_ROOM_002, 3000, 0, 3000, 0, IT_39_KEY_GUARDHOUSE_002, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 23600, 7300, 2500, 3100, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, ROOM_408_HONEYCOMB_PASSAGE, 4200, 0, 3400, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_03_ITEM, 23900, 27200, 800, 1000, IT_44_HEAL_HERB_GREEN, 1, IMDL_00, SCA_NONE, 24300, 0, 27560, 1024, F_ITEM_6A, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_04_ITEM, 22700, 27000, 1000, 1000, IT_44_HEAL_HERB_GREEN, 1, IMDL_01, SCA_NONE, 23040, 0, 27350, 1024, F_ITEM_6B, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_05_ITEM, 23000, 26000, 800, 1100, IT_44_HEAL_HERB_GREEN, 1, IMDL_02, SCA_NONE, 23040, 0, 26440, 1024, F_ITEM_6C, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    obj(OBJ_00, OF_ACTIVE, SCA_NONE, 24390, 0, 24550, 1024, 0, 200, 0, -200, 400, 620, 600, 600);
    evt_exec(0, TASK_09, on_enter);
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_AB, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
            {
                evt_exec(0, TASK_09, on_enter_3);
            }
        }
        if (ck(FG_COMMON, F_COMMON_AB, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
            {
                enemy(EM_24_NPC_WESKER, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 2000, 0, 16400, 0, 4500, ENEMY_00_NPC_WESKER, ANIM_00, 0, EVAR_00);
                enemy(EM_07_WASP, EB_13, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 15000, 0, 3100, ENEMY_01_WASP, ANIM_00, 0, EVAR_00);
                enemy(EM_07_WASP, EB_13, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 9300, 0, 4600, ENEMY_02_WASP, ANIM_00, 0, EVAR_00);
                enemy(EM_07_WASP, EB_13, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 7000, 0, 3600, ENEMY_03_WASP, ANIM_00, 0, EVAR_00);
            }
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_AF, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_B2, FALSE))
                {
                    room_bgm_state_set(3, ROOM_405_CENTER_PASSAGE, BGM_RELOAD | 1);
                    evt_exec(0, TASK_09, on_enter_2);
                }
                else
                {
                    room_bgm_state_set(3, ROOM_405_CENTER_PASSAGE, BGM_RELOAD | 1);
                    evt_exec(0, TASK_09, on_enter_3);
                }
                set(FG_COMMON, F_COMMON_27, TRUE);
            }
        }
        if (ck(FG_COMMON, F_COMMON_AF, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
            {
                enemy(EM_24_NPC_WESKER, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 2000, 0, 16400, 0, 4500, ENEMY_00_NPC_WESKER, ANIM_00, 0, EVAR_00);
                enemy(EM_07_WASP, EB_13, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 11500, 0, 3100, ENEMY_01_WASP, ANIM_00, 0, EVAR_00);
                enemy(EM_07_WASP, EB_13, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 9300, 0, 4600, ENEMY_02_WASP, ANIM_00, 0, EVAR_00);
                enemy(EM_07_WASP, EB_13, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 7000, 0, 3600, ENEMY_03_WASP, ANIM_00, 0, EVAR_00);
            }
        }
    }
}

event on_enter
{
    run
    {
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_AB, FALSE))
            {
                if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
                {
                    room_bgm_state_set(3, ROOM_405_CENTER_PASSAGE, BGM_RELOAD | 1);
                }
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_07, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_AE, FALSE))
                {
                    aot_reset(AOT_01_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_01_door, 0);
                    room_bgm_state_set(3, ROOM_405_CENTER_PASSAGE, BGM_RELOAD);
                }
            }
            if (ck(FG_COMMON, F_COMMON_AF, FALSE))
            {
                if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
                {
                    if (ck(FG_COMMON, F_COMMON_B2, FALSE))
                    {
                        room_bgm_state_set(3, ROOM_405_CENTER_PASSAGE, BGM_RELOAD | 1);
                    }
                    else
                    {
                        room_bgm_state_set(3, ROOM_405_CENTER_PASSAGE, BGM_RELOAD | 1);
                    }
                }
            }
        }
    }
    evt_finish();
}

