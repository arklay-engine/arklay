event on_aot_01_door when (JILL)
{
    sleep(1);
    run
    {
        bgm_play(BGM_MAIN);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_AE, TRUE);
        message(MSG_VOICES_ARE_HEARD_FROM_THE_OTHER | MSG_FAST, 0); // "Voices are heard from the other side of the door."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2E, F_ROOM_20, AFL_01);
    act_param_set(0, 1024);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_20, AFL_01);
    act_motion_path(MOTION_33, 500, 230, 0, 80, 60);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    run
    {
        message(13, 0);
        voice_play(VOICE_PLAY, VO_109_00);
    }
    wait_message();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    run
    {
        bgm_stop(BGM_MAIN);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        aot_reset(AOT_01_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
        room_bgm_state_set(3, ROOM_405_CENTER_PASSAGE, BGM_OFF);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}
