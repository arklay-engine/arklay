#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_DOOR 0x04
#define AOT_05_EVENT 0x05
#define CAM_02 0x02
#define CAM_03 0x03
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_ZOMBIE_LAB 0x00
#define ENEMY_01_ZOMBIE_LAB 0x01
#define F_ROOM_3F 0x3F
#define MSG_VO_00C_00 0x00
#define MSG_VO_00C_01 0x01
#define MSG_VO_00C_20 0x02
#define MSG_VO_00C_22 0x03
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_00C_00 0x54
#define VO_00C_01 0x55
#define VO_00C_20 0x64
#define VO_00C_21 0x65
#define VO_00C_22 0x66

proc init
{
    if (MANSION2)
    {
        set(FG_STATUS, F_STATUS_1C, TRUE);
    }
    door_aot_set(AOT_00_DOOR, 15200, 2400, 2000, 2600, 9, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_109_TRAP_PASSAGE, 2700, 0, 8500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 1800, 1000, 2400, 1400, 2, DOOR_SND_00_DR_WD, DOOR_1E_DOOR03K, 5, DOOR_LOCK_40, ROOM_117_LARGE_GALLERY, 2900, 0, 10000, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 7800, 5200, 1500, 1700, 1, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 4, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_18, ROOM_119_STUDY, 6300, 0, 2700, 3072, IT_36_KEY_MANSION_HELMET, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 10600, 5200, 2000, 1700, 2, DOOR_SND_00_DR_WD, DOOR_02_DOOR02, 1, DOOR_LOCKED | F_LOCK_14, ROOM_10B_1F_RIGHT_STAIRS, 3300, 0, 6600, 3072, LOCK, SAT_MANUAL | SAT_PLAYER);
    if (MANSION1)
    {
        door_aot_set(AOT_04_DOOR, 200, 10700, 2000, 2300, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCK_40, ROOM_11A_ROOFED_PASSAGE, 4500, 0, 4100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        enemy(EM_11_ZOMBIE_LAB, EB_00, F_ENEMY_71, SPAWN_FORCE, 2, 0, 0, 0, 8272, 0, 2433, ENEMY_00_ZOMBIE_LAB, ANIM_00, 0, EVAR_00);
        enemy(EM_11_ZOMBIE_LAB, EB_00, F_ENEMY_72, SPAWN_FORCE, 2, 0, 1031, 0, 3023, 0, 6864, ENEMY_01_ZOMBIE_LAB, ANIM_00, 0, EVAR_00);
    }
    else
    {
        if (CHRIS)
        {
            door_aot_set(AOT_04_DOOR, 200, 10700, 2000, 2300, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCK_40, ROOM_11A_ROOFED_PASSAGE, 4500, 0, 4100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
            if (ck(FG_COMMON, F_COMMON_2B, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_64, TRUE))
                {
                    set(FG_COMMON, F_COMMON_36, TRUE);
                }
                if (ck(FG_COMMON, F_COMMON_59, TRUE) && ck(FG_COMMON, F_COMMON_5D, FALSE))
                {
                    set(FG_COMMON, F_COMMON_36, TRUE);
                }
                aot_set(AOT_05_EVENT, 0, 400, 5600, 6100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 0, 0, on_aot_05, 0, 0, 0);
                enemy(EM_06_HUNTER, EB_A7, F_ENEMY_02, SPAWN_FORCE, 2, 0, 0, 0, 20000, 20000, 20000, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_06_HUNTER, EB_27, F_ENEMY_02, SPAWN_FORCE, 2, 0, 896, 0, 4561, 0, 4818, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            }
        }
        else
        {
            door_aot_set(AOT_04_DOOR, 200, 10700, 2000, 2300, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_11A_ROOFED_PASSAGE, 4500, 0, 4100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
            if (ck(FG_COMMON, F_COMMON_28, FALSE))
            {
                aot_set(AOT_05_EVENT, 0, 400, 5600, 6100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 0, 0, on_aot_05, 0, 0, 0);
                enemy(EM_06_HUNTER, EB_A7, F_ENEMY_02, SPAWN_FORCE, 2, 0, 0, 0, 20000, 20000, 20000, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_06_HUNTER, EB_27, F_ENEMY_02, SPAWN_FORCE, 2, 0, 896, 0, 4561, 0, 4818, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            }
        }
        return;
    }
}

proc main when (CHRIS && MANSION2)
{
    if (ck(FG_ENEMY, F_ENEMY_02, TRUE) && ck(FG_COMMON, F_COMMON_21, TRUE))
    {
        set(FG_COMMON, F_COMMON_21, FALSE);
        if (ck(FG_COMMON, F_COMMON_22, TRUE))
        {
            setw(W_04, 0);
            evt_exec(0, TASK_09, from_main);
        }
        if (ck(FG_COMMON, F_COMMON_36, TRUE))
        {
            setw(W_04, 0);
            evt_exec(0, TASK_09, from_main_2);
        }
    }
    return;
}

event on_aot_05 when (MANSION2)
{
    run
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
        if (CHRIS)
        {
            set(FG_COMMON, F_COMMON_2B, TRUE);
        }
        else
        {
            set(FG_COMMON, F_COMMON_28, TRUE);
        }
        bgm_stop_all(0);
    }
    sleep(1);
    movie_on(MOVIE_06_DM6);
    sleep(1);
    run
    {
        set(FG_STATUS, F_STATUS_0F, TRUE);
        bgm_restore(0);
        dir_set(0, 0, 304, 0, 2276, 0, 3481);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_02);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_3F, 0);
    act_reset();
    evt_nop();
    sleep(10);
    evt_fork(TASK_09, on_aot_05_sub2, 0);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_POINT, 0, 2468, 11628);
    sleep(30);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 2468, 11628);
    sleep(20);
    run
    {
        pos_set(ENEMY_00_HUNTER, 0, 914, 0, 2524, 0, 12163);
        eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_67);
        if (CHRIS)
        {
            dir_set(0, 0, 0, 0, 4880, 0, 3549);
        }
        else
        {
            dir_set(0, 0, 304, 0, 4890, 0, 3549);
        }
    }
    evt_fork(TASK_09, on_aot_05_sub1, 0);
    cutnext(CAM_03);
    sleep(100);
    run
    {
        dir_set(0, 0, 3144, 0, 2260, 0, 2984);
        pos_set(ENEMY_00_HUNTER, 0, 914, 0, 2665, 0, 8864);
        eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_27);
        cutnext(CAM_02);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        if (CHRIS)
        {
            set(FG_COMMON, F_COMMON_21, TRUE);
        }
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    evt_finish();
}

event on_aot_05_sub1 when (MANSION2)
{
    evt_work_set(WK_ENEMY, ENEMY_00_HUNTER);
    evt_actor_begin();
    act_anim_seq(AB_02, 3033, 8206, F_ROOM_3F);
    act_finish();
}

event from_main when (CHRIS && MANSION2)
{
    run
    {
        bgm_play(BGM_SUB_1);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, from_main_sub1);
        voice_play(VOICE_PLAY, VO_00C_00);
        message(MSG_VO_00C_00, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(VOICE_PLAY, VO_00C_01);
    message(MSG_VO_00C_01, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

event from_main_sub1 when (CHRIS && MANSION2)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(70);
    act_motion_path(MOTION_31, 1250, 0, 0, 50, 0);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_finish();
}

event from_main_2 when (CHRIS && MANSION2)
{
    run
    {
        bgm_play(BGM_SUB_1);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, from_main_2_sub1);
        voice_play(VOICE_PLAY, VO_00C_20);
        message(MSG_VO_00C_20, 0);
    }
    sleep(40);
    wait_message();
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_21);
    if (JPN)
    {
        sleep(56);
    }
    else
    {
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_0E, TRUE));
    }
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_22);
    message(MSG_VO_00C_22, 0);
    wait_message();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, 0, 0, 0, 250, 250);
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

