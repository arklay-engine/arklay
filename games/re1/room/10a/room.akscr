    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(40);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_motion_path(MOTION_33, -1700, -5000, 0, 150, 50);
    sleep(15);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    sleep(25);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(40);
    act_anim_flags(ANIM_2A, F_ROOM_3F, 0);
    sleep(40);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    act_flag_op(EF_OR, EF_0010);
    act_finish();
}

event on_aot_05_sub2 when (MANSION2)
{
    sleep(37);
