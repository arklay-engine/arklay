#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_309 0x00
#define AOT_01_ITEM_AMMO_HANDGUN_0 0x01                     // Enrico's rounds; a 1 by 1 spot turned on by searching him.
#define AOT_02_EVENT_BARRY_INVESTIGATING 0x02
#define AOT_02_EVENT_ENRICO_SCENE 0x02
#define AOT_03_EVENT_ENRICO_BODY 0x03
#define AOT_09_ITEM_KEY_CRANK_HEXAGONAL_1 0x09              // Turned on in Enrico's scene.
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define CAM_06 0x06
#define CAM_07 0x07
#define ENEMY_00_NPC_ENRICO 0x00
#define ENEMY_01_HUNTER 0x01
#define ENEMY_01_NPC_BARRY 0x01
#define ENEMY_02_HUNTER 0x02
#define FX_00 0x00
#define F_ROOM_ANIM_DONE 0x20                               // An animation finished (one frame); nothing waits for it.
#define F_ROOM_C_HUNTERS_PENDING 0x08                       // After Enrico's scene: main sends the two hunters in at camera 2.
#define F_ROOM_C_PLAYER_WALK_2_DONE 0x00                    // Chris's second walk in Enrico's scene finished (one frame).
#define F_ROOM_J_BARRY_WALK_DONE 0x23                       // Barry's walk finished (one frame).
#define F_ROOM_J_PLAYER_WALK_2_DONE 0x01                    // Jill's second walk in Enrico's scene finished (one frame).
#define F_ROOM_PLAYER_WALK_DONE 0x21                        // The player's walk finished (one frame).
#define IMDL_00_AMMO_HANDGUN 0x00
#define IMDL_01_KEY_CRANK_HEXAGONAL 0x01
#define MSG_BARRY_IS_INVESTIGATING 0x18
#define MSG_HE_COULD_NOT_HAVE_MOVED_BECAUSE_HE_IS_HOLDING_SOMETHING_06 0x06
#define MSG_VO_00D_00 0x00
#define MSG_VO_00D_01 0x01
#define MSG_VO_00D_03 0x03
#define MSG_VO_00D_04 0x04
#define MSG_VO_00D_05 0x05
#define MSG_VO_10F_00 0x07
#define MSG_VO_10F_02 0x08
#define MSG_VO_10F_04 0x09
#define MSG_VO_10F_05 0x0A
#define MSG_VO_10F_06 0x0B
#define MSG_VO_10F_07 0x0C
#define MSG_VO_10F_08 0x0D
#define MSG_VO_10F_15 0x0E
#define MSG_VO_10F_16 0x0F
#define MSG_VO_10F_17 0x10
#define MSG_VO_10F_18 0x11
#define MSG_VO_10F_19 0x12
#define MSG_VO_10F_1A 0x13
#define MSG_VO_10F_1B 0x14
#define SE_17_GUN_PF 0x17
#define SE_19_YK_30A 0x19
#define SE_1A_TAORE_CA 0x1A
#define SE_1B_V00D_02 0x1B
#define SE_2D_FT_CAVEA 0x2D
#define VO_00D_00 0x00
#define VO_00D_01 0x01
#define VO_00D_03 0x03
#define VO_00D_04 0x04
#define VO_00D_05 0x05
#define VO_10F_00 0x06
#define VO_10F_02 0x07
#define VO_10F_04 0x08
#define VO_10F_05 0x09
#define VO_10F_06 0x0A
#define VO_10F_07 0x0B
#define VO_10F_08 0x0C
#define VO_10F_15 0x0F
#define VO_10F_16 0x10
#define VO_10F_17 0x11
#define VO_10F_18 0x12
#define VO_10F_19 0x13
#define VO_10F_1A 0x14
#define VO_10F_1B 0x15

proc init
{
    door_aot_set(AOT_00_DOOR_309, 3400, 20200, 1500, 1300, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_309_DARKNESS_PASSAGE, 15300, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM_AMMO_HANDGUN_0, 0, 0, 1, 1, IT_0B_AMMO_HANDGUN, 15, IMDL_00_AMMO_HANDGUN, SCA_NONE, 0, 0, 0, 0, F_ITEM_30A_AMMO_HANDGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_COMMON, F_COMMON_ENRICO_SHOT, FALSE))
    {
        item_aot_set(ITEM_ALT_ROT | AOT_09_ITEM_KEY_CRANK_HEXAGONAL_1, 3330, 11130, 1000, 1000, IT_1E_KEY_CRANK_HEXAGONAL, 0, IMDL_01_KEY_CRANK_HEXAGONAL, SCA_NONE, 30000, 30000, 30000, 0, F_ITEM_30A_KEY_CRANK_HEXAGONAL_1, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6 | ITEM_REACH);
        aot_delete(AOT_09_ITEM_KEY_CRANK_HEXAGONAL_1, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        item_aot_set(ITEM_ALT_ROT | AOT_09_ITEM_KEY_CRANK_HEXAGONAL_1, 3330, 11130, 1000, 1000, IT_1E_KEY_CRANK_HEXAGONAL, 0, IMDL_01_KEY_CRANK_HEXAGONAL, SCA_NONE, 3830, 0, 11630, 1200, F_ITEM_30A_KEY_CRANK_HEXAGONAL_1, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6 | ITEM_REACH);
    }
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_ENRICO_SHOT, FALSE))
        {
            aot_set(AOT_02_EVENT_ENRICO_SCENE, 10600, 1700, 1000, 6300, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, enrico_shot_chris_or_with_barry, 0, 0, 0);
            enemy(EM_28_NPC_ENRICO, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 824, 0, 10840, 0, 16490, ENEMY_00_NPC_ENRICO, ANIM_00, 58, EVAR_00);
        }
        else
        {
            enemy(EM_28_NPC_ENRICO, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 824, 0, 10840, 0, 16490, ENEMY_00_NPC_ENRICO, ANIM_00, 58, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_ENRICO_SEARCHED, FALSE))
        {
            aot_set(AOT_03_EVENT_ENRICO_BODY, 10400, 14800, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, search_enrico, 0, 0, 0);
        }
        if (ck(FG_COMMON, F_COMMON_ENRICO_SHOT, FALSE))
        {
            enemy(EM_06_HUNTER, EB_88, F_ENEMY_30A_HUNTER_1, SPAWN_FORCE, 2, 0, 2048, 0, 30000, 30000, 30000, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
            enemy(EM_06_HUNTER, EB_80, F_ENEMY_30A_HUNTER_2, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_02_HUNTER, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_06_HUNTER, EB_02, F_ENEMY_30A_HUNTER_1, SPAWN_FORCE, 2, 0, 2048, 0, 9270, 0, 3950, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
            enemy(EM_06_HUNTER, EB_02, F_ENEMY_30A_HUNTER_2, SPAWN_FORCE, 2, 0, 3072, 0, 3530, 0, 8280, ENEMY_02_HUNTER, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_ENRICO_SHOT, FALSE) && ck(FG_COMMON, F_COMMON_ENRICO_SEARCHED, FALSE))
        {
            aot_set(AOT_02_EVENT_ENRICO_SCENE, 10600, 1700, 1000, 6300, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, enrico_scene_jill, 0, 0, 0);
            aot_set(AOT_03_EVENT_ENRICO_BODY, 10400, 14800, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, search_enrico, 0, 0, 0);
            if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE))
            {
                enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 3060, 0, 19800, ENEMY_01_NPC_BARRY, ANIM_00, 0, EVAR_00);
                evt_exec(0, TASK_09, barry_follows);
                aot_reset(AOT_00_DOOR_309, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, leave_with_barry, 0);
            }
        }
        if (ck(FG_COMMON, F_COMMON_ENRICO_SHOT, TRUE) && ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE) && ck(FG_COMMON, F_COMMON_J_BACK_IN_308_AFTER_ENRICO, FALSE))
        {
            enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3024, 0, 11550, 0, 13650, ENEMY_01_NPC_BARRY, ANIM_09, 24, EVAR_00);
            aot_set(AOT_02_EVENT_BARRY_INVESTIGATING, 11000, 14000, 1500, 1500, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, barry_investigating, 0, 0, 0);
        }
        if (ck(FG_COMMON, F_COMMON_ENRICO_SEARCHED, FALSE) && ck(FG_COMMON, F_COMMON_ENRICO_SHOT, TRUE))
        {
            aot_set(AOT_03_EVENT_ENRICO_BODY, 10400, 14800, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, search_enrico, 0, 0, 0);
        }
        enemy(EM_28_NPC_ENRICO, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 824, 0, 10840, 0, 16490, ENEMY_00_NPC_ENRICO, ANIM_00, 59, EVAR_00);
    }
}

proc main
{
    if (CHRIS)
    {
        if (ck(FG_ROOM, F_ROOM_C_HUNTERS_PENDING, TRUE))
        {
            if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
            {
                set(FG_ROOM, F_ROOM_C_HUNTERS_PENDING, FALSE);
                pos_set(ENEMY_01_HUNTER, 0, 1024, 0, 4644, 0, 8920);
                pos_set(ENEMY_02_HUNTER, 0, 1024, 0, 5600, 0, 20000);
                eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, EB_08);
                eml_state(0, ENEMY_02_HUNTER, EML_BEHAVIOUR, EB_02);
            }
        }
    }
}
event enrico_scene_jill
{
    run
    {
        aot_delete(AOT_02_EVENT_ENRICO_SCENE, SCE_NONE, 0);
        aot_delete(AOT_09_ITEM_KEY_CRANK_HEXAGONAL_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
    }
    sleep(1);
    evt_work_set(WK_AOT, IMDL_01_KEY_CRANK_HEXAGONAL);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3830, 0, 11630);
    tw_abs_rot(0, 0, 1200, 0);
    tw_end();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_anim_flags(ANIM_02, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    run
    {
        set(FG_COMMON, F_COMMON_ENRICO_SHOT, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        cutnext(CAM_03);
        dir_set(0, 0, 3480, 0, 13220, 0, 4450);
    }
    run
    {
        if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE))
        {
            evt_exec(0, TASK_09, enrico_scene_barry_idle);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 15450, 6260, F_ROOM_PLAYER_WALK_DONE);
    act_nop();
    act_motion_path(MOTION_71, 600, 0, 2, 60, 0);
    act_reset();
    evt_nop();
    sleep(25);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 14530, 8520, F_ROOM_J_PLAYER_WALK_2_DONE);
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        voice_play(VOICE_PLAY, VO_10F_00);
        message(MSG_VO_10F_00, 0);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_WALK_2_DONE, FALSE));
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(55);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_27, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        voice_play(VOICE_PLAY, VO_10F_02);
        message(MSG_VO_10F_02, 0);
    }
    sleep(30);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_anim_flags(ANIM_02, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    evt_fork(TASK_09, enrico_scene_jill_walk, 0);
    wait_message();
    evt_fork(TASK_07, enrico_death_anim, 0);
    run
    {
        cutnext(CAM_05);
        if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE))
        {
            evt_exec(0, TASK_09, enrico_shot_chris_or_with_barry);
        }
        else
        {
            evt_exec(0, TASK_09, enrico_shot_jill_alone);
        }
    }
    evt_finish();
}

event enrico_shot_jill_alone
{
    run
    {
        voice_play(VOICE_PLAY, VO_10F_04);
        message(MSG_VO_10F_04, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(25);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_25, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_motion_path(MOTION_71, 600, 0, 1, 60, 0);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        voice_play(VOICE_PLAY, VO_10F_05);
        message(MSG_VO_10F_05, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 0, 1, 8, 0);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        cutnext(CAM_07);
    }
    run
    {
        voice_play(VOICE_PLAY, VO_10F_06);
        message(MSG_VO_10F_06, 0);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 0, 1, 8, 0);
    act_reset();
    evt_nop();
    sleep(65);
    evt_disable(TASK_07);
    sleep(15);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_GUN_PF, 0, SND_AT_POINT, 0, 14570, 8460);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0080);
    act_reset();
    evt_nop();
    sleep(5);
    run
    {
        effect(FX_00, FX_ROW_02, FX_AT_WORLD, 11000, -1000, 16300, 400);
    }
    sleep(10);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_19_YK_30A, 0, SND_AT_POINT, 0, 14570, 8460);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    for (5)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
        evt_actor_begin();
        act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, 0);
        act_flag_op(EF_SET, EF_0080);
        act_action_a(30);
        act_reset();
        evt_nop();
        sleep(3);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
        evt_actor_begin();
        act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, 0);
        act_flag_op(EF_SET, EF_0080 | EF_0001);
        act_action_a(32);
        act_reset();
        evt_nop();
        sleep(3);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
        evt_actor_begin();
        act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, 0);
        act_flag_op(EF_SET, EF_0080);
        act_action_a(33);
        act_reset();
        evt_nop();
        sleep(3);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
        evt_actor_begin();
        act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, 0);
        act_flag_op(EF_SET, EF_0080 | EF_0001);
        act_action_a(35);
        act_reset();
        evt_nop();
        sleep(2);
    }
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, 0);
    act_action_a(30);
    act_flag_op(EF_SET, EF_0080);
    act_reset();
    evt_nop();
    sleep(35);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_flag_op(EF_SET, 0);
    act_reset();
    evt_nop();
    sleep(20);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_1A_TAORE_CA, 0, SND_AT_PLAYER, 0, 0, 0);
    }
    sleep(35);
    evt_fork(TASK_09, shooter_footsteps, 0);
    wait_message();
    run
    {
        cutnext(CAM_05);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_motion_path(MOTION_31, -700, 0, 0, 50, 0);
    act_reset();
    evt_nop();
    sleep(70);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_flag_op(EF_OR, EF_0002 | EF_0001);
    act_reset();
    evt_nop();
    sleep(20);
    run
    {
        voice_play(VOICE_PLAY, VO_10F_07);
        message(MSG_VO_10F_07, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_motion_path(MOTION_71, 300, 0, 1, 40, 0);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        voice_play(VOICE_PLAY, VO_10F_08);
        message(MSG_VO_10F_08, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 300, 0, 0, 40);
    act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        cutnext(CAM_04);
    }
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event enrico_shot_chris_or_with_barry
{
    if (CHRIS)
    {
        run
        {
            aot_delete(AOT_02_EVENT_ENRICO_SCENE, SCE_NONE, 0);
            aot_delete(AOT_09_ITEM_KEY_CRANK_HEXAGONAL_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        sleep(1);
        evt_work_set(WK_AOT, IMDL_01_KEY_CRANK_HEXAGONAL);
        evt_tween_begin_alt();
        tw_abs_pos(0, 3830, 0, 11630);
        tw_abs_rot(0, 0, 1200, 0);
        tw_end();
        evt_nop();
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
