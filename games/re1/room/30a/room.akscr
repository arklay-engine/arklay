            evt_nop();
            sleep(18);
            evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
            evt_actor_begin();
            act_anim_flags(ANIM_03, F_ROOM_ANIM_DONE, 0);
            act_reset();
            evt_nop();
            sleep(13);
        }
    }
    else
    {
        for (30)
        {
            evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
            evt_actor_begin();
            act_anim_flags(ANIM_03, F_ROOM_ANIM_DONE, 0);
            act_reset();
            evt_nop();
            sleep(25);
            evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
            evt_actor_begin();
            act_anim_flags(ANIM_03, F_ROOM_ANIM_DONE, 0);
            act_reset();
            evt_nop();
            sleep(18);
            evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
            evt_actor_begin();
            act_anim_flags(ANIM_03, F_ROOM_ANIM_DONE, 0);
            act_reset();
            evt_nop();
            sleep(13);
        }
    }
    evt_nop();
    evt_finish();
}

event enrico_scene_barry_idle
{
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, 0);
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    sleep(10);
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

event search_enrico
{
    if (CHRIS)
    {
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_RUN, F_RUN_MONSTERS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            cutnext(CAM_05);
        }
    }
    else
    {
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        }
        sleep(20);
        run
        {
            cutnext(CAM_05);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(25);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 500, 0, 1, 30, 0);
    act_reset();
    evt_nop();
    message(MSG_HE_COULD_NOT_HAVE_MOVED_BECAUSE_HE_IS_HOLDING_SOMETHING_06, 0); // "He couldn't have moved because of this injury... He's holding something."
    wait_message();
    if (CHRIS)
    {
        evt_chain(search_enrico_take_rounds);
    }
    else
    {
        evt_chain(search_enrico_take_rounds);
    }
    evt_finish();
}

event unused_empty
{
    evt_finish();
}

event search_enrico_take_rounds
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_on(AOT_01_ITEM_AMMO_HANDGUN_0, SCE_ITEM, 0);
    }
    evt_next();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_04);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ITEM, F_ITEM_30A_AMMO_HANDGUN_0, FALSE))
        {
            aot_delete(AOT_03_EVENT_ENRICO_BODY, SCE_NONE, 0);
            set(FG_COMMON, F_COMMON_ENRICO_SEARCHED, TRUE);
        }
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        if (CHRIS)
        {
            set(FG_RUN, F_RUN_MONSTERS, TRUE);
        }
    }
    evt_finish();
}

event barry_follows
{
    sleep(5);
    run
    {
        eml_state(0, ENEMY_01_NPC_BARRY, EML_08);
    }
    evt_finish();
}

event leave_with_barry
{
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_FROM_30A, TRUE);
        aot_on(AOT_00_DOOR_309, SCE_DOOR, 0);
    }
    evt_finish();
}

event barry_investigating
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    sleep(20);
    message(MSG_BARRY_IS_INVESTIGATING | MSG_FAST, 0); // "Barry is investigating..."
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 0, 1, 30, 0);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event shooter_footsteps
{
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 12200);
    }
    sleep(9);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 10800);
    }
    sleep(10);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 9400);
    }
    sleep(9);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 8000);
    }
    sleep(10);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 6600);
    }
    sleep(9);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 5200);
    }
    sleep(10);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 3800);
    }
    sleep(9);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 2400);
    }
    if (CHRIS)
    {
        sleep(10);
        run
        {
            se_play_3d(SND_BANK_ROOM, SE_2D_FT_CAVEA, 0, SND_AT_POINT, 0, 10800, 1000);
        }
    }
    evt_finish();
}
