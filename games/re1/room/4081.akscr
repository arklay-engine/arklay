#version 1

proc init
{
    door_aot_set(0, 0, 2200, 3000, 2100, 0, 0, 0, 4, 0, RDT_005, 23200, 0, 8800, 2048, UNLOCKED, 129);
    door_aot_set(1, 5500, 9400, 3000, 1800, 1, 0, 7, 1, 0, RDT_009, 9000, 0, 3000, 2048, UNLOCKED, 129);
    door_aot_set(2, 18200, 6500, 3000, 2000, 1, 0, 6, 1, 170, RDT_00A, 2900, 0, 2800, 0, ITEM_DORM_KEY_003_, 129);
    if (ck(FG_SCENARIO, 68, 0))
    {
        door_aot_set(3, 27800, 2100, 3000, 4000, 12, 0, 0, 1, 0, RDT_00C, 3000, 0, 10200, 0, UNLOCKED, 129);
    }
    else
    {
        aot_set(3, 27800, 2100, 3000, 4000, SCE_MESSAGE, 129, 13, 0, 255, 0, 0, 0);
    }
    aot_set(4, 7200, 11000, 800, 800, SCE_USEITEM, 129, 0, 0, 32, 0, 1, 0);
    item_aot_set(5, 15000, 21700, 2000, 1000, ITEM_DORM_KEY_002_, 1, 0, 255, 0, 0, 0, 0, 0, 0, 0, 4, 72, 129, 0, 0);
    if (ck(FG_COMMON, 174, 0))
    {
        set(FG_COMMON, 177, 0);
    }
    set(FG_ROOM, 29, 0);
    aot_reset(1, SCE_MESSAGE, 129, 143, 255, 0);
    evt_exec(0, 9, event_00);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17600, -4000, 22700, 0, 0, 0, 0);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17600, -4000, 22700, 1, 0, 0, 0);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17600, -3500, 22600, 2, 0, 0, 0);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17700, -4000, 22700, 3, 0, 0, 0);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17800, -3500, 22800, 4, 0, 0, 0);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17900, -4000, 22800, 5, 0, 0, 0);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 18000, -3500, 22900, 6, 0, 0, 0);
    enemy(ENEMY_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 18000, -4000, 22900, 7, 0, 0, 0);
}

proc main
{
    if (ck(FG_SCENARIO, 33, 0))
    {
        aot_delete(1, SCE_DOOR, 129);
    }
    return;
}

event event_00
{
    evt_work_set(WK_AOT, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 15520, -1590, 22430);
    tw_abs_rot(0, 1020, 800, 64466);
    tw_end();
    evt_nop();
    evt_finish();
}

