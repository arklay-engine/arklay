event event_00
{
    sleep(1);
    set(FG_STATUS, 29, 0);
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        evt_exec(0, 9, event_07);
        se_play_3d(2, 24, 0, 0, 0, 11000, 17380);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 32, 1));
    se_play_3d(2, 24, 0, 0, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 23, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 32, 1));
