    {
        aot_set(AOT_02_C, 21500, 10323, 1500, 1800, SCE_C, SAT_MANUAL | SAT_PLAYER, 1, 0, 234, 86, 215, 43);
        aot_set(AOT_03_C, 21500, 24246, 1500, 1800, SCE_C, SAT_MANUAL | SAT_PLAYER, 0, 0, 234, 86, 58, 98);
    }
    else
    {
        aot_set(AOT_02_C, 21500, 10323, 1500, 1800, SCE_C, SAT_MANUAL | SAT_PLAYER, 0, 0, 234, 86, 215, 43);
        aot_set(AOT_03_C, 21500, 24246, 1500, 1800, SCE_C, SAT_MANUAL | SAT_PLAYER, 1, 0, 234, 86, 58, 98);
    }
    aot_set(AOT_04_USEITEM, 11000, 16700, 2200, 2500, SCE_USEITEM, SAT_PLAYER, 9, 0, 2, 0, 1, 0);
    aot_set(AOT_05_USEITEM, 11000, 16700, 2200, 2500, SCE_USEITEM, SAT_PLAYER, 4, 0, 33, 0, 1, 0);
    aot_set(AOT_06_MESSAGE, 12400, 17000, 800, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
