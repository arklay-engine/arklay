        set(FG_STATUS, F_STATUS_0F, FALSE);
        cut_auto(0);
        set(FG_SCENARIO, F_SCENARIO_2F, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event event_03
{
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        aot_delete(AOT_01_DOOR, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        message(MSG_THERE_IS_A_SQUARE_HOLE, 0); // "There's a square hole."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        aot_delete(AOT_04_USEITEM, SCE_USEITEM, SAT_PLAYER);
        aot_delete(AOT_05_USEITEM, SCE_USEITEM, SAT_PLAYER);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

