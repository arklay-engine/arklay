event event_10
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 0, 0 | 1);
    act_flag_op(0, 32, 0);
    act_param_set(0, 252);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 32, 1));
    message(130, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        aot_reset(2, SCE_C, 129, 1, 22250, 11223);
        aot_reset(3, SCE_C, 129, 0, 22250, 25146);
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
        cut_auto(0);
        set(FG_SCENARIO, 47, 0);
        set(FG_SCENARIO, 82, 0);
        room_bgm_state_set(2, 0, 24);
        room_bgm_state_set(2, 1, 24);
        room_bgm_state_set(2, 2, 24);
        room_bgm_state_set(2, 4, 24);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

