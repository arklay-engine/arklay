proc init
{
    door_aot_set(AOT_00_DOOR, 20800, 1000, 3300, 2400, 1, DOOR_SND_08_DR_GAT, DOOR_0F_MON, 64, 0, ROOM_300_FIRST_HOUSE_OUT, 23800, 0, 27500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
