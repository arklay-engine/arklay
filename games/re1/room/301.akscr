        eml_pos(OBJ_01, 0, 0, 0, 23880, 730, 19844);
        set(FG_ROOM, F_ROOM_01, FALSE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_2F, FALSE))
    {
        if (testitem(IT_1D_KEY_CRANK_SQUARE))
        {
            if (ck(FG_ROOM, F_ROOM_21, TRUE))
            {
                evt_exec(0, TASK_07, from_main);
                dir_set(0, 0, 3072, 0, 11942, 0, 16500);
            }
        }
    }
    else if (testitem(IT_1D_KEY_CRANK_SQUARE))
    {
        if (ck(FG_ROOM, F_ROOM_21, TRUE))
        {
            evt_exec(0, TASK_07, from_main_2);
            dir_set(0, 0, 3072, 0, 11842, 0, 16686);
        }
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
    {
        if (ck(FG_ROOM, F_ROOM_0A, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_2F, FALSE))
            {
