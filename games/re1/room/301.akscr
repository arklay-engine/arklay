        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    run
    {
        se_play_3d(2, 25, 0, 2, 0, 12700, 17700);
    }
    evt_work_set(WK_OBJ, 5);
    evt_tween_begin_alt();
    tw_set_pos(0, 64, 0);
    for (50)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        snd_pan_vol_set(2, 45, 35);
        bgm_play(2);
    }
    sleep(3);
    run
    {
        bgm_stop(1);
    }
    set(FG_STATUS, FLAG_STATUS_11, TRUE);
    evt_work_set(WK_OBJ, 6);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, FLAG_ROOM_01, TRUE);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        cut_auto(0);
        set(FG_SCENARIO, FLAG_SCENARIO_2F, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event event_03
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        aot_delete(AOT_01_DOOR, SCE_NONE, 129);
        message(0, 0); // "There's a square hole."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        aot_delete(AOT_04_USEITEM, SCE_USEITEM, 1);
        aot_delete(AOT_05_USEITEM, SCE_USEITEM, 1);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

