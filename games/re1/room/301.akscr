        spd_set(0, 196, 9);
        evt_exec(0, TASK_09, on_enter_2);
        cutnext(CAM_07);
        snd_pan_vol_set(BGM_SUB_1, 60, 45);
    }
    else
    {
        snd_pan_vol_set(BGM_SUB_1, 30, 30);
    }
    enemy(EM_0A_ADDER, 1, 255, 1, 1, 0, 0, 1024, 0, 0, 19000, 0, 27000, ENEMY_00_ADDER, 0, 0, 0);
    enemy(EM_0A_ADDER, 1, 255, 1, 1, 0, 0, 1024, 0, 0, 15000, 0, 27000, ENEMY_01_ADDER, 0, 0, 0);
