        evt_exec(0, 9, on_aot_07_sub2);
        se_play_3d(2, 33, 0, 0, 0, 3000, 11300);
        sys_multi(1, 128);
    }
    sleep(70);
    timer_setup(2, 128, 8, 7, 0);
    sleep(7);
    run
    {
        setw(2, 0, 0);
        aot_on(AOT_01_DOOR, SCE_DOOR, 129);
        set(FG_SCENARIO, FLAG_SCENARIO_30, TRUE);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}

