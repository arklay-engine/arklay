    enemy(EM_0A_ADDER, 1, 255, 1, 1, 0, 0, 1024, 0, 0, 10000, 0, 26000, ENEMY_03_ADDER, 0, 0, 0);
    enemy(EM_0A_ADDER, 1, 255, 1, 1, 0, 0, 4072, 0, 0, 8000, 0, 23800, ENEMY_04_ADDER, 0, 0, 0);
    enemy(EM_0A_ADDER, 1, 255, 1, 1, 0, 0, 0, 0, 0, 3200, 0, 20000, ENEMY_05_ADDER, 0, 0, 0);
    enemy(EM_0A_ADDER, 1, 255, 1, 1, 0, 0, 0, 0, 0, 2200, 0, 16000, ENEMY_06_ADDER, 0, 0, 0);
