event on_enter
{
    sleep(1);
    set(FG_STATUS, F_STATUS_1D, TRUE);
    evt_finish();
}

event from_main
{
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        evt_exec(0, TASK_09, from_main_sub1);
        se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 23, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 23, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    run
    {
        bgm_stop_all(0);
        objtbl_b_set(0, 0, 128);
        objtbl_b_set(0, 1, 128);
        eml_pos(5, 0, 0, 0, 0, 0, 0, 24, 51, 78, 1, 248, 77);
        dir_set(0, 0, 3072, 0, 12700, 0, 16700);
        movie_on(MOVIE_0D_DMD);
    }
    sleep(1);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 45, 35);
        bgm_play(BGM_SUB_1);
        set(FG_STATUS, F_STATUS_11, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_02);
    evt_tween_begin_alt();
    tw_abs_pos(0, 12390, 314, 19540);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_06);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    sleep(1);
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_52, FALSE))
        {
            evt_exec(0, TASK_09, from_main_sub2);
        }
        else
        {
            evt_exec(0, TASK_09, from_main_sub3);
        }
    }
    evt_finish();
}

event from_main_2
{
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        evt_exec(0, TASK_09, from_main_sub1);
        se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    }
    do
    {
