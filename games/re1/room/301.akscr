            set(FG_ROOM, F_ROOM_0B, FALSE);
            set(FG_ROOM, F_ROOM_0C, FALSE);
            set(FG_ROOM, F_ROOM_0D, FALSE);
            set(FG_ROOM, F_ROOM_0E, FALSE);
            set(FG_ROOM, F_ROOM_0F, FALSE);
            set(FG_ROOM, F_ROOM_10, FALSE);
            set(FG_ROOM, F_ROOM_11, TRUE);
            if (ck(FG_SCENARIO, F_SCENARIO_30, FALSE))
            {
                objtbl_b_set(TBL_OBJ, OBJ_07, OF_80 | OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
            }
        }
    }
}

event on_enter
{
    sleep(1);
    set(FG_STATUS, F_STATUS_1D, TRUE);
    evt_finish();
}

event from_main
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        evt_exec(0, TASK_09, from_main_sub1);
        se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_37, F_ROOM_20, AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_37, F_ROOM_20, AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    run
    {
        bgm_stop_all(0);
        objtbl_b_set(TBL_OBJ, OBJ_00, OF_80);
        objtbl_b_set(TBL_OBJ, OBJ_01, OF_80);
        eml_pos(OBJ_05, 0, 0, 0, 13080, 334, 19960);
        dir_set(0, 0, 3072, 0, 12700, 0, 16700);
        movie_on(MOVIE_0D_DMD);
    }
    sleep(1);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 45, 35);
        bgm_play(BGM_SUB_1);
        set(FG_STATUS, F_STATUS_11, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_02);
    evt_tween_begin_alt();
    tw_abs_pos(0, 12390, 314, 19540);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_06);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    sleep(1);
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_52, FALSE))
        {
            evt_exec(0, TASK_09, from_main_sub2);
        }
        else
        {
            evt_exec(0, TASK_09, from_main_sub3);
        }
    }
    evt_finish();
}

event from_main_2
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        evt_exec(0, TASK_09, from_main_sub1);
        se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_37, F_ROOM_20, AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    se_play_3d(SND_BANK_ROOM, SE_18_CRANK, 0, SND_AT_POINT, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_37, F_ROOM_20, AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_19_WATERGT, 0, SND_AT_ENEMY, ENEMY_00_ADDER, 12700, 17700);
    }
    evt_work_set(WK_OBJ, OBJ_05);
    evt_tween_begin_alt();
    tw_set_pos(0, 64, 0);
    for (50)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        snd_pan_vol_set(BGM_SUB_2, 45, 35);
        bgm_play(BGM_SUB_2);
    }
    sleep(3);
    run
    {
        bgm_stop(BGM_SUB_1);
    }
    set(FG_STATUS, F_STATUS_11, TRUE);
    evt_work_set(WK_OBJ, OBJ_06);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, F_ROOM_01, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        cut_auto(CUT_FREE);
        set(FG_SCENARIO, F_SCENARIO_2F, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event event_03
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        aot_delete(AOT_01_DOOR, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        message(MSG_THERE_IS_A_SQUARE_HOLE, 0); // "There's a square hole."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        aot_delete(AOT_04_USEITEM, SCE_USEITEM, SAT_PLAYER);
        aot_delete(AOT_05_USEITEM, SCE_USEITEM, SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

