proc main
{
    if (ck(FG_ROOM, F_ROOM_01, TRUE))
    {
        dir_set(0, 0, 3072, 0, 12700, 0, 16700);
        bgm_stop(BGM_SUB_1);
        aot_reset(AOT_02_C, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
        aot_reset(AOT_03_C, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
        room_bgm_state_set(2, ROOM_300_FIRST_HOUSE_OUT, BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_301_WATER_GATE, BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_302_FALLS, BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_304_SECOND_HOUSE_GATE, BGM_MAIN_ON);
        objtbl_b_set(TBL_OBJ, OBJ_00, OF_ACTIVE);
        objtbl_b_set(TBL_OBJ, OBJ_01, OF_ACTIVE);
