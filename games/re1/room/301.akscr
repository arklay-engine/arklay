event from_main_sub2
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 0, 0 | 1);
    act_flag_op(0, 32, 0);
    act_param_set(0, 252);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    message(130, 0); // "The water is running down the opposite side."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        aot_reset(AOT_02_C, SCE_C, 129, 1, 22250, 11223);
        aot_reset(AOT_03_C, SCE_C, 129, 0, 22250, 25146);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        cut_auto(0);
        set(FG_SCENARIO, FLAG_SCENARIO_2F, TRUE);
        set(FG_SCENARIO, FLAG_SCENARIO_52, TRUE);
        room_bgm_state_set(2, 0, 24);
        room_bgm_state_set(2, 1, 24);
        room_bgm_state_set(2, 2, 24);
        room_bgm_state_set(2, 4, 24);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

