event on_enter
{
    sleep(1);
    set(FG_STATUS, FLAG_STATUS_1D, TRUE);
    evt_finish();
}

event from_main
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        evt_exec(0, 9, from_main_sub1);
        se_play_3d(2, 24, 0, 0, 0, 11000, 17380);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    se_play_3d(2, 24, 0, 0, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 23, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    se_play_3d(2, 24, 0, 0, 0, 11000, 17380);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 23, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    run
    {
        bgm_stop_all(0);
        objtbl_b_set(0, 0, 128);
        objtbl_b_set(0, 1, 128);
        eml_pos(5, 0, 0, 0, 0, 0, 0, 24, 51, 78, 1, 248, 77);
        dir_set(0, 0, 3072, 0, 12700, 0, 16700);
        movie_on(13);
    }
    sleep(1);
    run
    {
        snd_pan_vol_set(1, 45, 35);
        bgm_play(1);
        set(FG_STATUS, FLAG_STATUS_11, TRUE);
    }
    evt_work_set(WK_OBJ, 2);
    evt_tween_begin_alt();
    tw_abs_pos(0, 12390, 314, 19540);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, 6);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    sleep(1);
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_52, FALSE))
        {
            evt_exec(0, 9, from_main_sub2);
        }
        else
        {
            evt_exec(0, 9, from_main_sub3);
        }
    }
    evt_finish();
}

