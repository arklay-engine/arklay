event from_main_sub2
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 0, 0 | 1);
    act_flag_op(0, 32, 0);
    act_param_set(0, 252);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    message(MSG_THE_WATER_IS_RUNNING_DOWN_THE | MSG_FAST, 0); // "The water is running down the opposite side."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        aot_reset(AOT_02_C, SCE_C, SAT_MANUAL | SAT_PLAYER, 1, 22250, 11223);
        aot_reset(AOT_03_C, SCE_C, SAT_MANUAL | SAT_PLAYER, 0, 22250, 25146);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        cut_auto(0);
        set(FG_SCENARIO, F_SCENARIO_2F, TRUE);
        set(FG_SCENARIO, F_SCENARIO_52, TRUE);
        room_bgm_state_set(2, ROOM_300_FIRST_HOUSE_OUT, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_301_WATER_GATE, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_302_FALLS, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_304_SECOND_HOUSE_GATE, BGM_SUB_1_ON | BGM_MAIN_ON);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

