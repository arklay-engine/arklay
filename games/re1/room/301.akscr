        snd_pan_vol_set(1, 45, 35);
        bgm_play(1);
        set(FG_STATUS, 17, 0);
    }
    evt_work_set(WK_OBJ, 2);
    evt_tween_begin_alt();
    tw_abs_pos(0, 12390, 314, 19540);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, 6);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    sleep(1);
    run
    {
        if (ck(FG_SCENARIO, 82, 1))
        {
            evt_exec(0, 9, event_10);
        }
        else
        {
            evt_exec(0, 9, event_11);
        }
