    <language lang="en-US">
      <string key="name">ROOM 001 BATHROOM</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">{scroll 2}The bathtub is filled with\nmuddy water.{clear 0}{scroll 2}Will you unplug it?{branch 0 1 1}\nNothing special.</string>
      <string key="1">\nNothing special.</string>
      <string key="2">\nNothing major.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 2}\nにごった水がバスタブにたまっている{clear 0}{scroll 2}せんを抜きますか?{branch 0 1 1}\n      特に何もない</string>
      <string key="1">\n      特に何もない</string>
      <string key="2">\n     何もないようだ</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Poste de garde RdC</string>
      <string key="0">{scroll 2}La baignoire est remplie\nd'eau boueuse.{clear 0}{scroll 2}La vider?{branch 0 6 1}</string>
      <string key="1">\nRien de spécial.</string>
      <string key="2">\nRien d'important.</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Die Badewanne ist voll\nmit dreckigem Wasser.{clear 0}{scroll 2}Möchen Sie den Stöpsel ziehen?{branch 0 6 1}</string>
      <string key="1">\nNichts Besonderes.</string>
      <string key="2">\nNichts von Bedeutung.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Guardiola 1P</string>
