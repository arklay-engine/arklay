      <string key="1">\nNiente di speciale.</string>
      <string key="2">\nNiente di importante.</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}La bañera está llena\nde agua turbia...{clear 0}{scroll 2}¿Quieres vaciarla?{branch 0 6 1}</string>
      <string key="1">\nNada especial...</string>
