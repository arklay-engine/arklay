#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_401 0x00
#define AOT_01_ITEM_KEY_CONTROL_ROOM_0 0x01
#define AOT_03_EVENT_BATHTUB 0x03
#define AOT_04_MESSAGE_NOTHING 0x04                         // "Nothing special."
#define AOT_05_MESSAGE_NOTHING_MAJOR 0x05                   // "Nothing major."
#define CAM_00 0x00
#define CAM_01_BATHTUB 0x01
#define F_ROOM_BATHTUB_ANSWERED 0x18                        // The unplug question was answered.
#define F_ROOM_BATHTUB_UNPLUG 0x19                          // The answer was to unplug the bathtub.
#define F_ROOM_WATER_FOLLOWS_CAMERA 0x1A                    // Main swaps the water models on camera changes (off during the bathtub event).
#define IMDL_00_KEY_CONTROL_ROOM 0x00
#define MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY 0x00
#define OBJ_00_BATH_WATER 0x00                              // The muddy water's surface, as camera 0 shows it.
#define OBJ_01_BATH_WATER_CLOSEUP 0x01                      // The water's surface in the bathtub close-up; it sinks when drained.
#define SE_17_BATHMIX 0x17

proc init
{
    door_aot_set(AOT_00_DOOR_401, 6600, 2000, 2100, 2300, 2, DOOR_SND_00_DR_WD, DOOR_21_DOOR15, 1, 0, ROOM_401_ROOM_001, 9200, 0, 3200, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM_KEY_CONTROL_ROOM_0, 1300, 2100, 2400, 3200, IT_3B_KEY_CONTROL_ROOM, 1, IMDL_00_KEY_CONTROL_ROOM, SCA_NONE, 2570, -560, 3870, 246, F_ITEM_402_KEY_CONTROL_ROOM_0, SAT_MANUAL | SAT_PLAYER, 0);
    eml_rot(IMDL_00_KEY_CONTROL_ROOM, 0, 2048);
    obj(OBJ_00_BATH_WATER, OF_ACTIVE, SCA_NONE, 21000, 0, 21000, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_01_BATH_WATER_CLOSEUP, OF_ACTIVE, SCA_NONE, 20000, 0, 20000, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_03_EVENT_BATHTUB, 1300, 2100, 2400, 3200, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_bathtub, 0, 0, 0);
    aot_set(AOT_04_MESSAGE_NOTHING, 4800, 700, 1500, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_05_MESSAGE_NOTHING_MAJOR, 2000, 6400, 2000, 1600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
    set(FG_ROOM, F_ROOM_WATER_FOLLOWS_CAMERA, TRUE);
    if (ck(FG_SCENARIO, F_SCENARIO_402_BATHTUB_DRAINED, FALSE))
    {
        aot_delete(AOT_01_ITEM_KEY_CONTROL_ROOM_0, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_03_EVENT_BATHTUB, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        evt_exec(0, TASK_09, show_water_far);
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_BATHTUB_ANSWERED, TRUE))
    {
        set(FG_ROOM, F_ROOM_BATHTUB_ANSWERED, FALSE);
        if (ck(FG_ROOM, F_ROOM_BATHTUB_UNPLUG, TRUE))
        {
            set(FG_ROOM, F_ROOM_BATHTUB_UNPLUG, FALSE);
            evt_exec(0, TASK_09, drain_bathtub);
        }
        else
        {
            evt_exec(0, TASK_09, leave_bathtub_plugged);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_402_BATHTUB_DRAINED, FALSE) && ck(FG_ROOM, F_ROOM_WATER_FOLLOWS_CAMERA, TRUE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_00) && ck(FG_STATUS, F_STATUS_CAMERA_REDRAW, TRUE))
        {
            evt_exec(0, TASK_09, show_water_far);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_01_BATHTUB) && ck(FG_STATUS, F_STATUS_CAMERA_REDRAW, TRUE))
        {
            evt_exec(0, TASK_09, show_water_closeup);
        }
    }
}

event show_water_far
{
    evt_work_set(WK_OBJ, OBJ_00_BATH_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 2580, -1610, 4580);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_01_BATH_WATER_CLOSEUP);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_finish();
}

event show_water_closeup
{
    evt_work_set(WK_OBJ, OBJ_01_BATH_WATER_CLOSEUP);
    evt_tween_begin_alt();
    tw_abs_pos(0, 2600, -680, 3680);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_00_BATH_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 20000, 0, 20000);
    tw_finish();
}

event examine_bathtub
{
    run
    {
        set(FG_ROOM, F_ROOM_WATER_FOLLOWS_CAMERA, FALSE);
        cut_auto(CUT_LOCKED);
    }
    evt_work_set(WK_OBJ, OBJ_01_BATH_WATER_CLOSEUP);
    evt_tween_begin_alt();
    tw_abs_pos(0, 2600, -680, 3680);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_00_BATH_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 20000, 0, 20000);
    tw_end();
    evt_nop();
    run
    {
        aot_delete(AOT_03_EVENT_BATHTUB, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        cutnext(CAM_01_BATHTUB);
    }
    evt_next();
    evt_nop();
    sleep(15);
    run
    {
        message(MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "The bathtub is filled with muddy water. Will you unplug it? Nothing special."
    }
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_ROOM, F_ROOM_BATHTUB_ANSWERED, TRUE);
        require(cmpb(B_MENU_CHOICE, CMP_EQ, 0));
        set(FG_ROOM, F_ROOM_BATHTUB_UNPLUG, TRUE);
    }
    evt_finish();
}

event drain_bathtub
{
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_BATHMIX, 0, SND_AT_POINT, 0, 2400, 3800);
        set(FG_SCENARIO, F_SCENARIO_402_BATHTUB_DRAINED, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_01_BATH_WATER_CLOSEUP);
    evt_tween_begin_alt();
    tw_set_pos(0, 1, 0);
    for (15)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    for (60)
    {
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 2, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
    }
    tw_end();
    sleep(30);
    set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    evt_work_set(WK_OBJ, OBJ_01_BATH_WATER_CLOSEUP);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, F_ROOM_WATER_FOLLOWS_CAMERA, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        cut_auto(CUT_FREE);
    }
    sleep(3);
    run
    {
        aot_delete(AOT_01_ITEM_KEY_CONTROL_ROOM_0, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
    }
    evt_finish();
}

event leave_bathtub_plugged
{
    sleep(20);
    run
    {
        set(FG_ROOM, F_ROOM_WATER_FOLLOWS_CAMERA, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        cut_auto(CUT_FREE);
    }
    sleep(3);
    run
    {
        aot_delete(AOT_03_EVENT_BATHTUB, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    evt_finish();
}
