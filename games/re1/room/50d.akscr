#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define F_ROOM_18 0x18
#define MSG_VO_016_06 0x00
#define SE_17_ESCELV 0x17
#define VO_016_06 0x52

proc init
{
    set(FG_STATUS, F_STATUS_3D, TRUE);
    door_aot_set(AOT_00_DOOR, 0, 0, 1, 1, 1, DOOR_SND_0D_EV_LAB, DOOR_11_ELE01, 64, 0, ROOM_501_HELIPORT_PASSAGE, 3500, 0, 28000, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 0, 0, 1, 1, 1, DOOR_SND_0D_EV_LAB, DOOR_11_ELE01, 64, 0, STAGE_3 | ROOM_303_HELIPORT, 9000, 0, 5500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    dir_set(0, 0, 2048, 0, 4600, 0, 4600);
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_501_HELIPORT_PASSAGE))
    {
        evt_exec(0, TASK_09, on_enter_2);
    }
    else
    {
        evt_exec(0, TASK_09, on_enter);
    }
}

event on_enter
{
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    se_play_3d(SND_BANK_ROOM, SE_17_ESCELV, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_fork(TASK_09, on_enter_sub1, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_18, FALSE));
    run
    {
        set(FG_6, F_6_17, TRUE);
        aot_on(AOT_00_DOOR, SCE_DOOR, 0);
    }
    evt_finish();
}

event on_enter_2
{
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    se_play_3d(SND_BANK_ROOM, SE_17_ESCELV, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_fork(TASK_09, on_enter_sub1, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_18, FALSE));
    run
    {
        set(FG_6, F_6_17, TRUE);
        aot_on(AOT_01_DOOR, SCE_DOOR, 0);
    }
    evt_finish();
}

event on_enter_sub1
{
    sleep(5);
    set(FG_STATUS, F_STATUS_3E, TRUE);
    sleep(10);
    set(FG_STATUS, F_STATUS_3E, FALSE);
    sleep(220);
    set(FG_STATUS, F_STATUS_3E, TRUE);
    sleep(8);
    set(FG_STATUS, F_STATUS_3E, FALSE);
    sleep(7);
    set(FG_STATUS, F_STATUS_3E, TRUE);
    sleep(5);
    set(FG_STATUS, F_STATUS_3E, FALSE);
    sleep(60);
    set(FG_ROOM, F_ROOM_18, TRUE);
    evt_finish();
}

event event_03
{
    sleep(30);
    voice_play(VOICE_PLAY, VO_016_06, 0);
    sleep(30);
    message(MSG_VO_016_06, 0);
    evt_finish();
}
