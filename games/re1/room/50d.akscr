#version 1

proc init
{
    set(FG_STATUS, 61, 0);
    door_aot_set(0, 0, 0, 1, 1, 1, 13, 17, 64, 0, RDT_001, 3500, 0, 28000, 0, UNLOCKED, 129);
    door_aot_set(1, 0, 0, 1, 1, 1, 13, 17, 64, 0, RDT_303, 9000, 0, 5500, 0, UNLOCKED, 129);
    dir_set(0, 0, 2048, 0, 4600, 0, 4600);
    if (cmpb(3, 0, 1))
    {
        evt_exec(0, 9, event_01);
    }
    else
    {
        evt_exec(0, 9, event_00);
    }
}

event event_00
{
    sleep(1);
    set(FG_6, 23, 1);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 24, 1));
    run
    {
        set(FG_6, 23, 0);
        aot_on(0, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_01
{
    sleep(1);
    set(FG_6, 23, 1);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 24, 1));
    run
    {
        set(FG_6, 23, 0);
        aot_on(1, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_02
{
    sleep(5);
    set(FG_STATUS, 62, 0);
    sleep(10);
    set(FG_STATUS, 62, 1);
    sleep(220);
    set(FG_STATUS, 62, 0);
    sleep(8);
    set(FG_STATUS, 62, 1);
    sleep(7);
    set(FG_STATUS, 62, 0);
    sleep(5);
    set(FG_STATUS, 62, 1);
    sleep(60);
    set(FG_ROOM, 24, 0);
    evt_finish();
}

event event_03
{
    sleep(30);
    voice_play(1, 82, 0);
    sleep(30);
    message(0, 0);
    evt_finish();
}
