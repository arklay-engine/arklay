}

event rebecca_works_activator_look
{
    if (CHRIS)
    {
        evt_fork(TASK_09, rebecca_works_activator_look_turn, 0);
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_fork(TASK_09, rebecca_works_activator_look_turn, 0);
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_2A, F_ROOM_OPERATOR_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0010);
    sleep(260);
    act_idle();
    act_reset();
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, TRUE);
    evt_finish();
}

event rebecca_works_activator_look_turn
{
    sleep(60);
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 100, 75);
    sleep(200);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_finish();
}

event rebecca_works_activator_step
{
    if (CHRIS)
    {
        evt_fork(TASK_09, rebecca_works_activator_step_move, 0);
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_fork(TASK_09, rebecca_works_activator_step_move, 0);
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_OPERATOR_ANIM_DONE, 0);
    act_flag_op(EF_SET, 0);
    sleep(11);
    act_idle();
    act_nop();
    sleep(100);
    act_idle();
    act_reset();
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, TRUE);
    evt_finish();
}

event rebecca_works_activator_step_move
{
    sleep(6);
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_motion_path(MOTION_71, 600, 0, 2, 150, 75);
    sleep(100);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_finish();
}

event rebecca_works_activator_idle
{
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_OPERATOR_ANIM_DONE, 0);
    act_flag_op(EF_SET, 0);
    sleep(25);
    sleep(30);
    act_idle();
    act_reset();
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, TRUE);
    evt_finish();
}
