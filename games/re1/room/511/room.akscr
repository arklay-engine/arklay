event rebecca_works_activator_tap
{
    se_play_3d(SND_BANK_ROOM, SE_17_PANEL02, 0, SND_AT_POINT, 0, 6500, 4100);
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_OPERATOR_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0001);
    act_action_a(11);
    sleep(2);
    act_idle();
    act_nop();
    sleep(2);
    act_anim_flags(ANIM_24, F_ROOM_OPERATOR_ANIM_DONE, 0);
    act_flag_op(EF_SET, 0);
    act_action_a(6);
    sleep(2);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, TRUE);
    evt_finish();
}

event rebecca_works_activator_pause
{
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_OPERATOR_ANIM_DONE, 0);
    act_flag_op(EF_SET, 0);
    sleep(15);
    act_idle();
    act_reset();
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, TRUE);
    evt_finish();
}

event rebecca_works_activator_reach
{
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_WESKER);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_OPERATOR_ANIM_DONE, 0);
    act_flag_op(EF_SET, 0);
