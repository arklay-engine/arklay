event on_enter_3_sub1
{
    se_play_3d(SND_BANK_ROOM, SE_17_PANEL02, 0, SND_AT_POINT, 0, 6500, 4100);
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_WESKER);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_18, 0);
    act_flag_op(EF_SET, EF_0001);
    act_action_a(11);
    sleep(2);
    act_idle();
    act_nop();
    sleep(2);
    act_anim_flags(ANIM_24, F_ROOM_18, 0);
    act_flag_op(EF_SET, 0);
    act_action_a(6);
    sleep(2);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_ROOM, F_ROOM_19, TRUE);
    evt_finish();
}

