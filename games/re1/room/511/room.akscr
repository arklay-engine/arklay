#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_510 0x00
#define AOT_01_MESSAGE_ELEVATOR_POWER_SWITCH 0x01
#define AOT_02_MESSAGE_ACTIVATOR 0x02                       // The self-destruct triggering system activator.
#define AOT_03_MESSAGE_REBECCA_AT_ACTIVATOR 0x03            // Chris: "Rebecca is activating the triggering device."
#define AOT_03_MESSAGE_WESKER_BODY 0x03                     // Jill: "What a miserable death..."
#define ENEMY_00_REBECCA 0x00
#define ENEMY_00_WESKER 0x00
#define ENEMY_01_CHIMERA 0x01
#define FX_1F 0x1F
#define F_ROOM_OPERATOR_ANIM_DONE 0x18                      // Rebecca's (Wesker's in the Jill branches) animation at the activator finished; never waited on.
#define F_ROOM_OPERATOR_STEP_DONE 0x19                      // One step of Rebecca's work at the activator finished.
#define MSG_A_POWER_CONNECTION_SWITCH 0x03
#define MSG_THE_POWER_FOR_THE_ELEVATOR_IS 0x06
#define MSG_THE_POWER_IS_NOT_SUPPLIED_TO 0x04
#define SE_17_PANEL02 0x17
#define SE_18_STEAM_A 0x18

proc init
{
    door_aot_set(AOT_00_DOOR_510, 11300, 15800, 3000, 2900, 12, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, 0, ROOM_510_MAZE_B, 12200, 0, 2500, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_MESSAGE_ELEVATOR_POWER_SWITCH, 17700, 8300, 2100, 1600, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 0, 0, 0, 0);
    aot_set(AOT_02_MESSAGE_ACTIVATOR, 5800, 4400, 2100, 1700, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 0, 0, 0, 0);
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_50C_SCENE, TRUE) && ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, FALSE))
        {
            aot_set(AOT_03_MESSAGE_REBECCA_AT_ACTIVATOR, 6000, 3600, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 135, 0, 69, 0, 0, 0);
            enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 6500, 0, 4100, ENEMY_00_REBECCA, ANIM_20, 1, EVAR_00);
            evt_exec(0, TASK_09, rebecca_works_activator);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, FALSE) && ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, TRUE) && ck(FG_SCENARIO, F_SCENARIO_TYRANT_1_DEAD, TRUE))
        {
            aot_set(AOT_03_MESSAGE_WESKER_BODY, 8500, 3226, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 71, 0, 0, 0);
            enemy(EM_24_NPC_WESKER, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 2000, 0, 9000, 0, 3726, ENEMY_00_WESKER, ANIM_00, 0, EVAR_00);
            enemy(EM_09_CHIMERA, EB_03, F_ENEMY_511_CHIMERA_1, SPAWN_FORCE, 2, 0, 2048, 0, 10600, 0, 4000, ENEMY_01_CHIMERA, ANIM_00, 0, EVAR_00);
        }
    }
    evt_exec(0, TASK_09, steam_jet_1);
    evt_exec(0, TASK_09, steam_jet_2);
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, TRUE))
    {
        aot_reset(AOT_02_MESSAGE_ACTIVATOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 69, 0);
    }
    else
    {
        aot_reset(AOT_02_MESSAGE_ACTIVATOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 69, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_ELEVATOR_POWER_CONNECTED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_POWER_PANEL_ON, TRUE))
    {
        aot_reset(AOT_01_MESSAGE_ELEVATOR_POWER_SWITCH, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 134, 69, 0);
    }
    else if (ck(FG_SCENARIO, F_SCENARIO_ELEVATOR_POWER_CONNECTED, FALSE))
    {
        aot_reset(AOT_01_MESSAGE_ELEVATOR_POWER_SWITCH, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, elevator_power_switch, 0);
    }
    else
    {
        aot_reset(AOT_01_MESSAGE_ELEVATOR_POWER_SWITCH, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 69, 0);
    }
}

event elevator_power_switch
{
    run
    {
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_A_POWER_CONNECTION_SWITCH | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_ENTITIES); // "A power connection switch. The elevator power is off. Will you connect it? The power isn't supplied to the elevator."
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(15);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, elevator_power_switch_connect);
            set(FG_SCENARIO, F_SCENARIO_ELEVATOR_POWER_CONNECTED, TRUE);
        }
    }
    run
    {
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event elevator_power_switch_connect
{
    run
    {
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    sleep(10);
    se_play_3d(SND_BANK_ROOM, SE_17_PANEL02, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(10);
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_POWER_PANEL_ON, TRUE))
        {
            message(MSG_THE_POWER_FOR_THE_ELEVATOR_IS | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_ENTITIES); // "The power for the elevator is activated as the power supply and the circuit have been connected."
        }
        else
        {
            message(MSG_THE_POWER_IS_NOT_SUPPLIED_TO | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_ENTITIES); // "The power isn't supplied to the elevator."
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event steam_jet_1
{
    sleep(119);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_18_STEAM_A, 0, SND_AT_POINT, 0, 6600, 11600);
    }
    for (8)
    {
        effect(FX_1F, FX_ROW_00, FX_AT_WORLD, 6600, -3900, 11600, 1980);
        sleep(3);
    }
    evt_nop();
    evt_chain(steam_jet_1);
    evt_finish();
}

event steam_jet_2
{
    sleep(240);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_18_STEAM_A, 0, SND_AT_POINT, 0, 13200, 5600);
    }
    for (8)
    {
        effect(FX_1F, FX_ROW_00, FX_AT_WORLD, 13200, -2500, 5600, 770);
        sleep(3);
    }
    evt_chain(steam_jet_2);
    evt_finish();
}

event rebecca_works_activator
