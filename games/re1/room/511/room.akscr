        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
        sleep(2);
    }
    evt_nop();
    sleep(30);
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE);
    if (CHRIS)
    {
        evt_fork(TASK_09, rebecca_works_activator_look, 0);
    }
    else
    {
        evt_fork(TASK_09, rebecca_works_activator_look, 0);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE);
    if (CHRIS)
    {
        evt_fork(TASK_09, rebecca_works_activator_pause, 0);
    }
    else
    {
        evt_fork(TASK_09, rebecca_works_activator_pause, 0);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
    sleep(1);
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE);
    if (CHRIS)
    {
        evt_fork(TASK_09, rebecca_works_activator_reach, 0);
    }
    else
    {
        evt_fork(TASK_09, rebecca_works_activator_reach, 0);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
    sleep(30);
    for (5)
    {
        set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE);
        if (CHRIS)
        {
            evt_fork(TASK_09, rebecca_works_activator_tap, 0);
        }
        else
        {
            evt_fork(TASK_09, rebecca_works_activator_tap, 0);
        }
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
    }
    evt_nop();
    sleep(10);
    for (3)
    {
        set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE);
        if (CHRIS)
        {
            evt_fork(TASK_09, rebecca_works_activator_tap, 0);
        }
        else
        {
            evt_fork(TASK_09, rebecca_works_activator_tap, 0);
        }
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
    }
    evt_nop();
    sleep(10);
    set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE);
    if (CHRIS)
    {
        evt_fork(TASK_09, rebecca_works_activator_tap, 0);
    }
    else
    {
        evt_fork(TASK_09, rebecca_works_activator_tap, 0);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
    sleep(10);
    for (3)
    {
        set(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE);
        if (CHRIS)
        {
            evt_fork(TASK_09, rebecca_works_activator_tap, 0);
        }
        else
        {
            evt_fork(TASK_09, rebecca_works_activator_tap, 0);
        }
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_OPERATOR_STEP_DONE, FALSE));
