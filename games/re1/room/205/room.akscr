    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 8600, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 7800, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 7500, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 8300, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 6800, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 7500, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 8200, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 7800, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 7000, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    single(12) effect(FX_08, FX_ROW_13, FX_AT_WORLD, 2800, -180, 8000, 0);
    evt_nop();
