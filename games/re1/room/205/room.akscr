#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_204 0x00
#define AOT_01_USEITEM_GAS_HOLE_W 0x01                      // Under-object spot over the west gas hole; raises F_ROOM_GAS_HOLE_W_COVERED.
#define AOT_02_USEITEM_GAS_HOLE_E 0x02                      // Under-object spot over the east gas hole; raises F_ROOM_GAS_HOLE_E_COVERED.
#define AOT_03_EVENT_SWITCH 0x03
#define AOT_04_MESSAGE_SHOWCASE 0x04
#define AOT_05_MESSAGE_ARMOR 0x05
#define AOT_06_MESSAGE_ARMOR 0x06
#define AOT_07_MESSAGE_GAS_HOLE_W 0x07                      // "A weird hole opens."
#define AOT_08_MESSAGE_GAS_HOLE_E 0x08                      // "A weird hole opens."
#define AOT_09_ITEM_KEY_CREST_SUN 0x09
#define CAM_01 0x01
#define CAM_02_SHOWCASE 0x02
#define CAM_03_SWITCH 0x03
#define FX_08 0x08
#define FX_09 0x09
#define F_ROOM_GAS_BGM_ON 0x1F                              // The gas music is playing.
#define F_ROOM_GAS_E_FLOWING 0x19                           // Gas is escaping from the east hole.
#define F_ROOM_GAS_HOLE_E_COVERED 0x21                      // An armor covers the east gas hole (raised each frame it stands there).
#define F_ROOM_GAS_HOLE_W_COVERED 0x20                      // An armor covers the west gas hole (raised each frame it stands there).
#define F_ROOM_GAS_RELEASED 0x1A                            // The switch let the gas out; uncovered holes leak.
#define F_ROOM_GAS_W_FLOWING 0x18                           // Gas is escaping from the west hole.
#define F_ROOM_PLAYER_ANIM_DONE 0x22                        // The player's animation finished (one frame).
#define F_ROOM_PLAYER_GAS_ANIM_DONE 0x24                    // The player's choking animation finished (one frame).
#define F_ROOM_SHOWCASE_OPEN 0x1B                           // The showcase is open.
#define F_ROOM_SHOWCASE_SCENE 0x1E                          // The showcase scene is running.
#define F_ROOM_SWITCH_PUSHED 0x1C                           // The player chose to push the switch.
#define F_ROOM_WATCH_ARMORS 0x1D                            // Showcase open: moving an armor off its hole now lets gas out.
#define IMDL_00_KEY_CREST_SUN 0x00
#define MSG_POISON_GAS_IS_ESCAPING 0x04
#define MSG_THERE_IS_A_SWITCH 0x00
#define OBJ_00_SHOWCASE 0x00                                // Likely: the showcase lid; it slides open.
#define OBJ_01_ARMOR_W 0x01
#define OBJ_02_ARMOR_E 0x02
#define SE_17_MACHA 0x17
#define SE_18_SHUTER 0x18
#define SE_PL_02 0x02
#define SPR_03 0x03

proc init
{
    door_aot_set(AOT_00_DOOR_204, 16400, 5800, 2000, 3000, 12, DOOR_SND_01_DR_MTL, DOOR_09_DOOR09, 5, 0, ROOM_204_C_PASSAGE, 18600, 0, 11300, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_USEITEM_GAS_HOLE_W, 4785, 6936, 700, 600, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 32, 0, 1, 0);
    aot_set(AOT_02_USEITEM_GAS_HOLE_E, 13635, 6936, 700, 600, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 33, 0, 1, 0);
    aot_set(AOT_03_EVENT_SWITCH, 9235, 6736, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_switch, 0, 0, 0);
    aot_set(AOT_04_MESSAGE_SHOWCASE, 1400, 6200, 2200, 2300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    aot_set(AOT_05_MESSAGE_ARMOR, 1000, 9300, 17400, 3300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    aot_set(AOT_06_MESSAGE_ARMOR, 1000, 2000, 18400, 3300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    aot_set(AOT_07_MESSAGE_GAS_HOLE_W, 4385, 6736, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE_GAS_HOLE_E, 13535, 6736, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    item_aot_set(AOT_09_ITEM_KEY_CREST_SUN, 1400, 6200, 2200, 2300, IT_2E_KEY_CREST_SUN, 1, IMDL_00_KEY_CREST_SUN, SCA_NONE, 2090, 0, 6590, 1024, F_ITEM_205_KEY_CREST_SUN_0, SAT_MANUAL | SAT_PLAYER, 0);
    obj(OBJ_00_SHOWCASE, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 2655, 0, 7220, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_01_ARMOR_W, OF_ACTIVE, SCA_NONE, 8795, 0, 7886, 2048, 0, 0, 0, 0, 450, 1980, 450, 450);
    obj(OBJ_02_ARMOR_E, OF_ACTIVE, SCA_NONE, 14035, 0, 6190, 0, 0, 0, 0, 0, 450, 1980, 450, 450);
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
    set(FG_ROOM, F_ROOM_GAS_HOLE_W_COVERED, TRUE);
    set(FG_ROOM, F_ROOM_GAS_HOLE_E_COVERED, TRUE);
    aot_delete(AOT_09_ITEM_KEY_CREST_SUN, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_COMMON, F_COMMON_RICHARD_FOUND, TRUE) && ck(FG_COMMON, F_COMMON_RICHARD_SCENE_OVER, TRUE) && ck(FG_COMMON, F_COMMON_RICHARD_SERUM_IN_TIME, TRUE))
    {
        set(FG_COMMON, F_COMMON_RICHARD_SCENE_LEFT, TRUE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_ARMOR_SHOWCASE_OPEN, TRUE))
    {
        set(FG_ROOM, F_ROOM_SHOWCASE_OPEN, TRUE);
        if (ck(FG_ITEM, F_ITEM_205_KEY_CREST_SUN_0, TRUE))
        {
            aot_delete(AOT_09_ITEM_KEY_CREST_SUN, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        aot_delete(AOT_03_EVENT_SWITCH, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_04_MESSAGE_SHOWCASE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        eml_pos(OBJ_00_SHOWCASE, 0, 0, 0, 0, 0, 0);
        eml_pos(OBJ_01_ARMOR_W, 0, 2048, 0, 4845, 0, 7236);
        eml_pos(OBJ_02_ARMOR_E, 0, 0, 0, 14035, 0, 7240);
        set(FG_ROOM, F_ROOM_WATCH_ARMORS, TRUE);
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_SHOWCASE_OPEN, TRUE) && ck(FG_ROOM, F_ROOM_SHOWCASE_SCENE, TRUE))
    {
        set(FG_ROOM, F_ROOM_SHOWCASE_SCENE, FALSE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_ARMOR_SHOWCASE_OPEN, FALSE) && cmpb(B_CAMERA, CMP_EQ, CAM_02_SHOWCASE))
    {
        bank_bit(1);
        bank_bit(2);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_02_SHOWCASE) && ck(FG_ROOM, F_ROOM_SHOWCASE_SCENE, FALSE))
    {
        bank_bit(3);
    }
    if (ck(FG_ROOM, F_ROOM_SWITCH_PUSHED, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_GAS_HOLE_W_COVERED, TRUE) && ck(FG_ROOM, F_ROOM_GAS_HOLE_E_COVERED, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_SHOWCASE_OPEN, FALSE))
            {
                evt_exec(0, TASK_09, showcase_opens);
            }
            if (ck(FG_ITEM, F_ITEM_205_KEY_CREST_SUN_0, TRUE))
            {
                aot_delete(AOT_04_MESSAGE_SHOWCASE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_09_ITEM_KEY_CREST_SUN, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
            }
            set(FG_ROOM, F_ROOM_WATCH_ARMORS, TRUE);
        }
        else
        {
            evt_exec(0, TASK_09, switch_releases_gas);
        }
        aot_delete(AOT_03_EVENT_SWITCH, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_SWITCH_PUSHED, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_WATCH_ARMORS, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_GAS_HOLE_W_COVERED, TRUE) && ck(FG_ROOM, F_ROOM_GAS_HOLE_E_COVERED, TRUE))
        {
        }
        else
        {
            evt_exec(0, TASK_09, armor_moved_releases_gas);
            set(FG_ROOM, F_ROOM_WATCH_ARMORS, FALSE);
        }
    }
    if (ck(FG_ROOM, F_ROOM_GAS_HOLE_W_COVERED, TRUE))
    {
        aot_delete(AOT_07_MESSAGE_GAS_HOLE_W, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_GAS_W_FLOWING, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_GAS_HOLE_E_COVERED, TRUE))
    {
        aot_delete(AOT_08_MESSAGE_GAS_HOLE_E, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_GAS_E_FLOWING, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_GAS_RELEASED, TRUE) && ck(FG_ROOM, F_ROOM_GAS_HOLE_W_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_GAS_W_FLOWING, FALSE))
    {
        evt_exec(0, TASK_09, gas_from_west_hole);
        aot_delete(AOT_07_MESSAGE_GAS_HOLE_W, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_GAS_W_FLOWING, TRUE);
    }
    if (ck(FG_ROOM, F_ROOM_GAS_RELEASED, TRUE) && ck(FG_ROOM, F_ROOM_GAS_HOLE_E_COVERED, FALSE) && ck(FG_ROOM, F_ROOM_GAS_E_FLOWING, FALSE))
    {
        evt_exec(0, TASK_09, gas_from_east_hole);
        aot_delete(AOT_08_MESSAGE_GAS_HOLE_E, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_GAS_E_FLOWING, TRUE);
    }
    if (ck(FG_ROOM, F_ROOM_PLAYER_GAS_ANIM_DONE, TRUE) && ck(FG_STATUS, F_STATUS_40, FALSE))
    {
        sys_multi(SYS_HEALTH_STATUS, SYS_OR | HS_40);
    }
    if (ck(FG_ROOM, F_ROOM_GAS_W_FLOWING, FALSE) && ck(FG_ROOM, F_ROOM_GAS_E_FLOWING, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_GAS_BGM_ON, TRUE))
        {
            set(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE);
            bgm_stop(BGM_MAIN);
        }
    }
    else if (ck(FG_ROOM, F_ROOM_GAS_BGM_ON, FALSE))
    {
        set(FG_ROOM, F_ROOM_GAS_BGM_ON, TRUE);
        bgm_play(BGM_MAIN);
        snd_pan_vol_set(BGM_MAIN, -1, -1);
    }
}

event examine_switch
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cutnext(CAM_03_SWITCH);
    sleep(15);
    message(MSG_THERE_IS_A_SWITCH | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "There's a switch. Will you push it? A weird hole opens."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            set(FG_ROOM, F_ROOM_SWITCH_PUSHED, TRUE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cutnext(CAM_01);
        cut_auto(CUT_FREE);
    }
    evt_next();
    evt_finish();
}

event showcase_opens
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cut_auto(CUT_LOCKED);
        cutnext(CAM_01);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_ROOM, F_ROOM_SHOWCASE_SCENE, TRUE);
        bank_bit(1);
        bank_bit(2);
    }
    sleep(10);
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    act_reset();
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_18_SHUTER, 0, SND_AT_POINT, 0, 9550, 7200);
        cutnext(CAM_02_SHOWCASE);
        aot_switch(0, SPR_03, SPR_ON);
        aot_delete(AOT_03_EVENT_SWITCH, SCE_NONE, SAT_UNDER | SAT_OBJECT);
    }
    sleep(40);
    se_play_3d(SND_BANK_ROOM, SE_17_MACHA, 0, SND_AT_POINT, 0, 3500, 7200);
    evt_fork(TASK_09, showcase_opens_dust, 0);
    evt_work_set(WK_OBJ, OBJ_00_SHOWCASE);
    evt_tween_begin_alt();
    tw_set_pos(0, 24, 0);
    for (90)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 0, 0, 0);
    tw_nop();
    tw_end();
    sleep(40);
    aot_switch(0, SPR_03, SPR_OFF);
    cutnext(CAM_01);
    cut_auto(CUT_FREE);
    sleep(10);
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0004 | EF_0001);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        aot_delete(AOT_04_MESSAGE_SHOWCASE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_SCENARIO, F_SCENARIO_ARMOR_SHOWCASE_OPEN, TRUE);
        set(FG_ROOM, F_ROOM_SHOWCASE_SCENE, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event switch_releases_gas
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    act_reset();
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_18_SHUTER, 0, SND_AT_POINT, 0, 9550, 7200);
        set(FG_ROOM, F_ROOM_GAS_RELEASED, TRUE);
        timer_setup(LIGHT_FADE_01, 200, FADE_R | FADE_G);
    }
    sleep(30);
    setw(W_LIGHT_DELTA, 0);
    message(MSG_POISON_GAS_IS_ESCAPING, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "Poison gas is escaping...!"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0004 | EF_0001);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    cut_auto(CUT_FREE);
    sleep(60);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cut_auto(CUT_LOCKED);
    se_play_3d(SND_BANK_PLAYER, SE_PL_02, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_01, F_ROOM_PLAYER_GAS_ANIM_DONE, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_GAS_ANIM_DONE, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        if (ck(FG_RUN, F_RUN_READY, FALSE))
        {
            set(FG_RUN, F_RUN_READY, TRUE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event gas_from_west_hole
{
    do
    {
        single(12) effect(FX_09, FX_ROW_18, FX_AT_WORLD, 4885, -360, 7236, 0);
        evt_nop();
        evt_nop();
        sleep(15);
    }
    while (ck(FG_ROOM, F_ROOM_GAS_W_FLOWING, TRUE));
    evt_finish();
}

event gas_from_east_hole
{
    do
    {
        single(12) effect_tracked(FX_09, FX_ROW_18, FX_AT_WORLD, 14035, 65176, 7236, 0);
        evt_nop();
        evt_nop();
        sleep(15);
    }
    while (ck(FG_ROOM, F_ROOM_GAS_E_FLOWING, TRUE));
    evt_finish();
}

event armor_moved_releases_gas
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cut_auto(CUT_LOCKED);
        set(FG_ROOM, F_ROOM_GAS_RELEASED, TRUE);
        timer_setup(LIGHT_FADE_01, 200, FADE_R | FADE_G);
    }
    sleep(30);
    run
    {
        setw(W_LIGHT_DELTA, 0);
        message(MSG_POISON_GAS_IS_ESCAPING, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "Poison gas is escaping...!"
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    sleep(60);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        se_play_3d(SND_BANK_PLAYER, SE_PL_02, 0, SND_AT_PLAYER, 0, 0, 0);
        cut_auto(CUT_LOCKED);
    }
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_01, F_ROOM_PLAYER_GAS_ANIM_DONE, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_GAS_ANIM_DONE, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        if (ck(FG_STATUS, F_STATUS_OBJECT_PUSH, FALSE))
        {
            set(FG_RUN, F_RUN_READY, TRUE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

