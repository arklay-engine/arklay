  <strings>
    <language lang="en-US">
      <string key="name">ARMOR ROOM</string>
      <string key="save_name">Hall 1F</string>
      <string key="0">There's a switch. Will\nyou push it? {branch 1 1 0}\nA weird hole opens.{scroll 2}</string>
      <string key="1">\nA weird hole opens.{scroll 2}</string>
      <string key="2">Something can be seen in \nthe showcase.{scroll 2}</string>
      <string key="3">Heavy-looking suits of \narmor.{scroll 2}</string>
      <string key="4">\nPoison gas is escaping...!{scroll 2}{timed 1}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}ホ{s}ー{s}ル{s}/{s}1{s}F{s}</string>
      <string key="0">     スイッチがある\n押しますか?{branch 1 1 0}\n   不気味な穴が開いている{scroll 2}</string>
      <string key="1">\n   不気味な穴が開いている{scroll 2}</string>
      <string key="2">\n ショーケースの中に何か見える{scroll 2}</string>
      <string key="3">\n   重そうな鎧が並んでいる{scroll 2}</string>
      <string key="4">\n  毒ガスがもれている・・・!{scroll 2}{timed 1}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Hall RdC</string>
      <string key="0">Il y a un bouton.\nAppuyer dessus?{branch 1 6 0}</string>
      <string key="1">\nUn trou bizarre s'ouvre.{scroll 2}</string>
      <string key="2">Il y a quelque chose dans \nla vitrine.{scroll 2}</string>
      <string key="3">Une rangée d'armures très \nlourdes.{scroll 2}</string>
      <string key="4">\nUn gaz nocif s'échappe...!{scroll 2}{timed 1}</string>
    </language>
    <language lang="de-DE">
      <string key="0">Da ist ein Schalter.\nMöchten Sie draufdrücken?{branch 1 6 0}</string>
      <string when="MANSION2" key="0">Da ist ein Schalter. Möchten\nSie draufdrücken?{branch 1 6 0}</string>
      <string key="1">\nEin unheimliches Loch.{scroll 2}</string>
      <string key="2">Irgend etwas ist dort\nin der Vitrine zu sehen.{scroll 2}</string>
      <string when="MANSION2" key="2">Irgend etwas ist dort in der\nVitrine zu sehen.{scroll 2}</string>
      <string key="3">\nRobust aussehende Rüstungen.{scroll 2}</string>
      <string key="4">\nEs entweicht Giftgas!{scroll 2}{timed 1}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Atrio 1P</string>
      <string key="0">C'è un interruttore. \nVuoi premerlo?{branch 1 6 0}</string>
      <string key="1">\nÈ presente uno strano buco.{scroll 2}</string>
      <string when="MANSION2" key="1">\nÈ aperto uno strano buco.{scroll 2}</string>
      <string key="2">Si riesce a vedere \nqualcosa nella teca.{scroll 2}</string>
      <string key="3">Armature dall'aspetto \npesante.{scroll 2}</string>
      <string key="4">\nFuoriesce del gas velenoso...{scroll 2}{timed 1}</string>
    </language>
    <language lang="es-ES">
      <string key="0">Hay un interruptor...\n¿Quieres pulsarlo? {branch 1 6 0}</string>
      <string key="1">\nSe abre un extraño agujero...{scroll 2}</string>
      <string key="2">Parece que hay algo\nen la estantería...{scroll 2}</string>
      <string key="3">Son armaduras.\nParecen pesadas...{scroll 2}</string>
      <string key="4">\n¡Sale gas venenoso...!{scroll 2}{timed 1}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Зал 1-эт.</string>
      <string key="0">Тут есть кнопка.\nХотите нажать её?{branch 1 1 0}\nОткрывается таинственный тоннель.{scroll 2}</string>
      <string when="MANSION2" key="0">Тут есть кнопка.\nХотите нажать её? {branch 1 1 0}\nОткрывается таинственный тоннель.{scroll 2}</string>
      <string key="1">\nОткрывается таинственный тоннель.{scroll 2}</string>
      <string key="2">\nВ витрине что-то есть.{scroll 2}</string>
      <string key="3">\nТяжёлые доспехи.{scroll 2}</string>
      <string key="4">\nПошёл ядовитый газ...!{scroll 2}{timed 1}</string>
      <string when="MANSION2" key="4">\nЯдовитый газ уходит...!{scroll 2}{timed 1}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Pääaula 1 krs</string>
      <string key="0">Siinä on painike...\nPainatko sitä? {branch 1 6 0}</string>
      <string key="1">Omituinen ritilöity aukko...{scroll 2}</string>
      <string key="2">Näytekaapissa on jotakin...{scroll 2}</string>
      <string key="3">Painavan näköisiä haarniskoja...{scroll 2}</string>
      <string key="4">Ritilöydystä aukosta tulee\nmyrkkykaasua...!{scroll 2}{timed 1}</string>
    </language>
  </strings>
