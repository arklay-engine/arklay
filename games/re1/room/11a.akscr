#if CHRIS

event from_main
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(17154, 14346, 553);
    act_reset();
    sleep(10);
    set(FG_STATUS, F_STATUS_0F, TRUE);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_02, FALSE));
    set(FG_ROOM, F_ROOM_02, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(19, 4785, 0, 8990, 192, 64);
    act_reset();
    evt_nop();
    sleep(10);
    voice_play(VOICE_PLAY, VO_00B_00, 0);
    message(MSG_VO_00B_00, 0);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(19202, 56592, 8740);
    act_nop();
    act_param_set(40960, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    act_anim_flags(0 | 9, 32 | 2, 0 | 0);
    sleep(25);
    act_reset();
    evt_nop();
    wait_message();
    voice_play(VOICE_PLAY, VO_00B_01, 0);
    message(MSG_VO_00B_01, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 16, 32 | 2, 0 | 0);
    sleep(20);
    act_reset();
    evt_nop();
    objtbl_b_set(1, 0, 0);
    sleep(10);
    evt_fork(TASK_01, from_main_sub1, 0);
    wait_message();
    evt_disable(TASK_01);
    sys_multi(SYS_06);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_anim_flags(0 | 9, 32 | 2, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(25);
    act_idle();
    act_reset();
    run
    {
        set(FG_ITEM, F_ITEM_3B, FALSE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_1D, FALSE);
    }
    evt_finish();
}

event from_main_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 2, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 18, 32 | 2, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(20);
    act_reset();
    evt_nop();
    evt_chain(2);
    evt_finish();
}

event on_enter
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 2496, 0, 4500, 0, 4100);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        bgm_play(BGM_SUB_1);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, FALSE);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        evt_exec(0, TASK_09, on_enter_sub1);
        voice_play(VOICE_PLAY, VO_00C_00, 0);
        message(MSG_VO_00C_00, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(VOICE_PLAY, VO_00C_01, 0);
    message(MSG_VO_00C_01, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(0);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

