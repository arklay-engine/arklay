        {
            plw_anim(2, 40, 0);
            setw(4, 0, 0);
            evt_exec(0, 9, event_03);
        }
        if (ck(FG_COMMON, 54, 0))
        {
            plw_anim(2, 40, 0);
            setw(4, 0, 0);
            evt_exec(0, 9, event_05);
