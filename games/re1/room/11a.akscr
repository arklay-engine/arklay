{
    evt_finish();
}

event from_main_3
{
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, FALSE);
    }
    evt_next();
    evt_next();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_POINT, 0, 7027, 27234);
        cutnext(CAM_04);
        objtbl_b_set(0, 0, 47);
        set(FG_SCENARIO, F_SCENARIO_69, TRUE);
    }
    sleep(40);
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, TRUE);
        set(FG_ROOM, F_ROOM_01, FALSE);
        cutcurr(0);
    }
    evt_finish();
}

