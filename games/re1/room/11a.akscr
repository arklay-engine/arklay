event event_00
{
    cutnext(4);
#if MANSION1
    message(138, 255);
#else
    message(131, 255);
#endif
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    cutcurr(0);
    evt_finish();
}
