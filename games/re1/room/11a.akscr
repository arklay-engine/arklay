#if MANSION1
proc main
{
    if (ck(FG_ROOM, 32, 0) && ck(FG_ROOM, 1, 1))
    {
        if (ck(FG_SCENARIO, 105, 0) && ck(FG_SCENARIO, 106, 0) && ck(FG_SCENARIO, 107, 0) && ck(FG_SCENARIO, 108, 0))
        {
            evt_exec(0, 0, event_01);
        }
        else
        {
            evt_exec(0, 0, event_00);
        }
    }
    if (testitem(ITEM_SUN_CREST))
    {
        set(FG_ROOM, 1, 0);
        evt_exec(0, 0, event_03);
    }
    if (testitem(ITEM_MOON_CREST))
    {
        set(FG_ROOM, 1, 0);
        evt_exec(0, 0, event_04);
    }
    if (testitem(ITEM_STAR_CREST))
    {
        set(FG_ROOM, 1, 0);
        evt_exec(0, 0, event_05);
    }
    if (testitem(ITEM_WIND_CREST))
    {
        set(FG_ROOM, 1, 0);
        evt_exec(0, 0, event_06);
    }
    if (ck(FG_LOCK, 23, 1) && ck(FG_SCENARIO, 105, 0) && ck(FG_SCENARIO, 106, 0) && ck(FG_SCENARIO, 107, 0) && ck(FG_SCENARIO, 108, 0))
    {
        set(FG_LOCK, 23, 0);
        evt_exec(0, 1, event_07);
    }
}

