#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_EVENT 0x01
#define AOT_02_EVENT 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_ITEM 0x05
#define AOT_06_ITEM 0x06
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08
#define AOT_09_MESSAGE 0x09
#define AOT_0A_MESSAGE 0x0A
#define AOT_0B_MESSAGE 0x0B
#define MSG_NOTHING_IMPORTANT 0x01
#define MSG_THERE_IS_A_SWITCH 0x00
#define MSG_WILL_YOU_TRY_AND_TAKE_OUT 0x02

proc init
{
    door_aot_set(AOT_00_DOOR, 8100, 3200, 1800, 1300, 3, 0, 0, 4, 0, ROOM_201_2F_LEFT_STAIRS, 15000, 0, 17500, 0, UNLOCKED, 129);
    aot_set(AOT_01_EVENT, 8200, 5100, 1000, 1000, SCE_EVENT, 129, 9, 0, on_aot_01, 0, 0, 0);
    aot_set(AOT_02_EVENT, 4450, 10680, 1000, 1500, SCE_EVENT, 129, 9, 0, on_aot_02, 0, 0, 0);
    item_aot_set(AOT_03_ITEM, 1820, 9520, 1000, 1000, IT_0C_AMMO_SHOTGUN, 7, 0, 255, 16, 9, 80, 251, 36, 39, 0, 8, 29, 129, 0, 0);
    item_aot_set(AOT_04_ITEM, 3900, 7500, 1700, 1600, IT_62_FILE_ORDERS, 0, 1, 255, 242, 18, 70, 251, 244, 31, 180, 251, 116, 129, 0, 0);
    eml_rot(1, 124, 1, 232, 8);
    item_aot_set(AOT_05_ITEM, 0, 0, 10, 10, IT_22_KEY_JEWEL_RED, 1, 2, 255, 8, 32, 198, 233, 50, 55, 0, 0, 30, 129, 0, 0);
    eml_rot(2, 0, 0, 0, 252);
    setbyte(2, 0, 0);
    item_aot_set(AOT_06_ITEM, 1780, 7820, 1000, 1500, IT_0E_AMMO_MAGNUM, 6, 3, 255, 232, 8, 80, 251, 160, 35, 0, 0, 200, 129, 0, 0);
    obj(0, 65, 255, 6720, 0, 10440, 0, 64, 2, 0, 0, 192, 253, 0, 0, 28, 2, 132, 3, 232, 3, 28, 2);
    if (ck(FG_COMMON, F_COMMON_44, FALSE))
    {
        cutnext(4);
        evt_exec(0, 9, on_enter);
    }
    else
    {
        msg_list(0, 18, 38, 248, 243, 248, 25, 56, 56, 56, 0, 200, 45, 169, 38, 22, 244, 80, 28, 56, 56, 56, 0, 112, 43, 11, 39, 72, 244, 8, 25, 180, 180, 180, 0, 160, 35, 160, 1, 160, 1, 160, 1);
        if (ck(FG_ITEM, F_ITEM_1E, TRUE))
        {
            effect_tracked(12, 25, 0, 80, 20, 96, 240, 68, 47, 0, 0);
        }
    }
    aot_set(AOT_07_MESSAGE, 5500, 5200, 1100, 2500, SCE_MESSAGE, 129, 133, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 3600, 11500, 3500, 600, SCE_MESSAGE, 129, 134, 0, 255, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 7100, 11500, 1800, 600, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 1500, 10900, 2000, 1000, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    aot_set(AOT_0B_MESSAGE, 2200, 7500, 300, 2500, SCE_MESSAGE, 129, 134, 0, 255, 0, 0, 0);
}

proc main
{
    if (ck(FG_STATUS, F_STATUS_18, TRUE))
    {
        aot_delete(AOT_02_EVENT, SCE_EVENT, 129);
        aot_delete(AOT_03_ITEM, SCE_ITEM, 0);
        aot_delete(AOT_04_ITEM, SCE_DOCUMENT, 0);
        aot_delete(AOT_05_ITEM, SCE_ITEM, 0);
    }
    else
    {
        aot_delete(AOT_02_EVENT, SCE_EVENT, 0);
        aot_delete(AOT_03_ITEM, SCE_ITEM, 129);
        aot_delete(AOT_04_ITEM, SCE_DOCUMENT, 129);
        aot_delete(AOT_05_ITEM, SCE_ITEM, 129);
    }
    if (ck(FG_ITEM, F_ITEM_1E, FALSE))
    {
        aot_delete(AOT_02_EVENT, SCE_NONE, 0);
    }
    if (ck(FG_ITEM, F_ITEM_1D, FALSE))
    {
        aot_delete(AOT_03_ITEM, SCE_NONE, 0);
    }
    if (ck(FG_ITEM, F_ITEM_74, FALSE))
    {
        aot_delete(AOT_04_ITEM, SCE_NONE, 0);
    }
    if (ck(FG_ITEM, F_ITEM_C8, FALSE))
    {
        aot_delete(AOT_05_ITEM, SCE_NONE, 0);
    }
}

event on_aot_01
{
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    message(MSG_THERE_IS_A_SWITCH | 0x80, 0); // "There's a switch. Will you push it? ...Nothing important."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            se_play_3d(2, 23, 0, 0, 0, 8200, 5100);
            if (ck(FG_COMMON, F_COMMON_44, FALSE))
            {
                if (cmpb(2, 0, 4))
                {
                    cutnext(0);
                }
                else
                {
                    cutnext(1);
                }
                evt_exec(0, 9, on_aot_01_sub1);
            }
            else
            {
                if (cmpb(2, 0, 0))
                {
                    cutnext(4);
                }
                else
                {
                    cutnext(5);
                }
                evt_exec(0, 9, on_aot_01_sub2);
            }
        }
        else
        {
            evt_exec(0, 9, on_enter);
        }
    }
    evt_finish();
}

event on_aot_01_sub1
{
    run
    {
        if (ck(FG_ITEM, F_ITEM_1E, TRUE))
        {
            effect_tracked(12, 25, 0, 80, 20, 96, 240, 68, 47, 0, 0);
        }
        msg_list(0, 18, 38, 248, 243, 248, 25, 56, 56, 56, 0, 200, 45, 169, 38, 22, 244, 80, 28, 56, 56, 56, 0, 112, 43, 11, 39, 72, 244, 8, 25, 180, 180, 180, 0, 160, 35, 160, 1, 160, 1, 160, 1);
        set(FG_COMMON, F_COMMON_44, TRUE);
    }
    evt_chain(3);
    evt_finish();
}

event on_aot_01_sub2
{
    run
    {
        if (ck(FG_ITEM, F_ITEM_1E, TRUE))
        {
            effect_kill_a(0);
        }
        set(FG_COMMON, F_COMMON_44, FALSE);
    }
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    run
    {
        timer_setup(2, 240, 216, 7, 0);
        msg_list(0, 18, 38, 248, 243, 248, 25, 200, 200, 200, 0, 0, 25, 177, 20, 22, 244, 112, 31, 200, 200, 200, 0, 240, 25, 115, 20, 72, 244, 80, 28, 200, 200, 200, 0, 240, 25, 48, 5, 64, 3, 112, 1);
    }
    evt_chain(3);
    evt_finish();
}

event on_enter
{
    sleep(5);
    run
    {
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_02
{
    sleep(1);
    run
    {
        set(FG_6, F_6_17, FALSE);
        if (ck(FG_COMMON, F_COMMON_44, FALSE))
        {
            cutnext(7);
            evt_exec(0, 9, on_aot_02_sub1);
        }
        else
        {
            cutnext(3);
            setbyte(2, 1, 0);
            effect_kill_a(0);
            msg_list(0, 168, 22, 248, 243, 204, 41, 255, 255, 255, 0, 240, 25, 168, 22, 22, 244, 204, 41, 255, 255, 255, 0, 240, 25, 168, 22, 72, 244, 204, 41, 255, 255, 255, 0, 240, 25, 120, 5, 120, 5, 120, 5);
            evt_exec(0, 9, on_aot_02_sub2);
            evt_exec(0, 7, on_aot_02_sub3);
        }
    }
    evt_finish();
}

event on_aot_02_sub1
{
    sleep(50);
    message(MSG_NOTHING_IMPORTANT, 0); // "...Nothing important."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        cutcurr(0);
    }
    sleep(1);
    run
    {
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_02_sub2
{
    sleep(50);
    message(MSG_WILL_YOU_TRY_AND_TAKE_OUT | 0x80, 0); // "Will you try and take out the eyeball? It looks as if it's alive."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, on_aot_02_sub2_sub1);
        }
        else
        {
            evt_exec(0, 9, on_aot_02_sub2_sub2);
        }
    }
    evt_finish();
}

event on_aot_02_sub2_sub1
{
    run
    {
        set(FG_6, F_6_17, TRUE);
        aot_on(AOT_05_ITEM, SCE_ITEM, 0);
    }
    evt_next();
    evt_nop();
    run
    {
        set(FG_6, F_6_17, FALSE);
    }
    sleep(1);
    evt_chain(8);
    evt_finish();
}

event on_aot_02_sub2_sub2
{
    evt_disable(7);
    run
    {
        if (ck(FG_ITEM, F_ITEM_1E, TRUE))
        {
            effect_tracked(12, 25, 0, 80, 20, 96, 240, 68, 47, 0, 0);
        }
        setbyte(2, 0, 0);
        cutcurr(0);
        msg_list(0, 18, 38, 248, 243, 248, 25, 56, 56, 56, 0, 200, 45, 169, 38, 22, 244, 80, 28, 56, 56, 56, 0, 112, 43, 11, 39, 72, 244, 8, 25, 180, 180, 180, 0, 160, 35, 160, 1, 160, 1, 160, 1);
    }
    sleep(1);
    run
    {
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_02_sub3
{
    for (40)
    {
        evt_work_set(WK_AOT, 2);
        evt_tween_begin_alt();
        tw_set_rot(20, 0, 0);
        tw_rot_add();
        tw_nop();
        tw_end();
        evt_nop();
        sleep(1);
    }
    evt_nop();
    sleep(60);
    evt_chain(9);
    evt_finish();
}
