    act_reset();
    evt_nop();
    evt_finish();
}

event event_03
{
    set(FG_STATUS, 15, 0);
    dir_set(0, 0, 650, 0, 5300, 0, 7160);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, 23, 1);
        evt_exec(0, 9, event_04);
        voice_play(1, 99, 0);
        message(6, 0);
    }
    wait_message();
    sleep(10);
    voice_play(1, 100, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, 14, 0));
    sleep(10);
    voice_play(1, 101, 0);
    message(7, 0);
    wait_message();
    run
    {
        dir_set(0, 0, 1194, 0, 5520, 0, 8360);
        cut_auto(0);
        set(FG_6, 23, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 0, 0, 0, 250, 250);
    act_idle();
    act_reset();
    set(FG_STATUS, 15, 1);
    evt_finish();
}

