{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(70);
    act_motion_path(49, 1250, 0, 0, 50, 0);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
