event event_07
{
    evt_disable(0);
    run
    {
        set(FG_6, 29, 1);
        set(FG_6, 23, 1);
        set(FG_ROOM, 1, 1);
    }
    sleep(30);
    run
    {
        cutcurr(0);
        set(FG_6, 29, 0);
