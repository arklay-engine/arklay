event on_aot_03
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        aot_delete(AOT_03_EVENT, SCE_NONE, 0);
    }
    sleep(10);
    run
    {
        bgm_stop(BGM_SUB_1);
        se_play_3d(SND_BANK_ROOM, SE_1A_MAGNUM, 0, SND_AT_POINT, 0, 11850, 26300);
    }
    sleep(5);
    run
    {
        bgm_play(BGM_SUB_2);
        aot_reset(AOT_01_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_01_door_2, 0);
    }
    sleep(20);
    run
    {
        voice_play(VOICE_PLAY, VO_10E_08, 0);
        message(MSG_VO_10E_08, 0);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(113, 400, 0, 1, 60, 0);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

