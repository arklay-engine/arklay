event examine_infant_picture
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_EFFECTS, FALSE);
    }
    message(MSG_A_PICTURE_OF_AN_INFANT | MSG_FAST, RUN_CONTROLS | RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "A picture of an infant."
    do
    {
