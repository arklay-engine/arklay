event mourning_switch
{
    message(MSG_THERE_IS_A_SWITCH_BELOW | MSG_FAST, RUN_CONTROLS | RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "There's a switch below. Will you push it?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_ROOM, F_ROOM_WRONG_ORDER, FALSE);
        set(FG_ROOM, F_ROOM_SWITCH_PROMPT_DONE, TRUE);
        require(cmpb(B_MENU_CHOICE, CMP_EQ, 0));
        evt_exec(0, TASK_09, switch_click);
        evt_exec(0, TASK_09, reset_switch_order);
        if (ck(FG_ROOM, F_ROOM_ORDER_6_OLD_MAN, TRUE))
        {
            set(FG_ROOM, F_ROOM_SWITCH_IN_ORDER, TRUE);
        }
        else
        {
            set(FG_ROOM, F_ROOM_WRONG_ORDER, TRUE);
            set(FG_ROOM, F_ROOM_SWITCH_IN_ORDER, FALSE);
        }
    }
    sleep(1);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_SWITCH_PROMPT_DONE, FALSE));
    run
    {
        if (ck(FG_ROOM, F_ROOM_SWITCH_IN_ORDER, TRUE))
        {
            set(FG_ROOM, F_ROOM_SWITCH_IN_ORDER, FALSE);
            set(FG_ROOM, F_ROOM_ORDER_DONE, TRUE);
            set(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE);
            evt_exec(0, TASK_09, frame_falls);
            set(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE);
            evt_exec(0, TASK_09, pictures_become_messages);
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                bgm_play(BGM_MAIN);
            }
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            cutnext(CAM_06_FALLING_FRAME);
            dir_set(0, 0, 2100, 0, 2773, 0, 4147);
        }
    }
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
            {
                get_eml_state(ENEMY_00_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_0, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_00_CROW, 0, 1024, 0, 19000, -2000, 4847);
                }
                get_eml_state(ENEMY_01_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_1, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_01_CROW, 0, 2048, 0, 19000, -2000, 4247);
                }
            }
        }
    }
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
            {
                get_eml_state(ENEMY_02_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_2, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_02_CROW, 0, 3072, 0, 19000, -2000, 3647);
                }
                get_eml_state(ENEMY_03_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_3, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_03_CROW, 0, 0, 0, 19000, -2000, 3047);
                }
            }
        }
    }
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                get_eml_state(ENEMY_00_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_0, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_00_CROW, 0, 1024, 0, 19000, -2000, 5047);
                }
                get_eml_state(ENEMY_01_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_1, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_01_CROW, 0, 2048, 0, 19000, -2000, 4617);
                }
            }
        }
    }
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                get_eml_state(ENEMY_02_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_2, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_02_CROW, 0, 3072, 0, 19000, -2000, 4187);
                }
                get_eml_state(ENEMY_03_CROW);
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_3, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    pos_set(ENEMY_03_CROW, 0, 0, 0, 19000, -2000, 3757);
                }
            }
        }
    }
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
                {
                    get_eml_state(ENEMY_04_CROW);
                }
                else
                {
                    get_eml_state(ENEMY_04_CROW);
                }
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_4, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
                    {
                        pos_set(ENEMY_04_CROW, 0, 1024, 0, 19000, -2000, 3327);
                    }
                    else
                    {
                        pos_set(ENEMY_04_CROW, 0, 1024, 0, 19000, -2000, 3327);
                    }
                }
                if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
                {
                    get_eml_state(ENEMY_05_CROW);
                }
                else
                {
                    get_eml_state(ENEMY_05_CROW);
                }
                if (ck(FG_ENEMY, F_ENEMY_117_CROW_5, FALSE) && cmpb(B_0A, CMP_NE, 0))
                {
                    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
                    {
                        pos_set(ENEMY_05_CROW, 0, 2048, 0, 19000, -2000, 2897);
