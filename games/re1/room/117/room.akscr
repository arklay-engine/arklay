#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_10A 0x00
#define AOT_01_EVENT_TITLE_PLAQUE 0x01
#define AOT_02_MESSAGE_PICTURE_MIDDLE_AGED 0x02             // An event with a switch until the puzzle is solved; the same for 03 to 07.
#define AOT_03_MESSAGE_PICTURE_NEWBORN 0x03
#define AOT_04_MESSAGE_PICTURE_YOUNG_MAN 0x04
#define AOT_05_MESSAGE_PICTURE_INFANT 0x05
#define AOT_06_MESSAGE_PICTURE_BOY 0x06
#define AOT_07_MESSAGE_PICTURE_OLD_MAN 0x07
#define AOT_08_EVENT_PICTURE_MOURNING 0x08                  // The last switch; cleared once the puzzle is solved.
#define AOT_09_ITEM_KEY_CREST_STAR_0 0x09
#define CAM_00 0x00
#define CAM_06_FALLING_FRAME 0x06
#define CAM_07_TITLE_PLAQUE 0x07
#define ENEMY_00_CROW 0x00
#define ENEMY_01_CROW 0x01
#define ENEMY_02_CROW 0x02
#define ENEMY_03_CROW 0x03
#define ENEMY_04_CROW 0x04
#define ENEMY_05_CROW 0x05
#define F_ROOM_ANIM_DONE_UNUSED 0x3F                        // An animation-finished pulse no script waits on.
#define F_ROOM_FRAME_STEP_BUSY 0x13                         // Handshake for the falling frame's steps and the player's step back.
#define F_ROOM_LAST_SWITCH_BUSY 0x12                        // The mourning picture's switch scene is running.
#define F_ROOM_ORDER_1_NEWBORN 0x1A                         // First in order: the newborn baby.
#define F_ROOM_ORDER_2_INFANT 0x1C                          // Second in order: the infant.
#define F_ROOM_ORDER_3_BOY 0x1D                             // Third in order: the lively boy.
#define F_ROOM_ORDER_4_YOUNG_MAN 0x1B                       // Fourth in order: the young man.
#define F_ROOM_ORDER_5_MIDDLE_AGED 0x19                     // Fifth in order: the tired middle-aged man.
#define F_ROOM_ORDER_6_OLD_MAN 0x1E                         // Sixth in order: the bold-looking old man.
#define F_ROOM_ORDER_DONE 0x1F                              // All seven pressed in order; nothing reads it.
#define F_ROOM_ORDER_SPARE 0x18                             // Cleared with the order bits; never set.
#define F_ROOM_SWITCH_IN_ORDER 0x17                         // The switch just pressed was the next in the order.
#define F_ROOM_SWITCH_PROMPT_DONE 0x16                      // A switch prompt (or its click) finished.
#define F_ROOM_WRONG_ORDER 0x14                             // The last switch was pressed out of order: the crows attack.
#define IMDL_00_KEY_CREST_STAR 0x00
#define MSG_A_PICTURE_OF_AN_INFANT 0x08
#define MSG_A_PICTURE_OF_A_BOLDLOOKING_OLD 0x0A
#define MSG_A_PICTURE_OF_A_LIVELY_BOY 0x09
#define MSG_A_PICTURE_OF_A_NEWBORN_BABY 0x06
#define MSG_A_PICTURE_OF_A_TIRED_MIDDLEAGED 0x05
#define MSG_A_PICTURE_OF_A_YOUNG_MAN 0x07
#define MSG_A_PICTURE_OF_PEOPLE_MOURNING_FOR 0x0B
#define MSG_THERE_IS_A_SWITCH_BELOW 0x0C
#define MSG_THE_TITLE_IS_ALL_LIVING_THINGS 0x04
#define MSG_VO_00C_00 0x00
#define MSG_VO_00C_01 0x01
#define MSG_VO_00C_20 0x02
#define MSG_VO_00C_22 0x03
#define OBJ_00_FALLING_FRAME 0x00                           // The mourning picture's frame, which falls to reveal the star crest.
#define SE_17_SW_BTN 0x17
#define SE_18_FRAME_GA 0x18
#define SE_19_FRAME_FA 0x19
#define VO_00C_00 0x54
#define VO_00C_01 0x55
#define VO_00C_20 0x64
#define VO_00C_21 0x65
#define VO_00C_22 0x66

proc init
{
    door_aot_set(AOT_00_DOOR_10A, 2000, 10800, 2400, 1800, 1, DOOR_SND_00_DR_WD, DOOR_1E_DOOR03K, 5, 0, ROOM_10A_BACK_PASSAGE, 3000, 0, 2500, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_09_ITEM_KEY_CREST_STAR_0, 1300, 3300, 1100, 1600, IT_2D_KEY_CREST_STAR, 1, IMDL_00_KEY_CREST_STAR, SCA_NONE, 1530, -2870, 4060, 3200, F_ITEM_117_KEY_CREST_STAR_0, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            room_bgm_state_set(0, ROOM_117_LARGE_GALLERY, BGM_RELOAD | BGM_MAIN_ON);
        }
    }
    else
    {
        room_bgm_state_set(5, 23, BGM_MAIN_ON);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            room_bgm_state_set(0, ROOM_117_LARGE_GALLERY, BGM_MAIN_ON);
            evt_exec(0, TASK_09, solved_bgm);
        }
        else if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
        {
            evt_exec(0, TASK_09, solved_bgm);
        }
        obj(OBJ_00_FALLING_FRAME, OF_80 | OF_ACTIVE, SCA_NONE, 3440, 300, 3310, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_exec(0, TASK_09, frame_fallen_on_enter);
        }
        else if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            evt_exec(0, TASK_09, frame_fallen_on_enter);
        }
        else
        {
            evt_exec(0, TASK_09, frame_fallen_on_enter);
        }
        aot_set(AOT_01_EVENT_TITLE_PLAQUE, 6600, 6800, 5000, 1200, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, read_title_plaque, 0, 0, 0);
        aot_set(AOT_02_MESSAGE_PICTURE_MIDDLE_AGED, 15000, 6800, 2000, 800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 69, 1, 0, 0);
        aot_set(AOT_03_MESSAGE_PICTURE_NEWBORN, 18500, 6800, 2000, 800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 134, 0, 69, 1, 0, 0);
        aot_set(AOT_04_MESSAGE_PICTURE_YOUNG_MAN, 18500, 5700, 2000, 800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 135, 0, 69, 1, 0, 0);
        aot_set(AOT_05_MESSAGE_PICTURE_INFANT, 15300, 5700, 1400, 800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 0, 69, 1, 0, 0);
        aot_set(AOT_06_MESSAGE_PICTURE_BOY, 9800, 5700, 1400, 800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 0, 69, 1, 0, 0);
        aot_set(AOT_07_MESSAGE_PICTURE_OLD_MAN, 6000, 5700, 2500, 800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 138, 0, 69, 1, 0, 0);
        aot_set(AOT_08_EVENT_PICTURE_MOURNING, 1300, 3300, 1100, 1600, SCE_NONE, 0, 0, 0, 0, 0, 0, 0);
    }
    else
    {
        obj(OBJ_00_FALLING_FRAME, OF_ACTIVE, SCA_NONE, 1860, -3850, 3200, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        aot_set(AOT_01_EVENT_TITLE_PLAQUE, 6600, 6800, 5000, 1200, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, read_title_plaque, 0, 0, 0);
        aot_set(AOT_02_MESSAGE_PICTURE_MIDDLE_AGED, 15000, 6800, 2000, 800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_middle_aged_picture, 0, 0, 0);
        aot_set(AOT_03_MESSAGE_PICTURE_NEWBORN, 18500, 6800, 2000, 800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_newborn_picture, 0, 0, 0);
        aot_set(AOT_04_MESSAGE_PICTURE_YOUNG_MAN, 18500, 5700, 2000, 800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_young_man_picture, 0, 0, 0);
        aot_set(AOT_05_MESSAGE_PICTURE_INFANT, 15300, 5700, 1400, 800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_infant_picture, 0, 0, 0);
        aot_set(AOT_06_MESSAGE_PICTURE_BOY, 9800, 5700, 1400, 800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_boy_picture, 0, 0, 0);
        aot_set(AOT_07_MESSAGE_PICTURE_OLD_MAN, 6000, 5700, 2500, 800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_old_man_picture, 0, 0, 0);
        aot_set(AOT_08_EVENT_PICTURE_MOURNING, 1300, 3300, 1100, 1600, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_mourning_picture, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE) && ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        room_bgm_state_set(0, ROOM_117_LARGE_GALLERY, BGM_RELOAD | BGM_MAIN_ON);
    }
    enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_0, SPAWN_FORCE, 2, 0, 1024, 0, 19557, -5500, 10200, ENEMY_00_CROW, ANIM_00, 0, EVAR_00);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_1, SPAWN_FORCE, 2, 0, 1024, 0, 18500, -5500, 10200, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_2, SPAWN_FORCE, 2, 0, 1024, 0, 17500, -5500, 10200, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_3, SPAWN_FORCE, 2, 0, -1024, 0, 15000, -5000, 2600, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_4, SPAWN_FORCE, 2, 0, -1024, 0, 12000, -5000, 2600, ENEMY_04_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_5, SPAWN_FORCE, 2, 0, -1024, 0, 6000, -5000, 2600, ENEMY_05_CROW, ANIM_00, 0, EVAR_00);
    }
    else
    {
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_1, SPAWN_FORCE, 2, 0, 1024, 0, 17500, -5500, 10200, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_2, SPAWN_FORCE, 2, 0, -1024, 0, 12000, -5000, 2600, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_00, F_ENEMY_117_CROW_3, SPAWN_FORCE, 2, 0, -1024, 0, 6000, -5000, 2600, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_RADIO_CALL_DUE, TRUE))
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_RADIO_CALL_DUE, FALSE);
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_IN_SAVE_ROOM, TRUE))
                {
                    room_bgm_state_set(5, 23, BGM_RELOAD | 1);
                    plw_anim(PLW_02, ANIM_28, 0);
                    setw(W_04, 0);
                    cut_auto(CUT_LOCKED);
                    setb(B_CAMERA, CAM_00, 0);
                    evt_exec(0, TASK_09, radio_call_monsters);
                }
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_UPSTAIRS_CALL, TRUE))
                {
                    room_bgm_state_set(5, 23, BGM_RELOAD | 1);
                    plw_anim(PLW_02, ANIM_28, 0);
                    setw(W_04, 0);
                    cut_auto(CUT_LOCKED);
                    setb(B_CAMERA, CAM_00, 0);
                    evt_exec(0, TASK_09, radio_call_rebecca_upstairs);
                }
            }
        }
    }
}

event radio_call_monsters
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE) && ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        dir_set(0, 0, 754, 0, 3680, 0, 9970);
        sleep(1);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
        act_reset();
        evt_nop();
        run
        {
            bgm_play(BGM_SUB_1);
            set(FG_RUN, F_RUN_MONSTERS, FALSE);
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            evt_exec(0, TASK_09, radio_call_monsters_anim);
            voice_play(VOICE_PLAY, VO_00C_00);
            message(MSG_VO_00C_00, 0);
        }
        wait_message();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_32, 0, 0, 0, 0, 50);
        act_reset();
        evt_nop();
        sleep(30);
        voice_play(VOICE_PLAY, VO_00C_01);
        message(MSG_VO_00C_01, 0);
        wait_message();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_idle();
        act_reset();
        run
        {
            cut_auto(CUT_FREE);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_RUN, F_RUN_MONSTERS, TRUE);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_idle();
        act_reset();
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event radio_call_monsters_anim
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE) && ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
        sleep(20);
        act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
        sleep(30);
        act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
        sleep(20);
        act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
        sleep(30);
        act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
        sleep(20);
        act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
        sleep(70);
        act_motion_path(MOTION_31, 1250, 0, 0, 50, 0);
        act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
        sleep(20);
        act_motion(MOTION_10);
        act_reset();
        evt_nop();
    }
    evt_finish();
}

event radio_call_rebecca_upstairs
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE) && ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        dir_set(0, 0, 754, 0, 3680, 0, 9970);
        sleep(1);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
        act_reset();
        evt_nop();
        run
        {
            bgm_play(BGM_SUB_1);
            set(FG_RUN, F_RUN_MONSTERS, FALSE);
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            evt_exec(0, TASK_09, radio_call_rebecca_upstairs_anim);
            voice_play(VOICE_PLAY, VO_00C_20);
            message(MSG_VO_00C_20, 0);
        }
        wait_message();
        sleep(10);
        voice_play(VOICE_PLAY, VO_00C_21);
        sleep(56);
        sleep(10);
        voice_play(VOICE_PLAY, VO_00C_22);
        message(MSG_VO_00C_22, 0);
        wait_message();
        run
        {
            cut_auto(CUT_FREE);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_RUN, F_RUN_MONSTERS, TRUE);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_33, 0, 0, 0, 250, 250);
        act_idle();
        act_reset();
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event empty_event_mansion1
{
    evt_finish();
}
event radio_call_rebecca_upstairs_anim
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(40);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_motion_path(MOTION_33, -1700, -5000, 0, 150, 50);
    sleep(15);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    sleep(25);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(40);
    act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(40);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    act_flag_op(EF_OR, EF_0010);
    act_finish();
}
event empty_event_jill_mansion2
{
    evt_finish();
}

event reset_switch_order
{
    run
    {
        set(FG_ROOM, F_ROOM_ORDER_SPARE, FALSE);
        set(FG_ROOM, F_ROOM_ORDER_5_MIDDLE_AGED, FALSE);
        set(FG_ROOM, F_ROOM_ORDER_1_NEWBORN, FALSE);
        set(FG_ROOM, F_ROOM_ORDER_4_YOUNG_MAN, FALSE);
        set(FG_ROOM, F_ROOM_ORDER_2_INFANT, FALSE);
        set(FG_ROOM, F_ROOM_ORDER_3_BOY, FALSE);
        set(FG_ROOM, F_ROOM_ORDER_6_OLD_MAN, FALSE);
    }
    evt_finish();
}

event read_title_plaque
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_EFFECTS, FALSE);
        cutnext(CAM_07_TITLE_PLAQUE);
        message(MSG_THE_TITLE_IS_ALL_LIVING_THINGS | MSG_FAST, RUN_CONTROLS | RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "The title is “All living things are destined to die"."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_EFFECTS, TRUE);
        cutcurr(0);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event examine_middle_aged_picture
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_EFFECTS, FALSE);
    }
    message(MSG_A_PICTURE_OF_A_TIRED_MIDDLEAGED | MSG_FAST, RUN_CONTROLS | RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "A picture of a tired middle-aged man."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, FALSE))
        {
            evt_exec(0, TASK_09, middle_aged_switch);
        }
        else
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_RUN, F_RUN_MONSTERS, TRUE);
            set(FG_RUN, F_RUN_EFFECTS, TRUE);
        }
    }
    evt_finish();
}

