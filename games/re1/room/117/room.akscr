                    else
                    {
                        pos_set(ENEMY_05_CROW, 0, 2048, 0, 19000, -2000, 2897);
                    }
                }
            }
        }
    }
    run
    {
        if (ck(FG_ROOM, F_ROOM_WRONG_ORDER, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                bgm_play(BGM_MAIN);
            }
            get_eml_state(ENEMY_00_CROW);
            if (cmpb(B_0A, CMP_EQ, 0))
            {
                eml_state(0, ENEMY_00_CROW, EML_ACTION, AB_0D);
                eml_state(0, ENEMY_01_CROW, EML_ACTION, AB_0D);
                eml_state(0, ENEMY_02_CROW, EML_ACTION, AB_0D);
                eml_state(0, ENEMY_03_CROW, EML_ACTION, AB_0D);
            }
            if (cmpb(B_0A, CMP_EQ, 0) && ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
                {
                    eml_state(0, ENEMY_04_CROW, EML_ACTION, AB_0D);
                    eml_state(0, ENEMY_05_CROW, EML_ACTION, AB_0D);
                }
                else
                {
                    eml_state(0, ENEMY_04_CROW, EML_ACTION, AB_0D);
                    eml_state(0, ENEMY_05_CROW, EML_ACTION, AB_0D);
                }
            }
            evt_exec(0, TASK_09, pictures_become_messages);
        }
    }
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_EFFECTS, TRUE);
        set(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, FALSE);
        set(FG_ROOM, F_ROOM_LAST_SWITCH_BUSY, FALSE);
    }
    evt_finish();
}

event frame_falls
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE));
    sleep(10);
    se_play_3d(SND_BANK_ROOM, SE_18_FRAME_GA, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_work_set(WK_OBJ, OBJ_00_FALLING_FRAME);
    evt_tween_begin_alt();
    tw_set_rot(-50, 0, 0);
    for (2)
    {
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    sleep(15);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_05, 4429, 4443, F_ROOM_FRAME_STEP_BUSY);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, FALSE));
    act_idle();
    act_reset();
    run
    {
        dir_set(0, 0, 2048, 0, 4800, 0, 3950);
        set(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE);
        evt_exec(0, TASK_09, frame_shake_1);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE));
    evt_work_set(WK_OBJ, OBJ_00_FALLING_FRAME);
    evt_tween_begin_alt();
    tw_set_rot(-100, 0, 0);
    for (4)
    {
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE);
        evt_exec(0, TASK_09, frame_shake_2);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE));
    sleep(2);
    run
    {
        set(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE);
        evt_exec(0, TASK_09, frame_shake_3);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_FRAME_STEP_BUSY, TRUE));
    evt_work_set(WK_OBJ, OBJ_00_FALLING_FRAME);
    evt_tween_begin_alt();
    tw_set_rot(100, 0, 0);
    for (2)
    {
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_00_FALLING_FRAME);
    evt_tween_begin_alt();
    tw_set_pos(0, 40, 0);
    tw_set_rot(80, 0, 0);
    tw_pos_rot_add();
    evt_next();
    tw_set_rot(40, 0, 0);
    tw_pos_rot_add();
    evt_next();
    tw_set_pos(0, 70, 0);
    tw_pos_rot_add();
    evt_next();
    tw_set_rot(16, 0, 0);
    tw_pos_rot_add();
    evt_next();
    tw_set_pos(0, 120, 0);
    tw_pos_rot_add();
    evt_next();
    tw_set_pos(0, 100, 0);
    for (5)
    {
        tw_pos_rot_add();
        tw_pos_add();
        evt_next();
        tw_nop();
    }
    tw_nop();
    sleep(1);
    tw_abs_pos(0, 3440, 300, 3310);
    tw_abs_rot(0, 0, -120, 1024);
    tw_end();
    evt_nop();
    sleep(5);
    se_play_3d(SND_BANK_ROOM, SE_19_FRAME_FA, 0, SND_AT_POINT, 0, 2500, 3200);
    sleep(10);
    set(FG_RUN, F_RUN_MONSTERS, TRUE);
    sleep(10);
    run
    {
        cutcurr(0);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_EFFECTS, TRUE);
        objtbl_b_set(TBL_OBJ, OBJ_00_FALLING_FRAME, OF_80 | OF_ACTIVE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event pictures_become_messages
{
    run
    {
        aot_reset(AOT_02_MESSAGE_PICTURE_MIDDLE_AGED, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 325, 0);
        aot_reset(AOT_03_MESSAGE_PICTURE_NEWBORN, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 134, 325, 0);
        aot_reset(AOT_04_MESSAGE_PICTURE_YOUNG_MAN, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 135, 325, 0);
        aot_reset(AOT_05_MESSAGE_PICTURE_INFANT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 325, 0);
        aot_reset(AOT_06_MESSAGE_PICTURE_BOY, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 325, 0);
        aot_reset(AOT_07_MESSAGE_PICTURE_OLD_MAN, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 138, 325, 0);
        if (ck(FG_SCENARIO, F_SCENARIO_GALLERY_PUZZLE_SOLVED, TRUE))
        {
            aot_reset(AOT_08_EVENT_PICTURE_MOURNING, SCE_NONE, 0, 0, 0, 0);
        }
        else
        {
            aot_reset(AOT_08_EVENT_PICTURE_MOURNING, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 139, 325, 0);
        }
    }
    evt_finish();
}

event frame_shake_1
{
    evt_work_set(WK_OBJ, OBJ_00_FALLING_FRAME);
    evt_tween_begin_alt();
    tw_set_rot(-16, 0, 0);
    for (2)
    {
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_rot(-24, 0, 0);
    for (2)
    {
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_rot(-40, 0, 0);
    for (1)
    {
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_rot(-80, 0, 0);
