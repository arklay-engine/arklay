#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_213 0x00
#define AOT_01_DOOR_217 0x01
#define AOT_02_DOOR_218 0x02                                // Behind the bookshelf: usable only while the shelf is pushed aside.
#define AOT_03_ITEM_FILE_SCRAPBOOK_0 0x03
#define AOT_04_ITEM_AMMO_MAGNUM_1 0x04                      // In the drawer.
#define AOT_05_HIKIDASHI_DRAWER 0x05
#define AOT_06_USEITEM_SHELF_SPOT 0x06                      // The spot the bookshelf is pushed onto.
#define AOT_07_MESSAGE_BIOLOGY_BOOKS 0x07
#define AOT_08_MESSAGE_BIOLOGY_BOOKS 0x08
#define AOT_09_MESSAGE_BIOLOGY_BOOKS 0x09
#define AOT_0A_MESSAGE_VARIOUS_BOOKS 0x0A
#define AOT_0B_MESSAGE_DUSTY 0x0B                           // "It has not been used for a long time and is dusty."
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define F_ROOM_SHELF_PUSHED_ASIDE 0x18                      // The bookshelf sits on its spot: the door to 218 opens.
#define IMDL_00_FILE_SCRAPBOOK 0x00
#define IMDL_01_AMMO_MAGNUM 0x01
#define OBJ_00_BOOKSHELF 0x00

proc init
{
    door_aot_set(AOT_00_DOOR_213, 13600, 9500, 1700, 1900, 9, DOOR_SND_00_DR_WD, DOOR_04_DOOR04, 4, 0, ROOM_213_FRONT_ELEVATOR, 15800, 0, 16500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_217, 700, 2900, 1700, 1300, 3, DOOR_SND_00_DR_WD, DOOR_1E_DOOR03K, 5, 0, ROOM_217_LIBRARY_B, 10800, 0, 3700, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_218, 4200, 15300, 1000, 1500, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_218_HIDDEN_LIBRARY, 5000, 0, 2600, 3136, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_03_ITEM_FILE_SCRAPBOOK_0, 2600, 8700, 1500, 1500, IT_66_FILE_SCRAPBOOK, 1, IMDL_00_FILE_SCRAPBOOK, SCA_NONE, 3432, -800, 9407, 1024, F_ITEM_216_FILE_SCRAPBOOK_0, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_04_ITEM_AMMO_MAGNUM_1, 0, 2, 0, 2, IT_0E_AMMO_MAGNUM, 6, IMDL_01_AMMO_MAGNUM, SCA_NONE, 13520, -1440, 14040, -2710, F_ITEM_216_AMMO_MAGNUM_1, 0, 0);
    setbyte(1, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_HIDDEN_LIBRARY_ENTERED, TRUE))
    {
        obj(OBJ_00_BOOKSHELF, OF_10 | OF_ACTIVE, SCA_NONE, 2532, 0, 15307, 1024, 0, -270, 0, 270, 270, 3420, 1260, 540);
    }
    else
    {
        obj(OBJ_00_BOOKSHELF, OF_10 | OF_ACTIVE, SCA_NONE, 4732, 0, 15307, 1024, 0, -270, 0, 270, 270, 3420, 1260, 540);
    }
    aot_set(AOT_05_HIKIDASHI_DRAWER, 13100, 14000, 1100, 1200, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 32, 0, 4, 0, 6, 0);
    aot_set(AOT_06_USEITEM_SHELF_SPOT, 2486, 15307, 500, 500, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 24, 0, 1, 0);
    aot_set(AOT_07_MESSAGE_BIOLOGY_BOOKS, 1300, 5300, 1300, 7300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 126, 255, 0, 0);
    aot_set(AOT_08_MESSAGE_BIOLOGY_BOOKS, 1300, 4400, 3000, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 126, 255, 0, 0);
    aot_set(AOT_09_MESSAGE_BIOLOGY_BOOKS, 1300, 11600, 3000, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 126, 255, 0, 0);
    aot_set(AOT_0A_MESSAGE_VARIOUS_BOOKS, 1300, 1000, 7300, 1700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 126, 255, 0, 0);
    aot_set(AOT_0B_MESSAGE_DUSTY, 5700, 5500, 2200, 7000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 126, 255, 0, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_216_ZOMBIE_GROUNDSKEEPER_0, SPAWN_FORCE, 2, 0, 512, 0, 9325, 0, 12878, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_01, F_ENEMY_216_ZOMBIE_GROUNDSKEEPER_1, SPAWN_FORCE, 2, 0, 2048, 0, 4000, 0, 9000, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
    set(FG_SCENARIO, F_SCENARIO_LIBRARY_ENTERED, TRUE);
}

proc main when (MANSION2)
{
    if (ck(FG_ROOM, F_ROOM_SHELF_PUSHED_ASIDE, TRUE))
    {
        set(FG_ROOM, F_ROOM_SHELF_PUSHED_ASIDE, FALSE);
        aot_delete(AOT_02_DOOR_218, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_02_DOOR_218, SCE_DOOR, 0);
    }
}
