proc init
{
    door_aot_set(AOT_00_DOOR, 14200, 7000, 1800, 2600, 1, 0, 2, 1, 0, ROOM_103_F_PASSAGE, 21800, 0, 19100, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
