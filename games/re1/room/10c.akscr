    effect(19, 0, 0, 3, 31, 38, 248, 56, 21, 0, 0);
    effect(27, 0, 0, 4, 31, 234, 247, 74, 21, 0, 0);
    evt_exec(0, 9, on_enter);
    snd_pan_vol_set(1, 110, 110);
