        enemy(EM_0F_PLANT_FOUNTAIN, 6, 255, 1, 2, 0, 0, 3000, 0, 0, 7900, 0, 6100, ENEMY_01_PLANT_FOUNTAIN, 0, 0, 0);
        enemy(EM_0F_PLANT_FOUNTAIN, 6, 255, 1, 2, 0, 0, 100, 0, 0, 8200, 0, 6200, ENEMY_02_PLANT_FOUNTAIN, 0, 0, 0);
        enemy(EM_0F_PLANT_FOUNTAIN, 6, 255, 1, 2, 0, 0, 1000, 0, 0, 7900, 0, 4700, ENEMY_03_PLANT_FOUNTAIN, 0, 0, 0);
        enemy(EM_0F_PLANT_FOUNTAIN, 6, 255, 1, 2, 0, 0, 1000, 0, 0, 8400, 0, 4900, ENEMY_04_PLANT_FOUNTAIN, 0, 0, 0);
        enemy(EM_0F_PLANT_FOUNTAIN, 6, 255, 1, 2, 0, 0, 1000, 0, 0, 8200, 0, 4800, ENEMY_05_PLANT_FOUNTAIN, 0, 0, 0);
    }
#else
