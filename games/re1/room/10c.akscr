proc main
{
    if (cmpb(B_CAMERA, CMP_EQ, 0))
    {
        snd_pan_vol_set(1, 110, 110);
    }
    if (cmpb(B_CAMERA, CMP_EQ, 1))
    {
        snd_pan_vol_set(1, 50, 50);
    }
    if (cmpb(B_CAMERA, CMP_EQ, 2))
    {
        snd_pan_vol_set(1, 50, 50);
    }
    if (cmpb(B_CAMERA, CMP_EQ, 3))
    {
        snd_pan_vol_set(1, 50, 50);
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_A6, FALSE))
    {
        if (testitem(IT_26_KEY_HERBICIDE))
        {
            if (ck(FG_ROOM, F_ROOM_20, TRUE))
            {
                evt_exec(0, 9, from_main);
            }
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_A9, FALSE))
    {
        if (testitem(IT_26_KEY_HERBICIDE))
        {
            if (ck(FG_ROOM, F_ROOM_20, TRUE))
            {
                evt_exec(0, 9, from_main);
            }
        }
    }
#endif
    if (ck(FG_SCENARIO, F_SCENARIO_5B, TRUE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_5C, FALSE))
        {
            set(FG_SCENARIO, F_SCENARIO_5C, TRUE);
            evt_exec(0, 9, from_main_2);
        }
    }
}

event event_00
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
        message(MSG_AN_OLD_PUMP, 0); // "An old pump. Water seems to be sent from here. The lid is open!"
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_ROOM, F_ROOM_00, TRUE);
    set(FG_6, F_6_17, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event from_main
{
    run
    {
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_6, F_6_17, FALSE);
#if CHRIS
        effect_clear(0);
#endif
    }
    sleep(10);
    run
    {
        cutnext(4);
        dir_set(0, 0, 0, 0, 0, 0, 0);
        effect_kill_b(19, 0, 0);
        effect_kill_b(27, 0, 0);
        effect(19, 8, 0, 3, 31, 38, 248, 56, 21, 0, 0);
        effect(27, 8, 0, 4, 31, 234, 247, 74, 21, 0, 0);
    }
    for (10)
    {
        model_op(0, 0, 0, 255, 2, 0, 0);
        sleep(8);
    }
    evt_nop();
    sleep(30);
    dir_set(0, 0, 3100, 0, 16200, 0, 4900);
    cutnext(1);
    sleep(50);
    run
    {
        eml_state(0, ENEMY_00_PLANT_FOUNTAIN, EML_BEHAVIOUR, 40);
        eml_state(0, ENEMY_01_PLANT_FOUNTAIN, EML_BEHAVIOUR, 41);
        eml_state(0, ENEMY_02_PLANT_FOUNTAIN, EML_BEHAVIOUR, 40);
        eml_state(0, ENEMY_03_PLANT_FOUNTAIN, EML_BEHAVIOUR, 40);
        eml_state(0, ENEMY_04_PLANT_FOUNTAIN, EML_BEHAVIOUR, 40);
        eml_state(0, ENEMY_05_PLANT_FOUNTAIN, EML_BEHAVIOUR, 40);
    }
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(47110, 9252, 8467);
    act_nop();
    act_reset();
    evt_nop();
    sleep(150);
    cutnext(2);
    run
    {
        eml_state(0, ENEMY_00_PLANT_FOUNTAIN, EML_BEHAVIOUR, 64);
        eml_state(0, ENEMY_01_PLANT_FOUNTAIN, EML_BEHAVIOUR, 64);
        eml_state(0, ENEMY_02_PLANT_FOUNTAIN, EML_BEHAVIOUR, 64);
        eml_state(0, ENEMY_03_PLANT_FOUNTAIN, EML_BEHAVIOUR, 64);
        eml_state(0, ENEMY_04_PLANT_FOUNTAIN, EML_BEHAVIOUR, 64);
        eml_state(0, ENEMY_05_PLANT_FOUNTAIN, EML_BEHAVIOUR, 64);
    }
    sleep(150);
    cutnext(0);
    sleep(10);
    run
    {
#if CHRIS
        set(FG_COMMON, F_COMMON_A6, TRUE);
#else
        set(FG_COMMON, F_COMMON_A9, TRUE);
#endif
        set(FG_6, F_6_17, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_enter
{
    evt_work_set(WK_AOT, AOT_00_DOOR);
    evt_tween_begin_alt();
    tw_abs_rot(0, 1010, 20, 1130);
    tw_end();
    evt_nop();
    evt_finish();
}

event from_main_2
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        message(MSG_IT_DOES_NOT_SEEM_TO_CAUSE | MSG_FAST, 0); // "It does not seem to cause any damage."
    }
    sleep(30);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_6, F_6_17, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
}
