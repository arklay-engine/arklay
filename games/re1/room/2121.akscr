#version 1

proc init
{
    door_aot_set(0, 16800, 26400, 2200, 2200, 3, 0, 6, 4, 0, RDT_011, 3000, 0, 12000, 1024, UNLOCKED, 129);
    item_aot_set(1, 23500, 19770, 1000, 1000, ITEM_BAZOOKA_ACID, 6, 0, 255, 192, 93, 0, 0, 46, 79, 6, 6, 6, 129, 1, 0);
    enemy(ENEMY_FORREST, 0, 255, 1, 2, 0, 0, 1936, 0, 0, 25150, 0, 18700, 0, 0, 0, 0);
    if (ck(FG_COMMON, 7, 1) && ck(FG_COMMON, 33, 1) && ck(FG_COMMON, 79, 0) && ck(FG_SCENARIO, 103, 1))
    {
        if (ck(FG_COMMON, 94, 1))
        {
            enemy(ENEMY_BARRY_STARS_, 4, 255, 1, 2, 0, 0, 52, 0, 0, 22680, 0, 26170, 1, 0, 0, 0);
            if (ck(FG_COMMON, 95, 1))
            {
                set(FG_COMMON, 95, 0);
                evt_exec(0, 9, event_05);
            }
            else
            {
                room_bgm_state_set(1, 18, 32);
                pos_set(1, 0, 900, 0, 24000, 0, 21000);
                evt_exec(0, 9, event_03);
                aot_set(3, 23000, 20000, 2000, 2000, SCE_EVENT, 129, 9, 0, event_02, 0, 0, 0);
            }
        }
        else
        {
            room_bgm_state_set(1, 18, 32);
            evt_exec(0, 9, event_2A);
            evt_exec(0, 9, event_2B);
            room_bgm_state_set(1, 18, 32);
            enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
            enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
            enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
        }
    }
    else
    {
        set(FG_SCENARIO, 103, 0);
        evt_exec(0, 9, event_2A);
        evt_exec(0, 9, event_2B);
        if (ck(FG_COMMON, 94, 1))
        {
            enemy(ENEMY_CROW, 130, 255, 1, 2, 0, 0, 3000, 0, 0, 19000, -3000, 20000, 1, 0, 0, 0);
            enemy(ENEMY_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19100, -4000, 21000, 2, 0, 0, 0);
            enemy(ENEMY_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19200, -3500, 20000, 3, 0, 0, 0);
            aot_set(3, 22600, 18000, 2900, 2250, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
        }
        else
        {
            room_bgm_state_set(1, 18, 32);
            enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
            enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
            enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
        }
    }
}

event event_00
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        bgm_stop(0);
    }
    sleep(2);
    run
    {
        set(FG_COMMON, 66, 0);
        set(FG_COMMON, 94, 0);
        aot_reset(3, SCE_NONE, 0, 0, 0, 0);
        cutnext(3);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 31, 0 | 3);
    act_reset();
    evt_nop();
    sleep(30);
    run
    {
        bgm_play(1);
    }
    message(143, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    evt_fork(9, event_27, 0);
    evt_fork(9, event_28, 0);
    evt_fork(9, event_29, 0);
    cutnext(4);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_STATUS, 15, 1);
    sleep(20);
    run
    {
        set(FG_6, 23, 0);
        cutnext(2);
        cut_auto(0);
    }
    evt_finish();
}

