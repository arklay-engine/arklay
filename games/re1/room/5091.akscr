#version 1

proc init
{
    door_aot_set(0, 3000, 1300, 1200, 1200, 3, 1, 12, 7, 0, RDT_008, 11300, 0, 4800, 1024, UNLOCKED, 129);
    item_aot_set(1, 0, 0, 1, 1, ITEM_6B, 1, 0, 255, 168, 97, 48, 117, 168, 97, 0, 0, 82, 129, 0, 0);
    item_aot_set(2, 1200, 7400, 800, 1300, ITEM_65, 1, 1, 255, 164, 6, 94, 247, 154, 31, 0, 0, 83, 129, 0, 0);
    item_aot_set(7, 9000, 9000, 2700, 1900, ITEM_INK_RIBBON, 2, 2, 255, 0, 0, 0, 0, 0, 0, 0, 0, 230, 129, 0, 0);
    aot_set(3, 9900, 1700, 2000, 2100, SCE_USEITEM, 1, 9, 0, 13, 0, 1, 0);
    aot_set(4, 9900, 1700, 2000, 2100, SCE_NONE, 129, 0, 0, 0, 0, 0, 0);
    aot_set(5, 5900, 1700, 1800, 3400, SCE_MESSAGE, 129, 130, 0, 255, 0, 0, 0);
    aot_set(6, 11700, 4000, 1100, 1900, SCE_MESSAGE, 129, 131, 0, 255, 0, 0, 0);
    aot_set(8, 9000, 9000, 2700, 1900, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    aot_set(9, 1400, 8900, 800, 1100, SCE_MESSAGE, 129, 133, 0, 255, 0, 0, 0);
    enemy(ENEMY_ZOMBIE_NAKED_, 0, 92, 1, 1, 0, 0, 360, 0, 0, 2900, 0, 6400, 0, 0, 0, 0);
    enemy(ENEMY_ZOMBIE_NAKED_, 0, 93, 1, 1, 0, 0, 1024, 0, 0, 6100, 0, 8900, 1, 0, 0, 0);
    enemy(ENEMY_ZOMBIE_NAKED_, 0, 94, 1, 1, 0, 0, 1024, 0, 0, 10200, 0, 9700, 2, 0, 0, 0);
    enemy(ENEMY_ZOMBIE_NAKED_, 0, 95, 1, 1, 0, 0, 2700, 0, 0, 8500, 0, 3800, 3, 0, 0, 0);
    eml_rot(1, 0, 0, 244, 11);
}

proc main
{
    if (ck(FG_ITEM, 82, 0))
    {
        aot_reset(4, SCE_EVENT, 129, 9, event_00, 0);
        aot_reset(3, SCE_USEITEM, 1, 9, 13, 1);
    }
    else
    {
        aot_reset(4, SCE_MESSAGE, 129, 129, 69, 0);
        aot_reset(3, SCE_NONE, 129, 0, 0, 0);
    }
    if (testitem(ITEM_MO_DISK))
    {
        evt_exec(0, 9, event_01);
    }
}

event event_00
{
    run
    {
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
        set(FG_6, 25, 1);
        cut_auto(1);
        cutnext(4);
        message(128, 69);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        set(FG_6, 25, 0);
        cutcurr(0);
        cut_auto(0);
    }
    evt_finish();
}

event event_01
{
    sleep(1);
    aot_on(1, SCE_DOCUMENT, 0);
    evt_finish();
}
