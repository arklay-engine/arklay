#version 1

proc init
{
    door_aot_set(0, 900, 3400, 1700, 1900, 2, 0, 0, 9, 0, RDT_009, 9100, 0, 7700, 2048, UNLOCKED, 129);
    door_aot_set(1, 5700, 6400, 1400, 1200, 2, 0, 29, 5, 0, RDT_007, 17000, 0, 11300, 3072, UNLOCKED, 129);
    door_aot_set(2, 10200, 4000, 1400, 1100, 1, 0, 0, 7, 0, RDT_00A, 2600, 0, 5500, 0, UNLOCKED, 129);
    aot_set(3, 1000, 3900, 1100, 1200, SCE_NONE, 129, 9, 0, 0, 0, 0, 0);
    if (ck(FG_SCENARIO, 0, 1))
    {
        if (ck(FG_SCENARIO, 5, 0))
        {
            enemy(ENEMY_ZOMBIE_RESEARCHER_, 4, 23, 1, 2, 0, 0, 3072, 0, 0, 6000, 0, 3300, 0, 0, 0, 0);
        }
        else
        {
            if (ck(FG_ENEMY, 20, 1))
            {
                aot_delete(0, SCE_NONE, 129);
                aot_delete(3, SCE_EVENT, 129);
            }
            else
            {
                require(ck(FG_ENEMY, 19, 1));
                aot_delete(0, SCE_NONE, 129);
                aot_delete(3, SCE_EVENT, 129);
            }
            enemy(ENEMY_ZOMBIE_RESEARCHER_, 4, 23, 1, 2, 0, 0, 0, 0, 0, 20000, 0, 20000, 0, 0, 0, 0);
        }
    }
}

proc main
{
    if (ck(FG_SCENARIO, 0, 1))
    {
        if (ck(FG_ROOM, 24, 1) && ck(FG_SCENARIO, 5, 1))
        {
            evt_exec(0, 9, event_02);
            set(FG_ROOM, 24, 0);
        }
    }
}

event event_00
{
    run
    {
        aot_delete(0, SCE_DOOR, 129);
        aot_delete(3, SCE_NONE, 129);
        set(FG_SCENARIO, 5, 0);
        set(FG_ENEMY, 23, 0);
        if (ck(FG_ENEMY, 20, 1))
        {
            set(FG_ENEMY, 20, 0);
            set(FG_ENEMY, 23, 1);
            evt_exec(0, 9, event_01);
        }
        else
        {
            require(ck(FG_ENEMY, 19, 1));
            set(FG_ENEMY, 19, 0);
            set(FG_ENEMY, 23, 1);
            evt_exec(0, 9, event_01);
        }
    }
    evt_finish();
}

event event_01
{
    evt_fork(9, event_03, 0);
    set(FG_6, 23, 1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(38918, 31752, 6421);
    act_nop();
    act_param_set(0, 4);
    act_flag_op(0, 2, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 25, 1));
    act_reset();
    evt_nop();
    se_play_3d(0, 0, 0, 0, 0, 6400, 6300);
    set(FG_ROOM, 25, 1);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 14, 0 | 25, 0 | 1);
    act_param_set(0, 4);
    act_flag_op(0, 2, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 25, 1));
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, 29, 0);
        pos_set(0, 0, 1600, 0, 5900, 0, 6100);
        se_play_3d(0, 1, 0, 0, 0, 6400, 6300);
        eml_state(0, 0, 0, 0);
        cutnext(0);
        set(FG_ROOM, 26, 0);
    }
    sleep(30);
    cutcurr(0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_6, 23, 0);
    evt_finish();
}

event event_02
{
    sleep(3);
    set(FG_6, 29, 1);
    evt_finish();
}

event event_03
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(147, 1, 0, 0, 16, 8);
    sleep(30);
    act_motion_bitclr();
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 26, 1));
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    sleep(30);
    act_motion_bitclr();
    act_nop();
    act_finish();
}
