#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

proc init
{
#if MANSION2
    set(FG_STATUS, FLAG_STATUS_1C, TRUE);
#endif
    door_aot_set(0, 15200, 2400, 2000, 2600, 9, 0, 0, 1, 0, ROOM_109_TRAP_PASSAGE, 2700, 0, 8500, 0, UNLOCKED, 129);
    door_aot_set(1, 1800, 1000, 2400, 1400, 2, 0, 30, 5, 64, ROOM_117_LARGE_GALLERY, 2900, 0, 10000, 0, UNLOCKED, 129);
    door_aot_set(2, 7800, 5200, 1500, 1700, 1, 0, 1, 4, 216, ROOM_119_STUDY, 6300, 0, 2700, 3072, ITEM_36_KEY_MANSION_HELMET, 129);
    door_aot_set(3, 10600, 5200, 2000, 1700, 2, 0, 2, 1, 148, ROOM_10B_1F_RIGHT_STAIRS, 3300, 0, 6600, 3072, LOCK, 129);
#if MANSION1
    door_aot_set(4, 200, 10700, 2000, 2300, 0, 1, 8, 0, 64, ROOM_11A_ROOFED_PASSAGE, 4500, 0, 4100, 2048, UNLOCKED, 129);
    enemy(ENEMY_11_ZOMBIE_LAB, 0, 113, 1, 2, 0, 0, 0, 0, 0, 8272, 0, 2433, 0, 0, 0, 0);
    enemy(ENEMY_11_ZOMBIE_LAB, 0, 114, 1, 2, 0, 0, 1031, 0, 0, 3023, 0, 6864, 1, 0, 0, 0);
#else
#if CHRIS
    door_aot_set(4, 200, 10700, 2000, 2300, 0, 1, 8, 0, 64, ROOM_11A_ROOFED_PASSAGE, 4500, 0, 4100, 2048, UNLOCKED, 129);
    if (ck(FG_COMMON, FLAG_COMMON_2B, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_64, TRUE))
        {
            set(FG_COMMON, FLAG_COMMON_36, TRUE);
        }
        if (ck(FG_COMMON, FLAG_COMMON_59, TRUE) && ck(FG_COMMON, FLAG_COMMON_5D, FALSE))
        {
            set(FG_COMMON, FLAG_COMMON_36, TRUE);
        }
        aot_set(5, 0, 400, 5600, 6100, SCE_EVENT, 65, 0, 0, event_00, 0, 0, 0);
        enemy(ENEMY_06_HUNTER, 167, 2, 1, 2, 0, 0, 0, 0, 0, 20000, 20000, 20000, 0, 0, 0, 0);
    }
    else
    {
        enemy(ENEMY_06_HUNTER, 39, 2, 1, 2, 0, 0, 896, 0, 0, 4561, 0, 4818, 0, 0, 0, 0);
    }
#else
    door_aot_set(4, 200, 10700, 2000, 2300, 0, 1, 8, 0, 0, ROOM_11A_ROOFED_PASSAGE, 4500, 0, 4100, 2048, UNLOCKED, 129);
    if (ck(FG_COMMON, FLAG_COMMON_28, FALSE))
    {
        aot_set(5, 0, 400, 5600, 6100, SCE_EVENT, 65, 0, 0, event_00, 0, 0, 0);
        enemy(ENEMY_06_HUNTER, 167, 2, 1, 2, 0, 0, 0, 0, 0, 20000, 20000, 20000, 0, 0, 0, 0);
    }
    else
    {
        enemy(ENEMY_06_HUNTER, 39, 2, 1, 2, 0, 0, 896, 0, 0, 4561, 0, 4818, 0, 0, 0, 0);
    }
#endif
    return;
#endif
}
#if MANSION2

#if CHRIS
proc main
{
    if (ck(FG_ENEMY, FLAG_ENEMY_02, TRUE) && ck(FG_COMMON, FLAG_COMMON_21, TRUE))
    {
        set(FG_COMMON, FLAG_COMMON_21, FALSE);
        if (ck(FG_COMMON, FLAG_COMMON_22, TRUE))
        {
            setw(4, 0, 0);
            evt_exec(0, 9, event_02);
        }
        if (ck(FG_COMMON, FLAG_COMMON_36, TRUE))
        {
            setw(4, 0, 0);
            evt_exec(0, 9, event_04);
        }
    }
    return;
}

#endif
event event_00
{
    run
    {
        aot_delete(5, SCE_NONE, 0);
#if CHRIS
        set(FG_COMMON, FLAG_COMMON_2B, TRUE);
#else
        set(FG_COMMON, FLAG_COMMON_28, TRUE);
#endif
        bgm_stop_all(0);
    }
    sleep(1);
    movie_on(6);
    sleep(1);
    run
    {
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        bgm_restore(0);
        dir_set(0, 0, 304, 0, 2276, 0, 3481);
        set(FG_6, FLAG_6_17, FALSE);
        cutnext(2);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 0, 32 | 31, 0 | 0);
    act_reset();
    evt_nop();
    sleep(10);
#if CHRIS
    evt_fork(9, event_06, 0);
#else
    evt_fork(9, event_02, 0);
#endif
    se_play_3d(0, 0, 0, 0, 0, 2468, 11628);
    sleep(30);
    se_play_3d(0, 1, 0, 0, 0, 2468, 11628);
    sleep(20);
    run
    {
        pos_set(0, 0, 914, 0, 2524, 0, 12163);
        eml_state(0, 0, 0, 103);
#if CHRIS
        dir_set(0, 0, 0, 0, 4880, 0, 3549);
#else
        dir_set(0, 0, 304, 0, 4890, 0, 3549);
#endif
    }
    evt_fork(9, event_01, 0);
    cutnext(3);
    sleep(100);
    run
    {
        dir_set(0, 0, 3144, 0, 2260, 0, 2984);
        pos_set(0, 0, 914, 0, 2665, 0, 8864);
        eml_state(0, 0, 0, 39);
        cutnext(2);
        cut_auto(0);
        set(FG_6, FLAG_6_17, TRUE);
#if CHRIS
        set(FG_COMMON, FLAG_COMMON_21, TRUE);
#endif
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    }
    evt_finish();
}

event event_01
{
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_seq(55554, 3595, 16160);
    act_finish();
}

#if CHRIS
event event_02
{
    run
    {
        bgm_play(1);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        evt_exec(0, 9, event_03);
        voice_play(1, 84, 0);
        message(0, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(1, 85, 0);
    message(1, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(0);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    evt_finish();
}

event event_03
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(70);
    act_motion_path(49, 1250, 0, 0, 50, 0);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_motion(16);
    act_reset();
    evt_nop();
    evt_finish();
}

event event_04
{
    run
    {
        bgm_play(1);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        evt_exec(0, 9, event_05);
        voice_play(1, 100, 0);
        message(2, 0);
    }
    sleep(40);
    wait_message();
    sleep(10);
    voice_play(1, 101, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, FLAG_STATUS_0E, TRUE));
    sleep(10);
    voice_play(1, 102, 0);
    message(3, 0);
    wait_message();
    run
    {
        cut_auto(0);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 0, 0, 0, 250, 250);
    act_idle();
    act_reset();
    set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    evt_finish();
}

event event_05
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(30);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(40);
    act_motion_path(51, 1700, 60536, 0, 150, 50);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(20);
    act_motion_path(51, 63836, 60536, 0, 150, 50);
    sleep(15);
    act_motion_path(51, 1700, 60536, 0, 150, 50);
    sleep(25);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    sleep(40);
    act_anim_flags(32 | 10, 32 | 31, 0 | 0);
    sleep(40);
    act_anim_flags(32 | 8, 32 | 31, 0 | 0);
    act_flag_op(0, 16, 0);
    act_finish();
}

event event_06
#else
event event_02
#endif
{
    sleep(37);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 31, 0 | 0);
