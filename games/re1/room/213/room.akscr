#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_216 0x00
#define AOT_01_DOOR_200 0x01
#define AOT_02_DOOR_219 0x02
#define AOT_03_DOOR_214 0x03
#define AOT_04_ITEM_HEAL_HERB_GREEN_0 0x04
#define ENEMY_00_ZOMBIE_GREEN 0x00
#define ENEMY_01_ZOMBIE_GREEN 0x01
#define ENEMY_02_ZOMBIE_GREEN 0x02
#define IMDL_00_HEAL_HERB_GREEN 0x00

proc init
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
    {
        door_aot_set(AOT_00_DOOR_216, 13700, 15400, 1600, 3900, 6, DOOR_SND_00_DR_WD, DOOR_04_DOOR04, 4, 0, ROOM_216_LIBRARY_A, 13600, 0, 10300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_01_DOOR_200, 13700, 5300, 1700, 3900, 0, DOOR_SND_0A_EV_OLD, DOOR_10_ELE03, 64, 0, ROOM_200_1F_B1_ELEVATOR, 0, 0, 0, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_02_DOOR_219, 7300, 2000, 1500, 1800, 1, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_219_SHED, 7400, 0, 2900, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_03_DOOR_214, 0, 5600, 1900, 2700, 3, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_214_ROUGH_PASSAGE, 22800, 0, 6300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        item_aot_set(AOT_04_ITEM_HEAL_HERB_GREEN_0, 11990, 11200, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_00_HEAL_HERB_GREEN, SCA_NONE, 12890, 0, 12100, 0, F_ITEM_213_HEAL_HERB_GREEN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            enemy(EM_11_ZOMBIE_GREEN, EB_01, F_ENEMY_213_ZOMBIE_GREEN_0, SPAWN_FORCE, 2, 0, 3384, 0, 9623, 0, 7537, ENEMY_00_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
            enemy(EM_11_ZOMBIE_GREEN, EB_00, F_ENEMY_213_ZOMBIE_GREEN_0_2, SPAWN_FORCE, 2, 0, 3592, 0, 15740, 0, 3314, ENEMY_01_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
            enemy(EM_11_ZOMBIE_GREEN, EB_01, F_ENEMY_213_ZOMBIE_GREEN_1, SPAWN_FORCE, 2, 0, 1136, 0, 16355, 0, 21978, ENEMY_02_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_11_ZOMBIE_GREEN, EB_00, F_ENEMY_213_ZOMBIE_GREEN_0_2, SPAWN_FORCE, 2, 0, 3592, 0, 15740, 0, 3314, ENEMY_00_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
            enemy(EM_11_ZOMBIE_GREEN, EB_01, F_ENEMY_213_ZOMBIE_GREEN_1, SPAWN_FORCE, 2, 0, 1136, 0, 16355, 0, 21978, ENEMY_01_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
        }
    }
}
