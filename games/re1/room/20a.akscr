event on_aot_02_message
{
    message(131, 255); // "It seems someone has searched here already...It appears to be a switch. Will you push it?There's something at the back of the shelf."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 1, on_aot_02_message_sub1);
        }
    }
    evt_finish();
}

event on_aot_02_message_sub1
{
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 3200, 1800);
        set(FG_6, FLAG_6_17, FALSE);
        cutnext(5);
        set(FG_ROOM, FLAG_ROOM_0A, TRUE);
    }
    sleep(10);
    evt_fork(2, on_aot_02_message_sub1_sub1, 0);
    set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(113, 400, 0, 1, 100, 64);
    sleep(16);
    act_motion_path(17, 6565, 62936, 5035, 180, 64);
    sleep(8);
    act_motion(16);
    act_anim_flags(32 | 13, 32 | 4, 0 | 0);
    act_flag_op(0, 2, 0);
    act_param_set(0, 252);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_24, FALSE));
    act_motion_path(17, 6565, 62936, 5035, 240, 64);
    act_reset();
    evt_nop();
    sleep(10);
    cutnext(4);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_02, FALSE));
    cutnext(5);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 20000, 0);
    tw_end();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_reset();
    evt_nop();
    run
    {
        aot_reset(AOT_02_MESSAGE, SCE_NONE, 0, 0, 0, 0);
        aot_reset(AOT_06_USEITEM, SCE_NONE, 0, 0, 0, 0);
        set(FG_SCENARIO, FLAG_SCENARIO_12, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        set(FG_6, FLAG_6_17, TRUE);
        cut_auto(0);
        sys_multi(7);
    }
    evt_finish();
}

event on_aot_01_message
{
    run
    {
        aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, 129, 133, 255, 0);
        aot_reset(AOT_08_ITEM, SCE_DOCUMENT, 129, 0, 0, 0);
        aot_on(AOT_08_ITEM, SCE_DOCUMENT, 0);
#if CHRIS
        set(FG_COMMON, FLAG_COMMON_07, TRUE);
#else
        set(FG_COMMON, FLAG_COMMON_08, TRUE);
#endif
    }
    evt_finish();
}

event from_main
{
    objtbl_b_set(0, 0, 17);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 16, 32 | 4, 0 | 0);
    sleep(10);
    act_anim_flags(32 | 17, 32 | 4, 0 | 0);
    act_flag_op(0, 16, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck_bits(0, 1, 0));
    set(FG_6, FLAG_6_17, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 4, 0 | 0);
    sleep(10);
    act_idle();
    act_reset();
    run
    {
        objtbl_b_set(0, 0, 1);
        set(FG_ROOM, FLAG_ROOM_01, FALSE);
        message(129, 255); // "It's too heavy to move."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_6, FLAG_6_19, TRUE);
    set(FG_6, FLAG_6_17, TRUE);
    evt_finish();
}

#if JILL
event on_enter
{
    evt_fork(1, on_enter_sub1, 0);
    evt_next();
    evt_nop();
    set(FG_6, FLAG_6_17, FALSE);
    cut_auto(1);
    sleep(10);
    set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    sleep(20);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_motion_path(51, 64824, 0, 0, 192, 64);
    sleep(10);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(147, 1, 0, 0, 192, 64);
    act_reset();
    evt_nop();
    cutnext(1);
    evt_disable(1);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 5, 0 | 0);
    act_flag_op(0, 2, 0);
    act_param_set(0, 8);
    sleep(4);
    act_motion(16);
    sleep(16);
    act_anim_flags(32 | 1, 32 | 5, 0 | 0);
    act_flag_op(0, 2, 0);
    sleep(6);
    act_anim_flags(0 | 2, 32 | 5, 0 | 0);
    act_flag_op(0, 2, 0);
    sleep(4);
    act_reset();
    evt_nop();
    voice_play(1, 25, 0);
    message(9, 0);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_motion_path(113, 200, 0, 2, 50, 64);
    act_anim_flags(32 | 5, 32 | 5, 0 | 0);
    act_flag_op(0, 2, 0);
    sleep(15);
    act_anim_flags(32 | 1, 32 | 5, 0 | 0);
    sleep(25);
    act_anim_flags(32 | 2, 32 | 5, 0 | 0);
    act_reset();
    evt_nop();
    wait_message();
    cutnext(0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 6, 32 | 5, 0 | 0);
