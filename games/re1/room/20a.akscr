    act_motion_path(51, 0, 300, 0, 20, 44);
    sleep(10);
    act_motion_path(51, 200, 300, 0, 20, 44);
    sleep(10);
    act_motion_path(51, 65336, 300, 0, 20, 44);
    sleep(10);
    act_reset();
    evt_chain(5);
    evt_finish();
}

