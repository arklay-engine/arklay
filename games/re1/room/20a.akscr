event on_aot_02_message_sub1_sub1
{
    se_play_3d(2, 25, 0, 0, 0, 7470, 5980);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 10, 0);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    set(FG_ROOM, FLAG_ROOM_02, TRUE);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 10, 0);
    for (5)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_finish();
}
