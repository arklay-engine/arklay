#version 1

proc init
{
    door_aot_set(0, 1900, 25800, 2100, 1900, 3, 1, 8, 0, 0, RDT_008, 12600, 0, 27300, 2048, UNLOCKED, 129);
    door_aot_set(1, 0, 3500, 2400, 1900, 3, 1, 8, 0, 0, RDT_008, 11000, 0, 3300, 2048, UNLOCKED, 129);
    door_aot_set(2, 13900, 0, 2100, 2600, 0, 1, 8, 0, 0, RDT_00A, 4100, 0, 20000, 1024, UNLOCKED, 129);
    item_aot_set(131, 25000, 19000, 1000, 1000, ITEM_EXPLOSIVE_ROUNDS, 6, 0, 255, 156, 99, 174, 247, 44, 76, 0, 0, 45, 129, 0, 0);
    item_aot_set(132, 25000, 20900, 1000, 1000, ITEM_F_AID_SPRAY, 1, 1, 255, 156, 99, 174, 247, 152, 83, 0, 0, 248, 129, 0, 0);
    if (ck(FG_COMMON, 88, 0) && ck(FG_COMMON, 72, 1))
    {
        if (ck(FG_COMMON, 83, 0))
        {
            enemy(ENEMY_BARRY_3, 4, 255, 1, 2, 0, 0, 3200, 0, 0, 12460, 0, 2570, 0, 0, 0, 0);
        }
        else if (ck(FG_COMMON, 87, 0))
        {
            enemy(ENEMY_BARRY_3, 4, 255, 1, 2, 0, 0, 1112, 0, 0, 6165, 0, 27740, 0, 0, 0, 0);
        }
        else
        {
            enemy(ENEMY_BARRY_3, 4, 255, 1, 2, 0, 0, 3232, 0, 0, 3920, 0, 2790, 0, 0, 0, 0);
        }
        set(FG_COMMON, 87, 1);
        set(FG_COMMON, 83, 1);
        aot_reset(0, SCE_EVENT, 129, 9, event_03, 0);
        evt_exec(0, 9, event_04);
    }
    if (ck(FG_COMMON, 89, 0))
    {
        enemy(ENEMY_HUNTER, 192, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 1, 0, 0, 0);
        aot_reset(2, SCE_EVENT, 129, 9, event_00, 0);
    }
    if (ck(FG_COMMON, 90, 0))
    {
        enemy(ENEMY_BARRY_3, 4, 255, 1, 2, 0, 0, 1112, 0, 0, 6165, 0, 27740, 0, 0, 0, 0);
        enemy(ENEMY_HUNTER, 192, 255, 1, 2, 0, 0, 3192, 0, 0, 4300, 0, 16300, 1, 0, 0, 0);
        evt_exec(0, 9, event_00);
        aot_reset(0, SCE_EVENT, 129, 9, event_03, 0);
    }
    if (ck(FG_COMMON, 72, 0))
    {
        enemy(ENEMY_HUNTER, 0, 78, 1, 2, 0, 0, 0, 0, 0, 7750, 0, 4760, 1, 0, 0, 0);
        enemy(ENEMY_HUNTER, 0, 79, 1, 2, 0, 0, 0, 0, 0, 9760, 0, 18180, 2, 0, 0, 0);
    }
    aot_set(7, 25600, 16400, 2000, 10100, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
}

event event_00
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        if (ck(FG_COMMON, 89, 0))
        {
            evt_exec(0, 9, event_02);
        }
        if (ck(FG_COMMON, 90, 0))
        {
            evt_exec(0, 9, event_01);
        }
    }
    evt_finish();
}

