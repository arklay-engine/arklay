#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define FLAG_ROOM_18 0x18

proc init
{
    door_aot_set(0, 9500, 13300, 2700, 2200, 12, 1, 8, 0, 0, ROOM_30B_ROCK_PASSAGE, 27700, 0, 3300, 3072, UNLOCKED, 129);
    door_aot_set(1, 10300, 500, 2600, 2200, 12, 1, 8, 0, 0, ROOM_30D_STRAIGHT_PASSAGE, 14800, 0, 7100, 1024, UNLOCKED, 129);
    item_aot_set(2, 18400, 1400, 2000, 2000, ITEM_01_WEAPON_KNIFE, 1, 0, 255, 200, 75, 190, 251, 96, 9, 0, 0, 246, 129, 0, 135);
    if (ck(FG_STATUS, FLAG_STATUS_08, TRUE))
    {
        item_aot_set(3, 19000, 12800, 2000, 2000, ITEM_2F_TOOL_INK_RIBBON, 2, 1, 255, 32, 78, 78, 253, 232, 53, 0, 0, 250, 129, 0, 0);
    }
    set(FG_SCENARIO, FLAG_SCENARIO_62, FALSE);
    if (ck(FG_ENEMY, FLAG_ENEMY_8A, FALSE))
    {
        aot_delete(1, SCE_NONE, 129);
    }
    if (ck(FG_ENEMY, FLAG_ENEMY_89, FALSE))
    {
        set(FG_ROOM, FLAG_ROOM_18, TRUE);
    }
    else
    {
        room_bgm_state_set(2, 12, 255);
    }
    enemy(ENEMY_04_SPIDER_BLACK_TIGER, 0, 137, 1, 2, 0, 0, 3800, 0, 0, 4500, 0, 5700, 0, 0, 0, 0);
    enemy(ENEMY_13_PROP_COBWEB, 0, 138, 1, 1, 0, 0, 3072, 0, 0, 11000, -2000, 2000, 1, 0, 0, 0);
}

proc main
{
    if (ck(FG_ENEMY, FLAG_ENEMY_8A, TRUE))
    {
        aot_delete(1, SCE_DOOR, 129);
    }
    if (ck(FG_ENEMY, FLAG_ENEMY_89, TRUE) && ck(FG_ROOM, FLAG_ROOM_18, TRUE))
    {
        set(FG_ROOM, FLAG_ROOM_18, FALSE);
        bgm_volume_ramp(0, 161, 30);
    }
}
