#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_5 0x02
#define AOT_03_5 0x03
#define AOT_04_EVENT 0x04
#define AOT_05_EVENT 0x05
#define AOT_06_MESSAGE 0x06
#define CAM_00 0x00
#define CAM_01 0x01

proc init when (MANSION2)
{
    door_aot_set(AOT_00_DOOR, 9900, 2000, 2500, 2700, 9, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCKED | F_LOCK_13, ROOM_104_TEA_ROOM, 31800, 0, 3300, 2048, LOCK, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 0, 9200, 2500, 2700, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, STAGE_2 | ROOM_21C_UNDER_KITCHEN, 3800, 0, 10000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_02_5, 4500, 9300, 4348, 3500, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_03_5, 11151, 9300, 4148, 3500, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_04_EVENT, 8030, 8400, 500, 4400, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_04, 0, 0, 0);
    aot_set(AOT_05_EVENT, 11049, 8400, 500, 4400, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
    aot_set(AOT_06_MESSAGE, 15100, 6200, 1700, 2300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 79, 0, 0, 0);
    set(FG_STATUS, F_STATUS_1D, TRUE);
}

proc main when (MANSION2)
{
    if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
    {
        set(FG_MAP, F_MAP_VISITED_21E, TRUE);
    }
}

event on_aot_04 when (MANSION2)
{
    run
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        cut_auto(CUT_LOCKED);
        dir_set(0, 0, 0, 0, 11336, -4315, 10556);
        spd_set(ENT_PLAYER, -4315);
        aot_on(AOT_03_5, SCE_5, 0);
        cutnext(CAM_01);
        cut_auto(CUT_FREE);
    }
    sleep(70);
    run
    {
        aot_delete(AOT_05_EVENT, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
    }
    evt_finish();
}

event on_aot_05 when (MANSION2)
{
    run
    {
        aot_delete(AOT_04_EVENT, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        cut_auto(CUT_LOCKED);
        dir_set(0, 0, 2048, 0, 8338, -2885, 10453);
        spd_set(ENT_PLAYER, -2885);
        aot_on(AOT_02_5, SCE_5, 0);
        cutnext(CAM_00);
        cut_auto(CUT_FREE);
    }
    sleep(70);
    run
    {
        aot_delete(AOT_04_EVENT, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
    }
    evt_finish();
}
