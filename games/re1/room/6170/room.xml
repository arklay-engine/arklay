  <strings>
    <language lang="en-US">
      <string key="save_name">M. Room 1F</string>
      <string key="0">{scroll 0}{scroll 2}{timed 140}</string>
      <string key="1">{scroll 0}{scroll 2}{timed 100}</string>
      <string key="2">{scroll 0}{scroll 2}{timed 70}</string>
      <string key="3">{scroll 0}{scroll 2}{timed 110}</string>
      <string key="4">{scroll 2}The title is “All living things\nare destined to die\".{scroll 2}</string>
      <string key="5">{scroll 2}A picture of a tired\nmiddle-aged man.{scroll 2}</string>
      <string key="6">{scroll 2}A picture of a newborn\nbaby.{scroll 2}</string>
      <string key="7">{scroll 2}\nA picture of a young man.{scroll 2}</string>
      <string key="8">{scroll 2}\nA picture of an infant.{scroll 2}</string>
      <string key="9">{scroll 2}\nA picture of a lively boy.{scroll 2}</string>
      <string key="10">{scroll 2}A picture of a\nbold-looking old man.{scroll 2}</string>
      <string key="11">{scroll 2}A picture of people\nmourning for the dead.{scroll 2}</string>
      <string key="12">{scroll 2}There's a switch below.\nWill you push it?{branch 0 1 1}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}小部屋/{s}1{s}F{s}</string>
      <string key="0">{scroll 0}\n  あいつらは? バケモノか‽{scroll 2}{timed 140}</string>
      <string key="1">{scroll 0}\n  レベッカはまだあの部屋に‽{scroll 2}{timed 100}</string>
      <string key="2">{scroll 0}\n       奴らは‽{scroll 2}{timed 70}</string>
      <string key="3">{scroll 0}\n    レベッカ! 上か!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 2}   タイトルが記されている\n \xF8\x10生あるものはやがて死にいたる\xF8\x11{clear 0}\n  何かのヒントだろうか・・・?{scroll 2}</string>
      <string key="5">{scroll 2}\n   つかれた中年の男性の絵だ{scroll 2}</string>
      <string key="6">{scroll 2}\n  生まれたばかりの赤ちゃんの絵だ{scroll 2}</string>
      <string key="7">{scroll 2}\n  たくましい青年がモデルの絵だ{scroll 2}</string>
      <string key="8">{scroll 2}\n    おさない子どもの絵だ{scroll 2}</string>
      <string key="9">{scroll 2}\n     元気な少年の絵だ{scroll 2}</string>
      <string key="10">{scroll 2}\n   気の強そうなお年寄りの絵だ{scroll 2}</string>
      <string key="11">{scroll 2}\n 人の死をなげいている絵のようだ{scroll 2}</string>
      <string key="12">{scroll 2}   絵の下にボタンがある\n押しますか?{branch 0 1 1}  </string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Chambre RdC</string>
      <string key="0">{scroll 0}Qu'est-ce que c'est? \nDes monstres?{scroll 2}{timed 140}</string>
      <string key="1">{scroll 0}Rebecca! Est-elle encore dans \nla maison?{scroll 2}{timed 100}</string>
      <string key="2">{scroll 0}\nQu'est-ce que c'est?{scroll 2}{timed 70}</string>
      <string key="3">{scroll 0}C'est Rebecca! Elle doit être \nà l'étage!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 2}Son titre : \n‟Donne-moi un sommeil paisible.\"{scroll 2}</string>
      <string key="5">{scroll 2}Le tableau d'un homme \nentre 2 âges fatigué.{scroll 2}</string>
      <string key="6">{scroll 2}\nLe tableau d'un nouveau-né.{scroll 2}</string>
      <string key="7">{scroll 2}\nLe tableau d'un jeune homme.{scroll 2}</string>
      <string key="8">{scroll 2}\nLe tableau d'un bébé.{scroll 2}</string>
      <string key="9">{scroll 2}Le tableau d'un garçon \njoyeux.{scroll 2}</string>
      <string key="10">{scroll 2}Le tableau d'un vieil \nhomme chauve.{scroll 2}</string>
      <string key="11">{scroll 2}\nIl y a un message.{clear 0}‟Donne-moi la paix de la \n mort, et je te donnerai la{clear 0}\njoie de la vie...\"{scroll 2}</string>
      <string key="12">{scroll 2}Il y a un bouton dessous.\nAppuyer dessus?{branch 0 6 1}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}Was sind das?\nMonster?{scroll 2}{timed 140}</string>
      <string key="1">{scroll 0}Rebecca!\nIst sie immer noch im Haus?{scroll 2}{timed 100}</string>
      <string key="2">{scroll 0}\nWas sind das für welche?{scroll 2}{timed 70}</string>
      <string key="3">{scroll 0}Es ist Rebecca!\nSie muß oben sein!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 2}Der Titel ist\n\"Gib mir friedlichen Schlaf.\"{scroll 2}</string>
      <string key="5">{scroll 2}Das Bildnis eines müden\nMannes mittleren Alters.{scroll 2}</string>
      <string key="6">{scroll 2}Das Bild\neines neugeborenen Babys.{scroll 2}</string>
      <string key="7">{scroll 2}Ein Bild eines jungen\nMannes.{scroll 2}</string>
      <string key="8">{scroll 2}Ein Bild von einem\nKleinkind.{scroll 2}</string>
      <string key="9">{scroll 2}Das Bild zeigt einen lebhaften\nJungen.{scroll 2}</string>
      <string key="10">{scroll 2}Das Bild eines verwegen\naussehenden, alten Mannes.{scroll 2}</string>
      <string key="11">{scroll 2}\nDa ist eine Nachricht.{clear 0}\nGib' mir den Frieden des Todes,{clear 0}und ich werde dir die Freude des\nLebens geben...{scroll 2}</string>
      <string key="12">{scroll 2}Da unten ist ein Schalter. Möch-\nten Sie draufdrücken?{branch 0 6 1}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Villa 1P</string>
      <string key="0">{scroll 0}\nCosa sono?!{scroll 2}{timed 140}</string>
      <string key="1">{scroll 0}Rebecca! È ancora nella \nmagione?{scroll 2}{timed 100}</string>
      <string key="2">{scroll 0}\nChe cos'è?{scroll 2}{timed 70}</string>
      <string key="3">{scroll 0}È Rebecca! Deve essere \ndi sopra!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 2}Si intitola: \"Ogni essere vivente è \ndestinato a morire\".{scroll 2}</string>
      <string key="5">{scroll 2}Il quadro di un uomo \nmolto stanco di mezza età.{scroll 2}</string>
      <string key="6">{scroll 2}\nIl quadro di un neonato.{scroll 2}</string>
      <string key="7">{scroll 2}\nIl quadro di un giovane.{scroll 2}</string>
      <string key="8">{scroll 2}\nIl quadro di un bambino.{scroll 2}</string>
      <string key="9">{scroll 2}Il quadro di un ragazzo \nvivace.{scroll 2}</string>
      <string key="10">{scroll 2}Il quadro di un anziano \ndall'aria ardita.{scroll 2}</string>
      <string key="11">{scroll 2}Si intitola: \n\"La fine della vita.\"{scroll 2}</string>
      <string key="12">{scroll 2}Sotto c'è un bottone.\nVuoi premerlo?{branch 0 6 1}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 0}¿Q-Qué son?\n¿Monstruos?{scroll 2}{timed 140}</string>
      <string key="1">{scroll 0}¡Rebecca! \n¿Sigue estando en la casa?{scroll 2}{timed 100}</string>
      <string key="2">{scroll 0}\n¿Qué son?{scroll 2}{timed 70}</string>
      <string key="3">{scroll 0}Es Rebecca,\n¡debe estar arriba!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 2}El título es: \"Concédeme\nun sueño tranquilo...\"{scroll 2}</string>
      <string key="5">{scroll 2}Un cuadro de un hombre\nde mediana edad, cansado...{scroll 2}</string>
      <string key="6">{scroll 2}Un cuadro de un recién\nnacido...{scroll 2}</string>
      <string key="7">{scroll 2}\nUn cuadro de un joven...{scroll 2}</string>
      <string key="8">{scroll 2}\nUn cuadro de un niño pequeño...{scroll 2}</string>
      <string key="9">{scroll 2}Un cuadro de un chico\ncon aspecto sano...{scroll 2}</string>
      <string key="10">{scroll 2}Un cuadro de un anciano\ncon expresión severa...{scroll 2}</string>
      <string key="11">{scroll 2}\nHay un mensaje...{clear 0}\"Concédeme la paz\nde la muerte y te daré{clear 0}\nla alegría de la vida...\"{scroll 2}</string>
      <string key="12">{scroll 2}Abajo hay un interruptor...\n¿Lo pulsas?{branch 0 6 1}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Мед. комната 1-эт.</string>
      <string key="0">{scroll 0}{scroll 2}{timed 140}</string>
      <string key="1">{scroll 0}{scroll 2}{timed 100}</string>
      <string key="2">{scroll 0}{scroll 2}{timed 70}</string>
      <string key="3">{scroll 0}{scroll 2}{timed 110}</string>
      <string key="4">{scroll 2}Надпись: “Всем живым существам\nсуждено умереть\".{scroll 2}</string>
      <string key="5">{scroll 2}Портрет уставшего мужчины,\nсреднего возраста.{scroll 2}</string>
      <string key="6">{scroll 2}Портрет новорожденного\nребенка{scroll 2}</string>
      <string key="7">{scroll 2}\nПортрет молодого человека.{scroll 2}</string>
      <string key="8">{scroll 2}\nПортрет младенца.{scroll 2}</string>
      <string key="9">{scroll 2}\nПортрет весёлого мальчика.{scroll 2}</string>
