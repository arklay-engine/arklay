  <strings>
    <language lang="en-US">
      <string key="name">FRONT OF CELL</string>
      <string key="save_name">Laboratory B3</string>
      <string key="0">{scroll 0}\n {scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}\n {scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}\n {scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}\n {scroll 1}{timed 120}</string>
      <string key="4">{scroll 0}\n {scroll 1}{clear 70}{scroll 0}\n {scroll 1}{timed 120}</string>
      <string key="5">{scroll 0}\n {scroll 1}{timed 80}</string>
      <string key="6">The door is tightly\nlocked.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}研究所 {s}/{s}B{s}3{s}</string>
      <string key="0">{scroll 0}\n      ジルなのか‽{scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}\n      生きてたのね{scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}  当たり前だろ\n  とんでもないことになってるぜ{scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}\n   とにかくここを開けないと{scroll 1}{timed 120}</string>
      <string key="4">{scroll 0}\n       ダメだわ{scroll 1}{clear 70}{scroll 0}    すぐに助けに来るわ\n    待ってて{scroll 1}{timed 120}</string>
      <string key="5">{scroll 0}\n       頼むぜ{scroll 1}{timed 80}</string>
      <string key="6">\n  ドアは厳重にロックされている</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Laboratoire SS3</string>
      <string key="0">{scroll 0}\nJill? C'est toi, Jill?! {scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}\nOh, Chris! Tu es vivant? {scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}Bien sûr! Bon sang, nous sommes\ndans de beaux draps, Jill!{scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}Je sais Chris. De toute façon,\nil faut que j'ouvre cette porte.{scroll 1}{timed 120}</string>
      <string key="4">{scroll 0}\nOh, ça ne marche pas.{scroll 1}{clear 70}{scroll 0}Bon, Chris, je reviens t'aider\ntrès vite! Attends-moi ici!{scroll 1}{timed 120}</string>
      <string key="5">{scroll 0}\nMerci, je t'attends. {scroll 1}{timed 80}</string>
      <string key="6">La porte est fermée \nhermétiquement.</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}Jill?\nBist du das, Jill!{scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}Oh, Chris!\nDu lebst?{scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}Na klar! Wir stecken in einem\nechten Dilemma, Jill!{scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}\nIch weiß, Chris.{scroll 1}{clear 60}{scroll 0}Trotzdem muß ich diesen Raum\nirgendwie öffnen.{scroll 1}{timed 60}</string>
      <string key="4">{scroll 0}\nOh, so klappt es nicht.{scroll 1}{clear 70}{scroll 0}\nNun, Chris,{scroll 1}{clear 30}{scroll 0}ich verspreche, dass ich bald\nzurückkomme und dir helfe!{scroll 1}{clear 50}{scroll 0}\nWartest du hier auf mich?{scroll 1}{timed 40}</string>
      <string key="5">{scroll 0}Schon gut.\nIch warte hier auf dich.{scroll 1}{timed 80}</string>
      <string key="6">\nDie Tür ist fest verschlossen.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Laboratorio S3</string>
      <string key="0">{scroll 0}\nJill? Sei tu, Jill?! {scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}\nOh, Chris! Sei vivo! {scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}Puoi contarci! \nSiamo in guai grossi, Jill!{scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}Lo so, Chris. Devo riuscire \nad aprire questa porta.{scroll 1}{timed 120}</string>
      <string key="4">{scroll 0}\nOh! Non funziona!{scroll 1}{clear 70}{scroll 0}Chris, tornerò presto a salvarti! \nAspettami qui!{scroll 1}{timed 120}</string>
      <string key="5">{scroll 0}\nGrazie! Ti aspetto. {scroll 1}{timed 80}</string>
      <string key="6">\nÈ chiuso elettronicamente.</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 0}\n¿Jill? ¿Eres tú, Jill?{scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}\nOh, Chris, ¡¡estás vivo!!{scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}Pues claro. Maldición, estamos\nmetidos en un buen lío, Jill.{scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}Lo sé, Chris. Sea como sea,\nTengo que abrir esta puerta.{scroll 1}{timed 120}</string>
      <string key="4">{scroll 0}\nAhh, ¡no hay forma!{scroll 1}{clear 70}{scroll 0}Bueno, Chris, volveré\npronto para ayudarte.{scroll 1}{clear 80}{scroll 0}\n¿Me esperas?{scroll 1}{timed 40}</string>
      <string key="5">{scroll 0}¡Gracias!\nTe esperaré aquí.{scroll 1}{timed 80}</string>
      <string key="6">La puerta está bien\ncerrada...</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Лаборатория Б3</string>
      <string key="0">{scroll 0}\n {scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}\n {scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}\n {scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}\n {scroll 1}{timed 120}</string>
      <string key="4">{scroll 0}\n {scroll 1}{clear 70}{scroll 0}\n {scroll 1}{timed 120}</string>
      <string key="5">{scroll 0}\n {scroll 1}{timed 80}</string>
      <string key="6">\nДверь плотно закрыта.</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Laboratorion olohuone -2 krs</string>
      <string key="0">{scroll 0}Jill? Sinäkö siellä?{scroll 1}{timed 70}</string>
      <string key="1">{scroll 0}Chris, olet elossa!{scroll 1}{timed 60}</string>
      <string key="2">{scroll 0}Totta kai. Hemmetti, olemme\npahassa pulassa..{scroll 1}{timed 115}</string>
      <string key="3">{scroll 0}Tiedän. Minun on saatava tämä\novi auki.{scroll 1}{timed 120}</string>
      <string key="4">{scroll 0}Ei auta!{scroll 1}{clear 70}{scroll 0}Palaan pian takaisin.\nAutan sinut ulos sieltä.{scroll 1}{clear 80}{scroll 0}Malta vielä hetken aikaa.{scroll 1}{timed 40}</string>
      <string key="5">{scroll 0}Kiitos! Minä odotan.{scroll 1}{timed 80}</string>
      <string key="6">Ovi on vahvasti lukittu...</string>
    </language>
  </strings>
