#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_203 0x00
#define AOT_01_DOOR_212 0x01
#define AOT_02_MESSAGE_BLOOD 0x02
#define AOT_03_EVENT_BLOOD_TRAIL 0x03
#define AOT_04_EVENT_BLOOD_SPOTS 0x04
#define AOT_05_ITEM_KEY_DESK_0 0x05
#define F_ROOM_PLAYER_ANIM_DONE 0x18                        // The player's crouch animation finished; nothing waits on it.
#define IMDL_00_KEY_DESK 0x00
#define MSG_I_HOPE_THIS_BLOOD_IS_NOT 0x00
#define MSG_SPOTS_OF_BLOOD_ARE_HERE_AND 0x02
#define MSG_THIS_MUST_BE_FORESTS 0x01

proc init
{
    door_aot_set(AOT_00_DOOR_203, 0, 0, 2500, 4200, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_203_HALL_2F, 31500, -2885, 8000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_212, 3600, 11500, 2000, 2500, 0, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 4, 0, ROOM_212_TERRACE, 19600, 0, 27000, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_COMMON, F_COMMON_FOREST_FOUND, TRUE))
    {
        room_bgm_state_set(1, ROOM_211_TERRACE_PASSAGE, BGM_OFF);
        aot_set(AOT_02_MESSAGE_BLOOD, 3800, 10000, 600, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 69, 1, 0, 0);
        aot_set(AOT_03_EVENT_BLOOD_TRAIL, 2500, 11000, 900, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_forest_blood, 0, 0, 0);
    }
    else
    {
        room_bgm_state_set(1, ROOM_211_TERRACE_PASSAGE, BGM_MAIN_ON);
        aot_set(AOT_02_MESSAGE_BLOOD, 3800, 10000, 600, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 69, 1, 0, 0);
        aot_set(AOT_03_EVENT_BLOOD_TRAIL, 2500, 11000, 900, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_blood_teammates, 0, 0, 0);
    }
    aot_set(AOT_04_EVENT_BLOOD_SPOTS, 2500, 7600, 900, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_blood_spots, 0, 0, 0);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        item_aot_set(AOT_05_ITEM_KEY_DESK_0, 2000, 400, 1700, 1700, IT_3D_KEY_DESK, 1, IMDL_00_KEY_DESK, SCA_NONE, 2900, -2020, 1780, 0, F_ITEM_211_KEY_DESK_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6);
        eml_rot(IMDL_00_KEY_DESK, 0, 2048);
    }
}

event examine_forest_blood
{
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE);
    message(MSG_THIS_MUST_BE_FORESTS | MSG_FAST, RUN_CONTROLS | RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "This must be Forest's..."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0001);
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE);
    sleep(5);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

