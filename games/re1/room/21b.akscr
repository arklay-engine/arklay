#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_ZOMBIE_LAB 0x01
#define ENEMY_02_ZOMBIE_LAB 0x02

proc init
{
    door_aot_set(AOT_00_DOOR, 28000, 11900, 2000, 1300, 1, 0, 6, 7, 0, ROOM_21A_UNDER_PASSAGE_1, 2500, 0, 3500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 3600, 4900, 1600, 1600, 2, 1, 8, 0, 155, ROOM_21C_UNDER_KITCHEN, 6500, 0, 2500, 3072, LOCK, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_02_ITEM, 29000, 2200, 1800, 2500, IT_44_HEAL_HERB_GREEN, 1, 0, 255, 116, 114, 0, 0, 140, 10, 0, 0, 93, 129, 1, 0);
    item_aot_set(AOT_03_ITEM, 29000, 2200, 1800, 2500, IT_44_HEAL_HERB_GREEN, 1, 1, 255, 116, 114, 0, 0, 128, 12, 0, 0, 213, 129, 1, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 6, 99, 1, 2, 0, 0, 2896, 0, 0, 28387, 0, 3592, ENEMY_00_ZOMBIE_GROUNDSKEEPER, 0, 0, 1);
    enemy(EM_11_ZOMBIE_LAB, 7, 99, 1, 2, 0, 0, 352, 0, 0, 27544, 0, 4468, ENEMY_01_ZOMBIE_LAB, 0, 0, 1);
    enemy(EM_11_ZOMBIE_LAB, 7, 99, 1, 2, 0, 0, 3712, 0, 0, 27765, 0, 2712, ENEMY_02_ZOMBIE_LAB, 0, 0, 1);
}
