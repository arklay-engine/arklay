#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_11A 0x00
#define AOT_01_DOOR_300 0x01
#define AOT_02_ITEM_KEY_DESK_0 0x02                         // In a barrel; Jill's game has only the barrel's message here.
#define AOT_03_ITEM_KEY_CRANK_SQUARE_1 0x03
#define AOT_04_MESSAGE_NOTHING 0x04
#define AOT_05_MESSAGE_BARREL 0x05
#define IMDL_00_KEY_DESK 0x00
#define IMDL_01_KEY_CRANK_SQUARE 0x01
#define OBJ_00_STEP_BOX 0x00                                // Guess: a box to climb up to the square crank.
#define OBJ_01_CRANK_SQUARE 0x01                            // The square crank's model on the shelf.

proc init
{
    door_aot_set(AOT_00_DOOR_11A, 0, 5200, 2600, 2400, 1, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_11A_ROOFED_PASSAGE, 7700, 0, 25500, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_300, 8800, 4300, 1700, 3200, 11, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, STAGE_3 | ROOM_300_FIRST_HOUSE_OUT, 27300, 0, 5600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        item_aot_set(AOT_02_ITEM_KEY_DESK_0, 8100, 8500, 1300, 1800, IT_3D_KEY_DESK, 1, IMDL_00_KEY_DESK, SCA_NONE, 9200, -1460, 9200, 0, F_ITEM_11B_KEY_DESK_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        aot_set(AOT_02_ITEM_KEY_DESK_0, 8100, 8500, 1300, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 69, 0, 0, 0);
    }
    item_aot_set(AOT_03_ITEM_KEY_CRANK_SQUARE_1, 5000, 1200, 1300, 1600, IT_1D_KEY_CRANK_SQUARE, 0, IMDL_01_KEY_CRANK_SQUARE, SCA_NONE, 0, 0, 0, 0, F_ITEM_11B_KEY_CRANK_SQUARE_1, SAT_MANUAL | SAT_PLAYER, 0);
    obj(OBJ_00_STEP_BOX, OF_CLIMBABLE | OF_ACTIVE, SCA_NONE, 4050, 0, 7500, 3072, 576, 0, -576, 0, 540, 900, 540, 1000);
    obj(OBJ_01_CRANK_SQUARE, OF_NOT_PUSHABLE | OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 5660, -4180, 2144, 1168, 0, 0, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_04_MESSAGE_NOTHING, 1700, 8700, 2800, 900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 69, 0, 0, 0);
    aot_set(AOT_05_MESSAGE_BARREL, 7400, 1400, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 69, 0, 0, 0);
}

proc main
{
    if (ck(FG_STATUS, F_STATUS_DOOR_TRANSITION, TRUE))
    {
        aot_delete(AOT_02_ITEM_KEY_DESK_0, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_03_ITEM_KEY_CRANK_SQUARE_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_04_MESSAGE_NOTHING, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_05_MESSAGE_BARREL, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        if (ck(FG_ITEM, F_ITEM_11B_KEY_DESK_0, TRUE) && ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            aot_reset(AOT_02_ITEM_KEY_DESK_0, SCE_ITEM, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
        }
        else
        {
            aot_reset(AOT_02_ITEM_KEY_DESK_0, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 69, 0);
        }
        aot_delete(AOT_03_ITEM_KEY_CRANK_SQUARE_1, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_04_MESSAGE_NOTHING, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_05_MESSAGE_BARREL, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_ITEM, F_ITEM_11B_KEY_CRANK_SQUARE_1, FALSE))
    {
        aot_delete(AOT_03_ITEM_KEY_CRANK_SQUARE_1, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        objtbl_b_set(TBL_OBJ, OBJ_01_CRANK_SQUARE, OF_NOT_PUSHABLE | OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE);
    }
    else
    {
        objtbl_b_set(TBL_OBJ, OBJ_01_CRANK_SQUARE, OF_NOT_PUSHABLE | OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    }
}
