#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_106 0x00
#define AOT_01_DOOR_112 0x01
#define AOT_02_USEITEM_UNUSED 0x02                          // Data 4,0,25 raises FG_ROOM bit 0x19 here; no script reads it.
#define AOT_03_ITEM_AMMO_SHOTGUN_0 0x03                     // Hidden; the desk gives it.
#define AOT_04_ITEM_AMMO_HANDGUN_1 0x04
#define AOT_05_HIKIDASHI_DESK 0x05
#define AOT_06_MESSAGE_ART 0x06
#define AOT_07_MESSAGE_NOTHING 0x07
#define AOT_08_MESSAGE_VARIOUS_THINGS 0x08
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define IMDL_00_AMMO_SHOTGUN 0x00
#define IMDL_01_AMMO_HANDGUN 0x01

proc init
{
    door_aot_set(AOT_00_DOOR_106, 400, 3800, 1900, 2100, 1, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_106_MAIN_HALL, 31300, 0, 19200, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_112, 23000, 10400, 2500, 2000, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 7, 0, ROOM_112_WARDROBE, 2900, 0, 15300, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_02_USEITEM_UNUSED, 3000, 10170, 2244, 2239, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 25, 0, 1, 0);
    item_aot_set(AOT_03_ITEM_AMMO_SHOTGUN_0, 0, 0, 1, 1, IT_0C_AMMO_SHOTGUN, 7, IMDL_00_AMMO_SHOTGUN, SCA_NONE, 2870, -680, 11320, 2140, F_ITEM_111_AMMO_SHOTGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_04_ITEM_AMMO_HANDGUN_1, 10900, 4200, 500, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_01_AMMO_HANDGUN, SCA_NONE, 11136, -1160, 5588, 1600, F_ITEM_111_AMMO_HANDGUN_1, SAT_MANUAL | SAT_PLAYER, 0);
    eml_rot(IMDL_00_AMMO_SHOTGUN, 0, 3072);
    eml_rot(IMDL_01_AMMO_HANDGUN, -70, 110);
    aot_set(AOT_05_HIKIDASHI_DESK, 1726, 10560, 1800, 2000, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 31, 0, 3, 0, 4, 0);
    aot_set(AOT_06_MESSAGE_ART, 6500, 4800, 1400, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 69, 0, 0, 0);
    aot_set(AOT_07_MESSAGE_NOTHING, 7000, 1300, 1900, 2200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 69, 0, 0, 0);
    aot_set(AOT_08_MESSAGE_VARIOUS_THINGS, 1400, 9000, 9200, 1400, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 69, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_01, F_ENEMY_111_ZOMBIE_GROUNDSKEEPER_0, SPAWN_FORCE, 1, 0, 0, 0, 7061, 0, 11273, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
    }
    setbyte(0, 0, 0);
    scene_setup(2, 4000, 6300, 12500);
    set(FG_STATUS, F_STATUS_MIRROR_ENABLE, TRUE);
}
