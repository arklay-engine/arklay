event event_00
{
    set(FG_STATUS, 15, 0);
    dir_set(0, 0, 2880, 0, 3300, 0, 7410);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        bgm_play(1);
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
        evt_exec(0, 9, event_01);
        voice_play(1, 84, 0);
        message(0, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(1, 85, 0);
    message(1, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(0);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, 15, 1);
    evt_finish();
}

