#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_MESSAGE 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_MESSAGE 0x05
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define F_ROOM_3F 0x3F
#define IMDL_00 0x00
#define MSG_VO_00C_00 0x00
#define MSG_VO_00C_01 0x01
#define MSG_VO_00C_20 0x02
#define MSG_VO_00C_22 0x03
#define OBJ_00 0x00
#define VO_00C_00 0x54
#define VO_00C_01 0x55
#define VO_00C_20 0x64
#define VO_00C_21 0x65
#define VO_00C_22 0x66

proc init
{
    door_aot_set(AOT_00_DOOR, 2300, 4800, 1700, 1800, 1, DOOR_SND_00_DR_WD, DOOR_02_DOOR02, 1, DOOR_LOCKED | F_LOCK_14, ROOM_10A_BACK_PASSAGE, 11300, 0, 4800, 1024, LOCKED, SAT_MANUAL | SAT_PLAYER);
#if MANSION1
    door_aot_set(AOT_01_DOOR, 3100, 18200, 2605, 2100, 0, DOOR_SND_05_ST_WD, DOOR_17_KAI03, 96, 0, STAGE_2 | ROOM_207_2F_RIGHT_STAIRS, 8600, 2885, 19000, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 8500, 12400, 2000, 1500, 0, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, DOOR_LOCK_40, ROOM_118_ROOM_UNDER_STAIRS, 6000, 0, 8000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#else
    door_aot_set(AOT_01_DOOR, 3100, 18200, 2605, 2100, 0, DOOR_SND_05_ST_WD, DOOR_17_KAI03, 96, 0, STAGE_7 | 7, 8600, 2885, 19000, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 8500, 12400, 2000, 1500, 0, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_118_ROOM_UNDER_STAIRS, 6000, 0, 8000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#endif
    aot_set(AOT_03_MESSAGE, 4400, 7800, 1500, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 134, 0, 255, 0, 0, 0);
    item_aot_set(AOT_04_ITEM, 6762, 15568, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_00, SCA_NONE, 7662, 0, 16468, 0, F_ITEM_6E, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
#if MANSION1
    if (ck(FG_SCENARIO, F_SCENARIO_09, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_09, TRUE);
    }
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_04, F_ENEMY_19, SPAWN_FORCE, 2, 0, 2009, 0, 4089, 0, 13523, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
#else
    obj(OBJ_00, OF_ACTIVE, SCA_NONE, 10720, -2350, 15120, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    eml_rot(ROT_OBJ | OBJ_00, -2048, 1024);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        aot_set(AOT_05_MESSAGE, 9820, 14220, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_05_MESSAGE, 9820, 14220, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
    }
    enemy(EM_06_HUNTER, EB_27, F_ENEMY_75, SPAWN_FORCE, 2, 0, 520, 0, 5853, 0, 16051, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
    room_bgm_state_set(5, 11, BGM_MAIN_ON);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_21, TRUE))
        {
            set(FG_COMMON, F_COMMON_21, FALSE);
            if (ck(FG_COMMON, F_COMMON_22, TRUE))
            {
                plw_anim(PLW_02, ANIM_28, 0);
                setw(W_04, 0);
#if CHRIS
                evt_exec(0, TASK_09, on_enter);
#else
                evt_exec(0, TASK_09, event_00);
#endif
                room_bgm_state_set(5, 11, BGM_RELOAD | 1);
            }
            if (ck(FG_COMMON, F_COMMON_36, TRUE))
            {
                plw_anim(PLW_02, ANIM_28, 0);
                setw(W_04, 0);
#if CHRIS
                evt_exec(0, TASK_09, on_enter_2);
#else
                evt_exec(0, TASK_09, event_02);
#endif
                room_bgm_state_set(5, 11, BGM_RELOAD | 1);
            }
        }
    }
#endif
}
#if MANSION2
#if CHRIS

event on_enter
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 2880, 0, 3300, 0, 7410);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        bgm_play(BGM_SUB_1);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        evt_exec(0, TASK_09, on_enter_sub1);
        voice_play(VOICE_PLAY, VO_00C_00);
        message(MSG_VO_00C_00, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(VOICE_PLAY, VO_00C_01);
    message(MSG_VO_00C_01, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

event on_enter_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(70);
    act_motion_path(MOTION_31, 1250, 0, 0, 50, 0);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_finish();
}

event on_enter_2
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 2880, 0, 3300, 0, 7410);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        bgm_play(BGM_SUB_1);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        evt_exec(0, TASK_09, on_enter_2_sub1);
        voice_play(VOICE_PLAY, VO_00C_20);
        message(MSG_VO_00C_20, 0);
    }
    sleep(40);
    wait_message();
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_21);
    sleep(56);
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_22);
    message(MSG_VO_00C_22, 0);
    wait_message();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, 0, 0, 0, 250, 250);
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

event on_enter_2_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(40);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_motion_path(MOTION_33, -1700, -5000, 0, 150, 50);
    sleep(15);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    sleep(25);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(40);
    act_anim_flags(ANIM_2A, F_ROOM_3F, 0);
    sleep(40);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    act_finish();
}
#endif
#endif
