event on_aot_04
{
    run
    {
        objtbl_b_set(0, 0, 0);
        cut_auto(1);
        cutnext(5);
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_ROOM, F_ROOM_02, TRUE);
        dir_set(0, 0, 2728, 0, 8875, 0, 11549);
        pos_set(0, 0, 72, 0, 7897, 0, 12497);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    sleep(26);
    act_reset();
    evt_nop();
    message(129, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(113, 300, 128, 2, 23, 23);
    sleep(75);
    act_motion(16);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
