event on_aot_04
{
    run
    {
        objtbl_b_set(TBL_OBJ, OBJ_00, 0);
        cut_auto(CUT_LOCKED);
        cutnext(CAM_05);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_ROOM, F_ROOM_02, TRUE);
        dir_set(0, 0, 2728, 0, 8875, 0, 11549);
        pos_set(ENEMY_00_NPC_REBECCA_2, 0, 72, 0, 7897, 0, 12497);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_20, 0);
    sleep(26);
    act_reset();
    evt_nop();
    message(1 | MSG_FAST, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 128, 2, 23, 23);
    sleep(75);
    act_motion(MOTION_10);
    act_reset();
