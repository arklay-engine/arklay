    act_nop();
    act_reset();
    evt_nop();
    run
    {
        objtbl_b_set(TBL_OBJ, OBJ_00, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
        cutnext(CAM_03);
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_ROOM, F_ROOM_02, FALSE);
        pos_set(ENEMY_00_NPC_REBECCA_2, 0, 72, 0, 6947, 0, 12497);
    }
    evt_finish();
}

