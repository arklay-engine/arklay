        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_motion_path(147, 0, 0, 0, 128, 0);
    act_finish();
}

