    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        objtbl_b_set(0, 0, 47);
        cutnext(3);
        cut_auto(0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_6, F_6_17, TRUE);
        set(FG_ROOM, F_ROOM_02, FALSE);
        pos_set(0, 0, 72, 0, 6947, 0, 12497);
    }
    evt_finish();
}

