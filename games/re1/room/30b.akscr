event from_main
{
    evt_disable(TASK_01);
    evt_disable(TASK_02);
    evt_disable(TASK_05);
    evt_disable(TASK_06);
    evt_fork(TASK_01, from_main_sub1, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_34, F_ROOM_20, 0);
    act_reset();
    evt_nop();
    sleep(7);
    run
    {
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -900, 0, 0);
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -400, 0, 0);
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -200, 0, 0);
    }
    sleep(8);
    objtbl_b_set(TBL_OBJ, OBJ_00, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    sleep(10);
    evt_disable(TASK_07);
    run
    {
        objs_hide(0);
        set(FG_STATUS, F_STATUS_3E, FALSE);
        set(FG_STATUS, F_STATUS_07, TRUE);
        bgm_stop(BGM_SUB_1);
    }
    evt_finish();
}

