event event_06
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_sel(TW_POS_Z, 16000);
    tw_end();
    evt_nop();
    evt_fork(TASK_03, event_07, 0);
    run
    {
        aot_delete(AOT_09_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        dir_set(0, 0, 900, 0, 21600, 0, 18300);
        cutnext(CAM_00);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    evt_next();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_20, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_1A, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_OBJ, OBJ_00, 0, 16, 8);
    sleep(30);
    act_motion_bitclr();
    act_nop();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    sleep(30);
    act_motion_bitclr();
    act_nop();
    sleep(30);
    act_anim_flags(ANIM_09, F_ROOM_20, 0);
    act_flag_op(EF_SET, EF_0001);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    act_idle();
    act_reset();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_ROOM, F_ROOM_21, FALSE);
        bgm_play(BGM_SUB_2);
    }
    evt_finish();
}

