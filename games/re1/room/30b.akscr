proc init
{
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        door_aot_set(AOT_00_DOOR, 21800, 18800, 2200, 2600, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | F_LOCK_27, ROOM_307_LADDER_PASSAGE, 3600, 0, 3900, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        door_aot_set(AOT_00_DOOR, 21800, 18800, 2200, 2600, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_307_LADDER_PASSAGE, 3600, 0, 3900, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    door_aot_set(AOT_01_DOOR, 25600, 300, 4300, 2900, 11, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30C_BLACK_TIGER_ROOM, 10700, 0, 12500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        item_aot_set(AOT_02_ITEM, 2030, 9800, 1200, 1200, IT_0E_AMMO_MAGNUM, 6, IMDL_00, SCA_NONE, 2630, -2060, 10400, 0, F_ITEM_7D, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        item_aot_set(AOT_02_ITEM, 2030, 9800, 1200, 1200, IT_12_AMMO_GRENADE_FLAME, 6, IMDL_00, SCA_NONE, 2620, -1880, 9780, 400, F_ITEM_7E, SAT_MANUAL | SAT_PLAYER, 0);
    }
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        item_aot_set(AOT_03_ITEM, 20400, 17700, 1000, 1300, IT_06_WEAPON_FLAMETHROWER, 240, IMDL_01, SCA_NONE, 21190, -3100, 17840, 0, F_ITEM_99, SAT_MANUAL | SAT_PLAYER, 0);
        swap_var(XFER_RESTORE, AOT_03_ITEM, B_0D);
    }
    obj(OBJ_00, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 2000, -2480, 14500, 0, 0, 0, 0, 0, 2700, 2800, 2800, 2800);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        obj(OBJ_01, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 21090, -3072, 17840, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    }
    aot_set(AOT_04_NONE, 20400, 17700, 1000, 1300, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 13, 0, 0, 0);
    set(FG_STATUS, F_STATUS_3D, TRUE);
    if (ck(FG_SCENARIO, F_SCENARIO_3D, FALSE))
    {
        aot_set(AOT_05_NONE, 11000, 12000, 2000, 4000, SCE_NONE, SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
        aot_set(AOT_06_NONE, 14600, 11200, 4500, 6400, SCE_NONE, SAT_UNDER | SAT_PLAYER, 3, 0, 8, 0, 0, 0);
        aot_set(AOT_07_NONE, 400, 11600, 30000, 5300, SCE_NONE, SAT_UNDER | SAT_PLAYER, 4, 0, 33, 0, 1, 0);
        aot_set(AOT_08_USEITEM, 1500, 11300, 21700, 6000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 34, 0, 1, 0);
        aot_set(AOT_09_NONE, 21000, 16000, 4000, 4400, SCE_NONE, SAT_UNDER | SAT_PLAYER, 2, 0, 6, 0, 0, 0);
        aot_set(AOT_0A_USEITEM, 0, 12000, 9000, 4000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 31, 0, 1, 0);
    }
    else
    {
        evt_exec(0, TASK_00, on_enter);
        inst_cfg(COL_LIST_00, COL_05, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_01, COL_04, 0, 0, 0, 2, 2);
        msgnode_set(ZONE_0B, CAM_02, CAM_07);
        msgnode_set(ZONE_01, CAM_00, CAM_07);
        msgnode_set(ZONE_03, CAM_00, CAM_07);
        set(FG_ROOM, F_ROOM_17, TRUE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_61, FALSE))
    {
        aot_set(AOT_0B_NONE, 0, 9600, 8600, 8000, SCE_NONE, SAT_UNDER | SAT_PLAYER, 4, 0, 29, 0, 1, 0);
        enemy(EM_06_HUNTER, EB_82, F_ENEMY_7A, SPAWN_FORCE, 1, 0, 0, 0, 100, 0, 100, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        enemy(EM_06_HUNTER, EB_82, F_ENEMY_7B, SPAWN_FORCE, 1, 0, 0, 0, 200, 0, 200, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        set(FG_ROOM, F_ROOM_1E, TRUE);
    }
    else
    {
        enemy(EM_06_HUNTER, EB_02, F_ENEMY_7A, SPAWN_FORCE, 1, 0, 2400, 0, 27800, 0, 11600, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        enemy(EM_06_HUNTER, EB_02, F_ENEMY_7B, SPAWN_FORCE, 1, 0, 2400, 0, 27800, 0, 11600, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
    }
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        aot_set(AOT_0C_NONE, 20400, 17700, 1000, 1300, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    }
    if (ck(FG_ITEM, F_ITEM_99, FALSE))
    {
        evt_exec(0, TASK_09, on_enter_2);
        set(FG_LOCK, F_LOCK_27, FALSE);
        if (item_ck(IT_06_WEAPON_FLAMETHROWER))
        {
            aot_delete(AOT_04_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_0C_NONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        }
    }
    else
    {
        set(FG_LOCK, F_LOCK_27, TRUE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_62, FALSE))
    {
        room_bgm_state_set(2, ROOM_30B_ROCK_PASSAGE, BGM_MAIN_ON);
    }
    else
    {
        room_bgm_state_set(2, ROOM_30B_ROCK_PASSAGE, BGM_SUB_2_ON);
    }
    set(FG_STATUS, F_STATUS_1D, TRUE);
}

proc main
{
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        set(FG_MAP, F_MAP_VISITED_311, TRUE);
    }
    if (ck(FG_ROOM, F_ROOM_21, TRUE) && ck_counter(0, DIST_OBJ, OBJ_00, 4500))
    {
        aot_delete(AOT_07_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        if (ck_tween(0, 1024, 3072))
        {
            evt_exec(0, TASK_04, from_main);
        }
        else if (ck(FG_ROOM, F_ROOM_22, TRUE))
        {
            evt_exec(0, TASK_04, from_main_3);
        }
        else
        {
            evt_exec(0, TASK_04, from_main_2);
        }
    }
    if (ck(FG_ROOM, F_ROOM_1F, TRUE))
    {
        set(FG_ROOM, F_ROOM_1F, FALSE);
        aot_delete(AOT_05_NONE, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_3D, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_17, TRUE) && ck(FG_STATUS, F_STATUS_1A, TRUE))
        {
            if (cmpb(B_CAMERA, CMP_EQ, CAM_07))
            {
                evt_exec(0, TASK_09, from_main_8);
            }
            else
            {
                evt_exec(0, TASK_09, from_main_9);
            }
        }
    }
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        if (testpickup(IT_06_WEAPON_FLAMETHROWER))
        {
            evt_exec(0, TASK_09, from_main_4);
            set(FG_LOCK, F_LOCK_27, FALSE);
            set(FG_ITEM, F_ITEM_AC, FALSE);
        }
        if (testitem(IT_06_WEAPON_FLAMETHROWER))
        {
            set(FG_ITEM, F_ITEM_AC, FALSE);
            set(FG_ITEM, F_ITEM_99, TRUE);
            setbyte(1, 1, 0);
            evt_exec(0, TASK_09, from_main_5);
            evt_exec(0, TASK_09, from_main_6);
        }
    }
    if (ck(FG_ROOM, F_ROOM_1D, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_04))
    {
        set(FG_ROOM, F_ROOM_1D, FALSE);
        set(FG_ROOM, F_ROOM_1E, FALSE);
        set(FG_SCENARIO, F_SCENARIO_61, TRUE);
        set(FG_ENEMY, F_ENEMY_7B, TRUE);
        aot_delete(AOT_0B_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        evt_exec(0, TASK_09, from_main_7);
    }
    if (ck(FG_ROOM, F_ROOM_1E, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        set(FG_ROOM, F_ROOM_1D, FALSE);
        set(FG_ROOM, F_ROOM_1E, FALSE);
        set(FG_SCENARIO, F_SCENARIO_61, TRUE);
        set(FG_ENEMY, F_ENEMY_7A, TRUE);
        aot_delete(AOT_0B_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        pos_set(ENEMY_01_HUNTER, 0, 3072, 0, 27800, 0, 5000);
        eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, EB_02);
    }
    if (ck(FG_ROOM, F_ROOM_1C, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_0A, TRUE))
        {
            set(FG_ROOM, F_ROOM_0A, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1A_RCK_HITA, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_0B, TRUE))
        {
            set(FG_ROOM, F_ROOM_0B, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1B_RCK_HITB, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_0C, TRUE))
        {
            set(FG_ROOM, F_ROOM_0C, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1C_RCK_BROK, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_0D, TRUE))
        {
            set(FG_ROOM, F_ROOM_0D, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1D, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_0E, TRUE))
        {
            set(FG_ROOM, F_ROOM_0E, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1E_RCK_STOP, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_0F, TRUE))
        {
            set(FG_ROOM, F_ROOM_0F, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1F, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_10, TRUE))
        {
            set(FG_ROOM, F_ROOM_10, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_20, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
    }
}

event event_00
{
    run
    {
        set(FG_SCENARIO, F_SCENARIO_3D, TRUE);
        set(FG_RUN, F_RUN_READY, FALSE);
        aot_delete(AOT_05_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        aot_delete(AOT_0A_USEITEM, SCE_NONE, SAT_UNDER | SAT_PLAYER);
    }
    evt_fork(TASK_01, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_18, FALSE));
    evt_fork(TASK_01, event_01, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_1A, FALSE));
    run
    {
        cut_auto(CUT_FREE);
        msgnode_set(ZONE_0B, CAM_02, CAM_07);
        msgnode_set(ZONE_01, CAM_00, CAM_07);
        msgnode_set(ZONE_03, CAM_00, CAM_07);
        inst_cfg(COL_LIST_00, COL_05, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_01, COL_04, 0, 0, 0, 2, 2);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_SCENARIO, F_SCENARIO_62, TRUE);
        set(FG_ROOM, F_ROOM_17, TRUE);
        aot_delete(AOT_0B_NONE, SCE_USEITEM, SAT_UNDER | SAT_PLAYER);
    }
    evt_finish();
}

