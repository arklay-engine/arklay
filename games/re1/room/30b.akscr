        set(FG_ROOM, F_ROOM_0C, TRUE);
        set(FG_ROOM, F_ROOM_0D, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(121, 0, 0);
    tw_set_rot(0, 0, 102);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, F_ROOM_0C, TRUE);
        set(FG_ROOM, F_ROOM_0D, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    for (30)
    {
        tw_pos_rot_add();
        tw_pos_rot_add();
        evt_next();
        tw_nop();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_disable(TASK_05);
    evt_disable(TASK_06);
    evt_disable(TASK_07);
    run
    {
        set(FG_ROOM, F_ROOM_0E, TRUE);
        set(FG_ROOM, F_ROOM_0F, TRUE);
        set(FG_ROOM, F_ROOM_10, TRUE);
    }
    evt_fork(TASK_05, on_enter, 0);
    set(FG_STATUS, F_STATUS_3E, TRUE);
    sleep(1);
    run
    {
        set(FG_ROOM, F_ROOM_0E, TRUE);
        set(FG_ROOM, F_ROOM_0F, TRUE);
        set(FG_ROOM, F_ROOM_10, TRUE);
    }
    sleep(4);
    bgm_stop(BGM_SUB_1);
    sleep(25);
    run
    {
        set(FG_ROOM, F_ROOM_1A, TRUE);
        set(FG_ROOM, F_ROOM_21, FALSE);
        aot_delete(AOT_07_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        set(FG_STATUS, F_STATUS_3E, FALSE);
    }
    evt_finish();
}

