        dir_set(0, 0, 1864, 0, 16280, 0, 27750);
        cutnext(7);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 35, 1));
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 14, 32 | 0, 0 | 0);
    act_param_set(14336, 3);
    act_reset();
    evt_nop();
    sleep(40);
    run
    {
        if (ck(FG_COMMON, 37, 1))
        {
            evt_exec(0, 9, event_04);
        }
        else
        {
            evt_exec(0, 9, event_05);
        }
    }
    evt_finish();
}

