#version 1

proc init
{
    door_aot_set(0, 100, 16300, 2400, 2000, 8, 1, 12, 7, 0, RDT_005, 22500, 0, 3100, 2048, UNLOCKED, 129);
    door_aot_set(1, 4700, 18300, 2500, 2300, 6, 1, 13, 6, 0, RDT_007, 21300, 0, 2800, 3072, UNLOCKED, 129);
    door_aot_set(2, 14300, 17000, 2500, 1600, 2, 1, 12, 7, 0, RDT_00E, 2800, 0, 4200, 3648, UNLOCKED, 129);
    door_aot_set(3, 11400, 400, 2500, 2100, 11, 1, 11, 3, 0, RDT_00F, 11500, 0, 20800, 1024, UNLOCKED, 129);
    door_aot_set(4, 16200, 26400, 2500, 2600, 0, 13, 18, 64, 0, RDT_015, 4600, 0, 4600, 2048, UNLOCKED, 129);
    enemy(ENEMY_BARRY_STARS_, 4, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 0, 0, 0, 0);
    if (ck(FG_SCENARIO, 45, 1))
    {
        enemy(ENEMY_ZOMBIE_GROUNDSKEEPER_, 0, 82, 1, 2, 0, 0, 1424, 0, 0, 11312, 0, 19150, 1, 0, 0, 0);
        enemy(ENEMY_ZOMBIE_GROUNDSKEEPER_, 0, 83, 1, 2, 0, 0, 1653, 0, 0, 16243, 0, 29672, 2, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, 1, 1))
    {
        aot_set(5, 16000, 25000, 1000, 1000, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
        aot_reset(4, SCE_EVENT, 129, 9, event_01, 0);
    }
    if (ck(FG_SCENARIO, 1, 0))
    {
        msgnode_set(2, 0, 6);
        msgnode_set(8, 1, 6);
        msgnode_set(16, 4, 6);
        effect(10, 24, 0, 92, 68, 72, 244, 206, 99, 0, 0);
    }
    else
    {
        effect_tracked(10, 16, 0, 92, 68, 72, 244, 206, 99, 0, 0);
    }
    if (ck(FG_COMMON, 192, 1) && ck(FG_COMMON, 91, 0) && ck(FG_SCENARIO, 55, 0) && ck(FG_COMMON, 77, 1))
    {
        evt_exec(0, 9, event_06);
        set(FG_COMMON, 77, 0);
        pos_set(0, 0, 1608, 0, 14950, 0, 29400);
        dir_set(0, 0, 2500, 0, 16300, 0, 28000);
    }
}

proc main
{
    if (ck(FG_SCENARIO, 100, 1))
    {
        if (ck(FG_SCENARIO, 1, 0))
        {
            set(FG_SCENARIO, 100, 0);
            effect_kill_a(0);
            effect(10, 24, 0, 92, 68, 72, 244, 206, 99, 0, 0);
            msgnode_set(2, 0, 6);
            msgnode_set(8, 1, 6);
            msgnode_set(16, 4, 6);
        }
    }
}

event event_00
{
    sleep(1);
    set(FG_6, 23, 1);
    message(128, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            if (ck(FG_SCENARIO, 45, 0) && ck(FG_SCENARIO, 46, 0))
            {
                set(FG_SCENARIO, 1, 0);
                aot_delete(5, SCE_NONE, 0);
                if (ck(FG_COMMON, 192, 1))
                {
                    evt_exec(0, 9, event_03);
                }
                else
                {
                    evt_exec(0, 9, event_02);
                }
            }
            else
            {
                evt_exec(0, 9, event_01);
            }
        }
        else
        {
            set(FG_6, 23, 0);
        }
    }
    evt_finish();
}

event event_01
{
    sleep(1);
    message(129, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_6, 23, 0);
    evt_finish();
}

event event_02
{
    run
    {
        set(FG_6, 23, 1);
        cutnext(7);
        se_play_3d(2, 24, 0, 0, 0, 16300, 27630);
    }
    sleep(20);
    run
    {
        se_play_3d(2, 25, 0, 0, 0, 16300, 27630);
    }
    run
    {
        cut_auto(0);
    }
    sleep(20);
    run
    {
        msgnode_set(13, 2, 7);
        aot_delete(4, SCE_DOOR, 129);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

