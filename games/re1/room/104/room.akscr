#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_EVENT 0x04
#define AOT_04_ITEM 0x04
#define AOT_05_ITEM 0x05
#define AOT_05_MESSAGE 0x05
#define AOT_06_MESSAGE 0x06
#define AOT_07_MESSAGE 0x07
#define AOT_08_ITEM 0x08
#define AOT_08_MESSAGE 0x08
#define AOT_09_ITEM 0x09
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_ZOMBIE_LAB 0x00
#define ENEMY_01 0x01
#define ENEMY_01_HUNTER 0x01
#define ENEMY_01_NPC_KENNETH_1 0x01
#define IMDL_00 0x00
#define IMDL_01 0x01
#define MSG_HE_IS_KENNETH_FROM_THE_STARS 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 14800, 4100, 3000, 3100, 2, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 1, DOOR_LOCKED | F_LOCK_12, ROOM_103_F_PASSAGE, 3000, 0, 3000, 3072, LOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 29800, 4000, 1700, 3500, 2, DOOR_SND_00_DR_WD, DOOR_1F_DOOR05K, 5, DOOR_LOCKED | F_LOCK_06, ROOM_10F_BAR, 14000, 0, 3000, 3072, IT_33_KEY_MANSION_SWORD, SAT_MANUAL | SAT_PLAYER);
    if (MANSION1)
    {
        door_aot_set(AOT_02_DOOR, 31500, 1900, 2300, 1800, 6, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_13, ROOM_110_1F_ELEVATOR, 0, 0, 0, 0, LOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        door_aot_set(AOT_02_DOOR, 31500, 1900, 2300, 1800, 6, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_13, ROOM_110_1F_ELEVATOR, 12700, -7200, 3300, 0, LOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    door_aot_set(AOT_03_DOOR, 10600, 0, 2800, 2300, 1, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 4, 0, ROOM_105_DINING_ROOM, 6300, 0, 14100, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (MANSION1)
    {
        aot_set(AOT_04_EVENT, 3300, 5600, 2000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_04, 0, 0, 0);
        if (CHRIS)
        {
            item_aot_set(AOT_05_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_29, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
            aot_set(AOT_06_MESSAGE, 3300, 7400, 2000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
            aot_set(AOT_07_MESSAGE, 5500, 5700, 1000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
            aot_set(AOT_08_MESSAGE, 1000, 6900, 1000, 1600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
            item_aot_set(AOT_09_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_01, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_2F, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
            set(FG_STATUS, F_STATUS_1C, TRUE);
        }
        else
        {
            aot_set(AOT_05_MESSAGE, 3300, 7400, 2000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
            aot_set(AOT_06_MESSAGE, 5500, 5700, 1000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
            aot_set(AOT_07_MESSAGE, 1000, 6900, 1000, 1600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
            if (ck(FG_COMMON, F_COMMON_B4, FALSE))
            {
                item_aot_set(AOT_08_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_29, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
                item_aot_set(AOT_09_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_01, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_2F, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
            }
            set(FG_COMMON, F_COMMON_AC, TRUE);
        }
        evt_exec(0, TASK_09, on_enter);
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_A2, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_A0, TRUE))
                {
                    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_103_F_PASSAGE))
                    {
                        snd_pan_vol_set(BGM_MAIN, 40, 40);
                        snd_pan_vol_set(BGM_SUB_1, 40, 40);
                    }
                    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_105_DINING_ROOM))
                    {
                        snd_pan_vol_set(BGM_MAIN, 30, 30);
                        snd_pan_vol_set(BGM_SUB_1, 30, 30);
                    }
                    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_10F_BAR))
                    {
                        snd_pan_vol_set(BGM_MAIN, 60, 60);
                        snd_pan_vol_set(BGM_SUB_1, 60, 60);
                    }
                }
            }
        }
        if (ck(FG_COMMON, F_COMMON_02, FALSE))
        {
            enemy(EM_11_ZOMBIE_LAB, EB_85, F_ENEMY_1C, SPAWN_FORCE, 2, 0, 3072, 0, 4150, 0, 6300, ENEMY_00_ZOMBIE_LAB, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_11_ZOMBIE_LAB, EB_00, F_ENEMY_1C, SPAWN_FORCE, 2, 0, 3072, 0, 4150, 0, 5550, ENEMY_00_ZOMBIE_LAB, ANIM_00, 0, EVAR_00);
        }
        if (CHRIS)
        {
            enemy(EM_25_NPC_KENNETH_1, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 3550, 0, 6400, ENEMY_01_NPC_KENNETH_1, ANIM_00, 0, EVAR_00);
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_AD, FALSE))
            {
                enemy(EM_25_NPC_KENNETH_1, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 3550, 0, 6400, ENEMY_01, ANIM_00, 0, EVAR_00);
            }
            else if (ck(FG_COMMON, F_COMMON_B4, TRUE))
            {
                enemy(EM_29_NPC_KENNETH_2, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 3550, 0, 6400, ENEMY_01, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_25_NPC_KENNETH_1, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 3550, 0, 6400, ENEMY_01, ANIM_00, 0, EVAR_00);
            }
        }
    }
    else
    {
        if (CHRIS)
        {
            item_aot_set(AOT_04_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_29, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_B4, FALSE))
            {
                item_aot_set(AOT_04_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_29, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
            }
        }
        aot_set(AOT_05_MESSAGE, 3300, 7400, 2000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        aot_set(AOT_06_MESSAGE, 5500, 5700, 1000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
        aot_set(AOT_07_MESSAGE, 1000, 6900, 1000, 1600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
        if (CHRIS)
        {
            item_aot_set(AOT_08_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_01, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_2F, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_B4, FALSE))
            {
                item_aot_set(AOT_08_ITEM, 3300, 5600, 2000, 2000, IT_0B_AMMO_HANDGUN, 15, IMDL_01, SCA_NONE, 4150, 0, 6400, 1024, F_ITEM_2F, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
            }
        }
        enemy(EM_06_HUNTER, EB_00, F_ENEMY_9E, SPAWN_FORCE, 2, 0, 4011, 0, 3616, 0, 3322, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        enemy(EM_06_HUNTER, EB_00, F_ENEMY_9F, SPAWN_FORCE, 2, 0, 1915, 0, 23680, 0, 3370, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
    }
}

proc main when (MANSION1)
{
    if (ck(FG_COMMON, F_COMMON_02, FALSE))
    {
        if (ck(FG_STATUS, F_STATUS_1A, TRUE))
        {
            if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
            {
                evt_exec(0, TASK_09, from_main);
            }
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_11, TRUE))
    {
        aot_delete(AOT_04_EVENT, SCE_NONE, SAT_PLAYER);
    }
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_A2, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_A0, TRUE))
            {
                if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
                {
                    snd_pan_vol_set(BGM_MAIN, 30, 30);
                    snd_pan_vol_set(BGM_SUB_1, 30, 30);
                }
                if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
                {
                    snd_pan_vol_set(BGM_MAIN, 35, 35);
                    snd_pan_vol_set(BGM_SUB_1, 35, 35);
                }
                if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
                {
                    snd_pan_vol_set(BGM_MAIN, 40, 40);
                    snd_pan_vol_set(BGM_SUB_1, 40, 40);
                }
                if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
                {
                    snd_pan_vol_set(BGM_MAIN, 60, 60);
                    snd_pan_vol_set(BGM_SUB_1, 60, 60);
                }
                if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
                {
                    snd_pan_vol_set(BGM_MAIN, 30, 30);
                    snd_pan_vol_set(BGM_SUB_1, 30, 30);
                }
            }
        }
    }
}

event on_aot_04 when (MANSION1)
{
    run
    {
        cutnext(CAM_05);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        message(MSG_HE_IS_KENNETH_FROM_THE_STARS | MSG_FAST, 0); // "He's Kenneth from the ＳＴＡＲＳ Bravo team...! Now he's become a mere shadow of his former self."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        cutnext(CAM_04);
        aot_delete(AOT_04_EVENT, SCE_NONE, SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_enter when (MANSION1)
{
    sleep(1);
    if (CHRIS)
    {
        run
        {
            set(FG_STATUS, F_STATUS_1D, TRUE);
        }
    }
    else
    {
        set(FG_STATUS, F_STATUS_1D, TRUE);
    }
    evt_finish();
}

event from_main when (MANSION1)
{
    run
    {
        bgm_stop_all(0);
        movie_on(MOVIE_03_DM3);
    }
    sleep(1);
    run
    {
        room_bgm_state_set(0, ROOM_104_TEA_ROOM, BGM_MAIN_ON);
        eml_state(0, ENEMY_00_ZOMBIE_LAB, EML_BEHAVIOUR, EB_05);
        set(FG_COMMON, F_COMMON_02, TRUE);
    }
    evt_finish();
}
