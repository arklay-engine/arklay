      <string key="7">{scroll 2}There's a UMB.No4.{clear 0}Will you put UMB No.4 in the\nempty bottle?{branch 0 1 1}{scroll 2}There's UMB No.2. You need\na container to obtain it.{scroll 2}</string>
      <string key="8">{scroll 2}There's UMB No.2. You need\na container to obtain it.{scroll 2}</string>
      <string key="9">{scroll 2}There's UMB No.4. You need\na container to obtain it.{scroll 2}</string>
      <string key="10">\nIt's poison gas!{scroll 2}Perhaps I should leave for\na moment.{scroll 2}</string>
      <string key="11">{scroll 2}Perhaps I should leave for\na moment.{scroll 2}</string>
      <string key="12">{scroll 0}\n{scroll 2}{clear 100}{scroll 0}\n{scroll 2}{timed 150}</string>
      <string key="13">Do you want me to heal\nyour wounds?{scroll 1}{branch 0 1 0}{scroll 0}\n{scroll 2}{timed 130}</string>
