      <string key="name">DRUG STOREHOUSE</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">{scroll 2}Something is written on\nthe wall.{clear 0}Water=1, Red=2,\nPurple=3, Green=4{scroll 2}</string>
