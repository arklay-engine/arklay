#version 1

proc init
{
    door_aot_set(0, 0, 8000, 2500, 3300, 11, 1, 11, 3, 156, RDT_001, 30000, 0, 3500, 2048, ITEM_LAB_KEY_1_, 129);
    door_aot_set(1, 7500, 2400, 1600, 1700, 0, 14, 20, 64, 0, RDT_310, 0, 0, 0, 2048, UNLOCKED, 129);
    door_aot_set(2, 3200, 5900, 2100, 1700, 1, 11, 26, 64, 0, RDT_002, 5300, 0, 11200, 1024, UNLOCKED, 129);
    aot_set(3, 2000, 11500, 1000, 2000, SCE_EVENT, 129, 9, 0, event_03, 0, 0, 0);
    if (ck(FG_COMMON, 74, 1))
    {
        effect_tracked(10, 16, 0, 160, 15, 184, 242, 122, 43, 0, 0);
    }
    else
    {
        effect(10, 24, 0, 160, 15, 184, 242, 122, 43, 0, 0);
    }
    if (ck(FG_SCENARIO, 55, 0))
    {
        if (ck(FG_COMMON, 75, 0))
        {
            enemy(ENEMY_JILL_STARS_, 2, 255, 1, 2, 0, 0, 1024, 0, 0, 6100, 0, 9200, 0, 0, 0, 0);
            evt_exec(0, 9, event_00);
        }
        if (ck(FG_SCENARIO, 43, 0))
        {
            aot_reset(1, SCE_MESSAGE, 129, 130, 255, 0);
        }
        else
        {
            aot_reset(1, SCE_MESSAGE, 129, 132, 255, 0);
        }
    }
    aot_reset(2, SCE_EVENT, 129, 9, event_05, 0);
}

proc main
{
    if (ck(FG_COMMON, 74, 1))
    {
        if (ck(FG_LOCK, 28, 0))
        {
            set(FG_COMMON, 74, 0);
            effect_kill_a(0);
            effect(10, 24, 0, 160, 15, 184, 242, 122, 43, 0, 0);
        }
    }
}

event event_00
{
    sleep(1);
    eml_state(0, 0, 8);
    evt_finish();
}

event event_01
{
    sleep(1);
    eml_state(0, 1, 8);
    evt_finish();
}

event event_02
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        cutnext(2);
    }
    sleep(20);
    run
    {
        voice_play(1, 68, 0);
        message(0, 0);
    }
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_anim_flags(32 | 16, 0 | 0, 0 | 0);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(113, 0, 250, 1, 0, 40);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutcurr(0);
        cut_auto(0);
        set(FG_STATUS, 15, 1);
    }
    sleep(20);
    run
    {
        set(FG_6, 23, 0);
        eml_state(0, 1, 8);
    }
    evt_finish();
}

event event_03
{
    run
    {
        set(FG_6, 23, 1);
        cutnext(4);
    }
    sleep(20);
    run
    {
        message(129, 0);
    }
    wait_message();
    sleep(20);
    run
    {
        cutnext(2);
        cut_auto(0);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_04
{
    run
    {
        set(FG_6, 23, 1);
    }
    sleep(5);
    run
    {
        effect_kill_a(0);
        effect(10, 24, 0, 160, 15, 184, 242, 122, 43, 0, 0);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_05
{
    message(131, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            aot_on(2, SCE_DOOR, 0);
        }
    }
    evt_finish();
}
