#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_USEITEM 0x03
#define AOT_04_EVENT 0x04
#define AOT_05_MESSAGE 0x05
#define AOT_06_MESSAGE 0x06
#define AOT_07_ITEM 0x07
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08
#define AOT_09_MESSAGE 0x09
#define CAM_04 0x04
#define ENEMY_00_ZOMBIE_NAKED 0x00
#define ENEMY_01_ZOMBIE_NAKED 0x01
#define ENEMY_02_ZOMBIE_NAKED 0x02
#define ENEMY_03_ZOMBIE_NAKED 0x03
#define IMDL_00 0x00
#define IMDL_01 0x01
#define IMDL_02 0x02
#define MSG_IT_IS_A_PASS_CODE_OUTPUT 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 3000, 1300, 1200, 1200, 3, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_508_DOUBLE_LOCK, 11300, 0, 4800, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM, 0, 0, 1, 1, IT_6B_FILE_PASS_CODE_01, 1, IMDL_00, SCA_NONE, 25000, 30000, 25000, 0, F_ITEM_52, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_02_ITEM, 1200, 7400, 800, 1300, IT_65_FILE_FAX, 1, IMDL_01, SCA_NONE, 1700, -2210, 8090, 0, F_ITEM_53, SAT_MANUAL | SAT_PLAYER, 0);
#if JILL
#if USA
    item_aot_set(AOT_07_ITEM, 9000, 9000, 2700, 1900, IT_2F_KEY_INK_RIBBON, 2, IMDL_02, SCA_NONE, 0, 0, 0, 0, F_ITEM_E6, SAT_MANUAL | SAT_PLAYER, 0);
#else
    item_aot_set(AOT_07_ITEM, 9000, 9000, 2700, 1900, IT_2F_KEY_INK_RIBBON, 3, IMDL_02, SCA_NONE, 0, 0, 0, 0, F_ITEM_E6, SAT_MANUAL | SAT_PLAYER, 0);
#endif
#endif
    aot_set(AOT_03_USEITEM, 9900, 1700, 2000, 2100, SCE_USEITEM, SAT_PLAYER, 9, 0, 13, 0, 1, 0);
    aot_set(AOT_04_EVENT, 9900, 1700, 2000, 2100, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_05_MESSAGE, 5900, 1700, 1800, 3400, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    aot_set(AOT_06_MESSAGE, 11700, 4000, 1100, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
#if CHRIS
    aot_set(AOT_07_MESSAGE, 9000, 9000, 2700, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 1400, 8900, 800, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
#else
    aot_set(AOT_08_MESSAGE, 9000, 9000, 2700, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 1400, 8900, 800, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
#endif
    enemy(EM_01_ZOMBIE_NAKED, EB_00, F_ENEMY_5C, SPAWN_FORCE, 1, 0, 360, 0, 2900, 0, 6400, ENEMY_00_ZOMBIE_NAKED, ANIM_00, 0, EVAR_00);
    enemy(EM_01_ZOMBIE_NAKED, EB_00, F_ENEMY_5D, SPAWN_FORCE, 1, 0, 1024, 0, 6100, 0, 8900, ENEMY_01_ZOMBIE_NAKED, ANIM_00, 0, EVAR_00);
    enemy(EM_01_ZOMBIE_NAKED, EB_00, F_ENEMY_5E, SPAWN_FORCE, 1, 0, 1024, 0, 10200, 0, 9700, ENEMY_02_ZOMBIE_NAKED, ANIM_00, 0, EVAR_00);
    enemy(EM_01_ZOMBIE_NAKED, EB_00, F_ENEMY_5F, SPAWN_FORCE, 1, 0, 2700, 0, 8500, 0, 3800, ENEMY_03_ZOMBIE_NAKED, ANIM_00, 0, EVAR_00);
    eml_rot(IMDL_01, 0, 3060);
}

proc main
{
    if (ck(FG_ITEM, F_ITEM_52, TRUE))
    {
        aot_reset(AOT_04_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_04, 0);
        aot_reset(AOT_03_USEITEM, SCE_USEITEM, SAT_PLAYER, 9, 13, 1);
    }
    else
    {
        aot_reset(AOT_04_EVENT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 69, 0);
        aot_reset(AOT_03_USEITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    }
    if (testitem(IT_28_KEY_MO_DISK))
    {
        evt_exec(0, TASK_09, from_main);
    }
}

event on_aot_04
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        cut_auto(CUT_LOCKED);
        cutnext(CAM_04);
        message(MSG_IT_IS_A_PASS_CODE_OUTPUT | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "It's a pass code output machine. If I had a MO DISK, I could get the code..."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        cutcurr(0);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event from_main
{
    sleep(1);
    aot_on(AOT_01_ITEM, SCE_DOCUMENT, 0);
    evt_finish();
}
