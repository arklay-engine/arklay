        se_play_3d(SND_BANK_ROOM, SE_17_MAGNUM, 0, SND_AT_ENEMY, ENEMY_00_NPC_BARRY_3, 0, 0);
    }
    sleep(5);
    run
    {
        eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_0F);
    }
    sleep(5);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_07, ANIM_16, F_ROOM_00);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_08, ANIM_17, F_ROOM_00);
    act_reset();
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_MAGNUM, 0, SND_AT_ENEMY, ENEMY_00_NPC_BARRY_3, 0, 0);
    }
    sleep(5);
    run
    {
        eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_14);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_00, 0);
    act_motion_path(MOTION_32, 0, 300, 0, 0, 30);
    act_flag_op(EF_SET, EF_0001);
    act_reset();
    evt_nop();
    sleep(100);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_set(AB_09, ANIM_10, F_ROOM_00);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_00, 0);
    act_motion_path(MOTION_31, -500, 0, 0, 40, 0);
    act_reset();
    evt_nop();
    run
    {
        voice_play(VOICE_PLAY, VO_A00_01);
        message(MSG_VO_A00_01, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2C, F_ROOM_00, 0);
