#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_07_MESSAGE 0x07
#define AOT_83_ITEM 0x83
#define AOT_84_ITEM 0x84
#define AOT_85_ITEM 0x85

proc init
{
    door_aot_set(AOT_00_DOOR, 1900, 25800, 2100, 1900, 3, 1, 8, 0, 0, ROOM_308_BRANCH_PASSAGE, 12600, 0, 27300, 2048, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 0, 3500, 2400, 1900, 3, 1, 8, 0, 0, ROOM_308_BRANCH_PASSAGE, 11000, 0, 3300, 2048, UNLOCKED, 129);
    door_aot_set(AOT_02_DOOR, 13900, 0, 2100, 2600, 0, 1, 8, 0, 0, ROOM_30A_ENRICO_ROOM, 4100, 0, 20000, 1024, UNLOCKED, 129);
#if CHRIS
    item_aot_set(AOT_84_ITEM, 25000, 19000, 1000, 1000, IT_0C_AMMO_SHOTGUN, 7, 1, 255, 156, 99, 174, 247, 44, 76, 0, 0, 202, 129, 0, 0);
    item_aot_set(AOT_85_ITEM, 25000, 20900, 1000, 1000, IT_41_HEAL_FIRST_AID_SPRAY, 1, 0, 255, 156, 99, 174, 247, 152, 83, 0, 0, 248, 129, 0, 0);
#else
    item_aot_set(AOT_83_ITEM, 25000, 19000, 1000, 1000, IT_10_AMMO_GRENADE_EXPLOSIVE, 6, 0, 255, 156, 99, 174, 247, 44, 76, 0, 0, 45, 129, 0, 0);
    item_aot_set(AOT_84_ITEM, 25000, 20900, 1000, 1000, IT_41_HEAL_FIRST_AID_SPRAY, 1, 1, 255, 156, 99, 174, 247, 152, 83, 0, 0, 248, 129, 0, 0);
    if (ck(FG_COMMON, F_COMMON_58, TRUE) && ck(FG_COMMON, F_COMMON_48, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_53, TRUE))
        {
            enemy(EM_2D_NPC_BARRY_3, 4, 255, 1, 2, 0, 0, 3200, 0, 0, 12460, 0, 2570, 0, 0, 0, 0);
        }
        else if (ck(FG_COMMON, F_COMMON_57, TRUE))
        {
            enemy(EM_2D_NPC_BARRY_3, 4, 255, 1, 2, 0, 0, 1112, 0, 0, 6165, 0, 27740, 0, 0, 0, 0);
        }
        else
        {
            enemy(EM_2D_NPC_BARRY_3, 4, 255, 1, 2, 0, 0, 3232, 0, 0, 3920, 0, 2790, 0, 0, 0, 0);
        }
        set(FG_COMMON, F_COMMON_57, FALSE);
        set(FG_COMMON, F_COMMON_53, FALSE);
        aot_reset(AOT_00_DOOR, SCE_EVENT, 129, 9, on_aot_00_door, 0);
        evt_exec(0, 9, on_enter);
    }
    if (ck(FG_COMMON, F_COMMON_59, TRUE))
    {
        enemy(EM_06_HUNTER, 192, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 1, 0, 0, 0);
        aot_reset(AOT_02_DOOR, SCE_EVENT, 129, 9, on_aot_02_door, 0);
    }
    if (ck(FG_COMMON, F_COMMON_5A, TRUE))
    {
        enemy(EM_2D_NPC_BARRY_3, 4, 255, 1, 2, 0, 0, 1112, 0, 0, 6165, 0, 27740, 0, 0, 0, 0);
        enemy(EM_06_HUNTER, 192, 255, 1, 2, 0, 0, 3192, 0, 0, 4300, 0, 16300, 1, 0, 0, 0);
        evt_exec(0, 9, on_aot_02_door);
        aot_reset(AOT_00_DOOR, SCE_EVENT, 129, 9, on_aot_00_door, 0);
    }
#endif
    if (ck(FG_COMMON, F_COMMON_48, TRUE))
    {
#if CHRIS
        enemy(EM_06_HUNTER, 0, 78, 1, 2, 0, 0, 0, 0, 0, 7750, 0, 4760, 0, 0, 0, 0);
        enemy(EM_06_HUNTER, 0, 79, 1, 2, 0, 0, 0, 0, 0, 9760, 0, 18180, 1, 0, 0, 0);
#else
        enemy(EM_06_HUNTER, 0, 78, 1, 2, 0, 0, 0, 0, 0, 7750, 0, 4760, 1, 0, 0, 0);
        enemy(EM_06_HUNTER, 0, 79, 1, 2, 0, 0, 0, 0, 0, 9760, 0, 18180, 2, 0, 0, 0);
#endif
    }
    aot_set(AOT_07_MESSAGE, 25600, 16400, 2000, 10100, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
}
#if JILL

event on_aot_02_door
{
    sleep(1);
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        if (ck(FG_COMMON, F_COMMON_59, TRUE))
        {
            evt_exec(0, 9, on_aot_02_door_sub2);
        }
        if (ck(FG_COMMON, F_COMMON_5A, TRUE))
        {
            evt_exec(0, 9, on_aot_02_door_sub1);
        }
    }
    evt_finish();
}

