    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_72, 0, 300, 1, 0, 40);
    act_reset();
    evt_nop();
    sleep(50);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, -200, 0, 0, 30);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
