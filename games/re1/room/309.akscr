event on_aot_00_door
{
    run
    {
        set(FG_COMMON, F_COMMON_57, TRUE);
        aot_on(AOT_00_DOOR, SCE_DOOR, 0);
    }
    evt_finish();
}

event on_enter
{
    sleep(5);
    run
    {
        eml_state(0, ENEMY_00_NPC_BARRY_3, EML_08);
    }
    evt_finish();
}
