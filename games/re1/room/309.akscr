    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_3);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_00, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    wait_message();
    run
