    evt_nop();
    sleep(5);
    evt_work_set(WK_ENEMY, ENEMY_01_HUNTER);
    evt_actor_begin();
    act_anim_seq(AB_03, 5940, 23540, F_ROOM_00);
    act_nop();
    act_reset();
    evt_nop();
    sleep(26);
    run
    {
        eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_0A);
    }
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_00, 0);
    act_motion_path(MOTION_33, 400, 300, 0, 80, 60);
