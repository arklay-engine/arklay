#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_208 0x00
#define AOT_01_ITEM_KEY_LIGHTER 0x01
#define AOT_02_ITEM_AMMO_HANDGUN 0x02
#define AOT_02_ITEM_AMMO_SHOTGUN 0x02
#define AOT_03_ITEM_HEAL_HERB_RED 0x03
#define IMDL_00_KEY_LIGHTER 0x00
#define IMDL_01_AMMO_HANDGUN 0x01
#define IMDL_01_AMMO_SHOTGUN 0x01
#define IMDL_02_HEAL_HERB_RED 0x02

proc init
{
    door_aot_set(AOT_00_DOOR_208, 9200, 7200, 1500, 1000, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 9, 0, ROOM_208_DEER_ROOM, 2700, 0, 4500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM_KEY_LIGHTER, 3000, 9000, 1500, 2100, IT_30_KEY_LIGHTER, 0, IMDL_00_KEY_LIGHTER, SCA_NONE, 3390, -2500, 9690, 0, F_ITEM_209_KEY_LIGHTER_0, SAT_MANUAL | SAT_PLAYER, 0);
    if (MANSION1)
    {
        if (CHRIS)
        {
            item_aot_set(AOT_02_ITEM_AMMO_SHOTGUN, 1300, 1200, 3300, 2100, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN, SCA_NONE, 2800, 0, 2500, 0, F_ITEM_209_AMMO_HANDGUN_OR_AMMO_SHOTGUN_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        else
        {
            item_aot_set(AOT_02_ITEM_AMMO_HANDGUN, 1300, 1200, 3300, 2100, IT_0B_AMMO_HANDGUN, 15, IMDL_01_AMMO_HANDGUN, SCA_NONE, 2800, 0, 2500, 0, F_ITEM_209_AMMO_HANDGUN_OR_AMMO_SHOTGUN_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
    }
    else
    {
        item_aot_set(AOT_02_ITEM_AMMO_SHOTGUN, 1300, 1200, 3300, 2100, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN, SCA_NONE, 2800, 0, 2500, 0, F_ITEM_209_AMMO_HANDGUN_OR_AMMO_SHOTGUN_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    }
    item_aot_set(AOT_03_ITEM_HEAL_HERB_RED, 8100, 1700, 1400, 1400, IT_43_HEAL_HERB_RED, 1, IMDL_02_HEAL_HERB_RED, SCA_NONE, 8800, 0, 2400, 0, F_ITEM_209_HEAL_HERB_RED_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
}
