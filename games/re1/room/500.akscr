#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_EVENT 0x03
#define ENEMY_00_NPC_CHRIS 0x00
#define ENEMY_00_NPC_JILL 0x00
#define ENEMY_01_NPC_BARRY 0x01
#define MSG_EMERGENCY_EXIT 0x01
#define MSG_THERE_IS_A_LADDER 0x03
#define MSG_VO_A00_03_44 0x00
#define VO_A00_03_44 0x44

proc init
{
    door_aot_set(AOT_00_DOOR, 0, 8000, 2500, 3300, 11, 1, 11, 3, 156, ROOM_501_HELIPORT_PASSAGE, 30000, 0, 3500, 2048, IT_37_KEY_LAB_MASTER, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 7500, 2400, 1600, 1700, 0, 14, 20, 64, 0, STAGE_3 | ROOM_310_COURT_TO_LABO, 0, 0, 0, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 3200, 5900, 2100, 1700, 1, 11, 26, 64, 0, ROOM_502_LADDER_ROOM, 5300, 0, 11200, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_03_EVENT, 2000, 11500, 1000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
    if (ck(FG_COMMON, F_COMMON_4A, FALSE))
    {
        effect_tracked(10, 16, 0, 160, 15, 184, 242, 122, 43, 0, 0);
    }
    else
    {
        effect(10, 24, 0, 160, 15, 184, 242, 122, 43, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_37, TRUE))
    {
        if (ck(FG_COMMON, F_COMMON_4B, TRUE))
        {
#if CHRIS
            enemy(EM_21_NPC_JILL, 2, 255, 1, 2, 0, 0, 1024, 0, 0, 6100, 0, 9200, ENEMY_00_NPC_JILL, 0, 0, 0);
#else
            enemy(EM_20_NPC_CHRIS, 2, 255, 1, 2, 0, 0, 1730, 0, 0, 6040, 0, 10070, ENEMY_00_NPC_CHRIS, 0, 0, 0);
#endif
            evt_exec(0, 9, on_enter);
        }
#if JILL
        if (ck(FG_COMMON, F_COMMON_C0, FALSE))
        {
            enemy(EM_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 500, 0, 0, 3680, 0, 11310, ENEMY_01_NPC_BARRY, 0, 0, 0);
            if (ck(FG_COMMON, F_COMMON_51, FALSE))
            {
                evt_exec(0, 9, on_enter_3);
            }
            else
            {
                evt_exec(0, 9, on_enter_2);
            }
        }
#endif
        if (ck(FG_SCENARIO, F_SCENARIO_2B, TRUE))
        {
            aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 255, 0);
        }
        else
        {
            aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 255, 0);
        }
#if JILL
        set(FG_COMMON, F_COMMON_4E, TRUE);
#endif
    }
    aot_reset(AOT_02_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_02_door, 0);
}

proc main
{
    if (ck(FG_COMMON, F_COMMON_4A, FALSE))
    {
        if (ck(FG_LOCK, F_LOCK_1C, TRUE))
        {
            set(FG_COMMON, F_COMMON_4A, TRUE);
            effect_kill_a(0);
            effect(10, 24, 0, 160, 15, 184, 242, 122, 43, 0, 0);
        }
    }
}

event on_enter
{
    sleep(1);
#if CHRIS
    eml_state(0, ENEMY_00_NPC_JILL, 8);
#else
    eml_state(0, ENEMY_00_NPC_CHRIS, 8);
#endif
    evt_finish();
}

#if CHRIS
event event_01
#else
event on_enter_2
#endif
{
    sleep(1);
#if CHRIS
    eml_state(0, 1, 8);
#else
    eml_state(0, ENEMY_01_NPC_BARRY, 8);
#endif
    evt_finish();
}

#if CHRIS
event event_02
#else
event on_enter_3
#endif
{
    sleep(1);
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        cutnext(2);
    }
    sleep(20);
    run
    {
        voice_play(VOICE_PLAY, VO_A00_03_44, 0);
        message(MSG_VO_A00_03_44, 0);
    }
#if CHRIS
    evt_work_set(WK_ENEMY, 1);
#else
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
#endif
    evt_actor_begin();
    act_anim_flags(32 | 16, 0 | 0, 0 | 0);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(113, 0, 250, 1, 0, 40);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutcurr(0);
        cut_auto(0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    sleep(20);
    run
    {
        set(FG_6, F_6_17, TRUE);
#if CHRIS
        eml_state(0, 1, 8);
#else
        eml_state(0, ENEMY_01_NPC_BARRY, 8);
#endif
    }
    evt_finish();
}

event on_aot_03
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        cutnext(4);
    }
    sleep(20);
    run
    {
        message(MSG_EMERGENCY_EXIT | MSG_FAST, 0); // "“Emergency Exit""
    }
    wait_message();
    sleep(20);
    run
    {
        cutnext(2);
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event event_04
{
    run
    {
        set(FG_6, F_6_17, FALSE);
    }
    sleep(5);
    run
    {
        effect_kill_a(0);
        effect(10, 24, 0, 160, 15, 184, 242, 122, 43, 0, 0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_02_door
{
    message(MSG_THERE_IS_A_LADDER | MSG_FAST, 255); // "There's a ladder. Will you descend it? There's no turning back!"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_on(AOT_02_DOOR, SCE_DOOR, 0);
        }
    }
    evt_finish();
}
