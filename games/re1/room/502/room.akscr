        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_30, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_reset();
        evt_nop();
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_anim_flags(ANIM_30, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_flag_op(EF_SET, EF_0010);
        act_reset();
