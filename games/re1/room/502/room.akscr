        evt_actor_begin();
        act_motion_path(MOTION_33, 50, 20, 0, 10, 10);
        act_reset();
        evt_nop();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_72, 0, 300, 1, 0, 20);
        act_reset();
        evt_nop();
