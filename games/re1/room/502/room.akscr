        act_nop();
        act_reset();
        evt_nop();
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_anim_seq(AB_02, 5500, 11000, F_ROOM_J_CHRIS_WALK_DONE);
        act_nop();
        act_reset();
        evt_nop();
        sleep(30);
        run
        {
            voice_play(VOICE_PLAY, VO_11A_04);
            message(MSG_VO_11A_04, 0);
        }
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_anim_flags(ANIM_21, F_ROOM_ACTOR_ANIM_DONE, AFL_02 | AFL_01);
        act_motion_path(MOTION_32, 0, -300, 0, 0, 30);
        act_flag_op(EF_OR, EF_0001);
        act_reset();
        evt_nop();
        wait_message();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_32, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_reset();
        evt_nop();
        sleep(140);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_motion_path(MOTION_32, 0, 300, 0, 0, 50);
        act_reset();
        evt_nop();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_34, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_motion(MOTION_10);
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_reset();
        evt_nop();
        sleep(40);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        run
        {
            aot_on(AOT_02_ITEM_FILE_BARRYS_PICTURE, SCE_DOCUMENT, 0);
        }
        evt_next();
        evt_nop();
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_motion_path(MOTION_31, 300, 0, 0, 20, 0);
        act_reset();
        evt_nop();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_2D, F_ROOM_ACTOR_ANIM_DONE, 0);
        act_motion_path(MOTION_31, -300, 0, 0, 20, 0);
    }
    act_param_set(0, 3072);
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        sleep(40);
        run
        {
            voice_play(VOICE_PLAY, VO_11A_05);
            message(MSG_VO_11A_05, 0);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_21, F_ROOM_ACTOR_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        sleep(50);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_29, F_ROOM_ACTOR_ANIM_DONE, 0);
        act_reset();
        evt_nop();
    }
    wait_message();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_00, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_motion(MOTION_10);
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_reset();
        evt_nop();
        sleep(20);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_idle();
        act_nop();
        act_reset();
        evt_nop();
    }
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
        {
            eml_state(0, ENEMY_01_NPC_CHRIS, EML_08);
        }
        cutnext(CAM_00);
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            eml_state(0, ENEMY_00_NPC_JILL, EML_08);
        }
        else
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        sleep(20);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event jill_waits_or_chris_walks_in
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        sleep(5);
        run
        {
            eml_state(0, ENEMY_00_NPC_JILL, EML_08);
        }
    }
    else
    {
        sleep(1);
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        }
        sleep(10);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_anim_seq(AB_03, 5260, 7600, F_ROOM_J_WALK_DONE);
        act_nop();
        act_reset();
        evt_nop();
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_J_WALK_DONE, FALSE));
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_anim_flags(ANIM_26, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_reset();
        evt_nop();
        sleep(35);
        run
        {
            voice_play(VOICE_PLAY, VO_A00_04_45);
            message(MSG_VO_A00_04_45, 0);
        }
        wait_message();
        run
        {
            cutnext(CAM_00);
            cut_auto(CUT_FREE);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
            eml_state(0, ENEMY_01_NPC_CHRIS, EML_08);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    evt_finish();
}

event ladder_up_prompt
{
    message(MSG_THERE_IS_A_LADDER | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a ladder. Will you climb it? He must have been attacked by those monsters."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_on(AOT_00_DOOR_500, SCE_DOOR, 0);
        }
    }
    evt_finish();
}

event chris_waits
{
    sleep(1);
    run
    {
        eml_state(0, ENEMY_01_NPC_CHRIS, EML_08);
    }
    evt_finish();
}
