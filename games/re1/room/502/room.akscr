        act_motion(MOTION_10);
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_nop();
        act_reset();
        evt_nop();
        sleep(70);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_anim_flags(ANIM_32, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_reset();
        evt_nop();
        sleep(50);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_33, -400, 300, 0, 30, 20);
