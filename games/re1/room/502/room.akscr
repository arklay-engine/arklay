#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_500 0x00
#define AOT_01_DOOR_503 0x01
#define AOT_02_ITEMBOX_CHRIS 0x02
#define AOT_02_ITEM_FILE_BARRYS_PICTURE 0x02                // Shown as a document in Barry's scene.
#define AOT_03_ITEMBOX_JILL 0x03
#define AOT_04_MESSAGE_ATTACKED 0x04                        // "He must have been attacked by those monsters."
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define ENEMY_00_NPC_BARRY_2 0x00
#define ENEMY_00_NPC_JILL 0x00
#define ENEMY_01_NPC_CHRIS 0x01
#define F_ROOM_ACTOR_ANIM_DONE 0x20                         // Any actor's animation finished; nothing waits on it.
#define F_ROOM_J_CHRIS_WALK_DONE 0x21                       // Jill: Chris's walk finished; nothing waits on it.
#define F_ROOM_J_WALK_DONE 0x22                             // Jill: Jill's walk to Barry, or Chris's walk in, finished.
#define IMDL_00_FILE_BARRYS_PICTURE 0x00
#define MSG_THERE_IS_A_LADDER 0x0A
#define MSG_VO_11A_00 0x06
#define MSG_VO_11A_01 0x00
#define MSG_VO_11A_02 0x01
#define MSG_VO_11A_03 0x02
#define MSG_VO_11A_04 0x07
#define MSG_VO_11A_05 0x03
#define MSG_VO_A00_04_45 0x08
#define MSG_VO_A00_05_46 0x09
#define OBJ_00_ITEM_BOX 0x00                                // Guess: the item box beside the box spot.
#define VO_11A_00 0x53
#define VO_11A_01 0x54
#define VO_11A_02 0x55
#define VO_11A_03 0x56
#define VO_11A_04 0x57
#define VO_11A_05 0x58
#define VO_A00_04_45 0x45
#define VO_A00_05_46 0x46

proc init
{
    door_aot_set(AOT_00_DOOR_500, 4700, 12000, 1300, 1300, 0, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_500_UNDER_FOUNTAIN, 4400, 0, 7600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_503, 4800, 1500, 1500, 1300, 0, DOOR_SND_01_DR_MTL, DOOR_0A_DOOR10, 8, 0, ROOM_503_STAIRS, 26000, 0, 5800, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        item_aot_set(AOT_02_ITEM_FILE_BARRYS_PICTURE, 0, 0, 1, 1, IT_6A_FILE_BARRYS_PICTURE, 0, IMDL_00_FILE_BARRYS_PICTURE, SCA_NONE, 30000, 30000, 30000, 0, F_ITEM_307_FILE_BARRYS_PICTURE_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    obj(OBJ_00_ITEM_BOX, OF_10 | OF_ACTIVE, SCA_NONE, 2100, -1440, 7800, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        aot_set(AOT_02_ITEMBOX_CHRIS, 1100, 6350, 3200, 2750, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 4, 0, 0, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
        {
            enemy(EM_21_NPC_JILL, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 2368, 0, 8140, 0, 9680, ENEMY_00_NPC_JILL, ANIM_06, 0, EVAR_00);
            if (ck(FG_COMMON, F_COMMON_C_JILL_502_SCENE, FALSE))
            {
                evt_exec(0, TASK_09, jill_talks_or_barry_photo_scene_with_chris);
                set(FG_COMMON, F_COMMON_C_JILL_502_SCENE, TRUE);
            }
            else
            {
                evt_exec(0, TASK_09, jill_waits_or_chris_walks_in);
            }
        }
        aot_reset(AOT_00_DOOR_500, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, ladder_up_prompt, 0);
        if (ck(FG_SCENARIO, F_SCENARIO_SELF_DESTRUCT_ON, TRUE))
        {
            room_bgm_state_set(4, ROOM_502_LADDER_ROOM, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
        }
    }
    else
    {
        aot_set(AOT_03_ITEMBOX_JILL, 1100, 6350, 3200, 2750, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 4, 0, 0, 0, 0, 0);
        aot_reset(AOT_00_DOOR_500, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, ladder_up_prompt, 0);
        enemy(EM_2A_NPC_BARRY_2, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_00_NPC_BARRY_2, ANIM_32, 99, EVAR_00);
        enemy(EM_20_NPC_CHRIS, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_01_NPC_CHRIS, ANIM_00, 0, EVAR_00);
        if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE) && ck(FG_COMMON, F_COMMON_J_CAME_FROM_500, FALSE))
        {
            pos_set(ENEMY_01_NPC_CHRIS, 0, 1504, 0, 3860, 0, 11550);
            evt_exec(0, TASK_07, jill_waits_or_chris_walks_in);
        }
        if (ck(FG_COMMON, F_COMMON_J_BARRY_RESCUED_FROM_PIT, FALSE) && ck(FG_SCENARIO, F_SCENARIO_TYRANT_1_DEAD, TRUE))
        {
            pos_set(ENEMY_00_NPC_BARRY_2, 0, 0, 0, 2400, 0, 10500);
            aot_set(AOT_04_MESSAGE_ATTACKED, 1900, 9300, 1500, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 139, 0, 255, 0, 0, 0);
            if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
                {
                    evt_exec(0, TASK_09, jill_talks_or_barry_photo_scene_with_chris);
                }
                else
                {
                    evt_exec(0, TASK_09, barry_photo_scene);
                }
            }
            else if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
            {
                evt_exec(0, TASK_09, chris_waits);
            }
            set(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE);
            room_bgm_state_set(4, ROOM_502_LADDER_ROOM, BGM_RELOAD | 2);
        }
        if (ck(FG_COMMON, F_COMMON_J_WAITED_FOR_BARRY, TRUE) && ck(FG_SCENARIO, F_SCENARIO_TYRANT_1_DEAD, TRUE))
        {
            pos_set(ENEMY_00_NPC_BARRY_2, 0, 0, 0, 2400, 0, 10500);
            aot_set(AOT_04_MESSAGE_ATTACKED, 1900, 9300, 1500, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 139, 0, 255, 0, 0, 0);
            if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
                {
                    evt_exec(0, TASK_09, jill_talks_or_barry_photo_scene_with_chris);
                }
                else
                {
                    evt_exec(0, TASK_09, barry_photo_scene);
                }
            }
            else if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
            {
                evt_exec(0, TASK_09, chris_waits);
            }
            set(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE);
            room_bgm_state_set(4, ROOM_502_LADDER_ROOM, BGM_RELOAD | 2);
        }
        if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE) && ck(FG_COMMON, F_COMMON_J_CAME_FROM_500, TRUE))
        {
            pos_set(ENEMY_01_NPC_CHRIS, 0, 1504, 0, 3860, 0, 11550);
            evt_exec(0, TASK_09, chris_waits);
            set(FG_COMMON, F_COMMON_J_BEEN_TO_501, FALSE);
        }
    }
}

event barry_photo_scene
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_flag_op(EF_SET, EF_0010);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_03, 3800, 10900, F_ROOM_J_WALK_DONE);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_WALK_DONE, FALSE));
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_PHOTO_SCENE, TRUE);
        set(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE);
        cutnext(CAM_03);
        dir_set(0, 0, 1552, 0, 3850, 0, 11500);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_ACTOR_ANIM_DONE, 0);
    act_motion_path(MOTION_32, 0, -300, 0, 0, 30);
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        voice_play(VOICE_PLAY, VO_11A_01);
        message(MSG_VO_11A_01, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_33, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_flag_op(EF_SET, EF_0010);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_motion_path(MOTION_33, -400, -100, 0, 20, 10);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        voice_play(VOICE_PLAY, VO_11A_02);
        message(MSG_VO_11A_02, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 0, 1, 20, 0);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_motion_path(MOTION_33, 50, 20, 0, 10, 10);
    act_reset();
    evt_nop();
    sleep(60);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_motion_path(MOTION_33, -300, -20, 0, 20, 10);
    act_reset();
    evt_nop();
    sleep(150);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_motion_path(MOTION_33, 20, 0, 0, 20, 10);
    act_reset();
    evt_nop();
    sleep(80);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_32, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_reset();
    evt_nop();
    sleep(15);
    sys_multi(SYS_FORCE_ACTION);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 0, 1, 20, 0);
    act_reset();
    evt_nop();
    wait_message();
    cutnext(CAM_02);
    sleep(1);
    run
    {
        voice_play(VOICE_PLAY, VO_11A_03);
        message(MSG_VO_11A_03, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_33, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_flag_op(EF_SET, EF_0010);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_motion_path(MOTION_33, 50, 20, 0, 10, 10);
    act_reset();
    evt_nop();
    sleep(100);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, -300, 0, 0, 20);
    act_reset();
    evt_nop();
    sleep(240);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_anim_flags(ANIM_31, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_flag_op(EF_SET, EF_0010);
    act_reset();
    evt_nop();
    sleep(130);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_motion_path(MOTION_33, 50, 20, 0, 10, 10);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_72, 0, 300, 1, 0, 20);
    act_reset();
    evt_nop();
    sleep(60);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    sleep(70);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
    evt_actor_begin();
    act_anim_flags(ANIM_32, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_reset();
    evt_nop();
    sleep(50);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, -400, 300, 0, 30, 20);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        bgm_play(BGM_SUB_1);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_32, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_reset();
    evt_nop();
    sleep(140);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_34, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    sleep(40);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    run
    {
        aot_on(AOT_02_ITEM_FILE_BARRYS_PICTURE, SCE_DOCUMENT, 0);
    }
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutnext(CAM_00);
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event jill_talks_or_barry_photo_scene_with_chris
{
    sleep(1);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        evt_disable(TASK_07);
    }
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_anim_flags(ANIM_30, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_flag_op(EF_SET, EF_0010);
        act_reset();
        evt_nop();
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_anim_flags(ANIM_09, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_reset();
        evt_nop();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_24, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_reset();
        evt_nop();
        sleep(30);
        cutnext(CAM_02);
        sleep(20);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_motion_path(MOTION_31, -500, 0, 0, 30, 0);
        act_reset();
        evt_nop();
        sleep(20);
        run
        {
            voice_play(VOICE_PLAY, VO_11A_00);
            message(MSG_VO_11A_00, 0);
        }
        wait_message();
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_anim_flags(ANIM_09, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_flag_op(EF_SET, EF_0001);
        act_reset();
        evt_nop();
        sleep(30);
        run
        {
            cutnext(CAM_01);
            cut_auto(CUT_FREE);
            pos_set(ENEMY_01_NPC_CHRIS, 0, 1720, 0, 6300, 0, 11400);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_23, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_motion_path(MOTION_71, 300, 0, 1, 30, 0);
        act_reset();
        evt_nop();
        sleep(50);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
        evt_actor_begin();
        act_motion_path(MOTION_33, -500, 200, 0, 30, 20);
        act_reset();
        evt_nop();
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_seq(AB_03, 3800, 10900, F_ROOM_J_WALK_DONE);
        act_nop();
        act_reset();
        evt_nop();
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_J_WALK_DONE, FALSE));
        run
        {
            set(FG_COMMON, F_COMMON_J_BARRY_PHOTO_SCENE, TRUE);
            set(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE);
            cutnext(CAM_03);
            dir_set(0, 0, 1552, 0, 3850, 0, 11500);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_09, F_ROOM_ACTOR_ANIM_DONE, 0);
        act_motion_path(MOTION_32, 0, -300, 0, 0, 30);
        act_reset();
        evt_nop();
    }
    sleep(10);
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            voice_play(VOICE_PLAY, VO_A00_05_46);
            message(MSG_VO_A00_05_46, 0);
        }
        else
        {
            voice_play(VOICE_PLAY, VO_11A_01);
            message(MSG_VO_11A_01, 0);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
    }
    else
    {
        evt_work_set(WK_PLAYER, 0);
    }
    evt_actor_begin();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        act_anim_flags(ANIM_2D, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
    }
    else
    {
        act_anim_flags(ANIM_33, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_flag_op(EF_SET, EF_0010);
        act_reset();
        evt_nop();
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_motion_path(MOTION_33, -400, -100, 0, 20, 10);
        act_reset();
        evt_nop();
        wait_message();
        run
        {
            voice_play(VOICE_PLAY, VO_11A_02);
            message(MSG_VO_11A_02, 0);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_71, 300, 0, 1, 20, 0);
        act_reset();
        evt_nop();
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_motion_path(MOTION_33, 50, 20, 0, 10, 10);
        act_reset();
        evt_nop();
        sleep(60);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_motion_path(MOTION_33, -300, -20, 0, 20, 10);
        act_reset();
        evt_nop();
        sleep(150);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_motion_path(MOTION_33, 20, 0, 0, 20, 10);
        act_reset();
        evt_nop();
        sleep(80);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_32, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_reset();
        evt_nop();
        sleep(15);
        sys_multi(SYS_FORCE_ACTION);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_71, 300, 0, 1, 20, 0);
        act_reset();
        evt_nop();
        wait_message();
        cutnext(CAM_02);
        run
        {
            voice_play(VOICE_PLAY, VO_11A_03);
            message(MSG_VO_11A_03, 0);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_33, F_ROOM_ACTOR_ANIM_DONE, AFL_01);
        act_flag_op(EF_SET, EF_0010);
        act_reset();
        evt_nop();
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY_2);
        evt_actor_begin();
        act_motion_path(MOTION_33, 50, 20, 0, 10, 10);
        act_reset();
        evt_nop();
        sleep(100);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion_path(MOTION_32, 0, -300, 0, 0, 20);
        act_reset();
        evt_nop();
