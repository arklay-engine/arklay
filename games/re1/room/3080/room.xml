    <language lang="fr-FR">
      <string key="save_name">Salle de la cour SS1</string>
      <string key="0">{scroll 0}\nOh, Jill. Quelle synchro.{scroll 1}{timed 95}</string>
      <string key="1">{scroll 0}Il y a un instant, j'ai entendu une\nune voix venant de ce trou{scroll 1}{timed 105}</string>
      <string key="2">{scroll 0}\nAllons-y ensemble.{scroll 1}{clear 40}{scroll 0}Il y fait sombre et on n'y \nvoit pas à deux mètres. {scroll 1}{timed 85}</string>
      <string key="3">{scroll 0}</string>
      <string key="4">{scroll 0}\nOK, allons-y! {scroll 1}{timed 55}</string>
      <string key="5">{scroll 0}OK, je te couvre. \nDépêchons-nous. {scroll 1}{timed 120}</string>
      <string key="6">{scroll 0}\nEh, ça va?  {scroll 1}{clear 60}{scroll 0}Je peux y aller \nen premier si tu veux... {scroll 1}{timed 100}</string>
      <string key="7">{scroll 0}</string>
      <string key="8">{scroll 0}Oh oui, s'il te plaît. \nJe ne suis pas tranquille. {scroll 1}{timed 70}</string>
      <string key="9">{scroll 0}\nJe comprends.  {scroll 1}{timed 35}</string>
      <string key="10">{scroll 0}Mais cela peut être plus\ndangereux encore si tu me{scroll 1}{clear 70}{scroll 0}suis...\nSois prudente!{scroll 1}{timed 50}</string>
      <string key="11">{scroll 0}\nOK. Allons-y, Barry.{scroll 1}{timed 65}</string>
      <string key="12">{scroll 0}\nJe compte sur toi.{scroll 1}{timed 65}</string>
      <string key="13">{scroll 0}\n...Barry.... Je... {scroll 1}{timed 65}</string>
      <string key="14">{scroll 0}....Cela peut être\ndangereux.{scroll 1}{timed 55}</string>
      <string key="15">{scroll 0}J'y vais même si je dois y \naller seul.  {scroll 1}{timed 75}</string>
      <string key="16">{scroll 0}\nTu m'attends ici, Jill? {scroll 1}{timed 80}</string>
      <string key="17">{scroll 0}\nJe suis désolée. {scroll 1}{timed 40}</string>
      <string key="18">{scroll 0}Ce n'est pas grave. \nBon, j'y vais.{scroll 1}{timed 100}</string>
      <string key="19">{scroll 0}Attends ici. \nJe reviens tout de suite! {scroll 1}{timed 165}</string>
      <string key="20">{scroll 0}Barry, je crois que je vais \nprendre un autre chemin. {scroll 1}{timed 95}</string>
      <string key="21">{scroll 0}Je vois... Tu as peut-être \nraison.  {scroll 1}{clear 75}{scroll 0}\nFais attention. {scroll 1}{timed 30}</string>
      <string key="22">{scroll 0}</string>
      <string key="23">{scroll 1}Voulez-vous l'accompagner?\n{scroll 1}{branch 0 6 0}</string>
      <string key="24">{scroll 1}Voulez-vous qu'il vous \nprécède?{scroll 1}{branch 0 6 0}</string>
      <string key="25">{scroll 1}Voulez-vous rester ici?\n {scroll 1}{branch 0 6 0}</string>
      <string key="26">{scroll 0}Tu baisses déjà les bras? \nÇa ne te ressemble pas. {scroll 1}{timed 90}</string>
      <string key="27">{scroll 0}\nBarry? {scroll 1}{timed 55}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}Oh, Jill.\nWas für ein Timing.{scroll 1}{timed 95}</string>
      <string key="1">{scroll 0}Noch vor einem Augenblick\nhörte ich irgendeine Stimme{scroll 1}{clear 65}{scroll 0}\ndurch dieses Loch.{scroll 1}{timed 40}</string>
      <string key="2">{scroll 0}Lass uns zusammen gehen,\ndenn es ist so dunkel,{scroll 1}\n{scroll 0}\nund wir können kaum was sehen.{scroll 1}{timed 45}</string>
      <string key="3">{scroll 0}</string>
      <string key="4">{scroll 0}\nOkay, dann los!{scroll 1}{timed 55}</string>
      <string key="5">{scroll 0}Okay, dann werde ich dir\nDeckung geben.{scroll 1}{clear 70}{scroll 0}\nWir sollten uns beeilen.{scroll 1}{timed 50}</string>
      <string key="6">{scroll 0}\nHey, alles in Ordnung mit dir?{scroll 1}\n{scroll 0}Wenn du möchtest,\nkann ich auch zuerst gehen...{scroll 1}{timed 100}</string>
      <string key="7">{scroll 0}</string>
      <string key="8">{scroll 0}Oh ja, bitte.\nIch bin etwas nervös.{scroll 1}{timed 80}</string>
      <string key="9">{scroll 0}\nSchon klar.{scroll 1}{timed 35}</string>
      <string key="10">{scroll 0}Es könnte sogar\ngefährlicher sein,{scroll 1}{clear 60}{scroll 0}\nwenn du hinter mir herkommst...{scroll 1}{clear 54}{scroll 0}\nGib gut Acht!{scroll 1}{timed 50}</string>
      <string key="11">{scroll 0}Okay.\nLos geht's, Barry.{scroll 1}{timed 65}</string>
      <string key="12">{scroll 0}\nIch verlass mich auf dich.{scroll 1}{timed 65}</string>
      <string key="13">{scroll 0}\n...Barry... ich...{scroll 1}{timed 65}</string>
      <string key="14">{scroll 0}...Natürlich könnte es\ngefährlich werden.{scroll 1}{timed 55}</string>
      <string key="15">{scroll 0}Ich werde gehen, sogar wenn\nich ganz allein gehen muss.{scroll 1}{timed 75}</string>
      <string key="16">{scroll 0}Willst du lieber hier warten,\nJill?{scroll 1}{timed 80}</string>
      <string key="17">{scroll 0}\nEs tut mir so Leid.{scroll 1}{timed 40}</string>
      <string key="18">{scroll 0}Ist schon gut.\nIch gehe jetzt wirklich.{scroll 1}{timed 100}</string>
      <string key="19">{scroll 0}Warte einfach hier.\nIch bin bald zurück!{scroll 1}{timed 165}</string>
      <string key="20">{scroll 0}Barry, ich denke, ich sollte\neinen anderen Weg versuchen.{scroll 1}{timed 95}</string>
      <string key="21">{scroll 0}Ich verstehe...\nTja, vielleicht solltest du.{scroll 1}{timed 105}</string>
      <string key="22">{scroll 0}\nSei vorsichtig.{scroll 1}{timed 60}</string>
      <string key="23">{scroll 1}Möchten Sie mit ihm gehen?\n{scroll 1}{branch 0 6 0}</string>
      <string key="24">{scroll 1}Möchten Sie, dass er vorgeht?\n{scroll 1}{branch 0 6 0}</string>
      <string key="25">{scroll 1}Möchten Sie hier bleiben?\n{scroll 1}{branch 0 6 0}</string>
      <string key="26">{scroll 0}Hast du den Mut verloren?\nDas sieht dir nicht ähnlich.{scroll 1}{timed 90}</string>
      <string key="27">{scroll 0}\nBarry?{scroll 1}{timed 55}</string>
