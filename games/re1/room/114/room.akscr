#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_109 0x00
#define AOT_01_ITEM_HEAL_HERB_GREEN_0 0x01
#define AOT_02_ITEM_HEAL_HERB_GREEN_1 0x02
#define AOT_03_ITEM_HEAL_HERB_GREEN_2 0x03
#define AOT_04_ITEM_HEAL_HERB_GREEN_3 0x04
#define AOT_05_ITEM_HEAL_HERB_GREEN_4 0x05
#define AOT_06_ITEM_HEAL_HERB_GREEN_5 0x06
#define AOT_09_MESSAGE_BOILER 0x09
#define AOT_0A_USEITEM_BOILER_FRONT 0x0A                    // Data 4,0,62 raises F_ROOM_AT_BOILER here.
#define CAM_00 0x00
#define CAM_02 0x02
#define ENEMY_00_CERBERUS 0x00
#define ENEMY_00_ZOMBIE 0x00
#define ENEMY_01_CERBERUS 0x01
#define ENEMY_01_ZOMBIE 0x01
#define ENEMY_02_ZOMBIE_GREEN 0x02
#define F_ROOM_AT_BOILER 0x3E                               // Raised while the player stands in front of the boiler; turns on its examine spot.
#define F_ROOM_DOGS_RELEASED 0x00                           // Likely: the second dog was let loose at camera 2; the first attacks back at camera 0.
#define IMDL_00_HEAL_HERB_GREEN 0x00
#define IMDL_01_HEAL_HERB_GREEN 0x01
#define IMDL_02_HEAL_HERB_GREEN 0x02
#define IMDL_03_HEAL_HERB_GREEN 0x03
#define IMDL_04_HEAL_HERB_GREEN 0x04
#define IMDL_05_HEAL_HERB_GREEN 0x05

proc init
{
    door_aot_set(AOT_00_DOOR_109, 10500, 22812, 978, 1596, 1, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_109_TRAP_PASSAGE, 24300, 0, 7600, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM_HEAL_HERB_GREEN_0, 18600, 11900, 1500, 2400, IT_44_HEAL_HERB_GREEN, 1, IMDL_00_HEAL_HERB_GREEN, SCA_NONE, 18886, 0, 14300, 0, F_ITEM_114_HEAL_HERB_GREEN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_02_ITEM_HEAL_HERB_GREEN_1, 18600, 11900, 1500, 2400, IT_44_HEAL_HERB_GREEN, 1, IMDL_01_HEAL_HERB_GREEN, SCA_NONE, 18886, 0, 13850, 0, F_ITEM_114_HEAL_HERB_GREEN_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_03_ITEM_HEAL_HERB_GREEN_2, 18600, 11900, 1500, 2400, IT_44_HEAL_HERB_GREEN, 1, IMDL_02_HEAL_HERB_GREEN, SCA_NONE, 18886, 0, 13370, 0, F_ITEM_114_HEAL_HERB_GREEN_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_04_ITEM_HEAL_HERB_GREEN_3, 18600, 11900, 1500, 2400, IT_44_HEAL_HERB_GREEN, 1, IMDL_03_HEAL_HERB_GREEN, SCA_NONE, 18886, 0, 12910, 0, F_ITEM_114_HEAL_HERB_GREEN_3, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_05_ITEM_HEAL_HERB_GREEN_4, 12000, 14100, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_04_HEAL_HERB_GREEN, SCA_NONE, 13216, 0, 15450, 0, F_ITEM_114_HEAL_HERB_GREEN_4, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_06_ITEM_HEAL_HERB_GREEN_5, 12000, 14100, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_05_HEAL_HERB_GREEN, SCA_NONE, 12766, 0, 15450, 0, F_ITEM_114_HEAL_HERB_GREEN_5, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    aot_set(AOT_09_MESSAGE_BOILER, 13700, 14100, 2600, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_0A_USEITEM_BOILER_FRONT, 13700, 13100, 2600, 1200, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 62, 0, 1, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_BOILER_DOGS_SCENE, FALSE))
        {
            enemy(EM_02_CERBERUS, EB_01, F_ENEMY_114_CERBERUS_0, SPAWN_FORCE, 2, 0, 0, 0, 4000, 0, 21696, ENEMY_00_CERBERUS, ANIM_00, 0, EVAR_00);
            enemy(EM_02_CERBERUS, EB_80, F_ENEMY_114_CERBERUS_1, SPAWN_FORCE, 2, 0, 2400, 0, 22000, 0, 9800, ENEMY_01_CERBERUS, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_09, first_dog_attacks);
            evt_exec(0, TASK_09, second_dog_attacks);
        }
        else
        {
            enemy(EM_02_CERBERUS, EB_08, F_ENEMY_114_CERBERUS_0, SPAWN_FORCE, 2, 0, 2800, 0, 10000, 0, 13500, ENEMY_00_CERBERUS, ANIM_00, 0, EVAR_00);
            enemy(EM_02_CERBERUS, EB_08, F_ENEMY_114_CERBERUS_1, SPAWN_FORCE, 2, 0, 1700, 0, 18800, 0, 13200, ENEMY_01_CERBERUS, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        enemy(EM_11_ZOMBIE_GREEN, EB_00, F_ENEMY_114_ZOMBIE_GREEN_0, SPAWN_FORCE, 2, 0, 3184, 0, 8018, 0, 17483, ENEMY_00_ZOMBIE, ANIM_00, 0, EVAR_00);
        enemy(EM_11_ZOMBIE_GREEN, EB_00, F_ENEMY_114_ZOMBIE_GREEN_1, SPAWN_FORCE, 2, 0, 2048, 0, 10560, 0, 14947, ENEMY_01_ZOMBIE, ANIM_00, 0, EVAR_00);
        enemy(EM_11_ZOMBIE_GREEN, EB_01, F_ENEMY_114_ZOMBIE_GREEN_2, SPAWN_FORCE, 2, 0, 2128, 0, 18370, 0, 13340, ENEMY_02_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_AT_BOILER, TRUE))
    {
        aot_delete(AOT_09_MESSAGE_BOILER, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_09_MESSAGE_BOILER, SCE_MESSAGE, 0);
    }
}

event first_dog_attacks
{
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_DOGS_RELEASED, FALSE));
    do
    {
        evt_next();
    }
    while (cmpb(B_CAMERA, CMP_NE, CAM_00));
    eml_state(0, ENEMY_00_CERBERUS, EML_BEHAVIOUR, EB_06);
    set(FG_SCENARIO, F_SCENARIO_BOILER_DOGS_SCENE, TRUE);
    evt_finish();
}

event second_dog_attacks
{
    do
    {
        evt_next();
    }
    while (cmpb(B_CAMERA, CMP_NE, CAM_02));
    sleep(1);
    run
    {
        eml_state(0, ENEMY_00_CERBERUS, EML_BEHAVIOUR, EB_80);
        eml_state(0, ENEMY_01_CERBERUS, EML_BEHAVIOUR, EB_06);
        set(FG_ROOM, F_ROOM_DOGS_RELEASED, TRUE);
        pos_set(ENEMY_00_CERBERUS, 0, 400, 0, 4000, 0, 28110);
    }
    evt_finish();
}
