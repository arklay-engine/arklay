#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_101 0x00
#define AOT_01_DOOR_104 0x01
#define AOT_02_DOOR_10C 0x02
#define AOT_03_DOOR_10D 0x03
#define AOT_04_DOOR_10E 0x04
#define AOT_05_USEITEM_AMBUSH_SOUTH 0x05                    // Floor trigger: raises F_ROOM_SOUTH_TRIGGER_HIT.
#define AOT_06_USEITEM_AMBUSH_NORTH 0x06                    // Floor trigger: raises F_ROOM_NORTH_TRIGGER_HIT.
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_HUNTER 0x01
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define ENEMY_02_ZOMBIE_GROUNDSKEEPER 0x02
#define F_ROOM_ANIM_DONE 0x3F                               // Raised when an actor's animation ends (one frame); nothing waits for it.
#define F_ROOM_ENTERED_NORTH 0x01                           // Came in from 101 or 10C before the ambush: the hunter waits for the north trigger.
#define F_ROOM_ENTERED_SOUTH 0x00                           // Came in from 104 or 10E before the ambush: the hunter waits for the south trigger.
#define F_ROOM_NORTH_TRIGGER_HIT 0x03                       // The player stepped on AOT_06's trigger (one frame).
#define F_ROOM_SOUTH_TRIGGER_HIT 0x02                       // The player stepped on AOT_05's trigger (one frame).
#define VO_A00_00 0x85

proc init
{
    if (MANSION1)
    {
        door_aot_set(AOT_00_DOOR_101, 0, 23700, 2500, 2100, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_101_1F_LEFT_STAIRS, 19000, 0, 20500, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_01_DOOR_104, 800, 500, 3200, 2500, 1, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 1, DOOR_LOCKED | F_LOCK_103_104, ROOM_104_TEA_ROOM, 15800, 0, 3700, 1024, LOCK, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_02_DOOR_10C, 19000, 17700, 2500, 2400, 2, DOOR_SND_00_DR_WD, DOOR_02_DOOR02, 1, DOOR_LOCK_40, ROOM_10C_GREEN_HOUSE, 13600, 0, 7400, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_03_DOOR_10D, 7500, 15100, 2300, 2000, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, DOOR_LOCK_40, ROOM_10D_TIGER_STATUE_ROOM, 5600, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_04_DOOR_10E, 0, 10100, 2400, 1600, 2, DOOR_SND_00_DR_WD, DOOR_1C_DOOR00K, 3, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_103_10E, ROOM_10E_EMPLOYEE_ROOM, 7400, 0, 10700, 2048, IT_33_KEY_MANSION_SWORD, SAT_MANUAL | SAT_PLAYER);
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_103_ZOMBIE_GROUNDSKEEPER_0, SPAWN_FORCE, 2, 0, 1024, 0, 8380, 0, 25515, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        if (CHRIS)
        {
            enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_103_ZOMBIE_GROUNDSKEEPER_1, SPAWN_FORCE, 2, 0, 2177, 0, 14813, 0, 22274, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        }
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_01, F_ENEMY_103_ZOMBIE_GROUNDSKEEPER_2, SPAWN_FORCE, 2, 0, 2025, 0, 4210, 0, 14400, ENEMY_02_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_C_BAR_WOOD_EMBLEM_SET, TRUE))
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_LEFT_BAR, TRUE);
            }
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_JUST_SPOKE, FALSE);
            }
        }
    }
    else
    {
        door_aot_set(AOT_00_DOOR_101, 0, 23700, 2400, 2700, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_101_1F_LEFT_STAIRS, 19000, 0, 20500, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_01_DOOR_104, 2300, 1600, 1500, 1000, 1, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 1, DOOR_LOCKED | F_LOCK_103_104, ROOM_104_TEA_ROOM, 15800, 0, 3700, 1024, LOCK, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_02_DOOR_10C, 19600, 18200, 1900, 1000, 2, DOOR_SND_00_DR_WD, DOOR_02_DOOR02, 1, 0, ROOM_10C_GREEN_HOUSE, 13600, 0, 7400, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_03_DOOR_10D, 7900, 15300, 3100, 2200, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, ROOM_10D_TIGER_STATUE_ROOM, 5600, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_04_DOOR_10E, 0, 10700, 2300, 1300, 2, DOOR_SND_00_DR_WD, DOOR_1C_DOOR00K, 3, DOOR_LOCKED | F_LOCK_103_10E, ROOM_10E_EMPLOYEE_ROOM, 7400, 0, 10700, 2048, IT_33_KEY_MANSION_SWORD, SAT_MANUAL | SAT_PLAYER);
        aot_set(AOT_05_USEITEM_AMBUSH_SOUTH, 0, 9300, 6400, 6800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 2, 0, 1, 0);
        aot_set(AOT_06_USEITEM_AMBUSH_NORTH, 0, 11700, 6400, 6800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 3, 0, 1, 0);
        if (ck(FG_SCENARIO, F_SCENARIO_F_PASSAGE_HUNTER_AMBUSH, TRUE))
        {
            enemy(EM_06_HUNTER, EB_10, F_ENEMY_103_HUNTER_0, SPAWN_FORCE, 2, 0, 1152, 0, 5219, 0, 15022, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        else
        {
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_104_TEA_ROOM))
            {
                set(FG_ROOM, F_ROOM_ENTERED_SOUTH, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_10E_EMPLOYEE_ROOM))
            {
                set(FG_ROOM, F_ROOM_ENTERED_SOUTH, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_101_1F_LEFT_STAIRS))
            {
                set(FG_ROOM, F_ROOM_ENTERED_NORTH, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_10C_GREEN_HOUSE))
            {
                set(FG_ROOM, F_ROOM_ENTERED_NORTH, TRUE);
            }
        }
        if (ck(FG_ROOM, F_ROOM_ENTERED_SOUTH, TRUE))
        {
            enemy(EM_06_HUNTER, EB_88, F_ENEMY_103_HUNTER_0, SPAWN_FORCE, 2, 0, 2048, 0, 6819, 0, 14176, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_ROOM, F_ROOM_ENTERED_NORTH, TRUE))
        {
            enemy(EM_06_HUNTER, EB_89, F_ENEMY_103_HUNTER_0, SPAWN_FORCE, 2, 0, 2048, 0, 6819, 0, 14176, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_103_HUNTER_1, SPAWN_FORCE, 2, 0, 2192, 0, 15874, 0, 22102, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_UNDER_ATTACK, TRUE))
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_KILLED, TRUE);
                set(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE);
                set(FG_COMMON, F_COMMON_C_REBECCA_UNDER_ATTACK, FALSE);
                if (CHRIS)
                {
                    evt_exec(0, TASK_09, rebecca_scream_heard);
                }
                else
                {
                    evt_exec(0, TASK_09, event_00);
                }
            }
        }
    }
}

proc main when (MANSION2)
{
    if (ck(FG_SCENARIO, F_SCENARIO_F_PASSAGE_HUNTER_AMBUSH, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_ENTERED_SOUTH, TRUE) && ck(FG_ROOM, F_ROOM_SOUTH_TRIGGER_HIT, TRUE))
        {
            set(FG_SCENARIO, F_SCENARIO_F_PASSAGE_HUNTER_AMBUSH, TRUE);
            eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_08);
        }
        if (ck(FG_ROOM, F_ROOM_ENTERED_NORTH, TRUE) && ck(FG_ROOM, F_ROOM_NORTH_TRIGGER_HIT, TRUE))
        {
            set(FG_SCENARIO, F_SCENARIO_F_PASSAGE_HUNTER_AMBUSH, TRUE);
            eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_09);
        }
    }
}

event rebecca_scream_heard when (CHRIS && MANSION2)
{
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_RUN, F_RUN_MONSTERS, FALSE);
    voice_play(VOICE_PLAY, VO_A00_00);
    wait_message();
    evt_fork(TASK_09, rebecca_scream_heard_chris, 0);
    sleep(100);
    run
    {
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_finish();
}

event rebecca_scream_heard_chris when (CHRIS && MANSION2)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_ANIM_DONE, 0);
    act_param_set(0, 2048);
    sleep(42);
    act_idle();
    act_finish();
}
