event clock_slides_open
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    bgm_stop(BGM_SUB_1);
    sleep(10);
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        cutnext(CAM_05_CLOCK);
        se_play_3d(SND_BANK_ROOM, SE_1A, 0, SND_AT_POINT, 0, 19000, 14000);
    }
    sleep(40);
    se_play_3d(SND_BANK_ROOM, SE_1A, 0, SND_AT_POINT, 0, 19000, 14000);
    sleep(40);
    se_play_3d(SND_BANK_ROOM, SE_1A, 0, SND_AT_POINT, 0, 19000, 14000);
    sleep(50);
    se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_POINT, 0, 19000, 14000);
    evt_work_set(WK_OBJ, OBJ_02_CLOCK);
    evt_tween_begin_alt();
    evt_next();
    tw_nop();
    tw_set_pos(-20, 0, 0);
    for (100)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    sleep(10);
    run
    {
        cutnext(CAM_03_FIREPLACE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
        room_bgm_state_set(0, ROOM_105_DINING_ROOM, BGM_MAIN_ON);
        room_bgm_state_set(1, ROOM_202_DINING_ROOM_2F, BGM_MAIN_ON);
    }
    evt_finish();
}

