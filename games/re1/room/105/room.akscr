    act_motion_path(MOTION_31, -600, 0, 0, 40, 0);
    sleep(40);
    act_motion_path(MOTION_31, 330, 0, 0, 60, 0);
    sleep(25);
    act_motion_path(MOTION_31, -400, 0, 0, 40, 0);
    sleep(30);
    act_reset();
    evt_nop();
    evt_chain(barry_looks_around);
}

