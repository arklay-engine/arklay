#define AOT_04_ITEM_KEY_EMBLEM_WOOD_1 0x04
#define AOT_05_EVENT_HALL_DOOR_BLOCK 0x05
#define AOT_05_ITEM_KEY_EMBLEM_GOLD_2 0x05                  // Not a pickup: a 0 by 0 spot.
#define AOT_06_ITEM_KEY_MANSION_SHIELD_0 0x06
#define AOT_06_USEITEM_FIREPLACE_WOOD_ALT 0x06              // Use-item spot with data 9,0,N; its role is not traced.
#define AOT_07_ITEM_KEY_EMBLEM_WOOD_1 0x07
#define AOT_07_USEITEM_FIREPLACE_WOOD 0x07
#define AOT_08_ITEM_KEY_EMBLEM_GOLD_2 0x08                  // Not a pickup: a 0 by 0 spot.
#define AOT_08_USEITEM_FIREPLACE_GOLD_ALT 0x08              // Use-item spot with data 9,0,N; its role is not traced.
#define AOT_09_USEITEM_FIREPLACE_GOLD 0x09
#define AOT_09_USEITEM_FIREPLACE_WOOD_ALT 0x09
#define AOT_0A_EVENT_FIREPLACE_HOLLOW 0x0A
#define AOT_0A_USEITEM_FIREPLACE_WOOD 0x0A
#define AOT_0B_MESSAGE_EMPTY_CABINET 0x0B                   // Guess: the object is a cabinet.
#define AOT_0B_USEITEM_FIREPLACE_GOLD_ALT 0x0B              // Use-item spot with data 9,0,N; its role is not traced.
#define AOT_0C_MESSAGE_PORTRAIT_WOMAN 0x0C
#define AOT_0C_USEITEM_FIREPLACE_GOLD 0x0C
#define AOT_0D_EVENT_FIREPLACE_HOLLOW 0x0D
#define AOT_0D_MESSAGE_PAINTING_SCENERY 0x0D
#define AOT_0E_EVENT_DOOR_ZOMBIE 0x0E                       // Starts as SCE_NONE; main turns it into the zombie event.
#define AOT_0E_MESSAGE_TABLE 0x0E
#define AOT_0F_MESSAGE_EMPTY_CABINET 0x0F
#define AOT_0F_MESSAGE_WINDOW 0x0F
#define AOT_10_MESSAGE_BLOOD 0x10
#define AOT_10_MESSAGE_CLOCK 0x10
#define AOT_11_MESSAGE_CLOCK_MOVED 0x11                     // The clock after it moves; its text is missing.
#define AOT_11_MESSAGE_PORTRAIT_WOMAN 0x11
#define AOT_12_ITEM_KEY_JEWEL_BLUE_4 0x12
#define AOT_12_MESSAGE_PAINTING_SCENERY 0x12
#define AOT_13_MESSAGE_TABLE 0x13
#define AOT_14_MESSAGE_WINDOW 0x14
#define AOT_15_MESSAGE_CLOCK 0x15                           // The clock before it moves; its text is missing.
#define AOT_16_MESSAGE_CLOCK_MOVED 0x16                     // The clock after it moves; its text is missing.
#define AOT_17_ITEM_KEY_JEWEL_BLUE_4 0x17
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03_FIREPLACE 0x03
#define CAM_04 0x04
#define CAM_05_CLOCK 0x05
#define CAM_06_FIREPLACE_CLOSEUP 0x06
#define ENEMY_00_BARRY 0x00
#define ENEMY_01_FIRST_ZOMBIE 0x01                          // Stands in for 104's zombie.
#define F_ROOM_C_GOLD_EMBLEM_USED 0x20                      // Chris: the gold emblem was used on the fireplace (one frame).
#define F_ROOM_C_WOOD_EMBLEM_USED 0x21                      // Chris: the wooden emblem was used on the fireplace (one frame).
#define F_ROOM_J_ARM_DOOR_ZOMBIE 0x08                       // Main turns on the 104 door trigger where Barry shoots the zombie.
#define F_ROOM_J_BARRY_ANIM_DONE 0x21                       // Jill: Barry's animation finished (one frame).
#define F_ROOM_J_BARRY_TO_FIREPLACE 0x04                    // Likely: Barry goes to (or is already at) the fireplace.
#define F_ROOM_J_BARRY_WALK_GO 0x03                         // Likely: ends Barry's first walk loop.
#define F_ROOM_J_BARRY_WALK_IN 0x01                         // Barry's first entry: he walks in.
#define F_ROOM_J_GOLD_EMBLEM_USED 0x22                      // The gold emblem was used on the fireplace (one frame).
#define F_ROOM_J_PLAYER_ANIM_DONE 0x20                      // Jill: Jill's animation finished (one frame).
#define F_ROOM_J_PLAYER_AT_CAM_01 0x02                      // Likely: Jill reached camera 1 (or timed out); Barry starts walking.
#define F_ROOM_J_PLAYER_AT_FIREPLACE 0x06                   // Jill's walk to Barry finished.
#define F_ROOM_J_PLAYER_NEAR_BARRY 0x05                     // Jill stepped near Barry at the fireplace.
#define F_ROOM_J_START_BARRY_EVENT 0x00                     // Init asks main to start Barry's scene.
#define F_ROOM_J_WOOD_EMBLEM_USED 0x23                      // The wooden emblem was used on the fireplace (one frame).
#define IMDL_00_KEY_MANSION_SHIELD 0x00
#define IMDL_01_EMBLEM_WOOD 0x01
#define IMDL_02_EMBLEM_GOLD 0x02
#define IMDL_04_JEWEL_BLUE 0x04
#define MSG_AN_EMBLEM_IS_IN_PLACE 0x11
#define MSG_IT_IS_THE_HOLLOW_THAT_AN 0x10
#define MSG_THERE_MAY_BE_MORE_HERE_WORTH 0x0E
#define MSG_VO_102_03 0x03
#define OBJ_00_BLOOD_POOL 0x00                              // Guess: where Barry kneels; intangible.
#define OBJ_01_BLOOD_SPLASH 0x01                            // Guess: beside OBJ_00_BLOOD_POOL.
#define OBJ_02_CLOCK 0x02
#define OBJ_03_FALLEN_STATUE 0x03
#define SE_17 0x17
#define SE_18 0x18
#define SE_19 0x19
#define SE_1A 0x1A
#define SE_1B 0x1B
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_102_00 0x1E
#define VO_102_01 0x1F
#define VO_102_02 0x20
#define VO_102_03 0x21
#define VO_102_04 0x22
#define VO_102_05 0x23
#define VO_102_06 0x24
#define VO_102_07 0x25
#define VO_102_08 0x26
#define VO_102_09 0x27
#define VO_102_0A_28 0x28
#define VO_102_0B 0x29
#define VO_102_0C 0x2A
#define VO_102_0D 0x2B
#define VO_102_0E_2C 0x2C

proc init
{
    door_aot_set(AOT_00_DOOR_104, 5300, 14000, 2800, 2800, 2, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 4, 0, ROOM_104_TEA_ROOM, 11500, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_106, 31600, 6300, 2000, 4000, 9, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 7, 0, ROOM_106_MAIN_HALL, 3400, 0, 17000, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        aot_set(AOT_02_EVENT_HALL_DOOR_BLOCK, 31700, 6300, 2000, 4000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
        item_aot_set(AOT_03_ITEM_KEY_MANSION_SHIELD_0, 17400, 14500, 1000, 1000, IT_35_KEY_MANSION_SHIELD, 1, IMDL_00_KEY_MANSION_SHIELD, SCA_NONE, 18000, -2400, 14880, 0, F_ITEM_105_KEY_MANSION_SHIELD_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6);
        if (ck(FG_COMMON, F_COMMON_C_FIREPLACE_WOOD_EMBLEM, TRUE))
        {
            item_aot_set(AOT_04_ITEM_KEY_EMBLEM_WOOD_1, 2000, 7200, 1800, 1800, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_01_EMBLEM_WOOD, SCA_NONE, 2320, -2600, 8200, 0, F_ITEM_105_KEY_EMBLEM_WOOD_1, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_04_ITEM_KEY_EMBLEM_WOOD_1, 2000, 7200, 1800, 1800, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_01_EMBLEM_WOOD, SCA_NONE, 0, 0, 0, 0, F_ITEM_105_KEY_EMBLEM_WOOD_1, SAT_MANUAL | SAT_PLAYER, 0);
        }
        if (ck(FG_COMMON, F_COMMON_C_FIREPLACE_GOLD_EMBLEM, TRUE))
        {
            item_aot_set(AOT_05_ITEM_KEY_EMBLEM_GOLD_2, 0, 0, 0, 0, IT_20_KEY_EMBLEM_GOLD, 1, IMDL_02_EMBLEM_GOLD, SCA_NONE, 2320, -2600, 8200, 0, F_ITEM_105_KEY_EMBLEM_GOLD_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_05_ITEM_KEY_EMBLEM_GOLD_2, 0, 0, 0, 0, IT_20_KEY_EMBLEM_GOLD, 1, IMDL_02_EMBLEM_GOLD, SCA_NONE, 0, 0, 0, 0, F_ITEM_105_KEY_EMBLEM_GOLD_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
        aot_set(AOT_06_USEITEM_FIREPLACE_WOOD_ALT, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 9, 0, 4, 0, 1, 0);
        aot_set(AOT_07_USEITEM_FIREPLACE_WOOD, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 4, 0, 33, 0, 1, 0);
        aot_set(AOT_08_USEITEM_FIREPLACE_GOLD_ALT, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 9, 0, 5, 0, 1, 0);
        aot_set(AOT_09_USEITEM_FIREPLACE_GOLD, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 4, 0, 32, 0, 1, 0);
        aot_set(AOT_0A_EVENT_FIREPLACE_HOLLOW, 2400, 7200, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, fireplace_hollow_empty, 0, 0, 0);
        aot_set(AOT_0B_MESSAGE_EMPTY_CABINET, 11600, 2400, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 155, 0, 255, 0, 0, 0);
        aot_set(AOT_0C_MESSAGE_PORTRAIT_WOMAN, 19300, 14000, 2000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 149, 0, 255, 0, 0, 0);
        aot_set(AOT_0D_MESSAGE_PAINTING_SCENERY, 16700, 1300, 4000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 150, 0, 255, 0, 0, 0);
        aot_set(AOT_0E_MESSAGE_TABLE, 7200, 5800, 20000, 5000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 0, 255, 0, 0, 0);
        aot_set(AOT_0F_MESSAGE_WINDOW, 7700, 1300, 2000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 255, 0, 0, 0);
        aot_set(AOT_10_MESSAGE_CLOCK, 16600, 13000, 2500, 1000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 151, 0, 255, 0, 0, 0);
        aot_set(AOT_11_MESSAGE_CLOCK_MOVED, 14600, 13000, 2500, 1000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 152, 0, 255, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_02_EVENT_REACH_BARRY_S, 4000, 10500, 6000, 3700, SCE_NONE, SAT_UNDER | SAT_PLAYER, 5, 0, 0, 0, 0, 0);
        aot_set(AOT_03_EVENT_REACH_BARRY_N, 3000, 2300, 5000, 5300, SCE_NONE, SAT_UNDER | SAT_PLAYER, 6, 0, 0, 0, 0, 0);
        aot_set(AOT_04_EVENT_BARRY_DOOR_TALK, 31700, 6300, 2000, 4000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 7, 0, 0, 0, 0, 0);
        aot_set(AOT_05_EVENT_HALL_DOOR_BLOCK, 31700, 6300, 2000, 4000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 8, 0, 0, 0, 0, 0);
        item_aot_set(AOT_06_ITEM_KEY_MANSION_SHIELD_0, 17400, 14500, 1000, 1000, IT_35_KEY_MANSION_SHIELD, 1, IMDL_00_KEY_MANSION_SHIELD, SCA_NONE, 18000, -2400, 14880, 0, F_ITEM_105_KEY_MANSION_SHIELD_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6);
        if (ck(FG_COMMON, F_COMMON_J_FIREPLACE_WOOD_EMBLEM, TRUE))
        {
            item_aot_set(AOT_07_ITEM_KEY_EMBLEM_WOOD_1, 2000, 7200, 1800, 1800, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_01_EMBLEM_WOOD, SCA_NONE, 2320, -2600, 8200, 0, F_ITEM_105_KEY_EMBLEM_WOOD_1, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_07_ITEM_KEY_EMBLEM_WOOD_1, 2000, 7200, 1800, 1800, IT_1F_KEY_EMBLEM_WOOD, 1, IMDL_01_EMBLEM_WOOD, SCA_NONE, 0, 0, 0, 0, F_ITEM_105_KEY_EMBLEM_WOOD_1, SAT_MANUAL | SAT_PLAYER, 0);
        }
        if (ck(FG_COMMON, F_COMMON_J_FIREPLACE_GOLD_EMBLEM, TRUE))
        {
            item_aot_set(AOT_08_ITEM_KEY_EMBLEM_GOLD_2, 0, 0, 0, 0, IT_20_KEY_EMBLEM_GOLD, 1, IMDL_02_EMBLEM_GOLD, SCA_NONE, 2320, -2600, 8200, 0, F_ITEM_105_KEY_EMBLEM_GOLD_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_08_ITEM_KEY_EMBLEM_GOLD_2, 0, 0, 0, 0, IT_20_KEY_EMBLEM_GOLD, 1, IMDL_02_EMBLEM_GOLD, SCA_NONE, 0, 0, 0, 0, F_ITEM_105_KEY_EMBLEM_GOLD_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
        aot_set(AOT_09_USEITEM_FIREPLACE_WOOD_ALT, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 9, 0, 4, 0, 1, 0);
        aot_set(AOT_0A_USEITEM_FIREPLACE_WOOD, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 4, 0, 35, 0, 1, 0);
        aot_set(AOT_0B_USEITEM_FIREPLACE_GOLD_ALT, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 9, 0, 5, 0, 1, 0);
        aot_set(AOT_0C_USEITEM_FIREPLACE_GOLD, 2000, 7200, 1800, 1800, SCE_USEITEM, SAT_PLAYER, 4, 0, 34, 0, 1, 0);
        aot_set(AOT_0D_EVENT_FIREPLACE_HOLLOW, 2400, 7200, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, fireplace_hollow_empty, 0, 0, 0);
        aot_set(AOT_0E_EVENT_DOOR_ZOMBIE, 16000, 10800, 1000, 3200, SCE_NONE, SAT_UNDER | SAT_PLAYER, 9, 0, barry_shoots_zombie_at_door, 0, 0, 0);
        aot_set(AOT_0F_MESSAGE_EMPTY_CABINET, 11600, 2400, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 155, 0, 255, 0, 0, 0);
        aot_set(AOT_10_MESSAGE_BLOOD, 3700, 7000, 1000, 1200, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 146, 0, 125, 0, 0, 0);
        aot_set(AOT_11_MESSAGE_PORTRAIT_WOMAN, 19300, 14000, 2000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 149, 0, 255, 0, 0, 0);
        aot_set(AOT_12_MESSAGE_PAINTING_SCENERY, 16700, 1300, 4000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 150, 0, 255, 0, 0, 0);
        aot_set(AOT_13_MESSAGE_TABLE, 7200, 5800, 20000, 5000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 0, 255, 0, 0, 0);
        aot_set(AOT_14_MESSAGE_WINDOW, 7700, 1300, 2000, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 255, 0, 0, 0);
        aot_set(AOT_15_MESSAGE_CLOCK, 16600, 13000, 2500, 1000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 151, 0, 255, 0, 0, 0);
        aot_set(AOT_16_MESSAGE_CLOCK_MOVED, 14600, 13000, 2500, 1000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 152, 0, 255, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_BALCONY_STATUE_PUSHED, TRUE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            item_aot_set(AOT_12_ITEM_KEY_JEWEL_BLUE_4, 12000, 4000, 1000, 1500, IT_21_KEY_JEWEL_BLUE, 1, IMDL_04_JEWEL_BLUE, SCA_NONE, 12700, 0, 4800, 3072, F_ITEM_105_KEY_JEWEL_BLUE_4, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4 | ITEM_REACH);
        }
        else
        {
            item_aot_set(AOT_17_ITEM_KEY_JEWEL_BLUE_4, 12000, 4000, 1000, 1500, IT_21_KEY_JEWEL_BLUE, 1, IMDL_04_JEWEL_BLUE, SCA_NONE, 12700, 0, 4800, 3072, F_ITEM_105_KEY_JEWEL_BLUE_4, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4 | ITEM_REACH);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        obj(OBJ_00_BLOOD_POOL, 0, SCA_NONE, 4100, 0, 6700, 0, 0, 0, 0, 0, 0, 500, 700, 600);
        obj(OBJ_01_BLOOD_SPLASH, 0, SCA_NONE, 5000, 0, 6900, -7800, 0, 0, 0, 0, 0, 500, 350, 300);
        if (ck(FG_COMMON, F_COMMON_C_FIREPLACE_GOLD_EMBLEM, TRUE))
        {
            obj(OBJ_02_CLOCK, OF_ACTIVE, SCA_NONE, 16000, 0, 14300, 1024, 0, 876, 0, -876, 300, 544, 700, 600);
        }
        else
        {
            obj(OBJ_02_CLOCK, OF_ACTIVE, SCA_NONE, 18000, 0, 14300, 1024, 0, 876, 0, -876, 300, 544, 700, 600);
        }
    }
    else
    {
        obj(OBJ_00_BLOOD_POOL, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 4100, 0, 6700, 0, 0, 0, 0, 0, 0, 500, 700, 600);
        obj(OBJ_01_BLOOD_SPLASH, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 5000, 0, 6900, -7800, 0, 0, 0, 0, 0, 500, 350, 300);
        if (ck(FG_COMMON, F_COMMON_J_FIREPLACE_GOLD_EMBLEM, TRUE))
        {
            obj(OBJ_02_CLOCK, OF_ACTIVE, SCA_NONE, 16000, 0, 14300, 1024, 0, 876, 0, -876, 300, 544, 700, 600);
        }
        else
        {
            obj(OBJ_02_CLOCK, OF_ACTIVE, SCA_NONE, 18000, 0, 14300, 1024, 0, 876, 0, -876, 300, 544, 700, 600);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_BALCONY_STATUE_PUSHED, TRUE))
    {
        obj(OBJ_03_FALLEN_STATUE, OF_NOT_PUSHABLE | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 12700, 0, 5000, 3072, 0, 0, 0, 0, 0, 544, 1300, 500);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_KENNETH_ZOMBIE_SEEN, FALSE))
        {
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
            if (ck(FG_COMMON, F_COMMON_HALL_EARLY_RETURN, TRUE))
            {
                aot_delete(AOT_01_DOOR_106, SCE_NONE, 0);
                aot_reset(AOT_02_EVENT_HALL_DOOR_BLOCK, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, hall_door_not_done_or_barry_walks_in, 0);
            }
        }
        if (ck(FG_COMMON, F_COMMON_C_BAR_WOOD_EMBLEM_SET, TRUE))
        {
            set(FG_COMMON, F_COMMON_C_REBECCA_LEFT_BAR, TRUE);
        }
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
        {
            aot_reset(AOT_03_ITEM_KEY_MANSION_SHIELD_0, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 147, 255, 0);
            aot_reset(AOT_04_ITEM_KEY_EMBLEM_WOOD_1, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 147, 255, 0);
            aot_reset(AOT_12_ITEM_KEY_JEWEL_BLUE_4, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 147, 255, 0);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_BARRY_LEFT_DINING, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_KENNETH_ZOMBIE_SEEN, TRUE))
            {
                set(FG_COMMON, F_COMMON_J_BARRY_LEFT_DINING, TRUE);
            }
            else
            {
                if (ck(FG_COMMON, F_COMMON_J_BARRY_SHOWED_BLOOD, FALSE))
                {
                    if (ck(FG_COMMON, F_COMMON_J_BARRY_DINING_ENTRY, FALSE))
                    {
                        set(FG_COMMON, F_COMMON_J_BARRY_DINING_ENTRY, TRUE);
                        set(FG_ROOM, F_ROOM_J_START_BARRY_EVENT, TRUE);
                        set(FG_ROOM, F_ROOM_J_BARRY_WALK_IN, TRUE);
                        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 2200, 0, 30700, 0, 9200, ENEMY_00_BARRY, ANIM_20, 0, EVAR_00);
                        dir_set(0, 0, 1900, 0, 30700, 0, 7200);
                    }
                    else
                    {
                        set(FG_ROOM, F_ROOM_J_START_BARRY_EVENT, TRUE);
                        set(FG_ROOM, F_ROOM_J_BARRY_TO_FIREPLACE, TRUE);
                        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 4300, 0, 8000, ENEMY_00_BARRY, ANIM_20, 0, EVAR_00);
                    }
                }
                else
                {
                    enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 4300, 0, 8000, ENEMY_00_BARRY, ANIM_09, 24, EVAR_00);
                    aot_delete(AOT_10_MESSAGE_BLOOD, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
                }
                if (ck(FG_COMMON, F_COMMON_J_BARRY_LEFT_DINING, FALSE))
                {
                    if (ck(FG_COMMON, F_COMMON_HALL_EARLY_RETURN, TRUE))
                    {
                        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
                        aot_delete(AOT_01_DOOR_106, SCE_NONE, 0);
                        if (ck(FG_COMMON, F_COMMON_J_BARRY_DOOR_TALK, FALSE))
                        {
                            aot_reset(AOT_04_EVENT_BARRY_DOOR_TALK, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 7, barry_door_talk, 0);
                        }
                        else
                        {
                            aot_reset(AOT_05_EVENT_HALL_DOOR_BLOCK, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, hall_door_not_done, 0);
                        }
                    }
                }
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_KENNETH_ZOMBIE_DEAD, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_ENTERED_TEA_ROOM, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_KENNETH_ZOMBIE_SEEN, TRUE))
                {
                    enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 1, 0, 2048, 0, 4900, 0, 5600, ENEMY_00_BARRY, ANIM_00, 0, EVAR_00);
                    evt_exec(0, TASK_00, zombie_follows_jill);
                    evt_exec(0, TASK_01, barry_looks_around);
                }
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_BARRY_LOCKPICK_SCENE, TRUE))
        {
            set(FG_COMMON, F_COMMON_J_BARRY_TERRACE_READY, TRUE);
        }
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_104_TEA_ROOM))
    {
        snd_pan_vol_set(BGM_SUB_1, 87, 90);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_106_MAIN_HALL))
        {
            snd_pan_vol_set(BGM_SUB_1, 85, 82);
        }
    }
    else
    {
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_106_MAIN_HALL))
        {
            snd_pan_vol_set(BGM_SUB_1, 85, 82);
        }
        if (ck(FG_COMMON, F_COMMON_J_KENNETH_ZOMBIE_DEAD, FALSE))
        {
            enemy(EM_11_ZOMBIE_GREEN, EB_C0, NO_FLAG, SPAWN_FORCE, 1, 0, 3072, 0, 0, 0, 0, ENEMY_01_FIRST_ZOMBIE, ANIM_00, 0, EVAR_00);
        }
    }
}

proc main
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_C_FIREPLACE_GOLD_EMBLEM, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_C_FIREPLACE_WOOD_EMBLEM, TRUE))
            {
                aot_delete(AOT_06_USEITEM_FIREPLACE_WOOD_ALT, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_07_USEITEM_FIREPLACE_WOOD, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_08_USEITEM_FIREPLACE_GOLD_ALT, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_09_USEITEM_FIREPLACE_GOLD, SCE_NONE, SAT_PLAYER);
            }
            else
            {
                aot_delete(AOT_04_ITEM_KEY_EMBLEM_WOOD_1, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_06_USEITEM_FIREPLACE_WOOD_ALT, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_07_USEITEM_FIREPLACE_WOOD, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_08_USEITEM_FIREPLACE_GOLD_ALT, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_09_USEITEM_FIREPLACE_GOLD, SCE_USEITEM, SAT_PLAYER);
            }
            if (testpickup(IT_1F_KEY_EMBLEM_WOOD))
            {
                set(FG_COMMON, F_COMMON_C_FIREPLACE_WOOD_EMBLEM, FALSE);
            }
            if (testitem(IT_1F_KEY_EMBLEM_WOOD))
            {
                if (ck(FG_ROOM, F_ROOM_C_WOOD_EMBLEM_USED, TRUE))
                {
                    set(FG_ITEM, F_ITEM_105_KEY_EMBLEM_WOOD_1, TRUE);
                    set(FG_COMMON, F_COMMON_C_FIREPLACE_WOOD_EMBLEM, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_01_EMBLEM_WOOD, OF_ACTIVE);
                    aot_delete(AOT_04_ITEM_KEY_EMBLEM_WOOD_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                    evt_exec(0, TASK_09, place_wood_emblem);
                }
            }
            if (testitem(IT_20_KEY_EMBLEM_GOLD))
            {
                if (ck(FG_ROOM, F_ROOM_C_GOLD_EMBLEM_USED, TRUE))
                {
                    set(FG_COMMON, F_COMMON_C_FIREPLACE_GOLD_EMBLEM, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_02_EMBLEM_GOLD, OF_ACTIVE);
                    evt_exec(0, TASK_09, clock_slides_open);
                    evt_exec(0, TASK_09, place_gold_emblem);
                }
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
            {
                snd_pan_vol_set(BGM_SUB_1, 85, 82);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
            {
                snd_pan_vol_set(BGM_SUB_1, 90, 87);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
            {
                snd_pan_vol_set(BGM_SUB_1, 87, 90);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_03_FIREPLACE))
            {
                snd_pan_vol_set(BGM_SUB_1, 82, 85);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
            {
                snd_pan_vol_set(BGM_SUB_1, 85, 85);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_05_CLOCK))
            {
                snd_pan_vol_set(BGM_SUB_1, 95, 95);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_06_FIREPLACE_CLOSEUP))
            {
                snd_pan_vol_set(BGM_SUB_1, 80, 80);
            }
        }
        else
        {
            aot_delete(AOT_04_ITEM_KEY_EMBLEM_WOOD_1, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_06_USEITEM_FIREPLACE_WOOD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM_FIREPLACE_WOOD, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_08_USEITEM_FIREPLACE_GOLD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_09_USEITEM_FIREPLACE_GOLD, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM_FIREPLACE_WOOD, SCE_NONE, SAT_PLAYER);
        }
        if (ck(FG_COMMON, F_COMMON_C_FIREPLACE_WOOD_EMBLEM, TRUE))
        {
            aot_delete(AOT_0A_EVENT_FIREPLACE_HOLLOW, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_0A_EVENT_FIREPLACE_HOLLOW, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        }
        if (ck(FG_COMMON, F_COMMON_C_FIREPLACE_GOLD_EMBLEM, TRUE))
        {
            aot_reset(AOT_0A_EVENT_FIREPLACE_HOLLOW, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fireplace_emblem_in_place, 0);
            aot_delete(AOT_10_MESSAGE_CLOCK, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_11_MESSAGE_CLOCK_MOVED, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_10_MESSAGE_CLOCK, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_11_MESSAGE_CLOCK_MOVED, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
    }
    else
    {
        if (ck(FG_ROOM, F_ROOM_J_START_BARRY_EVENT, TRUE))
        {
            set(FG_ROOM, F_ROOM_J_START_BARRY_EVENT, FALSE);
            if (ck(FG_ROOM, F_ROOM_J_BARRY_TO_FIREPLACE, TRUE))
            {
                evt_exec(0, TASK_09, barry_shows_blood);
            }
            else if (ck(FG_ROOM, F_ROOM_J_BARRY_WALK_IN, TRUE))
            {
                evt_exec(0, TASK_09, hall_door_not_done_or_barry_walks_in);
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_KENNETH_ZOMBIE_DEAD, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_BARRY_SHOWED_BLOOD, TRUE))
            {
                if (ck(FG_ROOM, F_ROOM_J_ARM_DOOR_ZOMBIE, TRUE))
                {
                    aot_delete(AOT_0E_EVENT_DOOR_ZOMBIE, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
                    set(FG_ROOM, F_ROOM_J_ARM_DOOR_ZOMBIE, FALSE);
                }
            }
        }
        if (ck(FG_COMMON, F_COMMON_J_FIREPLACE_GOLD_EMBLEM, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_FIREPLACE_WOOD_EMBLEM, TRUE))
            {
                aot_delete(AOT_09_USEITEM_FIREPLACE_WOOD_ALT, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_0A_USEITEM_FIREPLACE_WOOD, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_0B_USEITEM_FIREPLACE_GOLD_ALT, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_0C_USEITEM_FIREPLACE_GOLD, SCE_NONE, SAT_PLAYER);
            }
            else
            {
                aot_delete(AOT_07_ITEM_KEY_EMBLEM_WOOD_1, SCE_NONE, SAT_PLAYER);
                aot_delete(AOT_09_USEITEM_FIREPLACE_WOOD_ALT, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_0A_USEITEM_FIREPLACE_WOOD, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_0B_USEITEM_FIREPLACE_GOLD_ALT, SCE_USEITEM, SAT_PLAYER);
                aot_delete(AOT_0C_USEITEM_FIREPLACE_GOLD, SCE_USEITEM, SAT_PLAYER);
            }
            if (testpickup(IT_1F_KEY_EMBLEM_WOOD))
            {
                set(FG_COMMON, F_COMMON_J_FIREPLACE_WOOD_EMBLEM, FALSE);
            }
            if (testitem(IT_1F_KEY_EMBLEM_WOOD))
            {
                if (ck(FG_ROOM, F_ROOM_J_WOOD_EMBLEM_USED, TRUE))
                {
                    set(FG_ITEM, F_ITEM_105_KEY_EMBLEM_WOOD_1, TRUE);
                    set(FG_COMMON, F_COMMON_J_FIREPLACE_WOOD_EMBLEM, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_01_EMBLEM_WOOD, OF_ACTIVE);
                    aot_delete(AOT_07_ITEM_KEY_EMBLEM_WOOD_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                    evt_exec(0, TASK_09, place_wood_emblem);
                }
            }
            if (testitem(IT_20_KEY_EMBLEM_GOLD))
            {
                if (ck(FG_ROOM, F_ROOM_J_GOLD_EMBLEM_USED, TRUE))
                {
                    set(FG_COMMON, F_COMMON_J_FIREPLACE_GOLD_EMBLEM, TRUE);
                    set(FG_COMMON, F_COMMON_J_FIREPLACE_WOOD_EMBLEM, TRUE);
                    objtbl_b_set(TBL_ITEM, IMDL_02_EMBLEM_GOLD, OF_ACTIVE);
                    evt_exec(0, TASK_09, clock_slides_open);
                    evt_exec(0, TASK_09, place_gold_emblem);
                }
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
            {
                snd_pan_vol_set(BGM_SUB_1, 85, 82);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
            {
                snd_pan_vol_set(BGM_SUB_1, 90, 87);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
            {
                snd_pan_vol_set(BGM_SUB_1, 87, 90);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_03_FIREPLACE))
            {
                snd_pan_vol_set(BGM_SUB_1, 82, 85);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
            {
                snd_pan_vol_set(BGM_SUB_1, 85, 85);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_05_CLOCK))
            {
                snd_pan_vol_set(BGM_SUB_1, 95, 95);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_06_FIREPLACE_CLOSEUP))
            {
                snd_pan_vol_set(BGM_SUB_1, 80, 80);
            }
        }
        else
        {
            aot_delete(AOT_07_ITEM_KEY_EMBLEM_WOOD_1, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_09_USEITEM_FIREPLACE_WOOD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_0A_USEITEM_FIREPLACE_WOOD, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_0B_USEITEM_FIREPLACE_GOLD_ALT, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_0C_USEITEM_FIREPLACE_GOLD, SCE_NONE, SAT_PLAYER);
        }
        if (ck(FG_COMMON, F_COMMON_J_FIREPLACE_WOOD_EMBLEM, TRUE))
        {
            aot_delete(AOT_0D_EVENT_FIREPLACE_HOLLOW, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_0D_EVENT_FIREPLACE_HOLLOW, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        }
        if (ck(FG_COMMON, F_COMMON_J_FIREPLACE_GOLD_EMBLEM, TRUE))
        {
            aot_reset(AOT_0D_EVENT_FIREPLACE_HOLLOW, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fireplace_emblem_in_place, 0);
            aot_delete(AOT_15_MESSAGE_CLOCK, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_16_MESSAGE_CLOCK_MOVED, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_15_MESSAGE_CLOCK, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_16_MESSAGE_CLOCK_MOVED, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
        if (ck(FG_COMMON, F_COMMON_J_KENNETH_ZOMBIE_DEAD, TRUE))
        {
            aot_delete(AOT_10_MESSAGE_BLOOD, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
    }
}

event hall_door_not_done_or_barry_walks_in
{
if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
{
        message(MSG_THERE_MAY_BE_MORE_HERE_WORTH | MSG_FAST, RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There may be more here worth investigating."
}
else
{
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        }
        evt_exec(0, TASK_06, jill_looks_around);
        evt_exec(0, TASK_07, barry_looks_around);
        sleep(30);
        evt_exec(0, TASK_09, barry_walks_in_barry);
        sleep(30);
        cutnext(CAM_01);
        sleep(15);
        message(0, 0);
        voice_play(VOICE_PLAY, VO_102_00);
        sleep(90);
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_VOICE_PLAYING, TRUE));
        do
        {
            evt_next();
        }
        while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
        cutcurr(0);
        evt_disable(TASK_06);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion(MOTION_10);
        act_reset();
        evt_nop();
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
            room_bgm_state_set(0, ROOM_10F_BAR, BGM_RELOAD | 1);
        }
        evt_exec(0, TASK_09, barry_walks_in_timeout_1);
        do
        {
            do
            {
                evt_next();
                evt_nop();
                run
                {
                    if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
                    {
                        set(FG_ROOM, F_ROOM_J_PLAYER_AT_CAM_01, TRUE);
                    }
                }
                evt_nop();
            }
            while (ck(FG_ROOM, F_ROOM_J_PLAYER_AT_CAM_01, FALSE));
            set(FG_ROOM, F_ROOM_J_BARRY_WALK_GO, TRUE);
            evt_nop();
        }
        while (ck(FG_ROOM, F_ROOM_J_BARRY_WALK_GO, FALSE));
        do
        {
            evt_next();
            evt_nop();
            run
            {
                if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
                {
                    set(FG_ROOM, F_ROOM_J_BARRY_TO_FIREPLACE, TRUE);
                }
            }
            evt_nop();
        }
        while (ck(FG_ROOM, F_ROOM_J_BARRY_TO_FIREPLACE, FALSE));
}
    evt_finish();
}

event barry_walks_in_barry
{
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_seq(AB_ADDITIVE | AB_02, 27100, 11700, F_ROOM_J_BARRY_ANIM_DONE);
    evt_next();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    act_anim_seq(AB_02, 19000, 11900, F_ROOM_J_BARRY_ANIM_DONE);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    pos_set(ENEMY_00_BARRY, 0, 2048, 0, 12000, 0, 11900);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_AT_CAM_01, FALSE));
    do
    {
        evt_actor_begin();
        act_nop();
        act_anim_seq(AB_02, 8000, 11900, F_ROOM_J_BARRY_ANIM_DONE);
        act_reset();
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_J_BARRY_WALK_GO, FALSE));
        evt_nop();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_WALK_GO, FALSE));
    evt_exec(0, TASK_09, barry_walks_in_timeout_2);
    evt_disable(TASK_07);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    pos_set(ENEMY_00_BARRY, 0, 1024, 0, 4300, 0, 8000);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_TO_FIREPLACE, FALSE));
    evt_chain(barry_shows_blood);
}

event barry_walks_in_timeout_1
{
    sleep(180);
    set(FG_ROOM, F_ROOM_J_PLAYER_AT_CAM_01, TRUE);
    set(FG_ROOM, F_ROOM_J_BARRY_WALK_GO, TRUE);
    evt_finish();
}

event barry_walks_in_timeout_2
{
    sleep(180);
    set(FG_ROOM, F_ROOM_J_BARRY_TO_FIREPLACE, TRUE);
    evt_finish();
}

event barry_shows_blood
{
    aot_reset(AOT_02_EVENT_REACH_BARRY_S, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, jill_walks_to_barry_s, 0);
    aot_reset(AOT_03_EVENT_REACH_BARRY_N, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, jill_walks_to_barry_n, 0);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_J_BARRY_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_NEAR_BARRY, FALSE));
    message(1, 0);
    voice_play(VOICE_PLAY, VO_102_01);
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, F_STATUS_VOICE_PLAYING, TRUE));
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_AT_FIREPLACE, FALSE));
    sleep(10);
    cutnext(CAM_03_FIREPLACE);
    message(2, 0);
    voice_play(VOICE_PLAY, VO_102_02);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_12, 0, 300, 0, 0, 40);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_ANIM_DONE, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_05, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_ANIM_DONE, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_06, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0010);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, F_STATUS_VOICE_PLAYING, TRUE));
    voice_play(VOICE_PLAY, VO_102_03);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 100, 0);
    act_reset();
    evt_nop();
    wait_message();
    sleep(10);
    message(MSG_VO_102_03, 0);
    voice_play(VOICE_PLAY, VO_102_04);
    evt_exec(0, TASK_09, barry_looks_around);
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, F_STATUS_VOICE_PLAYING, TRUE));
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        cutcurr(0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_COMMON, F_COMMON_J_BARRY_SHOWED_BLOOD, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        aot_delete(AOT_10_MESSAGE_BLOOD, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event jill_walks_to_barry_s
{
    run
