  <strings>
    <language lang="en-US">
      <string key="name">PRIVATE ROOM A</string>
      <string key="save_name">Laboratory B3</string>
      <string key="0">{scroll 2}It's a pass code output\nmachine.{clear 0}If I had a MO DISK,\nI could get the code...{scroll 2}</string>
      <string key="1">{scroll 2}I already have the pass\ncode.{scroll 2}</string>
      <string key="2">{scroll 2}\nNothing special.\n{scroll 2}</string>
      <string key="3">{scroll 2}Most of them are fiction\nbooks.{scroll 2}</string>
      <string key="4">{scroll 2}Cardboard and posters.\nNothing useful.{scroll 2}</string>
      <string key="5">{scroll 2}A switch for the air\nconditioner.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}研究所 {s}/{s}B{s}3{s}</string>
      <string key="0">{scroll 2}\n   パスコードの出力装置だ{clear 0} MOディスクがあれば、\n コードを入手できるのだが・・・{scroll 2}</string>
      <string key="1">{scroll 2}\nここのパスコードはもう入手している{scroll 2}</string>
      <string key="2">{scroll 2}\n     特に何もない{scroll 2}</string>
      <string key="3">{scroll 2}  フィクションものの本が目立つ\n  研究員がよんでいたのだろう{scroll 2}</string>
      <string key="4">{scroll 2}  ダンボールにポスター・・・\n  これといって役に立つ物はない{scroll 2}</string>
      <string key="5">{scroll 2}\n    エアコンのスイッチだ{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Laboratoire SS3</string>
      <string key="0">{scroll 2}C'est une machine pour\ncodes d'accès.{clear 0}Si j'avais un disque M.O., je\npourrais avoir le code...{scroll 2}</string>
      <string key="1">{scroll 2}\nJ'ai déjà le code d'accès.{scroll 2}</string>
      <string key="2">{scroll 2}\nRien de spécial.\n{scroll 2}</string>
      <string key="3">{scroll 2}La plupart des livres sont\ndes romans.{scroll 2}</string>
      <string key="4">{scroll 2}Des cartons et des posters.\nRien d'utile.{scroll 2}</string>
      <string key="5">{scroll 2}L'interrupteur de \nl'air conditionné.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Das ist ein Gerät,\ndas Passcodes ausgibt.{clear 0}Mit einer MO-DISKETTE könnte\nich den Code aufzeichnen...{scroll 2}</string>
      <string key="1">{scroll 2}\nIch habe schon einen Passcode.{scroll 2}</string>
      <string key="2">{scroll 2}\nNichts Besonderes.{scroll 2}</string>
      <string key="3">{scroll 2}Die meisten Bücher dort\nsind Romane.{scroll 2}</string>
      <string key="4">{scroll 2}Kartons und Plakate.\nNichts Brauchbares.{scroll 2}</string>
      <string key="5">{scroll 2}Ein Schalter\nfür die Lüftungsanlage.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Laboratorio S3</string>
      <string key="0">{scroll 2}È una macchina che \nemette codici d'accesso.{clear 0}Se avessi un DISCO MO\npotrei ottenerlo...{scroll 2}</string>
      <string key="1">{scroll 2}\nHo già il codice d'accesso.{scroll 2}</string>
      <string key="2">{scroll 2}\nNiente di speciale.\n{scroll 2}</string>
      <string key="3">{scroll 2}Molti di questi libri \nsono romanzi.{scroll 2}</string>
      <string key="4">{scroll 2}Scatole e poster.\nNiente di utile.{scroll 2}</string>
      <string key="5">{scroll 2}L'interruttore dell'aria \ncondizionata.{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}Es una máquina de\ngrabación de contraseñas...{clear 0}Si tuviera un DISCO MO podría\nconseguir la contraseña...{scroll 2}</string>
      <string key="1">{scroll 2}\nYa tengo la contraseña...{scroll 2}</string>
      <string key="2">{scroll 2}\nNada especial...{scroll 2}</string>
      <string key="3">{scroll 2}La mayoría son\nlibros de ficción...{scroll 2}</string>
      <string key="4">{scroll 2}Cajas de cartón y un póster...\nNada útil...{scroll 2}</string>
      <string key="5">{scroll 2}Un interruptor para\nel aire acondicionado...{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Лаборатория Б3</string>
      <string key="0">{scroll 2}Устройство\nдля печати паролей.{clear 0}Если бы у меня был МО-ДИСК,\nя мог бы получить код...{scroll 2}</string>
      <string key="1">{scroll 2}У меня уже\nесть пароль.{scroll 2}</string>
      <string key="2">{scroll 2}\nНичего особенного.\n{scroll 2}</string>
      <string key="3">{scroll 2}Большинство книг\nо фантастике.{scroll 2}</string>
      <string key="4">{scroll 2}Плакаты и картон.\nНичего полезного.{scroll 2}</string>
      <string key="5">{scroll 2}\nВыключатель кондиционера.{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Laboratorion olohuone -2 krs</string>
      <string key="0">{scroll 2}Se on kulkukoodien tulostin...{clear 0}Jos minulla olisi MO-levyke,\nvoisin tulostaa sellaisen...{scroll 2}</string>
      <string key="1">{scroll 2}Olen jo saanut siitä\nkulkukoodin...{scroll 2}</string>
      <string key="2">{scroll 2}Ei mitään erityistä...{scroll 2}</string>
      <string key="3">{scroll 2}Suurin osa niistä on kaunokirjallisuutta...{scroll 2}</string>
      <string key="4">{scroll 2}Pahvilaatikoita ja julisteita...\nEi mitään hyödyllistä...{scroll 2}</string>
      <string key="5">{scroll 2}Painike ilmastointilaitteelle...{scroll 2}</string>
    </language>
  </strings>
</room>
