#define FLAG_ROOM_20 0x20
#define FLAG_ROOM_21 0x21

proc init
{
    door_aot_set(0, 300, 2000, 2100, 1800, 0, 0, 6, 1, 0, ROOM_405_CENTER_PASSAGE, 24700, 0, 21100, 2048, UNLOCKED, 129);
    door_aot_set(1, 2500, 3700, 1600, 1800, 1, 0, 33, 1, 0, ROOM_407_ROOM_002_BATHROOM, 3100, 0, 6400, 3072, UNLOCKED, 129);
    door_aot_set(2, 0, 0, 1, 1, 1, 11, 26, 64, 0, ROOM_40D_UNDER_PASSAGE, 3500, 0, 29000, 1024, UNLOCKED, 129);
    aot_set(3, 10500, 1600, 1100, 1600, SCE_HIKIDASHI, 129, 34, 0, 6, 0, 6, 0);
#if CHRIS
    aot_set(4, 9000, 5000, 1000, 1000, SCE_EVENT, 129, 9, 0, event_01, 0, 0, 0);
    aot_set(5, 12100, 8400, 1000, 1000, SCE_EVENT, 129, 9, 0, event_04, 0, 0, 0);
#else
    aot_set(4, 9000, 5000, 1000, 1000, SCE_EVENT, 129, 9, 0, event_04, 0, 0, 0);
    aot_set(5, 12100, 8400, 1000, 1000, SCE_EVENT, 129, 9, 0, event_07, 0, 0, 0);
#endif
    item_aot_set(6, 0, 0, 1, 1, ITEM_0C_AMMO_SHOTGUN, 7, 0, 255, 22, 43, 116, 255, 168, 7, 0, 0, 25, 0, 0, 0);
    eml_rot(0, 0, 0, 0, 252);
    setbyte(0, 0, 0);
    item_aot_set(7, 12400, 3800, 1000, 1400, ITEM_64_FILE_PLANT_42_REPORT, 1, 1, 255, 88, 52, 58, 253, 76, 19, 0, 0, 134, 129, 0, 0);
    item_aot_set(8, 0, 0, 1, 10, ITEM_52_UNKNOWN_52, 1, 2, 255, 64, 36, 240, 246, 44, 21, 0, 0, 135, 129, 0, 0);
    if (ck(FG_SCENARIO, FLAG_SCENARIO_45, TRUE))
    {
        obj(0, 17, 255, 10180, 0, 8970, 1024, 0, 0, 94, 1, 0, 0, 162, 254, 200, 0, 76, 4, 176, 4, 88, 2);
        obj(1, 17, 255, 10176, 0, 10220, 1024, 0, 0, 44, 1, 0, 0, 212, 254, 200, 0, 76, 4, 176, 4, 88, 2);
    }
    else
    {
        obj(0, 17, 255, 12907, 0, 8580, 1024, 0, 0, 94, 1, 0, 0, 162, 254, 200, 0, 76, 4, 176, 4, 88, 2);
        obj(1, 17, 255, 10176, 0, 8580, 1024, 0, 0, 44, 1, 0, 0, 212, 254, 200, 0, 76, 4, 176, 4, 88, 2);
    }
#if CHRIS
    if (cmpb(9, 0, 3))
    {
        aot_reset(3, SCE_MESSAGE, 129, 136, 255, 0);
        aot_reset(4, SCE_MESSAGE, 129, 136, 255, 0);
        aot_reset(7, SCE_MESSAGE, 129, 136, 255, 0);
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_B2, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_AE, TRUE))
        {
            if (ck(FG_COMMON, FLAG_COMMON_B0, FALSE))
            {
                if (ck(FG_COMMON, FLAG_COMMON_B1, FALSE))
                {
                    evt_exec(0, 9, event_01);
                }
            }
        }
    }
#endif
    if (ck(FG_SCENARIO, FLAG_SCENARIO_3E, TRUE))
    {
        aot_delete(4, SCE_NONE, 129);
    }
    set(FG_STATUS, FLAG_STATUS_3C, TRUE);
#if JILL
    if (ck(FG_COMMON, FLAG_COMMON_B2, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_AE, TRUE))
        {
            if (ck(FG_COMMON, FLAG_COMMON_B0, FALSE))
            {
                if (ck(FG_COMMON, FLAG_COMMON_B1, FALSE))
                {
                    room_bgm_state_set(3, 6, 65);
                    enemy(ENEMY_22_NPC_BARRY, 4, 255, 1, 1, 0, 0, 1550, 0, 0, 13000, 0, 7550, 0, 0, 0, 0);
                }
            }
        }
    }
#endif
}

