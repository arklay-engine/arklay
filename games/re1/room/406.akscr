event on_enter_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 64836, 300, 0, 160, 100);
    sleep(25);
    act_motion_path(51, 400, 200, 0, 120, 90);
    sleep(30);
    act_motion_path(51, 700, 65236, 0, 140, 80);
    sleep(25);
    act_motion_path(51, 64936, 0, 0, 160, 0);
    sleep(5);
    act_anim_flags(0 | 2, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    evt_finish();
}

event on_enter_sub2
{
    sleep(45);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
