#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_50C 0x00
#define AOT_01_DOOR_514 0x01
#define ENEMY_00_NPC_BARRY 0x00
#define ENEMY_00_NPC_REBECCA 0x00
#define F_ROOM_ELEVATOR_ARRIVED 0x18                        // The elevator ride finished.
#define SE_17_ELV515 0x17

proc init
{
    set(FG_STATUS, F_STATUS_SCREEN_BORDER, TRUE);
    door_aot_set(AOT_00_DOOR_50C, 0, 0, 1, 1, 1, DOOR_SND_0D_EV_LAB, DOOR_12_ELE01A, 64, 0, ROOM_50C_FRONT_OF_ELEVATOR, 16000, 0, 27900, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_514, 0, 0, 1, 1, 1, DOOR_SND_0D_EV_LAB, DOOR_13_ELE01B, 64, 0, ROOM_514_FRONT_OF_TYRANT, 13300, 0, 10000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (JILL)
    {
        dir_set(0, 0, 2048, 0, 4500, 0, 4200);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_50C_FRONT_OF_ELEVATOR))
    {
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_50C_SCENE, FALSE))
            {
                dir_set(0, 0, 1500, 0, 5000, 0, 5500);
                enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2000, 0, 4600, 0, 3500, ENEMY_00_NPC_REBECCA, ANIM_05, 19, EVAR_00);
            }
            else
            {
                dir_set(0, 0, 2048, 0, 4500, 0, 4200);
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, FALSE) && ck(FG_COMMON, F_COMMON_J_BARRY_SPLIT_AFTER_TYRANT, FALSE) && ck(FG_SCENARIO, F_SCENARIO_TYRANT_1_DEAD, FALSE))
            {
                dir_set(0, 0, 1500, 0, 5000, 0, 5500);
                enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2000, 0, 4600, 0, 3500, ENEMY_00_NPC_BARRY, ANIM_05, 34, EVAR_00);
            }
            else
            {
                dir_set(0, 0, 2048, 0, 4500, 0, 4200);
            }
        }
        evt_exec(0, TASK_09, ride_down_from_50c);
    }
    else
    {
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_50C_SCENE, FALSE))
            {
                dir_set(0, 0, 1500, 0, 5000, 0, 5500);
                enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2500, 0, 4600, 0, 3500, ENEMY_00_NPC_REBECCA, ANIM_05, 19, EVAR_00);
            }
            else
            {
                dir_set(0, 0, 2048, 0, 4500, 0, 4200);
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, FALSE) && ck(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, TRUE) && ck(FG_COMMON, F_COMMON_J_BARRY_SPLIT_AFTER_TYRANT, FALSE))
            {
                dir_set(0, 0, 1500, 0, 5000, 0, 5500);
                enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2500, 0, 4600, 0, 3500, ENEMY_00_NPC_BARRY, ANIM_05, 34, EVAR_00);
            }
            else
            {
                dir_set(0, 0, 2048, 0, 4500, 0, 4200);
            }
        }
        evt_exec(0, TASK_09, ride_up_from_514);
    }
}

event ride_down_from_50c
{
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    se_play_3d(SND_BANK_ROOM, SE_17_ELV515, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_fork(TASK_09, elevator_ride, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ELEVATOR_ARRIVED, FALSE));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_on(AOT_01_DOOR_514, SCE_DOOR, 0);
    }
    evt_finish();
}

event ride_up_from_514
{
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    se_play_3d(SND_BANK_ROOM, SE_17_ELV515, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_fork(TASK_09, elevator_ride, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ELEVATOR_ARRIVED, FALSE));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_on(AOT_00_DOOR_50C, SCE_DOOR, 0);
    }
    evt_finish();
}

event elevator_ride
{
    sleep(5);
    set(FG_STATUS, F_STATUS_SCREEN_SHAKE, TRUE);
    sleep(10);
    set(FG_STATUS, F_STATUS_SCREEN_SHAKE, FALSE);
    sleep(100);
    sleep(60);
    set(FG_ROOM, F_ROOM_ELEVATOR_ARRIVED, TRUE);
    evt_finish();
}
