#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_TYPEWRITER 0x01
#define AOT_02_ITEMBOX 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_ITEM 0x05
#define IMDL_00 0x00
#define IMDL_01 0x01
#define IMDL_02 0x02
#define OBJ_00 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 3700, 900, 1600, 1400, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30D_STRAIGHT_PASSAGE, 28600, 0, 6500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_TYPEWRITER, 3900, 4000, 1350, 1600, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_02_ITEMBOX, 1800, 9100, 2500, 1900, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 2, 0, 0, 0, 0, 0);
    item_aot_set(AOT_03_ITEM, 7584, 8338, 1800, 1800, IT_45_HEAL_HERB_BLUE, 1, IMDL_00, SCA_NONE, 8484, 0, 9238, 0, F_ITEM_EC, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_04_ITEM, 5064, 5900, 1800, 1800, IT_41_HEAL_FIRST_AID_SPRAY, 1, IMDL_01, SCA_NONE, 5964, -1200, 6800, 0, F_ITEM_EF, SAT_MANUAL | SAT_PLAYER, 0);
#if STEAM
    item_aot_set(AOT_05_ITEM, 3810, 5368, 1800, 1800, IT_2F_KEY_INK_RIBBON, 2, IMDL_02, SCA_NONE, 4710, -1200, 6258, 0, F_ITEM_F0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_7);
#else
    item_aot_set(AOT_05_ITEM, 3810, 5368, 1800, 1800, IT_2F_KEY_INK_RIBBON, 3, IMDL_02, SCA_NONE, 4710, -1200, 6258, 0, F_ITEM_F0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_7);
#endif
    obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 2900, -1440, 10800, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_42, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_42, TRUE);
    }
}
