event event_03
{
    run
    {
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
        eml_pos(0, 0, 0, 0, 4, 0, 0, 120, 15, 146, 245, 102, 28);
        cutnext(4);
    }
    evt_work_set(WK_AOT, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3810, -2640, 7270);
    tw_end();
    evt_nop();
    sleep(20);
    run
    {
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        setb(6, 6, 0);
        swap_var(2, 3, 13);
        set(FG_STATUS, 18, 0);
        set(FG_ROOM, 24, 0);
    }
    evt_finish();
}

event event_04
{
