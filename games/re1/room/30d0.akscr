    evt_next();
    tw_set_pos(0, 252, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 254, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 8, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 252, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 254, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 253, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 254, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 255, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 255, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    run
    {
        eml_pos(0, 0, 0, 0, 4, 0, 0, 18, 17, 220, 246, 108, 27);
        aot_delete(4, SCE_EVENT, 129);
        se_play_3d(2, 24, 0, 0, 0, 1200, 2750);
        set(FG_LOCK, 47, 1);
        cutcurr(0);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        set(FG_STATUS, 26, 0);
    }
    evt_finish();
}

