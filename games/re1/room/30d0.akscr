event event_07
{
    run
    {
        message(128, 255);
        eml_pos(0, 0, 0, 0, 4, 0, 0, 120, 15, 146, 245, 102, 28);
        cutnext(4);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        eml_pos(0, 0, 0, 0, 4, 0, 0, 228, 12, 214, 247, 26, 29);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        cutcurr(0);
    }
    evt_finish();
}
