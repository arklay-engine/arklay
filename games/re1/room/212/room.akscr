#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_211 0x00
#define AOT_01_ITEM_AMMO_HANDGUN_0 0x01
#define AOT_01_ITEM_WEAPON_GL_ACID_0 0x01
#define AOT_03_EVENT_FOREST_BODY 0x03                       // Jill's game reuses it for talking to Barry again.
#define CAM_02_FROM_DOOR 0x02                               // Likely.
#define CAM_03_FOREST_CLOSEUP 0x03
#define CAM_04_TERRACE_HIGH 0x04
#define ENEMY_00_NPC_FORREST 0x00
#define ENEMY_01_BARRY 0x01
#define ENEMY_01_CROW 0x01
#define ENEMY_02_CROW 0x02
#define ENEMY_03_CROW 0x03
#define F_ROOM_ANIM_DONE_0 0x20                             // An animation finished (one frame); one of ten bits the terrace scenes hand out in turn to Jill, Barry and the crows.
#define F_ROOM_ANIM_DONE_1 0x21                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_2 0x22                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_3 0x23                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_4 0x24                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_5 0x25                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_6 0x26                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_7 0x27                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_8 0x28                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_ANIM_DONE_9 0x29                             // Pool animation bit, as F_ROOM_ANIM_DONE_0.
#define F_ROOM_PLAYER_ANIM_DONE 0x3F                        // The player's crouch at Forest's body finished; nothing waits on it.
#define IMDL_00_AMMO_HANDGUN 0x00
#define IMDL_00_WEAPON_GL_ACID 0x00
#define MSG_FOREST 0x0E
#define MSG_IT_IS_FOREST 0x0F
#define MSG_VO_104_00 0x00
#define MSG_VO_104_01 0x01
#define MSG_VO_104_02 0x02
#define MSG_VO_104_03 0x04
#define MSG_VO_104_04 0x05
#define MSG_VO_104_05 0x06
#define MSG_VO_104_06 0x07
#define MSG_VO_104_07 0x09
#define MSG_VO_104_09 0x0B
#define MSG_VO_104_0A 0x0D
#define SE_17 0x17
#define SE_18_RVPATA 0x18
#define SE_19_RVPATB 0x19
#define VO_104_00 0x00
#define VO_104_01 0x01
#define VO_104_02 0x02
#define VO_104_03 0x03
#define VO_104_04 0x04
#define VO_104_05 0x05
#define VO_104_06 0x06
#define VO_104_07 0x07
#define VO_104_08 0x08
#define VO_104_09 0x09
#define VO_104_0A 0x0A

proc init
{
    door_aot_set(AOT_00_DOOR_211, 16800, 26400, 2200, 2200, 3, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 4, 0, ROOM_211_TERRACE_PASSAGE, 3000, 0, 12000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        item_aot_set(AOT_01_ITEM_AMMO_HANDGUN_0, 23500, 19770, 1000, 1000, IT_0B_AMMO_HANDGUN, 15, IMDL_00_AMMO_HANDGUN, SCA_NONE, 24000, 0, 20270, 1542, F_ITEM_C_212_AMMO_HANDGUN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        if (MANSION1)
        {
            if (ck(FG_COMMON, F_COMMON_FOREST_FOUND, FALSE))
            {
                aot_set(AOT_03_EVENT_FOREST_BODY, 22600, 18000, 2900, 2250, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_forest_body, 0, 0, 0);
            }
        }
    }
    else
    {
        item_aot_set(AOT_01_ITEM_WEAPON_GL_ACID_0, 23500, 19770, 1000, 1000, IT_07_WEAPON_GL_ACID, 6, IMDL_00_WEAPON_GL_ACID, SCA_NONE, 24000, 0, 20270, 1542, F_ITEM_J_212_WEAPON_GL_ACID_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    }
    if (MANSION1)
    {
        enemy(EM_26_NPC_FORREST, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1936, 0, 25150, 0, 18700, ENEMY_00_NPC_FORREST, ANIM_00, 0, EVAR_00);
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_FOREST_FOUND, FALSE))
            {
                enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 3000, 0, 19000, -3000, 20000, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
                enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19000, -4000, 20000, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
                enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19000, -3500, 20000, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
            }
            else
            {
                room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
                enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
                enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
                enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
            }
            evt_exec(0, TASK_09, crow_flaps_loop_a);
            evt_exec(0, TASK_09, crow_flaps_loop_b);
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, FALSE) && ck(FG_COMMON, F_COMMON_J_BARRY_SANDWICH_TALK_DONE, FALSE) && ck(FG_COMMON, F_COMMON_J_BARRY_TERRACE_READY, TRUE) && ck(FG_SCENARIO, F_SCENARIO_J_BARRY_TERRACE_MISSED, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_J_BARRY_LEFT_TERRACE, FALSE))
                {
                    enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 52, 0, 22680, 0, 26170, ENEMY_01_BARRY, ANIM_00, 0, EVAR_00);
                    if (ck(FG_COMMON, F_COMMON_J_BARRY_MET_ON_TERRACE, FALSE))
                    {
                        set(FG_COMMON, F_COMMON_J_BARRY_MET_ON_TERRACE, TRUE);
                        evt_exec(0, TASK_09, barry_terrace_scene);
                    }
                    else
                    {
                        room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
                        pos_set(ENEMY_01_BARRY, 0, 900, 0, 24000, 0, 21000);
                        evt_exec(0, TASK_09, barry_waits_on_terrace);
                        aot_set(AOT_03_EVENT_FOREST_BODY, 23000, 20000, 2000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, barry_terrace_talk_again, 0, 0, 0);
                    }
                }
                else
                {
                    room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
                    evt_exec(0, TASK_09, crow_flaps_loop_a);
                    evt_exec(0, TASK_09, crow_flaps_loop_b);
                    room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
                    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
                    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
                    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
                }
            }
            else
            {
                set(FG_SCENARIO, F_SCENARIO_J_BARRY_TERRACE_MISSED, TRUE);
                evt_exec(0, TASK_09, crow_flaps_loop_a);
                evt_exec(0, TASK_09, crow_flaps_loop_b);
                if (ck(FG_COMMON, F_COMMON_J_BARRY_LEFT_TERRACE, FALSE))
                {
                    enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 3000, 0, 19000, -3000, 20000, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
                    enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19100, -4000, 21000, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
                    enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19200, -3500, 20000, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
                    aot_set(AOT_03_EVENT_FOREST_BODY, 22600, 18000, 2900, 2250, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_forest_body, 0, 0, 0);
                }
                else
                {
                    room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
                    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
                    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
                    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
                }
            }
        }
    }
    else
    {
        room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
        enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
        evt_exec(0, TASK_09, crow_flaps_loop_a);
        evt_exec(0, TASK_09, crow_flaps_loop_b);
    }
}

event examine_forest_body when (MANSION1)
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        bgm_stop(BGM_MAIN);
    }
    if (CHRIS)
    {
        sleep(1);
    }
    else
    {
        sleep(2);
    }
    run
    {
        set(FG_COMMON, F_COMMON_FOREST_FOUND, TRUE);
        if (JILL)
        {
            set(FG_COMMON, F_COMMON_J_BARRY_LEFT_TERRACE, TRUE);
        }
        aot_reset(AOT_03_EVENT_FOREST_BODY, SCE_NONE, 0, 0, 0, 0);
        cutnext(CAM_03_FOREST_CLOSEUP);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(30);
    run
    {
        bgm_play(BGM_SUB_1);
    }
    message(MSG_IT_IS_FOREST | MSG_FAST, 0); // "It's Forest...! He's been pecked to death by crows."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0001);
    act_reset();
    evt_nop();
    sleep(30);
    evt_fork(TASK_09, crow_1_attacks, 0);
    evt_fork(TASK_09, crow_2_attacks, 0);
    evt_fork(TASK_09, crow_3_attacks, 0);
    cutnext(CAM_04_TERRACE_HIGH);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    sleep(20);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cutnext(CAM_02_FROM_DOOR);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event unused_empty when (MANSION1)
{
    evt_finish();
}

event barry_terrace_talk_again when (JILL && MANSION1)
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_71, 400, 0, 2, 40, 0);
    act_reset();
    evt_nop();
    sleep(20);
    run
    {
        voice_play(VOICE_PLAY, VO_104_0A);
        message(MSG_VO_104_0A, 0);
    }
    wait_message();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event barry_waits_on_terrace when (JILL && MANSION1)
{
    sleep(1);
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_ANIM_DONE_0, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    evt_finish();
}

event unused_forest_message when (JILL && MANSION1)
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    sleep(20);
    message(MSG_FOREST, 0); // "Forest..."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event barry_terrace_scene when (JILL && MANSION1)
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_COMMON, F_COMMON_FOREST_FOUND, TRUE);
        set(FG_COMMON, F_COMMON_J_BARRY_FOREST_SCENE, TRUE);
    }
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_ANIM_DONE_1, AFL_02 | AFL_01);
    act_param_set(0, 2048);
    act_flag_op(EF_SET, EF_0002);
    act_reset();
    evt_nop();
    sleep(21);
    evt_chain(barry_terrace_turns);
    evt_finish();
}

event barry_terrace_turns when (JILL && MANSION1)
{
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_10, F_ROOM_ANIM_DONE_1, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_ENEMY, ENEMY_01_BARRY, 0, 0);
    evt_fork(TASK_09, barry_terrace_jill_approaches, 0);
    sleep(20);
    evt_chain(barry_terrace_line_1);
    evt_finish();
}

event barry_terrace_jill_approaches when (JILL && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_06, 22680, 26170, F_ROOM_ANIM_DONE_2);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_2, FALSE));
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_ANIM_DONE_3, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0002);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_3, FALSE));
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE_4, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_4, FALSE));
    evt_finish();
}

event barry_terrace_line_1 when (JILL && MANSION1)
{
    sleep(5);
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_10, F_ROOM_ANIM_DONE_5, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0001);
    act_reset();
    evt_nop();
    voice_play(VOICE_PLAY, VO_104_00);
    sleep(5);
    message(MSG_VO_104_00, 0);
    sleep(1);
    evt_fork(TASK_09, barry_terrace_jill_steps, 0);
    wait_message();
    evt_chain(barry_terrace_line_2);
    evt_finish();
}

event barry_terrace_jill_steps when (JILL && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_72, 0, 240, 1, 0, 60);
    act_reset();
    evt_nop();
    sleep(35);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_ANIM_DONE_6, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_6, FALSE));
    evt_finish();
}

event barry_terrace_line_2 when (JILL && MANSION1)
{
    sleep(4);
    voice_play(VOICE_PLAY, VO_104_01);
    sleep(5);
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 0, 2, 50, 0);
    act_reset();
    evt_nop();
    message(MSG_VO_104_01, 0);
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_7, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_7, FALSE));
    sleep(1);
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_8, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_8, FALSE));
    sleep(1);
    evt_fork(TASK_09, barry_terrace_jill_steps_back, 0);
    sleep(3);
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_25, F_ROOM_ANIM_DONE_9, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0001);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_9, FALSE));
    wait_message();
    evt_chain(barry_terrace_jill_line);
    evt_finish();
}

event barry_terrace_jill_steps_back when (JILL && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, -200, 0, 0, 40);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 21400, 26500, F_ROOM_ANIM_DONE_0);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_ANIM_DONE_0, FALSE));
    evt_finish();
}

event barry_terrace_jill_line when (JILL && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_ANIM_DONE_1, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(8);
    voice_play(VOICE_PLAY, VO_104_02);
    sleep(5);
    message(MSG_VO_104_02, 0);
    evt_fork(TASK_09, barry_terrace_barry_reacts, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_3, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0002);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE_4, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(24);
    evt_work_set(WK_PLAYER, 0);
