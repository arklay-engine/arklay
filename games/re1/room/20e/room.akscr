        evt_nop();
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
        evt_actor_begin();
        act_anim_flags(ANIM_3E, F_ROOM_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        sleep(40);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
        evt_actor_begin();
        act_anim_flags(ANIM_3E, F_ROOM_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        sleep(20);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
        evt_actor_begin();
        act_anim_flags(ANIM_3E, F_ROOM_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    }
    else
    {
        evt_work_set(WK_PLAYER, 0);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_motion_path(MOTION_32, 0, 300, 4, 0, 50);
    }
    else
    {
        act_anim_flags(ANIM_39, F_ROOM_ANIM_DONE, 0);
    }
    act_reset();
    evt_nop();
    evt_finish();
}

event examine_rebecca when (CHRIS && MANSION1)
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    evt_chain(talk_to_rebecca_again);
    evt_finish();
}
