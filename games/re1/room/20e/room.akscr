event jill_poisoned_barry_rescues when (JILL && MANSION1)
{
    evt_fork(TASK_09, rebecca_walks_in_or_jill_walks, 0);
    sleep(20);
    evt_fork(TASK_09, rebecca_pose_or_jill_clutches_bite, 0);
    bgm_play(BGM_MAIN);
    sleep(80);
    voice_play(VOICE_PLAY, VO_A07_00);
    sleep(15);
    message(MSG_VO_A07_00, 0);
    evt_fork(TASK_09, player_staggers, 0);
    for (3)
    {
        evt_fork(TASK_09, rebecca_anims_or_jill_gasps, 0);
        sleep(30);
    }
    evt_nop();
    evt_fork(TASK_09, chris_gasps_or_jill_kneels, 0);
    sleep(25);
    evt_fork(TASK_09, player_walks_back, 0);
    sleep(40);
    evt_fork(TASK_09, chris_breathes_or_jill_falls, 0);
    sleep(33);
    run
    {
        bgm_stop(BGM_MAIN);
        se_play_3d(SND_BANK_ROOM, SE_2C_TAORE_ST, 0, SND_AT_PLAYER, 0, 0, 0);
    }
    sleep(140);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 500, 2500);
    }
    sleep(20);
    evt_fork(TASK_09, partner_runs_in, 0);
    evt_fork(TASK_09, collapse_fade_jill, 0);
    sleep(100);
    wait_message();
    run
    {
        set(FG_COMMON, F_COMMON_J_CARRIED_TO_SAVE_ROOM, TRUE);
        sys_multi(SYS_HEALTH_STATUS, SYS_XOR | HS_20);
        aot_on(AOT_03_DOOR_100, SCE_DOOR, 0);
    }
    evt_finish();
}

