#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_20D 0x00
#define AOT_01_DOOR_20F 0x01
#define AOT_02_DOOR_210 0x02
#define AOT_03_DOOR_100 0x03                                // Opened when the poisoned player is carried to the save room.
#define AOT_04_5 0x04
#define AOT_05_EVENT_POISON_COLLAPSE 0x05
#define CAM_00_FROM_ATTIC_DOOR 0x00                         // Likely.
#define ENEMY_00_BARRY 0x00
#define ENEMY_00_NPC_REBECCA 0x00
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define F_ROOM_ANIM_DONE 0x20                               // An actor's animation finished (one frame); every actor raises it and nothing waits on it.
#define MSG_VO_008_10 0x01
#define MSG_VO_008_11 0x02
#define MSG_VO_008_12 0x04
#define MSG_VO_008_13 0x05
#define MSG_VO_008_14 0x06
#define MSG_VO_008_15 0x08
#define MSG_VO_008_16 0x09
#define MSG_VO_008_17 0x0B
#define MSG_VO_008_18 0x0A
#define MSG_VO_A06_00 0x00
#define MSG_VO_A07_00 0x0C
#define SE_2C_TAORE_ST 0x2C
#define SE_DOOR_01 0x01
#define VO_008_10 0x0F
#define VO_008_11 0x10
#define VO_008_12 0x11
#define VO_008_13 0x12
#define VO_008_14 0x13
#define VO_008_15 0x14
#define VO_008_16 0x15
#define VO_008_17 0x16
#define VO_008_18 0x17
#define VO_008_19 0x18
#define VO_A06_00 0x0D
#define VO_A07_00 0x0E

proc init noreturn (MANSION2)
{
    door_aot_set(AOT_00_DOOR_20D, 500, 2500, 1700, 3800, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_20D_PILLAR_PASSAGE, 11500, 0, 3100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_20F, 3200, 11400, 1700, 1600, 2, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 4, 0, ROOM_20F_DINING, 4800, 0, 11600, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (MANSION1)
    {
        door_aot_set(AOT_02_DOOR_210, 9200, 2500, 1700, 1300, 2, DOOR_SND_00_DR_WD, DOOR_07_DOOR07, 1, DOOR_LOCKED | F_LOCK_20E_210, ROOM_210_ATTIC, 6100, 0, 3600, 0, IT_35_KEY_MANSION_SHIELD, SAT_MANUAL | SAT_PLAYER);
        if (CHRIS)
        {
            door_aot_set(AOT_03_DOOR_100, 0, 0, 1, 1, 5, DOOR_SND_03_DR_REB, DOOR_00_DOOR00, 64, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            door_aot_set(AOT_03_DOOR_100, 0, 0, 1, 1, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        }
        aot_set(AOT_04_5, 6800, 2100, 1400, 1700, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
        if (CHRIS)
        {
            enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_00_NPC_REBECCA, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_YAWN_POISONED, FALSE))
        {
            room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_OFF);
            if (CHRIS)
            {
                enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_04, F_ENEMY_20E_ZOMBIE_GROUNDSKEEPER_0, SPAWN_FORCE, 2, 0, 1024, 0, 5300, 0, 5800, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_04, F_ENEMY_20E_ZOMBIE_GROUNDSKEEPER_0, SPAWN_FORCE, 2, 0, 1024, 0, 5300, 0, 5800, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
            }
        }
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_YAWN_POISONED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_YAWN_SERUM, FALSE))
            {
                aot_set(AOT_05_EVENT_POISON_COLLAPSE, 5460, 1700, 1300, 3100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, poison_collapse, 0, 0, 0);
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_MET, TRUE))
                {
                    room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD);
                }
                else if (ck(FG_COMMON, F_COMMON_RICHARD_SERUM_IN_TIME, TRUE))
                {
                    room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD);
                }
                else
                {
                    room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 1);
                }
            }
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_SERUM_RUN, TRUE) && ck(FG_COMMON, F_COMMON_C_POISON_SCENE_DONE, FALSE))
            {
                room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 2);
                dir_set(0, 0, 2448, 0, 5070, 0, 3100);
                plw_anim(PLW_00, ANIM_04, 27);
                pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
                if (cmpw(0, W_04, CMP_LT, 300))
                {
                    if (cmpw(0, W_04, CMP_LT, 200))
                    {
                        set(FG_COMMON, F_COMMON_C_REBECCA_SERUM_QUICK, TRUE);
                    }
                    evt_exec(0, TASK_09, rebecca_returns_in_time);
                }
                else
                {
                    evt_exec(0, TASK_09, rebecca_too_late);
                }
            }
            set(FG_COMMON, F_COMMON_RICHARD_SCENE_LEFT, TRUE);
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_YAWN_POISONED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_YAWN_SERUM, FALSE) && ck(FG_COMMON, F_COMMON_J_POISON_COLLAPSE_DONE, FALSE))
            {
                room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 1);
                enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_00_BARRY, ANIM_00, 0, EVAR_00);
                aot_set(AOT_05_EVENT_POISON_COLLAPSE, 5460, 1700, 1300, 3100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, poison_collapse, 0, 0, 0);
            }
        }
    }
    else
    {
        door_aot_set(AOT_02_DOOR_210, 8900, 2500, 1700, 1300, 2, DOOR_SND_00_DR_WD, DOOR_07_DOOR07, 1, DOOR_LOCKED | F_LOCK_20E_210, ROOM_210_ATTIC, 6100, 0, 3600, 0, IT_35_KEY_MANSION_SHIELD, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_03_DOOR_100, 0, 0, 1, 1, 5, DOOR_SND_03_DR_REB, DOOR_00_DOOR00, 64, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        aot_set(AOT_04_5, 6600, 2600, 1900, 2400, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
}

proc main when (MANSION1)
{
    if (ck(FG_COMMON, F_COMMON_YAWN_POISONED, FALSE))
    {
        aot_delete(AOT_05_EVENT_POISON_COLLAPSE, SCE_NONE, 0);
    }
}

event poison_collapse when (MANSION1)
{
    if (CHRIS)
    {
        run
        {
            aot_delete(AOT_05_EVENT_POISON_COLLAPSE, SCE_NONE, 0);
        }
        sleep(1);
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            set(FG_SCENARIO, F_SCENARIO_YAWN_SERUM, TRUE);
        }
    }
    else
    {
        run
        {
            aot_delete(AOT_05_EVENT_POISON_COLLAPSE, SCE_NONE, 0);
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            set(FG_COMMON, F_COMMON_J_POISON_COLLAPSE_DONE, TRUE);
            set(FG_SCENARIO, F_SCENARIO_YAWN_SERUM, TRUE);
        }
    }
    sleep(20);
    run
    {
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_MET, TRUE))
            {
                evt_exec(0, TASK_09, chris_poisoned_with_rebecca);
            }
            else if (ck(FG_COMMON, F_COMMON_RICHARD_SERUM_IN_TIME, TRUE))
            {
                evt_exec(0, TASK_09, chris_poisoned_richard_saved);
            }
            else
            {
                evt_exec(0, TASK_09, chris_poisoned_alone);
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, TRUE))
            {
                evt_exec(0, TASK_09, jill_poisoned_barry_rescues);
            }
            else
            {
                evt_exec(0, TASK_09, jill_poisoned_alone);
            }
        }
    }
    evt_finish();
}

event chris_poisoned_richard_saved when (CHRIS && MANSION1)
{
    evt_fork(TASK_09, chris_walks_from_attic, 0);
    sleep(20);
    evt_chain(rebecca_goes_for_serum);
    evt_finish();
}

event chris_poisoned_alone when (CHRIS && MANSION1)
{
    evt_fork(TASK_09, player_walks_back, 0);
    sleep(40);
    bgm_play(BGM_MAIN);
    evt_fork(TASK_09, chris_gasps_or_jill_kneels, 0);
    sleep(80);
    voice_play(VOICE_PLAY, VO_A06_00);
    evt_fork(TASK_09, player_staggers, 0);
    sleep(15);
    message(MSG_VO_A06_00, 0);
    wait_message();
    sleep(100);
    run
    {
        set(FG_COMMON, F_COMMON_C_POISON_SCENE_DONE, TRUE);
        set(FG_COMMON, F_COMMON_C_CHRIS_NEEDS_SERUM, TRUE);
    }
    evt_chain(poison_scene_end);
    evt_finish();
}

event chris_poisoned_with_rebecca when (CHRIS && MANSION1)
{
    evt_fork(TASK_09, chris_walks_from_attic, 0);
    sleep(20);
    run
    {
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_IN_SAVE_ROOM, TRUE))
        {
            evt_exec(0, TASK_09, chris_carried_to_save_room);
        }
        else
        {
            evt_exec(0, TASK_09, rebecca_goes_for_serum);
        }
    }
    evt_finish();
}

event chris_carried_to_save_room when (CHRIS && MANSION1)
{
    run
    {
        cut_auto(CUT_LOCKED);
        bgm_play(BGM_MAIN);
    }
    evt_fork(TASK_09, chris_clutches_bite, 0);
    sleep(80);
    voice_play(VOICE_PLAY, VO_A06_00);
    sleep(15);
    message(MSG_VO_A06_00, 0);
    evt_fork(TASK_09, chris_staggers, 0);
    for (3)
    {
        evt_fork(TASK_09, chris_gasps, 0);
        sleep(30);
    }
    evt_nop();
    evt_fork(TASK_09, chris_kneels, 0);
    sleep(25);
    evt_fork(TASK_09, player_walks_from_attic, 0);
    sleep(10);
    evt_fork(TASK_09, chris_falls, 0);
    sleep(33);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2C_TAORE_ST, 0, SND_AT_PLAYER, 0, 0, 0);
        bgm_stop(BGM_MAIN);
    }
    sleep(140);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 500, 2500);
    }
    sleep(20);
    evt_fork(TASK_09, partner_runs_in, 0);
    evt_fork(TASK_09, collapse_fade, 0);
    sleep(100);
    wait_message();
    run
    {
        set(FG_COMMON, F_COMMON_C_YAWN_WAKE_UP_DUE, TRUE);
        set(FG_COMMON, F_COMMON_C_POISON_SCENE_DONE, TRUE);
        sys_multi(SYS_HEALTH_STATUS, SYS_XOR | HS_20);
        cut_auto(CUT_FREE);
        aot_on(AOT_03_DOOR_100, SCE_DOOR, 0);
    }
    evt_finish();
}

event rebecca_goes_for_serum when (CHRIS && MANSION1)
{
    run
    {
        pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
    }
    evt_fork(TASK_09, chris_clutches_bite, 0);
    sleep(80);
    bgm_play(BGM_MAIN);
    evt_fork(TASK_09, chris_gasps_loop, 0);
    sleep(20);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 500, 2500);
    }
    sleep(30);
    cutnext(CAM_00_FROM_ATTIC_DOOR);
    evt_fork(TASK_09, rebecca_gesture, 0);
    sleep(5);
    voice_play(VOICE_PLAY, VO_008_10);
    sleep(15);
    message(MSG_VO_008_10, 0);
    evt_fork(TASK_09, rebecca_runs_to_chris, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_A06_00);
    sleep(15);
    message(MSG_VO_A06_00, 0);
    evt_fork(TASK_09, chris_staggers, 0);
    for (3)
    {
        evt_fork(TASK_09, chris_gasps, 0);
        sleep(48);
    }
    evt_nop();
    wait_message();
    voice_play(VOICE_PLAY, VO_008_11);
    sleep(15);
    message(MSG_VO_008_11, 0);
    evt_fork(TASK_09, rebecca_kneels, 0);
    sleep(80);
    message(3, 0);
    evt_fork(TASK_09, rebecca_turns, 0);
    sleep(61);
    evt_fork(TASK_09, rebecca_leaves_for_serum, 0);
    sleep(25);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_COMMON, F_COMMON_C_CHRIS_NEEDS_SERUM, TRUE);
        set(FG_COMMON, F_COMMON_C_REBECCA_SERUM_RUN, TRUE);
        set(FG_COMMON, F_COMMON_C_REBECCA_RAN_FOR_SERUM, TRUE);
        setb(B_CHARACTER_MODEL, 3, 0);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        setw(W_04, 0);
        aot_on(AOT_00_DOOR_20D, SCE_DOOR, 0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event rebecca_returns_in_time when (CHRIS && MANSION1)
{
    sleep(1);
    run
    {
        pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
    }
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    sleep(20);
    evt_chain(rebecca_cures_chris);
    evt_finish();
}

event rebecca_cures_chris when (CHRIS && MANSION1)
{
    evt_fork(TASK_09, rebecca_walks_to_chris, 0);
    sleep(60);
    bgm_play(BGM_MAIN);
    evt_fork(TASK_09, poison_vision_pulse, 0);
    sleep(50);
    evt_fork(TASK_09, rebecca_pose_or_jill_clutches_bite, 0);
    sleep(1);
    evt_fork(TASK_07, chris_breathes_loop, 0);
    sleep(100);
    voice_play(VOICE_PLAY, VO_008_12);
    sleep(15);
    message(MSG_VO_008_12, 0);
    evt_fork(TASK_09, rebecca_talk_anims, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_008_13);
    sleep(15);
    message(MSG_VO_008_13, 0);
    evt_fork(TASK_09, chris_steps_forward, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_008_14);
    sleep(15);
    message(MSG_VO_008_14, 0);
    evt_fork(TASK_09, rebecca_talk_anims_2, 0);
    sleep(100);
    message(7, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_008_15);
    evt_fork(TASK_09, player_gasps, 0);
    sleep(15);
    message(MSG_VO_008_15, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_008_16);
    sleep(15);
    message(MSG_VO_008_16, 0);
    evt_fork(TASK_09, rebecca_gestures_or_jill_staggers, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_008_18);
    sleep(15);
    message(MSG_VO_008_18, 0);
    evt_fork(TASK_09, player_recover_anims, 0);
    wait_message();
    evt_disable(TASK_07);
    evt_fork(TASK_09, chris_breathes_or_jill_falls, 0);
    sleep(40);
    run
    {
        sys_multi(SYS_HEALTH_STATUS, SYS_XOR | HS_20);
        aot_set(AOT_05_EVENT_POISON_COLLAPSE, 3420, 1930, 1100, 1100, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_rebecca, 0, 0, 0);
        set(FG_COMMON, F_COMMON_C_POISON_SCENE_DONE, TRUE);
    }
    evt_chain(poison_scene_end);
    evt_finish();
}

event jill_poisoned_alone when (JILL && MANSION1)
{
    evt_fork(TASK_09, player_walks_from_attic, 0);
    sleep(40);
    evt_fork(TASK_09, player_gasps, 0);
    bgm_play(BGM_MAIN);
    sleep(80);
    voice_play(VOICE_PLAY, VO_A07_00);
    evt_fork(TASK_09, rebecca_gestures_or_jill_staggers, 0);
    sleep(15);
    message(MSG_VO_A07_00, 0);
    wait_message();
    sleep(100);
    set(FG_COMMON, F_COMMON_J_JILL_NEEDS_SERUM, TRUE);
    evt_chain(poison_scene_end);
    evt_finish();
}

event poison_scene_end when (MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_00, F_ROOM_ANIM_DONE, AFL_01);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(30);
        run
        {
            cut_auto(CUT_FREE);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        }
    }
    else
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    sleep(20);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

event chris_clutches_bite when (CHRIS && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_38, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    evt_finish();
}

event chris_staggers when (CHRIS && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 400, 0, 2, 30, 0);
    act_reset();
    evt_nop();
    evt_finish();
}

event chris_kneels when (CHRIS && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0001);
    act_reset();
    evt_nop();
    evt_finish();
}

event chris_gasps when (CHRIS && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_39, F_ROOM_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    evt_finish();
}

event rebecca_runs_to_chris when (CHRIS && MANSION1)
{
    sleep(30);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_seq(AB_03, 3880, 2780, F_ROOM_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, -300, 0, 0, 30);
    act_reset();
    evt_nop();
    evt_finish();
}

event rebecca_kneels when (CHRIS && MANSION1)
{
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0001);
    act_reset();
    evt_nop();
