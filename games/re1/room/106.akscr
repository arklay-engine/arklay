#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_03_USEITEM 0x03
#define AOT_04_DOOR 0x04
#define AOT_05_ITEM 0x05
#define AOT_06_ITEM 0x06
#define FLAG_ROOM_00 0x00
#define FLAG_ROOM_01 0x01
#define FLAG_ROOM_02 0x02
#define FLAG_ROOM_03 0x03
#define FLAG_ROOM_05 0x05
#define FLAG_ROOM_06 0x06
#define FLAG_ROOM_07 0x07
#define FLAG_ROOM_08 0x08
#define FLAG_ROOM_09 0x09
#define FLAG_ROOM_0A 0x0A
#define FLAG_ROOM_0B 0x0B
#define FLAG_ROOM_0C 0x0C
#define FLAG_ROOM_0D 0x0D
#define FLAG_ROOM_0E 0x0E
#define FLAG_ROOM_0F 0x0F
#define FLAG_ROOM_10 0x10
#define FLAG_ROOM_14 0x14
#define FLAG_ROOM_20 0x20
#define FLAG_ROOM_21 0x21
#define FLAG_ROOM_22 0x22
#define FLAG_ROOM_23 0x23
#define FLAG_ROOM_24 0x24
#define FLAG_ROOM_25 0x25
#define FLAG_ROOM_26 0x26

proc init
{
    set(FG_STATUS, FLAG_STATUS_1C, TRUE);
    door_aot_set(AOT_00_DOOR, 31100, 10000, 2000, 3000, 6, 0, 4, 7, 0, ROOM_107_GALLERY, 2700, 0, 6600, 0, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 31100, 18600, 2000, 1200, 2, 0, 3, 1, 197, ROOM_111_DRESSING_ROOM, 2800, 0, 4600, 0, ITEM_34_KEY_MANSION_ARMOR, 129);
    door_aot_set(AOT_02_DOOR, 1000, 15000, 1950, 3800, 6, 0, 3, 7, 0, ROOM_105_DINING_ROOM, 30900, 0, 8300, 2048, UNLOCKED, 129);
#if CHRIS
    if (cmpb(9, 0, 3))
    {
        door_aot_set(AOT_03_DOOR, 14600, 800, 5200, 2200, 2, 0, 3, 1, 197, ROOM_111_DRESSING_ROOM, 2800, 0, 4600, 0, ITEM_34_KEY_MANSION_ARMOR, 129);
    }
    else
    {
        aot_set(AOT_03_DOOR, 14600, 800, 5200, 2200, SCE_SAVE, 129, 4, 0, 0, 0, 1, 0);
    }
#else
    aot_set(AOT_03_USEITEM, 14600, 800, 5200, 2200, SCE_USEITEM, 129, 4, 0, 32, 0, 1, 0);
#endif
    door_aot_set(AOT_04_DOOR, 15600, 15900, 2900, 2600, 0, 4, 22, 96, 0, STAGE_2 | ROOM_203_HALL_2F, 17100, 0, 25300, 3072, UNLOCKED, 129);
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_08, FALSE))
    {
        item_aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, ITEM_2F_TOOL_INK_RIBBON, 3, 3, 255, 0, 0, 32, 78, 0, 0, 0, 0, 52, 129, 0, 0);
        if (ck(FG_ITEM, FLAG_ITEM_34, TRUE))
        {
            if (cmpb(9, 0, 3))
            {
                aot_reset(AOT_05_ITEM, SCE_MESSAGE, 129, 174, 255, 0);
            }
        }
    }
    else
    {
        aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, SCE_TYPEWRITER, 129, 0, 0, 0, 0, 0, 0);
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_0B, FALSE) && ck(FG_SCENARIO, FLAG_SCENARIO_7B, TRUE))
    {
        item_aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, ITEM_2F_TOOL_INK_RIBBON, 2, 3, 255, 0, 0, 32, 78, 0, 0, 0, 0, 52, 129, 0, 0);
    }
    else
    {
        aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, SCE_TYPEWRITER, 129, 0, 0, 0, 0, 0, 0);
    }
#endif
    if (ck(FG_COMMON, FLAG_COMMON_03, TRUE))
    {
        room_bgm_state_set(0, 6, 8);
    }
#if CHRIS
    if (ck(FG_ITEM, FLAG_ITEM_1A, TRUE) && ck(FG_COMMON, FLAG_COMMON_02, TRUE))
    {
        item_aot_set(AOT_06_ITEM, 24100, 10100, 1800, 1800, ITEM_02_WEAPON_HANDGUN, 15, 2, 255, 168, 97, 0, 0, 248, 42, 0, 0, 26, 129, 0, 0);
        if (cmpb(9, 0, 3))
        {
            aot_reset(AOT_06_ITEM, SCE_MESSAGE, 129, 174, 255, 0);
        }
        else
        {
            aot_reset(AOT_06_ITEM, SCE_EVENT, 129, 0, on_aot_06_item, 0);
        }
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_0A, FALSE) && ck(FG_COMMON, FLAG_COMMON_07, FALSE) && ck(FG_ITEM, FLAG_ITEM_0D, FALSE))
    {
        set(FG_COMMON, FLAG_COMMON_07, TRUE);
        item_aot_set(AOT_06_ITEM, 0, 0, 16, 16, ITEM_11_AMMO_GRENADE_ACID, 6, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, 14, 65, 0, 0);
        enemy(ENEMY_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 1568, 0, 0, 19100, 0, 14600, 0, 0, 0, 0);
        evt_exec(0, 0, on_enter_5);
    }
    if (ck(FG_COMMON, FLAG_COMMON_05, FALSE) && ck(FG_COMMON, FLAG_COMMON_07, TRUE))
    {
        set(FG_COMMON, FLAG_COMMON_07, FALSE);
        set(FG_COMMON, FLAG_COMMON_05, TRUE);
        room_bgm_state_set(0, 6, 65);
        item_aot_set(AOT_06_ITEM, 0, 0, 16, 16, ITEM_31_TOOL_LOCKPICK, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 9, 65, 0, 0);
        enemy(ENEMY_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 317, 0, 0, 12609, 0, 5417, 0, 0, 0, 0);
        evt_exec(0, 0, on_enter_4);
        cut_auto(1);
        setb(2, 6, 0);
        set(FG_STATUS, FLAG_STATUS_1D, TRUE);
        set(FG_ROOM, FLAG_ROOM_09, TRUE);
        set(FG_ROOM, FLAG_ROOM_0C, TRUE);
    }
#endif
    if (ck(FG_COMMON, FLAG_COMMON_03, FALSE) && ck(FG_COMMON, FLAG_COMMON_02, TRUE))
    {
#if CHRIS
        set(FG_COMMON, FLAG_COMMON_03, TRUE);
#else
        room_bgm_state_set(0, 6, 65);
        item_aot_set(AOT_06_ITEM, 0, 0, 16, 16, ITEM_31_TOOL_LOCKPICK, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 9, 65, 0, 0);
        enemy(ENEMY_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 480, 0, 0, 5460, 0, 14767, 0, 0, 0, 0);
        aot_reset(AOT_00_DOOR, SCE_MESSAGE, 129, 162, 255, 0);
        aot_reset(AOT_01_DOOR, SCE_MESSAGE, 129, 162, 255, 0);
        aot_reset(AOT_02_DOOR, SCE_MESSAGE, 129, 162, 255, 0);
        aot_reset(AOT_05_ITEM, SCE_MESSAGE, 129, 174, 255, 0);
        cut_auto(1);
        setb(2, 6, 0);
#endif
        evt_exec(0, 0, on_enter_3);
#if JILL
        set(FG_COMMON, FLAG_COMMON_03, TRUE);
        set(FG_STATUS, FLAG_STATUS_1D, TRUE);
#endif
    }
    if (ck(FG_COMMON, FLAG_COMMON_00, TRUE) && ck(FG_COMMON, FLAG_COMMON_02, FALSE))
    {
#if CHRIS
        enemy(ENEMY_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 1920, 0, 0, 16000, 0, 9000, 0, 0, 0, 0);
        enemy(ENEMY_21_NPC_JILL, 2, 255, 1, 2, 0, 0, 3328, 0, 0, 20000, 0, 11000, 1, 0, 0, 0);
#else
        enemy(ENEMY_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 3888, 0, 0, 19600, 0, 8500, 0, 0, 0, 0);
#endif
        cut_auto(1);
        setb(2, 6, 0);
        set(FG_COMMON, FLAG_COMMON_01, TRUE);
        evt_exec(0, 0, on_enter_2);
    }
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_00, FALSE))
    {
        enemy(ENEMY_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 2304, 0, 0, 18700, 0, 3000, 0, 0, 0, 0);
        enemy(ENEMY_21_NPC_JILL, 2, 255, 1, 2, 0, 0, 1300, 0, 0, 20800, 0, 8500, 1, 18, 0, 0);
        dir_set(0, 0, 0, 0, 14600, 0, 5000);
        set(FG_COMMON, FLAG_COMMON_00, TRUE);
        evt_exec(0, 0, on_enter);
        set(FG_STATUS, FLAG_STATUS_1D, TRUE);
        set(FG_COMMON, FLAG_COMMON_A7, TRUE);
    }
    if (ck(FG_COMMON, FLAG_COMMON_A0, TRUE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_A1, FALSE))
        {
            set(FG_COMMON, FLAG_COMMON_A1, TRUE);
            room_bgm_state_set(0, 4, 10);
            room_bgm_state_set(0, 15, 65);
        }
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_5F, TRUE))
    {
        set(FG_COMMON, FLAG_COMMON_5E, TRUE);
    }
    if (ck(FG_COMMON, FLAG_COMMON_00, FALSE))
    {
        enemy(ENEMY_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 3072, 0, 0, 17000, 0, 2500, 0, 0, 0, 0);
        enemy(ENEMY_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 2816, 0, 0, 15500, 0, 2500, 1, 0, 0, 0);
        dir_set(0, 0, 3200, 0, 18500, 0, 2500);
        set(FG_COMMON, FLAG_COMMON_00, TRUE);
        evt_exec(0, 0, on_enter);
        set(FG_STATUS, FLAG_STATUS_1D, TRUE);
        set(FG_COMMON, FLAG_COMMON_AA, TRUE);
    }
#endif
}

proc main
{
#if CHRIS
    if (cmpb(9, 5, 3))
    {
        if (ck(FG_ROOM, FLAG_ROOM_01, FALSE))
        {
            if (cmpb(16, 0, 4))
            {
                if (ck(FG_COMMON, FLAG_COMMON_04, FALSE))
                {
                    set(FG_COMMON, FLAG_COMMON_04, TRUE);
                    set(FG_ROOM, FLAG_ROOM_01, TRUE);
                    evt_exec(0, 7, from_main_2);
                    set(FG_ROOM, FLAG_ROOM_01, FALSE);
                }
                else
                {
                    set(FG_ROOM, FLAG_ROOM_02, TRUE);
                }
            }
            if (ck(FG_ROOM, FLAG_ROOM_02, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_02, FALSE);
                set(FG_ROOM, FLAG_ROOM_01, TRUE);
                message(161, 255); // "It's too dangerous to go outside!"
                set(FG_ROOM, FLAG_ROOM_01, FALSE);
            }
        }
    }
    if (testpickup(ITEM_02_WEAPON_HANDGUN))
    {
        set(FG_ROOM, FLAG_ROOM_03, TRUE);
    }
    if (ck(FG_COMMON, FLAG_COMMON_08, FALSE) && ck(FG_ITEM, FLAG_ITEM_34, FALSE))
    {
        set(FG_COMMON, FLAG_COMMON_08, TRUE);
        aot_reset(AOT_05_ITEM, SCE_TYPEWRITER, 129, 0, 0, 0);
    }
    return;
    if (testpickup(ITEM_54_UNKNOWN_54))
    {
        evt_exec(0, 9, from_main);
    }
    if (ck(FG_ROOM, FLAG_ROOM_00, TRUE))
    {
        evt_exec(0, 9, from_main_3);
        set(FG_ROOM, FLAG_ROOM_00, FALSE);
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_03, TRUE) && ck(FG_COMMON, FLAG_COMMON_05, FALSE))
    {
        if (cmpb(2, 0, 3) && ck(FG_ROOM, FLAG_ROOM_14, FALSE))
        {
            set(FG_ROOM, FLAG_ROOM_07, TRUE);
            set(FG_ROOM, FLAG_ROOM_14, TRUE);
            evt_exec(0, 3, from_main);
        }
        if (cmpb(2, 0, 4) && ck(FG_ROOM, FLAG_ROOM_14, FALSE))
        {
            set(FG_ROOM, FLAG_ROOM_07, TRUE);
            set(FG_ROOM, FLAG_ROOM_14, TRUE);
            evt_exec(0, 3, from_main);
        }
        if (ck(FG_ROOM, FLAG_ROOM_07, TRUE) && ck(FG_ROOM, FLAG_ROOM_08, FALSE))
        {
            if (cmpb(2, 0, 2))
            {
                set(FG_ROOM, FLAG_ROOM_08, TRUE);
                set(FG_COMMON, FLAG_COMMON_05, TRUE);
                set(FG_ROOM, FLAG_ROOM_09, TRUE);
                set(FG_ROOM, FLAG_ROOM_0A, TRUE);
                pos_set(0, 0, 1709, 0, 25524, 0, 6371);
                evt_exec(0, 0, from_main_2);
            }
            if (cmpb(2, 0, 5))
            {
                set(FG_ROOM, FLAG_ROOM_08, TRUE);
                set(FG_COMMON, FLAG_COMMON_05, TRUE);
                set(FG_ROOM, FLAG_ROOM_09, TRUE);
                set(FG_ROOM, FLAG_ROOM_0B, TRUE);
                pos_set(0, 0, 2488, 0, 8111, 0, 9567);
                evt_exec(0, 0, from_main_5);
            }
        }
    }
    if (ck(FG_ROOM, FLAG_ROOM_09, TRUE))
    {
        if (ck(FG_ROOM, FLAG_ROOM_0A, TRUE))
        {
            if (ck(FG_ROOM, FLAG_ROOM_0D, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0D, FALSE);
                evt_exec(0, 0, from_main_10);
            }
            if (ck(FG_ROOM, FLAG_ROOM_0E, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0E, FALSE);
                evt_exec(0, 0, from_main_3);
            }
            if (ck(FG_ROOM, FLAG_ROOM_0F, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0F, FALSE);
                evt_exec(0, 0, from_main_11);
            }
            if (ck(FG_ROOM, FLAG_ROOM_10, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_10, FALSE);
                evt_exec(0, 0, from_main_4);
            }
        }
        if (ck(FG_ROOM, FLAG_ROOM_0B, TRUE))
        {
            if (ck(FG_ROOM, FLAG_ROOM_0D, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0D, FALSE);
                evt_exec(0, 0, from_main_10);
            }
            if (ck(FG_ROOM, FLAG_ROOM_0E, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0E, FALSE);
                evt_exec(0, 0, from_main_6);
            }
            if (ck(FG_ROOM, FLAG_ROOM_0F, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0F, FALSE);
                evt_exec(0, 0, from_main_11);
            }
            if (ck(FG_ROOM, FLAG_ROOM_10, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_10, FALSE);
                evt_exec(0, 0, from_main_7);
            }
        }
        if (ck(FG_ROOM, FLAG_ROOM_0C, TRUE))
        {
            if (ck(FG_ROOM, FLAG_ROOM_0D, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0D, FALSE);
                evt_exec(0, 0, from_main_10);
            }
            if (ck(FG_ROOM, FLAG_ROOM_0E, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0E, FALSE);
                evt_exec(0, 0, from_main_8);
            }
            if (ck(FG_ROOM, FLAG_ROOM_0F, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_0F, FALSE);
                evt_exec(0, 0, from_main_11);
            }
            if (ck(FG_ROOM, FLAG_ROOM_10, TRUE))
            {
                set(FG_ROOM, FLAG_ROOM_10, FALSE);
                evt_exec(0, 0, from_main_9);
            }
        }
    }
    if (ck(FG_ROOM, FLAG_ROOM_01, FALSE))
    {
        if (cmpb(16, 0, 4))
        {
            if (ck(FG_COMMON, FLAG_COMMON_04, FALSE))
            {
                set(FG_COMMON, FLAG_COMMON_04, TRUE);
                set(FG_ROOM, FLAG_ROOM_01, TRUE);
                evt_exec(0, 7, from_main_12);
                set(FG_ROOM, FLAG_ROOM_01, FALSE);
            }
            else
            {
                set(FG_ROOM, FLAG_ROOM_02, TRUE);
            }
        }
        if (ck(FG_ROOM, FLAG_ROOM_02, TRUE))
        {
            set(FG_ROOM, FLAG_ROOM_02, FALSE);
            set(FG_ROOM, FLAG_ROOM_01, TRUE);
            message(161, 255); // "It's too dangerous to go outside!"
            set(FG_ROOM, FLAG_ROOM_01, FALSE);
        }
    }
    if (ck(FG_COMMON, FLAG_COMMON_0B, FALSE) && ck(FG_ITEM, FLAG_ITEM_34, FALSE))
    {
        set(FG_COMMON, FLAG_COMMON_0B, TRUE);
        aot_reset(AOT_05_ITEM, SCE_TYPEWRITER, 129, 0, 0, 0);
    }
#endif
}

event on_enter
{
    evt_next();
    evt_nop();
    set(FG_6, FLAG_6_17, FALSE);
#if CHRIS
    evt_fork(1, on_enter_sub1, 0);
    evt_fork(2, on_enter_sub2, 0);
#else
    cut_auto(1);
#endif
    sleep(10);
    set(FG_STATUS, FLAG_STATUS_0F, TRUE);
#if CHRIS
    sleep(50);
    cutnext(6);
    sleep(20);
    evt_work_set(WK_ENEMY, 1);
#else
    evt_work_set(WK_PLAYER, 0);
#endif
    evt_actor_begin();
#if CHRIS
    act_anim_flags(0 | 16, 32 | 2, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(8);
#else
    act_anim_seq(42002, 13393, 8225);
#endif
    act_reset();
#if CHRIS
    evt_nop();
    voice_play(1, 0, 0);
    message(0, 0);
#else
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_seq(37890, 32835, 8460);
    act_reset();
#endif
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
#if CHRIS
    sleep(5);
    act_motion_path(113, 500, 0, 2, 160, 64);
    act_anim_flags(32 | 5, 32 | 2, 0 | 0);
    act_flag_op(0, 2, 0);
#else
    act_anim_seq(33794, 16437, 8735);
#endif
    act_reset();
#if JILL
    evt_fork(3, on_enter_sub1, 0);
    evt_fork(2, on_enter_sub2, 0);
    evt_fork(1, on_enter_sub3, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
    sleep(10);
    cutnext(1);
    voice_play(1, 25, 0);
    message(11, 0);
    sleep(32);
    evt_disable(1);
    sleep(23);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_motion_path(17, 13700, 62936, 8000, 192, 64);
    sleep(3);
    act_anim_seq(18438, 10303, 8483);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
    act_motion_path(51, 65436, 65236, 0, 192, 64);
    act_anim_flags(32 | 1, 32 | 1, 0 | 3);
    act_reset();
#endif
    evt_nop();
#if CHRIS
    sleep(4);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_motion_path(147, 1, 1, 0, 80, 64);
#else
    act_anim_seq(46082, 95, 8242);
#endif
    act_reset();
#if CHRIS
    evt_nop();
    evt_disable(2);
#else
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
#endif
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
#if CHRIS
    act_motion_path(147, 1, 1, 0, 80, 64);
#else
    act_anim_flags(32 | 2, 32 | 1, 0 | 3);
#endif
    act_reset();
    evt_nop();
#if JILL
    evt_disable(2);
#endif
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
#if CHRIS
    sleep(10);
    act_anim_flags(32 | 5, 32 | 2, 0 | 0);
    act_flag_op(0, 3, 0);
    sleep(15);
    act_anim_flags(32 | 2, 32 | 2, 0 | 0);
#else
    act_motion_path(17, 17300, 62936, 3200, 192, 64);
    sleep(3);
    act_anim_seq(46086, 45126, 8733);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_22, FALSE));
    act_anim_flags(32 | 2, 32 | 2, 0 | 3);
#endif
    act_reset();
    evt_nop();
#if JILL
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, FLAG_STATUS_0E, TRUE));
    cutnext(2);
    sleep(8);
    evt_disable(3);
#endif
    sleep(10);
#if CHRIS
    evt_fork(3, on_enter_sub3, 0);
    wait_message();
    cutnext(1);
    evt_disable(1);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_motion_path(51, 65036, 0, 0, 140, 64);
    sleep(10);
    act_motion_path(51, 500, 0, 0, 120, 120);
    sleep(10);
    act_motion_path(51, 64836, 0, 0, 196, 80);
    sleep(15);
    act_motion_path(19, 12000, 62936, 9300, 196, 64);
#else
    act_anim_flags(32 | 15, 32 | 0, 0 | 0);
    act_flag_op(0, 2, 0);
    act_param_set(0, 8);
    sleep(21);
    act_anim_seq(16387, 12369, 8234);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    act_anim_flags(32 | 2, 32 | 0, 0 | 0);
#endif
    sleep(4);
#if CHRIS
    act_anim_flags(32 | 13, 32 | 2, 0 | 0);
    act_param_set(0, 252);
#else
    act_motion_path(49, 64836, 0, 0, 120, 40);
#endif
    sleep(10);
#if JILL
    act_motion_path(49, 500, 0, 0, 140, 40);
    sleep(19);
    act_motion_path(49, 0, 0, 0, 152, 64);
    sleep(12);
#endif
    act_reset();
    evt_nop();
#if CHRIS
    voice_play(1, 1, 0);
    message(1, 0);
