proc init
{
    set(FG_STATUS, F_STATUS_1C, TRUE);
    door_aot_set(AOT_00_DOOR, 31100, 10000, 2000, 3000, 6, DOOR_SND_00_DR_WD, DOOR_04_DOOR04, 7, 0, ROOM_107_GALLERY, 2700, 0, 6600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 31100, 18600, 2000, 1200, 2, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_05, ROOM_111_DRESSING_ROOM, 2800, 0, 4600, 0, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 1000, 15000, 1950, 3800, 6, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 7, 0, ROOM_105_DINING_ROOM, 30900, 0, 8300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
    {
        door_aot_set(AOT_03_DOOR, 14600, 800, 5200, 2200, 2, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_05, ROOM_111_DRESSING_ROOM, 2800, 0, 4600, 0, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_set(AOT_03_DOOR, 14600, 800, 5200, 2200, SCE_SAVE, SAT_MANUAL | SAT_PLAYER, 4, 0, 0, 0, 1, 0);
    }
#else
    aot_set(AOT_03_USEITEM, 14600, 800, 5200, 2200, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER, 4, 0, 32, 0, 1, 0);
#endif
    door_aot_set(AOT_04_DOOR, 15600, 15900, 2900, 2600, 0, DOOR_SND_04_ST_WCP, DOOR_16_KAI01, 96, 0, STAGE_2 | ROOM_203_HALL_2F, 17100, 0, 25300, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_08, FALSE))
    {
        item_aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, IT_2F_KEY_INK_RIBBON, 3, 3, 255, 0, 0, 32, 78, 0, 0, 0, 0, F_ITEM_34, 129, 0, 0);
        if (ck(FG_ITEM, F_ITEM_34, TRUE))
        {
            if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
            {
                aot_reset(AOT_05_ITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 174, 255, 0);
            }
        }
    }
    else
    {
        aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
#else
    if (ck(FG_COMMON, F_COMMON_0B, FALSE) && ck(FG_SCENARIO, F_SCENARIO_7B, TRUE))
    {
        item_aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, IT_2F_KEY_INK_RIBBON, 2, 3, 255, 0, 0, 32, 78, 0, 0, 0, 0, F_ITEM_34, 129, 0, 0);
    }
    else
    {
        aot_set(AOT_05_ITEM, 13000, 16000, 2000, 2000, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
#endif
    if (ck(FG_COMMON, F_COMMON_03, TRUE))
    {
        room_bgm_state_set(0, ROOM_106_MAIN_HALL, BGM_MAIN_ON);
    }
#if CHRIS
    if (ck(FG_ITEM, F_ITEM_1A, TRUE) && ck(FG_COMMON, F_COMMON_02, TRUE))
    {
        item_aot_set(AOT_06_ITEM, 24100, 10100, 1800, 1800, IT_02_WEAPON_HANDGUN, 15, 2, 255, 168, 97, 0, 0, 248, 42, 0, 0, F_ITEM_1A, 129, 0, 0);
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
        {
            aot_reset(AOT_06_ITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 174, 255, 0);
        }
        else
        {
            aot_reset(AOT_06_ITEM, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_06_item, 0);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_0A, FALSE) && ck(FG_COMMON, F_COMMON_07, FALSE) && ck(FG_ITEM, F_ITEM_0D, FALSE))
    {
        set(FG_COMMON, F_COMMON_07, TRUE);
        item_aot_set(AOT_06_ITEM, 0, 0, 16, 16, IT_11_AMMO_GRENADE_ACID, 6, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_0E, 65, 0, 0);
        enemy(EM_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 1568, 0, 0, 19100, 0, 14600, ENEMY_00, 0, 0, 0);
        evt_exec(0, TASK_00, on_enter_5);
    }
    if (ck(FG_COMMON, F_COMMON_05, FALSE) && ck(FG_COMMON, F_COMMON_07, TRUE))
    {
        set(FG_COMMON, F_COMMON_07, FALSE);
        set(FG_COMMON, F_COMMON_05, TRUE);
        room_bgm_state_set(0, ROOM_106_MAIN_HALL, BGM_RELOAD | 1);
        item_aot_set(AOT_06_ITEM, 0, 0, 16, 16, IT_31_KEY_LOCKPICK, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_09, 65, 0, 0);
        enemy(EM_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 317, 0, 0, 12609, 0, 5417, ENEMY_00, 0, 0, 0);
        evt_exec(0, TASK_00, on_enter_4);
        cut_auto(1);
        setb(B_CAMERA, CAM_06, 0);
        set(FG_STATUS, F_STATUS_1D, TRUE);
        set(FG_ROOM, F_ROOM_09, TRUE);
        set(FG_ROOM, F_ROOM_0C, TRUE);
    }
#endif
    if (ck(FG_COMMON, F_COMMON_03, FALSE) && ck(FG_COMMON, F_COMMON_02, TRUE))
    {
#if CHRIS
        set(FG_COMMON, F_COMMON_03, TRUE);
#else
        room_bgm_state_set(0, ROOM_106_MAIN_HALL, BGM_RELOAD | 1);
        item_aot_set(AOT_06_ITEM, 0, 0, 16, 16, IT_31_KEY_LOCKPICK, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_09, 65, 0, 0);
        enemy(EM_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 480, 0, 0, 5460, 0, 14767, ENEMY_00, 0, 0, 0);
        aot_reset(AOT_00_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 162, 255, 0);
        aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 162, 255, 0);
        aot_reset(AOT_02_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 162, 255, 0);
        aot_reset(AOT_05_ITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 174, 255, 0);
        cut_auto(1);
        setb(B_CAMERA, CAM_06, 0);
#endif
        evt_exec(0, TASK_00, on_enter_3);
#if JILL
        set(FG_COMMON, F_COMMON_03, TRUE);
        set(FG_STATUS, F_STATUS_1D, TRUE);
#endif
    }
    if (ck(FG_COMMON, F_COMMON_00, TRUE) && ck(FG_COMMON, F_COMMON_02, FALSE))
    {
#if CHRIS
        enemy(EM_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 1920, 0, 0, 16000, 0, 9000, ENEMY_00_NPC_WESKER, 0, 0, 0);
        enemy(EM_21_NPC_JILL, 2, 255, 1, 2, 0, 0, 3328, 0, 0, 20000, 0, 11000, ENEMY_01_NPC_JILL, 0, 0, 0);
#else
        enemy(EM_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 3888, 0, 0, 19600, 0, 8500, ENEMY_00, 0, 0, 0);
#endif
        cut_auto(1);
        setb(B_CAMERA, CAM_06, 0);
        set(FG_COMMON, F_COMMON_01, TRUE);
        evt_exec(0, TASK_00, on_enter_2);
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_00, FALSE))
    {
        enemy(EM_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 2304, 0, 0, 18700, 0, 3000, ENEMY_00_NPC_WESKER, 0, 0, 0);
        enemy(EM_21_NPC_JILL, 2, 255, 1, 2, 0, 0, 1300, 0, 0, 20800, 0, 8500, ENEMY_01_NPC_JILL, 18, 0, 0);
        dir_set(0, 0, 0, 0, 14600, 0, 5000);
        set(FG_COMMON, F_COMMON_00, TRUE);
        evt_exec(0, TASK_00, on_enter);
        set(FG_STATUS, F_STATUS_1D, TRUE);
        set(FG_COMMON, F_COMMON_A7, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_A0, TRUE))
    {
        if (ck(FG_COMMON, F_COMMON_A1, FALSE))
        {
            set(FG_COMMON, F_COMMON_A1, TRUE);
            room_bgm_state_set(0, ROOM_104_TEA_ROOM, BGM_MAIN_ON | 2);
            room_bgm_state_set(0, ROOM_10F_BAR, BGM_RELOAD | 1);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_5F, TRUE))
    {
        set(FG_COMMON, F_COMMON_5E, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_00, FALSE))
    {
        enemy(EM_24_NPC_WESKER, 0, 255, 1, 2, 0, 0, 3072, 0, 0, 17000, 0, 2500, ENEMY_00, 0, 0, 0);
        enemy(EM_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 2816, 0, 0, 15500, 0, 2500, ENEMY_01_NPC_BARRY, 0, 0, 0);
        dir_set(0, 0, 3200, 0, 18500, 0, 2500);
        set(FG_COMMON, F_COMMON_00, TRUE);
        evt_exec(0, TASK_00, on_enter);
        set(FG_STATUS, F_STATUS_1D, TRUE);
        set(FG_COMMON, F_COMMON_AA, TRUE);
    }
#endif
}

proc main
{
#if CHRIS
    if (cmpb(B_CHARACTER_MODEL, CMP_NE, 3))
    {
        if (ck(FG_ROOM, F_ROOM_01, FALSE))
        {
            if (cmpb(B_FWD_AOT, CMP_EQ, 4))
            {
                if (ck(FG_COMMON, F_COMMON_04, FALSE))
                {
                    set(FG_COMMON, F_COMMON_04, TRUE);
                    set(FG_ROOM, F_ROOM_01, TRUE);
                    evt_exec(0, TASK_07, from_main_2);
                    set(FG_ROOM, F_ROOM_01, FALSE);
                }
                else
                {
                    set(FG_ROOM, F_ROOM_02, TRUE);
                }
            }
            if (ck(FG_ROOM, F_ROOM_02, TRUE))
            {
                set(FG_ROOM, F_ROOM_02, FALSE);
                set(FG_ROOM, F_ROOM_01, TRUE);
                message(MSG_IT_IS_TOO_DANGEROUS_TO_GO | MSG_FAST, MSG_PAUSE_0080 | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "It's too dangerous to go outside!"
                set(FG_ROOM, F_ROOM_01, FALSE);
            }
        }
    }
    if (testpickup(IT_02_WEAPON_HANDGUN))
    {
        set(FG_ROOM, F_ROOM_03, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_08, FALSE) && ck(FG_ITEM, F_ITEM_34, FALSE))
    {
        set(FG_COMMON, F_COMMON_08, TRUE);
        aot_reset(AOT_05_ITEM, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    }
    return;
    if (testpickup(IT_54_UNKNOWN_54))
    {
        evt_exec(0, TASK_09, from_main);
    }
    if (ck(FG_ROOM, F_ROOM_00, TRUE))
    {
        evt_exec(0, TASK_09, from_main_3);
        set(FG_ROOM, F_ROOM_00, FALSE);
    }
#else
    if (ck(FG_COMMON, F_COMMON_03, TRUE) && ck(FG_COMMON, F_COMMON_05, FALSE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03) && ck(FG_ROOM, F_ROOM_14, FALSE))
        {
            set(FG_ROOM, F_ROOM_07, TRUE);
            set(FG_ROOM, F_ROOM_14, TRUE);
            evt_exec(0, TASK_03, from_main);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_04) && ck(FG_ROOM, F_ROOM_14, FALSE))
        {
            set(FG_ROOM, F_ROOM_07, TRUE);
            set(FG_ROOM, F_ROOM_14, TRUE);
            evt_exec(0, TASK_03, from_main);
        }
        if (ck(FG_ROOM, F_ROOM_07, TRUE) && ck(FG_ROOM, F_ROOM_08, FALSE))
        {
            if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
            {
                set(FG_ROOM, F_ROOM_08, TRUE);
                set(FG_COMMON, F_COMMON_05, TRUE);
                set(FG_ROOM, F_ROOM_09, TRUE);
                set(FG_ROOM, F_ROOM_0A, TRUE);
                pos_set(ENEMY_00, 0, 1709, 0, 25524, 0, 6371);
                evt_exec(0, TASK_00, from_main_2);
            }
            if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
            {
                set(FG_ROOM, F_ROOM_08, TRUE);
                set(FG_COMMON, F_COMMON_05, TRUE);
                set(FG_ROOM, F_ROOM_09, TRUE);
                set(FG_ROOM, F_ROOM_0B, TRUE);
                pos_set(ENEMY_00, 0, 2488, 0, 8111, 0, 9567);
                evt_exec(0, TASK_00, from_main_5);
            }
        }
    }
    if (ck(FG_ROOM, F_ROOM_09, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_0A, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_0D, TRUE))
            {
                set(FG_ROOM, F_ROOM_0D, FALSE);
                evt_exec(0, TASK_00, from_main_10);
            }
            if (ck(FG_ROOM, F_ROOM_0E, TRUE))
            {
                set(FG_ROOM, F_ROOM_0E, FALSE);
                evt_exec(0, TASK_00, from_main_3);
            }
            if (ck(FG_ROOM, F_ROOM_0F, TRUE))
            {
                set(FG_ROOM, F_ROOM_0F, FALSE);
                evt_exec(0, TASK_00, from_main_11);
            }
            if (ck(FG_ROOM, F_ROOM_10, TRUE))
            {
                set(FG_ROOM, F_ROOM_10, FALSE);
                evt_exec(0, TASK_00, from_main_4);
            }
        }
        if (ck(FG_ROOM, F_ROOM_0B, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_0D, TRUE))
            {
                set(FG_ROOM, F_ROOM_0D, FALSE);
                evt_exec(0, TASK_00, from_main_10);
            }
            if (ck(FG_ROOM, F_ROOM_0E, TRUE))
            {
                set(FG_ROOM, F_ROOM_0E, FALSE);
                evt_exec(0, TASK_00, from_main_6);
            }
            if (ck(FG_ROOM, F_ROOM_0F, TRUE))
            {
                set(FG_ROOM, F_ROOM_0F, FALSE);
                evt_exec(0, TASK_00, from_main_11);
            }
            if (ck(FG_ROOM, F_ROOM_10, TRUE))
            {
                set(FG_ROOM, F_ROOM_10, FALSE);
                evt_exec(0, TASK_00, from_main_7);
            }
        }
        if (ck(FG_ROOM, F_ROOM_0C, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_0D, TRUE))
            {
                set(FG_ROOM, F_ROOM_0D, FALSE);
                evt_exec(0, TASK_00, from_main_10);
            }
            if (ck(FG_ROOM, F_ROOM_0E, TRUE))
            {
                set(FG_ROOM, F_ROOM_0E, FALSE);
                evt_exec(0, TASK_00, from_main_8);
            }
            if (ck(FG_ROOM, F_ROOM_0F, TRUE))
            {
                set(FG_ROOM, F_ROOM_0F, FALSE);
                evt_exec(0, TASK_00, from_main_11);
            }
            if (ck(FG_ROOM, F_ROOM_10, TRUE))
            {
                set(FG_ROOM, F_ROOM_10, FALSE);
                evt_exec(0, TASK_00, from_main_9);
            }
        }
    }
    if (ck(FG_ROOM, F_ROOM_01, FALSE))
    {
        if (cmpb(B_FWD_AOT, CMP_EQ, 4))
        {
            if (ck(FG_COMMON, F_COMMON_04, FALSE))
            {
                set(FG_COMMON, F_COMMON_04, TRUE);
                set(FG_ROOM, F_ROOM_01, TRUE);
                evt_exec(0, TASK_07, from_main_12);
                set(FG_ROOM, F_ROOM_01, FALSE);
            }
            else
            {
                set(FG_ROOM, F_ROOM_02, TRUE);
            }
        }
        if (ck(FG_ROOM, F_ROOM_02, TRUE))
        {
            set(FG_ROOM, F_ROOM_02, FALSE);
            set(FG_ROOM, F_ROOM_01, TRUE);
            message(MSG_IT_IS_TOO_DANGEROUS_TO_GO | MSG_FAST, MSG_PAUSE_0080 | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "It's too dangerous to go outside!"
            set(FG_ROOM, F_ROOM_01, FALSE);
        }
    }
    if (ck(FG_COMMON, F_COMMON_0B, FALSE) && ck(FG_ITEM, F_ITEM_34, FALSE))
    {
        set(FG_COMMON, F_COMMON_0B, TRUE);
        aot_reset(AOT_05_ITEM, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    }
#endif
}

event on_enter
{
    evt_next();
    evt_nop();
    set(FG_6, F_6_17, FALSE);
#if CHRIS
    evt_fork(TASK_01, on_enter_sub1, 0);
    evt_fork(TASK_02, on_enter_sub2, 0);
#else
    cut_auto(1);
#endif
    sleep(10);
    set(FG_STATUS, F_STATUS_0F, TRUE);
#if CHRIS
    sleep(50);
    cutnext(CAM_06);
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_JILL);
#else
    evt_work_set(WK_PLAYER, 0);
#endif
    evt_actor_begin();
#if CHRIS
    act_anim_flags(0 | 16, 32 | 2, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(8);
#else
    act_anim_seq(42002, 13393, 8225);
#endif
    act_reset();
#if CHRIS
    evt_nop();
    voice_play(VOICE_PLAY, VO_001_00, 0);
    message(MSG_VO_001_00, 0);
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_JILL);
#else
    evt_work_set(WK_ENEMY, ENEMY_00);
#endif
    evt_actor_begin();
