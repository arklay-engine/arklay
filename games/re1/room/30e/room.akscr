#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_30D 0x00
#define AOT_01_TYPEWRITER 0x01
#define AOT_02_ITEMBOX 0x02
#define AOT_03_ITEM_HEAL_HERB_BLUE_0 0x03
#define AOT_04_ITEM_HEAL_FIRST_AID_SPRAY_1 0x04
#define AOT_05_ITEM_INK_2 0x05
#define IMDL_00_HEAL_HERB_BLUE 0x00
#define IMDL_01_HEAL_FIRST_AID_SPRAY 0x01
#define IMDL_02_INK 0x02
#define OBJ_00_ITEMBOX 0x00                                 // Likely: the item box model (inside the item box spot).

proc init
{
    door_aot_set(AOT_00_DOOR_30D, 3700, 900, 1600, 1400, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30D_STRAIGHT_PASSAGE, 28600, 0, 6500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_TYPEWRITER, 3900, 4000, 1350, 1600, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_02_ITEMBOX, 1800, 9100, 2500, 1900, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 2, 0, 0, 0, 0, 0);
    item_aot_set(AOT_03_ITEM_HEAL_HERB_BLUE_0, 7584, 8338, 1800, 1800, IT_45_HEAL_HERB_BLUE, 1, IMDL_00_HEAL_HERB_BLUE, SCA_NONE, 8484, 0, 9238, 0, F_ITEM_30E_HEAL_HERB_BLUE_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_04_ITEM_HEAL_FIRST_AID_SPRAY_1, 5064, 5900, 1800, 1800, IT_41_HEAL_FIRST_AID_SPRAY, 1, IMDL_01_HEAL_FIRST_AID_SPRAY, SCA_NONE, 5964, -1200, 6800, 0, F_ITEM_30E_HEAL_FIRST_AID_SPRAY_1, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_STATUS, F_STATUS_REGION_JPN, FALSE) && ck(FG_STATUS, F_STATUS_REGION_EUR, FALSE))
    {
        item_aot_set(AOT_05_ITEM_INK_2, 3810, 5368, 1800, 1800, IT_2F_KEY_INK_RIBBON, 2, IMDL_02_INK, SCA_NONE, 4710, -1200, 6258, 0, F_ITEM_30E_INK_2, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_7);
    }
    else
    {
        item_aot_set(AOT_05_ITEM_INK_2, 3810, 5368, 1800, 1800, IT_2F_KEY_INK_RIBBON, 3, IMDL_02_INK, SCA_NONE, 4710, -1200, 6258, 0, F_ITEM_30E_INK_2, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_7);
    }
    obj(OBJ_00_ITEMBOX, OF_10 | OF_ACTIVE, SCA_NONE, 2900, -1440, 10800, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_ADDERS_IN_30D, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_ADDERS_IN_30D, TRUE);
    }
}
