                }
                else
                {
                    aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
                }
            }
        }
        else if (cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_04, TRUE);
        }
        if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_ROOM, F_ROOM_04, FALSE) && ck(FG_ROOM, F_ROOM_05, FALSE) && ck(FG_ROOM, F_ROOM_06, FALSE) && cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_05, TRUE);
            aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_5B, TRUE) && ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        if (ck(FG_ENEMY, F_ENEMY_70, TRUE) && ck(FG_ROOM, F_ROOM_03, FALSE))
        {
            set(FG_ROOM, F_ROOM_03, TRUE);
            set(FG_SCENARIO, F_SCENARIO_37, TRUE);
            aot_reset(AOT_03_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_03_message, 0);
        }
    }
#endif
    if (ck(FG_ENEMY, F_ENEMY_70, TRUE) && ck(FG_ROOM, F_ROOM_08, FALSE))
    {
        set(FG_ROOM, F_ROOM_08, TRUE);
#if CHRIS
        evt_exec(0, 5, from_main_4);
#else
        evt_exec(0, 5, from_main_3);
#endif
    }
    if (ck(FG_STATUS, F_STATUS_1A, TRUE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, 0))
        {
            evt_exec(0, 7, on_enter);
        }
        if (cmpb(B_CAMERA, CMP_EQ, 1))
        {
#if CHRIS
            evt_exec(0, 7, from_main);
#else
            evt_exec(0, 7, on_enter_2);
#endif
        }
        if (cmpb(B_CAMERA, CMP_EQ, 2))
        {
#if CHRIS
            evt_exec(0, 7, on_enter_2);
#else
            evt_exec(0, 7, on_enter_3);
#endif
        }
        if (cmpb(B_CAMERA, CMP_EQ, 3))
        {
#if CHRIS
            evt_exec(0, 7, from_main_2);
#else
            evt_exec(0, 7, from_main);
#endif
        }
        if (cmpb(B_CAMERA, CMP_EQ, 4))
        {
#if CHRIS
            evt_exec(0, 7, from_main_3);
#else
            evt_exec(0, 7, from_main_2);
#endif
