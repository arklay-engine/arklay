            enemy(EM_0C_TYRANT_1, EB_41, F_ENEMY_70, SPAWN_FORCE, 2, 0, 3072, 0, 10700, 0, 7000, ENEMY_01_TYRANT_1, ANIM_00, 0, EVAR_00);
            eml_state(0, ENEMY_00, EML_ACTION, AB_0B);
