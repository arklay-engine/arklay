proc main
{
#if CHRIS
    if (ck(FG_ITEM, F_ITEM_5F, FALSE) && ck(FG_ROOM, F_ROOM_02, FALSE))
    {
        set(FG_ROOM, F_ROOM_02, TRUE);
        objtbl_b_set(TBL_OBJ, OBJ_06, 0);
    }
    if (ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        if (ck(FG_ENEMY, F_ENEMY_70, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_03, FALSE))
            {
                set(FG_ROOM, F_ROOM_03, TRUE);
                set(FG_SCENARIO, F_SCENARIO_37, TRUE);
                aot_reset(AOT_00_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 159, 255, 0);
                if (ck(FG_ROOM, F_ROOM_04, FALSE))
                {
                    aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message, 0);
                }
                else
                {
                    aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
                }
            }
        }
        else if (cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_04, TRUE);
        }
        if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_ROOM, F_ROOM_04, FALSE) && ck(FG_ROOM, F_ROOM_05, FALSE) && ck(FG_ROOM, F_ROOM_06, FALSE) && cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_05, TRUE);
            aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_5B, FALSE))
    {
        if (ck(FG_ITEM, F_ITEM_5F, FALSE) && ck(FG_ROOM, F_ROOM_02, FALSE))
        {
            set(FG_ROOM, F_ROOM_02, TRUE);
            objtbl_b_set(TBL_OBJ, OBJ_06, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_5B, FALSE) && ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        if (ck(FG_ENEMY, F_ENEMY_70, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_03, FALSE))
            {
                set(FG_ROOM, F_ROOM_03, TRUE);
                set(FG_SCENARIO, F_SCENARIO_37, TRUE);
                aot_reset(AOT_00_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 159, 255, 0);
                if (ck(FG_ROOM, F_ROOM_04, FALSE))
                {
                    aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message, 0);
                }
                else
                {
                    aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
                }
            }
        }
        else if (cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_04, TRUE);
        }
        if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_ROOM, F_ROOM_04, FALSE) && ck(FG_ROOM, F_ROOM_05, FALSE) && ck(FG_ROOM, F_ROOM_06, FALSE) && cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_05, TRUE);
            aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_5B, TRUE) && ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        if (ck(FG_ENEMY, F_ENEMY_70, TRUE) && ck(FG_ROOM, F_ROOM_03, FALSE))
        {
            set(FG_ROOM, F_ROOM_03, TRUE);
            set(FG_SCENARIO, F_SCENARIO_37, TRUE);
            aot_reset(AOT_03_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_03_message, 0);
        }
    }
#endif
    if (ck(FG_ENEMY, F_ENEMY_70, TRUE) && ck(FG_ROOM, F_ROOM_08, FALSE))
    {
        set(FG_ROOM, F_ROOM_08, TRUE);
#if CHRIS
        evt_exec(0, TASK_05, from_main_4);
#else
        evt_exec(0, TASK_05, from_main_3);
#endif
    }
    if (ck(FG_STATUS, F_STATUS_1A, TRUE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
        {
            evt_exec(0, TASK_07, on_enter);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
        {
#if CHRIS
            evt_exec(0, TASK_07, from_main);
#else
            evt_exec(0, TASK_07, on_enter_2);
#endif
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
        {
#if CHRIS
            evt_exec(0, TASK_07, on_enter_2);
#else
            evt_exec(0, TASK_07, on_enter_3);
#endif
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
        {
#if CHRIS
            evt_exec(0, TASK_07, from_main_2);
#else
            evt_exec(0, TASK_07, from_main);
#endif
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
        {
#if CHRIS
            evt_exec(0, TASK_07, from_main_3);
#else
            evt_exec(0, TASK_07, from_main_2);
#endif
        }
    }
    if (ck(FG_ROOM, F_ROOM_09, FALSE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
        {
            set(FG_ROOM, F_ROOM_24, TRUE);
        }
    }
    else
    {
        return;
    }
    if (ck(FG_ROOM, F_ROOM_0A, TRUE))
    {
        set(FG_ROOM, F_ROOM_0A, FALSE);
        se_play_3d(SND_BANK_ROOM, SE_17_BUBBLE_S, 0, SND_AT_POINT, 0, 11200, 4800);
    }
    if (cmpw(0, W_RANDOM, CMP_LT, 15) && ck(FG_ROOM, F_ROOM_24, TRUE))
    {
        set(FG_ROOM, F_ROOM_24, FALSE);
        effect(FX_25, FX_ROW_00, FX_AT_WORLD, 10975, -4650, 4635, 0);
    }
    if (cmpw(0, W_RANDOM, CMP_LT, 30) && ck(FG_ROOM, F_ROOM_24, TRUE))
    {
        set(FG_ROOM, F_ROOM_24, FALSE);
        effect(FX_25, FX_ROW_01, FX_AT_WORLD, 10990, -4650, 4646, 0);
        effect(FX_25, FX_ROW_00, FX_AT_WORLD, 10990, -4750, 4646, 0);
        effect(FX_25, FX_ROW_00, FX_AT_WORLD, 10975, -4700, 4635, 0);
        se_play_3d(SND_BANK_ROOM, SE_17_BUBBLE_S, 0, SND_AT_POINT, 0, 10990, 4646);
    }
