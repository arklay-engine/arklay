        {
            objtbl_b_set(TBL_OBJ, OBJ_06, OF_ACTIVE);
            objtbl_b_set(TBL_ITEM, IMDL_00, OF_ACTIVE);
        }
        else
        {
            objtbl_b_set(TBL_OBJ, OBJ_06, 0);
            objtbl_b_set(TBL_ITEM, IMDL_00, 0);
        }
    }
    else
    {
        objtbl_b_set(TBL_OBJ, OBJ_06, 0);
        objtbl_b_set(TBL_ITEM, IMDL_00, 0);
    }
    if (ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_5B, FALSE))
        {
            enemy(EM_2E_NPC_WESKER_2, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 565, 0, 7340, 0, 10250, ENEMY_00, ANIM_32, 14, EVAR_00);
            enemy(EM_0C_TYRANT_1, EB_40, F_ENEMY_70, SPAWN_FORCE, 2, 0, 3072, 0, 10700, 0, 7000, ENEMY_01_TYRANT_1, ANIM_00, 0, EVAR_00);
            eml_state(0, ENEMY_00, EML_ACTION, AB_0B);
