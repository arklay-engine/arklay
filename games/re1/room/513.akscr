#if CHRIS
event on_enter_4
#else
event on_enter_5
#endif
{
    evt_next();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_NPC_WESKER_2, 0, 192, 64);
#else
    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00, 0, 192, 64);
#endif
    act_reset();
    evt_nop();
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_WESKER_2);
#else
    evt_work_set(WK_ENEMY, ENEMY_00);
#endif
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 192, 64);
    act_reset();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(10);
    set(FG_STATUS, F_STATUS_0F, TRUE);
    sleep(10);
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_WESKER_2);
#else
    evt_work_set(WK_ENEMY, ENEMY_00);
#endif
    evt_actor_begin();
    act_anim_flags(ANIM_34, F_ROOM_21, 0);
    sleep(5);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 9646, 6370, F_ROOM_20);
    act_nop();
    act_reset();
    evt_nop();
    sleep(3);
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_WESKER_2);
#else
    evt_work_set(WK_ENEMY, ENEMY_00);
#endif
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_motion(MOTION_10);
    act_anim_flags(ANIM_2B, F_ROOM_20, 0);
    act_flag_op(EF_OR, EF_0002);
    sleep(30);
    act_reset();
    evt_nop();
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_WESKER_2);
#else
    evt_work_set(WK_ENEMY, ENEMY_00);
#endif
    evt_actor_begin();
    act_anim_flags(ANIM_34, F_ROOM_21, 0);
    sleep(8);
    act_idle();
    act_reset();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2B, F_ROOM_20, 0);
    act_flag_op(EF_OR, EF_0080 | EF_0001);
    sleep(10);
    act_reset();
    evt_nop();
#if CHRIS
    cutnext(CAM_05);
    evt_fork(TASK_07, on_enter_4_sub1, 0);
#else
    evt_fork(TASK_07, on_enter_5_sub1, 0);
#endif
    evt_next();
    evt_nop();
    run
