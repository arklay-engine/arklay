        eml_rot(IMDL_00, 2048, 0);
        eml_rot(ROT_OBJ | OBJ_06, 2048, 0);
        if (ck(FG_ROOM, F_ROOM_07, FALSE))
        {
            objtbl_b_set(TBL_OBJ, OBJ_06, 0);
            objtbl_b_set(TBL_ITEM, IMDL_00, 0);
        }
        else if (ck(FG_ITEM, F_ITEM_5F, TRUE))
        {
            objtbl_b_set(TBL_OBJ, OBJ_06, OF_ACTIVE);
            objtbl_b_set(TBL_ITEM, IMDL_00, OF_ACTIVE);
        }
        else
        {
            objtbl_b_set(TBL_OBJ, OBJ_06, 0);
            objtbl_b_set(TBL_ITEM, IMDL_00, 0);
        }
    }
    if (ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        enemy(EM_2E_NPC_WESKER_2, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 565, 0, 7340, 0, 10250, ENEMY_00_NPC_WESKER_2, ANIM_32, 14, EVAR_00);
        enemy(EM_0C_TYRANT_1, EB_40, F_ENEMY_70, SPAWN_FORCE, 2, 0, 3072, 0, 10700, 0, 7000, ENEMY_01_TYRANT_1, ANIM_00, 0, EVAR_00);
        eml_state(0, ENEMY_00_NPC_WESKER_2, EML_ACTION, AB_0B);
        dir_set(0, 0, 613, 0, 8139, 0, 8994);
        sys_multi(SYS_UNEQUIP);
        plw_anim(PLW_00, ANIM_00, 0);
        cut_auto(CUT_LOCKED);
        setb(B_CAMERA, CAM_02, 0);
        evt_exec(0, TASK_07, on_enter_2);
        evt_exec(0, TASK_06, on_enter_3);
        evt_exec(0, TASK_00, on_enter_4);
