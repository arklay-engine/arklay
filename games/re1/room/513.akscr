        enemy(EM_2E_NPC_WESKER_2, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 1155, 0, 9627, 0, 8092, ENEMY_00_NPC_WESKER_2, ANIM_00, 0, EVAR_00);
        evt_exec(0, TASK_07, on_enter);
    }
