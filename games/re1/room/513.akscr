event on_aot_01_message
{
    message(MSG_IT_LOOKS_LIKE_THE_CONTROL_DEVICE_FOUND_A_DOOR_LOCK_SWITCH | MSG_FAST, 255); // "It looks like the control device for this room. Found a door lock switch. Unlock the door? It looks like the control device for this room. A door lock device. Unlock the door? It's electronically locked"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_reset(AOT_00_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
            aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 160, 255, 0);
            set(FG_ROOM, F_ROOM_06, TRUE);
            se_play_3d(2, 29, 0, SND_AT_POINT, 0, 7800, 5200);
        }
    }
    evt_finish();
}

event on_aot_01_message_2
{
    message(MSG_IT_LOOKS_LIKE_THE_CONTROL_DEVICE_A_DOOR_LOCK_DEVICE | MSG_FAST, 255); // "It looks like the control device for this room. A door lock device. Unlock the door? It's electronically locked"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_reset(AOT_00_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
            aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 160, 255, 0);
            set(FG_ROOM, F_ROOM_06, TRUE);
            se_play_3d(2, 29, 0, SND_AT_POINT, 0, 7800, 5200);
        }
    }
    evt_finish();
}

