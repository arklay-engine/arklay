    }
    eml_rot(IMDL_00, 2048, 0);
    eml_rot(ROT_OBJ | OBJ_06, 2048, 0);
    if (ck(FG_COMMON, F_COMMON_5B, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_07, FALSE))
        {
            objtbl_b_set(TBL_OBJ, OBJ_06, 0);
            objtbl_b_set(TBL_ITEM, IMDL_00, 0);
