proc main
{
#if CHRIS
    if (ck(FG_ITEM, F_ITEM_5F, FALSE) && ck(FG_ROOM, F_ROOM_02, FALSE))
    {
        set(FG_ROOM, F_ROOM_02, TRUE);
        objtbl_b_set(0, 6, 0);
    }
    if (ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        if (ck(FG_ENEMY, F_ENEMY_70, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_03, FALSE))
            {
                set(FG_ROOM, F_ROOM_03, TRUE);
                set(FG_SCENARIO, F_SCENARIO_37, TRUE);
                aot_reset(AOT_00_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 159, 255, 0);
                if (ck(FG_ROOM, F_ROOM_04, FALSE))
                {
                    aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message, 0);
                }
                else
                {
                    aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
                }
            }
        }
        else if (cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_04, TRUE);
        }
        if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_ROOM, F_ROOM_04, FALSE) && ck(FG_ROOM, F_ROOM_05, FALSE) && ck(FG_ROOM, F_ROOM_06, FALSE) && cmpb(B_FWD_AOT, CMP_EQ, 1))
        {
            set(FG_ROOM, F_ROOM_05, TRUE);
            aot_reset(AOT_01_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_message_2, 0);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_5B, FALSE))
    {
        if (ck(FG_ITEM, F_ITEM_5F, FALSE) && ck(FG_ROOM, F_ROOM_02, FALSE))
        {
            set(FG_ROOM, F_ROOM_02, TRUE);
            objtbl_b_set(0, 6, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_5B, FALSE) && ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        if (ck(FG_ENEMY, F_ENEMY_70, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_03, FALSE))
            {
