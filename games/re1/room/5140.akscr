#version 1

proc init
{
    door_aot_set(0, 2400, 700, 2400, 1700, 10, 12, 13, 64, 0, RDT_013, 4700, 0, 25500, 1024, UNLOCKED, 129);
    door_aot_set(1, 13500, 8500, 1800, 2900, 0, 13, 19, 64, 0, RDT_015, 0, 0, 0, 0, UNLOCKED, 129);
    if (ck(FG_SCENARIO, 55, 1))
    {
        room_bgm_state_set(4, 20, 64);
        enemy(ENEMY_WESKER_STARS_, 2, 255, 1, 2, 0, 0, 3072, 0, 0, 2950, 0, 3000, 0, 50, 0, 0);
        if (ck(FG_COMMON, 192, 1))
        {
            enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 2048, 0, 0, 13480, 0, 11000, 1, 0, 0, 0);
        }
        evt_exec(0, 9, event_00);
    }
    if (ck(FG_SCENARIO, 55, 0) && ck(FG_COMMON, 192, 1) && ck(FG_COMMON, 76, 1))
    {
        enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 1904, 0, 0, 12590, 0, 11000, 0, 0, 0, 0);
        eml_state(0, 0, 3, 258);
        set(FG_COMMON, 76, 0);
        room_bgm_state_set(4, 20, 255);
        evt_exec(0, 9, event_03);
    }
}

event event_00
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        if (ck(FG_COMMON, 192, 1))
        {
            evt_exec(0, 9, event_01);
        }
        else
        {
            evt_exec(0, 9, event_02);
        }
    }
    evt_finish();
}

