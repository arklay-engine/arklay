  <strings>
    <language lang="en-US">
      <string key="name">ROOM 003 BATHROOM</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">{scroll 2}Dust collects inside.\nThe bath towel is dirty.{scroll 2}</string>
      <string key="1">{scroll 2}Nothing major about this\nwashstand.{scroll 2}</string>
      <string key="2">{scroll 2}\nNothing special.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 2}  中にはほこりがつもっている\n  バスタオルもよごれている{scroll 2}</string>
      <string key="1">{scroll 2}\n   この洗面台には何もない{scroll 2}</string>
      <string key="2">{scroll 2}\n     何もないようだ{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Poste de garde RdC</string>
      <string key="0">{scroll 2}Un lanceur peut être chargé\navec diverses cartouches.{scroll 2}</string>
      <string key="1">{scroll 2}Rien d'important au sujet de\nce lavabo.{scroll 2}</string>
      <string key="2">{scroll 2}\nRien de spécial.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Da sammelt sich der Staub.\nDas Handtuch ist schmutzig.{scroll 2}</string>
      <string key="1">{scroll 2}Über dieses Waschbecken\ngibt es nichts mehr zu sagen.{scroll 2}</string>
      <string key="2">{scroll 2}\nNichts Besonderes.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Guardiola 1P</string>
      <string key="0">{scroll 2}La polvere si è accumulata \nall'interno.{clear 0}{scroll 2}\nL'asciugamano è sporco.{scroll 2}</string>
      <string key="1">{scroll 2}Nulla di importante \nnel lavandino.{scroll 2}</string>
      <string key="2">{scroll 2}\nNiente di speciale.{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}El polvo se acumula dentro...\nLa toalla está sucia.{scroll 2}</string>
      <string key="1">{scroll 2}No hay nada especial\nen el lavabo...{scroll 2}</string>
      <string key="2">{scroll 2}\nNada especial...{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната охраны 1-эт.</string>
      <string key="0">{scroll 2}Очень пыльно.\nПолотенце грязное.{scroll 2}</string>
      <string key="1">{scroll 2}Раковина пуста.{scroll 2}</string>
      <string key="2">{scroll 2}\nНичего особенного.{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Asuntolan varasto 1 krs</string>
      <string key="0">{scroll 2}Sisälle on kerääntynyt pölyä...\nSuihkupyyhe on likainen...{scroll 2}</string>
      <string key="1">{scroll 2}Pesualtaassa ei ole mitään\nmerkityksellistä...{scroll 2}</string>
      <string key="2">{scroll 2}Ei mitään erityistä...{scroll 2}</string>
