event barry_gunshot
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        aot_delete(AOT_03_EVENT_GUNSHOT, SCE_NONE, 0);
    }
    sleep(10);
    run
    {
        bgm_stop(BGM_SUB_1);
        se_play_3d(SND_BANK_ROOM, SE_1A_MAGNUM, 0, SND_AT_POINT, 0, 11850, 26300);
    }
    sleep(5);
    run
    {
        bgm_play(BGM_SUB_2);
        aot_reset(AOT_01_DOOR_309_N, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, follow_gunshot, 0);
    }
    sleep(20);
    run
    {
        voice_play(VOICE_PLAY, VO_10E_08);
        message(MSG_VO_10E_08, 0);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 400, 0, 1, 60, 0);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event flamethrower_taken_or_north_door_with_barry
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        run
        {
            se_play_3d(SND_BANK_ROOM, SE_17_HOOKMIX, 0, SND_AT_POINT, 0, 2200, 16700);
            se_play_3d(SND_BANK_ROOM, SE_18_LOCKOUTA, 0, SND_AT_POINT, 0, 2200, 16700);
        }
        sleep(5);
        evt_work_set(WK_OBJ, OBJ_00_FLAMETHROWER_HOOK);
        evt_tween_begin_alt();
        evt_next();
        tw_nop();
        tw_set_pos(0, -2, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -4, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -6, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -10, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -13, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -18, 0);
        for (4)
        {
            tw_pos_add();
            evt_next();
        }
        tw_nop();
        tw_set_pos(0, -13, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -10, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -6, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -4, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -2, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 8, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 4, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -4, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -2, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -2, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 2, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -1, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, -1, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
        aot_delete(AOT_04_EVENT_FLAMETHROWER_HOOK, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        run
        {
            set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_NORTH_DOOR, TRUE);
            aot_on(AOT_01_DOOR_309_N, SCE_DOOR, 0);
        }
    }
    evt_finish();
}

