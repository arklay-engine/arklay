#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_307 0x00
#define AOT_01_DOOR_309_N 0x01
#define AOT_02_DOOR_309_S 0x02
#define AOT_03_EVENT_GUNSHOT 0x03                           // Set after Barry goes on alone: Jill hears his magnum.
#define AOT_03_ITEM_WEAPON_FLAMETHROWER_0 0x03
#define AOT_04_EVENT_FLAMETHROWER_HOOK 0x04                 // Likely: becomes an event once the flamethrower is taken.
#define CAM_04_BARRY_LEAVES 0x04                            // Likely.
#define ENEMY_00_BARRY 0x00
#define ENEMY_00_HUNTER 0x00
#define ENEMY_01_HUNTER 0x01
#define F_ROOM_J_ANIM_DONE 0x20                             // Jill's or Barry's animation finished (one frame); nothing waits for it.
#define F_ROOM_J_BARRY_ANIM_DONE 0x23                       // Barry's walk finished (one frame); nothing waits for it.
#define IMDL_00_WEAPON_FLAMETHROWER 0x00
#define MSG_DO_YOU_WANT_HIM_TO_GO 0x18
#define MSG_VO_00D_02 0x1A
#define MSG_VO_10E_00 0x00
#define MSG_VO_10E_01 0x04
#define MSG_VO_10E_02 0x06
#define MSG_VO_10E_03 0x08
#define MSG_VO_10E_04 0x0B
#define MSG_VO_10E_05 0x0D
#define MSG_VO_10E_06 0x11
#define MSG_VO_10E_07 0x14
#define MSG_VO_10E_08 0x1B
#define MSG_WILL_YOU_GO_WITH_HIM 0x17
#define MSG_WILL_YOU_STAY_HERE 0x19
#define OBJ_00_FLAMETHROWER_HOOK 0x00
#define SE_17_HOOKMIX 0x17
#define SE_18_LOCKOUTA 0x18
#define SE_19_LOCKOUTB 0x19
#define SE_1A_MAGNUM 0x1A
#define VO_00D_02 0x02
#define VO_10E_00 0x16
#define VO_10E_01 0x17
#define VO_10E_02 0x18
#define VO_10E_03 0x19
#define VO_10E_04 0x1A
#define VO_10E_05 0x1B
#define VO_10E_06 0x1C
#define VO_10E_07 0x1D
#define VO_10E_08 0x31

proc init
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        door_aot_set(AOT_00_DOOR_307, 200, 15900, 2100, 1500, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | F_LOCK_307_308, ROOM_307_LADDER_PASSAGE, 13700, 0, 4200, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        door_aot_set(AOT_00_DOOR_307, 200, 15900, 2100, 1500, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_307_LADDER_PASSAGE, 13700, 0, 4200, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    door_aot_set(AOT_01_DOOR_309_N, 12800, 26400, 2100, 1700, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_309_DARKNESS_PASSAGE, 4100, 0, 26800, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_309_S, 11100, 2800, 2100, 1500, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_309_DARKNESS_PASSAGE, 2800, 0, 4400, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        item_aot_set(AOT_03_ITEM_WEAPON_FLAMETHROWER_0, 5060, 18000, 1400, 2000, IT_06_WEAPON_FLAMETHROWER, 240, IMDL_00_WEAPON_FLAMETHROWER, SCA_NONE, 5060, -1860, 19590, 1024, F_ITEM_308_WEAPON_FLAMETHROWER_0, SAT_MANUAL | SAT_PLAYER, 0);
        swap_var(XFER_RESTORE, AOT_03_ITEM_WEAPON_FLAMETHROWER_0, B_0E);
        obj(OBJ_00_FLAMETHROWER_HOOK, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 4910, -1740, 19790, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
        aot_set(AOT_04_EVENT_FLAMETHROWER_HOOK, 5060, 18000, 1400, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, flamethrower_hook_or_barry_follows, 0, 0, 0);
        if (ck(FG_ITEM, F_ITEM_308_WEAPON_FLAMETHROWER_0, FALSE))
        {
            evt_exec(0, TASK_09, hook_raised);
            aot_delete(AOT_04_EVENT_FLAMETHROWER_HOOK, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            set(FG_LOCK, F_LOCK_307_308, FALSE);
        }
        else
        {
            set(FG_LOCK, F_LOCK_307_308, TRUE);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_BARRY_MET_IN_CAVES, FALSE) && ck(FG_COMMON, F_COMMON_J_BARRY_RESCUED_FROM_PIT, TRUE))
        {
            dir_set(0, 0, 3920, 0, 2800, 0, 16300);
            enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3984, 0, 5224, 0, 17102, ENEMY_00_BARRY, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_09, barry_greets_jill);
            aot_reset(AOT_01_DOOR_309_N, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, flamethrower_taken_or_north_door_with_barry, 0);
        }
        if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE) && ck(FG_COMMON, F_COMMON_ENRICO_SHOT, FALSE) && ck(FG_COMMON, F_COMMON_J_BARRY_MET_IN_CAVES, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_NORTH_DOOR, TRUE))
            {
                enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1288, 0, 12140, 0, 28590, ENEMY_00_BARRY, ANIM_00, 0, EVAR_00);
                set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWS_NORTH_DOOR, FALSE);
            }
            else
            {
                enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3288, 0, 8690, 0, 3250, ENEMY_00_BARRY, ANIM_00, 0, EVAR_00);
            }
            evt_exec(0, TASK_09, flamethrower_hook_or_barry_follows);
            aot_reset(AOT_00_DOOR_307, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, barry_cold_feet, 0);
            aot_reset(AOT_01_DOOR_309_N, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, flamethrower_taken_or_north_door_with_barry, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_ENRICO_SHOT, TRUE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_308_HUNTER_0, SPAWN_FORCE, 2, 0, 0, 0, 5900, 0, 16500, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_308_HUNTER_0, SPAWN_FORCE, 2, 0, 0, 0, 5900, 0, 16500, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            set(FG_COMMON, F_COMMON_J_BACK_IN_308_AFTER_ENRICO, TRUE);
        }
    }
    if (ck(FG_ENEMY, F_ENEMY_308_HUNTER_0, TRUE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_308_HUNTER_0_2, SPAWN_FORCE, 2, 0, 1024, 0, 9800, 0, 13200, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_06_HUNTER, EB_00, F_ENEMY_308_HUNTER_0_2, SPAWN_FORCE, 2, 0, 1024, 0, 9800, 0, 13200, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        enemy(EM_06_HUNTER, EB_00, F_ENEMY_308_HUNTER_1, SPAWN_FORCE, 2, 0, 3072, 0, 9800, 0, 19600, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
    }
}

proc main
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (testpickup(IT_06_WEAPON_FLAMETHROWER))
        {
            set(FG_LOCK, F_LOCK_307_308, FALSE);
            evt_exec(0, TASK_09, flamethrower_taken_or_north_door_with_barry);
        }
        if (testitem(IT_06_WEAPON_FLAMETHROWER))
        {
            set(FG_ITEM, F_ITEM_308_WEAPON_FLAMETHROWER_0, TRUE);
            setbyte(0, 1, 0);
            evt_exec(0, TASK_09, place_flamethrower);
            evt_exec(0, TASK_09, place_flamethrower_model);
        }
    }
}
event barry_greets_jill
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_COMMON, F_COMMON_J_BARRY_MET_IN_CAVES, TRUE);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_J_ANIM_DONE, AFL_02 | AFL_01);
    act_param_set(0, 2048);
    act_flag_op(EF_SET, EF_0002);
    act_reset();
    evt_nop();
    sleep(21);
    evt_chain(barry_asks_to_team_up);
    evt_finish();
}

event barry_asks_to_team_up
{
    voice_play(VOICE_PLAY, VO_10E_00);
    sleep(15);
    evt_fork(TASK_09, jill_talk_gesture, 0);
    evt_fork(TASK_09, barry_asks_anim_1, 0);
    message(MSG_VO_10E_00, 0);
    sleep(100);
    message(1, 0);
    evt_fork(TASK_09, barry_asks_anim_2, 0);
    sleep(110);
    message(2, 0);
    evt_fork(TASK_09, barry_asks_anim_3, 0);
    sleep(65);
    message(3, 0);
    evt_fork(TASK_09, barry_asks_anim_4, 0);
    wait_message();
    run
    {
        bgm_play(BGM_SUB_1);
    }
    message(MSG_WILL_YOU_GO_WITH_HIM, 0); // "Will you go with him? Do you want him to go first? Will you stay here?"
    evt_fork(TASK_09, barry_waits_for_answer, 0);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, team_up);
        }
        else
        {
            evt_exec(0, TASK_09, refuse_team_up);
        }
    }
    evt_finish();
}

event team_up
{
    voice_play(VOICE_PLAY, VO_10E_01);
    sleep(15);
    evt_fork(TASK_09, team_up_anim_1, 0);
    message(MSG_VO_10E_01, 0);
    sleep(60);
    message(5, 0);
    evt_fork(TASK_09, team_up_anim_2, 0);
    sleep(30);
    evt_fork(TASK_09, team_up_anim_3, 0);
    evt_fork(TASK_09, jill_talk_gesture, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_10E_02);
    evt_fork(TASK_09, team_up_anim_4, 0);
    sleep(15);
    message(MSG_VO_10E_02, 0);
    sleep(65);
    message(7, 0);
    evt_fork(TASK_09, team_up_anim_5, 0);
    wait_message();
    message(MSG_DO_YOU_WANT_HIM_TO_GO, 0); // "Do you want him to go first? Will you stay here?"
    evt_fork(TASK_09, barry_waits_for_answer, 0);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, barry_goes_first);
        }
        else
        {
            evt_exec(0, TASK_09, go_on_together);
        }
    }
    evt_finish();
}

event barry_goes_first
{
    voice_play(VOICE_PLAY, VO_10E_03);
    sleep(15);
    message(MSG_VO_10E_03, 0);
    evt_fork(TASK_09, barry_goes_first_anim_1, 0);
    sleep(85);
    message(9, 0);
    evt_fork(TASK_09, barry_goes_first_anim_2, 0);
    sleep(40);
    message(10, 0);
    evt_fork(TASK_09, barry_goes_first_anim_3, 0);
    wait_message();
    evt_fork(TASK_09, barry_goes_first_walk_off, 0);
    sleep(100);
    pos_set(ENEMY_00_BARRY, 0, 0, 0, 30000, 30000, 30000);
    run
    {
        aot_set(AOT_03_EVENT_GUNSHOT, 5700, 13800, 1500, 5700, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, barry_gunshot, 0, 0, 0);
    }
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, FALSE);
        set(FG_COMMON, F_COMMON_J_BARRY_309_HUNTER_SCENE, FALSE);
        set(FG_COMMON, F_COMMON_J_RAN_AFTER_GUNSHOT, FALSE);
        set(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE);
        set(FG_COMMON, F_COMMON_J_BARRY_WENT_AHEAD, TRUE);
        set(FG_COMMON, F_COMMON_J_WAITED_FOR_BARRY, FALSE);
    }
    evt_chain(barry_talk_end);
    evt_finish();
}

event go_on_together
{
    voice_play(VOICE_PLAY, VO_10E_04);
    sleep(15);
    evt_fork(TASK_09, go_on_together_anim_1, 0);
    message(MSG_VO_10E_04, 0);
    sleep(70);
    evt_fork(TASK_09, go_on_together_anim_2, 0);
    message(12, 0);
    wait_message();
    run
    {
        eml_state(0, ENEMY_00_BARRY, EML_08);
        set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, TRUE);
        set(FG_COMMON, F_COMMON_J_BARRY_309_HUNTER_SCENE, TRUE);
        set(FG_COMMON, F_COMMON_J_RAN_AFTER_GUNSHOT, FALSE);
        set(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, TRUE);
        set(FG_COMMON, F_COMMON_J_BARRY_WENT_AHEAD, FALSE);
        set(FG_COMMON, F_COMMON_J_WAITED_FOR_BARRY, FALSE);
        aot_reset(AOT_00_DOOR_307, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, barry_cold_feet, 0);
    }
    evt_chain(barry_talk_end);
    evt_finish();
}

