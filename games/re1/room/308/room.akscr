event jill_waits_here
{
    voice_play(VOICE_PLAY, VO_10E_06);
    evt_fork(TASK_09, jill_waits_here_anim_1, 0);
    sleep(10);
    message(MSG_VO_10E_06, 0);
    sleep(45);
    message(18, 0);
    evt_fork(TASK_09, jill_waits_here_anim_2, 0);
    wait_message();
    cutnext(CAM_04_BARRY_LEAVES);
    evt_fork(TASK_09, barry_leaves_1, 0);
    sleep(50);
    evt_fork(TASK_09, barry_leaves_2, 0);
    sleep(50);
    evt_fork(TASK_09, barry_leaves_3, 0);
    sleep(40);
    evt_fork(TASK_09, barry_leaves_4, 0);
    sleep(30);
    evt_fork(TASK_09, barry_leaves_5, 0);
    sleep(10);
    cutcurr(0);
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, FALSE);
        set(FG_COMMON, F_COMMON_J_BARRY_309_HUNTER_SCENE, FALSE);
        set(FG_COMMON, F_COMMON_J_RAN_AFTER_GUNSHOT, FALSE);
        set(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, FALSE);
        set(FG_COMMON, F_COMMON_J_BARRY_WENT_AHEAD, FALSE);
        set(FG_COMMON, F_COMMON_J_WAITED_FOR_BARRY, TRUE);
    }
    evt_chain(barry_talk_end);
    evt_finish();
}

