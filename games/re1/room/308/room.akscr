    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 10, 0);
    for (5)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 5, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    for (4)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, -1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_next();
    evt_finish();
}

event flamethrower_hook_or_barry_follows
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        sleep(5);
    }
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            if (item_ck(IT_06_WEAPON_FLAMETHROWER))
            {
                swap_var(XFER_HELD, AOT_03_ITEM_WEAPON_FLAMETHROWER_0, B_0E);
                setb(B_SELECTED_ITEM, IT_06_WEAPON_FLAMETHROWER, 0);
                set(FG_STATUS, F_STATUS_MENU_KEY_DEPLETED, TRUE);
            }
        }
        else
        {
            eml_state(0, ENEMY_00_BARRY, EML_08);
        }
    }
    evt_finish();
}

event barry_cold_feet
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    sleep(30);
    run
    {
        voice_play(VOICE_PLAY, VO_00D_02);
        message(MSG_VO_00D_02, 0);
    }
    wait_message();
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event follow_gunshot
{
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_FOLLOWING, FALSE);
        set(FG_COMMON, F_COMMON_J_BARRY_309_HUNTER_SCENE, FALSE);
        set(FG_COMMON, F_COMMON_J_RAN_AFTER_GUNSHOT, TRUE);
        set(FG_COMMON, F_COMMON_J_WENT_ON_WITH_BARRY, TRUE);
        set(FG_COMMON, F_COMMON_J_BARRY_WENT_AHEAD, FALSE);
        set(FG_COMMON, F_COMMON_J_WAITED_FOR_BARRY, FALSE);
        aot_on(AOT_01_DOOR_309_N, SCE_DOOR, 0);
    }
    evt_finish();
}
