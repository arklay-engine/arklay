event barry_talk_end
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    sleep(30);
    set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    sleep(20);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

event jill_talk_gesture
{
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_05, F_ROOM_J_ANIM_DONE, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_06, F_ROOM_J_ANIM_DONE, AFL_02 | AFL_01);
    act_flag_op(EF_SET, EF_0010);
    act_reset();
    evt_nop();
    evt_finish();
}

