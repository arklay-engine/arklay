#define AOT_00_DOOR 0x00
#define AOT_01_USEITEM 0x01
#define AOT_02_USEITEM 0x02
#define AOT_03_EVENT 0x03
#define AOT_04_MESSAGE 0x04
#define AOT_05_MESSAGE 0x05
#define AOT_06_MESSAGE 0x06
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08
#define AOT_09_ITEM 0x09
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define FX_08 0x08
#define FX_09 0x09
#define F_ROOM_18 0x18
#define F_ROOM_19 0x19
#define F_ROOM_1A 0x1A
#define F_ROOM_1B 0x1B
#define F_ROOM_1C 0x1C
#define F_ROOM_1D 0x1D
#define F_ROOM_1E 0x1E
#define F_ROOM_1F 0x1F
#define F_ROOM_20 0x20
#define F_ROOM_21 0x21
#define F_ROOM_22 0x22
#define F_ROOM_24 0x24
#define IMDL_00 0x00
#define MSG_POISON_GAS_IS_ESCAPING 0x04
#define MSG_THERE_IS_A_SWITCH 0x00
#define OBJ_00 0x00
#define OBJ_01 0x01
#define OBJ_02 0x02
#define SE_17_MACHA 0x17
#define SE_18_SHUTER 0x18
#define SE_PL_02 0x02
#define SPR_03 0x03

proc init
{
    door_aot_set(AOT_00_DOOR, 16400, 5800, 2000, 3000, 12, DOOR_SND_01_DR_MTL, DOOR_09_DOOR09, 5, 0, ROOM_204_C_PASSAGE, 18600, 0, 11300, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_USEITEM, 4785, 6936, 700, 600, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 32, 0, 1, 0);
    aot_set(AOT_02_USEITEM, 13635, 6936, 700, 600, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 33, 0, 1, 0);
    aot_set(AOT_03_EVENT, 9235, 6736, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
    aot_set(AOT_04_MESSAGE, 1400, 6200, 2200, 2300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    aot_set(AOT_05_MESSAGE, 1000, 9300, 17400, 3300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    aot_set(AOT_06_MESSAGE, 1000, 2000, 18400, 3300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    aot_set(AOT_07_MESSAGE, 4385, 6736, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 13535, 6736, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    item_aot_set(AOT_09_ITEM, 1400, 6200, 2200, 2300, IT_2E_KEY_CREST_SUN, 1, IMDL_00, SCA_NONE, 2090, 0, 6590, 1024, F_ITEM_24, SAT_MANUAL | SAT_PLAYER, 0);
    obj(OBJ_00, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 2655, 0, 7220, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_01, OF_ACTIVE, SCA_NONE, 8795, 0, 7886, 2048, 0, 0, 0, 0, 450, 1980, 450, 450);
    obj(OBJ_02, OF_ACTIVE, SCA_NONE, 14035, 0, 6190, 0, 0, 0, 0, 0, 450, 1980, 450, 450);
    set(FG_STATUS, F_STATUS_1D, TRUE);
    set(FG_ROOM, F_ROOM_20, TRUE);
    set(FG_ROOM, F_ROOM_21, TRUE);
    aot_delete(AOT_09_ITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, TRUE) && ck(FG_COMMON, F_COMMON_63, TRUE))
    {
        set(FG_COMMON, F_COMMON_66, TRUE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_3A, TRUE))
    {
        set(FG_ROOM, F_ROOM_1B, TRUE);
        if (ck(FG_ITEM, F_ITEM_24, TRUE))
        {
            aot_delete(AOT_09_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        aot_delete(AOT_03_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_04_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        eml_pos(OBJ_00, 0, 0, 0, 0, 0, 0);
        eml_pos(OBJ_01, 0, 2048, 0, 4845, 0, 7236);
        eml_pos(OBJ_02, 0, 0, 0, 14035, 0, 7240);
        set(FG_ROOM, F_ROOM_1D, TRUE);
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_1B, TRUE) && ck(FG_ROOM, F_ROOM_1E, TRUE))
    {
        set(FG_ROOM, F_ROOM_1E, FALSE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_3A, FALSE) && cmpb(B_CAMERA, CMP_EQ, CAM_02))
    {
        bank_bit(1);
        bank_bit(2);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_02) && ck(FG_ROOM, F_ROOM_1E, FALSE))
    {
        bank_bit(3);
    }
    if (ck(FG_ROOM, F_ROOM_1C, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_20, TRUE) && ck(FG_ROOM, F_ROOM_21, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_1B, FALSE))
            {
                evt_exec(0, TASK_09, from_main);
            }
            if (ck(FG_ITEM, F_ITEM_24, TRUE))
            {
                aot_delete(AOT_04_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_09_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
            }
            set(FG_ROOM, F_ROOM_1D, TRUE);
        }
        else
        {
            evt_exec(0, TASK_09, from_main_2);
        }
        aot_delete(AOT_03_EVENT, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_1C, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_1D, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_20, TRUE) && ck(FG_ROOM, F_ROOM_21, TRUE))
        {
        }
        else
        {
            evt_exec(0, TASK_09, from_main_5);
            set(FG_ROOM, F_ROOM_1D, FALSE);
        }
    }
    if (ck(FG_ROOM, F_ROOM_20, TRUE))
    {
        aot_delete(AOT_07_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_18, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_21, TRUE))
    {
        aot_delete(AOT_08_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_19, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_1A, TRUE) && ck(FG_ROOM, F_ROOM_20, FALSE) && ck(FG_ROOM, F_ROOM_18, FALSE))
    {
        evt_exec(0, TASK_09, from_main_3);
        aot_delete(AOT_07_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_18, TRUE);
    }
    if (ck(FG_ROOM, F_ROOM_1A, TRUE) && ck(FG_ROOM, F_ROOM_21, FALSE) && ck(FG_ROOM, F_ROOM_19, FALSE))
    {
        evt_exec(0, TASK_09, from_main_4);
        aot_delete(AOT_08_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_19, TRUE);
    }
    if (ck(FG_ROOM, F_ROOM_24, TRUE) && ck(FG_STATUS, F_STATUS_40, FALSE))
    {
        sys_multi(SYS_HEALTH_STATUS, SYS_OR | HS_40);
    }
    if (ck(FG_ROOM, F_ROOM_18, FALSE) && ck(FG_ROOM, F_ROOM_19, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_1F, TRUE))
        {
            set(FG_ROOM, F_ROOM_1F, FALSE);
            bgm_stop(BGM_MAIN);
        }
    }
    else if (ck(FG_ROOM, F_ROOM_1F, FALSE))
    {
        set(FG_ROOM, F_ROOM_1F, TRUE);
        bgm_play(BGM_MAIN);
        snd_pan_vol_set(BGM_MAIN, -1, -1);
    }
}

event on_aot_03
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cutnext(CAM_03);
    sleep(15);
    message(MSG_THERE_IS_A_SWITCH | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "There's a switch. Will you push it? A weird hole opens."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            set(FG_ROOM, F_ROOM_1C, TRUE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cutnext(CAM_01);
        cut_auto(CUT_FREE);
    }
    evt_next();
    evt_finish();
}

event from_main
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cut_auto(CUT_LOCKED);
        cutnext(CAM_01);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_ROOM, F_ROOM_1E, TRUE);
        bank_bit(1);
        bank_bit(2);
    }
    sleep(10);
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_22, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    act_reset();
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_18_SHUTER, 0, SND_AT_POINT, 0, 9550, 7200);
        cutnext(CAM_02);
        aot_switch(0, SPR_03, SPR_ON);
        aot_delete(AOT_03_EVENT, SCE_NONE, SAT_UNDER | SAT_OBJECT);
    }
    sleep(40);
    se_play_3d(SND_BANK_ROOM, SE_17_MACHA, 0, SND_AT_POINT, 0, 3500, 7200);
    evt_fork(TASK_09, from_main_sub1, 0);
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(0, 24, 0);
    for (90)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 0, 0, 0);
    tw_nop();
    tw_end();
    sleep(40);
    aot_switch(0, SPR_03, SPR_OFF);
    cutnext(CAM_01);
    cut_auto(CUT_FREE);
    sleep(10);
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_22, 0);
    act_flag_op(EF_SET, EF_0004 | EF_0001);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        aot_delete(AOT_04_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_SCENARIO, F_SCENARIO_3A, TRUE);
        set(FG_ROOM, F_ROOM_1E, FALSE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event from_main_2
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_22, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    act_reset();
    evt_nop();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_18_SHUTER, 0, SND_AT_POINT, 0, 9550, 7200);
        set(FG_ROOM, F_ROOM_1A, TRUE);
        timer_setup(LIGHT_FADE_01, 200, FADE_R | FADE_G);
    }
    sleep(30);
    setw(W_LIGHT_DELTA, 0);
    message(MSG_POISON_GAS_IS_ESCAPING, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "Poison gas is escaping...!"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_22, 0);
    act_flag_op(EF_SET, EF_0004 | EF_0001);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    cut_auto(CUT_FREE);
    sleep(60);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cut_auto(CUT_LOCKED);
    se_play_3d(SND_BANK_PLAYER, SE_PL_02, 0, SND_AT_PLAYER, 0, 0, 0);
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_01, F_ROOM_24, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_24, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        if (ck(FG_RUN, F_RUN_READY, FALSE))
        {
            set(FG_RUN, F_RUN_READY, TRUE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event from_main_3
{
    do
    {
        single(12) effect(FX_09, FX_ROW_18, FX_AT_WORLD, 4885, -360, 7236, 0);
        evt_nop();
        evt_nop();
        sleep(15);
    }
    while (ck(FG_ROOM, F_ROOM_18, TRUE));
    evt_finish();
}

event from_main_4
{
    do
    {
        single(12) effect_tracked(FX_09, FX_ROW_18, FX_AT_WORLD, 14035, 65176, 7236, 0);
        evt_nop();
        evt_nop();
        sleep(15);
    }
    while (ck(FG_ROOM, F_ROOM_19, TRUE));
    evt_finish();
}

event from_main_5
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cut_auto(CUT_LOCKED);
        set(FG_ROOM, F_ROOM_1A, TRUE);
        timer_setup(LIGHT_FADE_01, 200, FADE_R | FADE_G);
    }
    sleep(30);
    run
    {
        setw(W_LIGHT_DELTA, 0);
        message(MSG_POISON_GAS_IS_ESCAPING, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "Poison gas is escaping...!"
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    sleep(60);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        se_play_3d(SND_BANK_PLAYER, SE_PL_02, 0, SND_AT_PLAYER, 0, 0, 0);
        cut_auto(CUT_LOCKED);
    }
    evt_work_set(WK_PLAYER, 1);
    evt_actor_begin();
    act_anim_flags(ANIM_01, F_ROOM_24, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_24, FALSE));
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        if (ck(FG_STATUS, F_STATUS_19, FALSE))
        {
            set(FG_RUN, F_RUN_READY, TRUE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

