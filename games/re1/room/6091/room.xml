    <language lang="ja-JP">
      <string key="save_name">館 {s}小部屋/{s}1{s}F{s}</string>
      <string key="0">{scroll 0}\n    危ない所だったな{scroll 2}{clear 68}{scroll 0}   サンドイッチが\n   出来上がるところだったぜ{scroll 2}{clear 69}{scroll 0}\n       本当ね{scroll 2}{timed 112}</string>
      <string key="1">{scroll 0}   でも“食堂を調べる”って\n   言ってたわよね{scroll 2}{clear 172}{scroll 0}\n     どうしてここに?{scroll 2}{timed 58}</string>
      <string key="2">{scroll 0}\n   気になる事があってな{scroll 2}{clear 112}{scroll 0}   さて迷子のウェスカーと\n   クリスの捜索に戻るか{scroll 2}{timed 143}</string>
      <string key="3">{scroll 0}\n    ありがとう バリー{scroll 2}{timed 40}</string>
      <string key="4">{scroll 0}\n  あいつらは? バケモノか‽{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}\n  レベッカはまだあの部屋に‽{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\n       奴らは‽{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}\n    レベッカ! 上か!{scroll 2}{timed 110}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Chambre RdC</string>
      <string key="0">{scroll 0}\nC'était moins une! {scroll 2}{clear 68}{scroll 0}Tu as failli finir en\nsandwich, Jill!{scroll 2}{clear 69}{scroll 0}Tu as raison. Barry, \nmerci de m'avoir sauvé la vie!{scroll 2}{timed 112}</string>
      <string key="1">{scroll 0}Mais Barry. Tu n'avais pas \ndit que tu allais à nouveau {scroll 2}{clear 73}{scroll 0}chercher dans la salle à \nmanger? {scroll 2}{clear 70}{scroll 0}Qu'est-ce que tu fais ici, \nbon sang?{scroll 2}{timed 48}</string>
      <string key="2">{scroll 0}Euh, je voulais vérifier un \ntruc.{scroll 2}{clear 112}{scroll 0}\nBon, reprenons nos recherches {scroll 2}{clear 60}{scroll 0}pour retrouver le Capitaine \net Chris, OK?{scroll 2}{timed 83}</string>
      <string key="3">{scroll 0}\nMerci, Barry!{scroll 2}{timed 40}</string>
      <string key="4">{scroll 0}Qu'est-ce que c'est? \nDes monstres?{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}Rebecca! Est-elle encore dans \nla maison?{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\nQu'est-ce que c'est?{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}C'est Rebecca! Elle doit être \nà l'étage!{scroll 2}{timed 110}</string>
    </language>
    <language lang="de-DE">
