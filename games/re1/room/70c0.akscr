    tw_abs_pos(0, 5545, -150, 3626);
    tw_abs_rot(0, 0, 2437, 0);
    evt_next();
    tw_nop();
    tw_abs_pos(0, 5745, -120, 3626);
    evt_next();
    tw_nop();
    tw_abs_pos(0, 5845, -80, 3626);
    evt_next();
    tw_nop();
    tw_abs_pos(0, 6045, -40, 3626);
    evt_next();
    tw_nop();
    tw_abs_pos(0, 6145, -20, 3626);
    evt_next();
    tw_nop();
    tw_abs_pos(0, 6245, 0, 3626);
    evt_next();
    tw_nop();
    tw_abs_pos(0, 6445, 0, 3626);
    evt_next();
    tw_nop();
    tw_end();
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 31, 0 | 0);
    act_flag_op(0, 1, 0);
    act_reset();
    evt_nop();
    inst_cfg(3, 2, 0, 252, 0, 64, 7, 188, 16, 120, 23);
