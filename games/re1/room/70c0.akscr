}

event event_06
{
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    tw_set_pos(246, 0, 0);
    for (20)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    for (50)
    {
        tw_set_pos(241, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(246, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(244, 0, 0);
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(249, 0, 0);
    for (20)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    aot_delete(7, SCE_EVENT, 129);
    set(FG_SCENARIO, 40, 0);
    evt_finish();
}

event event_07
{
    run
    {
        set(FG_STATUS, 15, 0);
        set(FG_6, 23, 1);
    }
    evt_fork(9, event_05, 0);
    sleep(40);
    message(151, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_ROOM, 15, 0);
        if (cmpb(5, 0, 0))
        {
            set(FG_ROOM, 14, 0);
            aot_delete(11, SCE_NONE, 0);
            evt_exec(0, 9, event_09);
        }
        else
        {
            evt_exec(0, 9, event_0A);
        }
    }
    evt_finish();
}

