    evt_finish();
}

event event_0C
{
    run
    {
        set(FG_6, 23, 1);
        message(155, 255);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            aot_on(1, SCE_DOOR, 0);
            set(FG_6, 23, 0);
        }
        else
        {
            set(FG_6, 23, 0);
        }
    }
    evt_finish();
}

