    while (ck(FG_ROOM, 15, 1));
    set(FG_ROOM, 15, 1);
    evt_actor_begin();
    act_nop();
    act_anim_flags(0 | 9, 32 | 31, 0 | 0);
    act_flag_op(0, 1, 0);
    act_reset();
