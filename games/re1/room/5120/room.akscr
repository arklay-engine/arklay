    evt_fork(TASK_09, on_enter_sub1_sub4, 0);
    sleep(60);
    evt_fork(TASK_09, on_enter_sub1_sub5, 0);
#endif
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_14, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
#if CHRIS
    sleep(45);
#endif
    run
    {
#if CHRIS
        cut_auto(CUT_FREE);
#endif
        set(FG_STATUS, F_STATUS_0F, FALSE);
#if CHRIS
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_on(AOT_00_DOOR, SCE_DOOR, 0);
#else
        pos_set(ENEMY_00_NPC_CHRIS, 0, 3072, 0, 5700, 0, 6800);
        cutnext(CAM_00);
        cut_auto(CUT_FREE);
#endif
    }
#if JILL
    sleep(45);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
