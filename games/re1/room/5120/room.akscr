    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_action_a(40);
    act_flag_op(EF_SET, 0);
    act_reset();
    evt_nop();
    sleep(20);
    run
    {
        pos_set(ENEMY_00_NPC_JILL, 0, 3072, 0, 5460, 0, 8560);
    }
    sleep(5);
    run
    {
