event on_enter_sub1_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_14, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0002);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_14, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    evt_finish();
}

event on_enter_sub1_sub2
{
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
    evt_actor_begin();
    act_anim_seq(AB_02, 5500, 7600, F_ROOM_14);
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

