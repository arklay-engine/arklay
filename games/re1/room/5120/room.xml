    <language lang="fr-FR">
      <string key="save_name">Laboratoire SS3</string>
      <string key="0">{scroll 0}Jill! Désolé de t'avoir fait \nattendre. {scroll 1}{clear 85}{scroll 0}\nChris... {scroll 1}{timed 50}</string>
      <string key="1">{scroll 0}Je savais que je pouvais te \nfaire confiance. {scroll 1}{timed 55}</string>
      <string key="2">{scroll 0}Filons!\nInutile de rester ici. {scroll 1}{timed 90}</string>
      <string key="3">{scroll 0}\nJill? Tu es là? {scroll 1}{timed 60}</string>
      <string key="4">{scroll 0}\nJill...Tu vas bien...! {scroll 1}{timed 55}</string>
      <string key="5">{scroll 0}Oui, Wesker est ici,\nil est... {scroll 1}{timed 100}</string>
      <string key="6">{scroll 0}Oh, je sais. Peu importe, \nsortons d'ici. {scroll 1}{timed 100}</string>
      <string key="7">{scroll 0}\nChris! {scroll 1}{timed 50}</string>
      <string key="8">{scroll 0}\nOh, Jill! {scroll 1}{clear 40}{scroll 0}Désolée de t'avoir fait \nattendre! {scroll 1}{clear 60}{scroll 0}\nAlors, tout est réglé?{scroll 1}{clear 50}{scroll 0}\nPresque. Allons-y maintenant!{scroll 1}{timed 100}</string>
      <string key="9">{scroll 0}\nOh, Jill! {scroll 1}{clear 21}{scroll 0}\nOh, Chris! Tu vas bien!? {scroll 1}{clear 70}{scroll 0}Oui! Toi aussi! Qu'est-il \narrivé à Wesker? {scroll 1}{clear 130}{scroll 0}Nous en reparlerons plus\ntard! Sortons d'ici. {scroll 1}{timed 80}</string>
      <string key="10">{scroll 2}\nRien d'important par ici.{scroll 1}</string>
      <string key="11">{scroll 2}\nRien d'important par ici.{scroll 1}</string>
      <string key="12">{scroll 2}\nRien d'important par ici.{scroll 1}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}Jill! Tut mir leid,\ndass du warten musstest.{scroll 1}{clear 85}{scroll 0}\nChris...{scroll 1}{timed 50}</string>
      <string key="1">{scroll 0}Ich wusste, dass ich\ndir vertrauen konnte.{scroll 1}{timed 55}</string>
      <string key="2">{scroll 0}Lass uns verschwinden! Es gibt\nkeinen Grund mehr, zu bleiben.{scroll 1}{timed 90}</string>
      <string key="3">{scroll 0}Jill!\nBist du hier?{scroll 1}{timed 60}</string>
      <string key="4">{scroll 0}Jill...\nDu bist in Ordnung...!{scroll 1}{timed 55}</string>
      <string key="5">{scroll 0}\nJa, Wesker ist hier, er ist...{scroll 1}{timed 100}</string>
      <string key="6">{scroll 0}Oh, ich weiß. Egal,\nwir sollten endlich abhauen.{scroll 1}{timed 100}</string>
      <string key="7">{scroll 0}\nChris!{scroll 1}{timed 50}</string>
      <string key="8">{scroll 0}\nOh, Jill!{scroll 1}{clear 40}{scroll 0}Tut mir Leid,\ndass ich dich warten ließ!{scroll 1}{clear 60}{scroll 0}\nDas heißt, alles ist erledigt?{scroll 1}{clear 65}{scroll 0}Nun, fast, ja.\nLass uns jetzt gehen!{scroll 1}{timed 90}</string>
      <string key="9">{scroll 0}\nOh, Jill!{scroll 1}{clear 40}{scroll 0}Oh, Chris!\nBist du auch okay?{scroll 1}{clear 70}{scroll 0}Ja! Du ja auch!\nWas ist mit Wesker passiert?{scroll 1}{clear 60}{scroll 0}Darüber können wir\nspäter sprechen!{scroll 1}{clear 70}{scroll 0}\nLass uns bloß abhauen.{scroll 1}{timed 80}</string>
      <string key="10">{scroll 2}\nHier gibt's nichts Wichtiges.{scroll 1}</string>
