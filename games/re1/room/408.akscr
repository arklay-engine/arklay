#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_USEITEM 0x04
#define AOT_05_ITEM 0x05
#define AOT_06_ITEM 0x06
#define FLAG_ROOM_1D 0x1D
#define FLAG_ROOM_20 0x20
#define FLAG_ROOM_21 0x21

proc init
{
    door_aot_set(AOT_00_DOOR, 0, 2200, 3000, 2100, 0, 0, 0, 4, 0, ROOM_405_CENTER_PASSAGE, 23200, 0, 8800, 2048, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 5500, 9400, 3000, 1800, 1, 0, 7, 1, 0, ROOM_409_DRUG_STOREHOUSE, 9000, 0, 3000, 2048, UNLOCKED, 129);
    door_aot_set(AOT_02_DOOR, 18200, 6500, 3000, 2000, 1, 0, 6, 1, 170, ROOM_40A_ROOM_003, 2900, 0, 2800, 0, ITEM_3A_KEY_GUARDHOUSE_003, 129);
    if (ck(FG_SCENARIO, FLAG_SCENARIO_44, TRUE))
    {
#if CHRIS
        door_aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, 12, 0, 0, 1, 64, ROOM_40C_PLANT_BOSS_ROOM, 3000, 0, 10200, 0, UNLOCKED, 129);
#else
        door_aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, 12, 0, 0, 1, 0, ROOM_40C_PLANT_BOSS_ROOM, 3000, 0, 10200, 0, UNLOCKED, 129);
#endif
    }
    else
    {
#if CHRIS
        aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, SCE_MESSAGE, 129, 141, 0, 255, 0, 0, 0);
#else
        aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, SCE_MESSAGE, 129, 13, 0, 255, 0, 0, 0);
#endif
    }
    aot_set(AOT_04_USEITEM, 7200, 11000, 800, 800, SCE_USEITEM, 129, 0, 0, 32, 0, 1, 0);
    item_aot_set(AOT_05_ITEM, 15000, 21700, 2000, 1000, ITEM_39_KEY_GUARDHOUSE_002, 1, 0, 255, 0, 0, 0, 0, 0, 0, 0, 4, 72, 129, 0, 0);
#if CHRIS
    item_aot_set(AOT_06_ITEM, 0, 0, 1, 1, ITEM_4D_TOOL_RADIO, 1, 1, 255, 0, 0, 0, 0, 0, 0, 0, 4, 8, 129, 0, 0);
    if (ck(FG_SCENARIO, FLAG_SCENARIO_00, TRUE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_3D, TRUE))
        {
            if (ck(FG_COMMON, FLAG_COMMON_AA, FALSE))
            {
                evt_exec(0, 9, on_enter_2);
            }
        }
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_AE, TRUE))
    {
        set(FG_COMMON, FLAG_COMMON_B1, TRUE);
    }
#endif
    set(FG_ROOM, FLAG_ROOM_1D, TRUE);
    aot_reset(AOT_01_DOOR, SCE_MESSAGE, 129, 143, 255, 0);
    evt_exec(0, 9, on_enter);
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_38, TRUE) && ck(FG_COMMON, FLAG_COMMON_AD, FALSE))
    {
        set(FG_COMMON, FLAG_COMMON_AD, TRUE);
        evt_exec(0, 9, on_enter_3);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_00, TRUE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_3D, TRUE))
        {
            if (ck(FG_COMMON, FLAG_COMMON_AA, FALSE))
            {
                enemy(ENEMY_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 3900, 0, 0, 24100, 0, 3200, 0, 0, 0, 0);
            }
        }
    }
#else
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17600, -4000, 22700, 0, 0, 0, 0);
#endif
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17600, -4000, 22700, 1, 0, 0, 0);
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17600, -3500, 22600, 2, 0, 0, 0);
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17700, -4000, 22700, 3, 0, 0, 0);
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17800, -3500, 22800, 4, 0, 0, 0);
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 17900, -4000, 22800, 5, 0, 0, 0);
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 18000, -3500, 22900, 6, 0, 0, 0);
    enemy(ENEMY_07_INSECT_WASP, 16, 255, 1, 2, 0, 0, 1024, 0, 0, 18000, -4000, 22900, 7, 0, 0, 0);
}

proc main
{
    if (ck(FG_SCENARIO, FLAG_SCENARIO_21, TRUE))
    {
        aot_delete(AOT_01_DOOR, SCE_DOOR, 129);
    }
    return;
}

event on_enter
{
    evt_work_set(WK_AOT, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 15520, -1590, 22430);
    tw_abs_rot(0, 1020, 800, 64466);
    tw_end();
    evt_nop();
    evt_finish();
}

#if CHRIS
event on_enter_2
#else
event event_01
#endif
{
    sleep(1);
    run
    {
        set(FG_COMMON, FLAG_COMMON_AA, TRUE);
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        dir_set(0, 0, 1680, 0, 26000, 0, 4280);
        cutnext(7);
