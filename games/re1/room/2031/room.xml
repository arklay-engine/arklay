  <strings>
    <language lang="en-US">
      <string key="name">HALL 2F</string>
      <string key="save_name">Hall 1F</string>
      <string key="0">{scroll 2}I've got to search this\nhall first!</string>
      <string key="1">{scroll 0}\n{scroll 1}{timed 44}</string>
      <string key="2">{scroll 0}\n{scroll 1}{clear 116}{scroll 0}\n{scroll 1}{timed 123}</string>
      <string key="3">{scroll 0}\n{scroll 1}{clear 115}{scroll 0}\n{scroll 1}{timed 109}</string>
      <string key="4">{scroll 0}\n{scroll 1}{clear 120}{scroll 0}\n{scroll 1}{timed 85}</string>
      <string key="5">{scroll 0}\n{scroll 1}{clear 96}{scroll 0}\n{scroll 1}{timed 85}</string>
      <string key="6">{scroll 0}\n{scroll 1}{timed 47}</string>
      <string key="7">{scroll 0}\n{scroll 1}{clear 190}{scroll 0}\n{scroll 1}{timed 45}</string>
      <string key="8">{scroll 0}\n{scroll 1}{timed 65}</string>
      <string key="9">{scroll 0}\n{scroll 1}{timed 67}</string>
      <string key="10">{scroll 0}\n{scroll 1}{timed 87}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}ホ{s}ー{s}ル{s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 2}\n 先ずこのホールを捜さなくては!</string>
      <string key="1">{scroll 0}\n       バリー{scroll 1}{timed 44}</string>
      <string key="2">{scroll 0}\n  どうだ 何か手かがりでも?{scroll 1}{clear 116}{scroll 0}\n   いえ でもおかしな館ね{scroll 1}{timed 123}</string>
      <string key="3">{scroll 0}\n   ここも安全とはいえんな{scroll 1}{clear 115}{scroll 0}    とりあえず脱出経路を\n    確保するか{scroll 1}{timed 109}</string>
      <string key="4">{scroll 0}\n     裏口があるだろう{scroll 1}{clear 120}{scroll 0}\n     そいつを捜すか{scroll 1}{timed 85}</string>
      <string key="5">{scroll 0}\n   じゃ また別れましょう{scroll 1}{clear 96}{scroll 0}\n  そうだ これを見つけたんだ{scroll 1}{timed 85}</string>
      <string key="6">{scroll 0}\n        何?{scroll 1}{timed 47}</string>
      <string key="7">{scroll 0}    ちょっとした弾だ\n    生き物によく効くぜ{scroll 1}{clear 190}{scroll 0}\n      とっときな{scroll 1}{timed 45}</string>
      <string key="8">{scroll 0}\n     でも バリーは?{scroll 1}{timed 65}</string>
      <string key="9">{scroll 0}\n     こいつがあるさ{scroll 1}{timed 67}</string>
      <string key="10">{scroll 0}\n   ありがとう 悪いわね{scroll 1}{timed 87}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Hall RdC</string>
      <string key="0">{scroll 2}Il faut que je fouille le \nhall d'abord!</string>
      <string key="1">{scroll 0}\nBarry!{scroll 1}{timed 44}</string>
      <string key="2">{scroll 0}Jill! Que se passe-t-il? \nDu nouveau?{scroll 1}{clear 116}{scroll 0}Non, mais...Quelque chose \ncloche dans cette maison!{scroll 1}{timed 123}</string>
      <string key="3">{scroll 0}Ouah! Ce hall est dangereux. \nPeut-être vaut-il mieux tout {scroll 1}{clear 115}{scroll 0}d'abord prévoir un moyen de \nsortir d'ici.{scroll 1}{timed 109}</string>
      <string key="4">{scroll 0}Il doit bien y avoir une\nporte à l'arrière...{scroll 1}{clear 100}{scroll 0}Essayons de la trouver\nd'abord, OK?{scroll 1}{timed 85}</string>
      <string key="5">{scroll 0}D'accord, \non se sépare de nouveau.{scroll 1}{clear 80}{scroll 0}Un moment. \nJ'ai trouvé quelque chose.{scroll 1}{timed 85}</string>
      <string key="6">{scroll 0}\nQu'est-ce que c'est?{scroll 1}{timed 47}</string>
      <string key="7">{scroll 0}C'est une arme. Elle est très \npuissante, {scroll 1}{clear 45}{scroll 0}tout particulièrement pour se \ndébarrasser de créatures. {scroll 1}{clear 125}{scroll 0}Mieux vaut que tu la prennes \navec toi.{scroll 1}{timed 60}</string>
      <string key="8">{scroll 0}\nEt toi, Barry?{scroll 1}{timed 65}</string>
      <string key="9">{scroll 0}\nMoi, j'ai ça.{scroll 1}{timed 67}</string>
      <string key="10">{scroll 0}Dans ce cas, \nje la prends, merci.{scroll 1}{timed 87}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Ich muss erst diese Halle\ndurchsuchen!</string>
      <string key="1">{scroll 0}\nBarry!{scroll 1}{timed 44}</string>
      <string key="2">{scroll 0}Jill! Wie sieht es aus?\nIrgendwelche Hinweise?{scroll 1}{clear 116}{scroll 0}Nein, aber... mit diesem Haus\nstimmt etwas nicht!{scroll 1}{timed 123}</string>
      <string key="3">{scroll 0}Mann!\nDiese Halle ist gefährlich.{scroll 1}{clear 115}{scroll 0}\nVielleicht wäre es besser,{scroll 1}{clear 50}{scroll 0}zuerst einmal\nunseren Fluchtweg zu sichern.{scroll 1}{timed 59}</string>
      <string key="4">{scroll 0}Da muss es noch irgendwo\neine Hintertür geben...{scroll 1}{clear 100}{scroll 0}Die sollten wir erst mal\nfinden, was meinst du?{scroll 1}{timed 85}</string>
      <string key="5">{scroll 0}Okay, dann sollten wir\nuns wieder trennen.{scroll 1}{clear 80}{scroll 0}Warte einen Moment.\nIch habe etwas gefunden.{scroll 1}{timed 85}</string>
      <string key="6">{scroll 0}\nWas ist das?{scroll 1}{timed 47}</string>
