#if CHRIS

event on_aot_00_door
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 0, 0 | 0);
    act_param_set(0, 8);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 3, 32 | 0, 0 | 0);
    act_motion_path(50, 0, 65226, 0, 0, 70);
    act_reset();
    evt_nop();
    sleep(25);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_reset();
    evt_nop();
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 0, 0 | 0);
    act_param_set(0, 8);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_20, FALSE));
    sleep(45);
    run
    {
        door_aot_set(AOT_00_DOOR, 0, 11300, 2500, 2300, 2, 1, 12, 7, 0, ROOM_40C_PLANT_BOSS_ROOM, 28400, 0, 29300, 2048, UNLOCKED, 1);
        setb(9, 0, 0);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}
#endif
