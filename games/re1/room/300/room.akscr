#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_USEITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_EVENT 0x05
#define AOT_06_ITEM 0x06
#define AOT_07_ITEM 0x07
#define AOT_08_ITEM 0x08
#define AOT_09_ITEM 0x09
#define AOT_0A_ITEM 0x0A
#define AOT_0B_ITEM 0x0B
#define AOT_0C_ITEM 0x0C
#define AOT_0D_MESSAGE 0x0D
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define CAM_06 0x06
#define COL_04 0x04
#define COL_06 0x06
#define ENEMY_00_CERBERUS 0x00
#define ENEMY_01_CERBERUS 0x01
#define ENEMY_02_CERBERUS 0x02
#define F_ROOM_00 0x00
#define F_ROOM_01 0x01
#define F_ROOM_20 0x20
#define IMDL_00 0x00
#define IMDL_01 0x01
#define IMDL_02 0x02
#define IMDL_03 0x03
#define IMDL_04 0x04
#define IMDL_05 0x05
#define IMDL_06 0x06
#define IMDL_07 0x07
#define MSG_IT_IS_A_MAP_OF_GARDEN 0x09
#define MSG_VO_009_00_1E 0x00
#define MSG_VO_009_00_24 0x04
#define MSG_VO_009_01 0x01
#define MSG_VO_009_02_20 0x02
#define MSG_VO_009_02_26 0x06
#define MSG_VO_009_03 0x03
#define MSG_VO_A05_01 0x05
