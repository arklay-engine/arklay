#version 1

proc init
{
    set(FG_STATUS, 28, 0);
    door_aot_set(0, 15200, 2400, 2000, 2600, 9, 0, 0, 1, 0, RDT_009, 2700, 0, 8500, 0, UNLOCKED, 129);
    door_aot_set(1, 1800, 1000, 2400, 1400, 2, 0, 30, 5, 64, RDT_017, 2900, 0, 10000, 0, UNLOCKED, 129);
    door_aot_set(2, 7800, 5200, 1500, 1700, 1, 0, 1, 4, 216, RDT_019, 6300, 0, 2700, 3072, ITEM_HELMET_KEY, 129);
    door_aot_set(3, 10600, 5200, 2000, 1700, 2, 0, 2, 1, 148, RDT_00B, 3300, 0, 6600, 3072, LOCK, 129);
    door_aot_set(4, 200, 10700, 2000, 2300, 0, 1, 8, 0, 0, RDT_01A, 4500, 0, 4100, 2048, UNLOCKED, 129);
    if (ck(FG_COMMON, 40, 1))
    {
        aot_set(5, 0, 400, 5600, 6100, SCE_EVENT, 65, 0, 0, event_00, 0, 0, 0);
        enemy(ENEMY_HUNTER, 167, 2, 1, 2, 0, 0, 0, 0, 0, 20000, 20000, 20000, 0, 0, 0, 0);
    }
    else
    {
        enemy(ENEMY_HUNTER, 39, 2, 1, 2, 0, 0, 896, 0, 0, 4561, 0, 4818, 0, 0, 0, 0);
    }
    return;
}

event event_00
{
    run
    {
        aot_delete(5, SCE_NONE, 0);
        set(FG_COMMON, 40, 0);
        bgm_stop_all(0);
    }
    sleep(1);
    movie_on(6);
    sleep(1);
    run
    {
        set(FG_STATUS, 15, 0);
        bgm_restore(0);
        dir_set(0, 0, 304, 0, 2276, 0, 3481);
        set(FG_6, 23, 1);
        cutnext(2);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 0, 32 | 31, 0 | 0);
    act_reset();
    evt_nop();
    sleep(10);
    evt_fork(9, event_02, 0);
    se_play_3d(0, 0, 0, 0, 0, 2468, 11628);
    sleep(30);
    se_play_3d(0, 1, 0, 0, 0, 2468, 11628);
    sleep(20);
    run
    {
        pos_set(0, 0, 914, 0, 2524, 0, 12163);
        eml_state(0, 0, 0, 103);
        dir_set(0, 0, 304, 0, 4890, 0, 3549);
    }
    evt_fork(9, event_01, 0);
    cutnext(3);
    sleep(100);
    run
    {
        dir_set(0, 0, 3144, 0, 2260, 0, 2984);
        pos_set(0, 0, 914, 0, 2665, 0, 8864);
        eml_state(0, 0, 0, 39);
        cutnext(2);
        cut_auto(0);
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
    }
    evt_finish();
}

event event_01
{
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_seq(55554, 3595, 16160);
    act_finish();
}

event event_02
{
    sleep(37);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 31, 0 | 0);
    sleep(25);
    act_idle();
    act_finish();
}
