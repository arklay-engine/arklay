event on_aot_00_door when (CHRIS)
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_20, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_20, 0);
    act_motion_path(MOTION_32, 0, -310, 0, 0, 70);
    act_reset();
    evt_nop();
    sleep(25);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_20, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    sleep(45);
    run
    {
        door_aot_set(AOT_00_DOOR, 0, 11300, 2500, 2300, 2, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_40C_PLANT_BOSS_ROOM, 28400, 0, 29300, 2048, UNLOCKED, SAT_PLAYER);
        setb(B_CHARACTER_MODEL, 0, 0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}
