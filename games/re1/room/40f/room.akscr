#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_40E 0x00                                // Rebecca's V-JOLT scene turns it into a door to 40C.
#define AOT_01_ITEM_KEY_DESK_0 0x01
#define AOT_02_USEITEM_ROOTS_EVENT 0x02
#define AOT_03_USEITEM_ROOTS 0x03                           // Raises F_ROOM_ITEM_USED_ON_ROOTS when an item is used on the roots.
#define AOT_04_B_WATER 0x04                                 // Likely: the flooded floor, while the water is not drained.
#define AOT_05_MESSAGE_ROOTS 0x05
#define AOT_06_MESSAGE_BAG 0x06
#define ENEMY_00_PLANT_42_ROOTS 0x00
#define FX_09 0x09
#define F_ROOM_ITEM_USED_ON_ROOTS 0x23                      // An item was used on the roots (one frame); main checks for the V-JOLT.
#define F_ROOM_PLAYER_ANIM_DONE 0x20                        // The player's animation finished (one frame).
#define IMDL_00_KEY_DESK 0x00
#define OBJ_00_WATER 0x00
#define SE_17_V_JOLT 0x17

proc init
{
    door_aot_set(AOT_00_DOOR_40E, 0, 11300, 2500, 2300, 2, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_40E_WATER_TANK, 28400, 0, 29300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        item_aot_set(AOT_01_ITEM_KEY_DESK_0, 9300, 2400, 600, 700, IT_3D_KEY_DESK, 1, IMDL_00_KEY_DESK, SCA_NONE, 9750, -1230, 3460, 1024, F_ITEM_40F_KEY_DESK_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6);
    }
    else
    {
        item_aot_set(AOT_01_ITEM_KEY_DESK_0, 9300, 2400, 600, 700, IT_3D_KEY_DESK, 1, IMDL_00_KEY_DESK, SCA_NONE, 9750, -1230, 3460, 1024, F_ITEM_40F_KEY_DESK_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_V_JOLT_ON_ROOTS, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_STAGE_VARIANT, FALSE))
        {
            aot_set(AOT_02_USEITEM_ROOTS_EVENT, 4200, 2500, 5000, 3000, SCE_USEITEM, SAT_PLAYER, 9, 0, 0, 0, 1, 0);
            aot_set(AOT_03_USEITEM_ROOTS, 4200, 2500, 5000, 3000, SCE_USEITEM, SAT_PLAYER, 4, 0, 35, 0, 1, 0);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_WATER_DRAINED, FALSE))
    {
        aot_set(AOT_04_B_WATER, 2000, 2000, 10000, 15000, SCE_B, SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_STAGE_VARIANT, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_V_JOLT_ON_ROOTS, FALSE))
        {
            aot_set(AOT_05_MESSAGE_ROOTS, 4200, 2500, 4000, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
        }
        else
        {
            aot_set(AOT_05_MESSAGE_ROOTS, 4800, 2500, 4000, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
        }
    }
    else
    {
        aot_set(AOT_05_MESSAGE_ROOTS, 4800, 2500, 4000, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    }
    aot_set(AOT_06_MESSAGE_BAG, 9300, 5000, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_WATER_DRAINED, FALSE))
    {
        if (CHRIS)
        {
            obj(OBJ_00_WATER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 6062, -1920, 7654, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        }
        else
        {
            obj(OBJ_00_WATER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 6032, -1800, 7994, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        }
    }
    eml_rot(IMDL_00_KEY_DESK, -1380, 70);
    if (CHRIS)
    {
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
        {
            aot_reset(AOT_01_ITEM_KEY_DESK_0, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
            set(FG_SCENARIO, F_SCENARIO_PLANT42_OBJ_ACK, TRUE);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_WATER_DRAINED, FALSE))
    {
        evt_exec(0, TASK_09, water_bob);
    }
    if (JILL)
    {
        aot_delete(AOT_01_ITEM_KEY_DESK_0, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_STAGE_VARIANT, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_V_JOLT_ON_ROOTS, FALSE))
        {
            enemy(EM_0E_PLANT_42_ROOTS, EB_80, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 6695, -5500, 2896, ENEMY_00_PLANT_42_ROOTS, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_0E_PLANT_42_ROOTS, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 6695, -5500, 2896, ENEMY_00_PLANT_42_ROOTS, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        enemy(EM_0E_PLANT_42_ROOTS, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 6695, -5500, 2896, ENEMY_00_PLANT_42_ROOTS, ANIM_00, 0, EVAR_00);
    }
    if (CHRIS)
    {
        return;
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_V_JOLT_ON_ROOTS, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_ITEM_USED_ON_ROOTS, TRUE))
        {
            if (testitem(IT_1B_CHEMICAL_V_JOLT))
            {
                evt_exec(0, TASK_09, v_jolt_on_roots);
                if (CHRIS)
                {
                    aot_reset(AOT_00_DOOR_40E, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, rebecca_returns_to_plant42, 0);
                }
            }
        }
    }
    if (CHRIS)
    {
        return;
    }
}

event roots_item_nop
{
    evt_finish();
}

event v_jolt_on_roots
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        evt_exec(0, TASK_09, v_jolt_on_roots_player);
    }
    sleep(20);
    se_play_3d(SND_BANK_ROOM, SE_17_V_JOLT, 0, SND_AT_POINT, 0, 14365, 2290);
    effect(FX_09, FX_ROW_1B, FX_AT_WORLD, 7100, -1200, 3800, 0);
    sleep(5);
    effect(FX_09, FX_ROW_19, FX_AT_WORLD, 7100, -1400, 3800, 0);
    sleep(10);
    effect(FX_09, FX_ROW_19, FX_AT_WORLD, 7100, -1300, 3800, 0);
    sleep(15);
    effect(FX_09, FX_ROW_19, FX_AT_WORLD, 7100, -1400, 3800, 0);
    sleep(20);
    effect_tracked(FX_09, FX_ROW_1A, FX_AT_WORLD, 7100, 64336, 3200, 0);
    sleep(70);
    effect_kill_a(0);
    run
    {
        eml_state(0, ENEMY_00_PLANT_42_ROOTS, EML_BEHAVIOUR, EB_00);
    }
    evt_finish();
}

event v_jolt_on_roots_player
{
    sleep(75);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 250, 0, 3, 70, 0);
    act_reset();
    evt_nop();
    sleep(35);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    if (JILL)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_23, F_ROOM_PLAYER_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    }
    sleep(15);
    run
    {
        aot_delete(AOT_02_USEITEM_ROOTS_EVENT, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_03_USEITEM_ROOTS, SCE_NONE, SAT_PLAYER);
        aot_reset(AOT_05_MESSAGE_ROOTS, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 255, 0);
        set(FG_SCENARIO, F_SCENARIO_V_JOLT_ON_ROOTS, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

