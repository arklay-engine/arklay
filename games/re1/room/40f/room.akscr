#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_USEITEM 0x02
#define AOT_03_USEITEM 0x03
#define AOT_04_B 0x04
#define AOT_05_MESSAGE 0x05
#define AOT_06_MESSAGE 0x06
#define ENEMY_00_PLANT_42_ROOTS 0x00
#define FX_09 0x09
#define F_ROOM_20 0x20
#define F_ROOM_23 0x23
#define IMDL_00 0x00
#define OBJ_00 0x00
#define SE_17_V_JOLT 0x17

proc init
{
    door_aot_set(AOT_00_DOOR, 0, 11300, 2500, 2300, 2, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_40E_WATER_TANK, 28400, 0, 29300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        item_aot_set(AOT_01_ITEM, 9300, 2400, 600, 700, IT_3D_KEY_DESK, 1, IMDL_00, SCA_NONE, 9750, -1230, 3460, 1024, F_ITEM_69, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6);
    }
    else
    {
        item_aot_set(AOT_01_ITEM, 9300, 2400, 600, 700, IT_3D_KEY_DESK, 1, IMDL_00, SCA_NONE, 9750, -1230, 3460, 1024, F_ITEM_69, SAT_MANUAL | SAT_PLAYER, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_13, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_00, FALSE))
        {
            aot_set(AOT_02_USEITEM, 4200, 2500, 5000, 3000, SCE_USEITEM, SAT_PLAYER, 9, 0, 0, 0, 1, 0);
            aot_set(AOT_03_USEITEM, 4200, 2500, 5000, 3000, SCE_USEITEM, SAT_PLAYER, 4, 0, 35, 0, 1, 0);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_23, FALSE))
    {
        aot_set(AOT_04_B, 2000, 2000, 10000, 15000, SCE_B, SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_00, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_13, FALSE))
        {
            aot_set(AOT_05_MESSAGE, 4200, 2500, 4000, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
        }
        else
        {
            aot_set(AOT_05_MESSAGE, 4800, 2500, 4000, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
        }
    }
    else
    {
        aot_set(AOT_05_MESSAGE, 4800, 2500, 4000, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    }
    aot_set(AOT_06_MESSAGE, 9300, 5000, 1000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_23, FALSE))
    {
        if (CHRIS)
        {
            obj(OBJ_00, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 6062, -1920, 7654, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        }
        else
        {
            obj(OBJ_00, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 6032, -1800, 7994, 0, 0, 0, 0, 0, 0, 0, 0, 0);
        }
    }
    eml_rot(IMDL_00, -1380, 70);
    if (CHRIS)
    {
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
        {
            aot_reset(AOT_01_ITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
            set(FG_SCENARIO, F_SCENARIO_48, TRUE);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_23, FALSE))
    {
        evt_exec(0, TASK_09, on_enter);
    }
    if (JILL)
    {
        aot_delete(AOT_01_ITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_00, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_13, FALSE))
        {
            enemy(EM_0E_PLANT_42_ROOTS, EB_80, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 6695, -5500, 2896, ENEMY_00_PLANT_42_ROOTS, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_0E_PLANT_42_ROOTS, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 6695, -5500, 2896, ENEMY_00_PLANT_42_ROOTS, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        enemy(EM_0E_PLANT_42_ROOTS, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 6695, -5500, 2896, ENEMY_00_PLANT_42_ROOTS, ANIM_00, 0, EVAR_00);
    }
    if (CHRIS)
    {
        return;
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_13, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_23, TRUE))
        {
            if (testitem(IT_1B_CHEMICAL_V_JOLT))
            {
                evt_exec(0, TASK_09, from_main);
                if (CHRIS)
                {
                    aot_reset(AOT_00_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_00_door, 0);
                }
            }
        }
    }
    if (CHRIS)
    {
        return;
    }
}

event event_00
{
    evt_finish();
}

event from_main
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        evt_exec(0, TASK_09, from_main_sub1);
    }
    sleep(20);
    se_play_3d(SND_BANK_ROOM, SE_17_V_JOLT, 0, SND_AT_POINT, 0, 14365, 2290);
    effect(FX_09, FX_ROW_1B, FX_AT_WORLD, 7100, -1200, 3800, 0);
    sleep(5);
    effect(FX_09, FX_ROW_19, FX_AT_WORLD, 7100, -1400, 3800, 0);
    sleep(10);
    effect(FX_09, FX_ROW_19, FX_AT_WORLD, 7100, -1300, 3800, 0);
    sleep(15);
    effect(FX_09, FX_ROW_19, FX_AT_WORLD, 7100, -1400, 3800, 0);
    sleep(20);
    effect_tracked(FX_09, FX_ROW_1A, FX_AT_WORLD, 7100, 64336, 3200, 0);
    sleep(70);
    effect_kill_a(0);
    run
    {
        eml_state(0, ENEMY_00_PLANT_42_ROOTS, EML_BEHAVIOUR, EB_00);
    }
    evt_finish();
}

event from_main_sub1
{
    sleep(75);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_20, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 250, 0, 3, 70, 0);
    act_reset();
    evt_nop();
    sleep(35);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_20, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    if (JILL)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_23, F_ROOM_20, 0);
        act_reset();
        evt_nop();
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_20, FALSE));
    }
    sleep(15);
    run
    {
        aot_delete(AOT_02_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_03_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_reset(AOT_05_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 255, 0);
        set(FG_SCENARIO, F_SCENARIO_13, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

