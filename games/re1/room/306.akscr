event from_main_sub2
{
    se_play_3d(SND_BANK_ROOM, SE_19_R_PASS, 0, SND_AT_POINT, 0, 9150, 10000);
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 228);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, F_SCENARIO_3C, TRUE);
    inst_cfg(0, 2, 0, 14, 28, 88, 32, 184, 35, 58, 44);
    evt_finish();
}

event from_main_sub3
{
    se_play_3d(SND_BANK_ROOM, SE_19_R_PASS, 0, SND_AT_POINT, 0, 9150, 10000);
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 28);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, F_SCENARIO_3C, FALSE);
    inst_cfg(0, 2, 0, 0, 0, 0, 0, 2, 0, 2, 0);
    evt_finish();
}

event from_main_2
{
    evt_work_set(WK_OBJ, OBJ_03);
    evt_tween_begin_alt();
    tw_set_pos(0, 176, 0);
    for (10)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, F_ROOM_02, FALSE);
    evt_finish();
}

event from_main_3
{
    evt_work_set(WK_OBJ, OBJ_03);
    evt_tween_begin_alt();
    tw_set_pos(0, 80, 0);
    for (10)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, F_ROOM_02, FALSE);
    evt_finish();
}

event event_07
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_I_CANNOT_USE_THE_CRANK_BECAUSE | MSG_FAST, 0); // "I can't use the crank because of the statue."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
}
