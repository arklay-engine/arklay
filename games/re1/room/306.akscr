event from_main_sub2
{
    se_play_3d(SND_BANK_ROOM, SE_19_R_PASS, 0, SND_AT_POINT, 0, 9150, 10000);
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, -28);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, F_SCENARIO_3C, TRUE);
    inst_cfg(COL_LIST_00, COL_02, 0, 7182, 8280, 9144, 11322);
    evt_finish();
}

event from_main_sub3
{
    se_play_3d(SND_BANK_ROOM, SE_19_R_PASS, 0, SND_AT_POINT, 0, 9150, 10000);
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 28);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, F_SCENARIO_3C, FALSE);
    inst_cfg(COL_LIST_00, COL_02, 0, 0, 0, 2, 2);
    evt_finish();
}

