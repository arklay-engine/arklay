event event_03
{
    se_play_3d(2, 25, 0, 0, 0, 9150, 10000);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 228);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, FLAG_SCENARIO_3C, TRUE);
    inst_cfg(0, 2, 0, 14, 28, 88, 32, 184, 35, 58, 44);
    evt_finish();
}

event event_04
{
    se_play_3d(2, 25, 0, 0, 0, 9150, 10000);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 0, 28);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_SCENARIO, FLAG_SCENARIO_3C, FALSE);
    inst_cfg(0, 2, 0, 0, 0, 0, 0, 2, 0, 2, 0);
    evt_finish();
}

event event_05
{
    evt_work_set(WK_OBJ, 3);
    evt_tween_begin_alt();
    tw_set_pos(0, 176, 0);
    for (10)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, FLAG_ROOM_02, FALSE);
    evt_finish();
}

event event_06
{
    evt_work_set(WK_OBJ, 3);
    evt_tween_begin_alt();
    tw_set_pos(0, 80, 0);
    for (10)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, FLAG_ROOM_02, FALSE);
    evt_finish();
}

event event_07
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        message(129, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_6, FLAG_6_17, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
}
