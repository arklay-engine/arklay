}

event from_main_5
{
    evt_work_set(WK_AOT, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3760, -2300, 7060);
    tw_finish();
}

event event_07
{
    run
    {
        message(MSG_IT_LOOKS_LIKE_A_HOOK | 0x80, 255); // "It looks like a hook."
        eml_pos(0, 0, 0, 0, 4, 0, 0, 120, 15, 146, 245, 102, 28);
        cutnext(4);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        eml_pos(0, 0, 0, 0, 4, 0, 0, 228, 12, 214, 247, 26, 29);
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        cutcurr(0);
    }
    evt_finish();
}
#endif
