event event_03
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        eml_pos(0, 0, 0, 0, 4, 0, 0, 120, 15, 146, 245, 102, 28);
        cutnext(CAM_04);
    }
    evt_work_set(WK_AOT, AOT_00_DOOR);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3810, -2640, 7270);
    tw_end();
    evt_nop();
    sleep(20);
    run
    {
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        setb(B_SELECTED_ITEM, IT_06_WEAPON_FLAMETHROWER, 0);
        swap_var(2, 3, 13);
        set(FG_STATUS, F_STATUS_12, TRUE);
        set(FG_ROOM, F_ROOM_18, TRUE);
    }
    evt_finish();
}

event event_04
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        eml_pos(0, 0, 0, 0, 4, 0, 0, 120, 15, 0, 246, 102, 28);
        cutnext(CAM_04);
    }
    evt_work_set(WK_AOT, AOT_00_DOOR);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3810, -2525, 7270);
    tw_end();
    evt_nop();
    sleep(20);
    run
    {
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        aot_on(AOT_03_ITEM, SCE_ITEM, 0);
        set(FG_ROOM, F_ROOM_18, TRUE);
    }
    evt_next();
    evt_nop();
    evt_work_set(WK_AOT, AOT_00_DOOR);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3760, -2300, 7060);
    tw_finish();
}

