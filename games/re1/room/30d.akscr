event event_07
{
    run
    {
        message(MSG_IT_LOOKS_LIKE_A_HOOK | MSG_FAST, MSG_PAUSE_0080 | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "It looks like a hook."
        eml_pos(0, 0, 0, 0, 4, 0, 0, 120, 15, 146, 245, 102, 28);
        cutnext(CAM_04);
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        eml_pos(0, 0, 0, 0, 4, 0, 0, 228, 12, 214, 247, 26, 29);
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        cutcurr(0);
    }
    evt_finish();
}
#endif
