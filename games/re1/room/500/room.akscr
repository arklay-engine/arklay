#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_EVENT 0x03
#define CAM_02 0x02
#define CAM_04 0x04
#define ENEMY_00_NPC_CHRIS 0x00
#define ENEMY_00_NPC_JILL 0x00
#define ENEMY_01 0x01
#define ENEMY_01_NPC_BARRY 0x01
#define FX_0A 0x0A
#define F_ROOM_00 0x00
#define MSG_EMERGENCY_EXIT 0x01
#define MSG_THERE_IS_A_LADDER 0x03
#define MSG_VO_A00_03_44 0x00
#define VO_A00_03_44 0x44

proc init
{
    door_aot_set(AOT_00_DOOR, 0, 8000, 2500, 3300, 11, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, DOOR_LOCKED | F_LOCK_1C, ROOM_501_HELIPORT_PASSAGE, 30000, 0, 3500, 2048, IT_37_KEY_LAB_MASTER, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 7500, 2400, 1600, 1700, 0, DOOR_SND_0E_EV_FTN, DOOR_14_ELE02, 64, 0, STAGE_3 | ROOM_310_COURT_TO_LABO, 0, 0, 0, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 3200, 5900, 2100, 1700, 1, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_502_LADDER_ROOM, 5300, 0, 11200, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_03_EVENT, 2000, 11500, 1000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
    if (ck(FG_COMMON, F_COMMON_4A, FALSE))
    {
        effect_tracked(FX_0A, FX_ROW_10, FX_AT_WORLD, 4000, 62136, 11130, 0);
    }
    else
    {
        effect(FX_0A, FX_ROW_18, FX_AT_WORLD, 4000, -3400, 11130, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_37, TRUE))
    {
        if (ck(FG_COMMON, F_COMMON_4B, TRUE))
        {
            if (CHRIS)
            {
                enemy(EM_21_NPC_JILL, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 6100, 0, 9200, ENEMY_00_NPC_JILL, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_20_NPC_CHRIS, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 1730, 0, 6040, 0, 10070, ENEMY_00_NPC_CHRIS, ANIM_00, 0, EVAR_00);
            }
            evt_exec(0, TASK_09, on_enter);
        }
        if (JILL)
        {
            if (ck(FG_COMMON, F_COMMON_C0, FALSE))
            {
                enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 500, 0, 3680, 0, 11310, ENEMY_01_NPC_BARRY, ANIM_00, 0, EVAR_00);
                if (ck(FG_COMMON, F_COMMON_51, FALSE))
                {
                    evt_exec(0, TASK_09, event_02);
                }
                else
                {
                    evt_exec(0, TASK_09, event_01);
                }
            }
        }
        if (ck(FG_SCENARIO, F_SCENARIO_2B, TRUE))
        {
            aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 255, 0);
        }
        else
        {
            aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 255, 0);
        }
        if (JILL)
        {
            set(FG_COMMON, F_COMMON_4E, TRUE);
        }
    }
    aot_reset(AOT_02_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_02_door, 0);
}

proc main
{
    if (ck(FG_COMMON, F_COMMON_4A, FALSE))
    {
        if (ck(FG_LOCK, F_LOCK_1C, TRUE))
        {
            set(FG_COMMON, F_COMMON_4A, TRUE);
            effect_kill_a(0);
            effect(FX_0A, FX_ROW_18, FX_AT_WORLD, 4000, -3400, 11130, 0);
        }
    }
}

event on_enter
{
    sleep(1);
    if (CHRIS)
    {
        eml_state(0, ENEMY_00_NPC_JILL, EML_08);
    }
    else
    {
        eml_state(0, ENEMY_00_NPC_CHRIS, EML_08);
    }
    evt_finish();
}

event event_01
{
    sleep(1);
    if (CHRIS)
    {
        eml_state(0, ENEMY_01, EML_08);
    }
    else
    {
        eml_state(0, ENEMY_01_NPC_BARRY, EML_08);
    }
    evt_finish();
}

event event_02
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        cutnext(CAM_02);
    }
    sleep(20);
    run
    {
        voice_play(VOICE_PLAY, VO_A00_03_44);
        message(MSG_VO_A00_03_44, 0);
    }
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_01);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_00, 0);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 0, 250, 1, 0, 40);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutcurr(0);
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    sleep(20);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        if (CHRIS)
        {
            eml_state(0, ENEMY_01, EML_08);
        }
        else
        {
            eml_state(0, ENEMY_01_NPC_BARRY, EML_08);
        }
    }
    evt_finish();
}

event on_aot_03
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_04);
    }
    sleep(20);
    run
    {
        message(MSG_EMERGENCY_EXIT | MSG_FAST, 0); // "“Emergency Exit""
    }
    wait_message();
    sleep(20);
    run
    {
        cutnext(CAM_02);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event event_04
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    sleep(5);
    run
    {
        effect_kill_a(0);
        effect(FX_0A, FX_ROW_18, FX_AT_WORLD, 4000, -3400, 11130, 0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event on_aot_02_door
{
    message(MSG_THERE_IS_A_LADDER | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a ladder. Will you descend it? There's no turning back!"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_on(AOT_02_DOOR, SCE_DOOR, 0);
        }
    }
    evt_finish();
}
