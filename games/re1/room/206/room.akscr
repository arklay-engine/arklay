#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_204 0x00
#define AOT_01_DOOR_207 0x01
#define AOT_02_ITEM_FILE_BOTANY_BOOK 0x02
#define AOT_03_MESSAGE_ARRANGED 0x03                        // "It's well arranged."
#define AOT_04_EVENT_REBECCA_BODY 0x04                      // Starts as SCE_NONE; main arms it once Rebecca is dead and the hunter too.
#define AOT_04_MESSAGE_NOTHING 0x04                         // "Nothing uncommon." ("It's well arranged." in Jill's MANSION2).
#define AOT_05_MESSAGE_NOTHING 0x05                         // "Nothing uncommon." ("It's well arranged." in Jill's MANSION2).
#define AOT_06_MESSAGE_NOTHING 0x06                         // "Nothing uncommon." ("It's well arranged." in Jill's MANSION2).
#define AOT_07_MESSAGE_NOTHING 0x07                         // "Nothing uncommon."
#define CAM_00 0x00
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define COL_04 0x04
#define ENEMY_00_REBECCA 0x00
#define ENEMY_01_HUNTER 0x01
#define FX_00 0x00
#define FX_AT_ENEMY_01 0x03
#define F_ROOM_C_BODY_SPOT_ARMED 0x03                       // Main armed AOT_04_EVENT_REBECCA_BODY.
#define F_ROOM_C_CUTSCENE 0x02                              // A cutscene is running.
#define F_ROOM_C_DOOR_OPENED 0x01                           // Rebecca opened the door.
#define F_ROOM_C_HUNTER_ANIM_DONE 0x22                      // The hunter's animation finished (one frame).
#define F_ROOM_C_HUNTER_SCENE_STARTED 0x00                  // Main started one of the hunter scenes.
#define F_ROOM_C_PLAYER_ANIM_DONE 0x20                      // Chris's animation finished (one frame).
#define F_ROOM_C_REBECCA_ANIM_DONE 0x21                     // Rebecca's animation finished (one frame).
#define IMDL_00_FILE_BOTANY_BOOK 0x00
#define IMDL_03 0x03
#define MSG_VO_00C_30 0x02
#define OBJ_00_DOOR_207 0x00                                // Likely: the door to 207 as an object; Rebecca opens it.
#define SE_03 0x03
#define SE_0B 0x0B
#define SE_0D 0x0D
#define SE_0E 0x0E
#define SE_0F 0x0F
#define SE_2D_FT_CPA 0x2D
#define SE_2E_FT_CPB 0x2E
#define SE_2F_TAORE_CP 0x2F
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_00C_30 0x0B

proc init
{
    door_aot_set(AOT_00_DOOR_204, 2500, 1000, 1300, 1400, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, ROOM_204_C_PASSAGE, 3500, 0, 19100, 512, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_207, 9500, 10700, 1300, 1600, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 2, DOOR_LOCKED | F_LOCK_206_207, ROOM_207_2F_RIGHT_STAIRS, 3000, 0, 12100, 0, LOCK, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_ITEM, F_ITEM_206_FILE_BOTANY_BOOK_0, TRUE))
    {
        item_aot_set(AOT_02_ITEM_FILE_BOTANY_BOOK, 4190, 9110, 1800, 1800, IT_6E_FILE_BOTANY_BOOK, 1, IMDL_00_FILE_BOTANY_BOOK, SCA_NONE, 5200, -1290, 10300, 0, F_ITEM_206_FILE_BOTANY_BOOK_0, SAT_MANUAL | SAT_PLAYER, 0);
        eml_rot(IMDL_00_FILE_BOTANY_BOOK, 1214, 0);
    }
    aot_set(AOT_03_MESSAGE_ARRANGED, 7900, 5000, 4000, 2200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    if (MANSION1)
    {
        aot_set(AOT_04_MESSAGE_NOTHING, 6580, 2280, 2600, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        aot_set(AOT_05_MESSAGE_NOTHING, 1000, 8700, 2000, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        aot_set(AOT_06_MESSAGE_NOTHING, 1000, 11500, 5400, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    }
    else if (CHRIS)
    {
        aot_set(AOT_04_EVENT_REBECCA_BODY, 5930, 11440, 1800, 1800, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
        aot_set(AOT_05_MESSAGE_NOTHING, 6580, 2280, 2600, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
        aot_set(AOT_06_MESSAGE_NOTHING, 1000, 8700, 2000, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
        aot_set(AOT_07_MESSAGE_NOTHING, 1000, 11500, 5400, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_04_MESSAGE_NOTHING, 6580, 2280, 2600, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
        aot_set(AOT_05_MESSAGE_NOTHING, 1000, 8700, 2000, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
        aot_set(AOT_06_MESSAGE_NOTHING, 1000, 11500, 5400, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
    }
    obj(OBJ_00_DOOR_207, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 10000, 0, 12220, 2046, 1, 1, 1, 1, 1, 1, 1, 1);
    if (MANSION1)
    {
        if (ck(FG_COMMON, F_COMMON_RICHARD_SCENE_OVER, TRUE) && ck(FG_COMMON, F_COMMON_RICHARD_SERUM_IN_TIME, TRUE))
        {
            set(FG_COMMON, F_COMMON_RICHARD_SCENE_LEFT, TRUE);
        }
    }
    else if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_IN_TIME, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_TOO_LATE, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_UPSTAIRS_CALL, TRUE))
        {
            if (cmpw(0, W_04, CMP_GT, 180))
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_TOO_LATE, TRUE);
                room_bgm_state_set(6, 6, BGM_RELOAD);
            }
            else
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_IN_TIME, TRUE);
                room_bgm_state_set(6, 6, BGM_RELOAD | 1);
            }
        }
        else
        {
            room_bgm_state_set(6, 6, BGM_OFF);
        }
        if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, TRUE))
        {
            enemy(EM_2C_NPC_REBECCA_2, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 72, 0, 6947, 0, 12497, ENEMY_00_REBECCA, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_IN_TIME, TRUE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, FALSE))
        {
            enemy(EM_2C_NPC_REBECCA_2, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1696, 0, 8253, 0, 9707, ENEMY_00_REBECCA, ANIM_31, 1, EVAR_00);
            enemy(EM_06_HUNTER, EB_60, F_ENEMY_206_HUNTER_1, SPAWN_RESTORE, 2, 0, 3416, 0, 5457, 0, 7095, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_TOO_LATE, TRUE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, FALSE))
        {
            enemy(EM_2C_NPC_REBECCA_2, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1150, 0, 6314, 0, 7354, ENEMY_00_REBECCA, ANIM_31, 1, EVAR_00);
            enemy(EM_06_HUNTER, EB_60, F_ENEMY_206_HUNTER_1, SPAWN_RESTORE, 2, 0, 3312, 0, 5500, 0, 5000, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, TRUE) && ck(FG_ENEMY, F_ENEMY_206_HUNTER_1, FALSE))
        {
            enemy(EM_06_HUNTER, EB_02, F_ENEMY_206_HUNTER_1, SPAWN_RESTORE, 2, 0, 1177, 0, 6258, 0, 7748, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_IN_TIME, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_TOO_LATE, FALSE) && ck(FG_ENEMY, F_ENEMY_206_HUNTER_1, FALSE))
        {
            enemy(EM_06_HUNTER, EB_02, F_ENEMY_206_HUNTER_1, SPAWN_RESTORE, 2, 0, 1177, 0, 6258, 0, 7748, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_RICHARD_SCENE_OVER, TRUE) && ck(FG_COMMON, F_COMMON_RICHARD_SERUM_IN_TIME, TRUE))
        {
            set(FG_COMMON, F_COMMON_RICHARD_SCENE_LEFT, TRUE);
        }
    }
}

proc main
{
    if (CHRIS && MANSION2)
    {
        if (ck(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE) && ck(FG_ENEMY, F_ENEMY_206_HUNTER_1, TRUE) && ck(FG_ROOM, F_ROOM_C_BODY_SPOT_ARMED, FALSE))
        {
            set(FG_ROOM, F_ROOM_C_BODY_SPOT_ARMED, TRUE);
            aot_reset(AOT_04_EVENT_REBECCA_BODY, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, examine_rebecca_body, 0);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_IN_TIME, TRUE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, FALSE) && ck(FG_COMMON, F_COMMON_C_LEFT_REBECCA_TO_HUNTER, FALSE) && ck(FG_ROOM, F_ROOM_C_HUNTER_SCENE_STARTED, FALSE))
        {
            set(FG_ROOM, F_ROOM_C_HUNTER_SCENE_STARTED, TRUE);
            inst_cfg(COL_LIST_00, COL_04, CF_2 | CF_1, 8900, 10500, 11916, 13000);
            evt_exec(0, TASK_00, hunter_attacks_rebecca);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_TOO_LATE, TRUE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, FALSE) && ck(FG_ROOM, F_ROOM_C_HUNTER_SCENE_STARTED, FALSE))
        {
            set(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, TRUE);
            set(FG_ROOM, F_ROOM_C_HUNTER_SCENE_STARTED, TRUE);
            evt_exec(0, TASK_00, hunter_kills_rebecca);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_IN_TIME, TRUE) && ck(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, FALSE) && ck(FG_ENEMY, F_ENEMY_206_HUNTER_1, TRUE))
        {
            set(FG_COMMON, F_COMMON_C_REBECCA_HUNTER_DONE, TRUE);
            inst_cfg(COL_LIST_00, COL_04, CF_2 | CF_1, 15000, 15000, 15010, 15010);
            evt_exec(0, TASK_00, rebecca_saved);
        }
    }
}

event hunter_attacks_rebecca
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_ROOM, F_ROOM_C_CUTSCENE, TRUE);
        cut_auto(CUT_LOCKED);
        bgm_play(BGM_MAIN);
        cutnext(CAM_04);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(30);
    act_reset();
    evt_nop();
    cutnext(CAM_03);
    evt_fork(TASK_01, hunter_attacks_rebecca_rebecca, 0);
    evt_fork(TASK_02, hunter_attacks_rebecca_hunter, 0);
    sleep(5);
    se_play_3d(SND_BANK_ROOM, SE_0D, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
    sleep(65);
    cutnext(CAM_00);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 3500, 4000, F_ROOM_C_PLAYER_ANIM_DONE);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_C_PLAYER_ANIM_DONE, FALSE));
    act_anim_flags(ANIM_24, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(20);
    act_reset();
    evt_nop();
    cutnext(CAM_03);
    sleep(120);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutnext(CAM_00);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_ROOM, F_ROOM_C_CUTSCENE, FALSE);
    }
    evt_finish();
}

event hunter_attacks_rebecca_rebecca
{
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_31, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_nop();
    evt_fork(TASK_07, rebecca_screams, 0);
    evt_tween_begin_alt();
    tw_nop();
    tw_set_pos(15, 0, 21);
    for (80)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 128, 0);
    act_finish();
}

event hunter_attacks_rebecca_hunter
{
    evt_work_set(WK_ENEMY, ENEMY_01_HUNTER);
    evt_actor_begin();
    act_anim_seq(AB_02, 8253, 9707, F_ROOM_C_HUNTER_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    sleep(80);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_16);
    sleep(50);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_12);
    sleep(75);
    eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, EB_02);
    evt_finish();
}

event rebecca_saved
{
    set(FG_ROOM, F_ROOM_C_CUTSCENE, TRUE);
    sleep(25);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_COMMON, F_COMMON_C_SAVED_REBECCA_FROM_HUNTER, TRUE);
        bgm_volume_ramp(BGM_MAIN, -95, 30);
        cut_auto(CUT_LOCKED);
        cutnext(CAM_03);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_anim_flags(ANIM_32, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    sleep(100);
    act_anim_flags(ANIM_23, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0080);
    sleep(22);
    act_anim_flags(ANIM_2D, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    act_param_set(0, 64512);
    sleep(30);
    act_reset();
    evt_nop();
    evt_fork(TASK_01, rebecca_saved_door, 0);
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    sleep(15);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_fork(TASK_02, rebecca_saved_chris, 0);
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_seq(AB_03, 12500, 11650, F_ROOM_C_REBECCA_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_C_DOOR_OPENED, FALSE));
    cutcurr(0);
    sleep(60);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_25, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(50);
    act_anim_flags(ANIM_25, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    sleep(30);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_ROOM, F_ROOM_C_CUTSCENE, FALSE);
    }
    evt_finish();
}

