event hunter_kills_rebecca
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_ROOM, F_ROOM_C_CUTSCENE, TRUE);
        cut_auto(CUT_LOCKED);
        bgm_play(BGM_MAIN);
        cutnext(CAM_04);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(30);
    act_reset();
    evt_nop();
    cutnext(CAM_02);
    se_play_3d(SND_BANK_ROOM, SE_0D, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
    sleep(8);
    evt_fork(TASK_01, hunter_kills_rebecca_rebecca, 0);
    evt_fork(TASK_02, hunter_kills_rebecca_hunter, 0);
    sleep(50);
    cutnext(CAM_03);
    dir_set(0, 0, 3489, 0, 4589, 0, 5649);
    sleep(85);
    cutnext(CAM_03);
    sleep(120);
    objtbl_b_set(TBL_OBJ, OBJ_00_DOOR_207, 0);
    cutnext(CAM_05);
    sleep(225);
    run
    {
        objtbl_b_set(TBL_OBJ, OBJ_00_DOOR_207, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
        cutnext(CAM_00);
        voice_play(VOICE_PLAY, VO_00C_30);
        message(MSG_VO_00C_30, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(95);
    se_play_3d(SND_BANK_ROOM, SE_2F_TAORE_CP, 0, SND_AT_POINT, 0, 0, 0);
    sleep(43);
    se_play_3d(SND_BANK_ROOM, SE_2E_FT_CPB, 0, SND_AT_POINT, 0, 0, 0);
    sleep(12);
    se_play_3d(SND_BANK_ROOM, SE_2E_FT_CPB, 0, SND_AT_POINT, 0, 0, 0);
    sleep(12);
    se_play_3d(SND_BANK_ROOM, SE_2D_FT_CPA, 0, SND_AT_POINT, 0, 0, 0);
    sleep(38);
    sleep(60);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_ROOM, F_ROOM_C_CUTSCENE, FALSE);
        set(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE);
        eml_state(0, ENEMY_00_REBECCA, EML_STATUS, EML_STATUS_SET | 1);
    }
    evt_finish();
}

event hunter_kills_rebecca_rebecca
{
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_31, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_nop();
    evt_fork(TASK_07, rebecca_screams, 0);
    evt_tween_begin_alt();
    tw_nop();
    tw_set_pos(4, 0, 33);
    for (100)
    {
        evt_next();
        tw_pos_add();
    }
    tw_end();
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    se_play_3d(SND_BANK_ROOM, SE_0B, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
    sleep(26);
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_31, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_nop();
    evt_tween_begin_alt();
    tw_nop();
    tw_set_pos(4, 0, 33);
    for (58)
    {
        evt_next();
        tw_pos_add();
    }
    tw_end();
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_32, F_ROOM_C_REBECCA_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(50);
    se_play_3d(SND_BANK_ROOM, SE_0E, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
    eml_state(0, ENEMY_00_REBECCA, EML_STATUS, EML_STATUS_SET | 3);
    sleep(54);
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_seq(AB_03, 8900, 12200, F_ROOM_C_REBECCA_ANIM_DONE);
    act_nop();
    act_param_set(0, 256);
    act_reset();
    evt_nop();
    evt_finish();
}

event hunter_kills_rebecca_hunter
{
    sleep(18);
    evt_work_set(WK_ENEMY, ENEMY_01_HUNTER);
    evt_actor_begin();
    act_anim_seq(AB_02, 6700, 9722, F_ROOM_C_HUNTER_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    sleep(82);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_0D);
    sleep(5);
    effect(FX_00, FX_ROW_00, FX_AT_ENEMY_01, 1700, -800, 0, 40);
    se_play_3d(SND_BANK_ROOM, SE_03, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
    sleep(34);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_12);
    sleep(84);
    evt_work_set(WK_ENEMY, ENEMY_01_HUNTER);
    evt_actor_begin();
    act_anim_seq(AB_02, 6700, 9722, F_ROOM_C_HUNTER_ANIM_DONE);
    act_nop();
    act_reset();
    evt_nop();
    sleep(66);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_0C);
    sleep(75);
    sleep(180);
    eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, EB_02);
    evt_finish();
}

event rebecca_screams
{
    for (5)
    {
        se_play_3d(SND_BANK_ROOM, SE_0F, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
        sleep(20);
    }
    evt_finish();
}

event arranged_spot_to_document
{
    aot_on(AOT_03_MESSAGE_ARRANGED, SCE_DOCUMENT, 0);
    evt_next();
    evt_nop();
    sleep(1);
    aot_reset(AOT_03_MESSAGE_ARRANGED, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    objtbl_b_set(TBL_ITEM, IMDL_03, 0);
    evt_finish();
}

event examine_rebecca_body
{
    run
    {
        objtbl_b_set(TBL_OBJ, OBJ_00_DOOR_207, 0);
        cut_auto(CUT_LOCKED);
        cutnext(CAM_05);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_ROOM, F_ROOM_C_CUTSCENE, TRUE);
        dir_set(0, 0, 2728, 0, 8875, 0, 11549);
        pos_set(ENEMY_00_REBECCA, 0, 72, 0, 7897, 0, 12497);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(26);
    act_reset();
    evt_nop();
    message(0x04 | MSG_FAST, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 128, 2, 23, 23);
    sleep(75);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        objtbl_b_set(TBL_OBJ, OBJ_00_DOOR_207, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
        cutnext(CAM_03);
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_ROOM, F_ROOM_C_CUTSCENE, FALSE);
        pos_set(ENEMY_00_REBECCA, 0, 72, 0, 6947, 0, 12497);
    }
    evt_finish();
}

event rebecca_saved_chris
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_06, 9521, 10959, F_ROOM_C_PLAYER_ANIM_DONE);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_C_PLAYER_ANIM_DONE, FALSE));
    act_anim_flags(ANIM_24, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    evt_nop();
    evt_nop();
}
