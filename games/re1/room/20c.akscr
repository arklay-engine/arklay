proc init
{
    door_aot_set(AOT_00_DOOR, 10400, 17500, 2300, 1400, 1, DOOR_SND_00_DR_WD, DOOR_1F_DOOR05K, 5, 0, ROOM_20B_FRONT_LESSON_ROOM, 2500, 0, 7400, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 16650, 2570, 2400, 2080, 1, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_21A_UNDER_PASSAGE_1, 28000, 0, 3550, 2048, UNLOCKED, 0);
#if CHRIS
    aot_set(AOT_07_EVENT, 16650, 2570, 2400, 2080, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_07, 0, 0, 0);
#else
    aot_set(AOT_0A_EVENT, 16650, 2570, 2400, 2080, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_0a, 0, 0, 0);
#endif
    set(FG_STATUS, F_STATUS_1D, TRUE);
#if JILL
    room_bgm_state_set(6, 12, BGM_RELOAD | 1);
#endif
    if (ck(FG_SCENARIO, F_SCENARIO_27, FALSE))
    {
        enemy(EM_12_YAWN_2, EB_84, F_ENEMY_3E, SPAWN_FORCE, 2, 0, 2048, 0, 13000, 0, 11150, ENEMY_00_YAWN_2, ANIM_00, 0, EVAR_00);
    }
    else
    {
        enemy(EM_12_YAWN_2, EB_06, F_ENEMY_3E, SPAWN_FORCE, 2, 0, 3072, 0, 5300, 0, 17500, ENEMY_00_YAWN_2, ANIM_00, 0, EVAR_00);
        inst_cfg(COL_LIST_03, COL_02, 0, 252, 1856, 4284, 6008);
        if (ck(FG_ENEMY, F_ENEMY_3E, FALSE))
        {
            evt_exec(0, TASK_09, on_enter);
        }
    }
#if CHRIS
    if (ck(FG_ENEMY, F_ENEMY_3E, TRUE))
    {
        room_bgm_state_set(6, 12, BGM_MAIN_ON);
    }
#else
    enemy(EM_2B_NPC_BARRY_2_STARS, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 0, 0, 0, ENEMY_0F_NPC_BARRY_2_STARS, ANIM_00, 0, EVAR_00);
#endif
    aot_set(AOT_02_EVENT, 1200, 1400, 3000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_02, 0, 0, 0);
#if CHRIS
    aot_set(AOT_03_EVENT, 1400, 3400, 3200, 2700, SCE_EVENT, 0, 9, 0, on_aot_03, 0, 0, 0);
#else
    if (ck(FG_ENEMY, F_ENEMY_3E, FALSE))
    {
        aot_set(AOT_03_EVENT, 1400, 3400, 3200, 2700, SCE_EVENT, 0, 9, 0, on_aot_03, 0, 0, 0);
    }
    else
    {
        set(FG_ROOM, F_ROOM_08, TRUE);
        if (ck(FG_COMMON, F_COMMON_26, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_25, TRUE))
            {
                aot_set(AOT_03_EVENT, 1400, 3400, 3200, 2700, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03_2, 0, 0, 0);
            }
            else
            {
                aot_set(AOT_03_EVENT, 1400, 3400, 3200, 2700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
            }
        }
        else
        {
            aot_set(AOT_03_EVENT, 1400, 3400, 3200, 2700, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
        }
    }
#endif
    if (ck(FG_SCENARIO, F_SCENARIO_28, FALSE))
    {
#if CHRIS
        aot_set(AOT_04_EVENT, 16650, 2570, 2400, 2080, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_04, 0, 0, 0);
#else
        aot_set(AOT_04_USEITEM, 16650, 2570, 2400, 2080, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER, 4, 0, 9, 0, 1, 0);
#endif
    }
    aot_set(AOT_06_USEITEM, 19000, 2570, 1400, 2080, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 62, 0, 1, 0);
#if JILL
    item_aot_set(AOT_07_ITEM, 0, 0, 1, 1, IT_4D_KEY_RADIO, 0, IMDL_00, SCA_NONE, 0, 0, 0, 0, F_ITEM_55, SAT_UNDER | SAT_PLAYER, 0);
    item_aot_set(AOT_08_ITEM, 0, 0, 1, 1, IT_63_FILE_PASS_NUMBER, 0, IMDL_00, SCA_NONE, 0, 0, 0, 0, F_ITEM_56, SAT_UNDER | SAT_PLAYER, 0);
    aot_set(AOT_09_EVENT, 23550, 2500, 1000, 2000, SCE_EVENT, 0, 9, 0, on_aot_09, 0, 0, 0);
#endif
    if (ck(FG_SCENARIO, F_SCENARIO_28, FALSE))
    {
        aot_set(AOT_0B_USEITEM, 13800, 1710, 2100, 3700, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
    }
#if CHRIS
    aot_set(AOT_08_MESSAGE, 14400, 2810, 1800, 1900, SCE_MESSAGE, 0, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_09_USEITEM, 8700, 10210, 1800, 1900, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 60, 0, 1, 0);
    aot_set(AOT_0A_MESSAGE, 9300, 9710, 1800, 2800, SCE_MESSAGE, 0, 156, 0, 255, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_28, FALSE))
    {
        obj(OBJ_00, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 17650, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
    }
    else
    {
        obj(OBJ_00, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 15460, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
        set(FG_ROOM, F_ROOM_0E, TRUE);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_21A_UNDER_PASSAGE_1))
    {
        msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
    }
#else
    aot_set(AOT_0C_MESSAGE, 14400, 2810, 1800, 1900, SCE_MESSAGE, 0, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_0D_USEITEM, 8700, 10210, 1800, 1900, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 60, 0, 1, 0);
    aot_set(AOT_0E_MESSAGE, 9300, 9710, 1800, 2800, SCE_MESSAGE, 0, 156, 0, 255, 0, 0, 0);
    if (ck(FG_COMMON, F_COMMON_25, TRUE))
    {
        effect(FX_0D, FX_ROW_00, FX_AT_WORLD, 23500, -2400, 3800, 0);
        aot_delete(AOT_09_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_21A_UNDER_PASSAGE_1))
    {
        msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
        if (ck(FG_COMMON, F_COMMON_25, FALSE))
        {
            room_bgm_state_set(6, 12, BGM_MAIN_ON);
        }
    }
    else if (ck(FG_COMMON, F_COMMON_25, TRUE))
    {
        room_bgm_state_set(6, 12, BGM_MAIN_ON);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_28, FALSE))
    {
        obj(OBJ_00, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 17650, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
    }
    else
    {
        obj(OBJ_00, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 15460, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
        set(FG_ROOM, F_ROOM_0E, TRUE);
    }
#endif
}

proc main
{
#if CHRIS
    if (ck(FG_ENEMY, F_ENEMY_3E, TRUE))
    {
        aot_delete(AOT_03_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
#else
    if (ck(FG_ENEMY, F_ENEMY_3E, TRUE) && ck(FG_ROOM, F_ROOM_08, FALSE))
    {
        aot_delete(AOT_03_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_08, TRUE);
    }
#endif
    if (ck(FG_ENEMY, F_ENEMY_3E, TRUE) && ck(FG_ROOM, F_ROOM_07, TRUE))
    {
        bgm_volume_ramp(BGM_SUB_1, -96, 30);
        set(FG_ROOM, F_ROOM_07, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_3E, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_0E, FALSE))
        {
#if CHRIS
            aot_delete(AOT_07_EVENT, SCE_EVENT, 0);
            aot_delete(AOT_04_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
#else
            aot_delete(AOT_0A_EVENT, SCE_EVENT, 0);
            aot_delete(AOT_04_USEITEM, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER);
#endif
        }
        else
        {
#if CHRIS
            aot_delete(AOT_07_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_04_EVENT, SCE_EVENT, 0);
#else
            aot_delete(AOT_0A_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_04_USEITEM, SCE_USEITEM, 0);
#endif
        }
    }
    else
    {
#if CHRIS
        aot_delete(AOT_07_EVENT, SCE_EVENT, 0);
        aot_delete(AOT_04_EVENT, SCE_EVENT, 0);
#else
        aot_delete(AOT_0A_EVENT, SCE_EVENT, 0);
        aot_delete(AOT_04_USEITEM, SCE_NONE, 0);
#endif
    }
    if (ck(FG_SCENARIO, F_SCENARIO_28, TRUE))
    {
#if CHRIS
        aot_delete(AOT_04_EVENT, SCE_NONE, 0);
#else
        aot_delete(AOT_04_USEITEM, SCE_NONE, 0);
#endif
    }
#if JILL
    if (ck(FG_ROOM, F_ROOM_09, TRUE))
    {
        set(FG_ROOM, F_ROOM_09, FALSE);
        if (ck(FG_ROOM, F_ROOM_0C, FALSE))
        {
            evt_exec(0, TASK_09, from_main);
            set(FG_ROOM, F_ROOM_0D, TRUE);
        }
    }
    if (ck(FG_ROOM, F_ROOM_0A, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_0D, FALSE))
        {
            evt_exec(0, TASK_09, from_main_2);
            set(FG_ROOM, F_ROOM_0C, TRUE);
            set(FG_ROOM, F_ROOM_0A, FALSE);
        }
    }
#endif
    if (cmpb(B_CAMERA, CMP_EQ, CAM_02) && ck(FG_SCENARIO, F_SCENARIO_27, FALSE))
    {
        bank_bit(255);
        bank_bit(2);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_01) && ck(FG_SCENARIO, F_SCENARIO_27, FALSE))
    {
        bank_bit(255);
        bank_bit(3);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_27, TRUE))
    {
        aot_delete(AOT_02_EVENT, SCE_NONE, 0);
    }
    if (ck(FG_ROOM, F_ROOM_3D, FALSE))
    {
#if CHRIS
        aot_delete(AOT_08_MESSAGE, SCE_MESSAGE, 0);
#else
        aot_delete(AOT_0C_MESSAGE, SCE_MESSAGE, 0);
#endif
    }
    else
    {
#if CHRIS
        aot_delete(AOT_08_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
#else
        aot_delete(AOT_0C_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
#endif
    }
    if (ck(FG_ROOM, F_ROOM_3C, FALSE))
    {
#if CHRIS
        aot_delete(AOT_0A_MESSAGE, SCE_MESSAGE, 0);
#else
        aot_delete(AOT_0E_MESSAGE, SCE_MESSAGE, 0);
#endif
    }
    else
    {
#if CHRIS
        aot_delete(AOT_0A_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
#else
        aot_delete(AOT_0E_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
#endif
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
    {
        set(FG_MAP, F_MAP_VISITED_11F, TRUE);
    }
}

event on_aot_03
{
#if CHRIS
    evt_fork(TASK_09, on_aot_03_sub2, 0);
#else
    evt_fork(TASK_09, on_aot_03_sub1, 0);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_26, TRUE);
        aot_reset(AOT_03_EVENT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
    }
#endif
    sleep(26);
#if CHRIS
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    message(MSG_IT_IS_TOO_DARK_TO_SEEWILL | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's too dark to see.Will you jump down? There's a rope. Will you descend it?"
#else
    message(MSG_IT_IS_TOO_DARK_TO_SEE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's too dark to see anything."
#endif
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
#if CHRIS
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, on_aot_03_sub1);
        }
        else
        {
            set(FG_ROOM, F_ROOM_0F, TRUE);
            evt_exec(0, TASK_09, on_aot_03_sub3);
        }
    }
#else
    pos_set(ENEMY_0F_NPC_BARRY_2_STARS, 0, 1240, 0, 8768, 0, 14600);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_ENEMY, ENEMY_00_YAWN_2, 0, 0);
    evt_fork(TASK_09, on_aot_03_sub2, 0);
    sleep(80);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_ENEMY, ENEMY_00_YAWN_2, 0, 0);
    sleep(10);
    evt_fork(TASK_09, on_aot_03_sub3, 0);
    sleep(10);
    run
    {
        cutnext(CAM_00);
        set(FG_ROOM, F_ROOM_0F, TRUE);
        dir_set(0, 0, 246, 0, 3796, 0, 6495);
    }
    sleep(60);
    cutnext(CAM_02);
    voice_play(VOICE_PLAY, VO_10D_00);
    message(MSG_VO_10D_00, 0);
    sleep(90);
    wait_message();
    cutnext(CAM_03);
    dir_set(0, 0, 982, 0, 3796, 0, 6495);
    evt_fork(TASK_09, on_aot_03_sub4, 0);
    voice_play(VOICE_PLAY, VO_10D_01);
    message(MSG_VO_10D_01, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_03_sub5, 0);
    voice_play(VOICE_PLAY, VO_10D_02);
    message(MSG_VO_10D_02, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_03_sub6, 0);
    voice_play(VOICE_PLAY, VO_10D_03);
    message(MSG_VO_10D_03, 0);
    wait_message();
    evt_work_set(WK_ENEMY, ENEMY_0F_NPC_BARRY_2_STARS);
    evt_actor_begin();
    act_motion_path(MOTION_13, 2634, 0, 4825, 200, 100);
    act_reset();
    evt_nop();
    voice_play(VOICE_PLAY, VO_10D_04);
    message(MSG_VO_10D_04, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_03_sub7, 0);
    voice_play(VOICE_PLAY, VO_B00_00);
    wait_message();
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_7F, FALSE))
        {
            evt_exec(0, TASK_09, on_aot_03_sub8);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_03_sub9);
        }
    }
#endif
    evt_finish();
}

event on_aot_02
{
    run
    {
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_fork(TASK_09, on_aot_02_sub1, 0);
    sleep(100);
    run
    {
        bank_bit(255);
        bank_bit(3);
        bank_bit(2);
        cutnext(CAM_01);
        dir_set(0, 0, 1208, 0, 3607, 0, 5516);
        eml_state(0, ENEMY_00_YAWN_2, EML_BEHAVIOUR, EB_04);
    }
    evt_fork(TASK_09, on_enter, 0);
    evt_fork(TASK_09, on_aot_02_sub3, 0);
    sleep(100);
    bank_bit(2);
    cutnext(CAM_02);
    evt_fork(TASK_09, on_aot_02_sub2, 0);
    sleep(70);
    se_play_3d(SND_BANK_ROOM, SE_19, 0, SND_AT_ENEMY, ENEMY_00_YAWN_2, 0, 0);
    se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_ENEMY, ENEMY_00_YAWN_2, 0, 0);
    sleep(1);
    se_play_3d(SND_BANK_ROOM, SE_19, 0, SND_AT_ENEMY, ENEMY_00_YAWN_2, 0, 0);
    se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_ENEMY, ENEMY_00_YAWN_2, 0, 0);
    sleep(1);
#if CHRIS
    sleep(98);
#else
    sleep(99);
#endif
    evt_chain(8);
    evt_nop();
    evt_nop();
}

event on_aot_02_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, 300, 200, 0, 15, 30);
