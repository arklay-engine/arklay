event on_aot_09
{
    set(FG_6, F_6_17, FALSE);
    message(MSG_THERE_IS_A_ROPE_WILL_YOU_CLIMB_IT | MSG_FAST, 255); // "There's a rope. Will you climb it? There's a ladder. Will you descend it? A hole opens in the fireplace."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, 9, on_aot_09_sub2);
        }
        else
        {
            evt_exec(0, 9, on_aot_09_sub1);
        }
    }
    evt_finish();
}

