#if CHRIS
event on_aot_04_sub1_sub1
#else
event from_main_sub1_sub1
#endif
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(-10, 0, 0);
    for (20)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    for (50)
    {
        tw_set_pos(-15, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(-10, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(-12, 0, 0);
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(-7, 0, 0);
    for (20)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
#if CHRIS
    aot_delete(AOT_07_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
#else
    aot_delete(AOT_0A_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
#endif
    set(FG_SCENARIO, F_SCENARIO_28, TRUE);
    evt_finish();
}

#if CHRIS
event on_aot_04
#else
event from_main
#endif
{
    run
    {
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
#if CHRIS
    evt_fork(TASK_09, on_aot_03_sub2, 0);
#else
    evt_fork(TASK_09, on_aot_03_sub1, 0);
#endif
    sleep(40);
    message(MSG_THERE_IS_A_SWITCH_BELOW | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a switch below. Will you push it?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_ROOM, F_ROOM_0F, TRUE);
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            set(FG_ROOM, F_ROOM_0E, TRUE);
            aot_delete(AOT_0B_USEITEM, SCE_NONE, 0);
#if CHRIS
            evt_exec(0, TASK_09, on_aot_04_sub1);
#else
            evt_exec(0, TASK_09, from_main_sub1);
#endif
        }
        else
        {
#if CHRIS
            evt_exec(0, TASK_09, on_aot_03_sub3);
#else
            evt_exec(0, TASK_09, from_main_sub2);
#endif
        }
    }
    evt_finish();
}

