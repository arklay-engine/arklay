        evt_next();
    }
    tw_nop();
    for (50)
    {
        tw_set_pos(241, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(246, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(244, 0, 0);
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(249, 0, 0);
    for (20)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
#if CHRIS
    aot_delete(AOT_07_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
#else
    aot_delete(AOT_0A_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
#endif
    set(FG_SCENARIO, F_SCENARIO_28, TRUE);
    evt_finish();
}

#if CHRIS
event on_aot_04
#else
event from_main
#endif
{
    run
    {
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_6, F_6_17, FALSE);
    }
#if CHRIS
    evt_fork(9, on_aot_03_sub2, 0);
#else
    evt_fork(9, on_aot_03_sub1, 0);
#endif
    sleep(40);
    message(MSG_THERE_IS_A_SWITCH_BELOW | MSG_FAST, 255); // "There's a switch below. Will you push it?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_ROOM, F_ROOM_0F, TRUE);
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            set(FG_ROOM, F_ROOM_0E, TRUE);
            aot_delete(AOT_0B_USEITEM, SCE_NONE, 0);
#if CHRIS
            evt_exec(0, 9, on_aot_04_sub1);
#else
            evt_exec(0, 9, from_main_sub1);
#endif
        }
        else
        {
#if CHRIS
            evt_exec(0, 9, on_aot_03_sub3);
#else
            evt_exec(0, 9, from_main_sub2);
#endif
        }
    }
    evt_finish();
}

