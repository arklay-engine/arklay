#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_111 0x00
#define AOT_01_DOOR_11C 0x01
#define AOT_01_MESSAGE_NO_KEY 0x01                          // The 11C door before the second playthrough: "You don't have the key".
#define AOT_02_ITEM_HEAL_HERB_GREEN_0 0x02
#define AOT_03_ITEM_HEAL_HERB_GREEN_1 0x03
#define AOT_04_ITEM_INK_2 0x04
#define AOT_05_MESSAGE_NOTHING 0x05                         // "Nothing special."; off once the ink ribbon is taken.
#define AOT_06_MESSAGE_NOTHING_MAJOR 0x06
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_ZOMBIE 0x00
#define IMDL_00_HEAL_HERB_GREEN 0x00
#define IMDL_01_HEAL_HERB_GREEN 0x01
#define IMDL_02_INK 0x02

proc init
{
    door_aot_set(AOT_00_DOOR_111, 1500, 14400, 900, 2100, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 7, 0, ROOM_111_DRESSING_ROOM, 22500, 0, 11300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_SCENARIO, F_SCENARIO_SECOND_PLAYTHROUGH, TRUE))
    {
        door_aot_set(AOT_01_DOOR_11C, 1200, 5200, 3100, 1500, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 7, DOOR_LOCKED | F_LOCK_112_11C, ROOM_11C_WARDROBE_S, 3500, 0, 4500, 1024, IT_38_KEY_CLOSET, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_set(AOT_01_MESSAGE_NO_KEY, 1200, 5200, 3100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    }
    item_aot_set(AOT_02_ITEM_HEAL_HERB_GREEN_0, 10250, 6500, 1000, 1000, IT_44_HEAL_HERB_GREEN, 1, IMDL_00_HEAL_HERB_GREEN, SCA_NONE, 10750, 0, 7000, -600, F_ITEM_112_HEAL_HERB_GREEN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_03_ITEM_HEAL_HERB_GREEN_1, 8200, 6500, 1000, 1000, IT_44_HEAL_HERB_GREEN, 1, IMDL_01_HEAL_HERB_GREEN, SCA_NONE, 8700, 0, 7000, -500, F_ITEM_112_HEAL_HERB_GREEN_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    if (ck(FG_STATUS, F_STATUS_REGION_JPN, FALSE) && ck(FG_STATUS, F_STATUS_REGION_EUR, FALSE))
    {
        item_aot_set(AOT_04_ITEM_INK_2, 3180, 9230, 1000, 1000, IT_2F_KEY_INK_RIBBON, 2, IMDL_02_INK, SCA_NONE, 3680, -1000, 9730, 0, F_ITEM_112_INK_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    }
    else
    {
        item_aot_set(AOT_04_ITEM_INK_2, 3180, 9230, 1000, 1000, IT_2F_KEY_INK_RIBBON, 3, IMDL_02_INK, SCA_NONE, 3680, -1000, 9730, 0, F_ITEM_112_INK_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    }
    if (ck(FG_ITEM, F_ITEM_112_INK_2, TRUE))
    {
        aot_set(AOT_05_MESSAGE_NOTHING, 2200, 9200, 2000, 1400, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_05_MESSAGE_NOTHING, 2200, 9200, 2000, 1400, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    }
    aot_set(AOT_06_MESSAGE_NOTHING_MAJOR, 11200, 9000, 2000, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    scene_setup(1, 4100, 10000, 5700);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        enemy(EM_11_ZOMBIE_GREEN, EB_02, F_ENEMY_112_ZOMBIE_GREEN_0, SPAWN_FORCE, 2, 0, 2048, 0, 10000, 0, 12600, ENEMY_00_ZOMBIE, ANIM_00, 0, EVAR_00);
    }
    else
    {
        enemy(EM_06_HUNTER, EB_07, F_ENEMY_112_HUNTER_0, SPAWN_FORCE, 2, 0, 1776, 0, 11211, 0, 11654, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
    }
}

proc main
{
    if (testpickup(IT_2F_KEY_INK_RIBBON))
    {
        aot_delete(AOT_05_MESSAGE_NOTHING, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
}
