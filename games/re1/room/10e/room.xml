    <language lang="en-US">
      <string key="name">EMPLOYEE ROOM</string>
      <string key="save_name">M. Room 1F</string>
      <string key="1">{scroll 2}It's a map of 1ST FLOOR.\nWill you take it? {branch 0 1 0}{scroll 2}\nNone of them looks useful.{scroll 10}</string>
      <string key="2">{scroll 2}\nNone of them looks useful.{scroll 10}</string>
      <string key="3">{scroll 2}\nNothing special.{scroll 10}</string>
      <string key="4">{scroll 2}You got the\nmap of 1ST FLOOR.{scroll 10}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}小部屋/{s}1{s}F{s}</string>
      <string key="1">{scroll 2}    館1階の地図がある\n取りますか?    {branch 0 1 0}{scroll 2}\n 役に立ちそうな本は見当たらない{scroll 10}</string>
      <string key="2">{scroll 2}\n 役に立ちそうな本は見当たらない{scroll 10}</string>
      <string key="3">{scroll 2}\n     特に何もない{scroll 10}</string>
      <string key="4">{scroll 2}\n   館1階の地図を入手した{scroll 10}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Chambre RdC</string>
      <string key="1">{scroll 2}C'est un plan du rez-de-chaussée.\nLe prendre?{branch 0 1 0}</string>
      <string key="2">{scroll 2}\nRien d'utile.{scroll 10}</string>
      <string key="3">{scroll 2}\nRien de spécial.{scroll 10}</string>
      <string key="4">{scroll 2}\nVous avez le plan du rez-de-chaussée.{scroll 10}</string>
      <string when="MANSION2" key="4">{scroll 2}Vous avez le plan \ndu rez-de-chaussée.{scroll 10}</string>
    </language>
    <language lang="de-DE">
      <string key="1">{scroll 2}Ein Plan des\n{color 1}ERDGESCHOSSES{color 0}.{clear 0}{scroll 2}Möchten Sie sie mitnehmen?\n{branch 0 6 0}</string>
      <string when="MANSION2" key="1">{scroll 2}Das ist eine Karte der\n{color 1}ERDGESCHOSSES{color 0}.{clear 0}{scroll 2}Möchten Sie sie mitnehmen?\n{branch 0 6 0}</string>
      <string key="2">{scroll 2}\nNichts von Nutzen.{scroll 10}</string>
      <string key="3">{scroll 2}\nNichts Besonderes.{scroll 10}</string>
      <string key="4">{scroll 2}Sie besitzen jetzt\nden Plan des {color 1}ERDGESCHOSSES{color 0}.{scroll 10}</string>
      <string when="MANSION2" key="4">{scroll 2}Sie besitzen jetzt die Karte\nder {color 1}ERDGESCHOSSES{color 0}.{scroll 10}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Villa 1P</string>
      <string key="1">{scroll 2}È la mappa del PIANO TERRA.\nLa vuoi prendere?{branch 0 1 0}</string>
      <string when="MANSION2" key="1">{scroll 2}È la pianta del PIANO TERRA.\nLa vuoi prendere?{branch 0 1 0}</string>
      <string key="2">{scroll 2}\nNessuno di questi sembra utile.{scroll 10}</string>
      <string key="3">{scroll 2}\nNiente di speciale.{scroll 10}</string>
      <string key="4">{scroll 2}\nHai la mappa del PIANO TERRA.{scroll 10}</string>
    </language>
    <language lang="es-ES">
      <string key="1">{scroll 2}Es un mapa de la planta baja...\n¿Te lo llevas? {branch 0 6 0}</string>
      <string key="2">{scroll 2}\nNada parece útil...{scroll 10}</string>
      <string key="3">{scroll 2}\nNada especial...{scroll 10}</string>
      <string key="4">{scroll 2}Ahora tienes el mapa\nde la planta baja...{scroll 10}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Мед. комната 1-эт.</string>
