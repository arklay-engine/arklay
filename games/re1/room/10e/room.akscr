        tw_set_rot(0, 5, 0);
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event diary_closet_zombie_player_turns
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0002);
    act_param_set(0, 2048);
    for (41)
    {
        evt_next();
    }
    act_idle();
    act_reset();
    evt_finish();
}

event closet_zombie_dead_music
{
    bgm_volume_ramp(BGM_SUB_2, -95, 30);
    sleep(30);
    bgm_stop(BGM_SUB_2);
    sleep(5);
    bgm_play(BGM_MAIN);
    evt_finish();
}

event take_map_1f_unused
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_EFFECTS, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_MAP_ANIM_DONE, 0);
    sleep(26);
    act_reset();
    evt_nop();
    message(MSG_IT_IS_A_MAP_OF_1ST_WILL_YOU_TAKE_IT_01 | MSG_FAST, RUN_CONTROLS | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's a map of 1ST FLOOR. Will you take it? None of them looks useful."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_reset(AOT_02_ITEM_AMMO_SHOTGUN_1, SCE_F, SAT_MANUAL | SAT_PLAYER, 0, 1, 0);
            aot_on(AOT_02_ITEM_AMMO_SHOTGUN_1, SCE_F, 0);
            message(MSG_YOU_GOT_THE_MAP_OF_1ST | MSG_FAST, RUN_CONTROLS | RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "You got the map of 1ST FLOOR."
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_MAP_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_EFFECTS, TRUE);
    }
    evt_finish();
}

event diary_becomes_document
{
    aot_reset(AOT_03_ITEM_FILE_KEEPERS_DIARY_2, SCE_DOCUMENT, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    aot_on(AOT_03_ITEM_FILE_KEEPERS_DIARY_2, SCE_DOCUMENT, 0);
    evt_finish();
}
