    <language lang="en-US">
      <string key="name">ROOM 001</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">{scroll 2}\nThere's a key in the cup.{scroll 1}</string>
      <string key="1">{scroll 2}It's dark outside and I\ncan't see anything.{scroll 1}</string>
      <string key="2">{scroll 2}\nNothing unusual.{scroll 1}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
