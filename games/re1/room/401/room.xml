      <string key="0">{scroll 2}\nIl y a une clé dans la coupe.{scroll 1}</string>
      <string key="1">{scroll 2}Il fait sombre dehors et je\nne peux rien voir.{scroll 1}</string>
      <string key="2">{scroll 2}\nRien d'utile.{scroll 1}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Da liegt ein Schlüssel\nin der Schale.{scroll 1}</string>
