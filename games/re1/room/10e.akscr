    tw_rot_add();
    evt_next();
    tw_set_rot(0, 90, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 100, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 100, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 124, 0);
    tw_rot_add();
    evt_next();
    tw_end();
    evt_nop();
    se_play_3d(SND_BANK_ROOM, SE_18_CLST_HIT, 0, SND_AT_POINT, 0, 4040, 2120);
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_rot(0, 226, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 236, 0);
    tw_rot_add();
    evt_next();
    for (6)
    {
        tw_set_rot(0, 246, 0);
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    for (10)
    {
        tw_set_rot(0, 251, 0);
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

