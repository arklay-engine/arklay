event on_aot_03_item_sub3
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 0 | 2, 0 | 0);
    act_flag_op(1, 2, 0);
    act_param_set(0, 8);
    for (41)
    {
        evt_next();
    }
    act_idle();
    act_reset();
    evt_finish();
}

event from_main
{
    bgm_volume_ramp(BGM_SUB_2, 161, 30);
    sleep(30);
    bgm_stop(BGM_SUB_2);
    sleep(5);
    bgm_play(BGM_MAIN);
    evt_finish();
}

event event_05
{
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, FALSE);
        set(FG_MESSAGE, F_MESSAGE_EFFECTS, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    sleep(26);
    act_reset();
    evt_nop();
    message(MSG_IT_IS_A_MAP_OF_1ST_WILL_YOU_TAKE_IT_01 | MSG_FAST, MSG_PAUSE_CONTROLS | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "It's a map of 1ST FLOOR. Will you take it? None of them looks useful."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_reset(AOT_02_ITEM, SCE_F, SAT_MANUAL | SAT_PLAYER, 0, 1, 0);
            aot_on(AOT_02_ITEM, SCE_F, 0);
            message(MSG_YOU_GOT_THE_MAP_OF_1ST | MSG_FAST, MSG_PAUSE_CONTROLS | MSG_PAUSE_0080 | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "You got the map of 1ST FLOOR."
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_EFFECTS, TRUE);
    }
    evt_finish();
}

event on_aot_03_item_2
{
    aot_reset(AOT_03_ITEM, SCE_DOCUMENT, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    aot_on(AOT_03_ITEM, SCE_DOCUMENT, 0);
    evt_finish();
}
