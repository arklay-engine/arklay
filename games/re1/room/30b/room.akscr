event boulder_starts
{
    run
    {
        cutnext(CAM_04);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_ROOM, F_ROOM_BOULDER_SOUNDS, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_HIT_A, TRUE);
        bgm_play(BGM_SUB_1);
    }
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4000, -1280, 11500);
    tw_set_pos(1, 0, 0);
    tw_set_rot(1, 0, 0);
    for (5)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, F_ROOM_SE_ROCK_HIT_A, TRUE);
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_set_pos(2, 0, 0);
    tw_set_rot(0, 0, 1);
    for (25)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(6, 0, 0);
    tw_set_rot(-1, 0, 2);
    for (10)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(8, 0, 0);
    tw_set_rot(0, 0, 3);
    for (10)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(12, 1, 0);
    tw_set_rot(1, 0, 4);
    for (18)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(18, 2, 0);
    tw_set_rot(0, 0, 6);
    for (16)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(26, 10, 0);
    tw_set_rot(-1, 0, 10);
    for (14)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_ROOM, F_ROOM_SE_ROCK_HIT_A, TRUE);
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_set_pos(34, -5, 0);
    tw_set_rot(0, 0, 14);
    for (12)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(50, -2, 0);
    tw_set_rot(0, 0, 18);
    for (10)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(80, 0, 0);
    tw_set_rot(2, 0, 26);
    for (5)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(100, 0, 0);
    tw_set_rot(-2, 0, 30);
    for (20)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 2000, -2380, 14700);
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, F_ROOM_BOULDER_START_DONE, TRUE);
        cutcurr(0);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_delete(AOT_06_EVENT_CHASE_CAMERA, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
        aot_delete(AOT_07_USEITEM_BOULDER_PATH, SCE_USEITEM, SAT_UNDER | SAT_PLAYER);
        aot_delete(AOT_09_EVENT_ALCOVE, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
    }
    evt_finish();
}

event crushed_by_boulder
{
    evt_disable(TASK_01);
    evt_disable(TASK_02);
    evt_disable(TASK_05);
    evt_disable(TASK_06);
    evt_fork(TASK_01, crushed_boulder_rolls_on, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_34, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(7);
    run
    {
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -900, 0, 0);
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -400, 0, 0);
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -200, 0, 0);
    }
    sleep(8);
    objtbl_b_set(TBL_OBJ, OBJ_00_BOULDER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    sleep(10);
    evt_disable(TASK_07);
    run
    {
        objs_hide(0);
        set(FG_STATUS, F_STATUS_SCREEN_SHAKE, FALSE);
        set(FG_STATUS, F_STATUS_PLAYER_DEAD, TRUE);
        bgm_stop(BGM_SUB_1);
    }
    evt_finish();
}

