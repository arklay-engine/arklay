        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -200, 0, 0);
    }
    sleep(10);
    objtbl_b_set(TBL_OBJ, OBJ_00_BOULDER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    sleep(8);
    evt_disable(TASK_07);
    run
    {
        objs_hide(0);
        set(FG_STATUS, F_STATUS_SCREEN_SHAKE, FALSE);
        set(FG_STATUS, F_STATUS_PLAYER_DEAD, TRUE);
        bgm_stop(BGM_SUB_1);
    }
    evt_finish();
}

event dodge_boulder
{
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_set_sel(TW_POS_Z, 16000);
    tw_end();
    evt_nop();
    evt_fork(TASK_03, boulder_smashes, 0);
    run
    {
        aot_delete(AOT_09_EVENT_ALCOVE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        dir_set(0, 0, 900, 0, 21600, 0, 18300);
        cutnext(CAM_00);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    evt_next();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_BOULDER_SMASHED, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_OBJ, OBJ_00_BOULDER, 0, 16, 8);
    sleep(30);
    act_motion_bitclr();
    act_nop();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    sleep(30);
    act_motion_bitclr();
    act_nop();
    sleep(30);
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_SET, EF_0001);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    act_idle();
    act_reset();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_ROOM, F_ROOM_IN_BOULDER_PATH, FALSE);
        bgm_play(BGM_SUB_2);
    }
    evt_finish();
}

event boulder_smashes
{
    evt_disable(TASK_05);
    objtbl_b_set(TBL_OBJ, OBJ_00_BOULDER, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_BOULDER_ROLL_DONE, FALSE));
    set(FG_ROOM, F_ROOM_BOULDER_SOUNDS, FALSE);
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_set_pos(121, 0, 0);
    tw_set_rot(0, 0, 99);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(121, 0, 0);
    tw_set_rot(0, 0, 99);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(121, 0, 0);
    tw_set_rot(0, 0, 100);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(121, 0, 0);
    tw_set_rot(0, 0, 100);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        effect(FX_09, FX_ROW_10, FX_AT_WORLD, 24600, -1240, 12200, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_WORLD, 24600, -1240, 12200, 1024);
        effect(FX_06, FX_ROW_03, FX_AT_WORLD, 24600, -1240, 12200, 1024);
        effect(FX_06, FX_ROW_03, FX_AT_WORLD, 24600, -1240, 12200, 1024);
        set(FG_ROOM, F_ROOM_BOULDER_SOUNDS, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_BREAK, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_1D, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_set_pos(121, 0, 0);
    tw_set_rot(0, 0, 102);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, F_ROOM_SE_ROCK_BREAK, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_1D, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    for (30)
    {
        tw_pos_rot_add();
        tw_pos_rot_add();
        evt_next();
        tw_nop();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_disable(TASK_05);
    evt_disable(TASK_06);
    evt_disable(TASK_07);
    run
    {
        set(FG_ROOM, F_ROOM_SE_ROCK_STOP, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_1F, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_20, TRUE);
    }
    evt_fork(TASK_05, boulder_at_rest, 0);
    set(FG_STATUS, F_STATUS_SCREEN_SHAKE, TRUE);
    sleep(1);
    run
    {
        set(FG_ROOM, F_ROOM_SE_ROCK_STOP, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_1F, TRUE);
        set(FG_ROOM, F_ROOM_SE_ROCK_20, TRUE);
    }
    sleep(4);
    bgm_stop(BGM_SUB_1);
    sleep(25);
    run
    {
        set(FG_ROOM, F_ROOM_BOULDER_SMASHED, TRUE);
        set(FG_ROOM, F_ROOM_IN_BOULDER_PATH, FALSE);
        aot_delete(AOT_07_USEITEM_BOULDER_PATH, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        set(FG_STATUS, F_STATUS_SCREEN_SHAKE, FALSE);
    }
    evt_finish();
}

event lock_chase_camera
{
    aot_delete(AOT_06_EVENT_CHASE_CAMERA, SCE_NONE, SAT_UNDER | SAT_PLAYER);
    cut_auto(CUT_LOCKED);
    evt_finish();
}

event boulder_rumble_loop
{
    set(FG_STATUS, F_STATUS_SCREEN_SHAKE, TRUE);
    set(FG_ROOM, F_ROOM_SE_ROCK_HIT_A, TRUE);
    sleep(20);
    set(FG_STATUS, F_STATUS_SCREEN_SHAKE, FALSE);
    set(FG_ROOM, F_ROOM_SE_ROCK_HIT_B, TRUE);
    sleep(4);
    evt_chain(boulder_rumble_loop);
    evt_finish();
}

event boulder_dust_loop
{
    run
    {
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 2480, -2600, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 2480, 2600, 3072);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 2080, -2600, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 2080, 2600, 3072);
    }
    sleep(7);
    run
    {
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 1240, -2600, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 1240, 2600, 3072);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 1040, -2600, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 1040, 2600, 3072);
    }
    sleep(7);
    run
    {
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 0, -2600, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 0, 2600, 3072);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 0, -2600, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 0, 2600, 3072);
    }
    sleep(6);
    evt_chain(boulder_dust_loop);
    evt_finish();
}

event boulder_debris_loop
{
    effect(FX_06, FX_ROW_03, FX_AT_OBJ | OBJ_00_BOULDER, 2300, 2680, -2000, 0);
    sleep(12);
    effect(FX_06, FX_ROW_02, FX_AT_OBJ | OBJ_00_BOULDER, 2000, 2680, 2000, 0);
    sleep(4);
    effect(FX_06, FX_ROW_03, FX_AT_OBJ | OBJ_00_BOULDER, 4000, 2680, 0, 0);
    sleep(6);
    evt_chain(boulder_debris_loop);
    evt_finish();
}

