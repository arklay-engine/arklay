#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_307 0x00
#define AOT_01_DOOR_30C 0x01
#define AOT_02_ITEM_AMMO_GRENADE_FLAME_0 0x02
#define AOT_02_ITEM_AMMO_MAGNUM_0 0x02
#define AOT_03_ITEM_WEAPON_FLAMETHROWER_1 0x03
#define AOT_04_EVENT_FLAMETHROWER_HOOK 0x04                 // Becomes an event while the flamethrower is carried.
#define AOT_05_EVENT_BOULDER_TRIGGER 0x05                   // Becomes the boulder event once F_ROOM_BOULDER_ARMED is raised.
#define AOT_06_EVENT_CHASE_CAMERA 0x06                      // Turned on as the boulder starts: locks the camera.
#define AOT_07_USEITEM_BOULDER_PATH 0x07                    // Turned on as the boulder starts: raises F_ROOM_IN_BOULDER_PATH.
#define AOT_08_USEITEM_BOULDER_PATH_2 0x08
#define AOT_09_EVENT_ALCOVE 0x09                            // Turned on as the boulder starts: the player ducks out of its way.
#define AOT_0A_USEITEM_BOULDER_ARM 0x0A                     // The floor by the boulder: arms the trigger.
#define AOT_0B_USEITEM_AMBUSH_ZONE 0x0B                     // Turned on after the boulder: raises F_ROOM_IN_AMBUSH_ZONE.
#define AOT_0C_MESSAGE_FLAMETHROWER_HOOK 0x0C               // Becomes a message while the flamethrower is gone and not carried.
#define CAM_00 0x00
#define CAM_02 0x02
#define CAM_04 0x04
#define CAM_05 0x05
#define CAM_07 0x07
#define COL_04 0x04
#define COL_05 0x05
#define ENEMY_00_HUNTER 0x00
#define ENEMY_01_HUNTER 0x01
#define FX_00 0x00
#define FX_06 0x06
#define FX_09 0x09
#define F_ROOM_AMBUSH_PENDING 0x1E                          // The hunters' ambush has not started yet.
#define F_ROOM_BOULDER_ARMED 0x1F                           // The player stepped by the boulder (one frame): its trigger turns on.
#define F_ROOM_BOULDER_AT_REST 0x17                         // The boulder has stopped at the far end; main places it per camera.
#define F_ROOM_BOULDER_ROLL_DONE 0x19                       // The boulder's roll is over.
#define F_ROOM_BOULDER_SMASHED 0x1A                         // The boulder hit the end wall; the chase is over.
#define F_ROOM_BOULDER_SOUNDS 0x1C                          // Main plays the rock sounds the F_ROOM_SE_ROCK_* bits ask for.
#define F_ROOM_BOULDER_START_DONE 0x18                      // The boulder's starting shot is over: it rolls next.
#define F_ROOM_IN_AMBUSH_ZONE 0x1D                          // The player is in the ambush zone (each frame).
#define F_ROOM_IN_BOULDER_PATH 0x21                         // The player is in the boulder's path (each frame).
#define F_ROOM_IN_BOULDER_PATH_2 0x22                       // Guess: picks the third crush animation.
#define F_ROOM_PLAYER_ANIM_DONE 0x20                        // The player's animation finished (one frame).
#define F_ROOM_SE_ROCK_1D 0x0D                              // Asks main to play SE_1D.
#define F_ROOM_SE_ROCK_1F 0x0F                              // Asks main to play SE_1F.
#define F_ROOM_SE_ROCK_20 0x10                              // Asks main to play SE_20.
#define F_ROOM_SE_ROCK_BREAK 0x0C                           // Asks main to play SE_1C_RCK_BROK.
#define F_ROOM_SE_ROCK_HIT_A 0x0A                           // Asks main to play SE_1A_RCK_HITA.
#define F_ROOM_SE_ROCK_HIT_B 0x0B                           // Asks main to play SE_1B_RCK_HITB.
#define F_ROOM_SE_ROCK_STOP 0x0E                            // Asks main to play SE_1E_RCK_STOP.
#define IMDL_00_AMMO_GRENADE_FLAME 0x00
#define IMDL_00_AMMO_MAGNUM 0x00
#define IMDL_01_WEAPON_FLAMETHROWER 0x01
#define OBJ_00_BOULDER 0x00
#define OBJ_01_FLAMETHROWER_HOOK 0x01
#define SE_18_LOCKOUTA 0x18
#define SE_19_LOCKOUTB 0x19
#define SE_1A_RCK_HITA 0x1A
#define SE_1B_RCK_HITB 0x1B
#define SE_1C_RCK_BROK 0x1C
#define SE_1D 0x1D
#define SE_1E_RCK_STOP 0x1E
#define SE_1F 0x1F
#define SE_20 0x20
#define SE_BGM_17 0x17
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define ZONE_01 0x01
#define ZONE_03 0x03
#define ZONE_0B 0x0B

proc init
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        door_aot_set(AOT_00_DOOR_307, 21800, 18800, 2200, 2600, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | F_LOCK_307_30B, ROOM_307_LADDER_PASSAGE, 3600, 0, 3900, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        door_aot_set(AOT_00_DOOR_307, 21800, 18800, 2200, 2600, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_307_LADDER_PASSAGE, 3600, 0, 3900, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    door_aot_set(AOT_01_DOOR_30C, 25600, 300, 4300, 2900, 11, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30C_BLACK_TIGER_ROOM, 10700, 0, 12500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        item_aot_set(AOT_02_ITEM_AMMO_MAGNUM_0, 2030, 9800, 1200, 1200, IT_0E_AMMO_MAGNUM, 6, IMDL_00_AMMO_MAGNUM, SCA_NONE, 2630, -2060, 10400, 0, F_ITEM_30B_AMMO_MAGNUM_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        item_aot_set(AOT_02_ITEM_AMMO_GRENADE_FLAME_0, 2030, 9800, 1200, 1200, IT_12_AMMO_GRENADE_FLAME, 6, IMDL_00_AMMO_GRENADE_FLAME, SCA_NONE, 2620, -1880, 9780, 400, F_ITEM_30B_AMMO_GRENADE_FLAME_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        item_aot_set(AOT_03_ITEM_WEAPON_FLAMETHROWER_1, 20400, 17700, 1000, 1300, IT_06_WEAPON_FLAMETHROWER, 240, IMDL_01_WEAPON_FLAMETHROWER, SCA_NONE, 21190, -3100, 17840, 0, F_ITEM_30B_WEAPON_FLAMETHROWER_1, SAT_MANUAL | SAT_PLAYER, 0);
        swap_var(XFER_RESTORE, AOT_03_ITEM_WEAPON_FLAMETHROWER_1, B_0D);
    }
    obj(OBJ_00_BOULDER, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 2000, -2480, 14500, 0, 0, 0, 0, 0, 2700, 2800, 2800, 2800);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        obj(OBJ_01_FLAMETHROWER_HOOK, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 21090, -3072, 17840, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    }
    aot_set(AOT_04_EVENT_FLAMETHROWER_HOOK, 20400, 17700, 1000, 1300, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, flamethrower_hook, 0, 0, 0);
    set(FG_STATUS, F_STATUS_SCREEN_BORDER, TRUE);
    if (ck(FG_SCENARIO, F_SCENARIO_30B_BOULDER_ROLLED, FALSE))
    {
        aot_set(AOT_05_EVENT_BOULDER_TRIGGER, 11000, 12000, 2000, 4000, SCE_NONE, SAT_UNDER | SAT_PLAYER, 0, 0, boulder_trap, 0, 0, 0);
        aot_set(AOT_06_EVENT_CHASE_CAMERA, 14600, 11200, 4500, 6400, SCE_NONE, SAT_UNDER | SAT_PLAYER, 3, 0, lock_chase_camera, 0, 0, 0);
        aot_set(AOT_07_USEITEM_BOULDER_PATH, 400, 11600, 30000, 5300, SCE_NONE, SAT_UNDER | SAT_PLAYER, 4, 0, 33, 0, 1, 0);
        aot_set(AOT_08_USEITEM_BOULDER_PATH_2, 1500, 11300, 21700, 6000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 34, 0, 1, 0);
        aot_set(AOT_09_EVENT_ALCOVE, 21000, 16000, 4000, 4400, SCE_NONE, SAT_UNDER | SAT_PLAYER, 2, 0, dodge_boulder, 0, 0, 0);
        aot_set(AOT_0A_USEITEM_BOULDER_ARM, 0, 12000, 9000, 4000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 31, 0, 1, 0);
    }
    else
    {
        evt_exec(0, TASK_00, boulder_at_rest);
        inst_cfg(COL_LIST_00, COL_05, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_01, COL_04, 0, 0, 0, 2, 2);
        msgnode_set(ZONE_0B, CAM_02, CAM_07);
        msgnode_set(ZONE_01, CAM_00, CAM_07);
        msgnode_set(ZONE_03, CAM_00, CAM_07);
        set(FG_ROOM, F_ROOM_BOULDER_AT_REST, TRUE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_ROCK_PASSAGE_AMBUSH, FALSE))
    {
        aot_set(AOT_0B_USEITEM_AMBUSH_ZONE, 0, 9600, 8600, 8000, SCE_NONE, SAT_UNDER | SAT_PLAYER, 4, 0, 29, 0, 1, 0);
        enemy(EM_06_HUNTER, EB_82, F_ENEMY_30B_HUNTER_0, SPAWN_FORCE, 1, 0, 0, 0, 100, 0, 100, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        enemy(EM_06_HUNTER, EB_82, F_ENEMY_30B_HUNTER_1, SPAWN_FORCE, 1, 0, 0, 0, 200, 0, 200, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        set(FG_ROOM, F_ROOM_AMBUSH_PENDING, TRUE);
    }
    else
    {
        enemy(EM_06_HUNTER, EB_02, F_ENEMY_30B_HUNTER_0, SPAWN_FORCE, 1, 0, 2400, 0, 27800, 0, 11600, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        enemy(EM_06_HUNTER, EB_02, F_ENEMY_30B_HUNTER_1, SPAWN_FORCE, 1, 0, 2400, 0, 27800, 0, 11600, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        aot_set(AOT_0C_MESSAGE_FLAMETHROWER_HOOK, 20400, 17700, 1000, 1300, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    }
    if (ck(FG_ITEM, F_ITEM_30B_WEAPON_FLAMETHROWER_1, FALSE))
    {
        evt_exec(0, TASK_09, hook_raised);
        set(FG_LOCK, F_LOCK_307_30B, FALSE);
        if (item_ck(IT_06_WEAPON_FLAMETHROWER))
        {
            aot_delete(AOT_04_EVENT_FLAMETHROWER_HOOK, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_0C_MESSAGE_FLAMETHROWER_HOOK, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        }
    }
    else
    {
        set(FG_LOCK, F_LOCK_307_30B, TRUE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_BOULDER_BGM, FALSE))
    {
        room_bgm_state_set(2, ROOM_30B_ROCK_PASSAGE, BGM_MAIN_ON);
    }
    else
    {
        room_bgm_state_set(2, ROOM_30B_ROCK_PASSAGE, BGM_SUB_2_ON);
    }
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
}

proc main
{
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        set(FG_MAP, F_MAP_VISITED_311, TRUE);
    }
    if (ck(FG_ROOM, F_ROOM_IN_BOULDER_PATH, TRUE) && ck_counter(0, DIST_OBJ, OBJ_00_BOULDER, 4500))
    {
        aot_delete(AOT_07_USEITEM_BOULDER_PATH, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        if (ck_tween(0, 1024, 3072))
        {
            evt_exec(0, TASK_04, crushed_by_boulder);
        }
        else if (ck(FG_ROOM, F_ROOM_IN_BOULDER_PATH_2, TRUE))
        {
            evt_exec(0, TASK_04, crushed_by_boulder_3);
        }
        else
        {
            evt_exec(0, TASK_04, crushed_by_boulder_2);
        }
    }
    if (ck(FG_ROOM, F_ROOM_BOULDER_ARMED, TRUE))
    {
        set(FG_ROOM, F_ROOM_BOULDER_ARMED, FALSE);
        aot_delete(AOT_05_EVENT_BOULDER_TRIGGER, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_30B_BOULDER_ROLLED, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_BOULDER_AT_REST, TRUE) && ck(FG_STATUS, F_STATUS_CAMERA_REDRAW, TRUE))
        {
            if (cmpb(B_CAMERA, CMP_EQ, CAM_07))
            {
                evt_exec(0, TASK_09, boulder_pos_cam_07);
            }
            else
            {
                evt_exec(0, TASK_09, boulder_pos_other_cams);
            }
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (testpickup(IT_06_WEAPON_FLAMETHROWER))
        {
            evt_exec(0, TASK_09, flamethrower_taken);
            set(FG_LOCK, F_LOCK_307_30B, FALSE);
            set(FG_ITEM, F_ITEM_30D_WEAPON_FLAMETHROWER_0, FALSE);
        }
        if (testitem(IT_06_WEAPON_FLAMETHROWER))
        {
            set(FG_ITEM, F_ITEM_30D_WEAPON_FLAMETHROWER_0, FALSE);
            set(FG_ITEM, F_ITEM_30B_WEAPON_FLAMETHROWER_1, TRUE);
            setbyte(1, 1, 0);
            evt_exec(0, TASK_09, place_flamethrower);
            evt_exec(0, TASK_09, place_flamethrower_model);
        }
    }
    if (ck(FG_ROOM, F_ROOM_IN_AMBUSH_ZONE, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_04))
    {
        set(FG_ROOM, F_ROOM_IN_AMBUSH_ZONE, FALSE);
        set(FG_ROOM, F_ROOM_AMBUSH_PENDING, FALSE);
        set(FG_SCENARIO, F_SCENARIO_ROCK_PASSAGE_AMBUSH, TRUE);
        set(FG_ENEMY, F_ENEMY_30B_HUNTER_1, TRUE);
        aot_delete(AOT_0B_USEITEM_AMBUSH_ZONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        evt_exec(0, TASK_09, hunter_bursts_in);
    }
    if (ck(FG_ROOM, F_ROOM_AMBUSH_PENDING, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        set(FG_ROOM, F_ROOM_IN_AMBUSH_ZONE, FALSE);
        set(FG_ROOM, F_ROOM_AMBUSH_PENDING, FALSE);
        set(FG_SCENARIO, F_SCENARIO_ROCK_PASSAGE_AMBUSH, TRUE);
        set(FG_ENEMY, F_ENEMY_30B_HUNTER_0, TRUE);
        aot_delete(AOT_0B_USEITEM_AMBUSH_ZONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        pos_set(ENEMY_01_HUNTER, 0, 3072, 0, 27800, 0, 5000);
        eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, EB_02);
    }
    if (ck(FG_ROOM, F_ROOM_BOULDER_SOUNDS, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_SE_ROCK_HIT_A, TRUE))
        {
            set(FG_ROOM, F_ROOM_SE_ROCK_HIT_A, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1A_RCK_HITA, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_SE_ROCK_HIT_B, TRUE))
        {
            set(FG_ROOM, F_ROOM_SE_ROCK_HIT_B, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1B_RCK_HITB, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_SE_ROCK_BREAK, TRUE))
        {
            set(FG_ROOM, F_ROOM_SE_ROCK_BREAK, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1C_RCK_BROK, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_SE_ROCK_1D, TRUE))
        {
            set(FG_ROOM, F_ROOM_SE_ROCK_1D, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1D, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_SE_ROCK_STOP, TRUE))
        {
            set(FG_ROOM, F_ROOM_SE_ROCK_STOP, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1E_RCK_STOP, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_SE_ROCK_1F, TRUE))
        {
            set(FG_ROOM, F_ROOM_SE_ROCK_1F, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_1F, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
        if (ck(FG_ROOM, F_ROOM_SE_ROCK_20, TRUE))
        {
            set(FG_ROOM, F_ROOM_SE_ROCK_20, FALSE);
            se_play_3d(SND_BANK_ROOM, SE_20, 0, SND_AT_PLAYER, 0, 31300, 14400);
        }
    }
}

event boulder_trap
{
    run
    {
        set(FG_SCENARIO, F_SCENARIO_30B_BOULDER_ROLLED, TRUE);
        set(FG_RUN, F_RUN_READY, FALSE);
        aot_delete(AOT_05_EVENT_BOULDER_TRIGGER, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        aot_delete(AOT_0A_USEITEM_BOULDER_ARM, SCE_NONE, SAT_UNDER | SAT_PLAYER);
    }
    evt_fork(TASK_01, boulder_starts, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_BOULDER_START_DONE, FALSE));
    evt_fork(TASK_01, boulder_rolls, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_BOULDER_ROLL_DONE, FALSE));
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_BOULDER_SMASHED, FALSE));
    run
    {
        cut_auto(CUT_FREE);
        msgnode_set(ZONE_0B, CAM_02, CAM_07);
        msgnode_set(ZONE_01, CAM_00, CAM_07);
        msgnode_set(ZONE_03, CAM_00, CAM_07);
        inst_cfg(COL_LIST_00, COL_05, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_01, COL_04, 0, 0, 0, 2, 2);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_SCENARIO, F_SCENARIO_BOULDER_BGM, TRUE);
        set(FG_ROOM, F_ROOM_BOULDER_AT_REST, TRUE);
        aot_delete(AOT_0B_USEITEM_AMBUSH_ZONE, SCE_USEITEM, SAT_UNDER | SAT_PLAYER);
    }
    evt_finish();
}

event boulder_rolls
{
    evt_fork(TASK_05, boulder_debris_loop, 0);
    evt_fork(TASK_06, boulder_dust_loop, 0);
    evt_fork(TASK_07, boulder_rumble_loop, 0);
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_set_pos(65, 2, 0);
    tw_set_rot(0, 0, 34);
    tw_pos_rot_add();
    evt_next();
    tw_set_pos(85, 4, 0);
    tw_set_rot(0, 0, 36);
    for (2)
    {
        tw_pos_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(35, 6, 0);
    tw_set_rot(0, 0, 19);
    for (3)
    {
        tw_pos_rot_add();
        tw_pos_rot_add();
        evt_next();
        tw_nop();
    }
    tw_nop();
    tw_set_pos(45, 8, 0);
    tw_set_rot(0, 0, 20);
    for (4)
    {
        tw_pos_rot_add();
        tw_pos_rot_add();
        evt_next();
        tw_nop();
    }
    tw_nop();
    tw_set_pos(35, 30, 0);
    tw_set_rot(0, 0, 22);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(40, -40, 0);
    tw_set_rot(0, 0, 24);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(45, -60, 0);
    tw_set_rot(0, 0, 26);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(40, -48, 0);
    tw_set_rot(0, 0, 28);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(45, -28, 0);
    tw_set_rot(0, 0, 30);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(45, 8, -10);
    tw_set_rot(3, 0, 40);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(50, 28, -14);
    tw_set_rot(4, 0, 46);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(55, 48, -18);
    tw_set_rot(5, 0, 42);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(65, 16, -22);
    tw_set_rot(6, 0, 42);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(70, -12, 40);
    tw_set_rot(-18, 0, 42);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(75, -16, 12);
    tw_set_rot(0, 0, 44);
    tw_pos_rot_add();
    tw_pos_rot_add();
    evt_next();
    tw_nop();
    tw_set_pos(75, -12, 6);
    tw_set_rot(0, 0, 46);
    tw_pos_rot_add();
    tw_pos_rot_add();
