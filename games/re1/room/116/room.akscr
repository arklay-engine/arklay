    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 5, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 8, 0);
    for (4)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 10, 0);
    for (5)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 5, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    for (4)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, -1, 0);
