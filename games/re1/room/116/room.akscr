    evt_next();
    tw_end();
    evt_next();
    evt_finish();
}

event place_shotgun_on_rack
{
    run
    {
        require(item_ck(IT_03_WEAPON_SHOTGUN));
        swap_var(XFER_HELD, AOT_01_ITEM_WEAPON_SHOTGUN_0, B_0C);
        setb(B_SELECTED_ITEM, IT_03_WEAPON_SHOTGUN, 0);
        set(FG_STATUS, F_STATUS_MENU_KEY_DEPLETED, TRUE);
    }
    evt_finish();
}

event ceiling_down_sound
{
    sleep(10);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_19_CEILPRES, 6, SND_AT_POINT, 0, 4700, 10380);
        se_play_3d(SND_BANK_ROOM, SE_1A, 6, SND_AT_POINT, 0, 4700, 10380);
    }
    evt_finish();
}
