    aot_delete(AOT_05_USEITEM_RACK_BROKEN_SHOTGUN, SCE_NONE, SAT_PLAYER);
    aot_delete(AOT_06_EVENT_RACK_SHOTGUN, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    evt_work_set(WK_AOT, IMDL_00_WEAPON_SHOTGUN);
    evt_tween_begin_alt();
    tw_abs_pos(0, 10950, -3208, 6490);
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
