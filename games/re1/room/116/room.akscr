    tw_end();
    evt_next();
    aot_delete(AOT_01_ITEM_WEAPON_SHOTGUN_0, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
    evt_finish();
}

event broken_shotgun_placed
{
