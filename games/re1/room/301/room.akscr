event ride_elevator_down
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, ride_elevator_down_platform);
        evt_exec(0, TASK_09, ride_elevator_down_player);
        se_play_3d(SND_BANK_ROOM, SE_21_ELV1, 0, SND_AT_POINT, 0, 3000, 11300);
        sys_multi(SYS_HIT, HIT_80);
    }
    sleep(70);
    timer_setup(LIGHT_FADE_VEIL, 2176, FADE_R | FADE_G | FADE_B);
    sleep(7);
    run
    {
        setw(W_LIGHT_DELTA, 0);
        aot_on(AOT_01_DOOR_302, SCE_DOOR, 129);
        set(FG_SCENARIO, F_SCENARIO_ELEVATOR_301_DOWN, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event ride_elevator_down_platform
{
    evt_work_set(WK_OBJ, OBJ_07_ELEVATOR);
    evt_tween_begin_alt();
    tw_set_pos(0, 25, 0);
    for (70)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event ride_elevator_down_player
{
    for (70)
    {
        spd_add(25);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 25, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    evt_finish();
}

event arrive_from_302
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, arrive_from_302_platform);
        evt_exec(0, TASK_09, arrive_from_302_player);
        se_play_3d(SND_BANK_ROOM, SE_22_ELV2, 0, SND_AT_POINT, 0, 3000, 11300);
    }
    sleep(110);
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event arrive_from_302_platform
{
    evt_work_set(WK_OBJ, OBJ_07_ELEVATOR);
    evt_tween_begin_alt();
    tw_set_pos(0, -25, 0);
    for (100)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event arrive_from_302_player
{
    for (100)
    {
        spd_add(-25);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, -25, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    evt_finish();
}

