event open_water_gate_first
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2D, F_ROOM_PLAYER_ANIM_DONE, AFL_01);
    act_flag_op(EF_OR, EF_0020);
    act_param_set(0, 64512);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    message(MSG_THE_WATER_IS_RUNNING_DOWN_THE | MSG_FAST, 0); // "The water is running down the opposite side."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        aot_reset(AOT_02_C_CHANNEL_LADDER_A, SCE_C, SAT_MANUAL | SAT_PLAYER, 1, 22250, 11223);
        aot_reset(AOT_03_C_CHANNEL_LADDER_B, SCE_C, SAT_MANUAL | SAT_PLAYER, 0, 22250, 25146);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
        set(FG_SCENARIO, F_SCENARIO_WATER_GATE_OPEN, TRUE);
        set(FG_SCENARIO, F_SCENARIO_WATER_GATE_OPENED_ONCE, TRUE);
        room_bgm_state_set(2, ROOM_300_FIRST_HOUSE_OUT, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_301_WATER_GATE, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_302_FALLS, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_304_SECOND_HOUSE_GATE, BGM_SUB_1_ON | BGM_MAIN_ON);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event open_water_gate_again
{
    run
    {
        dir_set(0, 0, 3072, 0, 12700, 0, 16700);
        aot_reset(AOT_02_C_CHANNEL_LADDER_A, SCE_C, SAT_MANUAL | SAT_PLAYER, 1, 22250, 11223);
        aot_reset(AOT_03_C_CHANNEL_LADDER_B, SCE_C, SAT_MANUAL | SAT_PLAYER, 0, 22250, 25146);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
        set(FG_SCENARIO, F_SCENARIO_WATER_GATE_OPEN, TRUE);
        room_bgm_state_set(2, ROOM_300_FIRST_HOUSE_OUT, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_301_WATER_GATE, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_302_FALLS, BGM_SUB_1_ON | BGM_MAIN_ON);
        room_bgm_state_set(2, ROOM_304_SECOND_HOUSE_GATE, BGM_SUB_1_ON | BGM_MAIN_ON);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}
