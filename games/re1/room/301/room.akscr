    tw_abs_pos(0, 8250, 5690, 19634);
    tw_set_pos(0, -77, 0);
    for (50)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

