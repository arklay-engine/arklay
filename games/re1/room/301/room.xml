  <strings>
    <language lang="en-US">
      <string key="name">WATER GATE</string>
      <string key="save_name">Courtyard Room B1</string>
      <string key="0">\nThere's a square hole.</string>
      <string key="1">A water passage.\nThere's a ladder.</string>
      <string key="2">The water is running down\nthe opposite side.</string>
      <string key="3">A winch for the elevator.\nThe elevator is down.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">中庭 {s}部屋/{s}B{s}1{s}</string>
      <string key="0">\n   四角形のさしこみ口がある</string>
      <string key="1">\n   用水路だ ハシゴがある</string>
      <string key="2">\n 水は向こうに流れ落ちているようだ</string>
      <string key="3">  エレベーターのまき上げ機だ\n  エレベーターは下に降りている</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Salle de la cour SS1</string>
      <string key="0">\nIl y a un trou carré.</string>
      <string key="1">Un conduit d'eau.\nIl y a une échelle.</string>
      <string key="2">\nL'eau coule dans l'autre sens.</string>
      <string key="3">Un treuil pour l'ascenseur.\nL'ascenseur est en bas.</string>
    </language>
    <language lang="de-DE">
      <string key="0">\nDa ist ein quadratisches Loch.</string>
      <string key="1">Ein Wasserlauf.\nDa ist eine Leiter.</string>
      <string key="2">Das Wasser läuft auf\nder anderen Seite herunter.</string>
      <string key="3">Eine Winde für den Aufzug.\nDer Aufzug ist unten.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Cortile S1</string>
      <string key="0">\nC'è un foro quadrato.</string>
      <string key="1">Un passaggio d'acqua.\nC'è una scala.</string>
      <string key="2">L'acqua sta scorrendo dal \nlato opposto.</string>
      <string key="3">Un argano per l'ascensore. \nL'ascensore è rimasto giù.</string>
    </language>
    <language lang="es-ES">
      <string key="0">\nHay un agujero cuadrado...</string>
      <string key="1">Un conducto para el agua...\nHay una escalera...</string>
      <string key="2">El agua está vaciándose\nhacia el otro lado...</string>
      <string key="3">Un torno para el ascensor...\nEl ascensor está abajo...</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната внутр. двора Б1</string>
      <string key="0">\nЗдесь квадратное отверстие</string>
      <string key="1">Воды слишком много,\nмне не пройти.{clear 0}\nЗдесь есть лестница.</string>
      <string key="2">Платина открыта,\nвода уходит.</string>
      <string key="3">Лебедка для лифта.\nЛифт не работает.</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Maanalainen varasto 0 krs</string>
      <string key="0">Siinä on neliön muotoinen kolo...</string>
      <string key="1">Veden alla näkyy kulkureitti...\nSinne laskeutuu tikkaat...</string>
      <string key="2">Vesi virtaa alas...</string>
      <string key="3">Hissin vinssi...\nHissi on alhaalla...</string>
    </language>
  </strings>
</room>
