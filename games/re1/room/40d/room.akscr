event box_3_falls
{
    run
    {
        aot_delete(AOT_02_EVENT_BOX_DROP, SCE_NONE, 0);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        objtbl_b_set(TBL_OBJ, OBJ_02_BOX_3, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_ACTIVE);
        eml_pos(OBJ_02_BOX_3, 0, 0, 0, 27850, 0, 14630);
    }
    evt_fork(TASK_09, box_3_falls_tilt, 0);
    evt_fork(TASK_09, box_3_falls_sink, 0);
    evt_fork(TASK_09, box_3_shoves_box_2, 0);
    evt_fork(TASK_09, box_3_shoves_box_2_tilt, 0);
    sleep(46);
    se_play_3d(SND_BANK_ROOM, SE_17_INWATER, 0, SND_AT_POINT, 0, 27850, 14000);
    evt_fork(TASK_09, box_splash, 0);
    sleep(26);
    run
    {
        set(FG_SCENARIO, F_SCENARIO_BOXES_SUNK_BIT0, TRUE);
        set(FG_SCENARIO, F_SCENARIO_BOXES_SUNK_BIT1, TRUE);
        objtbl_b_set(TBL_OBJ, OBJ_06_CHANNEL_BLOCK, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_INTANGIBLE | OF_ACTIVE);
        objtbl_b_set(TBL_OBJ, OBJ_03_BOX_1, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_INTANGIBLE | OF_ACTIVE);
        objtbl_b_set(TBL_OBJ, OBJ_01_BOX_2, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_INTANGIBLE | OF_ACTIVE);
        objtbl_b_set(TBL_OBJ, OBJ_02_BOX_3, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_INTANGIBLE | OF_ACTIVE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

