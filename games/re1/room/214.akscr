#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define FLAG_ROOM_18 0x18

proc init
{
#if CHRIS
    door_aot_set(0, 22800, 5200, 2900, 1600, 0, 0, 3, 1, 0, ROOM_213_FRONT_ELEVATOR, 2500, 0, 6600, 0, UNLOCKED, 129);
    aot_set(1, 10100, 25300, 1700, 2400, SCE_USEITEM, 129, 4, 0, 24, 0, 1, 0);
#else
    door_aot_set(0, 10100, 25300, 1700, 2400, 2, 0, 0, 1, 0, ROOM_201_2F_LEFT_STAIRS, 15500, 0, 25400, 1024, UNLOCKED, 129);
    door_aot_set(1, 22800, 5200, 2900, 1600, 0, 0, 3, 1, 0, ROOM_213_FRONT_ELEVATOR, 2500, 0, 6600, 0, UNLOCKED, 129);
#endif
    item_aot_set(2, 17200, 2000, 1900, 1900, ITEM_44_HEAL_HERB_GREEN, 1, 0, 255, 124, 71, 0, 0, 140, 10, 0, 0, 169, 129, 1, 0);
    item_aot_set(3, 21500, 2000, 1900, 1900, ITEM_45_HEAL_HERB_BLUE, 1, 1, 255, 228, 87, 0, 0, 140, 10, 0, 0, 170, 129, 1, 0);
    item_aot_set(4, 19500, 2000, 1900, 1900, ITEM_44_HEAL_HERB_GREEN, 1, 2, 255, 20, 80, 0, 0, 140, 10, 0, 0, 171, 129, 1, 0);
#if JILL
    aot_set(5, 10100, 25300, 1700, 2400, SCE_USEITEM, 129, 4, 0, 24, 0, 1, 0);
#endif
    enemy(ENEMY_11_ZOMBIE_LAB, 1, 139, 1, 2, 0, 0, 3584, 0, 0, 19100, 0, 3200, 0, 0, 0, 0);
    enemy(ENEMY_11_ZOMBIE_LAB, 7, 140, 1, 2, 0, 0, 1656, 0, 0, 15900, 0, 28000, 1, 0, 0, 0);
    enemy(ENEMY_11_ZOMBIE_LAB, 35, 141, 1, 2, 0, 0, 768, 0, 0, 15000, 0, 27600, 2, 0, 0, 0);
#if JILL
    if (ck(FG_SCENARIO, FLAG_SCENARIO_46, FALSE))
    {
        aot_delete(0, SCE_NONE, 129);
    }
    else
    {
        aot_delete(5, SCE_NONE, 129);
    }
#endif
    if (ck(FG_ENEMY, FLAG_ENEMY_8D, TRUE))
    {
        eml_state(0, 1, 0, 0);
    }
}

proc main
{
    if (ck(FG_ROOM, FLAG_ROOM_18, TRUE))
    {
        se_play_3d(2, 20, 0, 0, 0, 11000, 25300);
        message(128, 255);
        set(FG_ROOM, FLAG_ROOM_18, FALSE);
    }
}
