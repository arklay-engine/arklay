event on_aot_03
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_fork(TASK_09, on_aot_03_sub1, 0);
    evt_next();
    evt_nop();
    spd_add(-2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(-3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(-3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    for (80)
    {
        spd_add(-25);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, -25, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    run
    {
        if (ck(FG_STATUS, F_STATUS_08, FALSE))
        {
            setb(B_CHARACTER_MODEL, 0, 0);
        }
        else
        {
            setb(B_CHARACTER_MODEL, 1, 0);
        }
        aot_on(AOT_00_DOOR, SCE_DOOR, 0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event on_enter_sub1
{
    evt_work_set(WK_OBJ, OBJ_02);
    evt_tween_begin_alt();
    tw_abs_pos(0, 24300, -2000, 2360);
    tw_end();
    evt_next();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_22_ELV2, 0, SND_AT_POINT, 0, 24300, 2360);
        se_play_3d(SND_BANK_ROOM, SE_22_ELV2, 0, SND_AT_POINT, 0, 24300, 2360);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_work_set(WK_OBJ, OBJ_02);
    evt_tween_begin_alt();
    tw_set_pos(0, 25, 0);
    for (70)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 10, 0);
    for (25)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_finish();
}

event on_enter
{
    evt_fork(TASK_09, on_enter_sub1, 0);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 3072, 0, 24200, -2000, 3650);
        spd_set(ENT_PLAYER, -2000);
    }
    for (70)
    {
        spd_add(25);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 25, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    for (25)
    {
        spd_add(10);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 10, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    spd_add(-3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(-2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

