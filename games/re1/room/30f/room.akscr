    act_anim_flags(ANIM_34, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(15);
    objtbl_b_set(TBL_OBJ, OBJ_00_BOULDER, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    run
    {
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -200, 0, 0);
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -600, 0, 0);
        effect(FX_00, FX_ROW_03, FX_AT_PLAYER, 0, -1000, 0, 0);
    }
    sleep(10);
    evt_disable(TASK_07);
    run
    {
        objs_hide(0);
        set(FG_STATUS, F_STATUS_SCREEN_SHAKE, FALSE);
        set(FG_STATUS, F_STATUS_PLAYER_DEAD, TRUE);
        bgm_stop(BGM_SUB_1);
    }
    evt_finish();
}

