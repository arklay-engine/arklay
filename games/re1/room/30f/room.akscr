        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 0, 2400, 3072);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 0, -2400, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 0, 2400, 3072);
