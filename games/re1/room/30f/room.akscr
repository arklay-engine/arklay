event examine_map
{
    message(MSG_IT_IS_A_MAP_OF_UNDER | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's a map of UNDER GROUND. Will you take it? You got the map of UNDER GROUND."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        require(cmpb(B_MENU_CHOICE, CMP_EQ, 0));
        aot_on(AOT_04_ITEM_MAP_UNDERGROUND_0, SCE_F, 129);
        aot_delete(AOT_0C_EVENT_MAP, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    evt_finish();
}

event ride_elevator_up_platform
{
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_21_ELV1, 0, SND_AT_POINT, 0, 24300, 2360);
        se_play_3d(SND_BANK_ROOM, SE_21_ELV1, 0, SND_AT_POINT, 0, 24300, 2360);
    }
    evt_work_set(WK_OBJ, OBJ_02_ELEVATOR);
    evt_tween_begin_alt();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -25, 0);
    for (80)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_finish();
}

event ride_elevator_up
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_fork(TASK_09, ride_elevator_up_platform, 0);
    evt_next();
    evt_nop();
    spd_add(-2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(-3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(-3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    for (80)
    {
        spd_add(-25);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, -25, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            setb(B_CHARACTER_MODEL, 0, 0);
        }
        else
        {
            setb(B_CHARACTER_MODEL, 1, 0);
        }
        aot_on(AOT_00_DOOR_305, SCE_DOOR, 0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event ride_elevator_down_platform
{
    evt_work_set(WK_OBJ, OBJ_02_ELEVATOR);
    evt_tween_begin_alt();
    tw_abs_pos(0, 24300, -2000, 2360);
    tw_end();
    evt_next();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_22_ELV2, 0, SND_AT_POINT, 0, 24300, 2360);
        se_play_3d(SND_BANK_ROOM, SE_22_ELV2, 0, SND_AT_POINT, 0, 24300, 2360);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_work_set(WK_OBJ, OBJ_02_ELEVATOR);
    evt_tween_begin_alt();
    tw_set_pos(0, 25, 0);
    for (70)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 10, 0);
    for (25)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_finish();
}

event ride_elevator_down
{
    evt_fork(TASK_09, ride_elevator_down_platform, 0);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 3072, 0, 24200, -2000, 3650);
        spd_set(ENT_PLAYER, -2000);
    }
    for (70)
    {
        spd_add(25);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 25, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    for (25)
    {
        spd_add(10);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 10, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    spd_add(-3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(3);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(-2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    spd_add(2);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

