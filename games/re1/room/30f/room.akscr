        aot_delete(AOT_0E_USEITEM_BOULDER_PATH_SIDE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03_CORRIDOR_EAST_END))
        {
            eml_pos(OBJ_00_BOULDER, 0, 0, 0, 31000, -2000, 24120);
        }
        else
        {
            eml_pos(OBJ_00_BOULDER, 0, 0, 0, 29373, -2000, 24120);
        }
        if (ck(FG_ROOM, F_ROOM_PLAYER_CRUSHED, FALSE))
        {
            inst_cfg(COL_LIST_00, COL_06, 0, 27198, 21060, 33570, 27432);
            inst_cfg(COL_LIST_00, COL_07, 0, 27396, 24552, 31338, 28188);
        }
        objtbl_b_set(TBL_OBJ, OBJ_00_BOULDER, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
        set(FG_STATUS, F_STATUS_SCREEN_SHAKE, TRUE);
        set(FG_ROOM, F_ROOM_SND_ROCK_STOP, TRUE);
        set(FG_ROOM, F_ROOM_SND_ROCK_STOP_2, TRUE);
        set(FG_ROOM, F_ROOM_SND_ROCK_STOP_3, TRUE);
        set(FG_ROOM, F_ROOM_BOULDER_AT_REST, TRUE);
        bgm_stop(BGM_SUB_1);
    }
    sleep(30);
    run
    {
        set(FG_ROOM, F_ROOM_BOULDER_STOPPED, TRUE);
    }
    evt_disable(TASK_06);
    evt_finish();
}

event boulder_starts
{
    run
    {
        cutnext(CAM_07_MAP_CORNER);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_ROOM, F_ROOM_BOULDER_SOUNDS_ON, TRUE);
