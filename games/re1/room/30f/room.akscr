        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 2080, 2400, 3072);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 1680, -2400, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 1680, 2400, 3072);
    }
    sleep(7);
    run
    {
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 1040, -2400, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, 500, 1040, 2400, 3072);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 640, -2400, 1024);
        effect(FX_09, FX_ROW_10, FX_AT_OBJ | OBJ_00_BOULDER, -500, 640, 2400, 3072);
    }
