event boulder_reset
{
    objtbl_b_set(TBL_OBJ, OBJ_00_BOULDER, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    evt_work_set(WK_OBJ, OBJ_00_BOULDER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 29373, -2000, 24120);
    tw_abs_rot(0, 0, 0, 0);
    tw_finish();
}

event turn_crank
{
    run
    {
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    for (4)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_37, F_ROOM_PLAYER_ANIM_DONE, 0);
        act_flag_op(EF_SET, EF_0080);
        act_reset();
        evt_nop();
        evt_fork(TASK_09, turn_crank_handle, 0);
        evt_fork(TASK_09, turn_crank_passage, 0);
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    }
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_ROOM, F_ROOM_WALL_REFRESH, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_CRANK_TURNS_BIT0, FALSE))
        {
            set(FG_SCENARIO, F_SCENARIO_CRANK_TURNS_BIT0, TRUE);
        }
        else if (ck(FG_SCENARIO, F_SCENARIO_CRANK_TURNS_BIT1, FALSE))
        {
            set(FG_SCENARIO, F_SCENARIO_CRANK_TURNS_BIT0, FALSE);
            set(FG_SCENARIO, F_SCENARIO_CRANK_TURNS_BIT1, TRUE);
        }
        else
        {
            set(FG_SCENARIO, F_SCENARIO_CRANK_TURNS_BIT0, FALSE);
            set(FG_SCENARIO, F_SCENARIO_CRANK_TURNS_BIT1, FALSE);
        }
        eml_pos(OBJ_03_CRANK, 0, 0, 0, 1, 1, 1);
        set(FG_STATUS, F_STATUS_SCRIPT_ONLY_11, TRUE);
        set(FG_STATUS, F_STATUS_CAMERA_REDRAW, TRUE);
        set(FG_ROOM, F_ROOM_CRANK_TURNED, TRUE);
        aot_on(AOT_06_USEITEM_CRANK_HOLE, SCE_USEITEM, 1);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event turn_crank_passage
{
    run
    {
        set(FG_STATUS, F_STATUS_SCREEN_SHAKE, TRUE);
        se_play_3d(SND_BANK_ROOM, SE_17_R_PASS, 0, SND_AT_POINT, 0, 17000, 24050);
    }
    evt_work_set(WK_OBJ, OBJ_01_ROTATING_PASSAGE);
    evt_tween_begin_alt();
    for (16)
    {
        tw_set_rot(-1, 0, 0);
        tw_rot_add();
        evt_next();
        tw_set_rot(-3, 0, 0);
        tw_rot_add();
        evt_next();
        tw_set_rot(-8, 0, 0);
        tw_rot_add();
        evt_next();
        tw_set_rot(-3, 0, 0);
        tw_rot_add();
        evt_next();
        tw_set_rot(-1, 0, 0);
        tw_rot_add();
        tw_nop();
    }
    tw_nop();
    tw_end();
    evt_nop();
    set(FG_STATUS, F_STATUS_SCREEN_SHAKE, FALSE);
    evt_finish();
}

