        {
            set(FG_ROOM, 1, 0);
        }
        else if (ck(FG_ROOM, 2, 1))
        {
            set(FG_ROOM, 2, 0);
        }
        set(FG_ROOM, 5, 1);
    }
    evt_finish();
}

