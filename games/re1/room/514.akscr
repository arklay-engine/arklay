    act_motion_path(113, 400, 0, 2, 40, 0);
#if CHRIS
    act_anim_seq(22530, 63515, 8234);
#else
    act_anim_seq(22530, 63515, 9002);
#endif
    act_nop();
    act_reset();
    evt_nop();
    sleep(80);
    run
    {
        cutnext(CAM_03);
        dir_set(0, 0, 1024, 0, 3300, 0, 10000);
