    act_anim_seq(AB_02, 2937, 5403, F_ROOM_J_BARRY_ANIM_DONE);
    act_reset();
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 2446, -2600, 5440, 192, 64);
    sleep(6);
    act_anim_flags(ANIM_2D, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_param_set(0, 64512);
    act_flag_op(EF_OR, EF_0002);
    sleep(30);
    act_anim_seq(AB_06, 2937, 5403, F_ROOM_PLAYER_ANIM_DONE);
    act_reset();
    sleep(10);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_2D, F_ROOM_J_BARRY_ANIM_DONE, 0);
    act_param_set(0, 64512);
    sleep(30);
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 192, 64);
    act_anim_flags(ANIM_22, F_ROOM_J_BARRY_ANIM_DONE, 0);
    sleep(25);
    act_anim_flags(ANIM_26, F_ROOM_J_BARRY_ANIM_DONE, 0);
    sleep(30);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_J_BARRY_ANIM_DONE, 0);
    sleep(5);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_flags(ANIM_2E, F_ROOM_J_BARRY_ANIM_DONE, 0);
    act_param_set(0, 1024);
    sleep(30);
    act_anim_flags(ANIM_24, F_ROOM_J_BARRY_ANIM_DONE, 0);
    sleep(20);
    act_reset();
    evt_nop();
    cutnext(CAM_01);
    pos_set(ENEMY_00_BARRY, 0, 0, 0, 0, 30000, 0);
    sleep(10);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_POINT, 0, 2434, 4925);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_J_BARRY_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(50);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 2434, 4925);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_COMMON, F_COMMON_J_RESEARCHER_WILL_TAKEN, TRUE);
        cut_auto(CUT_FREE);
        sys_multi(SYS_IDLE);
    }
    evt_finish();
}

event barry_shows_researchers_will_barry_reads
{
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_33, -200, 300, 0, 50, 44);
    sleep(10);
    act_motion_path(MOTION_33, 0, 300, 0, 20, 44);
    sleep(10);
    act_motion_path(MOTION_33, 200, 300, 0, 20, 44);
    sleep(10);
    act_motion_path(MOTION_33, -200, 300, 0, 20, 44);
    sleep(10);
    act_reset();
    evt_chain(barry_shows_researchers_will_barry_reads);
    evt_finish();
}

event barry_shows_researchers_will_jill_reads
