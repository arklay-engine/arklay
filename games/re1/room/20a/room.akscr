event examine_switch
{
    message(MSG_IT_SEEMS_SOMEONE_HAS_SEARCHED_HERE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It seems someone has searched here already... It appears to be a switch. Will you push it? There's something at the back of the shelf."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_01, push_switch);
        }
    }
    evt_finish();
}

event push_switch
{
    run
    {
        if (!EUR)
        {
            se_play_3d(SND_BANK_ROOM, SE_18_SW_PUSH, 0, SND_AT_POINT, 0, 3200, 1800);
        }
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_05_SWITCH);
        set(FG_ROOM, F_ROOM_SWITCH_PUSHED, TRUE);
        if (EUR)
        {
            se_play_3d(SND_BANK_ROOM, SE_18_SW_PUSH, 0, SND_AT_POINT, 0, 3200, 1800);
        }
    }
    sleep(10);
    evt_fork(TASK_02, drain_aquarium, 0);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 400, 0, 1, 100, 64);
    sleep(16);
    act_motion_path(MOTION_11, 6565, -2600, 5035, 180, 64);
    sleep(8);
    act_motion(MOTION_10);
    act_anim_flags(ANIM_2D, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0002);
    act_param_set(0, 64512);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    act_motion_path(MOTION_11, 6565, -2600, 5035, 240, 64);
    act_reset();
    evt_nop();
    sleep(10);
    cutnext(CAM_04_AQUARIUM);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_WATER_DRAINED, FALSE));
    cutnext(CAM_05_SWITCH);
    evt_work_set(WK_OBJ, OBJ_01_AQUARIUM_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 20000, 0);
    tw_end();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    run
    {
        aot_reset(AOT_02_MESSAGE_SWITCH, SCE_NONE, 0, 0, 0, 0);
        aot_reset(AOT_06_USEITEM_AQUARIUM, SCE_NONE, 0, 0, 0, 0);
        set(FG_SCENARIO, F_SCENARIO_AQUARIUM_DRAINED, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
        sys_multi(SYS_IDLE);
    }
    evt_finish();
}

event find_researchers_will
{
    run
    {
        aot_reset(AOT_01_MESSAGE_ARRANGED, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 255, 0);
        aot_reset(AOT_08_ITEM_FILE_RESEARCHERS_WILL, SCE_DOCUMENT, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
        aot_on(AOT_08_ITEM_FILE_RESEARCHERS_WILL, SCE_DOCUMENT, 0);
        if (CHRIS)
        {
            set(FG_COMMON, F_COMMON_C_RESEARCHER_WILL_TAKEN, TRUE);
        }
        else
        {
            set(FG_COMMON, F_COMMON_J_RESEARCHER_WILL_TAKEN, TRUE);
        }
    }
    evt_finish();
}

event aquarium_too_heavy
{
    objtbl_b_set(TBL_OBJ, OBJ_00_AQUARIUM, OF_10 | OF_ACTIVE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_PLAYER_ANIM_DONE, 0);
    sleep(10);
    act_anim_flags(ANIM_31, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck_bits(TRUE, PAD_0001));
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_32, F_ROOM_PLAYER_ANIM_DONE, 0);
    sleep(10);
    act_idle();
    act_reset();
    run
    {
        objtbl_b_set(TBL_OBJ, OBJ_00_AQUARIUM, OF_ACTIVE);
        set(FG_ROOM, F_ROOM_TOO_HEAVY_RUNNING, FALSE);
        message(MSG_IT_IS_TOO_HEAVY_TO_MOVE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's too heavy to move."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_READY, TRUE);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

