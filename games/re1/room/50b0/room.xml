    </language>
    <language lang="fr-FR">
      <string key="save_name">Laboratoire SS3</string>
      <string key="0">{scroll 0}\nChris! {scroll 1}{timed 45}</string>
      <string key="1">{scroll 0}\nJill! {scroll 1}{timed 45}</string>
      <string key="2">{scroll 0}\nChris, Wesker, il est...{scroll 1}{clear 50}{scroll 0}\nJe sais. {scroll 1}{clear 35}{scroll 0}Zut! Ça ne s'ouvre pas!\nÉcoute,{scroll 1}{clear 70}{scroll 0}Jill. Attends-moi ici,\nje te sauverai!{scroll 1}{clear 100}{scroll 0}\nOK, je t'attends.{scroll 1}{timed 60}</string>
      <string key="3">La porte est fermée \nhermétiquement.</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}\nChris!{scroll 1}{timed 45}</string>
      <string key="1">{scroll 0}\nJill!{scroll 1}{timed 45}</string>
      <string key="2">{scroll 0}\nChris, Wesker, er ist...{scroll 1}{clear 50}{scroll 0}\nich weiß.{scroll 1}{clear 35}{scroll 0}Verdammter Mist!\nSie geht nicht auf!{scroll 1}{clear 70}{scroll 0}Also, Jill, warte hier,\nich werde dich herausholen!{scroll 1}{clear 100}{scroll 0}\nOkay, ich bleibe hier.{scroll 1}{timed 60}</string>
      <string key="3">\nDie Tür ist fest verschlossen.</string>
    </language>
