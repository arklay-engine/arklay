    <language lang="ja-JP">
      <string key="save_name"> {s}研究所 {s}/{s}B{s}3{s}</string>
      <string key="0">{scroll 0}\n       クリス{scroll 1}{timed 45}</string>
      <string key="1">{scroll 0}\n       ジル{scroll 1}{timed 45}</string>
      <string key="2">{scroll 0}\n   クリス ウェスカーよ…{scroll 1}{clear 50}{scroll 0}\n      分かっている{scroll 1}{clear 40}{scroll 0}\n    ちくしょう 開かない{scroll 1}{clear 70}{scroll 0}     待っててくれ\n     必ず助けるからな{scroll 1}{clear 100}{scroll 0}\n      待ってるわ{scroll 1}{timed 60}</string>
