  <strings>
    <language lang="en-US">
      <string key="name">ROOM 003</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">{scroll 2}These books are well\narranged.{scroll 2}</string>
      <string key="1">{scroll 2}There is no time to check\nit.{scroll 2}</string>
      <string key="2">{scroll 2}I wonder where the missing\nbook is...{scroll 2}</string>
      <string key="3">{scroll 2}\nA row of red books.{clear 0}There's one white book.\nWill you take it?{branch 0 1 1}{scroll 2}\nNow a book is missing.{scroll 2}</string>
      <string key="4">{scroll 2}\nNow a book is missing.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 2}\n  実験についての本が並んでいる{scroll 2}</string>
      <string key="1">{scroll 2}\n   調べている時間はない!{scroll 2}</string>
      <string key="2">{scroll 2}\n この抜けている部分はどこに・・・{scroll 2}</string>
      <string key="3">{scroll 2}\n  赤い本がずらりと並んでいる{clear 0}白い本がまざって入れられている\n取りますか?{branch 0 1 1}{scroll 2}\n  抜けている部分が気にかかる{scroll 2}</string>
      <string key="4">{scroll 2}\n  抜けている部分が気にかかる{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Poste de garde RdC</string>
      <string key="0">{scroll 2}Les livres relatifs aux\nexpériences sont alignés.{scroll 2}</string>
      <string key="1">{scroll 2}\nPas de temps pour vérifier.{scroll 2}</string>
      <string key="2">{scroll 2}Je me demande où se trouve le\nlivre manquant...{scroll 2}</string>
      <string key="3">{scroll 2}\nUne rangée de livres rouges.{clear 0}Il y a un livre blanc. \nLe prendre?{branch 0 6 1}</string>
      <string key="4">{scroll 2}\nA présent, il manque un livre.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Dort stehen Bücher\nüber Experimente.{scroll 2}</string>
      <string key="1">{scroll 2}Es ist keine Zeit,\ndas zu überprüfen.{scroll 2}</string>
      <string key="2">{scroll 2}Ich frage mich,\nwo das fehlende Buch ist...{scroll 2}</string>
      <string key="3">{scroll 2}\nEine Reihe von roten Büchern.{clear 0}Da ist ein weißes Buch dabei.\nMöchten Sie es nehmen?{branch 0 6 1}</string>
      <string key="4">{scroll 2}\nJetzt fehlt ein Buch.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Guardiola 1P</string>
      <string key="0">{scroll 2}\nI libri sono ben riposti.{scroll 2}</string>
      <string key="1">{scroll 2}\nNon c'è tempo per controllare.{scroll 2}</string>
      <string key="2">{scroll 2}Mi chiedo dove sia il \nlibro mancante...{scroll 2}</string>
      <string key="3">{scroll 2}\nUna fila di libri rossi.{clear 0}C'è un libro bianco. \nVuoi prenderlo?{branch 0 6 1}</string>
      <string key="4">{scroll 2}\nAdesso manca un libro.{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}Estos libros están\nbien ordenados...{scroll 2}</string>
      <string key="1">{scroll 2}No hay tiempo para\nexaminarlo...{scroll 2}</string>
      <string key="2">{scroll 2}Me pregunto dónde estará\nel libro que falta...{scroll 2}</string>
      <string when="JILL" key="2">{scroll 2}Me pregunto dónde estará\nel libro ue falta...{scroll 2}</string>
      <string key="3">{scroll 2}\nUna fila de libros rojos...{clear 0}Hay un libro blanco...\n¿Te lo llevas?{branch 0 6 1}</string>
      <string key="4">{scroll 2}\nAhora falta un libro...{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната охраны 1-эт.</string>
      <string key="0">{scroll 2}\nХорошо разложенные книги.{scroll 2}</string>
      <string key="1">{scroll 2}\nНа это нет времени.{scroll 2}</string>
      <string key="2">{scroll 2}Одной книги не хватает,\nинтересно где она...{scroll 2}</string>
      <string key="3">{scroll 2}\nРяд красных книг.{clear 0}Одна книга белая.\nВзять её?{branch 0 1 1}{scroll 2}\nТеперь книги нет.{scroll 2}</string>
      <string key="4">{scroll 2}\nТеперь книги нет.{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Asuntolan varasto 1 krs</string>
      <string key="0">{scroll 2}Nämä kirjat on järjestelty\nhyvin...{scroll 2}</string>
      <string key="1">{scroll 2}Ei ole aikaa tutkia sitä...{scroll 2}</string>
      <string key="2">{scroll 2}Missä puuttuva kirja voisi olla...{scroll 2}</string>
      <string key="3">{scroll 2}Rivi punaisia kirjoja...{clear 0}Joukossa on yksi valkoinen kirja...\nPoimitko sen?{branch 0 6 1}</string>
      <string key="4">{scroll 2}Nyt joukosta uupuu kirja...{scroll 2}</string>
    </language>
  </strings>
