#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_MESSAGE 0x04
#define AOT_05_MESSAGE 0x05
#define AOT_06_USEITEM 0x06
#define AOT_07_USEITEM 0x07
#define AOT_08_USEITEM 0x08
#define AOT_09_EVENT 0x09
#define AOT_0A_MESSAGE 0x0A
#define AOT_0B_MESSAGE 0x0B
#define AOT_0C_USEITEM 0x0C
#define AOT_0D_MESSAGE 0x0D
#define AOT_0E_ITEM 0x0E
#define AOT_0F_ITEM 0x0F
#define F_ROOM_00 0x00
#define F_ROOM_01 0x01
#define F_ROOM_02 0x02
#define F_ROOM_03 0x03
#define F_ROOM_04 0x04
#define F_ROOM_05 0x05
#define F_ROOM_06 0x06
#define F_ROOM_07 0x07
#define F_ROOM_08 0x08
#define F_ROOM_0A 0x0A
#define F_ROOM_0C 0x0C
#define F_ROOM_22 0x22
#define F_ROOM_23 0x23
#define F_ROOM_24 0x24
#define MSG_POISON_GAS_IS_ESCAPING 0x03
#define MSG_THERE_IS_AN_AIR_SHAFTWILL_YOU 0x02

proc init
{
    door_aot_set(AOT_00_DOOR, 10800, 0, 2200, 2200, 6, 1, 13, 6, 173, ROOM_505_O_PASSAGE, 16600, 0, 4200, 1024, LOCK, 129);
    door_aot_set(AOT_01_DOOR, 20000, 0, 2600, 2700, 9, 1, 13, 6, 0, ROOM_50C_FRONT_OF_ELEVATOR, 6100, 0, 18000, 1024, UNLOCKED, 129);
    if (ck(FG_ITEM, F_ITEM_7B, TRUE))
    {
        item_aot_set(AOT_02_ITEM, 23930, 1380, 1800, 1800, IT_43_HEAL_HERB_RED, 1, 0, 255, 254, 96, 36, 250, 232, 8, 0, 0, 123, 129, 0, 0);
    }
    if (ck(FG_ITEM, F_ITEM_94, TRUE))
    {
        item_aot_set(AOT_03_ITEM, 13200, 9860, 1800, 1800, IT_0E_AMMO_MAGNUM, 6, 1, 255, 20, 55, 182, 244, 8, 42, 0, 0, 148, 129, 0, 132);
    }
    aot_set(AOT_04_MESSAGE, 25000, 6000, 1100, 1500, SCE_MESSAGE, 129, 128, 0, 1, 1, 0, 0);
    aot_set(AOT_05_MESSAGE, 16600, 11900, 1380, 820, SCE_MESSAGE, 129, 129, 0, 1, 1, 0, 0);
    aot_set(AOT_06_USEITEM, 16680, 9820, 1090, 1190, SCE_USEITEM, 68, 4, 0, 34, 0, 1, 0);
    aot_set(AOT_07_USEITEM, 16680, 6430, 1090, 1020, SCE_USEITEM, 68, 4, 0, 35, 0, 1, 0);
    aot_set(AOT_08_USEITEM, 17000, 8000, 900, 1000, SCE_USEITEM, 69, 4, 0, 36, 0, 1, 0);
    aot_set(AOT_09_EVENT, 15000, 8200, 1800, 500, SCE_NONE, 129, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 9600, 10800, 1800, 1800, SCE_MESSAGE, 129, 132, 0, 1, 1, 0, 0);
    aot_set(AOT_0B_MESSAGE, 2300, 9100, 8700, 1500, SCE_MESSAGE, 129, 133, 0, 1, 1, 0, 0);
    aot_set(AOT_0C_USEITEM, 2520, 5720, 2300, 1800, SCE_USEITEM, 1, 9, 0, 20, 0, 1, 0);
    aot_set(AOT_0D_MESSAGE, 2520, 5720, 2300, 1800, SCE_NONE, 1, 0, 0, 0, 0, 0, 0);
    if (ck(FG_ITEM, F_ITEM_62, TRUE))
    {
        item_aot_set(AOT_0E_ITEM, 0, 0, 1, 1, IT_6C_FILE_PASS_CODE_02, 1, 2, 255, 0, 0, 0, 0, 0, 0, 0, 0, 98, 129, 0, 0);
    }
    if (ck(FG_ITEM, F_ITEM_7C, TRUE))
    {
        item_aot_set(AOT_0F_ITEM, 23540, 7100, 1900, 1500, IT_0C_AMMO_SHOTGUN, 7, 3, 255, 216, 94, 162, 249, 116, 29, 222, 8, 124, 129, 0, 0);
    }
    obj(0, 17, 255, 22226, -500, 9880, 0, 0, 0, 0, 0, 0, 0, 0, 0, 138, 2, 132, 3, 132, 3, 132, 3);
    obj(1, 17, 255, 22210, -500, 7780, 0, 0, 0, 0, 0, 0, 0, 0, 0, 138, 2, 132, 3, 132, 3, 132, 3);
    obj(66, 81, 255, 19970, 0, 7930, 0, 118, 253, 0, 0, 94, 1, 0, 0, 44, 1, 132, 3, 76, 4, 38, 2);
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_04, FALSE))
    {
        set(FG_ROOM, F_ROOM_04, TRUE);
        evt_exec(0, 0, from_main);
    }
    if (ck(FG_ROOM, F_ROOM_05, FALSE))
    {
        set(FG_ROOM, F_ROOM_05, TRUE);
        evt_exec(0, 1, from_main_2);
    }
    if (ck(FG_ROOM, F_ROOM_06, FALSE))
    {
        set(FG_ROOM, F_ROOM_06, TRUE);
        evt_exec(0, 2, from_main_3);
    }
    if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_STATUS, F_STATUS_18, TRUE))
    {
        aot_reset(AOT_09_EVENT, SCE_EVENT, 129, 5, on_aot_09, 0);
    }
    else
    {
        aot_reset(AOT_09_EVENT, SCE_NONE, 129, 0, 0, 0);
    }
#if CHRIS
    if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_COMMON, F_COMMON_69, FALSE) && ck(FG_ROOM, F_ROOM_01, FALSE))
    {
        set(FG_ROOM, F_ROOM_01, TRUE);
        evt_exec(0, 3, from_main_4);
    }
    if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_COMMON, F_COMMON_6A, FALSE) && ck(FG_ROOM, F_ROOM_02, FALSE))
    {
        set(FG_ROOM, F_ROOM_02, TRUE);
        evt_exec(0, 4, from_main_5);
    }
    if (ck(FG_COMMON, F_COMMON_69, FALSE) && ck(FG_ROOM, F_ROOM_01, TRUE) && ck(FG_ROOM, F_ROOM_00, FALSE))
    {
        set(FG_ROOM, F_ROOM_00, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_2B, FALSE))
        {
            bgm_play(1);
        }
    }
    if (ck(FG_COMMON, F_COMMON_6A, FALSE) && ck(FG_ROOM, F_ROOM_02, TRUE) && ck(FG_ROOM, F_ROOM_00, FALSE))
    {
        set(FG_ROOM, F_ROOM_00, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_2B, FALSE))
        {
            bgm_play(1);
        }
    }
    if (ck(FG_COMMON, F_COMMON_69, TRUE) && ck(FG_ROOM, F_ROOM_01, TRUE))
    {
        set(FG_COMMON, F_COMMON_69, FALSE);
        set(FG_ROOM, F_ROOM_01, FALSE);
        task_kill(3);
    }
    if (ck(FG_COMMON, F_COMMON_6A, TRUE) && ck(FG_ROOM, F_ROOM_02, TRUE))
    {
        set(FG_COMMON, F_COMMON_6A, FALSE);
        set(FG_ROOM, F_ROOM_02, FALSE);
        task_kill(4);
    }
#else
    if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_COMMON, F_COMMON_67, FALSE) && ck(FG_ROOM, F_ROOM_01, FALSE))
    {
        set(FG_ROOM, F_ROOM_01, TRUE);
        evt_exec(0, 3, from_main_4);
    }
    if (ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_COMMON, F_COMMON_68, FALSE) && ck(FG_ROOM, F_ROOM_02, FALSE))
    {
        set(FG_ROOM, F_ROOM_02, TRUE);
        evt_exec(0, 4, from_main_5);
    }
    if (ck(FG_COMMON, F_COMMON_67, FALSE) && ck(FG_ROOM, F_ROOM_01, TRUE) && ck(FG_ROOM, F_ROOM_00, FALSE))
    {
        set(FG_ROOM, F_ROOM_00, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_2B, FALSE))
        {
            bgm_play(1);
        }
    }
    if (ck(FG_COMMON, F_COMMON_68, FALSE) && ck(FG_ROOM, F_ROOM_02, TRUE) && ck(FG_ROOM, F_ROOM_00, FALSE))
    {
        set(FG_ROOM, F_ROOM_00, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_2B, FALSE))
        {
            bgm_play(1);
        }
    }
    if (ck(FG_COMMON, F_COMMON_67, TRUE) && ck(FG_ROOM, F_ROOM_01, TRUE))
    {
        set(FG_COMMON, F_COMMON_67, FALSE);
        set(FG_ROOM, F_ROOM_01, FALSE);
        task_kill(3);
    }
    if (ck(FG_COMMON, F_COMMON_68, TRUE) && ck(FG_ROOM, F_ROOM_02, TRUE))
    {
        set(FG_COMMON, F_COMMON_68, FALSE);
        set(FG_ROOM, F_ROOM_02, FALSE);
        task_kill(4);
    }
#endif
    if (ck(FG_ROOM, F_ROOM_01, FALSE) && ck(FG_ROOM, F_ROOM_02, FALSE) && ck(FG_ROOM, F_ROOM_00, TRUE))
    {
        set(FG_ROOM, F_ROOM_00, FALSE);
        if (ck(FG_SCENARIO, F_SCENARIO_2B, FALSE))
        {
            bgm_stop(1);
        }
    }
    if (ck(FG_ROOM, F_ROOM_07, TRUE) && ck(FG_ROOM, F_ROOM_08, FALSE))
    {
        set(FG_ROOM, F_ROOM_08, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_2B, FALSE))
        {
            bgm_stop(1);
        }
        task_kill(1);
        task_kill(2);
        task_kill(3);
        task_kill(4);
    }
    if (testitem(IT_45_HEAL_HERB_BLUE) && ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        evt_exec(0, 7, event_07);
    }
    if (testitem(IT_48_HEAL_HERB_MIX_GB) && ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        evt_exec(0, 7, event_07);
    }
    if (testitem(IT_49_HEAL_HERB_MIX_GRB) && ck(FG_ROOM, F_ROOM_03, TRUE) && ck(FG_ROOM, F_ROOM_07, FALSE))
    {
        evt_exec(0, 7, event_07);
    }
    if (ck(FG_ITEM, F_ITEM_62, TRUE))
    {
        aot_reset(AOT_0D_MESSAGE, SCE_MESSAGE, 129, 134, 257, 0);
        aot_reset(AOT_0C_USEITEM, SCE_USEITEM, 1, 9, 13, 1);
    }
    else
    {
        aot_reset(AOT_0D_MESSAGE, SCE_MESSAGE, 129, 135, 257, 0);
        aot_reset(AOT_0C_USEITEM, SCE_NONE, 129, 0, 0, 0);
    }
    if (testitem(IT_28_KEY_MO_DISK))
    {
        aot_on(AOT_0E_ITEM, SCE_DOCUMENT, 0);
    }
}

event from_main
{
    do
    {
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_24, FALSE));
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_18, TRUE));
    }
    while (ck(FG_ROOM, F_ROOM_24, FALSE));
    evt_nop();
    run
    {
        se_play_3d(2, 26, 0, 0, 0, 17000, 8400);
        set(FG_ROOM, F_ROOM_03, TRUE);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_00, FALSE));
    message(MSG_POISON_GAS_IS_ESCAPING | 0x80, 257); // "Poison gas is escaping...!"
    sleep(20);
    timer_setup(3, 88, 2, 6, 0);
    set(FG_ROOM, F_ROOM_0A, TRUE);
    sleep(40);
    single(4) setw(2);
    evt_nop();
    evt_nop();
    for (15)
    {
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_0C, TRUE));
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_27, TRUE));
        do
        {
            evt_next();
        }
        while (ck(FG_6, F_6_17, FALSE));
    }
    evt_nop();
    run
    {
        sys_multi(8, 320);
        se_play_3d(3, 2, 0, 1, 0, 0, 0);
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_19, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 1, 32 | 1, 0 | 0);
    sleep(20);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    single(4) set(FG_6, F_6_00, TRUE);
    raw(0x17, 0x00, 0x07, 0x04, 0x05, 0x06, 0x19, 0x00, 0xFF, 0x00, 0x00, 0x00);
}

event from_main_2
{
    do
    {
        run
        {
            if (ck(FG_ROOM, F_ROOM_22, TRUE))
            {
#if CHRIS
                set(FG_COMMON, F_COMMON_69, TRUE);
#else
                set(FG_COMMON, F_COMMON_67, TRUE);
#endif
            }
            else
            {
#if CHRIS
                set(FG_COMMON, F_COMMON_69, FALSE);
#else
                set(FG_COMMON, F_COMMON_67, FALSE);
#endif
            }
        }
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_05, TRUE));
    evt_finish();
}

event from_main_3
{
    do
    {
        run
        {
            if (ck(FG_ROOM, F_ROOM_23, TRUE))
            {
#if CHRIS
                set(FG_COMMON, F_COMMON_6A, TRUE);
#else
                set(FG_COMMON, F_COMMON_68, TRUE);
#endif
            }
            else
            {
#if CHRIS
                set(FG_COMMON, F_COMMON_6A, FALSE);
#else
                set(FG_COMMON, F_COMMON_68, FALSE);
#endif
            }
        }
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_06, TRUE));
    evt_finish();
}

event from_main_4
{
    do
    {
        for (10)
        {
            evt_next();
        }
        single(12) effect(9, 24, 0, 168, 67, 0, 0, 4, 41);
    }
    while (ck(FG_ROOM, F_ROOM_01, TRUE));
    evt_finish();
}

event from_main_5
{
    do
    {
        for (10)
        {
            evt_next();
        }
        single(12) effect(9, 24, 0, 168, 67, 0, 0, 148, 27);
    }
    while (ck(FG_ROOM, F_ROOM_02, TRUE));
    evt_finish();
}

event on_aot_09
{
    message(MSG_THERE_IS_AN_AIR_SHAFTWILL_YOU | 0x80, 257); // "There's an air shaft.Will you enter it? Poison gas is escaping...!"
    set(FG_ROOM, F_ROOM_0C, TRUE);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 6, on_aot_09_sub1);
        }
        else
        {
            set(FG_ROOM, F_ROOM_0C, FALSE);
        }
    }
    evt_finish();
}

event on_aot_09_sub1
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    timer_setup(2, 48, 248, 7, 0);
    sleep(1);
    setw(2, 0, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        spd_set(0, 0, 0);
        dir_set(0, 0, 2048, 0, 11800, 0, 6800);
        set(FG_STATUS, F_STATUS_18, FALSE);
        msg_list(0, 56, 34, 60, 246, 80, 35, 130, 130, 130, 0, 255, 40, 24, 26, 216, 245, 24, 36, 130, 130, 130, 0, 143, 42, 176, 29, 16, 245, 24, 36, 130, 130, 130, 0, 207, 38, 111, 4, 111, 4, 96, 4);
    }
    sleep(20);
    timer_setup(2, 48, 248, 7, 0);
    cutnext(0);
    sleep(10);
#if CHRIS
    se_play_3d(2, 25, 0, 0, 0, -13072, 6800);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 1, 0 | 0);
    act_flag_op(0, 1, 0);
    act_reset();
    evt_nop();
    sleep(7);
    se_play_3d(2, 25, 0, 0, 0, -13072, 6800);
    sleep(18);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ROOM, F_ROOM_0A, TRUE))
        {
            timer_setup(3, 88, 2, 6, 0);
        }
    }
    sleep(45);
    run
    {
        if (ck(FG_ROOM, F_ROOM_0A, TRUE))
        {
            setw(2, 0, 0);
        }
        cut_auto(0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_6, F_6_17, TRUE);
        set(FG_ROOM, F_ROOM_07, TRUE);
        set(FG_6, F_6_19, TRUE);
        set(FG_ROOM, F_ROOM_0C, FALSE);
        set(FG_MAP, F_MAP_7A, TRUE);
    }
    evt_finish();
}
