        evt_tween_begin_alt();
        tw_set_rot(0, 3, 0);
        tw_rot_add();
        tw_end();
        evt_nop();
        evt_next();
        evt_work_set(WK_OBJ, 0);
        evt_tween_begin_alt();
        tw_set_rot(0, 3, 0);
        tw_rot_add();
        tw_end();
        evt_nop();
        evt_next();
        evt_work_set(WK_OBJ, 0);
        evt_tween_begin_alt();
        tw_set_rot(0, 3, 0);
        tw_rot_add();
        tw_end();
        evt_nop();
        evt_next();
        evt_work_set(WK_OBJ, 0);
        evt_tween_begin_alt();
        tw_set_rot(0, 4, 0);
        tw_rot_add();
        tw_end();
        evt_nop();
        evt_next();
    }
    evt_nop();
    evt_finish();
}

