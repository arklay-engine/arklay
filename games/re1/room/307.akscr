}

event event_05
{
    message(130, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
#if CHRIS
            setb(9, 0, 0);
#else
            setb(9, 1, 0);
#endif
            aot_on(0, SCE_DOOR, 0);
        }
    }
    evt_finish();
}
