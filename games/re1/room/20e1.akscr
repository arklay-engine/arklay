event event_08
{
    evt_fork(9, event_10, 0);
    sleep(20);
    evt_fork(9, event_09, 0);
    bgm_play(0);
    sleep(80);
    voice_play(1, 14, 0);
    sleep(15);
    message(12, 0);
    evt_fork(9, event_0A, 0);
    for (3)
    {
        evt_fork(9, event_11, 0);
        sleep(30);
    }
    evt_nop();
    evt_fork(9, event_0B, 0);
    sleep(25);
    evt_fork(9, event_0C, 0);
    sleep(40);
    evt_fork(9, event_0D, 0);
    sleep(33);
    run
    {
        bgm_stop(0);
        se_play_3d(2, 44, 0, 1, 0, 0, 0);
    }
    sleep(140);
    run
    {
        se_play_3d(0, 1, 0, 0, 0, 500, 2500);
    }
    sleep(20);
    evt_fork(9, event_0E, 0);
    evt_fork(9, event_0F, 0);
    sleep(100);
    wait_message();
    run
    {
        set(FG_COMMON, 34, 0);
        sys_multi(8, 544);
        aot_on(3, SCE_DOOR, 0);
    }
    evt_finish();
}

