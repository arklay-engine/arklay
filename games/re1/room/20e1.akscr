#version 1

proc init
{
    door_aot_set(0, 500, 2500, 1700, 3800, 1, 0, 0, 1, 0, RDT_00D, 11500, 0, 3100, 2048, UNLOCKED, 129);
    door_aot_set(1, 3200, 11400, 1700, 1600, 2, 0, 1, 4, 0, RDT_00F, 4800, 0, 11600, 1024, UNLOCKED, 129);
    door_aot_set(2, 9200, 2500, 1700, 1300, 2, 0, 7, 1, 135, RDT_010, 6100, 0, 3600, 0, ITEM_SHEILD_KEY, 129);
    door_aot_set(3, 0, 0, 1, 1, 0, 0, 0, 4, 0, RDT_100, 3500, 0, 2600, 3072, UNLOCKED, 129);
    aot_set(4, 6800, 2100, 1400, 1700, SCE_5, 129, 0, 0, 0, 0, 0, 0);
    if (ck(FG_COMMON, 67, 1))
    {
        room_bgm_state_set(1, 14, 255);
        enemy(ENEMY_ZOMBIE_GROUNDSKEEPER_, 4, 88, 1, 2, 0, 0, 1024, 0, 0, 5300, 0, 5800, 0, 0, 0, 0);
    }
    if (ck(FG_COMMON, 67, 0) && ck(FG_SCENARIO, 71, 1) && ck(FG_COMMON, 86, 1))
    {
        room_bgm_state_set(1, 14, 65);
        enemy(ENEMY_BARRY_STARS_, 0, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 0, 0, 0, 0);
        aot_set(5, 5460, 1700, 1300, 3100, SCE_EVENT, 65, 9, 0, event_00, 0, 0, 0);
    }
}

proc main
{
    if (ck(FG_COMMON, 67, 1))
    {
        aot_delete(5, SCE_NONE, 0);
    }
}

event event_00
{
    run
    {
        aot_delete(5, SCE_NONE, 0);
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        set(FG_COMMON, 86, 0);
        set(FG_SCENARIO, 71, 0);
    }
    sleep(20);
    run
    {
        if (ck(FG_COMMON, 7, 0))
        {
            evt_exec(0, 9, event_08);
        }
        else
        {
            evt_exec(0, 9, event_01);
        }
    }
    evt_finish();
}

event event_01
{
    evt_fork(9, event_07, 0);
    sleep(40);
    evt_fork(9, event_03, 0);
    bgm_play(0);
    sleep(80);
    voice_play(1, 14, 0);
    evt_fork(9, event_04, 0);
    sleep(15);
    message(12, 0);
    wait_message();
    sleep(100);
    set(FG_COMMON, 36, 0);
    evt_chain(2);
    evt_finish();
}

event event_02
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 0, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_STATUS, 15, 1);
    sleep(20);
    set(FG_6, 23, 0);
    evt_finish();
}

event event_03
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 27, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    sleep(30);
    for (3)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(32 | 28, 32 | 0, 0 | 0);
        act_reset();
        evt_nop();
        sleep(30);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(32 | 28, 32 | 0, 0 | 0);
        act_reset();
        evt_nop();
        sleep(40);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(32 | 28, 32 | 0, 0 | 0);
        act_reset();
        evt_nop();
        sleep(20);
    }
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 27, 32 | 0, 0 | 1);
    act_flag_op(0, 1, 0);
    act_reset();
    evt_nop();
    evt_finish();
}

