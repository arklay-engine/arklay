#version 1

proc init
{
    door_aot_set(0, 0, 23700, 2400, 2700, 2, 0, 0, 1, 0, RDT_001, 19000, 0, 20500, 2048, UNLOCKED, 129);
    door_aot_set(1, 2300, 1600, 1500, 1000, 1, 0, 1, 1, 146, RDT_004, 15800, 0, 3700, 1024, LOCK, 129);
    door_aot_set(2, 19600, 18200, 1900, 1000, 2, 0, 2, 1, 0, RDT_00C, 13600, 0, 7400, 2048, UNLOCKED, 129);
    door_aot_set(3, 7900, 15300, 3100, 2200, 3, 0, 0, 4, 0, RDT_00D, 5600, 0, 2800, 3072, UNLOCKED, 129);
    door_aot_set(4, 0, 10700, 2300, 1300, 2, 0, 28, 3, 139, RDT_00E, 7400, 0, 10700, 2048, ITEM_SWORD_KEY, 129);
    aot_set(5, 0, 9300, 6400, 6800, SCE_USEITEM, 65, 4, 0, 2, 0, 1, 0);
    aot_set(6, 0, 11700, 6400, 6800, SCE_USEITEM, 65, 4, 0, 3, 0, 1, 0);
    if (ck(FG_SCENARIO, 93, 0))
    {
        enemy(ENEMY_HUNTER, 16, 59, 1, 2, 0, 0, 1152, 0, 0, 5219, 0, 15022, 0, 0, 0, 0);
    }
    else
    {
        if (cmpb(3, 0, 4))
        {
            set(FG_ROOM, 0, 0);
        }
        if (cmpb(3, 0, 14))
        {
            set(FG_ROOM, 0, 0);
        }
        if (cmpb(3, 0, 1))
        {
            set(FG_ROOM, 1, 0);
        }
        if (cmpb(3, 0, 12))
        {
            set(FG_ROOM, 1, 0);
        }
    }
    if (ck(FG_ROOM, 0, 0))
    {
        enemy(ENEMY_HUNTER, 136, 59, 1, 2, 0, 0, 2048, 0, 0, 6819, 0, 14176, 0, 0, 0, 0);
    }
    if (ck(FG_ROOM, 1, 0))
    {
        enemy(ENEMY_HUNTER, 137, 59, 1, 2, 0, 0, 2048, 0, 0, 6819, 0, 14176, 0, 0, 0, 0);
    }
    if (ck(FG_STATUS, 8, 1))
    {
        enemy(ENEMY_HUNTER, 0, 58, 1, 2, 0, 0, 2192, 0, 0, 15874, 0, 22102, 1, 0, 0, 0);
        if (ck(FG_COMMON, 47, 0))
        {
            set(FG_COMMON, 48, 0);
            set(FG_COMMON, 192, 0);
            set(FG_COMMON, 47, 1);
            evt_exec(0, 9, event_00);
        }
    }
}

proc main
{
    if (ck(FG_SCENARIO, 93, 1))
    {
        if (ck(FG_ROOM, 0, 0) && ck(FG_ROOM, 2, 0))
        {
            set(FG_SCENARIO, 93, 0);
            eml_state(0, 0, 0, 8);
        }
        if (ck(FG_ROOM, 1, 0) && ck(FG_ROOM, 3, 0))
        {
            set(FG_SCENARIO, 93, 0);
            eml_state(0, 0, 0, 9);
        }
    }
}

event event_00
{
    set(FG_STATUS, 15, 0);
    sleep(1);
    set(FG_6, 23, 1);
    set(FG_6, 29, 1);
    voice_play(1, 133, 0);
    wait_message();
    evt_fork(9, event_01, 0);
    sleep(100);
    run
    {
        cut_auto(0);
        set(FG_STATUS, 15, 1);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
    }
    evt_finish();
}

event event_01
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 31, 0 | 0);
    act_param_set(0, 8);
    sleep(42);
    act_idle();
    act_finish();
}
