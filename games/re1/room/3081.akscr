#version 1

proc init
{
    door_aot_set(0, 200, 15900, 2100, 1500, 3, 1, 8, 0, 0, RDT_007, 13700, 0, 4200, 2048, UNLOCKED, 129);
    door_aot_set(1, 12800, 26400, 2100, 1700, 0, 1, 8, 0, 0, RDT_009, 4100, 0, 26800, 0, UNLOCKED, 129);
    door_aot_set(2, 11100, 2800, 2100, 1500, 0, 1, 8, 0, 0, RDT_009, 2800, 0, 4400, 0, UNLOCKED, 129);
    if (ck(FG_COMMON, 93, 1) && ck(FG_COMMON, 37, 0))
    {
        dir_set(0, 0, 3920, 0, 2800, 0, 16300);
        enemy(ENEMY_BARRY_STARS_, 4, 255, 1, 2, 0, 0, 3984, 0, 0, 5224, 0, 17102, 0, 0, 0, 0);
        evt_exec(0, 9, event_00);
        aot_reset(1, SCE_EVENT, 129, 9, event_29, 0);
    }
    if (ck(FG_COMMON, 88, 0) && ck(FG_COMMON, 72, 1) && ck(FG_COMMON, 93, 0))
    {
        if (ck(FG_COMMON, 87, 0))
        {
            enemy(ENEMY_BARRY_STARS_, 4, 255, 1, 2, 0, 0, 1288, 0, 0, 12140, 0, 28590, 0, 0, 0, 0);
            set(FG_COMMON, 87, 1);
        }
        else
        {
            enemy(ENEMY_BARRY_STARS_, 4, 255, 1, 2, 0, 0, 3288, 0, 0, 8690, 0, 3250, 0, 0, 0, 0);
        }
        evt_exec(0, 9, event_2A);
        aot_reset(0, SCE_EVENT, 129, 9, event_2B, 0);
        aot_reset(1, SCE_EVENT, 129, 9, event_29, 0);
    }
    if (ck(FG_COMMON, 72, 0))
    {
        enemy(ENEMY_HUNTER, 0, 75, 1, 2, 0, 0, 0, 0, 0, 5900, 0, 16500, 0, 0, 0, 0);
        set(FG_COMMON, 80, 0);
    }
    if (ck(FG_ENEMY, 75, 0))
    {
        enemy(ENEMY_HUNTER, 0, 76, 1, 2, 0, 0, 1024, 0, 0, 9800, 0, 13200, 0, 0, 0, 0);
        enemy(ENEMY_HUNTER, 0, 77, 1, 2, 0, 0, 3072, 0, 0, 9800, 0, 19600, 1, 0, 0, 0);
    }
}

event event_00
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        set(FG_COMMON, 93, 0);
    }
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 0, 0 | 3);
    act_param_set(0, 8);
    act_flag_op(1, 2, 0);
    act_reset();
    evt_nop();
    sleep(21);
    evt_chain(1);
    evt_finish();
}

event event_01
{
    voice_play(1, 22, 0);
    sleep(15);
    evt_fork(9, event_09, 0);
    evt_fork(9, event_0A, 0);
    message(0, 0);
    sleep(100);
    message(1, 0);
    evt_fork(9, event_0B, 0);
    sleep(110);
    message(2, 0);
    evt_fork(9, event_0C, 0);
    sleep(65);
    message(3, 0);
    evt_fork(9, event_0D, 0);
    wait_message();
    run
    {
        bgm_play(1);
    }
    message(23, 0);
    evt_fork(9, event_0E, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, event_02);
        }
        else
        {
            evt_exec(0, 9, event_05);
        }
    }
    evt_finish();
}

