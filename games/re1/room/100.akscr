event on_aot_0a
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_STATUS, F_STATUS_0F, TRUE);
    evt_fork(TASK_09, on_aot_0a_sub1, 0);
    voice_play(VOICE_PLAY, VO_007_0D_63);
    message(MSG_VO_007_0D_63, 0);
    wait_message();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

