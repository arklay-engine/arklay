    message(MSG_VO_008_00, 0);
    wait_message();
    evt_fork(TASK_09, on_enter_2_sub2, 0);
    voice_play(VOICE_PLAY, VO_008_01);
    message(MSG_VO_008_01, 0);
    wait_message();
    evt_fork(TASK_09, on_enter_2_sub3, 0);
    voice_play(VOICE_PLAY, VO_008_02);
