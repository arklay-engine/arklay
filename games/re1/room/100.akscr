    message(MSG_VO_008_05, 0);
    wait_message();
    evt_fork(TASK_09, on_enter_2_sub7, 0);
    voice_play(VOICE_PLAY, VO_008_06);
    message(MSG_VO_008_06, 0);
#else
    evt_fork(TASK_09, on_enter_sub1, 0);
    sleep(350);
    voice_play(VOICE_PLAY, VO_107_00);
#endif
    wait_message();
#if CHRIS
    pos_set(ENEMY_00_NPC_REBECCA, 0, 2048, 0, 8050, 0, 7898);
    run
    {
        sys_multi(SYS_PLAYER_FLAGS, SYS_XOR | PLF_04);
        cutnext(CAM_01);
        dir_set(0, 0, 1472, 0, 6258, 0, 7898);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 150, 75);
    act_reset();
    evt_nop();
#else
    dir_set(0, 0, 1544, 0, 6900, 0, 7948);
    cutnext(CAM_01);
    cut_auto(CUT_FREE);
    set(FG_STATUS, F_STATUS_0F, FALSE);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    sys_multi(SYS_PLAYER_FLAGS, SYS_XOR | PLF_04);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_flag_op(EF_SET, 0);
    act_reset();
    evt_nop();
#if CHRIS
    evt_chain(29);
#else
    evt_finish();
#endif
}

