event on_aot_00_door
{
    run
    {
        set(FG_COMMON, F_COMMON_39, FALSE);
        set(FG_COMMON, F_COMMON_2C, TRUE);
        aot_reset(AOT_00_DOOR, SCE_NONE, 0, 0, 0, 0);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_fork(TASK_09, on_aot_00_door_sub3, 0);
    evt_fork(TASK_09, on_aot_00_door_sub4, 0);
    voice_play(VOICE_PLAY, VO_004_0A);
    message(MSG_VO_004_0A, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_004_0B);
    message(MSG_VO_004_0B, 0);
    wait_message();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    message(MSG_WILL_YOU_TAKE_REBECCA_WITH_YOU, 0); // "Will you take Rebecca with you?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, on_aot_00_door_sub1);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_00_door_sub2);
        }
    }
    evt_finish();
}

