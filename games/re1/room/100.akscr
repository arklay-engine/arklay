event on_aot_01_2
{
    run
    {
        set(FG_COMMON, F_COMMON_3C, TRUE);
        aot_reset(AOT_01_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
        cutnext(CAM_01);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 3400, 0, 3260, 0, 2370);
        pos_set(ENEMY_00_NPC_REBECCA, 0, 2600, 0, 7294, 0, 8200);
    }
    evt_fork(TASK_09, on_aot_01_2_sub1, 0);
    evt_fork(TASK_09, on_aot_01_sub1, 0);
    sleep(100);
    voice_play(VOICE_PLAY, VO_007_07);
    message(MSG_VO_007_07, 0);
    wait_message();
    message(MSG_DO_YOU_WANT_ME_TO_HEAL, 0); // "Do you want me to heal your wounds?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            if (ck(FG_COMMON, F_COMMON_28, FALSE))
            {
                set(FG_COMMON, F_COMMON_28, TRUE);
            }
            else
            {
                set(FG_COMMON, F_COMMON_28, FALSE);
            }
            if (ck(FG_COMMON, F_COMMON_29, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_28, FALSE))
                {
                    set(FG_COMMON, F_COMMON_29, TRUE);
                }
            }
            evt_exec(0, TASK_09, on_aot_01_2_sub2);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_01_2_sub3);
        }
    }
    evt_finish();
}

