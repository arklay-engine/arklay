event on_aot_03
#else
event on_aot_05
#endif
{
    run
    {
#if CHRIS
        if (ck(FG_COMMON, F_COMMON_2D, TRUE))
        {
            aot_on(AOT_06_ITEM, SCE_ITEM, 0);
        }
        if (ck(FG_COMMON, F_COMMON_2E, TRUE))
        {
            aot_on(AOT_07_ITEM, SCE_ITEM, 0);
        }
        if (ck(FG_COMMON, F_COMMON_2D, FALSE) && ck(FG_COMMON, F_COMMON_2E, FALSE))
        {
            message(MSG_VITAMINS_AND_SERUMS_2A | MSG_FAST, RUN_READY | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "Vitamins and serums."
        }
#else
        if (ck(FG_COMMON, F_COMMON_23, TRUE))
        {
            aot_on(AOT_03_ITEM, SCE_ITEM, 0);
        }
        if (ck(FG_COMMON, F_COMMON_24, TRUE))
        {
            aot_on(AOT_04_ITEM, SCE_ITEM, 0);
        }
        if (ck(FG_COMMON, F_COMMON_23, FALSE) && ck(FG_COMMON, F_COMMON_24, FALSE))
        {
            message(MSG_VITAMINS_AND_SERUMS_2A | MSG_FAST, RUN_READY | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "Vitamins and serums."
        }
#endif
    }
    sleep(1);
    run
    {
#if CHRIS
        if (ck(FG_COMMON, F_COMMON_2D, TRUE))
        {
            if (ck(FG_ITEM, F_ITEM_17, FALSE))
            {
                set(FG_COMMON, F_COMMON_2D, FALSE);
            }
        }
        if (ck(FG_COMMON, F_COMMON_2E, TRUE))
        {
            if (ck(FG_ITEM, F_ITEM_18, FALSE))
            {
                set(FG_COMMON, F_COMMON_2E, FALSE);
            }
        }
#else
        if (ck(FG_COMMON, F_COMMON_23, TRUE))
        {
            if (ck(FG_ITEM, F_ITEM_17, FALSE))
            {
                set(FG_COMMON, F_COMMON_23, FALSE);
            }
        }
        if (ck(FG_COMMON, F_COMMON_24, TRUE))
        {
            if (ck(FG_ITEM, F_ITEM_18, FALSE))
            {
                set(FG_COMMON, F_COMMON_24, FALSE);
            }
        }
#endif
    }
    evt_finish();
}
#else
#if CHRIS

event on_enter
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_RUN, F_RUN_MONSTERS, FALSE);
    voice_play(VOICE_PLAY, VO_A00_00);
    wait_message();
    evt_fork(TASK_09, on_enter_sub1, 0);
    sleep(100);
    run
    {
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_finish();
}

