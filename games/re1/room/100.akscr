    if (ck(FG_COMMON, F_COMMON_39, TRUE))
    {
        aot_reset(AOT_00_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_00_door, 0);
        enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2220, 0, 7280, 0, 3920, ENEMY_00_NPC_REBECCA, ANIM_00, 0, EVAR_00);
        aot_set(AOT_01_EVENT, 6780, 3420, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_01_4, 0, 0, 0);
    }
#endif
    room_bgm_state_set(0, ROOM_100_SAVE_ROOM, BGM_MAIN_ON | 1);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_24, FALSE) && ck(FG_COMMON, F_COMMON_62, FALSE))
    {
        set(FG_COMMON, F_COMMON_39, TRUE);
        room_bgm_state_set(0, ROOM_100_SAVE_ROOM, BGM_RELOAD);
        enemy(EM_23_NPC_REBECCA, EB_06, NO_FLAG, SPAWN_FORCE, 2, 0, 2220, 0, 7280, 0, 3920, ENEMY_00_NPC_REBECCA, ANIM_10, 12, EVAR_00);
        aot_set(AOT_01_EVENT, 6780, 3420, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_01_4, 0, 0, 0);
        set(FG_COMMON, F_COMMON_22, TRUE);
        evt_exec(0, TASK_09, on_enter);
        cut_auto(CUT_LOCKED);
        setb(B_CAMERA, CAM_02, 0);
    }
    if (ck(FG_COMMON, F_COMMON_2C, TRUE))
    {
        enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2220, 0, 7280, 0, 3920, ENEMY_00_NPC_REBECCA, ANIM_00, 0, EVAR_00);
        aot_set(AOT_01_EVENT, 6780, 3420, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_01_3, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_27, FALSE) && ck(FG_COMMON, F_COMMON_2C, FALSE) && ck(FG_COMMON, F_COMMON_24, TRUE) && ck(FG_COMMON, F_COMMON_39, FALSE) && ck(FG_COMMON, F_COMMON_3C, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_22, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_A0, TRUE) && ck(FG_COMMON, F_COMMON_A9, FALSE))
            {
            }
            else
            {
                if (ck(FG_COMMON, F_COMMON_2A, TRUE) && ck(FG_COMMON, F_COMMON_28, TRUE) && ck(FG_COMMON, F_COMMON_29, TRUE))
                {
                    enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 5673, 0, 7472, 0, 8070, ENEMY_00_NPC_REBECCA, ANIM_06, 0, EVAR_00);
                }
                else
                {
                    enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2600, 0, 7294, 0, 8700, ENEMY_00_NPC_REBECCA, ANIM_40, 0, EVAR_00);
                }
                aot_set(AOT_02_EVENT, 6794, 7700, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_02, 0, 0, 0);
                if (ck(FG_COMMON, F_COMMON_2A, FALSE))
                {
                    set(FG_COMMON, F_COMMON_2A, TRUE);
                    cut_auto(CUT_FREE);
                    aot_set(AOT_01_EVENT, 800, 5900, 9000, 3300, SCE_EVENT, SAT_PLAYER, 9, 0, on_aot_01, 0, 0, 0);
                }
                else if (ck(FG_COMMON, F_COMMON_28, FALSE))
                {
                    cut_auto(CUT_FREE);
                    aot_set(AOT_01_EVENT, 800, 5900, 9000, 3300, SCE_EVENT, SAT_PLAYER, 9, 0, on_aot_01_2, 0, 0, 0);
                }
                else if (ck(FG_COMMON, F_COMMON_29, FALSE))
                {
                    cut_auto(CUT_FREE);
                    aot_set(AOT_01_EVENT, 800, 5900, 9000, 3300, SCE_EVENT, SAT_PLAYER, 9, 0, on_aot_01_2, 0, 0, 0);
                }
                else
                {
                    evt_exec(0, TASK_09, on_enter_3);
                }
            }
        }
    }
    if (ck(FG_COMMON, F_COMMON_27, FALSE) && ck(FG_COMMON, F_COMMON_2C, FALSE) && ck(FG_COMMON, F_COMMON_24, TRUE) && ck(FG_COMMON, F_COMMON_39, FALSE) && ck(FG_COMMON, F_COMMON_3C, TRUE))
    {
        if (ck(FG_COMMON, F_COMMON_22, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_A0, TRUE) && ck(FG_COMMON, F_COMMON_A9, FALSE))
            {
            }
            else
            {
                enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 5673, 0, 7472, 0, 8070, ENEMY_00_NPC_REBECCA, ANIM_06, 0, EVAR_00);
                aot_set(AOT_02_EVENT, 6794, 7700, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_02, 0, 0, 0);
                evt_exec(0, TASK_09, on_enter_3);
            }
        }
    }
    if (ck(FG_COMMON, F_COMMON_27, TRUE))
    {
        set(FG_COMMON, F_COMMON_27, FALSE);
        enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2668, 0, 8050, 0, 7898, ENEMY_00_NPC_REBECCA, ANIM_00, 0, EVAR_00);
        aot_set(AOT_02_EVENT, 7550, 7398, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_02, 0, 0, 0);
        cut_auto(CUT_LOCKED);
        setb(B_CAMERA, CAM_04, 0);
        plw_anim(PLW_02, ANIM_30, 0);
        sys_multi(SYS_PLAYER_FLAGS, SYS_OR | PLF_04);
        sys_multi(SYS_UNEQUIP);
        evt_exec(0, TASK_09, on_enter_2);
    }
    if (ck(FG_COMMON, F_COMMON_2D, TRUE))
    {
        set(FG_SCENARIO, F_SCENARIO_49, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_2E, TRUE))
    {
        set(FG_SCENARIO, F_SCENARIO_4A, TRUE);
    }
#else
    if (ck(FG_COMMON, F_COMMON_22, TRUE))
    {
        if (ck(FG_COMMON, F_COMMON_21, TRUE))
        {
            sys_multi(SYS_UNEQUIP);
            sys_multi(SYS_PLAYER_FLAGS, SYS_OR | PLF_04);
            plw_anim(PLW_02, ANIM_30, 0);
            set(FG_ROOM, F_ROOM_00, TRUE);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_04, 0);
            evt_exec(0, TASK_09, on_enter);
            set(FG_COMMON, F_COMMON_22, FALSE);
            room_bgm_state_set(0, ROOM_100_SAVE_ROOM, BGM_RELOAD);
        }
        if (ck(FG_COMMON, F_COMMON_07, TRUE) && ck(FG_ROOM, F_ROOM_00, FALSE))
        {
            sys_multi(SYS_UNEQUIP);
            sys_multi(SYS_PLAYER_FLAGS, SYS_OR | PLF_04);
            plw_anim(PLW_02, ANIM_30, 0);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_04, 0);
            evt_exec(0, TASK_09, on_enter);
            set(FG_COMMON, F_COMMON_22, FALSE);
            room_bgm_state_set(0, ROOM_100_SAVE_ROOM, BGM_RELOAD);
        }
    }
    if (ck(FG_COMMON, F_COMMON_23, TRUE))
    {
        set(FG_SCENARIO, F_SCENARIO_49, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_24, TRUE))
    {
        set(FG_SCENARIO, F_SCENARIO_4A, TRUE);
    }
#endif
#else
    room_bgm_state_set(5, 0, BGM_MAIN_ON);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_22, TRUE))
    {
        if (ck(FG_COMMON, F_COMMON_32, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_2C, TRUE))
            {
                enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1853, 0, 8062, 0, 7898, ENEMY_00_NPC_REBECCA, ANIM_06, 0, EVAR_00);
                aot_set(AOT_0A_EVENT, 7562, 7398, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_0a, 0, 0, 0);
                evt_exec(0, TASK_09, on_enter_3);
            }
            else if (ck(FG_COMMON, F_COMMON_34, FALSE))
            {
                set(FG_COMMON, F_COMMON_34, TRUE);
                set(FG_COMMON, F_COMMON_2C, TRUE);
                enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1853, 0, 0, 0, 0, ENEMY_00_NPC_REBECCA, ANIM_09, 24, EVAR_00);
                evt_exec(0, TASK_09, on_enter_2);
                room_bgm_state_set(5, 0, BGM_RELOAD | 1);
            }
        }
        else if (ck(FG_COMMON, F_COMMON_2F, TRUE))
        {
            set(FG_COMMON, F_COMMON_30, TRUE);
            set(FG_COMMON, F_COMMON_C0, TRUE);
            set(FG_COMMON, F_COMMON_2F, FALSE);
            room_bgm_state_set(5, 0, BGM_OFF);
            evt_exec(0, TASK_09, on_enter);
        }
    }
    aot_set(AOT_0B_TYPEWRITER, 2300, 8750, 1600, 2000, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
#endif
#endif
}
#if MANSION1

#if CHRIS
event on_enter
{
    run
    {
        set(FG_STATUS, F_STATUS_0F, TRUE);
        dir_set(0, 0, 3356, 0, 3372, 0, 2568);
        set(FG_COMMON, F_COMMON_24, TRUE);
    }
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_fork(TASK_09, on_enter_sub1, 0);
    sleep(10);
    voice_play(VOICE_PLAY, VO_004_00);
    message(MSG_VO_004_00, 0);
    wait_message();
    dir_set(0, 0, 4036, 0, 3866, 0, 3098);
    cutnext(CAM_00);
    evt_fork(TASK_09, on_enter_sub2, 0);
    bgm_play(BGM_MAIN);
    voice_play(VOICE_PLAY, VO_004_01);
    message(MSG_VO_004_01, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_004_02);
    message(MSG_VO_004_02, 0);
    wait_message();
    cutnext(CAM_03);
    pos_set(ENEMY_00_NPC_REBECCA, 0, 2220, 0, 6428, 0, 3878);
    evt_fork(TASK_09, on_enter_sub3, 0);
    voice_play(VOICE_PLAY, VO_004_03);
    message(MSG_VO_004_03, 0);
    wait_message();
    run
    {
        dir_set(0, 0, 3832, 0, 3600, 0, 3070);
        cutnext(CAM_02);
    }
    evt_fork(TASK_09, on_enter_sub4, 0);
    voice_play(VOICE_PLAY, VO_004_04);
    message(MSG_VO_004_04, 0);
    wait_message();
    cutnext(CAM_03);
    evt_fork(TASK_09, on_enter_sub5, 0);
    voice_play(VOICE_PLAY, VO_004_05);
    message(MSG_VO_004_05, 0);
    wait_message();
    cutnext(CAM_02);
    evt_fork(TASK_09, on_enter_sub6, 0);
    voice_play(VOICE_PLAY, VO_004_06);
    message(MSG_VO_004_06, 0);
    wait_message();
    cutnext(CAM_03);
    evt_fork(TASK_09, on_enter_sub7, 0);
    voice_play(VOICE_PLAY, VO_004_07);
    message(MSG_VO_004_07, 0);
    wait_message();
    sleep(70);
    evt_fork(TASK_09, on_enter_sub8, 0);
    voice_play(VOICE_PLAY, VO_004_08);
    message(MSG_VO_004_08, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        aot_reset(AOT_00_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_00_door, 0);
        pos_set(ENEMY_00_NPC_REBECCA, 0, 2220, 0, 7280, 0, 3920);
        cutnext(CAM_00);
    }
    evt_chain(29);
}

event on_aot_01
{
    run
    {
        set(FG_COMMON, F_COMMON_3C, TRUE);
        aot_reset(AOT_01_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
        cutnext(CAM_01);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 3400, 0, 3260, 0, 2370);
        pos_set(ENEMY_00_NPC_REBECCA, 0, 2600, 0, 7294, 0, 8200);
    }
    evt_fork(TASK_09, on_aot_01_sub4, 0);
    evt_fork(TASK_09, on_aot_01_sub1, 0);
    sleep(100);
    voice_play(VOICE_PLAY, VO_007_00);
    message(MSG_VO_007_00, 0);
    wait_message();
    message(MSG_DO_YOU_WANT_ME_TO_HEAL, 0); // "Do you want me to heal your wounds?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, on_aot_01_sub2);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_01_sub3);
        }
    }
    evt_finish();
}
#else
proc main
{
    if (ck(FG_ROOM, F_ROOM_1F, FALSE) && ck(FG_SCENARIO, F_SCENARIO_7D, TRUE))
    {
        set(FG_ROOM, F_ROOM_1F, TRUE);
        bgm_play(BGM_MAIN);
    }
}
#endif

