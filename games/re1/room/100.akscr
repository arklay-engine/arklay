    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, event_1A);
        }
        else
        {
            evt_exec(0, 9, event_1B);
        }
    }
    evt_finish();
}
