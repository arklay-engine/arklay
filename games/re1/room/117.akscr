event on_aot_08
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        set(FG_6, F_6_1C, FALSE);
        message(MSG_A_PICTURE_OF_PEOPLE_MOURNING_FOR | MSG_FAST, MSG_PAUSE_CONTROLS | MSG_PAUSE_0040 | MSG_PAUSE_MONSTERS | MSG_PAUSE_PLAYER); // "A picture of people mourning for the dead."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_ROOM, F_ROOM_12, FALSE);
        if (ck(FG_SCENARIO, F_SCENARIO_03, FALSE))
        {
            evt_exec(0, TASK_09, on_aot_08_sub1);
