event on_aot_02_message_sub1_sub1
{
    run
    {
        set(FG_ROOM, FLAG_ROOM_18, FALSE);
        set(FG_ROOM, FLAG_ROOM_19, FALSE);
        set(FG_ROOM, FLAG_ROOM_1A, FALSE);
        set(FG_ROOM, FLAG_ROOM_1B, FALSE);
        set(FG_ROOM, FLAG_ROOM_1C, FALSE);
        set(FG_ROOM, FLAG_ROOM_1D, FALSE);
        set(FG_ROOM, FLAG_ROOM_1E, FALSE);
    }
    evt_finish();
}

event on_aot_01
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_1C, FALSE);
        cutnext(7);
        message(132, 325); // "The title is “All living things are destined to die"."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_6, FLAG_6_1D, TRUE);
        set(FG_6, FLAG_6_1C, TRUE);
        cutcurr(0);
        cut_auto(0);
    }
    evt_finish();
}

event on_aot_02_message
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_1C, FALSE);
    }
    message(133, 325); // "A picture of a tired middle-aged man."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_03, FALSE))
        {
            evt_exec(0, 9, on_aot_02_message_sub1);
        }
        else
        {
            set(FG_6, FLAG_6_17, TRUE);
            set(FG_6, FLAG_6_1D, TRUE);
            set(FG_6, FLAG_6_1C, TRUE);
        }
    }
    evt_finish();
}

