event on_aot_02_message_sub1_sub2
{
    set(FG_ROOM, FLAG_ROOM_16, FALSE);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    set(FG_ROOM, FLAG_ROOM_16, TRUE);
    evt_finish();
}

event on_aot_02_message_sub1
{
    message(140, 325); // "There's a switch below. Will you push it?"
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_ROOM, FLAG_ROOM_16, TRUE);
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, on_aot_02_message_sub1_sub1);
            evt_exec(0, 9, on_aot_02_message_sub1_sub2);
            require(ck(FG_ROOM, FLAG_ROOM_1B, TRUE));
            set(FG_ROOM, FLAG_ROOM_17, TRUE);
        }
    }
    sleep(1);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_16, FALSE));
    run
    {
        require(ck(FG_ROOM, FLAG_ROOM_17, TRUE));
        set(FG_ROOM, FLAG_ROOM_17, FALSE);
        set(FG_ROOM, FLAG_ROOM_19, TRUE);
    }
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_6, FLAG_6_1D, TRUE);
        set(FG_6, FLAG_6_1C, TRUE);
    }
    evt_finish();
}

