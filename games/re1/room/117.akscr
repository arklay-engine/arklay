event on_aot_02_message_sub1_sub1
{
    run
    {
        set(FG_ROOM, F_ROOM_18, FALSE);
        set(FG_ROOM, F_ROOM_19, FALSE);
        set(FG_ROOM, F_ROOM_1A, FALSE);
        set(FG_ROOM, F_ROOM_1B, FALSE);
        set(FG_ROOM, F_ROOM_1C, FALSE);
        set(FG_ROOM, F_ROOM_1D, FALSE);
        set(FG_ROOM, F_ROOM_1E, FALSE);
    }
    evt_finish();
}

event on_aot_01
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        set(FG_6, F_6_1C, FALSE);
        cutnext(CAM_07);
        message(MSG_THE_TITLE_IS_ALL_LIVING_THINGS | MSG_FAST, MSG_PAUSE_CONTROLS | MSG_PAUSE_0040 | MSG_PAUSE_MONSTERS | MSG_PAUSE_PLAYER); // "The title is “All living things are destined to die"."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        set(FG_6, F_6_1C, TRUE);
        cutcurr(0);
        cut_auto(0);
    }
    evt_finish();
}

event on_aot_02_message
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        set(FG_6, F_6_1C, FALSE);
    }
    message(MSG_A_PICTURE_OF_A_TIRED_MIDDLEAGED | MSG_FAST, MSG_PAUSE_CONTROLS | MSG_PAUSE_0040 | MSG_PAUSE_MONSTERS | MSG_PAUSE_PLAYER); // "A picture of a tired middle-aged man."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_03, FALSE))
        {
            evt_exec(0, TASK_09, on_aot_02_message_sub1);
        }
        else
        {
            set(FG_6, F_6_17, TRUE);
            set(FG_6, F_6_1D, TRUE);
            set(FG_6, F_6_1C, TRUE);
        }
    }
    evt_finish();
}

