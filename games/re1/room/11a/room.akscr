event crest_gate_unlocks
{
    evt_disable(TASK_00);
    run
    {
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_ROOM, F_ROOM_CREST_BUSY, FALSE);
    }
    sleep(30);
    run
    {
        cutcurr(0);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        se_play_3d(SND_BANK_ROOM, SE_18, 0, SND_AT_POINT, 0, 8500, 24600);
    }
    evt_finish();
}

event chris_finds_radio
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 2627, 10552, F_ROOM_C_RADIO_WALK_DONE);
    act_reset();
    sleep(10);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_C_RADIO_WALK_DONE, FALSE));
    set(FG_ROOM, F_ROOM_C_RADIO_WALK_DONE, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 4785, 0, 8990, 192, 64);
    act_reset();
    evt_nop();
    sleep(10);
    voice_play(VOICE_PLAY, VO_00B_00);
    message(MSG_VO_00B_00, 0);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 4171, 9437, F_ROOM_C_PLAYER_ANIM_DONE);
    act_nop();
    act_param_set(0, 160);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_C_PLAYER_ANIM_DONE, FALSE));
    act_anim_flags(ANIM_09, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(25);
    act_reset();
    evt_nop();
    wait_message();
    voice_play(VOICE_PLAY, VO_00B_01);
    message(MSG_VO_00B_01, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(20);
    act_reset();
    evt_nop();
    objtbl_b_set(TBL_ITEM, IMDL_00_KEY_RADIO, 0);
    sleep(10);
    evt_fork(TASK_01, chris_finds_radio_loop, 0);
    wait_message();
    evt_disable(TASK_01);
    sys_multi(SYS_CLEAR_8C);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_anim_flags(ANIM_09, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    sleep(25);
    act_idle();
    act_reset();
    run
    {
        set(FG_ITEM, F_ITEM_11A_KEY_RADIO_0, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_CAMERA_DEFER, FALSE);
    }
    evt_finish();
}

event chris_finds_radio_loop
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_32, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    sleep(20);
    act_anim_flags(ANIM_32, F_ROOM_C_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    sleep(20);
    act_reset();
    evt_nop();
    evt_chain(chris_finds_radio_loop);
    evt_finish();
}

event radio_call_monsters
{
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    dir_set(0, 0, 2496, 0, 4500, 0, 4100);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        bgm_play(BGM_SUB_1);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, radio_call_monsters_anim);
        voice_play(VOICE_PLAY, VO_00C_00);
        message(MSG_VO_00C_00, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(VOICE_PLAY, VO_00C_01);
    message(MSG_VO_00C_01, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    evt_finish();
}

event radio_call_monsters_anim
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(70);
    act_motion_path(MOTION_31, 1250, 0, 0, 50, 0);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_finish();
}

event radio_call_rebecca_upstairs
{
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    dir_set(0, 0, 2496, 0, 4500, 0, 4100);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        bgm_play(BGM_SUB_1);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, radio_call_rebecca_upstairs_anim);
        voice_play(VOICE_PLAY, VO_00C_20);
        message(MSG_VO_00C_20, 0);
    }
    sleep(40);
    wait_message();
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_21);
    sleep(56);
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_22);
    message(MSG_VO_00C_22, 0);
    wait_message();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, 0, 0, 0, 250, 250);
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    evt_finish();
}

event radio_call_rebecca_upstairs_anim
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(40);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_motion_path(MOTION_33, -1700, -5000, 0, 150, 50);
    sleep(15);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    sleep(25);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(40);
    act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(40);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    act_flag_op(EF_OR, EF_0010);
    act_finish();
}
