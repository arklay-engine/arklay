#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_10A 0x00
#define AOT_01_DOOR_11B 0x01
#define AOT_02_EVENT_CREST_PANEL 0x02
#define AOT_02_USEITEM_CREST_PANEL 0x02                     // Data 4,0,32: checking the panel raises F_ROOM_CREST_PANEL_CHECKED.
#define AOT_03_ITEM_KEY_RADIO_0 0x03
#define AOT_03_USEITEM_CREST_SUN 0x03
#define AOT_04_USEITEM_CREST_MOON 0x04
#define AOT_05_USEITEM_CREST_STAR 0x05
#define AOT_06_NONE_CLEARED 0x06                            // Chris, Mansion 2: slot 6 is cleared while the radio lies here.
#define AOT_06_USEITEM_CREST_WIND 0x06
#define CAM_01_RADIO 0x01
#define CAM_04_CREST_PANEL 0x04
#define ENEMY_00_CERBERUS 0x00
#define ENEMY_00_HUNTER 0x00
#define F_ROOM_ANIM_DONE_UNUSED 0x3F                        // An animation-finished pulse no script waits on.
#define F_ROOM_CREST_BUSY 0x01                              // A crest is being placed (or the gate is opening).
#define F_ROOM_CREST_PANEL_CHECKED 0x20                     // The crest panel was checked (one frame).
#define F_ROOM_C_PLAYER_ANIM_DONE 0x22                      // Chris's animation finished (one frame).
#define F_ROOM_C_RADIO_WALK_DONE 0x02                       // Chris's walk to the radio finished.
#define IMDL_00_KEY_RADIO 0x00
#define MSG_CRESTS_ARE_PLACED_IN_ALL_THE 0x03
#define MSG_VO_00B_00 0x04
#define MSG_VO_00B_01 0x05
#define MSG_VO_00C_00 0x06
#define MSG_VO_00C_01 0x07
#define MSG_VO_00C_20 0x08
#define MSG_VO_00C_22 0x09
#define MSG_WHEN_THE_SUN_SETS_IN_THE 0x0A
#define OBJ_00_CREST_SUN 0x00
#define OBJ_01_CREST_MOON 0x01
#define OBJ_02_CREST_STAR 0x02
#define OBJ_03_CREST_WIND 0x03
#define SE_17 0x17
#define SE_18 0x18
#define VO_00B_00 0x77
#define VO_00B_01 0x78
#define VO_00C_00 0x54
#define VO_00C_01 0x55
#define VO_00C_20 0x64
#define VO_00C_21 0x65
#define VO_00C_22 0x66

proc init
{
    door_aot_set(AOT_00_DOOR_10A, 4700, 2700, 1800, 2300, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_10A_BACK_PASSAGE, 2400, 0, 11900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_11B, 8000, 24500, 1500, 2100, 2, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | F_LOCK_11A_11B, ROOM_11B_STORE_ROOM, 3500, 0, 6600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (MANSION1)
    {
        aot_set(AOT_02_USEITEM_CREST_PANEL, 6500, 27200, 2000, 1000, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER, 4, 0, 32, 0, 1, 0);
        aot_set(AOT_03_USEITEM_CREST_SUN, 6500, 27200, 2000, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 19, 0, 1, 0);
        aot_set(AOT_04_USEITEM_CREST_MOON, 6500, 27200, 2000, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 17, 0, 1, 0);
        aot_set(AOT_05_USEITEM_CREST_STAR, 6500, 27200, 2000, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 18, 0, 1, 0);
        aot_set(AOT_06_USEITEM_CREST_WIND, 6500, 27200, 2000, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 14, 0, 1, 0);
    }
    else
    {
        aot_set(AOT_02_EVENT_CREST_PANEL, 6500, 27200, 2000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, read_crest_panel, 0, 0, 0);
        if (CHRIS)
        {
            if (ck(FG_SCENARIO, F_SCENARIO_HAS_RADIO, FALSE))
            {
                item_aot_set(AOT_03_ITEM_KEY_RADIO_0, 6500, 27200, 2000, 1000, IT_4D_KEY_RADIO, 1, IMDL_00_KEY_RADIO, SCA_NONE, 4785, 0, 8990, 0, F_ITEM_11A_KEY_RADIO_0, SAT_MANUAL | SAT_PLAYER, 0);
                aot_reset(AOT_06_NONE_CLEARED, SCE_NONE, 0, 0, 0, 0);
                set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
            }
        }
    }
    obj(OBJ_00_CREST_SUN, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 7010, -1910, 27220, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    eml_rot(ROT_OBJ | OBJ_00_CREST_SUN, 0, 1024);
    if (MANSION1)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_SUN_CREST_PLACED, FALSE))
        {
            objtbl_b_set(TBL_OBJ, OBJ_00_CREST_SUN, 0);
        }
    }
    obj(OBJ_01_CREST_MOON, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 8040, -1910, 27220, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    eml_rot(ROT_OBJ | OBJ_01_CREST_MOON, 0, 1024);
    if (MANSION1)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_MOON_CREST_PLACED, FALSE))
        {
            objtbl_b_set(TBL_OBJ, OBJ_01_CREST_MOON, 0);
        }
    }
    obj(OBJ_02_CREST_STAR, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 7540, -2390, 27220, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    eml_rot(ROT_OBJ | OBJ_02_CREST_STAR, 0, 1024);
    if (MANSION1)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_STAR_CREST_PLACED, FALSE))
        {
            objtbl_b_set(TBL_OBJ, OBJ_02_CREST_STAR, 0);
        }
    }
    obj(OBJ_03_CREST_WIND, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 7530, -1900, 27220, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
    eml_rot(ROT_OBJ | OBJ_03_CREST_WIND, 0, 1024);
    if (MANSION1)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_WIND_CREST_PLACED, FALSE))
        {
            objtbl_b_set(TBL_OBJ, OBJ_03_CREST_WIND, 0);
        }
        enemy(EM_02_CERBERUS, EB_03, F_ENEMY_11A_CERBERUS_0, SPAWN_FORCE, 2, 0, 1536, 0, 6500, 0, 24860, ENEMY_00_CERBERUS, ANIM_00, 0, EVAR_00);
    }
    else if (CHRIS)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_LIBRARY_ENTERED, TRUE))
        {
            enemy(EM_06_HUNTER, EB_02, F_ENEMY_11A_HUNTER_0, SPAWN_FORCE, 2, 0, 848, 0, 3826, 0, 22788, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_C_REBECCA_RADIO_CALL_DUE, TRUE))
        {
            set(FG_COMMON, F_COMMON_C_REBECCA_RADIO_CALL_DUE, FALSE);
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_IN_SAVE_ROOM, TRUE))
            {
                plw_anim(PLW_02, ANIM_28, 0);
                setw(W_04, 0);
                evt_exec(0, TASK_09, radio_call_monsters);
            }
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_UPSTAIRS_CALL, TRUE))
            {
                plw_anim(PLW_02, ANIM_28, 0);
                setw(W_04, 0);
                evt_exec(0, TASK_09, radio_call_rebecca_upstairs);
            }
        }
    }
    else
    {
        if (ck(FG_SCENARIO, F_SCENARIO_LIBRARY_ENTERED, TRUE))
        {
            enemy(EM_06_HUNTER, EB_02, F_ENEMY_11A_HUNTER_0, SPAWN_FORCE, 2, 0, 848, 0, 3826, 0, 22788, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
    }
}

proc main
{
    if (MANSION1)
    {
        if (ck(FG_ROOM, F_ROOM_CREST_PANEL_CHECKED, TRUE) && ck(FG_ROOM, F_ROOM_CREST_BUSY, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_SUN_CREST_PLACED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_STAR_CREST_PLACED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_MOON_CREST_PLACED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_WIND_CREST_PLACED, TRUE))
            {
                evt_exec(0, TASK_00, crests_all_placed);
            }
            else
            {
                evt_exec(0, TASK_00, read_crest_panel);
            }
        }
        if (testitem(IT_2E_KEY_CREST_SUN))
        {
            set(FG_ROOM, F_ROOM_CREST_BUSY, TRUE);
            evt_exec(0, TASK_00, place_sun_crest);
        }
        if (testitem(IT_2C_KEY_CREST_MOON))
        {
            set(FG_ROOM, F_ROOM_CREST_BUSY, TRUE);
            evt_exec(0, TASK_00, place_moon_crest);
        }
        if (testitem(IT_2D_KEY_CREST_STAR))
        {
            set(FG_ROOM, F_ROOM_CREST_BUSY, TRUE);
            evt_exec(0, TASK_00, place_star_crest);
        }
        if (testitem(IT_29_KEY_CREST_WIND))
        {
            set(FG_ROOM, F_ROOM_CREST_BUSY, TRUE);
            evt_exec(0, TASK_00, place_wind_crest);
        }
        if (ck(FG_LOCK, F_LOCK_11A_11B, FALSE) && ck(FG_SCENARIO, F_SCENARIO_SUN_CREST_PLACED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_STAR_CREST_PLACED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_MOON_CREST_PLACED, TRUE) && ck(FG_SCENARIO, F_SCENARIO_WIND_CREST_PLACED, TRUE))
        {
            set(FG_LOCK, F_LOCK_11A_11B, TRUE);
            evt_exec(0, TASK_01, crest_gate_unlocks);
        }
    }
    if (CHRIS && MANSION2)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_HAS_RADIO, FALSE) && cmpb(B_CAMERA, CMP_EQ, CAM_01_RADIO))
        {
            set(FG_SCENARIO, F_SCENARIO_HAS_RADIO, TRUE);
            set(FG_STATUS, F_STATUS_CAMERA_DEFER, FALSE);
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            dir_set(0, 0, 996, 0, 2888, 0, 12473);
            evt_exec(0, TASK_00, chris_finds_radio);
        }
    }
}


event read_crest_panel
{
    cutnext(CAM_04_CREST_PANEL);
    if (MANSION1)
    {
        message(MSG_WHEN_THE_SUN_SETS_IN_THE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "When the sun sets in the west and the moon rises in the east, stars will begin to appear in the sky and wind will blow towards the ground. Then the gate of new life will open."
    }
    else
    {
        message(MSG_CRESTS_ARE_PLACED_IN_ALL_THE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "Crests are placed in all the hollows."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    cutcurr(0);
    evt_finish();
}

event crests_all_placed
{
    cutnext(CAM_04_CREST_PANEL);
    message(MSG_CRESTS_ARE_PLACED_IN_ALL_THE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "Crests are placed in all the hollows."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    cutcurr(0);
    evt_finish();
}

event empty_event
{
    evt_finish();
}

event place_sun_crest
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
    }
    evt_next();
    evt_next();
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_POINT, 0, 7027, 27234);
        cutnext(CAM_04_CREST_PANEL);
        objtbl_b_set(TBL_OBJ, OBJ_00_CREST_SUN, OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
        set(FG_SCENARIO, F_SCENARIO_SUN_CREST_PLACED, TRUE);
    }
    sleep(40);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_ROOM, F_ROOM_CREST_BUSY, FALSE);
        cutcurr(0);
    }
    evt_finish();
}

