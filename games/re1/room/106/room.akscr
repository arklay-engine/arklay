event from_main_12
{
    if (CHRIS)
    {
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_0F, TRUE);
        }
        evt_next();
        evt_nop();
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            aot_on(AOT_06_ITEM, SCE_ITEM, 0);
        }
    }
    else
    {
        run
        {
            bgm_stop_all(0);
            movie_on(MOVIE_05_DM1);
        }
    }
    evt_next();
    evt_nop();
    if (CHRIS)
    {
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            aot_reset(AOT_06_ITEM, SCE_NONE, 0, 0, 0, 0);
        }
        sleep(50);
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_STATUS, F_STATUS_0F, FALSE);
        }
    }
    else
    {
        run
        {
            bgm_restore(0);
        }
    }
    evt_finish();
}
