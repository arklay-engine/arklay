#version 1

proc init
{
    door_aot_set(0, 21300, 16700, 1400, 1700, 3, 1, 11, 3, 0, RDT_00F, 22000, 0, 7500, 3072, UNLOCKED, 129);
    door_aot_set(1, 10700, 0, 3400, 2600, 11, 1, 11, 3, 0, RDT_011, 12900, 0, 15600, 1024, UNLOCKED, 129);
    item_aot_set(2, 0, 0, 1, 1, ITEM_6D, 1, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 90, 129, 0, 0);
    aot_set(3, 18600, 1500, 1800, 1500, SCE_USEITEM, 1, 9, 0, 13, 0, 1, 0);
    aot_set(4, 18600, 1500, 1800, 1500, SCE_NONE, 1, 0, 0, 0, 0, 0, 0);
    enemy(ENEMY_CHIMERA, 2, 97, 1, 1, 0, 0, 2500, 0, 0, 22000, 0, 7900, 0, 0, 0, 0);
    enemy(ENEMY_CHIMERA, 2, 98, 1, 1, 0, 0, 3500, 0, 0, 6000, 0, 5000, 1, 0, 0, 0);
#if CHRIS
    enemy(ENEMY_CHIMERA, 2, 179, 1, 1, 0, 0, 144, 0, 0, 12496, 0, 10163, 2, 0, 0, 0);
#endif
    evt_exec(0, 9, event_01);
    evt_exec(0, 9, event_02);
    evt_exec(0, 9, event_03);
}

proc main
{
    if (ck(FG_ITEM, 90, 0))
    {
        aot_reset(4, SCE_MESSAGE, 129, 128, 69, 0);
        aot_reset(3, SCE_USEITEM, 1, 9, 13, 1);
    }
    else
    {
        aot_reset(4, SCE_MESSAGE, 129, 129, 69, 0);
        aot_reset(3, SCE_NONE, 129, 0, 0, 0);
    }
    if (testitem(ITEM_MO_DISK))
    {
        evt_exec(0, 9, event_00);
    }
}

event event_00
{
    sleep(1);
    aot_on(2, SCE_DOCUMENT, 0);
    evt_finish();
}

event event_01
{
    sleep(171);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 18300, 9400);
    }
    for (8)
    {
        effect(31, 0, 0, 124, 71, 16, 245, 184, 36, 80, 10);
        sleep(3);
    }
    evt_nop();
    evt_chain(1);
    evt_finish();
}

event event_02
{
    sleep(285);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 9300, 1600);
    }
    for (8)
    {
        effect(31, 0, 0, 84, 36, 104, 247, 64, 6, 228, 12);
        sleep(3);
    }
    evt_nop();
    evt_chain(2);
    evt_finish();
}

event event_03
{
    sleep(349);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 8000, 8600);
    }
    for (8)
    {
        effect(31, 0, 0, 64, 31, 184, 242, 152, 33, 152, 8);
        sleep(3);
    }
    evt_chain(3);
    evt_finish();
}
