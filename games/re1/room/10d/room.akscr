event tiger_already_turned_blue
{
    evt_work_set(WK_OBJ, OBJ_00_TIGER_STATUE);
    evt_tween_begin_alt();
    tw_abs_rot(0, 0, 1024, 0);
    evt_next();
    tw_end();
    evt_finish();
}

event tiger_already_turned_red
{
    evt_work_set(WK_OBJ, OBJ_00_TIGER_STATUE);
    evt_tween_begin_alt();
    tw_abs_rot(0, 0, 3072, 0);
    evt_next();
    tw_end();
    evt_finish();
}
