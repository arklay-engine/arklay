#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_405 0x00
#define AOT_01_DOOR_407 0x01
#define AOT_02_DOOR_40D 0x02                                // The ladder down; armed when the player chooses to descend.
#define AOT_03_HIKIDASHI_DRAWER 0x03
#define AOT_04_EVENT_DORMITORY_SKETCH 0x04
#define AOT_05_EVENT_LADDER 0x05
#define AOT_06_ITEM_AMMO_SHOTGUN_0 0x06
#define AOT_07_ITEM_FILE_PLANT_42_REPORT_1 0x07
#define AOT_08_ITEM_MAP_DORMITORY 0x08                      // The dormitory map (item 0x52), given from the sketch.
#define CAM_00_LADDER 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_05 0x05
#define ENEMY_00_BARRY 0x00
#define F_ROOM_J_BARRY_ANIM_DONE 0x21                       // Barry's animation finished (one frame).
#define F_ROOM_J_PLAYER_ANIM_DONE 0x20                      // Jill's animation finished (one frame).
#define IMDL_00_AMMO_SHOTGUN 0x00
#define IMDL_01_FILE_PLANT_42_REPORT 0x01
#define IMDL_02_MAP_DORMITORY 0x02
#define MSG_A_DORMITORY_SKETCH 0x06
#define MSG_THERE_IS_A_LADDER 0x07
#define MSG_YOU_GOT_THE_MAP_OF_DORMITORY 0x09
#define OBJ_00_CABINET_OVER_LADDER 0x00                     // Guess: pushable furniture over the ladder; already moved aside once 40D was visited.
#define OBJ_01_CABINET 0x01                                 // Guess: the second pushable piece of furniture beside OBJ_00_CABINET_OVER_LADDER.
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_109_10 0x01
#define VO_109_11 0x02
#define VO_109_12 0x03
#define VO_109_13 0x04
#define VO_109_14 0x05
#define VO_109_15 0x06

proc init
{
    door_aot_set(AOT_00_DOOR_405, 300, 2000, 2100, 1800, 0, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_405_CENTER_PASSAGE, 24700, 0, 21100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_407, 2500, 3700, 1600, 1800, 1, DOOR_SND_00_DR_WD, DOOR_21_DOOR15, 1, 0, ROOM_407_ROOM_002_BATHROOM, 3100, 0, 6400, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_40D, 0, 0, 1, 1, 1, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_40D_UNDER_PASSAGE, 3500, 0, 29000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_03_HIKIDASHI_DRAWER, 10500, 1600, 1100, 1600, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 34, 0, 6, 0, 6, 0);
    aot_set(AOT_04_EVENT_DORMITORY_SKETCH, 9000, 5000, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_dormitory_sketch, 0, 0, 0);
    aot_set(AOT_05_EVENT_LADDER, 12100, 8400, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_ladder, 0, 0, 0);
    item_aot_set(AOT_06_ITEM_AMMO_SHOTGUN_0, 0, 0, 1, 1, IT_0C_AMMO_SHOTGUN, 7, IMDL_00_AMMO_SHOTGUN, SCA_NONE, 11030, -140, 1960, 0, F_ITEM_406_AMMO_SHOTGUN_0, 0, 0);
    eml_rot(IMDL_00_AMMO_SHOTGUN, 0, -1024);
    setbyte(0, 0, 0);
    item_aot_set(AOT_07_ITEM_FILE_PLANT_42_REPORT_1, 12400, 3800, 1000, 1400, IT_64_FILE_PLANT_42_REPORT, 1, IMDL_01_FILE_PLANT_42_REPORT, SCA_NONE, 13400, -710, 4940, 0, F_ITEM_406_FILE_PLANT_42_REPORT_1, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_08_ITEM_MAP_DORMITORY, 0, 0, 1, 10, IT_52_MAP_DORMITORY, 1, IMDL_02_MAP_DORMITORY, SCA_NONE, 9280, -2320, 5420, 0, F_ITEM_406_MAP_DORMITORY_2, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_UNDER_PASSAGE_ENTERED, TRUE))
    {
        obj(OBJ_00_CABINET_OVER_LADDER, OF_10 | OF_ACTIVE, SCA_NONE, 10180, 0, 8970, 1024, 0, 350, 0, -350, 200, 1100, 1200, 600);
        obj(OBJ_01_CABINET, OF_10 | OF_ACTIVE, SCA_NONE, 10176, 0, 10220, 1024, 0, 300, 0, -300, 200, 1100, 1200, 600);
    }
    else
    {
        obj(OBJ_00_CABINET_OVER_LADDER, OF_10 | OF_ACTIVE, SCA_NONE, 12907, 0, 8580, 1024, 0, 350, 0, -350, 200, 1100, 1200, 600);
        obj(OBJ_01_CABINET, OF_10 | OF_ACTIVE, SCA_NONE, 10176, 0, 8580, 1024, 0, 300, 0, -300, 200, 1100, 1200, 600);
    }
    if (CHRIS)
    {
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
        {
            aot_reset(AOT_03_HIKIDASHI_DRAWER, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 255, 0);
            aot_reset(AOT_04_EVENT_DORMITORY_SKETCH, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 255, 0);
            aot_reset(AOT_07_ITEM_FILE_PLANT_42_REPORT_1, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 255, 0);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_BARRY_002_TALK, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_OVERHEARD_BARRY_WESKER, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_J_BARRY_002_MISSED_400, FALSE))
                {
                    if (ck(FG_COMMON, F_COMMON_J_BARRY_002_MISSED_408, FALSE))
                    {
                        evt_exec(0, TASK_09, barry_talking_alone);
                    }
                }
            }
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_GUARDHOUSE_MAP_TAKEN, TRUE))
    {
        aot_delete(AOT_04_EVENT_DORMITORY_SKETCH, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    set(FG_STATUS, F_STATUS_FADE_NO_DEPTH_CLAMP, TRUE);
    if (JILL)
    {
        if (ck(FG_COMMON, F_COMMON_J_BARRY_002_TALK, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_OVERHEARD_BARRY_WESKER, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_J_BARRY_002_MISSED_400, FALSE))
                {
                    if (ck(FG_COMMON, F_COMMON_J_BARRY_002_MISSED_408, FALSE))
                    {
                        room_bgm_state_set(3, ROOM_406_ROOM_002, BGM_RELOAD | 1);
                        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 1, 0, 1550, 0, 13000, 0, 7550, ENEMY_00_BARRY, ANIM_00, 0, EVAR_00);
                    }
                }
            }
        }
    }
}

event empty_event
{
    evt_finish();
}

event barry_talking_alone when (JILL)
{
    sleep(2);
    run
    {
        set(FG_COMMON, F_COMMON_J_BARRY_002_TALK, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        dir_set(0, 0, 4085, 0, 2800, 0, 3000);
    }
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_31, 700, 0, 0, 100, 0);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_31, 710, 0, 0, 100, 0);
    act_reset();
    evt_nop();
    sleep(25);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_31, -700, 0, 0, 160, 0);
    act_reset();
    evt_nop();
    sleep(25);
    run
    {
        cutnext(CAM_02);
        evt_exec(0, TASK_09, barry_talking_alone_jill_walk);
        evt_exec(0, TASK_09, barry_talking_alone_barry_walk);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 9100, 3100, F_ROOM_J_PLAYER_ANIM_DONE);
    act_nop();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_ANIM_DONE, FALSE));
    sleep(15);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
