#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_HIKIDASHI 0x03
#define AOT_04_EVENT 0x04
#define AOT_05_EVENT 0x05
#define AOT_06_ITEM 0x06
#define AOT_07_ITEM 0x07
#define AOT_08_ITEM 0x08
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_05 0x05
#define ENEMY_00_NPC_BARRY 0x00
#define F_ROOM_20 0x20
#define F_ROOM_21 0x21
#define IMDL_00 0x00
#define IMDL_01 0x01
#define IMDL_02 0x02
#define MSG_A_DORMITORY_SKETCH 0x06
#define MSG_THERE_IS_A_LADDER 0x07
#define MSG_YOU_GOT_THE_MAP_OF_DORMITORY 0x09
#define OBJ_00 0x00
#define OBJ_01 0x01
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_109_10 0x01
#define VO_109_11 0x02
#define VO_109_12 0x03
#define VO_109_13 0x04
#define VO_109_14 0x05
#define VO_109_15 0x06

proc init
{
    door_aot_set(AOT_00_DOOR, 300, 2000, 2100, 1800, 0, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_405_CENTER_PASSAGE, 24700, 0, 21100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 2500, 3700, 1600, 1800, 1, DOOR_SND_00_DR_WD, DOOR_21_DOOR15, 1, 0, ROOM_407_ROOM_002_BATHROOM, 3100, 0, 6400, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 0, 0, 1, 1, 1, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_40D_UNDER_PASSAGE, 3500, 0, 29000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_03_HIKIDASHI, 10500, 1600, 1100, 1600, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 34, 0, 6, 0, 6, 0);
    aot_set(AOT_04_EVENT, 9000, 5000, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_04, 0, 0, 0);
    aot_set(AOT_05_EVENT, 12100, 8400, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
    item_aot_set(AOT_06_ITEM, 0, 0, 1, 1, IT_0C_AMMO_SHOTGUN, 7, IMDL_00, SCA_NONE, 11030, -140, 1960, 0, F_ITEM_19, 0, 0);
    eml_rot(IMDL_00, 0, -1024);
    setbyte(0, 0, 0);
    item_aot_set(AOT_07_ITEM, 12400, 3800, 1000, 1400, IT_64_FILE_PLANT_42_REPORT, 1, IMDL_01, SCA_NONE, 13400, -710, 4940, 0, F_ITEM_86, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_08_ITEM, 0, 0, 1, 10, IT_52_UNKNOWN_52, 1, IMDL_02, SCA_NONE, 9280, -2320, 5420, 0, F_ITEM_87, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_45, TRUE))
    {
        obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 10180, 0, 8970, 1024, 0, 350, 0, -350, 200, 1100, 1200, 600);
        obj(OBJ_01, OF_10 | OF_ACTIVE, SCA_NONE, 10176, 0, 10220, 1024, 0, 300, 0, -300, 200, 1100, 1200, 600);
    }
    else
    {
        obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 12907, 0, 8580, 1024, 0, 350, 0, -350, 200, 1100, 1200, 600);
        obj(OBJ_01, OF_10 | OF_ACTIVE, SCA_NONE, 10176, 0, 8580, 1024, 0, 300, 0, -300, 200, 1100, 1200, 600);
    }
    if (CHRIS)
    {
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
        {
            aot_reset(AOT_03_HIKIDASHI, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 255, 0);
            aot_reset(AOT_04_EVENT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 255, 0);
            aot_reset(AOT_07_ITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 255, 0);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_B2, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_AE, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_B0, FALSE))
                {
                    if (ck(FG_COMMON, F_COMMON_B1, FALSE))
                    {
                        evt_exec(0, TASK_09, on_enter);
                    }
                }
            }
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_3E, TRUE))
    {
        aot_delete(AOT_04_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    set(FG_STATUS, F_STATUS_3C, TRUE);
    if (JILL)
    {
        if (ck(FG_COMMON, F_COMMON_B2, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_AE, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_B0, FALSE))
                {
                    if (ck(FG_COMMON, F_COMMON_B1, FALSE))
                    {
                        room_bgm_state_set(3, ROOM_406_ROOM_002, BGM_RELOAD | 1);
                        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 1, 0, 1550, 0, 13000, 0, 7550, ENEMY_00_NPC_BARRY, ANIM_00, 0, EVAR_00);
                    }
                }
            }
        }
    }
}

event event_00
{
    evt_finish();
}

event on_enter when (JILL)
{
    sleep(2);
    run
    {
        set(FG_COMMON, F_COMMON_B2, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        dir_set(0, 0, 4085, 0, 2800, 0, 3000);
