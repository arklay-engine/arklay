        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
        room_bgm_state_set(3, ROOM_406_ROOM_002, BGM_MAIN_ON);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event barry_talking_alone_jill_walk when (JILL)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, -700, 300, 0, 160, 100);
    sleep(25);
    act_motion_path(MOTION_33, 400, 200, 0, 120, 90);
    sleep(30);
    act_motion_path(MOTION_33, 700, -300, 0, 140, 80);
    sleep(25);
    act_motion_path(MOTION_33, -600, 0, 0, 160, 0);
    sleep(5);
    act_anim_flags(ANIM_02, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    evt_finish();
}

event barry_talking_alone_barry_walk when (JILL)
{
    sleep(45);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_seq(AB_02, 10500, 4600, F_ROOM_J_BARRY_ANIM_DONE);
    act_nop();
    act_motion_path(MOTION_31, 600, 0, 0, 120, 0);
    sleep(40);
    act_motion(MOTION_10);
    act_anim_flags(ANIM_02, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    evt_finish();
}

event examine_dormitory_sketch
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_A_DORMITORY_SKETCH | MSG_FAST, 0); // "A dormitory sketch. Will you take it? There's a ladder. Will you descend it? There is no time to check it."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, take_dormitory_map);
        }
        else
        {
            evt_exec(0, TASK_09, leave_dormitory_map);
        }
    }
    evt_finish();
}

event take_dormitory_map
{
    run
    {
        aot_on(AOT_08_ITEM_MAP_DORMITORY, SCE_F, 0);
        aot_delete(AOT_04_EVENT_DORMITORY_SKETCH, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        message(MSG_YOU_GOT_THE_MAP_OF_DORMITORY | MSG_FAST, 0); // "You got the map of DORMITORY."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_SCENARIO, F_SCENARIO_GUARDHOUSE_MAP_TAKEN, TRUE);
    }
    evt_finish();
}

event leave_dormitory_map
{
    single(4) set(FG_RUN, 0, 0);
    raw(0x17, 0x00, 0xFF, 0x00);
}

event examine_ladder
{
    run
    {
        cutnext(CAM_00_LADDER);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_THERE_IS_A_LADDER | MSG_FAST, 0); // "There's a ladder. Will you descend it? There is no time to check it."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, descend_ladder);
        }
        else
        {
            evt_exec(0, TASK_09, leave_ladder);
        }
    }
    evt_finish();
}

event descend_ladder
{
    run
    {
        door_aot_set(AOT_02_DOOR_40D, 10000, 6400, 5000, 5000, 1, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_40D_UNDER_PASSAGE, 3000, 0, 27800, 1024, UNLOCKED, SAT_UNDER | SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event leave_ladder
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}
