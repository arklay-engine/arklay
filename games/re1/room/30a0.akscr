        set(FG_6, 23, 1);
        cutnext(4);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ITEM, 252, 1))
        {
            aot_delete(3, SCE_NONE, 0);
            set(FG_COMMON, 73, 0);
        }
        cut_auto(0);
        set(FG_STATUS, 15, 1);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
    }
    evt_finish();
}

