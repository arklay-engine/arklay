#version 1

proc init
{
    door_aot_set(0, 3400, 20200, 1500, 1300, 3, 1, 8, 0, 0, RDT_009, 15300, 0, 2800, 3072, UNLOCKED, 129);
    item_aot_set(1, 0, 0, 1, 1, ITEM_CLIP, 15, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 252, 129, 0, 0);
    if (ck(FG_COMMON, 72, 1))
    {
        item_aot_set(137, 3330, 11130, 1000, 1000, ITEM_HEX_CRANK, 0, 1, 255, 48, 117, 48, 117, 48, 117, 0, 0, 46, 129, 1, 134);
        aot_delete(9, SCE_NONE, 129);
    }
    else
    {
        item_aot_set(137, 3330, 11130, 1000, 1000, ITEM_HEX_CRANK, 0, 1, 255, 246, 14, 0, 0, 110, 45, 176, 4, 46, 129, 1, 134);
    }
    if (ck(FG_COMMON, 72, 1))
    {
        aot_set(2, 10600, 1700, 1000, 6300, SCE_EVENT, 65, 9, 0, event_00, 0, 0, 0);
        enemy(ENEMY_ENRICO, 2, 255, 1, 2, 0, 0, 824, 0, 0, 10840, 0, 16490, 0, 0, 58, 0);
    }
    else
    {
        enemy(ENEMY_ENRICO, 2, 255, 1, 2, 0, 0, 824, 0, 0, 10840, 0, 16490, 0, 0, 58, 0);
    }
    if (ck(FG_COMMON, 73, 1))
    {
        aot_set(3, 10400, 14800, 1000, 1800, SCE_EVENT, 129, 9, 0, event_02, 0, 0, 0);
    }
    if (ck(FG_COMMON, 72, 1))
    {
        enemy(ENEMY_HUNTER, 136, 80, 1, 2, 0, 0, 2048, 0, 0, 30000, 30000, 30000, 1, 0, 0, 0);
        enemy(ENEMY_HUNTER, 128, 81, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 2, 0, 0, 0);
    }
    else
    {
        enemy(ENEMY_HUNTER, 2, 80, 1, 2, 0, 0, 2048, 0, 0, 9270, 0, 3950, 1, 0, 0, 0);
        enemy(ENEMY_HUNTER, 2, 81, 1, 2, 0, 0, 3072, 0, 0, 3530, 0, 8280, 2, 0, 0, 0);
    }
}

proc main
{
    if (ck(FG_ROOM, 8, 0))
    {
        if (cmpb(2, 0, 2))
        {
            set(FG_ROOM, 8, 1);
            pos_set(1, 0, 1024, 0, 4644, 0, 8920);
            pos_set(2, 0, 1024, 0, 5600, 0, 20000);
            eml_state(0, 1, 0, 8);
            eml_state(0, 2, 0, 2);
        }
    }
}

