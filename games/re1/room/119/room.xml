  <strings>
    <language lang="en-US">
      <string key="save_name">M. Room 1F</string>
      <string key="0">There's a switch. Will\nyou push it?{scroll 1}{branch 0 1 0}\nNothing uncommon.{scroll 2}</string>
      <string key="1">\nNothing uncommon.{scroll 2}</string>
      <string key="2">It's too dark to see\nanything.{scroll 2}</string>
      <string key="3">I can only see moonlight\nand dense forest.{scroll 2}</string>
      <string key="4">{scroll 0}\n{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}\n{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\n{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}\n{scroll 2}{timed 110}</string>
      <string key="8">\n{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}小部屋/{s}1{s}F{s}</string>
      <string key="0">     スイッチがある\n押しますか?{scroll 1}{branch 0 1 0}\n   特に変わったものはない{scroll 2}</string>
      <string key="1">\n   特に変わったものはない{scroll 2}</string>
      <string key="2">\n    暗くてよく分からない{scroll 2}</string>
      <string key="3"> 見える物といえば、月あかりと\n うっそうとしげる緑だけだ{scroll 2}</string>
      <string key="4">{scroll 0}\n  あいつらは? バケモノか‽{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}\n  レベッカはまだあの部屋に‽{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\n       奴らは‽{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}\n    レベッカ! 上か!{scroll 2}{timed 110}</string>
      <string key="8">\n      しゃれた棚だ{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Chambre RdC</string>
      <string key="0">Il y a un bouton.\nAppuyer dessus?{scroll 1}{branch 0 6 0}</string>
      <string key="1">\nRien de particulier.{scroll 2}</string>
      <string key="2">Il fait trop sombre pour \nvoir quoi que ce soit.{scroll 2}</string>
      <string key="3">Je n'arrive à voir qu'un clair\nde lune et la forêt dense.{scroll 2}</string>
      <string key="4">{scroll 0}Qu'est-ce que c'est? \nDes monstres?{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}Rebecca! Est-elle encore \ndans la maison?{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\nQu'est-ce que c'est?{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}C'est Rebecca! \nElle doit être à l'étage!{scroll 2}{timed 110}</string>
      <string key="8">\n{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">Da ist ein Schalter.\nMöchten Sie draufdrücken?{scroll 1}{branch 0 6 0}</string>
      <string key="1">\nNichts Ungewöhnliches.{scroll 2}</string>
      <string key="2">Es ist zu dunkel,\num irgend etwas zu sehen.{scroll 2}</string>
      <string when="JILL" key="2">Es ist zu dunkel,\num irgendwas zu sehen.{scroll 2}</string>
      <string key="3">Ich kann nur den Mond und den\ndichten Wald sehen.{scroll 2}</string>
      <string when="JILL" key="3">Ich kann nur den Mond\nund den dichten Wald sehen.{scroll 2}</string>
      <string key="4">{scroll 0}Was sind das?\nMonster?{scroll 2}{timed 140}</string>
      <string when="JILL" key="4">{scroll 0}Was ist das?\nMonster?{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}Rebecca!\nIst sie immer noch im Haus?{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\nWas sind das für welche?{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}Es ist Rebecca!\nSie muß oben sein!{scroll 2}{timed 110}</string>
      <string when="JILL" key="7">{scroll 0}Es ist Rebecca!\nSie muss oben sein!{scroll 2}{timed 110}</string>
      <string key="8">\n {scroll 2}</string>
      <string when="JILL" key="8">\n{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Villa 1P</string>
      <string key="0">C'è un interruttore. \nVuoi premerlo?{scroll 1}{branch 0 6 0}</string>
      <string key="1">\nNiente di speciale.{scroll 2}</string>
      <string key="2">È troppo buio per \nvedere qualcosa.{scroll 2}</string>
      <string key="3">Riesci a vedere solo la luce della \nluna e una fitta foresta.{scroll 2}</string>
      <string key="4">{scroll 0}\nCosa sono?! {scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}Rebecca! È ancora nella \nmagione?{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\nChe cos'è?{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}È Rebecca! Deve essere \ndi sopra!{scroll 2}{timed 110}</string>
      <string key="8">\n{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">Hay un interruptor...\n¿Quieres pulsarlo?{scroll 1}{branch 0 6 0}</string>
      <string key="1">\nNada fuera de lo común...{scroll 2}</string>
      <string key="2">Está demasiado oscuro,\nno se ve nada...{scroll 2}</string>
      <string key="3">Solo se ve la luz de la luna\ny un bosque denso...{scroll 2}</string>
      <string key="4">{scroll 0}¿Q-Qué son?\n¿Monstruos?{scroll 2}{timed 140}</string>
      <string when="JILL" key="4">{scroll 0}¿Q-Qué son?\n¿M-Monstruos?{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}¡Rebecca!\n¿Sigue estando en la casa?{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\n¿Qué son?{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}Es Rebecca, \n¡debe estar arriba!{scroll 2}{timed 110}</string>
      <string key="8">{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Мед. комната 1-эт.</string>
      <string key="0">Здесь кнопка.\nНажать её?{scroll 1}{branch 0 1 0}\nНичего необычного.{scroll 2}</string>
      <string key="1">\nНичего необычного.{scroll 2}</string>
      <string key="2">Слишком темно,\nничего не видно.{scroll 2}</string>
      <string key="3">За окном только\nлунный свет и густой лес.{scroll 2}</string>
      <string key="4">{scroll 0}\n{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}\n{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}\n{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}\n{scroll 2}{timed 110}</string>
      <string key="8">\n{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Lääkevarasto 1 krs</string>
      <string key="0">Siinä on painike...\nPainatko sitä?{scroll 1}{branch 0 6 0}</string>
      <string key="1">Ei mitään epätavallista...{scroll 2}</string>
      <string key="2">On liian pimeää nähdäkseen\nmitään...{scroll 2}</string>
      <string key="3">Nään vain kuunvalon ja tiheää\nmetsää...{scroll 2}</string>
      <string key="4">{scroll 0}Mitä nuo ovat? Hirviöitä?{scroll 2}{timed 140}</string>
      <string key="5">{scroll 0}Rebecca!\nOnko hän vielä kartanossa?{scroll 2}{timed 100}</string>
      <string key="6">{scroll 0}Mitä nuo ovat?{scroll 2}{timed 70}</string>
      <string key="7">{scroll 0}Tuo on Rebecca.\nHänen on oltava yläkerrassa!{scroll 2}{timed 110}</string>
      <string key="8">{scroll 2}</string>
    </language>
