#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_EVENT 0x02
#define AOT_03_MESSAGE 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_MESSAGE 0x05
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define F_ROOM_0A 0x0A
#define F_ROOM_3F 0x3F
#define IMDL_00 0x00
#define IMDL_01 0x01
#define MSG_THERE_IS_A_SWITCH 0x00
#define MSG_VO_00C_00 0x04
#define MSG_VO_00C_01 0x05
#define MSG_VO_00C_20 0x06
#define MSG_VO_00C_22 0x07
#define SE_17 0x17
#define VO_00C_00 0x54
#define VO_00C_01 0x55
#define VO_00C_20 0x64
#define VO_00C_21 0x65
#define VO_00C_22 0x66

proc init when (MANSION2)
{
    door_aot_set(AOT_00_DOOR, 5000, 1300, 1500, 1400, 2, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 4, 0, ROOM_10A_BACK_PASSAGE, 8400, 0, 5000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM, 1820, 3942, 1800, 1800, IT_40_KEY_BOOK_DOOM_1, 0, IMDL_00, SCA_NONE, 2720, -900, 4842, 0, F_ITEM_43, 0, 0);
    aot_set(AOT_02_EVENT, 3270, 6862, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_02, 0, 0, 0);
    aot_set(AOT_03_MESSAGE, 6800, 3600, 1200, 1600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    item_aot_set(AOT_04_ITEM, 4110, 6462, 1800, 1800, IT_0E_AMMO_MAGNUM, 6, IMDL_01, SCA_NONE, 5130, -1440, 7482, -360, F_ITEM_65, 0, 0);
    aot_set(AOT_05_MESSAGE, 1900, 9100, 1500, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
    set(FG_ROOM, F_ROOM_0A, TRUE);
    cut_auto(CUT_LOCKED);
    setb(B_CAMERA, CAM_02, 0);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_21, TRUE))
        {
            set(FG_COMMON, F_COMMON_21, FALSE);
            if (ck(FG_COMMON, F_COMMON_22, TRUE))
            {
                plw_anim(PLW_02, ANIM_28, 0);
                setw(W_04, 0);
                evt_exec(0, TASK_09, on_enter_2);
            }
            if (ck(FG_COMMON, F_COMMON_36, TRUE))
            {
                plw_anim(PLW_02, ANIM_28, 0);
                setw(W_04, 0);
                evt_exec(0, TASK_09, on_enter_3);
            }
            if (ck(FG_COMMON, F_COMMON_22, FALSE) && ck(FG_COMMON, F_COMMON_36, FALSE))
            {
                evt_exec(0, TASK_09, on_enter);
            }
        }
        else
        {
            evt_exec(0, TASK_09, on_enter);
        }
    }
    else
    {
        evt_exec(0, TASK_09, on_enter);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_40, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_40, TRUE);
    }
}

proc main when (MANSION2)
{
    if (ck(FG_ROOM, F_ROOM_0A, TRUE))
    {
        aot_delete(AOT_01_ITEM, SCE_NONE, 0);
        aot_reset(AOT_03_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 255, 0);
        aot_delete(AOT_04_ITEM, SCE_NONE, 0);
    }
    else
    {
        if (ck(FG_ITEM, F_ITEM_43, TRUE))
        {
            aot_delete(AOT_01_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        if (ck(FG_ITEM, F_ITEM_65, TRUE))
        {
            aot_delete(AOT_04_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        aot_reset(AOT_03_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
    }
}

event on_aot_02 when (MANSION2)
{
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    message(MSG_THERE_IS_A_SWITCH | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a switch. Will you push it? Nothing uncommon."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_PLAYER, 0, 0, 0);
            if (ck(FG_ROOM, F_ROOM_0A, FALSE))
            {
                cutnext(CAM_03);
                evt_exec(0, TASK_09, on_aot_02_sub1);
            }
            else
            {
                cutnext(CAM_01);
                evt_exec(0, TASK_09, on_aot_02_sub2);
            }
        }
        else
        {
            evt_exec(0, TASK_09, on_enter);
        }
    }
    evt_finish();
}

event on_aot_02_sub1 when (MANSION2)
{
    run
    {
        set(FG_ROOM, F_ROOM_0A, TRUE);
        msg_list(0, 4640, -1650, 9280, 70, 70, 70, LIGHT_KIND_00, 9200, 6260, -2000, 9369, 70, 70, 70, LIGHT_KIND_00, 9200, 3120, -2000, 9200, 70, 70, 70, LIGHT_KIND_00, 9200, 800, 800, 800);
    }
    evt_chain(on_enter);
    evt_finish();
}

event on_aot_02_sub2 when (MANSION2)
{
    set(FG_ROOM, F_ROOM_0A, FALSE);
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    run
    {
        timer_setup(LIGHT_FADE_VEIL, -10000, FADE_R | FADE_G | FADE_B);
        msg_list(0, 3680, -1650, 7160, 90, 90, 90, LIGHT_KIND_00, 6000, 3880, -2000, 7920, 130, 130, 130, LIGHT_KIND_00, 6639, 3360, -2000, 7920, 111, 111, 111, LIGHT_KIND_00, 5279, 1136, 1120, 1040);
    }
    evt_chain(on_enter);
    evt_finish();
}

event on_enter when (MANSION2)
{
    sleep(1);
    cut_auto(CUT_FREE);
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

event on_enter_2 when (MANSION2)
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 2880, 0, 5600, 0, 3246);
    sleep(1);
    bgm_play(BGM_SUB_1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, on_enter_2_sub1);
        voice_play(VOICE_PLAY, VO_00C_00);
        message(MSG_VO_00C_00, 0);
    }
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 0, 0, 0, 50);
    act_reset();
    evt_nop();
    sleep(30);
    voice_play(VOICE_PLAY, VO_00C_01);
    message(MSG_VO_00C_01, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

event on_enter_2_sub1 when (MANSION2)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(70);
    act_motion_path(MOTION_31, 1250, 0, 0, 50, 0);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_finish();
}

event on_enter_3 when (MANSION2)
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    dir_set(0, 0, 2880, 0, 5600, 0, 3246);
    sleep(1);
    bgm_play(BGM_SUB_1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, on_enter_3_sub1);
        voice_play(VOICE_PLAY, VO_00C_20);
        message(MSG_VO_00C_20, 0);
    }
    sleep(40);
    wait_message();
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_21);
    if (CHRIS)
    {
        sleep(56);
    }
    else if (JPN)
    {
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_0E, TRUE));
    }
    else
    {
        sleep(56);
    }
    sleep(10);
    voice_play(VOICE_PLAY, VO_00C_22);
    message(MSG_VO_00C_22, 0);
    wait_message();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, 0, 0, 0, 250, 250);
    act_idle();
    act_reset();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_finish();
}

event on_enter_3_sub1 when (MANSION2)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(40);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(20);
    act_motion_path(MOTION_33, -1700, -5000, 0, 150, 50);
    sleep(15);
    act_motion_path(MOTION_33, 1700, -5000, 0, 150, 50);
    sleep(25);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    sleep(40);
    act_anim_flags(ANIM_2A, F_ROOM_3F, 0);
    sleep(40);
    act_anim_flags(ANIM_28, F_ROOM_3F, 0);
    act_flag_op(EF_SET, EF_0010);
    act_finish();
}
