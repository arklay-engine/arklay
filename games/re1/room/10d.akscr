event on_enter
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_rot(0, 0, 1024, 0);
    evt_next();
    tw_end();
    evt_finish();
}

event on_enter_2
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_rot(0, 0, 3072, 0);
    evt_next();
    tw_end();
    evt_finish();
}
