  <strings>
    <language lang="en-US">
      <string key="name">PRIVATE ROOM B</string>
      <string key="save_name">Laboratory B3</string>
      <string key="0">{scroll 2}There's a switch. Will\nyou push it?{branch 0 1 1}{scroll 4}\nJohn. ADA...{scroll 2}</string>
      <string key="1">{scroll 4}\nJohn. ADA...{scroll 2}</string>
      <string key="2">{scroll 2}Something is written on\nthe picture...{scroll 2}</string>
      <string key="3">{scroll 2}It's too dark to see\nanything.{scroll 2}</string>
      <string key="4">{scroll 2}It seems someone used this\nonly recently.{scroll 2}</string>
      <string key="5">{scroll 2}It's an air conditioner\nswitch but is broken.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}研究所 {s}/{s}B{s}3{s}</string>
      <string key="0">{scroll 2}     スイッチがある\n 押しますか?{branch 0 1 1}{scroll 4}\n   John、 ADA\xF8\x1C..{scroll 2}</string>
      <string key="1">{scroll 4}\n   John、 ADA\xF8\x1C..{scroll 2}</string>
      <string key="2">{scroll 2}\n  絵に何か書かれている...{scroll 2}</string>
      <string key="3">{scroll 2}\n  暗くてよく見えない...{scroll 2}</string>
      <string key="4">{scroll 2}\n  最近まで使われていたようだ{scroll 2}</string>
      <string key="5">{scroll 2}   エアコンのスイッチだが\n   壊れてしまっているようだ{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Laboratoire SS3</string>
      <string key="0">{scroll 2}Il y a un bouton.\nAppuyer dessus?{branch 0 1 1}</string>
      <string key="1">{scroll 4}\nJohn. Ada...{scroll 2}</string>
      <string key="2">{scroll 2}Il y a quelque chose\nd'écrit sur le tableau...{scroll 2}</string>
      <string key="3">{scroll 2}Il fait trop sombre pour \nvoir quoi que ce soit.{scroll 2}</string>
      <string key="4">{scroll 2}On dirait que quelqu'un \na utilisé ceci récemment.{scroll 2}</string>
      <string key="5">{scroll 2}C'est l'interrupteur de l'air\nconditionné mais il est cassé.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Da ist ein Schalter.\nMöchten Sie ihn betätigen?{branch 0 6 1}</string>
      <string key="1">{scroll 4}\nJohn. Ada...{scroll 2}</string>
      <string key="2">{scroll 2}Auf das Bild wurde etwas\ngeschrieben...{scroll 2}</string>
      <string key="3">{scroll 2}Es ist viel zu dunkel,\num etwas zu sehen.{scroll 2}</string>
      <string key="4">{scroll 2}Es scheint, als ob jemand\ndas kürzlich benutzt hat.{scroll 2}</string>
      <string key="5">{scroll 2}Ein Schalter für die Lüftung,\naber er ist defekt.{scroll 2}</string>
    </language>
    <language lang="it-IT">
