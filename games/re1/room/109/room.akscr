#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_108 0x00
#define AOT_01_DOOR_114 0x01
#define AOT_02_DOOR_113 0x02
#define AOT_03_DOOR_115 0x03
#define AOT_04_DOOR_10A 0x04
#define AOT_05_ITEM_HEAL_HERB_GREEN_0 0x05
#define AOT_06_USEITEM_AMBUSH_TRIGGER 0x06                  // Floor trigger: raises F_ROOM_AMBUSH_TRIGGER_HIT.
#define CAM_03 0x03
#define CAM_06 0x06
#define CAM_07 0x07
#define ENEMY_00_BARRY 0x00
#define ENEMY_00_HUNTER 0x00
#define F_ROOM_AMBUSH_TRIGGER_HIT 0x02                      // The player stepped on AOT_06's trigger (one frame).
#define F_ROOM_ANIM_DONE 0x3F                               // Raised when an actor's animation ends (one frame); nothing waits for it.
#define F_ROOM_ENTERED_EAST 0x01                            // Came in from 108, 113 or 114 before the ambush: the hunter waits for camera 3.
#define F_ROOM_ENTERED_WEST 0x00                            // Came in from 10A or 115 before the ambush: the hunter waits for the floor trigger.
#define IMDL_00_HEAL_HERB_GREEN 0x00
#define MSG_VO_007_0D_63 0x06
#define MSG_VO_00C_00 0x04
#define MSG_VO_00C_01 0x05
#define MSG_VO_00C_20 0x06
#define MSG_VO_00C_21 0x07
#define MSG_VO_00C_22 0x08
#define MSG_VO_105_06 0x00
#define MSG_VO_105_07 0x01
#define MSG_VO_105_08 0x02
#define MSG_VO_105_09 0x03
#define OBJ_00_DOOR_115 0x00                                // Guess: the 115 door's model; moved off when the door is sealed.
#define VO_007_0D_63 0x63
#define VO_00C_00 0x54
#define VO_00C_01 0x55
#define VO_00C_20 0x64
#define VO_00C_21 0x65
#define VO_00C_22 0x66
#define VO_105_05 0x35
#define VO_105_06 0x36
#define VO_105_07 0x37
#define VO_105_08 0x38
#define VO_105_09 0x39

proc init
{
    door_aot_set(AOT_00_DOOR_108, 23400, 800, 2000, 1700, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_108_L_PASSAGE, 25000, 0, 25300, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        door_aot_set(AOT_01_DOOR_114, 25000, 6800, 2000, 2300, 2, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_109_114, ROOM_114_BOILER, 10030, 0, 23449, 1024, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_02_DOOR_113, 17000, 8000, 1600, 1930, 0, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 7, DOOR_LOCK_40, ROOM_113_BATHROOM, 2800, 0, 2400, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_03_DOOR_115, 6850, 8500, 1650, 2500, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCK_40, ROOM_115_ALMOST_A_SANDWICH, 2500, 0, 4900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        door_aot_set(AOT_01_DOOR_114, 25000, 6800, 2000, 2300, 2, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | F_LOCK_109_114, ROOM_114_BOILER, 10030, 0, 23449, 1024, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_02_DOOR_113, 17000, 8000, 1600, 1930, 0, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 7, 0, ROOM_113_BATHROOM, 2800, 0, 2400, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_03_DOOR_115, 6850, 8500, 1650, 2500, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_115_ALMOST_A_SANDWICH, 2500, 0, 4900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    door_aot_set(AOT_04_DOOR_10A, 0, 7300, 2600, 2500, 6, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_10A_BACK_PASSAGE, 15200, 0, 3900, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_05_ITEM_HEAL_HERB_GREEN_0, 20406, 1524, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_00_HEAL_HERB_GREEN, SCA_NONE, 21306, 0, 2424, 0, F_ITEM_109_HEAL_HERB_GREEN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
    {
        aot_set(AOT_06_USEITEM_AMBUSH_TRIGGER, 12600, 2800, 7400, 8700, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 2, 0, 1, 0);
    }
    obj(OBJ_00_DOOR_115, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 7590, 0, 8680, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
        {
            enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 0, 0, 0, ENEMY_00_BARRY, ANIM_22, 24, EVAR_00);
            if (ck(FG_COMMON, F_COMMON_CEILING_TRAP_SPRUNG, TRUE))
            {
                evt_exec(0, TASK_09, seal_door_115);
                if (ck(FG_COMMON, F_COMMON_J_BARRY_SANDWICH_TALK_DONE, FALSE))
                {
                    evt_exec(0, TASK_09, chris_radio_call_or_barry_sandwich_talk);
                    cut_auto(CUT_LOCKED);
                    setb(B_CAMERA, CAM_07, 0);
                }
            }
        }
    }
    else
    {
        if (ck(FG_SCENARIO, F_SCENARIO_TRAP_PASSAGE_HUNTER_AMBUSH, TRUE))
        {
            enemy(EM_06_HUNTER, EB_12, F_ENEMY_109_HUNTER_0, SPAWN_FORCE, 2, 0, 1536, 0, 15565, 0, 12166, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        else
        {
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_10A_BACK_PASSAGE))
            {
                set(FG_ROOM, F_ROOM_ENTERED_WEST, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_115_ALMOST_A_SANDWICH))
            {
                set(FG_ROOM, F_ROOM_ENTERED_WEST, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_108_L_PASSAGE))
            {
                set(FG_ROOM, F_ROOM_ENTERED_EAST, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_113_BATHROOM))
            {
                set(FG_ROOM, F_ROOM_ENTERED_EAST, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_114_BOILER))
            {
                set(FG_ROOM, F_ROOM_ENTERED_EAST, TRUE);
            }
        }
        if (ck(FG_ROOM, F_ROOM_ENTERED_WEST, TRUE))
        {
            enemy(EM_06_HUNTER, EB_88, F_ENEMY_109_HUNTER_0, SPAWN_FORCE, 2, 0, 3600, 0, 20824, 0, 7524, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_ROOM, F_ROOM_ENTERED_EAST, TRUE))
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                enemy(EM_06_HUNTER, EB_89, F_ENEMY_109_HUNTER_0, SPAWN_FORCE, 2, 0, 0, 0, 12733, 0, 14086, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_06_HUNTER, EB_99, F_ENEMY_109_HUNTER_0, SPAWN_FORCE, 2, 0, 0, 0, 12733, 0, 14086, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            }
        }
        room_bgm_state_set(5, 9, BGM_OFF);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_RADIO_CALL_DUE, TRUE))
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_RADIO_CALL_DUE, FALSE);
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_IN_SAVE_ROOM, TRUE))
                {
                    plw_anim(PLW_02, ANIM_28, 0);
                    setw(W_04, 0);
                    room_bgm_state_set(5, 9, BGM_RELOAD);
                    cut_auto(CUT_LOCKED);
                    setb(B_CAMERA, CAM_07, 0);
                    evt_exec(0, TASK_09, chris_radio_call_or_barry_sandwich_talk);
                }
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_UPSTAIRS_CALL, TRUE))
                {
                    plw_anim(PLW_02, ANIM_28, 0);
                    setw(W_04, 0);
                    room_bgm_state_set(5, 9, BGM_RELOAD);
                    cut_auto(CUT_LOCKED);
                    setb(B_CAMERA, CAM_07, 0);
                    evt_exec(0, TASK_09, rebecca_radio_call_upstairs);
                }
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_CEILING_TRAP_SPRUNG, TRUE))
            {
                evt_exec(0, TASK_09, seal_door_115);
            }
        }
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        return;
    }
    else
    {
        if (ck(FG_SCENARIO, F_SCENARIO_TRAP_PASSAGE_HUNTER_AMBUSH, FALSE))
        {
            if (ck(FG_ROOM, F_ROOM_ENTERED_WEST, TRUE) && ck(FG_ROOM, F_ROOM_AMBUSH_TRIGGER_HIT, TRUE))
            {
                set(FG_SCENARIO, F_SCENARIO_TRAP_PASSAGE_HUNTER_AMBUSH, TRUE);
                eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_08);
            }
            if (ck(FG_ROOM, F_ROOM_ENTERED_EAST, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_03))
            {
                set(FG_SCENARIO, F_SCENARIO_TRAP_PASSAGE_HUNTER_AMBUSH, TRUE);
                eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, EB_09);
            }
        }
    }
}

event seal_door_115_chris
{
    evt_work_set(WK_OBJ, OBJ_00_DOOR_115);
    evt_tween_begin_alt();
    tw_abs_pos(0, 1000, 0, 1000);
    tw_end();
    evt_nop();
    single(6) aot_reset(AOT_03_DOOR_115, SCE_NONE, 0, 0, 0, 0);
    evt_nop();
    evt_nop();
    evt_nop();
    evt_nop();
    evt_nop();
    evt_nop();
    evt_finish();
}

event chris_radio_call_or_barry_sandwich_talk
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        dir_set(0, 0, 650, 0, 5300, 0, 7160);
    }
    else
    {
        run
        {
            set(FG_COMMON, F_COMMON_J_BARRY_SANDWICH_TALK_DONE, TRUE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            dir_set(0, 0, 2400, 0, 6800, 0, 7300);
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                pos_set(ENEMY_00_BARRY, 0, 400, 0, 4800, 0, 8900);
            }
            else
            {
                pos_set(ENEMY_00_HUNTER, 0, 400, 0, 4800, 0, 8900);
            }
        }
    }
    sleep(1);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    }
    else if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_BARRY, 0, 150, 75);
    }
    else
    {
        act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_HUNTER, 0, 150, 75);
    }
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        sleep(10);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_fork(TASK_09, barry_sandwich_talk_both_1, 0);
        }
        else
        {
            evt_fork(TASK_09, barry_sandwich_talk_both_1, 0);
        }
        sleep(4);
        voice_play(VOICE_PLAY, VO_105_05);
        sleep(35);
        wait_message();
        sleep(30);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_fork(TASK_09, barry_sandwich_talk_barry_1, 0);
            evt_fork(TASK_09, barry_sandwich_talk_jill_1, 0);
        }
        else
        {
            evt_fork(TASK_09, barry_sandwich_talk_barry_1, 0);
            evt_fork(TASK_09, barry_sandwich_talk_jill_1, 0);
        }
        voice_play(VOICE_PLAY, VO_105_06);
        message(MSG_VO_105_06, 0);
        wait_message();
        sleep(30);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_fork(TASK_09, barry_sandwich_talk_jill_2, 0);
        }
        else
        {
            evt_fork(TASK_09, barry_sandwich_talk_jill_2, 0);
        }
        sleep(20);
        voice_play(VOICE_PLAY, VO_105_07);
        message(MSG_VO_105_07, 0);
        wait_message();
        sleep(30);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_fork(TASK_09, barry_sandwich_talk_barry_2, 0);
        }
        else
        {
            evt_fork(TASK_09, barry_sandwich_talk_barry_2, 0);
        }
        voice_play(VOICE_PLAY, VO_105_08);
        message(MSG_VO_105_08, 0);
        wait_message();
        cutnext(CAM_06);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_fork(TASK_09, barry_sandwich_talk_both_2, 0);
        }
        else
        {
            evt_fork(TASK_09, barry_sandwich_talk_both_2, 0);
        }
        sleep(85);
    }
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
            {
                bgm_play(BGM_SUB_1);
                set(FG_RUN, F_RUN_MONSTERS, FALSE);
            }
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                evt_exec(0, TASK_09, rebecca_radio_call_chris);
            }
            else
            {
                evt_exec(0, TASK_09, rebecca_radio_call_chris);
            }
            voice_play(VOICE_PLAY, VO_00C_00);
            message(MSG_VO_00C_00, 0);
        }
        else
        {
            cutnext(CAM_07);
            voice_play(VOICE_PLAY, VO_105_09);
            message(MSG_VO_105_09, 0);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_fork(TASK_09, barry_sandwich_talk_barry_3, 0);
            evt_fork(TASK_09, barry_sandwich_talk_jill_3, 0);
        }
        else
        {
            evt_fork(TASK_09, barry_sandwich_talk_barry_3, 0);
            evt_fork(TASK_09, barry_sandwich_talk_jill_3, 0);
        }
    }
    wait_message();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        sleep(50);
        run
        {
            cutnext(CAM_06);
            dir_set(0, 0, 3360, 0, 5400, 0, 8400);
            if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
            {
                pos_set(ENEMY_00_BARRY, 0, 0, 0, 0, 0, 0);
            }
            else
            {
                pos_set(ENEMY_00_HUNTER, 0, 0, 0, 0, 0, 0);
            }
        }
        sleep(20);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        act_motion_path(MOTION_32, 0, 0, 0, 0, 50);
    }
    else
    {
        act_motion_path(MOTION_33, 500, 0, 0, 70, 0);
        act_motion(MOTION_10);
    }
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        sleep(30);
        voice_play(VOICE_PLAY, VO_00C_01);
        message(MSG_VO_00C_01, 0);
        wait_message();
    }
    else
    {
        sleep(10);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        act_nop();
    }
    act_reset();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        evt_nop();
    }
    run
    {
        cut_auto(CUT_FREE);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            dir_set(0, 0, 1194, 0, 5520, 0, 8360);
        }
        else
        {
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE) && ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            set(FG_RUN, F_RUN_MONSTERS, TRUE);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_idle();
        act_reset();
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event rebecca_radio_call_chris
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE, 0);
    sleep(30);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE, 0);
    sleep(20);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE, 0);
    sleep(70);
    act_motion_path(MOTION_31, 1250, 0, 0, 50, 0);
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE, 0);
    sleep(20);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_finish();
}
event seal_door_115
{
    evt_work_set(WK_OBJ, OBJ_00_DOOR_115);
    evt_tween_begin_alt();
    tw_abs_pos(0, 1000, 0, 1000);
    tw_end();
    evt_nop();
    aot_delete(AOT_03_DOOR_115, SCE_NONE, 0);
    evt_finish();
}

event rebecca_radio_call_upstairs
{
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    dir_set(0, 0, 650, 0, 5300, 0, 7160);
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 250, 0, 0, 250);
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
        {
            bgm_play(BGM_SUB_1);
            set(FG_RUN, F_RUN_MONSTERS, FALSE);
        }
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
        {
            evt_exec(0, TASK_09, rebecca_radio_call_upstairs_chris);
            voice_play(VOICE_PLAY, VO_007_0D_63);
            message(MSG_VO_007_0D_63, 0);
        }
        else
        {
            evt_exec(0, TASK_09, rebecca_radio_call_upstairs_chris);
            voice_play(VOICE_PLAY, VO_00C_20);
            message(MSG_VO_00C_20, 0);
        }
    }
    wait_message();
    sleep(10);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        voice_play(VOICE_PLAY, VO_00C_20);
        do
        {
            evt_next();
        }
        while (ck(FG_STATUS, F_STATUS_VOICE_PLAYING, TRUE));
        sleep(10);
    }
    voice_play(VOICE_PLAY, VO_00C_21);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        message(MSG_VO_00C_21, 0);
    }
    else
    {
        sleep(56);
        sleep(10);
        voice_play(VOICE_PLAY, VO_00C_22);
        message(MSG_VO_00C_22, 0);
    }
    wait_message();
    run
    {
        dir_set(0, 0, 1194, 0, 5520, 0, 8360);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
        {
            set(FG_RUN, F_RUN_MONSTERS, TRUE);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
