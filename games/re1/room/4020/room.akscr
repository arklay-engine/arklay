#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_03_NONE 0x03
#define AOT_04_MESSAGE 0x04
#define AOT_05_MESSAGE 0x05
#define CAM_00 0x00
#define CAM_01 0x01
#define F_ROOM_18 0x18
#define F_ROOM_19 0x19
#define F_ROOM_1A 0x1A
#define IMDL_00 0x00
#define MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY 0x00
#define OBJ_00 0x00
#define OBJ_01 0x01
#define SE_17_BATHMIX 0x17

proc init
{
    door_aot_set(AOT_00_DOOR, 6600, 2000, 2100, 2300, 2, DOOR_SND_00_DR_WD, DOOR_21_DOOR15, 1, 0, ROOM_401_ROOM_001, 9200, 0, 3200, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM, 1300, 2100, 2400, 3200, IT_3B_KEY_CONTROL_ROOM, 1, IMDL_00, SCA_NONE, 2570, -560, 3870, 246, F_ITEM_9C, SAT_MANUAL | SAT_PLAYER, 0);
    eml_rot(IMDL_00, 0, 2048);
    obj(OBJ_00, OF_ACTIVE, SCA_NONE, 21000, 0, 21000, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_01, OF_ACTIVE, SCA_NONE, 20000, 0, 20000, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_03_NONE, 1300, 2100, 2400, 3200, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 2, 0, 0, 0);
    aot_set(AOT_04_MESSAGE, 4800, 700, 1500, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_05_MESSAGE, 2000, 6400, 2000, 1600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    set(FG_STATUS, F_STATUS_1D, TRUE);
    set(FG_ROOM, F_ROOM_1A, TRUE);
    if (ck(FG_SCENARIO, F_SCENARIO_43, FALSE))
    {
        aot_delete(AOT_01_ITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_03_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        evt_exec(0, TASK_09, on_enter);
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_18, TRUE))
    {
        set(FG_ROOM, F_ROOM_18, FALSE);
        if (ck(FG_ROOM, F_ROOM_19, TRUE))
        {
            set(FG_ROOM, F_ROOM_19, FALSE);
            evt_exec(0, TASK_09, from_main_2);
        }
        else
        {
            evt_exec(0, TASK_09, from_main_3);
            set(FG_STATUS, F_STATUS_0F, FALSE);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_43, FALSE) && ck(FG_ROOM, F_ROOM_1A, TRUE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_00) && ck(FG_STATUS, F_STATUS_1A, TRUE))
        {
            evt_exec(0, TASK_09, on_enter);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_01) && ck(FG_STATUS, F_STATUS_1A, TRUE))
        {
            evt_exec(0, TASK_09, from_main);
        }
    }
}

event on_enter
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 2580, -1610, 4580);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_finish();
}

event from_main
{
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 2600, -680, 3680);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 20000, 0, 20000);
    tw_finish();
}

event event_02
{
    run
    {
        set(FG_ROOM, F_ROOM_1A, FALSE);
        cut_auto(CUT_LOCKED);
    }
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 2600, -680, 3680);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 20000, 0, 20000);
    tw_end();
    evt_nop();
    run
    {
        aot_delete(AOT_03_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        cutnext(CAM_01);
    }
    evt_next();
    evt_nop();
    sleep(15);
    run
    {
        message(MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "The bathtub is filled with muddy water. Will you unplug it? Nothing special."
    }
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_ROOM, F_ROOM_18, TRUE);
        require(cmpb(B_MENU_CHOICE, CMP_EQ, 0));
        set(FG_ROOM, F_ROOM_19, TRUE);
    }
    evt_finish();
}

event from_main_2
{
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_BATHMIX, 0, SND_AT_POINT, 0, 2400, 3800);
        set(FG_SCENARIO, F_SCENARIO_43, TRUE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_pos(0, 1, 0);
    for (15)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    for (60)
    {
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 2, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
    }
    tw_end();
    sleep(30);
    set(FG_STATUS, F_STATUS_0F, FALSE);
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_end();
    evt_nop();
    run
    {
        set(FG_ROOM, F_ROOM_1A, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        cut_auto(CUT_FREE);
    }
    sleep(3);
    run
    {
        aot_delete(AOT_01_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
    }
    evt_finish();
}

event from_main_3
{
    sleep(20);
    run
    {
        set(FG_ROOM, F_ROOM_1A, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        cut_auto(CUT_FREE);
    }
    sleep(3);
    run
    {
        aot_delete(AOT_03_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    evt_finish();
}
