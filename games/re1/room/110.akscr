#version 1

proc init
{
    door_aot_set(0, 9900, 2000, 2500, 2700, 9, 0, 0, 1, 147, RDT_004, 31800, 0, 3300, 2048, LOCK, 129);
    door_aot_set(1, 0, 9200, 2500, 2700, 0, 0, 0, 1, 0, RDT_21C, 3800, 0, 10000, 2048, UNLOCKED, 129);
    aot_set(2, 4500, 9300, 4348, 3500, SCE_5, 129, 0, 0, 0, 0, 0, 0);
    aot_set(3, 11151, 9300, 4148, 3500, SCE_5, 129, 0, 0, 0, 0, 0, 0);
    aot_set(4, 8030, 8400, 500, 4400, SCE_EVENT, 65, 9, 0, event_00, 0, 0, 0);
    aot_set(5, 11049, 8400, 500, 4400, SCE_EVENT, 65, 9, 0, event_01, 0, 0, 0);
    aot_set(6, 15100, 6200, 1700, 2300, SCE_MESSAGE, 129, 128, 0, 79, 0, 0, 0);
    set(FG_STATUS, 29, 0);
}

proc main
{
    if (cmpb(2, 0, 0))
    {
        set(FG_MAP, 62, 0);
    }
}

event event_00
{
    run
    {
        aot_delete(5, SCE_NONE, 65);
        cut_auto(1);
        dir_set(0, 0, 0, 0, 11336, -4315, 10556);
        spd_set(0, 37, 239);
        aot_on(3, SCE_5, 0);
        cutnext(1);
        cut_auto(0);
    }
    sleep(70);
    run
    {
        aot_delete(5, SCE_EVENT, 65);
    }
    evt_finish();
}

event event_01
{
    run
    {
        aot_delete(4, SCE_NONE, 65);
        cut_auto(1);
        dir_set(0, 0, 2048, 0, 8338, -2885, 10453);
        spd_set(0, 187, 244);
        aot_on(2, SCE_5, 0);
        cutnext(0);
        cut_auto(0);
    }
    sleep(70);
    run
    {
        aot_delete(4, SCE_EVENT, 65);
    }
    evt_finish();
}
