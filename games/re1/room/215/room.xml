  <strings>
    <language lang="en-US">
      <string key="save_name">Hall 1F</string>
      <string key="0">{scroll 2}There's a switch. Will \nyou push it?{scroll 1}{branch 0 1 0}{scroll 2}\n...Nothing important.{scroll 1}</string>
      <string key="1">{scroll 2}\n...Nothing important.{scroll 1}</string>
      <string key="2">{scroll 2}Will you try and take out\nthe eyeball?{scroll 1}{branch 0 1 0}{scroll 2}\nIt looks as if it's alive.{scroll 1}</string>
      <string key="3">{scroll 2}\nIt looks as if it's alive.{scroll 1}</string>
      <string key="4">{scroll 2}It looks like it's about\nto move.{scroll 1}</string>
      <string key="5">{scroll 2}\nA rocking chair.{scroll 1}</string>
      <string key="6">{scroll 2}\nNothing useful.{scroll 1}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}ホ{s}ー{s}ル{s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 2}     スイッチがある\n押しますか?{scroll 1}{branch 0 1 0}{scroll 2}\n     ・・・何もない{scroll 1}</string>
      <string key="1">{scroll 2}\n     ・・・何もない{scroll 1}</string>
      <string key="2">{scroll 2}     目玉が取れそうだ\n取りますか?{scroll 1}{branch 0 1 0}{scroll 2}\n   まるで生きているようだ{scroll 1}</string>
      <string key="3">{scroll 2}\n   まるで生きているようだ{scroll 1}</string>
      <string key="4">{scroll 2}\n    今にも動きだしそうだ{scroll 1}</string>
      <string key="5">{scroll 2}\n   ロッキングチェアーがある{scroll 1}</string>
      <string key="6">{scroll 2}\n   特に変わったものはない{scroll 1}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Hall RdC</string>
      <string key="0">{scroll 2}Il y a un bouton. \nAppuyer dessus?{scroll 1}{branch 0 6 0}</string>
      <string key="1">{scroll 2}\n...Rien d'important{scroll 1}</string>
      <string key="2">{scroll 2}Voulez-vous essayer  \nd'extraire les yeux?{scroll 1}{branch 0 6 0}</string>
      <string key="3">{scroll 2}\nOn dirait que c'est vivant.{scroll 1}</string>
      <string key="4">{scroll 2}\nOn dirait que ça va bouger.{scroll 1}</string>
      <string key="5">{scroll 2}\nUn rocking chair.{scroll 1}</string>
      <string key="6">{scroll 2}\nRien d'utile.{scroll 1}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Da ist ein Schalter.\nMöchten Sie draufdrücken?{scroll 1}{branch 0 6 0}</string>
      <string key="1">{scroll 2}\nNichts Wichtiges.{scroll 1}</string>
      <string key="2">{scroll 2}Möchten Sie den Augapfel\nherausnehmen?{scroll 1}{branch 0 6 0}</string>
      <string key="3">{scroll 2}Er sieht aus, \nals ob er am Leben ist.{scroll 1}</string>
      <string key="4">{scroll 2}Er sieht aus,\nals ob er sich gleich bewegt.{scroll 1}</string>
      <string key="5">{scroll 2}\nEin Schaukelstuhl.{scroll 1}</string>
      <string key="6">{scroll 2}\nNichts von Interesse.{scroll 1}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Atrio 1P</string>
      <string key="0">{scroll 2}C'è un interruttore. \nVuoi premerlo?{scroll 1}{branch 0 6 0}</string>
      <string key="1">{scroll 2}\nNiente di speciale.{scroll 1}</string>
      <string key="2">{scroll 2}Vuoi provare a rimuovere \nl'occhio?{scroll 1}{branch 0 6 0}</string>
      <string key="3">{scroll 2}\nSembra quasi vivo.{scroll 1}</string>
      <string key="4">{scroll 2}È come se stesse \nper muoversi.{scroll 1}</string>
      <string key="5">{scroll 2}\nUna sedia a dondolo.{scroll 1}</string>
      <string key="6">{scroll 2}\nNiente di utile.{scroll 1}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}Hay un interruptor... \n¿Quieres apretarlo?{scroll 1}{branch 0 6 0}</string>
      <string key="1">{scroll 2}\n... Nada importante...{scroll 1}</string>
      <string key="2">{scroll 2}¿Quieres intentar sacar\nel ojo?{scroll 1}{branch 0 6 0}</string>
      <string key="3">{scroll 2}\nParece que estuviera vivo...{scroll 1}</string>
      <string key="4">{scroll 2}Parece a punto de\nmoverse...{scroll 1}</string>
      <string key="5">{scroll 2}\nUna mecedora...{scroll 1}</string>
      <string key="6">{scroll 2}\nNada útil...{scroll 1}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Зал 1-эт.</string>
      <string key="0">{scroll 2}Здесь кнопка.\nНажать её?{scroll 1}{branch 0 1 0}{scroll 2}\n...Ничего важного.{scroll 1}</string>
      <string key="1">{scroll 2}\n...Ничего важного.{scroll 1}</string>
      <string key="2">{scroll 2}\nВытащить глаз?{scroll 1}{branch 0 1 0}{scroll 2}\nПохоже, что он жив.{scroll 1}</string>
      <string key="3">{scroll 2}\nПохоже, что он жив.{scroll 1}</string>
      <string key="4">{scroll 2}Похоже, он\nсобирается двигаться.{scroll 1}</string>
      <string key="5">{scroll 2}\nКресло-качалка.{scroll 1}</string>
      <string key="6">{scroll 2}\nНичего полезного.{scroll 1}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Pääaula 1 krs</string>
      <string key="0">{scroll 2}Siinä on painike...\nPainatko sitä?{scroll 1}{branch 0 6 0}</string>
      <string key="1">{scroll 2}Ei mitään tärkeää...{scroll 1}</string>
      <string key="2">{scroll 2}Koitatko irroittaa silmän?{scroll 1}{branch 0 6 0}</string>
      <string key="3">{scroll 2}Näyttää siltä kuin se olisi\nelossa...{scroll 1}</string>
      <string key="4">{scroll 2}Näyttää siltä kuin se lähtisi\nlentoon...{scroll 1}</string>
      <string key="5">{scroll 2}Keinutuoli...{scroll 1}</string>
      <string key="6">{scroll 2}Ei mitään hyödyllistä...{scroll 1}</string>
    </language>
  </strings>
