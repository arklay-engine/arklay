#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_201 0x00
#define AOT_01_EVENT_LIGHT_SWITCH 0x01
#define AOT_02_EVENT_DEER_HEAD 0x02
#define AOT_03_ITEM_AMMO_SHOTGUN_0 0x03
#define AOT_04_ITEM_FILE_ORDERS_1 0x04
#define AOT_05_ITEM_KEY_JEWEL_RED_2 0x05                    // In the deer head's eye; switched on only by the eyeball prompt.
#define AOT_06_ITEM_AMMO_MAGNUM_3 0x06
#define AOT_07_MESSAGE_ROCKING_CHAIR 0x07
#define AOT_08_MESSAGE_NOTHING 0x08
#define AOT_09_MESSAGE_TROPHY_ALIVE 0x09                    // "It looks as if it's alive."
#define AOT_0A_MESSAGE_TROPHY_MOVING 0x0A                   // "It looks like it's about to move."
#define AOT_0B_MESSAGE_NOTHING 0x0B
#define CAM_00_DARK_SWITCH 0x00                             // Camera 4 with the lights off.
#define CAM_01_DARK_ROOM 0x01                               // Camera 5 with the lights off.
#define CAM_03_DARK_DEER_HEAD 0x03                          // Camera 7 with the lights off.
#define CAM_04_LIT_SWITCH 0x04
#define CAM_05_LIT_ROOM 0x05
#define CAM_07_LIT_DEER_HEAD 0x07
#define FX_0C 0x0C
#define IMDL_00_AMMO_SHOTGUN 0x00
#define IMDL_01_FILE_ORDERS 0x01
#define IMDL_02_KEY_JEWEL_RED 0x02
#define IMDL_03_AMMO_MAGNUM 0x03
#define MSG_NOTHING_IMPORTANT 0x01
#define MSG_THERE_IS_A_SWITCH 0x00
#define MSG_WILL_YOU_TRY_AND_TAKE_OUT 0x02
#define OBJ_00_STEP 0x00                                    // Likely: the climbable step below the deer head.
#define SE_17_SW_BTN 0x17

proc init
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
    {
        door_aot_set(AOT_00_DOOR_201, 8100, 3200, 1800, 1300, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, ROOM_201_2F_LEFT_STAIRS, 15000, 0, 17500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        aot_set(AOT_01_EVENT_LIGHT_SWITCH, 8200, 5100, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, push_light_switch, 0, 0, 0);
        aot_set(AOT_02_EVENT_DEER_HEAD, 4450, 10680, 1000, 1500, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_deer_head, 0, 0, 0);
        item_aot_set(AOT_03_ITEM_AMMO_SHOTGUN_0, 1820, 9520, 1000, 1000, IT_0C_AMMO_SHOTGUN, 7, IMDL_00_AMMO_SHOTGUN, SCA_NONE, 2320, -1200, 10020, 2048, F_ITEM_215_AMMO_SHOTGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
        item_aot_set(AOT_04_ITEM_FILE_ORDERS_1, 3900, 7500, 1700, 1600, IT_62_FILE_ORDERS, 0, IMDL_01_FILE_ORDERS, SCA_NONE, 4850, -1210, 8180, -1100, F_ITEM_215_FILE_ORDERS_1, SAT_MANUAL | SAT_PLAYER, 0);
        eml_rot(IMDL_01_FILE_ORDERS, 380, 2280);
        item_aot_set(AOT_05_ITEM_KEY_JEWEL_RED_2, 0, 0, 10, 10, IT_22_KEY_JEWEL_RED, 1, IMDL_02_KEY_JEWEL_RED, SCA_NONE, 8200, -5690, 14130, 0, F_ITEM_215_KEY_JEWEL_RED_2, SAT_MANUAL | SAT_PLAYER, 0);
        eml_rot(IMDL_02_KEY_JEWEL_RED, 0, -1024);
        setbyte(2, 0, 0);
        item_aot_set(AOT_06_ITEM_AMMO_MAGNUM_3, 1780, 7820, 1000, 1500, IT_0E_AMMO_MAGNUM, 6, IMDL_03_AMMO_MAGNUM, SCA_NONE, 2280, -1200, 9120, 0, F_ITEM_215_AMMO_MAGNUM_3, SAT_MANUAL | SAT_PLAYER, 0);
        obj(OBJ_00_STEP, OF_CLIMBABLE | OF_ACTIVE, SCA_NONE, 6720, 0, 10440, 0, 576, 0, -576, 0, 540, 900, 1000, 540);
        if (ck(FG_COMMON, F_COMMON_STUFFED_ROOM_LIGHTS_OFF, FALSE))
        {
            cutnext(CAM_04_LIT_SWITCH);
            evt_exec(0, TASK_09, restore_control);
        }
        else
        {
            msg_list(0, 9746, -3080, 6648, 56, 56, 56, LIGHT_KIND_00, 11720, 9897, -3050, 7248, 56, 56, 56, LIGHT_KIND_00, 11120, 9995, -3000, 6408, 180, 180, 180, LIGHT_KIND_00, 9120, 416, 416, 416);
            if (ck(FG_ITEM, F_ITEM_215_KEY_JEWEL_RED_2, TRUE))
            {
                effect_tracked(FX_0C, FX_ROW_19, FX_AT_WORLD, 5200, 61536, 12100, 0);
            }
        }
        aot_set(AOT_07_MESSAGE_ROCKING_CHAIR, 5500, 5200, 1100, 2500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 133, 0, 255, 0, 0, 0);
        aot_set(AOT_08_MESSAGE_NOTHING, 3600, 11500, 3500, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 134, 0, 255, 0, 0, 0);
        aot_set(AOT_09_MESSAGE_TROPHY_ALIVE, 7100, 11500, 1800, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 0, 255, 0, 0, 0);
        aot_set(AOT_0A_MESSAGE_TROPHY_MOVING, 1500, 10900, 2000, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
        aot_set(AOT_0B_MESSAGE_NOTHING, 2200, 7500, 300, 2500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 134, 0, 255, 0, 0, 0);
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
    {
        if (ck(FG_STATUS, F_STATUS_DOOR_TRANSITION, TRUE))
        {
            aot_delete(AOT_02_EVENT_DEER_HEAD, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_03_ITEM_AMMO_SHOTGUN_0, SCE_ITEM, 0);
            aot_delete(AOT_04_ITEM_FILE_ORDERS_1, SCE_DOCUMENT, 0);
            aot_delete(AOT_05_ITEM_KEY_JEWEL_RED_2, SCE_ITEM, 0);
        }
        else
        {
            aot_delete(AOT_02_EVENT_DEER_HEAD, SCE_EVENT, 0);
            aot_delete(AOT_03_ITEM_AMMO_SHOTGUN_0, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_04_ITEM_FILE_ORDERS_1, SCE_DOCUMENT, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_05_ITEM_KEY_JEWEL_RED_2, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        if (ck(FG_ITEM, F_ITEM_215_KEY_JEWEL_RED_2, FALSE))
        {
            aot_delete(AOT_02_EVENT_DEER_HEAD, SCE_NONE, 0);
        }
        if (ck(FG_ITEM, F_ITEM_215_AMMO_SHOTGUN_0, FALSE))
        {
            aot_delete(AOT_03_ITEM_AMMO_SHOTGUN_0, SCE_NONE, 0);
        }
        if (ck(FG_ITEM, F_ITEM_215_FILE_ORDERS_1, FALSE))
        {
            aot_delete(AOT_04_ITEM_FILE_ORDERS_1, SCE_NONE, 0);
        }
        if (ck(FG_ITEM, F_ITEM_215_AMMO_MAGNUM_3, FALSE))
        {
            aot_delete(AOT_05_ITEM_KEY_JEWEL_RED_2, SCE_NONE, 0);
        }
    }
}

event push_light_switch
{
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    message(MSG_THERE_IS_A_SWITCH | MSG_FAST, 0); // "There's a switch. Will you push it? ...Nothing important."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            se_play_3d(SND_BANK_ROOM, SE_17_SW_BTN, 0, SND_AT_POINT, 0, 8200, 5100);
            if (ck(FG_COMMON, F_COMMON_STUFFED_ROOM_LIGHTS_OFF, FALSE))
            {
                if (cmpb(B_CAMERA, CMP_EQ, CAM_04_LIT_SWITCH))
                {
                    cutnext(CAM_00_DARK_SWITCH);
                }
                else
                {
                    cutnext(CAM_01_DARK_ROOM);
                }
                evt_exec(0, TASK_09, lights_off);
            }
            else
            {
                if (cmpb(B_CAMERA, CMP_EQ, CAM_00_DARK_SWITCH))
                {
                    cutnext(CAM_04_LIT_SWITCH);
                }
                else
                {
                    cutnext(CAM_05_LIT_ROOM);
                }
                evt_exec(0, TASK_09, lights_on);
            }
        }
        else
        {
            evt_exec(0, TASK_09, restore_control);
        }
    }
    evt_finish();
}

event lights_off
{
    run
    {
        if (ck(FG_ITEM, F_ITEM_215_KEY_JEWEL_RED_2, TRUE))
        {
            effect_tracked(FX_0C, FX_ROW_19, FX_AT_WORLD, 5200, 61536, 12100, 0);
        }
        msg_list(0, 9746, -3080, 6648, 56, 56, 56, LIGHT_KIND_00, 11720, 9897, -3050, 7248, 56, 56, 56, LIGHT_KIND_00, 11120, 9995, -3000, 6408, 180, 180, 180, LIGHT_KIND_00, 9120, 416, 416, 416);
        set(FG_COMMON, F_COMMON_STUFFED_ROOM_LIGHTS_OFF, TRUE);
    }
    evt_chain(restore_control);
    evt_finish();
}

event lights_on
{
    run
    {
        if (ck(FG_ITEM, F_ITEM_215_KEY_JEWEL_RED_2, TRUE))
        {
            effect_kill_a(0);
        }
        set(FG_COMMON, F_COMMON_STUFFED_ROOM_LIGHTS_OFF, FALSE);
    }
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    run
    {
        timer_setup(LIGHT_FADE_VEIL, -10000, FADE_R | FADE_G | FADE_B);
        msg_list(0, 9746, -3080, 6648, 200, 200, 200, LIGHT_KIND_00, 6400, 5297, -3050, 8048, 200, 200, 200, LIGHT_KIND_00, 6640, 5235, -3000, 7248, 200, 200, 200, LIGHT_KIND_00, 6640, 1328, 832, 368);
    }
    evt_chain(restore_control);
    evt_finish();
}

event restore_control
{
    sleep(5);
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event examine_deer_head
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        if (ck(FG_COMMON, F_COMMON_STUFFED_ROOM_LIGHTS_OFF, FALSE))
        {
            cutnext(CAM_07_LIT_DEER_HEAD);
            evt_exec(0, TASK_09, deer_head_nothing);
        }
        else
        {
            cutnext(CAM_03_DARK_DEER_HEAD);
            setbyte(2, 1, 0);
            effect_kill_a(0);
            msg_list(0, 5800, -3080, 10700, 255, 255, 255, LIGHT_KIND_00, 6640, 5800, -3050, 10700, 255, 255, 255, LIGHT_KIND_00, 6640, 5800, -3000, 10700, 255, 255, 255, LIGHT_KIND_00, 6640, 1400, 1400, 1400);
            evt_exec(0, TASK_09, eyeball_prompt);
            evt_exec(0, TASK_07, spin_jewel);
        }
    }
    evt_finish();
}

event deer_head_nothing
{
    sleep(50);
    message(MSG_NOTHING_IMPORTANT, 0); // "...Nothing important."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        cutcurr(0);
    }
    sleep(1);
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event eyeball_prompt
{
    sleep(50);
    message(MSG_WILL_YOU_TRY_AND_TAKE_OUT | MSG_FAST, 0); // "Will you try and take out the eyeball? It looks as if it's alive."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, take_eyeball);
        }
        else
        {
            evt_exec(0, TASK_09, leave_deer_head);
        }
    }
    evt_finish();
}

event take_eyeball
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_on(AOT_05_ITEM_KEY_JEWEL_RED_2, SCE_ITEM, 0);
    }
    evt_next();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    sleep(1);
    evt_chain(leave_deer_head);
    evt_finish();
}

event leave_deer_head
{
    evt_disable(TASK_07);
    run
    {
        if (ck(FG_ITEM, F_ITEM_215_KEY_JEWEL_RED_2, TRUE))
        {
            effect_tracked(FX_0C, FX_ROW_19, FX_AT_WORLD, 5200, 61536, 12100, 0);
        }
        setbyte(2, 0, 0);
        cutcurr(0);
        msg_list(0, 9746, -3080, 6648, 56, 56, 56, LIGHT_KIND_00, 11720, 9897, -3050, 7248, 56, 56, 56, LIGHT_KIND_00, 11120, 9995, -3000, 6408, 180, 180, 180, LIGHT_KIND_00, 9120, 416, 416, 416);
    }
    sleep(1);
    run
    {
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event spin_jewel
{
    for (40)
    {
        evt_work_set(WK_AOT, IMDL_02_KEY_JEWEL_RED);
        evt_tween_begin_alt();
        tw_set_rot(20, 0, 0);
        tw_rot_add();
        tw_nop();
        tw_end();
        evt_nop();
        sleep(1);
    }
    evt_nop();
    sleep(60);
    evt_chain(spin_jewel);
    evt_finish();
}
