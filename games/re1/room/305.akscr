event event_0A
{
    evt_work_set(WK_OBJ, 2);
    evt_tween_begin_alt();
    tw_abs_pos(0, 6180, 2000, 13450);
    tw_set_pos(0, 231, 0);
    for (80)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 6180, 0, 13450);
    tw_end();
    evt_nop();
    evt_finish();
}

event event_0B
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1F, FALSE);
    }
    sleep(10);
    run
    {
        bgm_stop_all(0);
        movie_on(8);
        cut_auto(1);
        if (ck(FG_ROOM, FLAG_ROOM_1E, FALSE))
        {
            cutnext(2);
        }
        else
        {
            cutnext(4);
        }
        cut_auto(0);
    }
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_6, FLAG_6_1F, TRUE);
        bgm_restore(0);
        set(FG_ROOM, FLAG_ROOM_1B, TRUE);
        set(FG_ROOM, FLAG_ROOM_1A, TRUE);
        msgnode_set(4, 1, 2);
        msgnode_set(9, 2, 4);
        msgnode_set(12, 3, 2);
        msgnode_set(13, 3, 4);
        msgnode_set(15, 4, 2);
    }
    evt_finish();
}

event event_0C
{
    sleep(1);
    bgm_restore(0);
    evt_finish();
}
