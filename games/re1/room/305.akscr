#define ZONE_04 0x04
#define ZONE_09 0x09
#define ZONE_0C 0x0C
#define ZONE_0D 0x0D
#define ZONE_0F 0x0F

proc init
{
    set(FG_STATUS, F_STATUS_1C, TRUE);
    set(FG_STATUS, F_STATUS_1D, TRUE);
    set(FG_STATUS, F_STATUS_3C, TRUE);
    door_aot_set(AOT_00_DOOR, 0, 15200, 2900, 3800, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 0, 0, ROOM_303_HELIPORT, 8700, 0, 5300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 20500, 11100, 3300, 3500, 1, DOOR_SND_0E_EV_FTN, DOOR_14_ELE02, 64, 0, ROOM_310_COURT_TO_LABO, 24600, 6400, 1300, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 0, 0, 1, 1, 1, DOOR_SND_06_EV_MV, DOOR_15_ELE04, 64, 0, ROOM_30F_CRANK_PASSAGE, 24200, 0, 5700, 3072, UNLOCKED, SAT_MANUAL | SAT_UNDER | SAT_PLAYER);
    aot_set(AOT_03_NONE, 0, 0, 1, 1, SCE_NONE, 0, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_04_NONE, 0, 0, 1, 1, SCE_NONE, 0, 0, 0, 0, 0, 0, 0);
    item_aot_set(AOT_0F_ITEM, 14700, 22500, 600, 600, IT_44_HEAL_HERB_GREEN, 1, IMDL_00, SCA_NONE, 15000, 0, 22800, 0, F_ITEM_CB, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_10_ITEM, 13700, 22500, 600, 600, IT_44_HEAL_HERB_GREEN, 1, IMDL_01, SCA_NONE, 14000, 0, 22800, 0, F_ITEM_CC, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_11_ITEM, 16700, 22500, 600, 600, IT_45_HEAL_HERB_BLUE, 1, IMDL_02, SCA_NONE, 17000, 0, 22800, 0, F_ITEM_CD, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_12_ITEM, 15900, 22500, 600, 600, IT_45_HEAL_HERB_BLUE, 1, IMDL_03, SCA_NONE, 16200, 0, 22800, 0, F_ITEM_CE, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_310_COURT_TO_LABO))
    {
        obj(OBJ_00, OF_NOT_PUSHABLE | OF_10 | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 22341, 0, 6000, 3072, 0, 576, 0, -576, 540, 0, 0, 0);
        obj(OBJ_01, OF_NOT_PUSHABLE | OF_10 | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 20770, 0, 6000, 3072, 0, 576, 0, -576, 540, 0, 0, 0);
    }
    else
    {
        obj(OBJ_00, OF_NOT_PUSHABLE | OF_10 | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 21560, 0, 6000, 3072, 0, 576, 0, -576, 540, 0, 0, 0);
        obj(OBJ_01, OF_NOT_PUSHABLE | OF_10 | OF_NO_FLOOR_PROBE | OF_ACTIVE, SCA_NONE, 21560, 0, 6000, 3072, 0, 576, 0, -576, 540, 0, 0, 0);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_30F_CRANK_PASSAGE))
    {
        obj(OBJ_02, OF_80 | OF_NOT_PUSHABLE | OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 6180, 3072, 13450, 3072, 0, 0, 0, 0, 0, 0, 0, 0);
    }
    else
    {
        obj(OBJ_02, OF_80 | OF_NOT_PUSHABLE | OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 6180, 0, 13450, 3072, 0, 0, 0, 0, 0, 0, 0, 0);
    }
    obj(OBJ_03, OF_NOT_PUSHABLE | OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, OBJ_02, 0, 0, 0, -1024, 0, 0, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_05_USEITEM, 24000, 10000, 3400, 2200, SCE_USEITEM, SAT_PLAYER, 9, 0, 10, 0, 1, 0);
    aot_set(AOT_06_USEITEM, 15900, 10000, 3400, 2200, SCE_USEITEM, SAT_PLAYER, 9, 0, 9, 0, 1, 0);
    aot_set(AOT_07_MESSAGE, 24000, 10000, 3400, 2200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 69, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 15900, 10000, 3400, 2200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 69, 0, 0, 0);
    aot_set(AOT_09_NONE, 21200, 5355, 700, 4500, SCE_NONE, SAT_PLAYER, 9, 0, 0, 0, 0, 0);
    aot_set(AOT_0A_NONE, 23700, 9383, 3400, 1000, SCE_NONE, SAT_UNDER | SAT_PLAYER, 9, 0, 1, 0, 0, 0);
    aot_set(AOT_0B_NONE, 21579, 7200, 2113, 1000, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
    aot_set(AOT_0C_6, 23800, 10996, 3400, 400, SCE_6, SAT_MANUAL | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
    aot_set(AOT_0D_NONE, 23800, 9883, 3400, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 4, 0, 0, 0);
    aot_set(AOT_0E_EVENT, 5000, 12500, 6000, 1500, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_0e, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_1D, TRUE))
    {
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_310_COURT_TO_LABO))
        {
            set(FG_ROOM, F_ROOM_1A, FALSE);
            set(FG_ROOM, F_ROOM_1D, TRUE);
        }
        else
        {
            set(FG_ROOM, F_ROOM_1A, TRUE);
            set(FG_ROOM, F_ROOM_1D, FALSE);
        }
    }
    else
    {
        set(FG_ROOM, F_ROOM_1A, FALSE);
        set(FG_ROOM, F_ROOM_1D, TRUE);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_310_COURT_TO_LABO))
    {
        set(FG_ROOM, F_ROOM_18, FALSE);
        set(FG_ROOM, F_ROOM_1C, TRUE);
        aot_delete(AOT_0D_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_0C_6, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        set(FG_ROOM, F_ROOM_18, TRUE);
        set(FG_ROOM, F_ROOM_1C, FALSE);
    }
    set(FG_ROOM, F_ROOM_1B, TRUE);
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_30F_CRANK_PASSAGE))
    {
        evt_exec(0, TASK_09, on_enter);
        dir_set(0, 0, 3072, 0, 6000, 2000, 13800);
        spd_set(ENT_PLAYER, 2000);
        timer_setup(LIGHT_FADE_VEIL, 0, FADE_R | FADE_G | FADE_B);
        setw(W_LIGHT_STATE, 32640);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_310_COURT_TO_LABO))
    {
        dir_set(0, 0, 0, 0, 24100, 4320, 13100);
        spd_set(ENT_PLAYER, 4320);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_1D, TRUE))
    {
        msgnode_set(ZONE_04, CAM_01, CAM_02);
        msgnode_set(ZONE_09, CAM_02, CAM_04);
        msgnode_set(ZONE_0C, CAM_03, CAM_02);
        msgnode_set(ZONE_0D, CAM_03, CAM_04);
        msgnode_set(ZONE_0F, CAM_04, CAM_02);
    }
    else
    {
        msgnode_set(ZONE_04, CAM_01, CAM_06);
        msgnode_set(ZONE_09, CAM_02, CAM_07);
        msgnode_set(ZONE_0C, CAM_03, CAM_06);
        msgnode_set(ZONE_0D, CAM_03, CAM_07);
        msgnode_set(ZONE_0F, CAM_04, CAM_06);
    }
}

proc main
{
    set(FG_STATUS, F_STATUS_1C, TRUE);
    aot_reset(AOT_00_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 131, 69, 0);
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        aot_delete(AOT_05_USEITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_07_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else if (ck(FG_SCENARIO, F_SCENARIO_1B, TRUE))
    {
        aot_reset(AOT_05_USEITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 69, 0);
        aot_delete(AOT_07_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_reset(AOT_05_USEITEM, SCE_USEITEM, SAT_PLAYER, 9, 10, 1);
        aot_delete(AOT_07_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        aot_delete(AOT_06_USEITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_08_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else if (ck(FG_SCENARIO, F_SCENARIO_1C, TRUE))
    {
        aot_reset(AOT_06_USEITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 69, 0);
        aot_delete(AOT_08_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_reset(AOT_06_USEITEM, SCE_USEITEM, SAT_PLAYER, 9, 9, 1);
        aot_delete(AOT_08_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    if (testitem(IT_25_KEY_MEDAL_EAGLE))
    {
        set(FG_SCENARIO, F_SCENARIO_1B, TRUE);
        se_play_3d(SND_BANK_ROOM, SE_17_SW_MEDAL2, 0, SND_AT_PLAYER, 0, 0, 0);
        set(FG_ROOM, F_ROOM_1E, TRUE);
    }
    if (testitem(IT_24_KEY_MEDAL_WOLF))
    {
        set(FG_SCENARIO, F_SCENARIO_1C, TRUE);
        se_play_3d(SND_BANK_ROOM, SE_17_SW_MEDAL2, 0, SND_AT_PLAYER, 0, 0, 0);
        set(FG_ROOM, F_ROOM_1E, FALSE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_1B, TRUE) && ck(FG_SCENARIO, F_SCENARIO_1C, TRUE) && ck(FG_SCENARIO, F_SCENARIO_1D, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_1D, TRUE);
        evt_exec(0, TASK_09, from_main_3);
    }
    if (ck(FG_ROOM, F_ROOM_1A, TRUE))
    {
        aot_delete(AOT_09_NONE, SCE_EVENT, SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_09_NONE, SCE_NONE, SAT_PLAYER);
    }
    if (ck(FG_ROOM, F_ROOM_1D, TRUE))
    {
        aot_delete(AOT_0A_NONE, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_0A_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
    }
    if (ck(FG_ROOM, F_ROOM_18, TRUE))
    {
        inst_cfg(COL_LIST_00, COL_00, 0, 15894, 5364, 27324, 16794);
        inst_cfg(COL_LIST_01, COL_00, 0, 15894, 5364, 27324, 16794);
        inst_cfg(COL_LIST_02, COL_00, 0, 15894, 5364, 27324, 16794);
        inst_cfg(COL_LIST_03, COL_00, 0, 15894, 5364, 27324, 16794);
    }
    else
    {
        inst_cfg(COL_LIST_00, COL_00, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_01, COL_00, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_02, COL_00, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_03, COL_00, 0, 0, 0, 2, 2);
    }
    if (ck(FG_ROOM, F_ROOM_1C, TRUE))
    {
        inst_cfg(COL_LIST_02, COL_03, 0, 18396, 10458, 26802, 11556);
        inst_cfg(COL_LIST_00, COL_04, 0, 18342, 10296, 23634, 15858);
        inst_cfg(COL_LIST_02, COL_04, 0, 18342, 10296, 23634, 15858);
        inst_cfg(COL_LIST_00, COL_05, 0, 18522, 13932, 27324, 15894);
        inst_cfg(COL_LIST_00, COL_06, 0, 25578, 9774, 27414, 15876);
        inst_cfg(COL_LIST_02, COL_05, 0, 25578, 9774, 27414, 15876);
    }
    else
    {
        inst_cfg(COL_LIST_02, COL_03, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_00, COL_04, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_02, COL_04, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_00, COL_05, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_00, COL_06, 0, 0, 0, 2, 2);
        inst_cfg(COL_LIST_02, COL_05, 0, 0, 0, 2, 2);
    }
    if (ck(FG_ROOM, F_ROOM_1B, TRUE))
    {
        set(FG_ROOM, F_ROOM_1B, FALSE);
        if (ck(FG_SCENARIO, F_SCENARIO_1D, TRUE))
        {
            evt_exec(0, TASK_09, from_main);
        }
        else
        {
            evt_exec(0, TASK_09, from_main_2);
        }
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
    {
        objtbl_b_set(TBL_OBJ, OBJ_02, OF_80 | OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE);
    }
    else
    {
        objtbl_b_set(TBL_OBJ, OBJ_02, OF_80 | OF_NOT_PUSHABLE | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE);
    }
}

event event_00
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_ROOM, F_ROOM_19, FALSE);
        set(FG_ROOM, F_ROOM_1A, FALSE);
        aot_delete(AOT_09_NONE, SCE_NONE, SAT_PLAYER);
        set(FG_ROOM, F_ROOM_1D, FALSE);
        set(FG_ROOM, F_ROOM_1A, FALSE);
        aot_delete(AOT_0A_NONE, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_0D_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    set(FG_ROOM, F_ROOM_18, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 21579, 8000, F_ROOM_19);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    set(FG_ROOM, F_ROOM_19, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_06, 22579, 8000, F_ROOM_19);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    set(FG_ROOM, F_ROOM_19, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_35, F_ROOM_19, 0);
    act_reset();
    evt_nop();
    sleep(10);
    se_play_3d(SND_BANK_ROOM, SE_2D_FT_RMA, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(10);
    timer_setup(LIGHT_FADE_VEIL, 2176, FADE_R | FADE_G | FADE_B);
    sleep(5);
    se_play_3d(SND_BANK_ROOM, SE_2D_FT_RMA, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(10);
    setw(W_LIGHT_DELTA, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    set(FG_ROOM, F_ROOM_19, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_36, F_ROOM_19, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    set(FG_ROOM, F_ROOM_19, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        dir_set(0, 0, 3072, 0, 24500, 2918, 11000);
        spd_set(ENT_PLAYER, 2918);
        set(FG_ROOM, F_ROOM_18, FALSE);
        set(FG_ROOM, F_ROOM_1C, TRUE);
        aot_delete(AOT_0C_6, SCE_6, SAT_UNDER | SAT_PLAYER);
        aot_on(AOT_0C_6, SCE_6, 129);
        setw(W_DPAD_HELD, 1);
    }
    sleep(1);
    run
    {
        cut_auto(CUT_LOCKED);
        cutnext(CAM_05);
    }
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -2176, FADE_R | FADE_G | FADE_B);
    sleep(15);
    setw(W_LIGHT_DELTA, 0);
    sleep(25);
    run
    {
        aot_delete(AOT_0B_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_ROOM, F_ROOM_19, FALSE);
        aot_delete(AOT_0D_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_1D, TRUE);
    }
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_ROOM, F_ROOM_1D, FALSE);
        aot_delete(AOT_0A_NONE, SCE_NONE, SAT_UNDER | SAT_PLAYER);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    set(FG_ROOM, F_ROOM_19, FALSE);
    run
    {
        dir_set(0, 0, 1024, 0, 21577, 0, 8000);
        spd_set(ENT_PLAYER, 0);
    }
    run
    {
        cut_auto(CUT_LOCKED);
        cutnext(CAM_03);
    }
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -2176, FADE_R | FADE_G | FADE_B);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 21577, 4320, F_ROOM_19);
    act_reset();
    sleep(15);
    setw(W_LIGHT_DELTA, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    set(FG_ROOM, F_ROOM_19, FALSE);
    run
    {
        aot_delete(AOT_0C_6, SCE_NONE, SAT_UNDER | SAT_PLAYER);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_ROOM, F_ROOM_19, FALSE);
        set(FG_ROOM, F_ROOM_1A, TRUE);
        aot_delete(AOT_0D_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_ROOM, F_ROOM_18, TRUE);
        set(FG_ROOM, F_ROOM_1C, FALSE);
    }
    evt_finish();
}

event from_main
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 22341, 0, 6000);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 20770, 0, 6000);
    tw_end();
    evt_nop();
    evt_finish();
}

event from_main_2
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21560, 0, 6000);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21560, 0, 6000);
    tw_end();
    evt_nop();
    evt_finish();
}

event event_04
{
    run
    {
        aot_delete(AOT_0D_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_on(AOT_0C_6, SCE_6, 129);
        setw(W_DPAD_HELD, 1);
    }
    sleep(20);
    timer_setup(LIGHT_FADE_VEIL, 2176, FADE_R | FADE_G | FADE_B);
    sleep(15);
    setw(W_LIGHT_DELTA, 0);
    set(FG_ROOM, F_ROOM_19, TRUE);
    sleep(1);
    evt_finish();
}

event on_aot_0e
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        se_play_3d(SND_BANK_ROOM, SE_21_ELV1, 0, SND_AT_PLAYER, 0, 0, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(15);
    run
    {
        set(FG_RUN, F_RUN_PLAYER, FALSE);
        evt_exec(0, TASK_09, on_aot_0e_sub1);
        evt_exec(0, TASK_09, on_aot_0e_sub2);
    }
    for (39)
    {
        spd_add(25);
        sleep(1);
    }
    evt_nop();
    timer_setup(LIGHT_FADE_VEIL, 2176, FADE_R | FADE_G | FADE_B);
    for (15)
    {
        spd_add(25);
        sleep(1);
    }
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        setw(W_LIGHT_DELTA, 0);
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 0))
        {
            setb(B_CHARACTER_MODEL, 4, 0);
        }
        else if (cmpb(B_CHARACTER_MODEL, CMP_GT, 0))
        {
            setb(B_CHARACTER_MODEL, 5, 0);
        }
        aot_on(AOT_02_DOOR, SCE_DOOR, 129);
    }
    evt_finish();
}

event on_aot_0e_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 25, 0);
    for (54)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event on_aot_0e_sub2
{
    evt_work_set(WK_OBJ, OBJ_02);
    evt_tween_begin_alt();
    tw_set_pos(0, 25, 0);
    for (54)
    {
        tw_pos_add();
        evt_next();
    }
