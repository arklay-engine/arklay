event event_05
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_19, FALSE);
        se_play_3d(2, 33, 0, 1, 0, 0, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(15);
    run
    {
        set(FG_6, FLAG_6_1F, FALSE);
        evt_exec(0, 9, event_06);
        evt_exec(0, 9, event_07);
    }
    for (39)
    {
        spd_add(25);
        sleep(1);
    }
    evt_nop();
    timer_setup(2, 128, 8, 7, 0);
    for (15)
    {
        spd_add(25);
        sleep(1);
    }
    evt_nop();
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_6, FLAG_6_1D, TRUE);
        set(FG_6, FLAG_6_19, TRUE);
        setw(2, 0, 0);
        if (cmpb(9, 0, 0))
        {
            setb(9, 4, 0);
        }
        else if (cmpb(9, 1, 0))
        {
            setb(9, 5, 0);
        }
        aot_on(2, SCE_DOOR, 129);
    }
    evt_finish();
}

