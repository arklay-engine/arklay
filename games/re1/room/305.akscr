event on_enter
{
    sleep(1);
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        set(FG_6, F_6_19, FALSE);
    }
    se_play_3d(SND_BANK_ROOM, SE_22_ELV2, 0, SND_AT_PLAYER, 0, 0, 0);
    run
    {
        evt_exec(0, TASK_09, on_enter_sub1);
        evt_exec(0, TASK_09, on_enter_sub2);
    }
    setw(W_LIGHT_DELTA, 128, 247);
    sleep(110);
    run
    {
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        set(FG_6, F_6_19, TRUE);
        setw(W_LIGHT_DELTA, 0, 0);
        setw(W_LIGHT_STATE, 0, 0);
    }
    evt_finish();
}

event on_enter_sub1
{
    for (80)
    {
        spd_add(231);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 231, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 6000, 0, 13800);
    tw_end();
    evt_nop();
    evt_finish();
}

event on_enter_sub2
{
    evt_work_set(WK_OBJ, OBJ_02);
    evt_tween_begin_alt();
    tw_abs_pos(0, 6180, 2000, 13450);
    tw_set_pos(0, 231, 0);
    for (80)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 6180, 0, 13450);
    tw_end();
    evt_nop();
    evt_finish();
}

event from_main_3
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1F, FALSE);
    }
    sleep(10);
    run
    {
        bgm_stop_all(0);
        movie_on(MOVIE_08_DM8);
        cut_auto(1);
        if (ck(FG_ROOM, F_ROOM_1E, FALSE))
        {
            cutnext(CAM_02);
        }
        else
        {
            cutnext(CAM_04);
        }
        cut_auto(0);
    }
    sleep(1);
    run
    {
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1F, TRUE);
        bgm_restore(0);
        set(FG_ROOM, F_ROOM_1B, TRUE);
        set(FG_ROOM, F_ROOM_1A, TRUE);
        msgnode_set(4, 1, 2);
        msgnode_set(9, 2, 4);
        msgnode_set(12, 3, 2);
        msgnode_set(13, 3, 4);
        msgnode_set(15, 4, 2);
    }
    evt_finish();
}

event event_0C
{
    sleep(1);
    bgm_restore(0);
    evt_finish();
}
