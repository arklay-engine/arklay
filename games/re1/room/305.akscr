#define AOT_04_NONE 0x04
#define AOT_05_USEITEM 0x05
#define AOT_06_USEITEM 0x06
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08
#define AOT_09_NONE 0x09
#define AOT_0A_NONE 0x0A
#define AOT_0B_NONE 0x0B
#define AOT_0C_6 0x0C
#define AOT_0D_NONE 0x0D
#define AOT_0E_EVENT 0x0E
#define AOT_0F_ITEM 0x0F
#define AOT_10_ITEM 0x10
#define AOT_11_ITEM 0x11
#define AOT_12_ITEM 0x12
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define CAM_06 0x06
#define CAM_07 0x07
#define COL_00 0x00
#define COL_03 0x03
#define COL_04 0x04
