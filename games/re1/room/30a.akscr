#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_EVENT 0x02
#define AOT_03_EVENT 0x03
#define AOT_89_ITEM 0x89
#define F_ROOM_00 0x00
#define F_ROOM_01 0x01
#define F_ROOM_08 0x08
#define F_ROOM_21 0x21
#define F_ROOM_23 0x23
#define MSG_BARRY_IS_INVESTIGATING 0x18
#define MSG_HE_COULD_NOT_HAVE_MOVED_BECAUSE_HE_IS_HOLDING_SOMETHING_06 0x06

proc init
{
    door_aot_set(AOT_00_DOOR, 3400, 20200, 1500, 1300, 3, 1, 8, 0, 0, ROOM_309_DARKNESS_PASSAGE, 15300, 0, 2800, 3072, UNLOCKED, 129);
    item_aot_set(AOT_01_ITEM, 0, 0, 1, 1, IT_0B_AMMO_HANDGUN, 15, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 252, 129, 0, 0);
    if (ck(FG_COMMON, F_COMMON_48, FALSE))
    {
        item_aot_set(AOT_89_ITEM, 3330, 11130, 1000, 1000, IT_1E_KEY_CRANK_HEXAGONAL, 0, 1, 255, 48, 117, 48, 117, 48, 117, 0, 0, 46, 129, 1, 134);
        aot_delete(9, SCE_NONE, 129);
    }
    else
    {
        item_aot_set(AOT_89_ITEM, 3330, 11130, 1000, 1000, IT_1E_KEY_CRANK_HEXAGONAL, 0, 1, 255, 246, 14, 0, 0, 110, 45, 176, 4, 46, 129, 1, 134);
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_48, FALSE))
    {
        aot_set(AOT_02_EVENT, 10600, 1700, 1000, 6300, SCE_EVENT, 65, 9, 0, on_aot_02, 0, 0, 0);
        enemy(EM_28_NPC_ENRICO, 2, 255, 1, 2, 0, 0, 824, 0, 0, 10840, 0, 16490, 0, 0, 58, 0);
    }
    else
    {
        enemy(EM_28_NPC_ENRICO, 2, 255, 1, 2, 0, 0, 824, 0, 0, 10840, 0, 16490, 0, 0, 58, 0);
    }
    if (ck(FG_COMMON, F_COMMON_49, FALSE))
    {
        aot_set(AOT_03_EVENT, 10400, 14800, 1000, 1800, SCE_EVENT, 129, 9, 0, on_aot_03, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_48, FALSE))
    {
        enemy(EM_06_HUNTER, 136, 80, 1, 2, 0, 0, 2048, 0, 0, 30000, 30000, 30000, 1, 0, 0, 0);
        enemy(EM_06_HUNTER, 128, 81, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 2, 0, 0, 0);
    }
    else
    {
        enemy(EM_06_HUNTER, 2, 80, 1, 2, 0, 0, 2048, 0, 0, 9270, 0, 3950, 1, 0, 0, 0);
        enemy(EM_06_HUNTER, 2, 81, 1, 2, 0, 0, 3072, 0, 0, 3530, 0, 8280, 2, 0, 0, 0);
    }
#else
    if (ck(FG_COMMON, F_COMMON_48, FALSE) && ck(FG_COMMON, F_COMMON_49, FALSE))
    {
        aot_set(AOT_02_EVENT, 10600, 1700, 1000, 6300, SCE_EVENT, 65, 9, 0, on_aot_02, 0, 0, 0);
        aot_set(AOT_03_EVENT, 10400, 14800, 1000, 1800, SCE_EVENT, 129, 9, 0, on_aot_03, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_58, TRUE))
        {
            enemy(EM_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 1024, 0, 0, 3060, 0, 19800, 1, 0, 0, 0);
            evt_exec(0, 9, on_enter);
            aot_reset(AOT_00_DOOR, SCE_EVENT, 129, 9, on_aot_00_door, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_48, TRUE) && ck(FG_COMMON, F_COMMON_58, TRUE) && ck(FG_COMMON, F_COMMON_50, FALSE))
    {
        enemy(EM_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 3024, 0, 0, 11550, 0, 13650, 1, 9, 24, 0);
        aot_set(AOT_02_EVENT, 11000, 14000, 1500, 1500, SCE_EVENT, 129, 9, 0, on_aot_02_2, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_49, FALSE) && ck(FG_COMMON, F_COMMON_48, TRUE))
    {
        aot_set(AOT_03_EVENT, 10400, 14800, 1000, 1800, SCE_EVENT, 129, 9, 0, on_aot_03, 0, 0, 0);
    }
    enemy(EM_28_NPC_ENRICO, 0, 255, 1, 2, 0, 0, 824, 0, 0, 10840, 0, 16490, 0, 0, 59, 0);
#endif
}

#if CHRIS
proc main
{
    if (ck(FG_ROOM, F_ROOM_08, TRUE))
    {
        if (cmpb(2, 0, 2))
        {
            set(FG_ROOM, F_ROOM_08, FALSE);
            pos_set(1, 0, 1024, 0, 4644, 0, 8920);
            pos_set(2, 0, 1024, 0, 5600, 0, 20000);
            eml_state(0, 1, 0, 8);
            eml_state(0, 2, 0, 2);
        }
    }
}
#else
event on_aot_02
{
    run
    {
        aot_delete(AOT_02_EVENT, SCE_NONE, 0);
        aot_delete(9, SCE_ITEM, 129);
    }
    sleep(1);
    evt_work_set(WK_AOT, 1);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3830, 0, 11630);
    tw_abs_rot(0, 0, 1200, 0);
    tw_end();
    evt_nop();
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(0 | 2, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    run
    {
        set(FG_COMMON, F_COMMON_48, TRUE);
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        cutnext(3);
        dir_set(0, 0, 3480, 0, 13220, 0, 4450);
    }
    run
    {
        if (ck(FG_COMMON, F_COMMON_58, TRUE))
        {
            evt_exec(0, 9, on_aot_02_sub5);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(23042, 29756, 8472);
    act_nop();
    act_motion_path(113, 600, 0, 2, 60, 0);
    act_reset();
    evt_nop();
    sleep(25);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(49666, 18488, 289);
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        voice_play(1, 6, 0);
        message(7, 0);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_01, FALSE));
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 4, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    sleep(55);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 7, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        voice_play(1, 7, 0);
        message(8, 0);
    }
    sleep(30);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(0 | 2, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    evt_fork(9, on_aot_02_sub3, 0);
    wait_message();
    evt_fork(7, on_aot_02_sub4, 0);
    run
    {
        cutnext(5);
        if (ck(FG_COMMON, F_COMMON_58, TRUE))
        {
            evt_exec(0, 9, on_aot_02_sub2);
        }
        else
        {
            evt_exec(0, 9, on_aot_02_sub1);
        }
    }
    evt_finish();
}
#endif

