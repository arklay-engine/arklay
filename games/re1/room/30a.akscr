#endif
    act_nop();
#if JILL
    act_motion_path(113, 600, 0, 2, 60, 0);
#endif
    act_reset();
    evt_nop();
#if CHRIS
    sleep(23);
#else
    sleep(25);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_anim_seq(49666, 18488, 33);
#else
    act_anim_seq(49666, 18488, 289);
#endif
    act_nop();
    act_reset();
    evt_nop();
#if JILL
    run
    {
        voice_play(1, 6, 0);
        message(7, 0);
    }
#endif
    do
    {
        evt_next();
    }
#if CHRIS
    while (ck(FG_ROOM, 0, 1));
    sleep(30);
    run
    {
        voice_play(1, 0, 0);
        message(0, 0);
    }
#else
    while (ck(FG_ROOM, 1, 1));
    sleep(20);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 4, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
#if CHRIS
    sleep(50);
#else
    sleep(55);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_anim_flags(32 | 0, 32 | 0, 0 | 3);
#else
    act_anim_flags(32 | 7, 32 | 0, 0 | 3);
#endif
    act_reset();
    evt_nop();
    wait_message();
#if JILL
    run
    {
        voice_play(1, 7, 0);
        message(8, 0);
    }
    sleep(30);
#endif
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(0 | 2, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
#if CHRIS
    sleep(2);
#else
    evt_fork(9, event_03, 0);
    wait_message();
    evt_fork(7, event_04, 0);
#endif
    run
    {
        cutnext(5);
#if JILL
        if (ck(FG_COMMON, 88, 0))
        {
            evt_exec(0, 9, event_02);
        }
        else
        {
            evt_exec(0, 9, event_01);
        }
#endif
    }
#if CHRIS
    sleep(2);
#else
    evt_finish();
}

