proc init
{
    door_aot_set(AOT_00_DOOR, 3400, 20200, 1500, 1300, 3, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_309_DARKNESS_PASSAGE, 15300, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM, 0, 0, 1, 1, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 0, 0, 0, 0, F_ITEM_FC, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_COMMON, F_COMMON_48, FALSE))
    {
        item_aot_set(ITEM_ALT_ROT | AOT_09_ITEM, 3330, 11130, 1000, 1000, IT_1E_KEY_CRANK_HEXAGONAL, 0, IMDL_01, SCA_NONE, 30000, 30000, 30000, 0, F_ITEM_2E, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6 | ITEM_REACH);
        aot_delete(AOT_09_ITEM, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        item_aot_set(ITEM_ALT_ROT | AOT_09_ITEM, 3330, 11130, 1000, 1000, IT_1E_KEY_CRANK_HEXAGONAL, 0, IMDL_01, SCA_NONE, 3830, 0, 11630, 1200, F_ITEM_2E, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_6 | ITEM_REACH);
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_48, FALSE))
    {
        aot_set(AOT_02_EVENT, 10600, 1700, 1000, 6300, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_02, 0, 0, 0);
        enemy(EM_28_NPC_ENRICO, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 824, 0, 10840, 0, 16490, ENEMY_00_NPC_ENRICO, ANIM_00, 58, EVAR_00);
    }
    else
    {
        enemy(EM_28_NPC_ENRICO, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 824, 0, 10840, 0, 16490, ENEMY_00_NPC_ENRICO, ANIM_00, 58, EVAR_00);
    }
    if (ck(FG_COMMON, F_COMMON_49, FALSE))
    {
        aot_set(AOT_03_EVENT, 10400, 14800, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_48, FALSE))
    {
        enemy(EM_06_HUNTER, EB_88, F_ENEMY_50, SPAWN_FORCE, 2, 0, 2048, 0, 30000, 30000, 30000, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        enemy(EM_06_HUNTER, EB_80, F_ENEMY_51, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_02_HUNTER, ANIM_00, 0, EVAR_00);
    }
    else
    {
        enemy(EM_06_HUNTER, EB_02, F_ENEMY_50, SPAWN_FORCE, 2, 0, 2048, 0, 9270, 0, 3950, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        enemy(EM_06_HUNTER, EB_02, F_ENEMY_51, SPAWN_FORCE, 2, 0, 3072, 0, 3530, 0, 8280, ENEMY_02_HUNTER, ANIM_00, 0, EVAR_00);
    }
#else
    if (ck(FG_COMMON, F_COMMON_48, FALSE) && ck(FG_COMMON, F_COMMON_49, FALSE))
    {
        aot_set(AOT_02_EVENT, 10600, 1700, 1000, 6300, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_02, 0, 0, 0);
        aot_set(AOT_03_EVENT, 10400, 14800, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_58, TRUE))
        {
            enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 3060, 0, 19800, ENEMY_01_NPC_BARRY, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_09, on_enter);
            aot_reset(AOT_00_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_00_door, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_48, TRUE) && ck(FG_COMMON, F_COMMON_58, TRUE) && ck(FG_COMMON, F_COMMON_50, FALSE))
    {
        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3024, 0, 11550, 0, 13650, ENEMY_01_NPC_BARRY, ANIM_09, 24, EVAR_00);
        aot_set(AOT_02_EVENT, 11000, 14000, 1500, 1500, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_02_2, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_49, FALSE) && ck(FG_COMMON, F_COMMON_48, TRUE))
    {
        aot_set(AOT_03_EVENT, 10400, 14800, 1000, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
    }
    enemy(EM_28_NPC_ENRICO, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 824, 0, 10840, 0, 16490, ENEMY_00_NPC_ENRICO, ANIM_00, 59, EVAR_00);
#endif
}

#if CHRIS
proc main
{
    if (ck(FG_ROOM, F_ROOM_08, TRUE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
        {
            set(FG_ROOM, F_ROOM_08, FALSE);
            pos_set(ENEMY_01_HUNTER, 0, 1024, 0, 4644, 0, 8920);
            pos_set(ENEMY_02_HUNTER, 0, 1024, 0, 5600, 0, 20000);
            eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, EB_08);
            eml_state(0, ENEMY_02_HUNTER, EML_BEHAVIOUR, EB_02);
        }
    }
}
#else
event on_aot_02
{
    run
    {
        aot_delete(AOT_02_EVENT, SCE_NONE, 0);
        aot_delete(AOT_09_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
    }
    sleep(1);
    evt_work_set(WK_AOT, IMDL_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3830, 0, 11630);
    tw_abs_rot(0, 0, 1200, 0);
    tw_end();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_anim_flags(ANIM_02, F_ROOM_20, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    run
    {
        set(FG_COMMON, F_COMMON_48, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        cutnext(CAM_03);
        dir_set(0, 0, 3480, 0, 13220, 0, 4450);
    }
    run
    {
        if (ck(FG_COMMON, F_COMMON_58, TRUE))
        {
            evt_exec(0, TASK_09, on_aot_02_sub5);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 15450, 6260, F_ROOM_21);
    act_nop();
    act_motion_path(MOTION_71, 600, 0, 2, 60, 0);
    act_reset();
    evt_nop();
    sleep(25);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 14530, 8520, F_ROOM_01);
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        voice_play(VOICE_PLAY, VO_10F_00);
        message(MSG_VO_10F_00, 0);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_01, FALSE));
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_24, F_ROOM_20, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(55);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_27, F_ROOM_20, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        voice_play(VOICE_PLAY, VO_10F_02);
        message(MSG_VO_10F_02, 0);
    }
    sleep(30);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_ENRICO);
    evt_actor_begin();
    act_anim_flags(ANIM_02, F_ROOM_20, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    evt_fork(TASK_09, on_aot_02_sub3, 0);
    wait_message();
    evt_fork(TASK_07, on_aot_02_sub4, 0);
    run
    {
        cutnext(CAM_05);
        if (ck(FG_COMMON, F_COMMON_58, TRUE))
        {
            evt_exec(0, TASK_09, on_aot_02_sub2);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_02_sub1);
        }
    }
    evt_finish();
}
#endif

