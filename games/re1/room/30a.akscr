{
    sleep(5);
    run
    {
        eml_state(0, ENEMY_01_NPC_BARRY, EML_08);
    }
    evt_finish();
}

event on_aot_00_door
{
    run
    {
        set(FG_COMMON, F_COMMON_53, TRUE);
        aot_on(AOT_00_DOOR, SCE_DOOR, 0);
    }
    evt_finish();
}

event on_aot_02_2
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    sleep(20);
    message(MSG_BARRY_IS_INVESTIGATING | MSG_FAST, 0); // "Barry is investigating..."
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 0, 1, 30, 0);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

