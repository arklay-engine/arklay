    <language lang="fi-FI">
      <string key="save_name">Lääkevarasto 1 krs</string>
      <string key="0">{scroll 0}Hei! Mitä tapahtuu?{scroll 2}{timed 80}</string>
      <string key="1">{scroll 0}Jill? Sinäkö siellä?\nMitä siellä tapahtuu?{scroll 2}{timed 110}</string>
      <string key="2">{scroll 0}Barry! Auta minua, ole kiltti!\nOvi ei aukea. Äkkiä!{scroll 2}{timed 150}</string>
      <string key="3">{scroll 0}Siirry pois oven edestä!{scroll 2}{clear 45}{scroll 0}Aion potkaista sen auki!{scroll 2}{timed 65}</string>
      <string key="4">{scroll 0}Tule! Pidä kiirettä!{scroll 2}{timed 60}</string>
    </language>
