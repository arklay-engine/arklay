    <language lang="ja-JP">
      <string key="save_name">館 {s}小部屋/{s}1{s}F{s}</string>
      <string key="0">{scroll 0}\n  ちょっと どうなってるの‽{scroll 2}{timed 80}</string>
      <string key="1">{scroll 0}\n   ジルか‽ どうしたんだ?{scroll 2}{timed 110}</string>
      <string key="2">{scroll 0}    バリー‽ 助けて\n    ドアが開かないの!{scroll 2}{timed 150}</string>
      <string key="3">{scroll 0}\n  下がってろ ドアを破るぞ!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 0}\n     急げ こっちだ!{scroll 2}{timed 60}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Chambre RdC</string>
      <string key="0">{scroll 0}\nEh, que se passe-t'il?{scroll 2}{timed 80}</string>
      <string key="1">{scroll 0}Jill? C'est toi, Jill? \nQue s'est-il passé?{scroll 2}{timed 110}</string>
      <string key="2">{scroll 0}Barry! Aide-moi! La porte ne \nveux pas s'ouvrir. Vite!{scroll 2}{timed 150}</string>
      <string key="3">{scroll 0}Eloigne-toi de la porte, Jill. \nJe vais défoncer cette porte!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 0}\nDépêche-toi! Par là!{scroll 2}{timed 60}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}\nHey, was ist hier los?{scroll 2}{timed 80}</string>
      <string key="1">{scroll 0}Jill? Bist du das, Jill?\nWas ist passiert?{scroll 2}{timed 110}</string>
      <string key="2">{scroll 0}Barry?\nHilf' mir, bitte!{scroll 2}{clear 75}{scroll 0}Die Tür läßt sich nicht\nöffnen. Schnell!{scroll 2}{timed 75}</string>
      <string key="3">{scroll 0}\nGeh' etwas zur Seite, Jill.{scroll 2}{clear 45}{scroll 0}\nIch werde diese Tür eintreten!{scroll 2}{timed 65}</string>
      <string key="4">{scroll 0}Beeilung!\nHier lang!{scroll 2}{timed 60}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Villa 1P</string>
      <string key="0">{scroll 0}\nEhi, ma che succede?{scroll 2}{timed 80}</string>
      <string key="1">{scroll 0}Jill? Sei tu, Jill!? \nChe è successo?{scroll 2}{timed 110}</string>
      <string key="2">{scroll 0}Barry! Aiutami! La porta non \nvuole aprirsi!{scroll 2}{timed 150}</string>
      <string key="3">{scroll 0}Stai lontano dalla porta, Jill.\nLa butto giù!{scroll 2}{timed 110}</string>
      <string key="4">{scroll 0}Sbrigati! \nDa questa parte!{scroll 2}{timed 60}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 0}\n¡Hey! ¿Qué pasa?{scroll 2}{timed 80}</string>
      <string key="1">{scroll 0}¿Jill? ¿Eres tú, Jill?\n¿Qué ocurre?{scroll 2}{timed 110}</string>
      <string key="2">{scroll 0}¡Barry! ¡Ayúdame, por favor!\nLa puerta no se abre. ¡Rápido!{scroll 2}{timed 150}</string>
      <string key="3">{scroll 0}¡Jill, aléjate de la\npuerta!{scroll 2}{clear 45}{scroll 0}¡La voy a echar\nabajo!{scroll 2}{timed 65}</string>
      <string key="4">{scroll 0}\n¡Rápido! ¡Por aquí!{scroll 2}{timed 60}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Мед. комната 1-эт.</string>
      <string key="0">{scroll 0}\n{scroll 2}{timed 80}</string>
      <string key="1">{scroll 0}\n{scroll 2}{timed 110}</string>
      <string key="2">{scroll 0}\n{scroll 2}{timed 150}</string>
      <string key="3">{scroll 0}\n{scroll 2}{timed 110}</string>
