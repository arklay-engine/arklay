    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 0}\n       クリス{scroll 2}{timed 40}</string>
      <string key="1">{scroll 0}  レベッカ\n  だめだ こいつには効かない{scroll 2}{clear 120}{scroll 0}\n   地下にこいつの根がある{scroll 2}{clear 80}{scroll 0}\n      そいつを…{scroll 2}{timed 80}</string>
      <string key="2">{scroll 0}\n   そのファイルを持っていけ{scroll 2}{clear 70}{scroll 0}\n   それで薬を調合するんだ{scroll 2}{clear 130}{scroll 0}\n      そして根を…{scroll 2}{clear 65}{scroll 0}\n     レベッカ 頼む{scroll 2}{timed 60}</string>
      <string key="3">{scroll 0}\n    クリス 死なないでね{scroll 2}{timed 95}</string>
      <string key="4">{scroll 0}\n     何だこいつは!{scroll 2}{clear 60}{scroll 0}\n       バリー{scroll 2}{clear 25}{scroll 0}\n        ジル{scroll 2}{timed 35}</string>
      <string key="5">{scroll 0}\n      助かったわ{scroll 2}{timed 65}</string>
      <string key="6">{scroll 0}\n        ああ{scroll 2}{timed 40}</string>
      <string key="7">{scroll 0}    危なかったわ\n    ありがとう バリー{scroll 2}{timed 90}</string>
      <string key="8">{scroll 0}    水くさいな だが\n    何てバケモンだ{scroll 2}{clear 145}{scroll 0}\n    一体どうなってんだ{scroll 2}{timed 75}</string>
      <string key="9">{scroll 0}\n   俺はもう少しここに残る{scroll 2}{clear 140}{scroll 0}\n   さっきの館も怪しいんだが{scroll 2}{clear 110}{scroll 0}\n  とにかく手分けして調べよう{scroll 2}{timed 110}</string>
      <string key="10">{scroll 0}\n        ええ{scroll 2}{timed 40}</string>
      <string key="11">   何か光るものがあるが\n   ツタがじゃまして取れない{scroll 2}</string>
      <string key="12">  しかけが戻ってしまったようだ\n  ドアが開かなくなっている{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Poste de garde RdC</string>
      <string key="0">{scroll 0}\nChris!{scroll 2}{timed 40}</string>
      <string key="1">{scroll 0}Rebecca! \nNon! Ça ne sert à rien...!{scroll 2}{clear 120}{scroll 0}Les racines de cette chose \nsont au sous-sol. {scroll 2}{clear 80}{scroll 0}\nVous pouvez..., ah!{scroll 2}{timed 80}</string>
      <string key="2">{scroll 0}\nPrenez ce dossier avec vous! {scroll 2}{clear 70}{scroll 0}\nUtilisez les informations {scroll 2}{clear 60}{scroll 0}qu'il contient pour préparer \nla potion, et éliminez les {scroll 2}{clear 55}{scroll 0}\net éliminez les racines...{scroll 2}{clear 40}{scroll 0}\nS'il vous plaît, Rebecca!{scroll 2}{timed 60}</string>
      <string key="3">{scroll 0}\nChris, ne mourez pas!{scroll 2}{timed 95}</string>
      <string key="4">{scroll 0}Bon sang, qu'est-ce que \nc'est que ça!{scroll 2}{clear 60}{scroll 0}\nBarry!{scroll 2}{clear 25}{scroll 0}\nJill!{scroll 2}{timed 35}</string>
      <string key="5">{scroll 0}\nTu m'as sauvée!{scroll 2}{timed 65}</string>
      <string key="6">{scroll 0}\nOuais.{scroll 2}{timed 40}</string>
      <string key="7">{scroll 0}C'était moins une. \nMerci, Barry.{scroll 2}{timed 90}</string>
      <string key="8">{scroll 0}C'est bon. Quel monstre! \nJe n'en crois pas mes yeux... {scroll 2}{clear 120}{scroll 0}Bon sang, qu'est-ce que c'est \nque cet endroit...?{scroll 2}{timed 90}</string>
      <string key="9">{scroll 0}OK! Je vais rester dans la\nmaison des gardes et continuer{scroll 2}{clear 90}{scroll 0}à jeter un coup d'oeil...\nmalgré le fait que je sois{scroll 2}{clear 90}{scroll 0}sure qu'il y a également des\nchoses dans l'autre maison.{scroll 2}{clear 65}{scroll 0}\nQuoi qu'il en soit, {scroll 2}{clear 30}{scroll 0}séparons-nous pour continuer\nles recherches.{scroll 2}{timed 60}</string>
      <string key="10">{scroll 0}\nOK!{scroll 2}{timed 40}</string>
      <string key="11">Il y a quelque chose qui brille\nmais je ne peux pas l'atteindre.{scroll 2}</string>
      <string key="12">C'est refermé. La porte \nne s'ouvre pas.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}\nChris!{scroll 2}{timed 40}</string>
      <string key="1">{scroll 0}Rebecca! Nein!\nDas hat keinen Zweck!{scroll 2}{clear 120}{scroll 0}\nDie Wurzeln sind im Keller.{scroll 2}{clear 80}{scroll 0}\nDu kannst..., brrr!{scroll 2}{timed 80}</string>
      <string key="2">{scroll 0}\nNimm diese Akte mit!{scroll 2}{clear 70}{scroll 0}Verwende die Informationen\ndarin,{scroll 2}{clear 60}{scroll 0}um die Lösung zu erhalten und\ndann bring dieses Viech um...{scroll 2}{clear 95}{scroll 0}\nRebecca, bitte!{scroll 2}{timed 60}</string>
      <string key="3">{scroll 0}\nChris, stirb nicht!{scroll 2}{timed 95}</string>
      <string key="4">{scroll 0}\nWas zur Hölle ist das!{scroll 2}{clear 60}{scroll 0}\nBarry!{scroll 2}{clear 25}{scroll 0}\nJill!{scroll 2}{timed 35}</string>
      <string key="5">{scroll 0}\nDu hast mich gerettet!{scroll 2}{timed 65}</string>
