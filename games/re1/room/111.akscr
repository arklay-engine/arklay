#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_USEITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_HIKIDASHI 0x05
#define AOT_06_MESSAGE 0x06
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08

proc init
{
    door_aot_set(AOT_00_DOOR, 400, 3800, 1900, 2100, 1, 0, 3, 1, 0, ROOM_106_MAIN_HALL, 31300, 0, 19200, 2048, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 23000, 10400, 2500, 2000, 0, 0, 0, 7, 0, ROOM_112_WARDROBE, 2900, 0, 15300, 0, UNLOCKED, 129);
    aot_set(AOT_02_USEITEM, 3000, 10170, 2244, 2239, SCE_USEITEM, 65, 4, 0, 25, 0, 1, 0);
    item_aot_set(AOT_03_ITEM, 0, 0, 1, 1, IT_0C_AMMO_SHOTGUN, 7, 0, 255, 54, 11, 88, 253, 56, 44, 92, 8, 2, 129, 0, 0);
    item_aot_set(AOT_04_ITEM, 10900, 4200, 500, 2000, IT_0B_AMMO_HANDGUN, 15, 1, 255, 128, 43, 120, 251, 212, 21, 64, 6, 96, 129, 0, 0);
    eml_rot(0, 0, 0, 0, 12);
    eml_rot(1, 186, 255, 110, 0);
    aot_set(AOT_05_HIKIDASHI, 1726, 10560, 1800, 2000, SCE_HIKIDASHI, 129, 31, 0, 3, 0, 4, 0);
    aot_set(AOT_06_MESSAGE, 6500, 4800, 1400, 1500, SCE_MESSAGE, 129, 130, 0, 69, 0, 0, 0);
    aot_set(AOT_07_MESSAGE, 7000, 1300, 1900, 2200, SCE_MESSAGE, 129, 131, 0, 69, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 1400, 9000, 9200, 1400, SCE_MESSAGE, 129, 132, 0, 69, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_00, FALSE))
    {
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 1, 167, 1, 1, 0, 0, 0, 0, 0, 7061, 0, 11273, 0, 0, 0, 0);
    }
    setbyte(0, 0, 0);
    scene_setup(2, 4000, 6300, 12500);
    set(FG_STATUS, F_STATUS_1F, TRUE);
}
