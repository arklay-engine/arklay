#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_106 0x00
#define AOT_01_DOOR_211 0x01
#define AOT_02_DOOR_204 0x02
#define AOT_03_DOOR_202 0x03
#define AOT_04_5_STAIRS_0 0x04                              // Guess: the SCE_5 spot at one of the main-hall staircases.
#define AOT_05_5_STAIRS_1 0x05                              // Guess: the SCE_5 spot at the other main-hall staircase.
#define AOT_07_USEITEM_HALL 0x07                            // Under-player spot over the whole hall; raises F_ROOM_ITEM_USED_IN_HALL.
#define AOT_08_ITEM_AMMO_GRENADE_ACID 0x08                  // The acid rounds Barry hands over.
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_03 0x03
#define ENEMY_00_BARRY 0x00
#define F_ROOM_ITEM_USED_IN_HALL 0x21                       // Guess: an item was used in the hall (one frame); main hides the sprites on camera 0.
#define F_ROOM_J_BARRY_ANIM_DONE 0x22                       // Barry's animation finished (one frame); Jill's talk gestures raise it too.
#define F_ROOM_J_BARRY_SCENE 0x1F                           // Barry's acid rounds scene is running; the hall sprites are hidden.
#define F_ROOM_J_BARRY_WALK_DONE 0x05                       // Barry's walk up to Jill finished.
#define F_ROOM_J_PLAYER_ANIM_DONE 0x20                      // Jill's animation finished (one frame).
#define F_ROOM_J_PLAYER_WALK_DONE 0x03                      // Jill's walk finished.
#define F_ROOM_J_SCENE_SPRITES 0x0A                         // Barry's scene controls the hall sprites.
#define F_ROOM_J_SCENE_SPRITES_ON 0x0B                      // During Barry's scene, show the hall sprites.
#define IMDL_00_AMMO_GRENADE_ACID 0x00
#define MSG_VO_106_00 0x01
#define MSG_VO_106_01 0x02
#define MSG_VO_106_02 0x05
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define SPR_01 0x01
#define SPR_02 0x02
#define VO_106_00 0x22
#define VO_106_01 0x23
#define VO_106_02 0x24

proc init
{
    door_aot_set(AOT_00_DOOR_106, 14000, 21500, 6000, 2000, 1, DOOR_SND_04_ST_WCP, DOOR_16_KAI01, 96, 0, STAGE_1 | ROOM_106_MAIN_HALL, 17000, 0, 14300, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_211, 31400, 7000, 2000, 2000, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCK_40, ROOM_211_TERRACE_PASSAGE, 2400, 0, 3600, 3360, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_204, 31400, 19000, 2000, 3000, 2, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_204_C_PASSAGE, 3000, 0, 3600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR_202, 1000, 15000, 1700, 3800, 6, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_202_DINING_ROOM_2F, 30900, 0, 8300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_04_5_STAIRS_0, 20220, 23900, 3540, 3500, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_05_5_STAIRS_1, 10200, 23900, 3480, 3490, SCE_5, SAT_MANUAL | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
    aot_set(AOT_07_USEITEM_HALL, 7000, 13000, 20000, 6000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 33, 0, 1, 0);
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_RICHARD_FOUND, TRUE) && ck(FG_COMMON, F_COMMON_RICHARD_SCENE_OVER, TRUE) && ck(FG_COMMON, F_COMMON_RICHARD_SERUM_IN_TIME, TRUE))
        {
            set(FG_COMMON, F_COMMON_RICHARD_SCENE_LEFT, TRUE);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_BARRY_FOREST_SCENE, FALSE) && ck(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, FALSE) && ck(FG_ITEM, F_ITEM_118_KEY_HERBICIDE_0, FALSE))
        {
            set(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, TRUE);
            set(FG_ROOM, F_ROOM_J_BARRY_SCENE, TRUE);
            item_aot_set(AOT_08_ITEM_AMMO_GRENADE_ACID, 0, 0, 16, 16, IT_11_AMMO_GRENADE_ACID, 6, IMDL_00_AMMO_GRENADE_ACID, SCA_NONE, 0, 0, 0, 0, F_ITEM_106_AMMO_GRENADE_ACID_1, SAT_UNDER | SAT_PLAYER, 0);
            enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1568, 0, 23782, -2885, 14862, ENEMY_00_BARRY, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_00, barry_offers_acid_rounds);
            set(FG_ROOM, F_ROOM_J_SCENE_SPRITES, TRUE);
            set(FG_ROOM, F_ROOM_J_SCENE_SPRITES_ON, TRUE);
        }
        if (ck(FG_COMMON, F_COMMON_J_BARRY_LOCKPICK_SCENE, FALSE))
        {
            set(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, TRUE);
            aot_reset(AOT_01_DOOR_211, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
            aot_reset(AOT_02_DOOR_204, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
            aot_reset(AOT_03_DOOR_202, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
        }
    }
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_ITEM_USED_IN_HALL, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_00))
    {
        aot_switch(0, SPR_01, SPR_OFF);
        aot_switch(0, SPR_02, SPR_OFF);
    }
    else if (ck(FG_ROOM, F_ROOM_J_BARRY_SCENE, TRUE))
    {
        aot_switch(0, SPR_01, SPR_OFF);
        aot_switch(0, SPR_02, SPR_OFF);
    }
    else
    {
        aot_switch(0, SPR_01, SPR_ON);
        aot_switch(0, SPR_02, SPR_ON);
    }
    if (ck(FG_ROOM, F_ROOM_J_SCENE_SPRITES, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_J_SCENE_SPRITES_ON, TRUE))
        {
            aot_switch(0, SPR_01, SPR_ON);
            aot_switch(0, SPR_02, SPR_ON);
        }
        else
        {
            aot_switch(0, SPR_01, SPR_OFF);
            aot_switch(0, SPR_02, SPR_OFF);
        }
    }
}

event barry_offers_acid_rounds
{
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cut_auto(CUT_LOCKED);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_11, 23782, -5485, 14862, 180, 64);
    act_anim_seq(AB_02, 29000, 19000, F_ROOM_J_PLAYER_WALK_DONE);
    act_reset();
    sleep(10);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    sleep(5);
    evt_fork(TASK_01, barry_walks_up, 0);
    voice_play(VOICE_PLAY, VO_106_00);
    message(MSG_VO_106_00, 0);
    wait_message();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_PLAYER_WALK_DONE, FALSE));
    set(FG_ROOM, F_ROOM_J_PLAYER_WALK_DONE, FALSE);
    voice_play(VOICE_PLAY, VO_106_01);
    message(MSG_VO_106_01, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_BARRY, 0, 192, 64);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_WALK_DONE, FALSE));
    set(FG_ROOM, F_ROOM_J_BARRY_WALK_DONE, FALSE);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
