    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_72, 600, 300, 1, 120, 64);
    act_reset();
    evt_nop();
    sleep(10);
    wait_message();
    run
    {
        if (cmpb(B_TOTAL_HELD, CMP_GE, 8))
        {
            evt_exec(0, TASK_01, barry_leaves);
        }
        else
        {
            evt_exec(0, TASK_01, barry_gives_acid_rounds);
        }
    }
    evt_finish();
}

