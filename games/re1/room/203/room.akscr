    act_reset();
    wait_message();
    give_item(AOT_08_ITEM_AMMO_GRENADE_ACID, 4, 129);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, F_STATUS_VOICE_PLAYING, TRUE));
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_fork(TASK_02, barry_leaves, 0);
    evt_finish();
}

event barry_walks_up
{
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_11, 31812, -5485, 21033, 180, 64);
    sleep(4);
    act_anim_seq(AB_06, 30700, 19000, F_ROOM_J_BARRY_ANIM_DONE);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    sleep(10);
    act_anim_seq(AB_02, 26194, 17345, F_ROOM_J_BARRY_WALK_DONE);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    act_motion_path(MOTION_11, 29000, -5485, 19000, 180, 64);
    act_reset();
    evt_nop();
    evt_finish();
}

event barry_leaves
{
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_11, 2338, -5485, 16099, 180, 64);
    sleep(6);
    act_anim_seq(AB_06, 19000, 25000, F_ROOM_J_BARRY_ANIM_DONE);
    act_nop();
    act_param_set(0, 80);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    sleep(20);
    act_motion_path(MOTION_11, 29000, -5485, 19000, 180, 64);
    sleep(8);
    act_anim_flags(ANIM_26, F_ROOM_J_BARRY_ANIM_DONE, 0);
    sleep(30);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    sleep(5);
    act_motion_path(MOTION_11, 2338, -5485, 16099, 180, 64);
    sleep(8);
    act_anim_seq(AB_06, 14137, 4781, F_ROOM_J_BARRY_ANIM_DONE);
    act_nop();
    act_param_set(0, 80);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    act_anim_seq(AB_03, 2338, 16099, F_ROOM_J_BARRY_ANIM_DONE);
    act_reset();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0002 | EF_0001);
    act_reset();
    evt_nop();
    sleep(5);
    run
    {
        cutnext(CAM_00);
        set(FG_ROOM, F_ROOM_J_SCENE_SPRITES_ON, FALSE);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_seq(AB_ADDITIVE | AB_03, 12544, 16000, F_ROOM_J_BARRY_ANIM_DONE);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    run
    {
        cutnext(CAM_01);
        set(FG_ROOM, F_ROOM_J_SCENE_SPRITES_ON, TRUE);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_anim_seq(AB_ADDITIVE | AB_03, 5339, 16501, F_ROOM_J_BARRY_ANIM_DONE);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_BARRY_ANIM_DONE, FALSE));
    cutnext(CAM_03);
    sleep(10);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY);
    evt_actor_begin();
    act_idle();
    act_reset();
    sleep(30);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_POINT, 0, 19000, 17000);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_J_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(50);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 19000, 17000);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        pos_set(ENEMY_00_BARRY, 0, 0, 0, 0, 10000, 0);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_ROOM, F_ROOM_J_BARRY_SCENE, FALSE);
        set(FG_ROOM, F_ROOM_J_SCENE_SPRITES, FALSE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}
