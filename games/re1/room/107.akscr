event event_00
{
    message(137, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, event_01);
        }
    }
    evt_finish();
}

event event_01
{
    aot_on(2, SCE_F, 0);
    sleep(1);
    aot_delete(5, SCE_NONE, 0);
    message(138, 255);
    evt_finish();
}
