#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_505 0x00
#define AOT_01_DOOR_509 0x01
#define AOT_02_DOOR_50A 0x02
#define AOT_03_DOOR_50B 0x03                                // The double-locked door; opened by the three pass codes.
#define AOT_04_EVENT_PASS_CODE_PANEL 0x04
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04_PASS_CODE_PANEL 0x04
#define ENEMY_00_NPC_CHRIS 0x00
#define ENEMY_00_NPC_JILL 0x00
#define FX_0A 0x0A
#define F_ROOM_CODE_1_LAMP_LIT 0x05                         // Pass code 01's lamp was switched on this visit.
#define F_ROOM_CODE_2_LAMP_LIT 0x06                         // Pass code 02's lamp was switched on this visit.
#define F_ROOM_CODE_3_LAMP_LIT 0x07                         // Pass code 03's lamp was switched on this visit.
#define F_ROOM_SURVIVOR_ANIM_DONE 0x21                      // The rescued Chris's or Jill's animation finished (one frame).
#define MSG_A_PASS_CODE_PANEL 0x00
#define MSG_IT_IS_ELECTRONICALLY_LOCKED 0x04
#define MSG_IT_IS_LOCKED_05 0x05
#define MSG_YOU_DO_NOT_HAVE_THE_PASS 0x01
#define MSG_YOU_HAVE_ENTERED_THE_PASS_CODE 0x02
#define SE_14_DM_GACHA 0x14
#define SE_17_DLBEEP 0x17
#define SE_18_DBROCK 0x18
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_A00_04_5A 0x5A
#define VO_A00_05_5B 0x5B

proc init
{
    door_aot_set(AOT_00_DOOR_505, 19500, 2400, 2100, 2500, 6, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_505_O_PASSAGE, 2900, 0, 17500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_509, 10700, 4800, 2300, 1600, 0, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_509_PRIVATE_ROOM_A, 3600, 0, 2700, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_50A, 17700, 800, 1400, 1600, 0, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_50A_PRIVATE_ROOM_B, 10800, 0, 10200, 1576, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR_50B, 200, 2500, 2100, 2200, 11, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, 0, ROOM_50B_FRONT_OF_CELL, 5300, 0, 4000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_ITEM, F_ITEM_509_FILE_PASS_CODE_01_0, TRUE))
    {
        if (ck(FG_ITEM, F_ITEM_507_FILE_PASS_CODE_02_2, TRUE))
        {
            if (ck(FG_ITEM, F_ITEM_510_FILE_PASS_CODE_03_0, TRUE))
            {
                aot_set(AOT_04_EVENT_PASS_CODE_PANEL, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, pass_code_panel_no_codes, 0, 0, 0);
            }
            else
            {
                aot_set(AOT_04_EVENT_PASS_CODE_PANEL, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, pass_code_panel, 0, 0, 0);
            }
        }
        else
        {
            aot_set(AOT_04_EVENT_PASS_CODE_PANEL, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, pass_code_panel, 0, 0, 0);
        }
    }
    else
    {
        aot_set(AOT_04_EVENT_PASS_CODE_PANEL, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, pass_code_panel, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_1_ENTERED, FALSE))
    {
        effect(FX_0A, FX_ROW_00, FX_AT_WORLD, 2230, -3000, 5300, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_2_ENTERED, FALSE))
    {
        effect(FX_0A, FX_ROW_01, FX_AT_WORLD, 2440, -3000, 5300, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_3_ENTERED, FALSE))
    {
        effect(FX_0A, FX_ROW_02, FX_AT_WORLD, 2650, -3000, 5300, 0);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_C_JILL_WENT_AHEAD, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
            {
                dir_set(0, 0, 4056, 0, 2600, 0, 2500);
                evt_exec(0, TASK_09, survivor_goes_ahead);
            }
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_CHRIS_WENT_AHEAD, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
            {
                dir_set(0, 0, 4056, 0, 2600, 0, 2500);
                evt_exec(0, TASK_09, survivor_goes_ahead);
            }
        }
    }
    if (ck(FG_LOCK, F_LOCK_508_509, FALSE))
    {
        aot_reset(AOT_01_DOOR_509, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, electronic_lock, 0);
    }
    aot_reset(AOT_03_DOOR_50B, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, double_lock, 0);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_C_JILL_WENT_AHEAD, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
            {
                enemy(EM_21_NPC_JILL, EB_00, NO_FLAG, SPAWN_FORCE, 1, 0, 4056, 0, 3100, 0, 4300, ENEMY_00_NPC_JILL, ANIM_00, 0, EVAR_00);
            }
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_J_CHRIS_WENT_AHEAD, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_CELL_RESCUED, TRUE))
            {
                enemy(EM_20_NPC_CHRIS, EB_00, NO_FLAG, SPAWN_FORCE, 1, 0, 4056, 0, 3100, 0, 4300, ENEMY_00_NPC_CHRIS, ANIM_00, 0, EVAR_00);
            }
        }
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_1_ENTERED, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_CODE_1_LAMP_LIT, FALSE))
        {
            set(FG_ROOM, F_ROOM_CODE_1_LAMP_LIT, TRUE);
            effect(FX_0A, FX_ROW_08, FX_AT_WORLD, 2230, -3000, 5300, 0);
            effect_kill_b(FX_0A, FX_ROW_00);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_2_ENTERED, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_CODE_2_LAMP_LIT, FALSE))
        {
            set(FG_ROOM, F_ROOM_CODE_2_LAMP_LIT, TRUE);
            effect(FX_0A, FX_ROW_09, FX_AT_WORLD, 2440, -3000, 5300, 0);
            effect_kill_b(FX_0A, FX_ROW_01);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_3_ENTERED, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_CODE_3_LAMP_LIT, FALSE))
        {
            set(FG_ROOM, F_ROOM_CODE_3_LAMP_LIT, TRUE);
            effect(FX_0A, FX_ROW_0A, FX_AT_WORLD, 2650, -3000, 5300, 0);
            effect_kill_b(FX_0A, FX_ROW_02);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_1_ENTERED, TRUE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_2_ENTERED, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_3_ENTERED, TRUE))
            {
                aot_delete(AOT_03_DOOR_50B, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
            }
        }
    }
}

event unused_empty
{
    evt_finish();
}

event survivor_goes_ahead
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            set(FG_COMMON, F_COMMON_C_JILL_WENT_AHEAD, TRUE);
        }
        else
        {
            set(FG_COMMON, F_COMMON_J_CHRIS_WENT_AHEAD, TRUE);
        }
    }
    sleep(20);
    cutnext(CAM_02);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
    }
    evt_actor_begin();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        act_anim_seq(AB_03, 12200, 4450, F_ROOM_SURVIVOR_ANIM_DONE);
    }
    else
    {
        act_anim_seq(AB_03, 18600, 4300, F_ROOM_SURVIVOR_ANIM_DONE);
    }
    act_reset();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        sleep(40);
        cutnext(CAM_01);
        sleep(30);
        cutnext(CAM_00);
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_SURVIVOR_ANIM_DONE, FALSE));
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_2E, F_ROOM_SURVIVOR_ANIM_DONE, 0);
    act_param_set(0, 1024);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_SURVIVOR_ANIM_DONE, FALSE));
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
    }
    evt_actor_begin();
    act_motion_path(MOTION_31, 710, 0, 0, 80, 0);
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        sleep(20);
    }
    else
    {
        sleep(30);
    }
    run
    {
        message(3, 0);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            voice_play(VOICE_PLAY, VO_A00_05_5B);
        }
        else
        {
            voice_play(VOICE_PLAY, VO_A00_04_5A);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_SURVIVOR_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_SURVIVOR_ANIM_DONE, FALSE));
    wait_message();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
        evt_actor_begin();
        act_anim_flags(ANIM_2D, F_ROOM_SURVIVOR_ANIM_DONE, 0);
        act_param_set(0, 64512);
        act_motion(MOTION_10);
        act_reset();
        evt_nop();
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_SURVIVOR_ANIM_DONE, FALSE));
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
        evt_actor_begin();
        act_anim_seq(AB_03, 18600, 4300, F_ROOM_SURVIVOR_ANIM_DONE);
        act_reset();
    }
    sleep(20);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_SURVIVOR_ANIM_DONE, FALSE));
        sleep(20);
    }
    else
    {
        cutnext(CAM_03);
        sleep(10);
    }
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_POINT, 0, 6388, 14000);
    sleep(30);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 6388, 14000);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            pos_set(ENEMY_00_NPC_JILL, 0, 4056, 0, 0, 0, 0);
        }
        else
        {
            pos_set(ENEMY_00_NPC_CHRIS, 0, 4056, 0, 0, 0, 0);
        }
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event pass_code_panel
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 4056, 0, 2600, 0, 2500);
        cutnext(CAM_04_PASS_CODE_PANEL);
        message(MSG_A_PASS_CODE_PANEL | MSG_FAST, 0); // "A pass code panel."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_1_ENTERED, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_509_FILE_PASS_CODE_01_0, FALSE))
            {
                message(MSG_YOU_HAVE_ENTERED_THE_PASS_CODE | MSG_FAST, 0); // "You've entered the pass code."
                set(FG_SCENARIO, F_SCENARIO_PASS_CODE_1_ENTERED, TRUE);
                se_play_3d(SND_BANK_ROOM, SE_17_DLBEEP, 0, SND_AT_POINT, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_2_ENTERED, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_507_FILE_PASS_CODE_02_2, FALSE))
            {
                message(MSG_YOU_HAVE_ENTERED_THE_PASS_CODE | MSG_FAST, 0); // "You've entered the pass code."
                set(FG_SCENARIO, F_SCENARIO_PASS_CODE_2_ENTERED, TRUE);
                se_play_3d(SND_BANK_ROOM, SE_17_DLBEEP, 0, SND_AT_POINT, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_3_ENTERED, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_510_FILE_PASS_CODE_03_0, FALSE))
            {
                message(MSG_YOU_HAVE_ENTERED_THE_PASS_CODE | MSG_FAST, 0); // "You've entered the pass code."
                set(FG_SCENARIO, F_SCENARIO_PASS_CODE_3_ENTERED, TRUE);
                se_play_3d(SND_BANK_ROOM, SE_17_DLBEEP, 0, SND_AT_POINT, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_1_ENTERED, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_2_ENTERED, TRUE))
            {
                if (ck(FG_SCENARIO, F_SCENARIO_PASS_CODE_3_ENTERED, TRUE))
                {
                    if (ck(FG_SCENARIO, F_SCENARIO_DOUBLE_LOCK_OPENED, FALSE))
                    {
                        set(FG_SCENARIO, F_SCENARIO_DOUBLE_LOCK_OPENED, TRUE);
                        se_play_3d(SND_BANK_ROOM, SE_18_DBROCK, 0, SND_AT_POINT, 0, 2300, 4850);
                    }
                }
            }
        }
        dir_set(0, 0, 3056, 0, 2280, 0, 4850);
        cutnext(CAM_03);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event pass_code_panel_no_codes
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 4056, 0, 2600, 0, 2500);
        cutnext(CAM_04_PASS_CODE_PANEL);
        message(MSG_A_PASS_CODE_PANEL | MSG_FAST, 0); // "A pass code panel."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    message(MSG_YOU_DO_NOT_HAVE_THE_PASS | MSG_FAST, 0); // "You don't have the pass code."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        dir_set(0, 0, 3056, 0, 2280, 0, 4850);
        cutnext(CAM_03);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event electronic_lock
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        se_play_3d(SND_BANK_ROOM, SE_14_DM_GACHA, 0, SND_AT_POINT, 0, 11300, 4850);
        message(MSG_IT_IS_ELECTRONICALLY_LOCKED | MSG_FAST, 0); // "It's electronically locked."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

event double_lock
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        se_play_3d(SND_BANK_ROOM, SE_14_DM_GACHA, 0, SND_AT_POINT, 0, 11300, 4850);
        message(MSG_IT_IS_LOCKED_05 | MSG_FAST, 0); // "It's locked."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}
