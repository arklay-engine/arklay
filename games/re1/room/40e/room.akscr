event on_enter
{
    evt_fork(TASK_00, on_enter_sub1, 0);
    evt_fork(TASK_01, on_enter_sub2, 0);
    evt_fork(TASK_02, on_enter_sub3, 0);
    evt_fork(TASK_03, on_enter_sub4, 0);
    evt_finish();
}

event on_aot_02
{
    se_play_3d(SND_BANK_ROOM, SE_14_DM_GACHA, 0, SND_AT_POINT, 0, 1250, 26900);
    message(MSG_IT_IS_LOCKED_THERE_IS_NO_KEY_HOLE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's locked. There's no key hole."
    evt_finish();
}

event event_06
{
    run
    {
        bgm_stop_all(0);
        movie_on(MOVIE_07_DM7);
    }
    evt_next();
    evt_nop();
    run
    {
        bgm_restore(0);
    }
    evt_finish();
}
