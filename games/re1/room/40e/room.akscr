proc init
{
    if (JILL)
    {
        set(FG_STATUS, F_STATUS_1C, TRUE);
    }
    door_aot_set(AOT_00_DOOR, 29700, 15100, 3700, 4800, 12, DOOR_SND_01_DR_MTL, DOOR_0A_DOOR10, 8, 0, ROOM_40D_UNDER_PASSAGE, 18000, 0, 3500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 29700, 27200, 3700, 3200, 1, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_40F_SECURITY_ROOM, 2800, 0, 12300, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_LOCK, F_LOCK_24, FALSE))
    {
        aot_set(AOT_02_EVENT, 0, 25400, 2500, 3000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 5, 0, on_aot_02, 0, 0, 0);
    }
    else
    {
        door_aot_set(AOT_02_EVENT, 0, 25400, 2500, 3000, 3, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, 0, ROOM_410_ARMS_STOREHOUSE, 9100, 0, 3100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    door_aot_set(AOT_03_DOOR, 0, 22400, 2500, 2500, 3, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, DOOR_LOCKED | F_LOCK_2B, ROOM_411_CONTROL_ROOM, 8200, 0, 10800, 2048, IT_3B_KEY_CONTROL_ROOM, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        aot_set(AOT_04_MESSAGE, 14500, 8000, 6500, 2700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
        aot_set(AOT_05_MESSAGE, 7500, 8000, 7000, 2700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        aot_set(AOT_06_MESSAGE, 7500, 24000, 13500, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        if (ck(FG_SCENARIO, F_SCENARIO_23, FALSE))
        {
            aot_set(AOT_07_B, 0, 0, 32000, 32000, SCE_B, SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
            obj(OBJ_00, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 21840, -1850, 16600, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            obj(OBJ_01, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 16330, -1850, 26850, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            obj(OBJ_02, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 4090, -1850, 16430, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            obj(OBJ_03, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 16230, -1850, 5470, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            enemy(EM_0B_NEPTUNE, EB_00, F_ENEMY_39, SPAWN_FORCE, 2, 0, 848, 0, 4060, 0, 15600, ENEMY_00_NEPTUNE, ANIM_00, 0, EVAR_00);
            enemy(EM_0B_NEPTUNE, EB_02, F_ENEMY_0C, SPAWN_FORCE, 2, 0, 848, 0, 4060, 0, 14600, ENEMY_01_NEPTUNE, ANIM_00, 0, EVAR_00);
            enemy(EM_0B_NEPTUNE, EB_02, F_ENEMY_0D, SPAWN_FORCE, 2, 0, 848, 0, 4060, 0, 13600, ENEMY_02_NEPTUNE, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_04, on_enter);
        }
        else
        {
            enemy(EM_0B_NEPTUNE, EB_01, F_ENEMY_39, SPAWN_FORCE, 2, 0, 3257, 0, 26833, 0, 17000, ENEMY_00_NEPTUNE, ANIM_00, 0, EVAR_00);
            enemy(EM_0B_NEPTUNE, EB_03, F_ENEMY_0C, SPAWN_FORCE, 2, 0, 0, 0, 24833, 0, 14000, ENEMY_01_NEPTUNE, ANIM_00, 0, EVAR_00);
            enemy(EM_0B_NEPTUNE, EB_03, F_ENEMY_0D, SPAWN_FORCE, 2, 0, 512, 0, 25833, 0, 11000, ENEMY_02_NEPTUNE, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        aot_set(AOT_04_USEITEM, 7000, 1000, 6000, 8000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 32, 0, 1, 0);
        aot_set(AOT_05_USEITEM, 1400, 23600, 6000, 8000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 33, 0, 1, 0);
        if (ck(FG_COMMON, F_COMMON_09, TRUE))
        {
            aot_reset(AOT_04_USEITEM, SCE_NONE, 0, 0, 0, 0);
            aot_reset(AOT_05_USEITEM, SCE_NONE, 0, 0, 0, 0);
        }
        aot_set(AOT_06_MESSAGE, 14500, 8000, 6500, 2700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
        aot_set(AOT_07_MESSAGE, 7500, 8000, 7000, 2700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        aot_set(AOT_08_MESSAGE, 7500, 24000, 13500, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        if (ck(FG_SCENARIO, F_SCENARIO_23, FALSE))
        {
            aot_set(AOT_09_B, 0, 0, 32000, 32000, SCE_B, SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
            obj(OBJ_00, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 21840, -1850, 16600, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            obj(OBJ_01, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 16330, -1850, 26850, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            obj(OBJ_02, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 4090, -1850, 16430, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            obj(OBJ_03, OF_10 | OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 16230, -1850, 5470, 0, 0, 0, 0, 0, 0, 0, 0, 0);
            evt_exec(0, TASK_04, on_enter);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_23, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_09, FALSE))
            {
                enemy(EM_0B_NEPTUNE, EB_80, F_ENEMY_39, SPAWN_FORCE, 2, 0, 848, 0, 4060, -32000, 15600, ENEMY_00_NEPTUNE, ANIM_00, 0, EVAR_00);
                enemy(EM_0B_NEPTUNE, EB_82, F_ENEMY_0C, SPAWN_FORCE, 2, 0, 848, 0, 4060, -32000, 14600, ENEMY_01_NEPTUNE, ANIM_00, 0, EVAR_00);
                enemy(EM_0B_NEPTUNE, EB_82, F_ENEMY_0D, SPAWN_FORCE, 2, 0, 848, 0, 4060, -32000, 13600, ENEMY_02_NEPTUNE, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_0B_NEPTUNE, EB_00, F_ENEMY_39, SPAWN_FORCE, 2, 0, 848, 0, 4060, 0, 15600, ENEMY_00_NEPTUNE, ANIM_00, 0, EVAR_00);
                enemy(EM_0B_NEPTUNE, EB_02, F_ENEMY_0C, SPAWN_FORCE, 2, 0, 848, 0, 4060, 0, 14600, ENEMY_01_NEPTUNE, ANIM_00, 0, EVAR_00);
                enemy(EM_0B_NEPTUNE, EB_02, F_ENEMY_0D, SPAWN_FORCE, 2, 0, 848, 0, 4060, 0, 13600, ENEMY_02_NEPTUNE, ANIM_00, 0, EVAR_00);
            }
        }
        else
        {
            enemy(EM_0B_NEPTUNE, EB_01, F_ENEMY_39, SPAWN_FORCE, 2, 0, 3257, 0, 26833, 0, 17000, ENEMY_00_NEPTUNE, ANIM_00, 0, EVAR_00);
            enemy(EM_0B_NEPTUNE, EB_03, F_ENEMY_0C, SPAWN_FORCE, 2, 0, 0, 0, 26833, 0, 14000, ENEMY_01_NEPTUNE, ANIM_00, 0, EVAR_00);
            enemy(EM_0B_NEPTUNE, EB_03, F_ENEMY_0D, SPAWN_FORCE, 2, 0, 512, 0, 26833, 0, 11000, ENEMY_02_NEPTUNE, ANIM_00, 0, EVAR_00);
        }
    }
}

proc main when (JILL)
{
    if (ck(FG_COMMON, F_COMMON_09, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_20, TRUE))
        {
            pos_set(ENEMY_00_NEPTUNE, 0, 848, 0, 4060, 0, 15600);
            pos_set(ENEMY_01_NEPTUNE, 0, 848, 0, 4060, 0, 16600);
            pos_set(ENEMY_02_NEPTUNE, 0, 848, 0, 4060, 0, 17600);
            eml_state(0, ENEMY_00_NEPTUNE, EML_BEHAVIOUR, EB_00);
            eml_state(0, ENEMY_01_NEPTUNE, EML_BEHAVIOUR, EB_02);
            eml_state(0, ENEMY_02_NEPTUNE, EML_BEHAVIOUR, EB_02);
            aot_reset(AOT_04_USEITEM, SCE_NONE, 0, 0, 0, 0);
            aot_reset(AOT_05_USEITEM, SCE_NONE, 0, 0, 0, 0);
            set(FG_COMMON, F_COMMON_09, TRUE);
        }
        if (ck(FG_ROOM, F_ROOM_21, TRUE))
        {
            dir_set(0, 0, 2048, 0, 2800, 0, 26960);
            pos_set(ENEMY_00_NEPTUNE, 0, 2056, 0, 14136, 0, 27209);
            pos_set(ENEMY_01_NEPTUNE, 0, 2056, 0, 15136, 0, 27209);
            pos_set(ENEMY_02_NEPTUNE, 0, 2056, 0, 16136, 0, 27209);
            eml_state(0, ENEMY_00_NEPTUNE, EML_BEHAVIOUR, EB_00);
            eml_state(0, ENEMY_01_NEPTUNE, EML_BEHAVIOUR, EB_02);
            eml_state(0, ENEMY_02_NEPTUNE, EML_BEHAVIOUR, EB_02);
            aot_reset(AOT_04_USEITEM, SCE_NONE, 0, 0, 0, 0);
            aot_reset(AOT_05_USEITEM, SCE_NONE, 0, 0, 0, 0);
            set(FG_COMMON, F_COMMON_09, TRUE);
            evt_exec(0, TASK_07, event_06);
        }
    }
}

