  <strings>
    <language lang="en-US">
      <string key="name">WATER TANK</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">{scroll 2}\nIt's locked.{clear 0}{scroll 2}\nThere's no key hole.</string>
      <string key="1">{scroll 2}\nIt's a large watertank.</string>
      <string key="2">{scroll 2}The tank appears to have\ncracked.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 2}\n     ロックされている{clear 0}{scroll 2}\n    カギ穴は見当たらない</string>
      <string key="1">{scroll 2}\n      大きな水槽だ</string>
      <string key="2">{scroll 2}\n     穴があいている</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Poste de garde RdC</string>
      <string key="0">{scroll 2}\nC'est fermé.{clear 0}{scroll 2}\nIl n'y a pas de serrure.</string>
      <string key="1">{scroll 2}\nC'est un grand réservoir.</string>
      <string key="2">{scroll 2}\nUn trou s'ouvre.</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}\nSie ist verschlossen.{clear 0}{scroll 2}Da gibt es gar kein\nSchlüsselloch.</string>
      <string key="1">{scroll 2}Das ist ein großer\nWasserbehälter.</string>
      <string key="2">{scroll 2}\nEin kaputter Tank.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Guardiola 1P</string>
      <string key="0">{scroll 2}\nÈ chiuso.{clear 0}{scroll 2}\nManca la serratura.</string>
      <string key="1">{scroll 2}\nÈ una grande cisterna.</string>
      <string key="2">{scroll 2}\nIl serbatoio sembra essersi rotto.</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}\nEstá cerrado...{clear 0}{scroll 2}\nNo hay cerradura...</string>
      <string key="1">{scroll 2}\nEs un gran tanque de agua...</string>
      <string key="2">{scroll 2}El tanque parece tener\nuna fuga...</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната охраны 1-эт.</string>
      <string key="0">{scroll 2}\nЗаперто.{clear 0}{scroll 2}\nЗамка не видно.</string>
      <string key="1">{scroll 2}\nЭто большой резервуар для воды.</string>
      <string key="2">{scroll 2}\nПохоже бак треснул.</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Asuntolan varasto 1 krs</string>
      <string key="0">{scroll 2}Se on lukossa..{clear 0}{scroll 2}Siinä ei ole avainmenreikää...</string>
