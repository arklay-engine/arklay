#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_109 0x00
#define AOT_01_ITEM_KEY_DESK_0 0x01
#define AOT_03_EVENT_BATHTUB 0x03                           // Chris: turned into the bathtub event while it is full.
#define AOT_04_EVENT_BATHTUB_KEY 0x04                       // Chris: turned into the drained bathtub's event, which offers the key.
#define AOT_05_MESSAGE_NOTHING 0x05
#define CAM_03_BATHTUB 0x03
#define F_ROOM_BATHTUB_ANSWERED 0x18                        // The bathtub prompt was answered; main acts on it.
#define F_ROOM_BATHTUB_UNPLUG 0x19                          // The answer was yes: drain the tub.
#define IMDL_00_KEY_DESK 0x00
#define MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY 0x00
#define OBJ_00_WATER 0x00                                   // Likely: the muddy water's surface, lowered as the tub drains.
#define OBJ_01_WATER_LOWER 0x01                             // Guess: a second water layer that drains after the first.
#define SE_17_BATHMIX 0x17

proc init
{
    door_aot_set(AOT_00_DOOR_109, 1700, 1300, 2000, 900, 3, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 7, 0, ROOM_109_TRAP_PASSAGE, 18000, 0, 8100, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_113_BATHTUB_DRAINED, FALSE))
        {
            item_aot_set(AOT_01_ITEM_KEY_DESK_0, 20000, 20000, 1, 1, IT_3D_KEY_DESK, 1, IMDL_00_KEY_DESK, SCA_NONE, 20000, 0, 20000, -2300, F_ITEM_113_KEY_DESK_0, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_01_ITEM_KEY_DESK_0, 20000, 20000, 1, 1, IT_3D_KEY_DESK, 1, IMDL_00_KEY_DESK, SCA_NONE, 5850, -70, 6920, -430, F_ITEM_113_KEY_DESK_0, SAT_MANUAL | SAT_PLAYER, 0);
            eml_rot(IMDL_00_KEY_DESK, 0, 2040);
        }
        obj(OBJ_00_WATER, OF_ACTIVE, SCA_NONE, 21000, 0, 21000, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
        obj(OBJ_01_WATER_LOWER, OF_ACTIVE, SCA_NONE, 20000, 0, 20000, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
        aot_set(AOT_03_EVENT_BATHTUB, 4500, 6300, 2000, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 1, 0, 0, 0);
        aot_set(AOT_04_EVENT_BATHTUB_KEY, 4500, 6300, 2000, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 4, 0, 0, 0);
    }
    aot_set(AOT_05_MESSAGE_NOTHING, 8500, 2000, 1500, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    scene_setup(1, 4700, 7000, 1800);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_113_BATHTUB_DRAINED, FALSE))
        {
            aot_delete(AOT_03_EVENT_BATHTUB, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            evt_exec(0, TASK_09, place_water);
        }
        else
        {
            require(ck(FG_ITEM, F_ITEM_113_KEY_DESK_0, TRUE));
            aot_delete(AOT_04_EVENT_BATHTUB_KEY, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        }
    }
}

proc main
{
    if (testpickup(IT_3D_KEY_DESK))
    {
        aot_delete(AOT_04_EVENT_BATHTUB_KEY, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_ROOM, F_ROOM_BATHTUB_ANSWERED, TRUE))
    {
        set(FG_ROOM, F_ROOM_BATHTUB_ANSWERED, FALSE);
        if (ck(FG_ROOM, F_ROOM_BATHTUB_UNPLUG, TRUE))
        {
            set(FG_ROOM, F_ROOM_BATHTUB_UNPLUG, FALSE);
            evt_exec(0, TASK_09, drain_bathtub);
        }
        else
        {
            aot_delete(AOT_03_EVENT_BATHTUB, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            evt_exec(0, TASK_09, bathtub_left_full);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        }
    }
}

event place_water
{
    evt_work_set(WK_OBJ, OBJ_00_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 6280, 160, 7920);
    tw_finish();
}

event examine_bathtub
{
    run
    {
        aot_delete(AOT_03_EVENT_BATHTUB, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_03_BATHTUB);
    }
    evt_work_set(WK_OBJ, OBJ_00_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 5500, -660, 7070);
    tw_end();
    evt_next();
    sleep(15);
    message(MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "The bathtub is filled with muddy water. Will you unplug it? Nothing useful."
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_ROOM, F_ROOM_BATHTUB_ANSWERED, TRUE);
        require(cmpb(B_MENU_CHOICE, CMP_EQ, 0));
        set(FG_ROOM, F_ROOM_BATHTUB_UNPLUG, TRUE);
    }
    evt_next();
    evt_finish();
}

event drain_bathtub
{
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_BATHMIX, 7, SND_AT_POINT, 0, 5500, 7070);
        aot_delete(AOT_03_EVENT_BATHTUB, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_SCENARIO, F_SCENARIO_113_BATHTUB_DRAINED, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_00_WATER);
    evt_tween_begin_alt();
    tw_set_pos(0, 1, 0);
    for (15)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    for (29)
    {
        tw_set_pos(0, 6, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 2, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
    }
    tw_end();
    cutcurr(0);
    evt_work_set(WK_OBJ, OBJ_00_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_01_WATER_LOWER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 5790, -605, 7150);
    evt_next();
    tw_nop();
    for (33)
    {
        tw_set_pos(0, 6, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 2, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_end();
    evt_nop();
    evt_work_set(WK_AOT, IMDL_00_KEY_DESK);
    evt_tween_begin_alt();
    tw_abs_pos(0, 5850, -70, 6920);
    tw_abs_rot(0, 0, -430, 2040);
    tw_end();
    evt_next();
    run
    {
        aot_delete(AOT_04_EVENT_BATHTUB_KEY, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event bathtub_left_full
{
    sleep(20);
    cutcurr(0);
    evt_work_set(WK_OBJ, OBJ_00_WATER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 6280, 160, 7920);
    tw_end();
    evt_next();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_finish();
}

event examine_drained_bathtub
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cutnext(CAM_03_BATHTUB);
    evt_next();
    evt_nop();
    sleep(30);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    aot_on(AOT_01_ITEM_KEY_DESK_0, SCE_ITEM, 0);
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(20);
    cutcurr(0);
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}
