#version 1

proc init
{
    door_aot_set(0, 11100, 20500, 3200, 3800, 12, 1, 11, 3, 0, RDT_00C, 12700, 0, 2500, 3072, UNLOCKED, 129);
    door_aot_set(1, 21100, 4800, 1500, 2100, 0, 1, 11, 3, 0, RDT_010, 22000, 0, 16500, 1024, UNLOCKED, 129);
    if (ck(FG_SCENARIO, 46, 1))
    {
        aot_set(2, 1528, 3494, 1050, 1800, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    }
    else
    {
        aot_set(2, 1528, 3494, 950, 1800, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, 43, 0))
    {
        room_bgm_state_set(4, 15, 57);
    }
    else
    {
        room_bgm_state_set(4, 15, 8);
    }
    if (ck(FG_STATUS, 8, 1))
    {
        enemy(ENEMY_CHIMERA, 2, 120, 1, 2, 0, 0, 3072, 0, 0, 5676, 0, 7812, 0, 0, 0, 0);
        enemy(ENEMY_CHIMERA, 2, 121, 1, 2, 0, 0, 1152, 0, 0, 16644, 0, 13289, 1, 0, 0, 0);
        enemy(ENEMY_CHIMERA, 2, 178, 1, 2, 0, 0, 3128, 0, 0, 16093, 0, 4892, 2, 0, 0, 0);
    }
    else
    {
        enemy(ENEMY_CHIMERA, 2, 120, 1, 2, 0, 0, 3072, 0, 0, 5676, 0, 7812, 0, 0, 0, 0);
        enemy(ENEMY_CHIMERA, 2, 121, 1, 2, 0, 0, 1152, 0, 0, 16644, 0, 13289, 1, 0, 0, 0);
    }
    evt_exec(0, 9, event_03);
    evt_exec(0, 9, event_04);
}

event event_00
{
    set(FG_6, 23, 1);
    message(128, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, event_01);
        }
        else
        {
            evt_exec(0, 9, event_02);
        }
    }
    evt_finish();
}

event event_01
{
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    run
    {
        set(FG_6, 23, 0);
        set(FG_SCENARIO, 46, 0);
        aot_reset(2, SCE_MESSAGE, 129, 129, 255, 0);
    }
    evt_finish();
}

event event_02
{
    set(FG_6, 23, 0);
    evt_finish();
}

event event_03
{
    sleep(119);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 7600, 9900);
    }
    for (8)
    {
        effect(31, 0, 0, 176, 29, 52, 239, 172, 38, 78, 7);
        sleep(3);
    }
    evt_nop();
    evt_chain(3);
    evt_finish();
}

event event_04
{
    sleep(240);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 13100, 10600);
    }
    for (8)
    {
        effect(31, 0, 0, 44, 51, 160, 246, 104, 41, 10, 15);
        sleep(3);
    }
    evt_chain(4);
    evt_finish();
}
