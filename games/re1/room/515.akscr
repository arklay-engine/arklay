#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define FLAG_ROOM_18 0x18

proc init
{
    set(FG_STATUS, FLAG_STATUS_3D, TRUE);
    door_aot_set(0, 0, 0, 1, 1, 1, 13, 18, 64, 0, ROOM_50C_FRONT_OF_ELEVATOR, 16000, 0, 27900, 2048, UNLOCKED, 129);
    door_aot_set(1, 0, 0, 1, 1, 1, 13, 19, 64, 0, ROOM_514_FRONT_OF_TYRANT, 13300, 0, 10000, 2048, UNLOCKED, 129);
#if JILL
    dir_set(0, 0, 2048, 0, 4500, 0, 4200);
#endif
    if (cmpb(3, 0, 12))
    {
#if CHRIS
        if (ck(FG_COMMON, FLAG_COMMON_C0, FALSE) && ck(FG_COMMON, FLAG_COMMON_5A, FALSE))
        {
            dir_set(0, 0, 1500, 0, 5000, 0, 5500);
            enemy(ENEMY_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 2000, 0, 0, 4600, 0, 3500, 0, 5, 19, 0);
        }
        else
        {
            dir_set(0, 0, 2048, 0, 4500, 0, 4200);
        }
#else
        if (ck(FG_COMMON, FLAG_COMMON_C0, FALSE) && ck(FG_COMMON, FLAG_COMMON_4D, FALSE) && ck(FG_SCENARIO, FLAG_SCENARIO_37, FALSE))
        {
            dir_set(0, 0, 1500, 0, 5000, 0, 5500);
            enemy(ENEMY_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 2000, 0, 0, 4600, 0, 3500, 0, 5, 34, 0);
        }
        else
        {
            dir_set(0, 0, 2048, 0, 4500, 0, 4200);
        }
#endif
        evt_exec(0, 9, event_00);
    }
    else
    {
#if CHRIS
        if (ck(FG_COMMON, FLAG_COMMON_C0, FALSE) && ck(FG_COMMON, FLAG_COMMON_5A, FALSE))
        {
            dir_set(0, 0, 1500, 0, 5000, 0, 5500);
            enemy(ENEMY_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 2500, 0, 0, 4600, 0, 3500, 0, 5, 19, 0);
        }
        else
        {
            dir_set(0, 0, 2048, 0, 4500, 0, 4200);
        }
#else
        if (ck(FG_COMMON, FLAG_COMMON_C0, FALSE) && ck(FG_COMMON, FLAG_COMMON_5B, TRUE) && ck(FG_COMMON, FLAG_COMMON_4D, FALSE))
        {
            dir_set(0, 0, 1500, 0, 5000, 0, 5500);
            enemy(ENEMY_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 2500, 0, 0, 4600, 0, 3500, 0, 5, 34, 0);
        }
        else
        {
            dir_set(0, 0, 2048, 0, 4500, 0, 4200);
        }
#endif
        evt_exec(0, 9, event_01);
    }
}

event event_00
{
    sleep(1);
    set(FG_6, FLAG_6_17, FALSE);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_18, FALSE));
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        aot_on(1, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_01
{
    sleep(1);
    set(FG_6, FLAG_6_17, FALSE);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_18, FALSE));
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        aot_on(0, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_02
{
    sleep(5);
    set(FG_STATUS, FLAG_STATUS_3E, TRUE);
    sleep(10);
    set(FG_STATUS, FLAG_STATUS_3E, FALSE);
    sleep(100);
    sleep(60);
    set(FG_ROOM, FLAG_ROOM_18, TRUE);
    evt_finish();
}
