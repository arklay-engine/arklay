#version 1

proc init
{
    door_aot_set(0, 14000, 21500, 6000, 2000, 1, 4, 22, 96, 0, RDT_106, 17000, 0, 14300, 1024, UNLOCKED, 129);
    door_aot_set(1, 31400, 7000, 2000, 2000, 2, 0, 0, 1, 64, RDT_011, 2400, 0, 3600, 3360, UNLOCKED, 129);
    door_aot_set(2, 31400, 19000, 2000, 3000, 2, 0, 3, 1, 0, RDT_004, 3000, 0, 3600, 0, UNLOCKED, 129);
    door_aot_set(3, 1000, 15000, 1700, 3800, 6, 0, 3, 1, 0, RDT_002, 30900, 0, 8300, 2048, UNLOCKED, 129);
    aot_set(4, 20220, 23900, 3540, 3500, SCE_5, 129, 0, 0, 0, 0, 0, 0);
    aot_set(5, 10200, 23900, 3480, 3490, SCE_5, 129, 1, 0, 0, 0, 0, 0);
    aot_set(7, 7000, 13000, 20000, 6000, SCE_USEITEM, 65, 4, 0, 33, 0, 1, 0);
    if (ck(FG_COMMON, 10, 1) && ck(FG_COMMON, 7, 1) && ck(FG_ITEM, 13, 1))
    {
        set(FG_COMMON, 7, 0);
        set(FG_ROOM, 31, 0);
        item_aot_set(8, 0, 0, 16, 16, ITEM_ACID_ROUNDS, 6, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 14, 65, 0, 0);
        enemy(ENEMY_BARRY_STARS_, 4, 255, 1, 2, 0, 0, 1568, 0, 0, 23782, -2885, 14862, 0, 0, 0, 0);
        evt_exec(0, 0, event_00);
        set(FG_ROOM, 10, 0);
        set(FG_ROOM, 11, 0);
    }
    if (ck(FG_COMMON, 5, 1))
    {
        set(FG_COMMON, 7, 0);
        aot_reset(1, SCE_MESSAGE, 129, 128, 255, 0);
        aot_reset(2, SCE_MESSAGE, 129, 128, 255, 0);
        aot_reset(3, SCE_MESSAGE, 129, 128, 255, 0);
    }
}

proc main
{
    if (ck(FG_ROOM, 33, 0) && cmpb(2, 0, 0))
    {
        aot_switch(0, 1, 1);
        aot_switch(0, 2, 1);
    }
    else if (ck(FG_ROOM, 31, 0))
    {
        aot_switch(0, 1, 1);
        aot_switch(0, 2, 1);
    }
    else
    {
        aot_switch(0, 1, 0);
        aot_switch(0, 2, 0);
    }
    if (ck(FG_ROOM, 10, 0))
    {
        if (ck(FG_ROOM, 11, 0))
        {
            aot_switch(0, 1, 0);
            aot_switch(0, 2, 0);
        }
        else
        {
            aot_switch(0, 1, 1);
            aot_switch(0, 2, 1);
        }
    }
}

