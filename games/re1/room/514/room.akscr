proc init
{
    door_aot_set(AOT_00_DOOR, 2400, 700, 2400, 1700, 10, DOOR_SND_0C_DR_AIR, DOOR_0D_DOOR13, 64, 0, ROOM_513_TYRANT_ROOM, 4700, 0, 25500, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 13500, 8500, 1800, 2900, 0, DOOR_SND_0D_EV_LAB, DOOR_13_ELE01B, 64, 0, ROOM_515_B4_ELEVATOR, 0, 0, 0, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_SCENARIO, F_SCENARIO_37, FALSE))
    {
        if (CHRIS)
        {
            room_bgm_state_set(4, ROOM_514_FRONT_OF_TYRANT, BGM_RELOAD);
        }
        enemy(EM_24_NPC_WESKER, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 2950, 0, 3000, ENEMY_00, ANIM_32, 0, EVAR_00);
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_C0, FALSE))
            {
                enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 13480, 0, 11000, ENEMY_01_NPC_REBECCA, ANIM_00, 0, EVAR_00);
            }
            evt_exec(0, TASK_09, on_enter);
        }
        else
        {
            room_bgm_state_set(4, ROOM_514_FRONT_OF_TYRANT, BGM_RELOAD | 1);
            if (ck(FG_COMMON, F_COMMON_C0, FALSE))
            {
                enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 13480, 0, 11000, ENEMY_01_NPC_BARRY, ANIM_00, 0, EVAR_00);
                evt_exec(0, TASK_09, on_enter_sub1);
            }
            else
            {
                evt_exec(0, TASK_09, on_enter_2);
            }
        }
    }
    if (CHRIS)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_37, TRUE) && ck(FG_COMMON, F_COMMON_C0, FALSE) && ck(FG_COMMON, F_COMMON_4C, FALSE))
        {
            enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1904, 0, 12590, 0, 11000, ENEMY_00, ANIM_00, 0, EVAR_00);
            eml_state(0, ENEMY_00, EML_STATUS, EML_STATUS_OR | 2);
            set(FG_COMMON, F_COMMON_4C, TRUE);
            room_bgm_state_set(4, ROOM_514_FRONT_OF_TYRANT, BGM_OFF);
            evt_exec(0, TASK_09, on_enter_2);
        }
    }
    else
    {
        if (ck(FG_SCENARIO, F_SCENARIO_37, TRUE) && ck(FG_COMMON, F_COMMON_C0, FALSE) && ck(FG_COMMON, F_COMMON_5B, TRUE) && ck(FG_COMMON, F_COMMON_4C, TRUE))
        {
            room_bgm_state_set(4, ROOM_514_FRONT_OF_TYRANT, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 2);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_37, TRUE) && ck(FG_COMMON, F_COMMON_C0, FALSE) && ck(FG_COMMON, F_COMMON_5B, TRUE) && ck(FG_COMMON, F_COMMON_4C, FALSE))
        {
            room_bgm_state_set(4, ROOM_500_UNDER_FOUNTAIN, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_501_HELIPORT_PASSAGE, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON);
            room_bgm_state_set(4, ROOM_502_LADDER_ROOM, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_503_STAIRS, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_504_CONFERENCE_ROOM, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_505_O_PASSAGE, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_506_SMALL_LABORATORY, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_507_MORTUARY, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_508_DOUBLE_LOCK, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_509_PRIVATE_ROOM_A, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_50A_PRIVATE_ROOM_B, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_50B_FRONT_OF_CELL, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_50C_FRONT_OF_ELEVATOR, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_50D_ESCAPE_ELEVATOR, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON);
            room_bgm_state_set(4, ROOM_50E_SAVE_ROOM, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_50F_MAZE_A, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_510_MAZE_B, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_511_ENGINE_ROOM, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_512_CELL, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_513_TYRANT_ROOM, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
            room_bgm_state_set(4, ROOM_514_FRONT_OF_TYRANT, BGM_RELOAD | 2);
            room_bgm_state_set(4, ROOM_515_B4_ELEVATOR, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_37, TRUE) && ck(FG_COMMON, F_COMMON_C0, FALSE) && ck(FG_COMMON, F_COMMON_5B, TRUE) && ck(FG_COMMON, F_COMMON_4C, FALSE))
        {
            enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3232, 0, 2836, 0, 3180, ENEMY_00, ANIM_00, 0, EVAR_00);
            evt_exec(0, TASK_09, on_enter_3);
        }
    }
}

event on_enter when (CHRIS)
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        if (ck(FG_COMMON, F_COMMON_C0, FALSE))
        {
            evt_exec(0, TASK_09, on_enter_sub1);
        }
        else
        {
            evt_exec(0, TASK_09, on_enter_sub3);
        }
    }
    evt_finish();
}

event on_enter_sub1
{
    if (JILL)
    {
        sleep(1);
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_0F, TRUE);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_seq(AB_02, 5000, 10000, F_ROOM_21);
    }
    else
    {
        act_anim_seq(AB_02, 5000, 10000, F_ROOM_22);
    }
    act_nop();
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 400, 0, 1, 20, 0);
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    }
    evt_actor_begin();
    act_motion_path(MOTION_71, 400, 0, 2, 40, 0);
    if (CHRIS)
    {
        act_anim_seq(AB_02, 7000, 11000, F_ROOM_20);
    }
    else
    {
        act_anim_seq(AB_02, 7000, 11000, F_ROOM_23);
    }
    act_nop();
    act_reset();
    evt_nop();
    sleep(80);
    run
    {
        cutnext(CAM_03);
        dir_set(0, 0, 1024, 0, 3300, 0, 10000);
        if (CHRIS)
        {
            pos_set(ENEMY_01_NPC_REBECCA, 0, 1024, 0, 5000, 0, 11000);
        }
        else
        {
            pos_set(ENEMY_01_NPC_BARRY, 0, 1024, 0, 5000, 0, 11000);
        }
        bgm_play(BGM_MAIN);
    }
    sleep(1);
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_seq(AB_02, 4740, 8770, F_ROOM_20);
    }
    else
    {
        act_anim_seq(AB_02, 5100, 8870, F_ROOM_20);
    }
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (CHRIS)
        {
            voice_play(VOICE_PLAY, VO_012_00);
            message(MSG_VO_012_00, 0);
        }
        else
        {
            voice_play(VOICE_PLAY, VO_115_00);
            message(MSG_VO_115_00, 0);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_seq(AB_02, 3130, 9050, F_ROOM_21);
    }
    else
    {
        act_anim_seq(AB_02, 3340, 8460, F_ROOM_22);
    }
    act_nop();
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(20);
        evt_work_set(WK_ENEMY, ENEMY_00);
        evt_actor_begin();
        act_anim_flags(ANIM_32, F_ROOM_20, AFL_01);
        act_reset();
        evt_nop();
        sleep(20);
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(ANIM_22, F_ROOM_20, AFL_01);
        act_reset();
        evt_nop();
    }
    else
    {
        wait_message();
        run
        {
            voice_play(VOICE_PLAY, VO_115_01);
            message(MSG_VO_115_01, 0);
        }
    }
    evt_work_set(WK_ENEMY, ENEMY_00);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_3C, F_ROOM_20, AFL_01);
    }
    else
    {
        act_anim_flags(ANIM_25, F_ROOM_20, AFL_01);
    }
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_00);
    }
    else
    {
        sleep(10);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_38, F_ROOM_20, AFL_01);
    }
    else
    {
        act_anim_flags(ANIM_2E, F_ROOM_20, 0);
        act_flag_op(EF_SET, EF_0002);
        act_param_set(0, 974);
    }
    act_reset();
    evt_nop();
    wait_message();
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    }
    else
    {
        sleep(10);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_23, F_ROOM_20, 0);
    }
    else
    {
        act_anim_flags(ANIM_10, F_ROOM_20, 0);
    }
    act_reset();
    evt_nop();
    run
    {
        if (CHRIS)
        {
            voice_play(VOICE_PLAY, VO_012_01);
            message(MSG_VO_012_01, 0);
        }
        else
        {
            voice_play(VOICE_PLAY, VO_115_02);
            message(MSG_VO_115_02, 0);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_seq(AB_02, 3130, 8050, F_ROOM_21);
        act_nop();
    }
    else
    {
        act_anim_flags(ANIM_2B, F_ROOM_20, AFL_01);
    }
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(5);
        evt_work_set(WK_ENEMY, ENEMY_00);
    }
    else
    {
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_01_NPC_BARRY);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_34, F_ROOM_20, AFL_01);
        act_flag_op(EF_SET, EF_0002);
    }
    else
    {
        act_motion_path(MOTION_33, -400, 200, 0, 20, 20);
    }
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(15);
        evt_work_set(WK_PLAYER, 0);
    }
    else
    {
        wait_message();
        cutnext(CAM_04);
        sleep(1);
        run
        {
            voice_play(VOICE_PLAY, VO_115_03);
            message(MSG_VO_115_03, 0);
        }
        evt_work_set(WK_ENEMY, ENEMY_00);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_20, AFL_01);
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(35);
        evt_work_set(WK_PLAYER, 0);
    }
    else
    {
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_00);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_25, F_ROOM_20, AFL_01);
    }
    else
    {
        act_anim_flags(ANIM_22, F_ROOM_20, AFL_01);
    }
    act_reset();
    evt_nop();
    if (JILL)
    {
        sleep(70);
    }
    evt_work_set(WK_ENEMY, ENEMY_00);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_34, F_ROOM_20, AFL_01);
    }
    else
    {
        act_anim_flags(ANIM_22, F_ROOM_20, AFL_01);
    }
    act_flag_op(EF_SET, EF_0001);
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(32);
        evt_work_set(WK_PLAYER, 0);
    }
    else
    {
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_00);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_22, F_ROOM_20, AFL_01);
    }
    else
    {
        act_anim_flags(ANIM_24, F_ROOM_20, AFL_01);
    }
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(25);
        evt_work_set(WK_PLAYER, 0);
    }
    else
    {
        sleep(55);
        evt_work_set(WK_ENEMY, ENEMY_00);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_motion_path(MOTION_71, 300, 0, 1, 15, 0);
    }
    else
    {
        act_anim_flags(ANIM_21, F_ROOM_20, AFL_01);
    }
    act_reset();
    evt_nop();
    wait_message();
    if (CHRIS)
    {
        cutnext(CAM_04);
        sleep(1);
    }
    run
    {
        if (CHRIS)
        {
            voice_play(VOICE_PLAY, VO_012_02);
            message(MSG_VO_012_02, 0);
        }
        else
        {
            voice_play(VOICE_PLAY, VO_115_04);
            message(MSG_VO_115_04, 0);
        }
    }
    if (CHRIS)
    {
        evt_work_set(WK_ENEMY, ENEMY_00);
    }
