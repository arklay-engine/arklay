    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

event event_07 when (JILL)
{
    run
    {
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}
