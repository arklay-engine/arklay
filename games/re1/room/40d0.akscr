proc main
{
    if (cmpb(2, 0, 4) && ck(FG_ROOM, 15, 0))
    {
        set(FG_ROOM, 15, 1);
        eml_pos(3, 0, 0, 0, 0, 0, 0, 202, 108, 108, 7, 248, 52);
    }
    if (cmpb(2, 0, 4) && ck(FG_ROOM, 14, 0))
    {
        set(FG_ROOM, 14, 1);
        eml_pos(3, 0, 0, 0, 0, 0, 0, 202, 108, 108, 7, 232, 38);
        eml_pos(1, 0, 0, 0, 0, 0, 0, 202, 108, 108, 7, 248, 52);
    }
    if (ck(FG_ROOM, 62, 0))
    {
        sys_multi(10, 256);
        objtbl_b_set(0, 5, 63);
    }
    else
    {
        sys_multi(10, 0);
        objtbl_b_set(0, 5, 0);
    }
}

event event_00
{
    run
    {
        aot_delete(2, SCE_NONE, 0);
        aot_delete(9, SCE_NONE, 0);
        set(FG_6, 23, 1);
        objtbl_b_set(0, 3, 41);
    }
    evt_fork(9, event_01, 0);
    evt_fork(9, event_02, 0);
    sleep(27);
    se_play_3d(2, 23, 0, 0, 0, 27850, 14000);
    evt_fork(9, event_0E, 0);
    sleep(45);
    run
    {
        objtbl_b_set(0, 3, 43);
        set(FG_6, 23, 0);
        set(FG_SCENARIO, 57, 0);
        set(FG_SCENARIO, 56, 1);
    }
    evt_finish();
}

