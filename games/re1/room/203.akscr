    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    run
    {
        cutnext(CAM_01);
        set(FG_ROOM, F_ROOM_0B, TRUE);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    evt_actor_begin();
    act_anim_seq(AB_ADDITIVE | AB_03, 5339, 16501, F_ROOM_22);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    cutnext(CAM_03);
    sleep(10);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    evt_actor_begin();
    act_idle();
    act_reset();
    sleep(30);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_POINT, 0, 19000, 17000);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_20, 0);
    act_reset();
    evt_nop();
    sleep(50);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 19000, 17000);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        pos_set(ENEMY_00_NPC_BARRY, 0, 0, 0, 0, 10000, 0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_ROOM, F_ROOM_1F, FALSE);
        set(FG_ROOM, F_ROOM_0A, FALSE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}
#endif
