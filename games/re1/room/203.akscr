#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_5 0x04
#define AOT_05_5 0x05
#define AOT_07_USEITEM 0x07
#define AOT_08_ITEM 0x08
#define F_ROOM_03 0x03
#define F_ROOM_05 0x05
#define F_ROOM_0A 0x0A
#define F_ROOM_0B 0x0B
#define F_ROOM_1F 0x1F
#define F_ROOM_21 0x21
#define F_ROOM_22 0x22

proc init
{
    door_aot_set(AOT_00_DOOR, 14000, 21500, 6000, 2000, 1, 4, 22, 96, 0, STAGE_1 | ROOM_106_MAIN_HALL, 17000, 0, 14300, 1024, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 31400, 7000, 2000, 2000, 2, 0, 0, 1, 64, ROOM_211_TERRACE_PASSAGE, 2400, 0, 3600, 3360, UNLOCKED, 129);
    door_aot_set(AOT_02_DOOR, 31400, 19000, 2000, 3000, 2, 0, 3, 1, 0, ROOM_204_C_PASSAGE, 3000, 0, 3600, 0, UNLOCKED, 129);
    door_aot_set(AOT_03_DOOR, 1000, 15000, 1700, 3800, 6, 0, 3, 1, 0, ROOM_202_DINING_ROOM_2F, 30900, 0, 8300, 2048, UNLOCKED, 129);
    aot_set(AOT_04_5, 20220, 23900, 3540, 3500, SCE_5, 129, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_05_5, 10200, 23900, 3480, 3490, SCE_5, 129, 1, 0, 0, 0, 0, 0);
    aot_set(AOT_07_USEITEM, 7000, 13000, 20000, 6000, SCE_USEITEM, 65, 4, 0, 33, 0, 1, 0);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, TRUE) && ck(FG_COMMON, F_COMMON_63, TRUE))
    {
        set(FG_COMMON, F_COMMON_66, TRUE);
    }
#else
    if (ck(FG_COMMON, F_COMMON_0A, FALSE) && ck(FG_COMMON, F_COMMON_07, FALSE) && ck(FG_ITEM, F_ITEM_0D, FALSE))
    {
        set(FG_COMMON, F_COMMON_07, TRUE);
        set(FG_ROOM, F_ROOM_1F, TRUE);
        item_aot_set(AOT_08_ITEM, 0, 0, 16, 16, IT_11_AMMO_GRENADE_ACID, 6, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 14, 65, 0, 0);
        enemy(EM_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 1568, 0, 0, 23782, -2885, 14862, 0, 0, 0, 0);
        evt_exec(0, 0, on_enter);
        set(FG_ROOM, F_ROOM_0A, TRUE);
        set(FG_ROOM, F_ROOM_0B, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_05, FALSE))
    {
        set(FG_COMMON, F_COMMON_07, TRUE);
        aot_reset(AOT_01_DOOR, SCE_MESSAGE, 129, 128, 255, 0);
        aot_reset(AOT_02_DOOR, SCE_MESSAGE, 129, 128, 255, 0);
        aot_reset(AOT_03_DOOR, SCE_MESSAGE, 129, 128, 255, 0);
    }
#endif
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_21, TRUE) && cmpb(2, 0, 0))
    {
        aot_switch(0, 1, 1);
        aot_switch(0, 2, 1);
    }
    else if (ck(FG_ROOM, F_ROOM_1F, TRUE))
    {
        aot_switch(0, 1, 1);
        aot_switch(0, 2, 1);
    }
    else
    {
        aot_switch(0, 1, 0);
        aot_switch(0, 2, 0);
    }
    if (ck(FG_ROOM, F_ROOM_0A, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_0B, TRUE))
        {
            aot_switch(0, 1, 0);
            aot_switch(0, 2, 0);
        }
        else
        {
            aot_switch(0, 1, 1);
            aot_switch(0, 2, 1);
        }
    }
}
