#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_5 0x04
#define AOT_05_5 0x05
#define AOT_07_USEITEM 0x07
#define AOT_08_ITEM 0x08
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_03 0x03
#define ENEMY_00_NPC_BARRY 0x00
#define F_ROOM_03 0x03
#define F_ROOM_05 0x05
#define F_ROOM_0A 0x0A
#define F_ROOM_0B 0x0B
#define F_ROOM_1F 0x1F
#define F_ROOM_20 0x20
#define F_ROOM_21 0x21
#define F_ROOM_22 0x22
#define IMDL_00 0x00
#define MSG_VO_106_00 0x01
#define MSG_VO_106_01 0x02
#define MSG_VO_106_02 0x05
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define SPR_01 0x01
#define SPR_02 0x02
#define VO_106_00 0x22
#define VO_106_01 0x23
#define VO_106_02 0x24

proc init
{
    door_aot_set(AOT_00_DOOR, 14000, 21500, 6000, 2000, 1, DOOR_SND_04_ST_WCP, DOOR_16_KAI01, 96, 0, STAGE_1 | ROOM_106_MAIN_HALL, 17000, 0, 14300, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 31400, 7000, 2000, 2000, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCK_40, ROOM_211_TERRACE_PASSAGE, 2400, 0, 3600, 3360, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 31400, 19000, 2000, 3000, 2, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_204_C_PASSAGE, 3000, 0, 3600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 1000, 15000, 1700, 3800, 6, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_202_DINING_ROOM_2F, 30900, 0, 8300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_04_5, 20220, 23900, 3540, 3500, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_05_5, 10200, 23900, 3480, 3490, SCE_5, SAT_MANUAL | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
    aot_set(AOT_07_USEITEM, 7000, 13000, 20000, 6000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 33, 0, 1, 0);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, TRUE) && ck(FG_COMMON, F_COMMON_63, TRUE))
    {
        set(FG_COMMON, F_COMMON_66, TRUE);
    }
#else
    if (ck(FG_COMMON, F_COMMON_0A, FALSE) && ck(FG_COMMON, F_COMMON_07, FALSE) && ck(FG_ITEM, F_ITEM_0D, FALSE))
    {
        set(FG_COMMON, F_COMMON_07, TRUE);
        set(FG_ROOM, F_ROOM_1F, TRUE);
        item_aot_set(AOT_08_ITEM, 0, 0, 16, 16, IT_11_AMMO_GRENADE_ACID, 6, IMDL_00, SCA_NONE, 0, 0, 0, 0, F_ITEM_0E, SAT_UNDER | SAT_PLAYER, 0);
        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1568, 0, 23782, -2885, 14862, ENEMY_00_NPC_BARRY, ANIM_00, 0, EVAR_00);
        evt_exec(0, TASK_00, on_enter);
        set(FG_ROOM, F_ROOM_0A, TRUE);
        set(FG_ROOM, F_ROOM_0B, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_05, FALSE))
    {
        set(FG_COMMON, F_COMMON_07, TRUE);
        aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
        aot_reset(AOT_02_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
        aot_reset(AOT_03_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 255, 0);
    }
#endif
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_21, TRUE) && cmpb(B_CAMERA, CMP_EQ, CAM_00))
    {
        aot_switch(0, SPR_01, SPR_OFF);
        aot_switch(0, SPR_02, SPR_OFF);
    }
    else if (ck(FG_ROOM, F_ROOM_1F, TRUE))
    {
        aot_switch(0, SPR_01, SPR_OFF);
        aot_switch(0, SPR_02, SPR_OFF);
    }
    else
    {
        aot_switch(0, SPR_01, SPR_ON);
        aot_switch(0, SPR_02, SPR_ON);
    }
    if (ck(FG_ROOM, F_ROOM_0A, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_0B, TRUE))
        {
            aot_switch(0, SPR_01, SPR_ON);
            aot_switch(0, SPR_02, SPR_ON);
        }
        else
        {
            aot_switch(0, SPR_01, SPR_OFF);
            aot_switch(0, SPR_02, SPR_OFF);
        }
    }
}
#if JILL

event on_enter
{
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cut_auto(CUT_LOCKED);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_11, 23782, -5485, 14862, 180, 64);
    act_anim_seq(AB_02, 29000, 19000, F_ROOM_03);
    act_reset();
    sleep(10);
    set(FG_STATUS, F_STATUS_0F, TRUE);
    sleep(5);
    evt_fork(TASK_01, on_enter_sub2, 0);
    voice_play(VOICE_PLAY, VO_106_00);
    message(MSG_VO_106_00, 0);
    wait_message();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_03, FALSE));
    set(FG_ROOM, F_ROOM_03, FALSE);
    voice_play(VOICE_PLAY, VO_106_01);
    message(MSG_VO_106_01, 0);
    evt_work_set(WK_PLAYER, 0);
