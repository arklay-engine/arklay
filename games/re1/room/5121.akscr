#version 1

proc init
{
    door_aot_set(0, 4800, 10400, 1300, 1200, 3, 1, 14, 3, 0, RDT_00B, 9800, 0, 15800, 3072, UNLOCKED, 129);
    room_bgm_state_set(4, 18, 255);
    if (ck(FG_SCENARIO, 43, 0))
    {
        room_bgm_state_set(4, 18, 57);
    }
    if (ck(FG_COMMON, 75, 1))
    {
        enemy(ENEMY_CHRIS_STARS_, 0, 255, 1, 2, 0, 0, 3000, 0, 0, 5680, 0, 2930, 0, 0, 0, 0);
        evt_exec(0, 9, event_00);
        set(FG_COMMON, 75, 0);
        room_bgm_state_set(4, 18, 16);
    }
    aot_set(1, 1800, 3100, 900, 1400, SCE_MESSAGE, 129, 139, 0, 255, 0, 0, 0);
    aot_set(2, 7000, 2000, 1800, 3600, SCE_MESSAGE, 129, 138, 0, 255, 0, 0, 0);
}

event event_00
{
    sleep(1);
    run
    {
        dir_set(0, 0, 1024, 0, 5670, 0, 9200);
    }
    set(FG_6, 23, 1);
    set(FG_STATUS, 15, 0);
    sleep(20);
    run
    {
        if (ck(FG_SCENARIO, 101, 0))
        {
            evt_exec(0, 9, event_01);
        }
        else
        {
            evt_exec(0, 9, event_02);
        }
    }
    evt_finish();
}

event event_01
{
    evt_fork(9, event_03, 0);
    sleep(30);
    cutnext(2);
    evt_fork(9, event_04, 0);
    voice_play(1, 66, 0);
    sleep(15);
    message(8, 0);
    sleep(20);
    evt_fork(9, event_05, 0);
    sleep(70);
    evt_fork(9, event_06, 0);
    sleep(60);
    evt_fork(9, event_07, 0);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 0 | 20, 0 | 0);
    act_param_set(0, 8);
    act_reset();
    evt_nop();
    run
    {
        set(FG_STATUS, 15, 1);
        pos_set(0, 0, 3072, 0, 5700, 0, 6800);
        cutnext(0);
        cut_auto(0);
    }
    sleep(45);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        eml_state(0, 0, 8);
        set(FG_6, 23, 0);
        aot_on(0, SCE_DOOR, 0);
    }
    evt_finish();
}

