#define AOT_00_DOOR_406 0x00
#define AOT_01_ITEM_AMMO_HANDGUN_0 0x01
#define AOT_02_MESSAGE_BATHTUB 0x02                         // "No water is left."
#define AOT_03_MESSAGE_DUSTY 0x03                           // "It's dusty. It has not been used for a long time."
#define AOT_04_MESSAGE_NOTHING 0x04                         // "Nothing special."
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define IMDL_00_AMMO_HANDGUN 0x00

proc init
{
    door_aot_set(AOT_00_DOOR_406, 1600, 4400, 2400, 1500, 2, DOOR_SND_00_DR_WD, DOOR_21_DOOR15, 1, 0, ROOM_406_ROOM_002, 3100, 0, 3700, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_01_ITEM_AMMO_HANDGUN_0, 7000, 5600, 1000, 1500, IT_0B_AMMO_HANDGUN, 15, IMDL_00_AMMO_HANDGUN, SCA_NONE, 7550, -1650, 6850, 1024, F_ITEM_407_AMMO_HANDGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
    aot_set(AOT_02_MESSAGE_BATHTUB, 2300, 8700, 2800, 4000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_03_MESSAGE_DUSTY, 5600, 5400, 1500, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_04_MESSAGE_NOTHING, 6100, 8900, 1500, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_407_ZOMBIE_GROUNDSKEEPER_0, SPAWN_FORCE, 2, 0, 1528, 0, 7025, 0, 8632, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
}
