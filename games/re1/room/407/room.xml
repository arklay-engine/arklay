  <strings>
    <language lang="en-US">
      <string key="name">ROOM 002 BATHROOM</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">\nNo water is left.</string>
      <string key="1">It's dusty.It has not\nbeen used for a long time.</string>
      <string key="2">\nNothing special.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
      <string key="0">\n     少しの水も無い</string>
      <string key="1"> 長い間このままだったのだろう\n ほこりまみれになっている</string>
      <string key="2">\n     何もないようだ</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Poste de garde RdC</string>
      <string key="0">\nIl n'y a plus d'eau.</string>
      <string key="1">C'est poussiéreux. Ça n'a pas\nservi depuis longtemps.</string>
      <string key="2">\nRien de spécial.</string>
    </language>
    <language lang="de-DE">
      <string key="0">\nEs ist kein Wasser mehr da.</string>
      <string key="1">Es ist staubig. Es wurde\nschon lang nicht mehr benutzt.</string>
      <string key="2">\nNichts Besonderes.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Guardiola 1P</string>
      <string key="0">\nNon c'è più acqua.</string>
      <string key="1">È impolverato. Sembra non venga\nusato da tanto tempo.</string>
      <string key="2">\nNiente di speciale.</string>
    </language>
    <language lang="es-ES">
      <string key="0">\nNo queda agua...</string>
      <string key="1">Está cubierta de polvo...\nNo se ha usado en mucho tiempo.</string>
      <string key="2">\nNada especial...</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната охраны 1-эт.</string>
      <string key="0">\nВоды нет.</string>
      <string key="1">Всё в пыли.\nДавно не использовалось.</string>
      <string key="2">\nНичего особенного.</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Asuntolan varasto 1 krs</string>
      <string key="0">Amme on tyhjä...</string>
      <string key="1">Se on pölyinen. Sitä ei ole\nkäytetty pitkään aikaan...</string>
      <string key="2">Ei mitään erityistä...</string>
    </language>
