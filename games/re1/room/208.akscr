#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_NONE 0x03
#define ENEMY_00_ZOMBIE_LAB 0x00
#define F_ROOM_18 0x18
#define F_ROOM_19 0x19
#define F_ROOM_1A 0x1A

proc init
{
    door_aot_set(AOT_00_DOOR, 900, 3400, 1700, 1900, 2, 0, 0, 9, 0, ROOM_209_BEDROOM, 9100, 0, 7700, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 5700, 6400, 1400, 1200, 2, 0, 29, 5, 0, ROOM_207_2F_RIGHT_STAIRS, 17000, 0, 11300, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 10200, 4000, 1400, 1100, 1, 0, 0, 7, 0, ROOM_20A_STUDY_ROOM, 2600, 0, 5500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_03_NONE, 1000, 3900, 1100, 1200, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 0, 0, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_00, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_05, TRUE))
        {
            enemy(EM_11_ZOMBIE_LAB, 4, F_ENEMY_17, 1, 2, 0, 0, 3072, 0, 0, 6000, 0, 3300, ENEMY_00_ZOMBIE_LAB, 0, 0, 0);
        }
        else
        {
            if (ck(FG_ENEMY, F_ENEMY_14, FALSE))
            {
                aot_delete(AOT_00_DOOR, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_03_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            }
            else
            {
                require(ck(FG_ENEMY, F_ENEMY_13, FALSE));
                aot_delete(AOT_00_DOOR, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_03_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            }
            enemy(EM_11_ZOMBIE_LAB, 4, F_ENEMY_17, 1, 2, 0, 0, 0, 0, 0, 20000, 0, 20000, ENEMY_00_ZOMBIE_LAB, 0, 0, 0);
        }
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_00, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_18, FALSE) && ck(FG_SCENARIO, F_SCENARIO_05, FALSE))
        {
            evt_exec(0, 9, from_main);
            set(FG_ROOM, F_ROOM_18, TRUE);
        }
    }
}

event event_00
{
    run
    {
        aot_delete(AOT_00_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_03_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_SCENARIO, F_SCENARIO_05, TRUE);
        set(FG_ENEMY, F_ENEMY_17, TRUE);
        if (ck(FG_ENEMY, F_ENEMY_14, FALSE))
        {
            set(FG_ENEMY, F_ENEMY_14, TRUE);
            set(FG_ENEMY, F_ENEMY_17, FALSE);
            evt_exec(0, 9, event_01);
        }
        else
        {
            require(ck(FG_ENEMY, F_ENEMY_13, FALSE));
            set(FG_ENEMY, F_ENEMY_13, TRUE);
            set(FG_ENEMY, F_ENEMY_17, FALSE);
            evt_exec(0, 9, event_01);
        }
    }
    evt_finish();
}

event event_01
{
    evt_fork(9, event_03, 0);
    set(FG_6, F_6_17, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(38918, 31752, 6421);
    act_nop();
    act_param_set(0, 4);
    act_flag_op(0, 2, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    act_reset();
    evt_nop();
    se_play_3d(0, 0, 0, SND_AT_POINT, 0, 6400, 6300);
    set(FG_ROOM, F_ROOM_19, FALSE);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 14, 0 | 25, 0 | 1);
    act_param_set(0, 4);
    act_flag_op(0, 2, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_19, FALSE));
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, F_6_1D, TRUE);
        pos_set(ENEMY_00_ZOMBIE_LAB, 0, 1600, 0, 5900, 0, 6100);
        se_play_3d(0, 1, 0, SND_AT_POINT, 0, 6400, 6300);
        eml_state(0, ENEMY_00_ZOMBIE_LAB, EML_BEHAVIOUR, 0);
        cutnext(0);
        set(FG_ROOM, F_ROOM_1A, TRUE);
    }
    sleep(30);
    cutcurr(0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    set(FG_6, F_6_17, TRUE);
    evt_finish();
}

event from_main
{
    sleep(3);
    set(FG_6, F_6_1D, FALSE);
    evt_finish();
}

event event_03
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(147, 1, 0, 0, 16, 8);
    sleep(30);
    act_motion_bitclr();
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_1A, FALSE));
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    sleep(30);
    act_motion_bitclr();
    act_nop();
    act_finish();
}
