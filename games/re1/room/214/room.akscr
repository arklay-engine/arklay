#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_201 0x00
#define AOT_00_DOOR_213 0x00
#define AOT_01_DOOR_213 0x01
#define AOT_01_USEITEM_DOOR_201 0x01                        // Chris: the locked door to 201.
#define AOT_02_ITEM_HEAL_HERB_GREEN_0 0x02
#define AOT_03_ITEM_HEAL_HERB_BLUE_1 0x03
#define AOT_04_ITEM_HEAL_HERB_GREEN_2 0x04
#define AOT_05_USEITEM_DOOR_201 0x05                        // Jill: the door to 201, locked until F_SCENARIO_46.
#define ENEMY_00_ZOMBIE_GREEN 0x00
#define ENEMY_01_ZOMBIE_GREEN 0x01
#define ENEMY_02_ZOMBIE_GREEN 0x02
#define F_ROOM_DOOR_201_TRIED 0x18                          // The locked door to 201 was tried: play the "locked" sound and message.
#define IMDL_00_HEAL_HERB_GREEN 0x00
#define IMDL_01_HEAL_HERB_BLUE 0x01
#define IMDL_02_HEAL_HERB_GREEN 0x02
#define MSG_THE_DOOR_IS_LOCKED 0x00
#define SE_14 0x14

proc init when (MANSION2)
{
    if (CHRIS)
    {
        door_aot_set(AOT_00_DOOR_213, 22800, 5200, 2900, 1600, 0, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_213_FRONT_ELEVATOR, 2500, 0, 6600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        aot_set(AOT_01_USEITEM_DOOR_201, 10100, 25300, 1700, 2400, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER, 4, 0, 24, 0, 1, 0);
    }
    else
    {
        door_aot_set(AOT_00_DOOR_201, 10100, 25300, 1700, 2400, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_201_2F_LEFT_STAIRS, 15500, 0, 25400, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_01_DOOR_213, 22800, 5200, 2900, 1600, 0, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, ROOM_213_FRONT_ELEVATOR, 2500, 0, 6600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    item_aot_set(AOT_02_ITEM_HEAL_HERB_GREEN_0, 17200, 2000, 1900, 1900, IT_44_HEAL_HERB_GREEN, 1, IMDL_00_HEAL_HERB_GREEN, SCA_NONE, 18300, 0, 2700, 0, F_ITEM_214_HEAL_HERB_GREEN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_03_ITEM_HEAL_HERB_BLUE_1, 21500, 2000, 1900, 1900, IT_45_HEAL_HERB_BLUE, 1, IMDL_01_HEAL_HERB_BLUE, SCA_NONE, 22500, 0, 2700, 0, F_ITEM_214_HEAL_HERB_BLUE_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_04_ITEM_HEAL_HERB_GREEN_2, 19500, 2000, 1900, 1900, IT_44_HEAL_HERB_GREEN, 1, IMDL_02_HEAL_HERB_GREEN, SCA_NONE, 20500, 0, 2700, 0, F_ITEM_214_HEAL_HERB_GREEN_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    if (JILL)
    {
        aot_set(AOT_05_USEITEM_DOOR_201, 10100, 25300, 1700, 2400, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER, 4, 0, 24, 0, 1, 0);
    }
    enemy(EM_11_ZOMBIE_GREEN, EB_01, F_ENEMY_214_ZOMBIE_GREEN_0, SPAWN_FORCE, 2, 0, 3584, 0, 19100, 0, 3200, ENEMY_00_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
    enemy(EM_11_ZOMBIE_GREEN, EB_07, F_ENEMY_214_ZOMBIE_GREEN_1, SPAWN_FORCE, 2, 0, 1656, 0, 15900, 0, 28000, ENEMY_01_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
    enemy(EM_11_ZOMBIE_GREEN, EB_23, F_ENEMY_214_ZOMBIE_GREEN_2, SPAWN_FORCE, 2, 0, 768, 0, 15000, 0, 27600, ENEMY_02_ZOMBIE_GREEN, ANIM_00, 0, EVAR_00);
    if (JILL)
    {
        if (ck(FG_SCENARIO, F_SCENARIO_J_PASS_NUMBER_ENTERED, FALSE))
        {
            aot_delete(AOT_00_DOOR_201, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_05_USEITEM_DOOR_201, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
    }
    if (ck(FG_ENEMY, F_ENEMY_214_ZOMBIE_GREEN_2, TRUE))
    {
        eml_state(0, ENEMY_01_ZOMBIE_GREEN, EML_BEHAVIOUR, EB_00);
    }
}

proc main when (MANSION2)
{
    if (ck(FG_ROOM, F_ROOM_DOOR_201_TRIED, TRUE))
    {
        se_play_3d(SND_BANK_ROOM, SE_14, 0, SND_AT_POINT, 0, 11000, 25300);
        message(MSG_THE_DOOR_IS_LOCKED | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "The door is locked."
        set(FG_ROOM, F_ROOM_DOOR_201_TRIED, FALSE);
    }
}
