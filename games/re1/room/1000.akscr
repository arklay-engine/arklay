event event_39
{
    run
    {
        if (ck(FG_COMMON, 45, 0))
        {
            aot_on(6, SCE_ITEM, 0);
        }
        if (ck(FG_COMMON, 46, 0))
        {
            aot_on(7, SCE_ITEM, 0);
        }
        if (ck(FG_COMMON, 45, 1) && ck(FG_COMMON, 46, 1))
        {
            message(170, 79);
        }
    }
    sleep(1);
    run
    {
        if (ck(FG_COMMON, 45, 0))
        {
            if (ck(FG_ITEM, 23, 1))
            {
                set(FG_COMMON, 45, 1);
            }
        }
        if (ck(FG_COMMON, 46, 0))
        {
            if (ck(FG_ITEM, 24, 1))
            {
                set(FG_COMMON, 46, 1);
            }
        }
    }
    evt_finish();
}

