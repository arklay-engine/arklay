    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_ANIM_DONE, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        sleep(45);
    }
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
        else
        {
            cutnext(CAM_00);
        }
        cut_auto(CUT_FREE);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            aot_on(AOT_00_DOOR_50B, SCE_DOOR, 0);
        }
        else
        {
            pos_set(ENEMY_00_CHRIS, 0, 3072, 0, 5700, 0, 6800);
        }
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        sleep(45);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        run
        {
            eml_state(0, ENEMY_00_CHRIS, EML_08);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            aot_on(AOT_00_DOOR_50B, SCE_DOOR, 0);
        }
    }
    evt_finish();
}

