proc main
{
    if (cmpb(2, 0, 0))
    {
        snd_pan_vol_set(1, 110, 110);
    }
    if (cmpb(2, 0, 1))
    {
        snd_pan_vol_set(1, 50, 50);
    }
    if (cmpb(2, 0, 2))
    {
        snd_pan_vol_set(1, 50, 50);
    }
    if (cmpb(2, 0, 3))
    {
        snd_pan_vol_set(1, 50, 50);
    }
    if (ck(FG_COMMON, 169, 1))
    {
        if (testitem(ITEM_CHEMICAL))
        {
            if (ck(FG_ROOM, 32, 0))
            {
                evt_exec(0, 9, event_01);
            }
        }
    }
    if (ck(FG_SCENARIO, 91, 0))
    {
        if (ck(FG_SCENARIO, 92, 1))
        {
            set(FG_SCENARIO, 92, 0);
            evt_exec(0, 9, event_03);
        }
    }
}

event event_00
{
    run
    {
        set(FG_6, 23, 1);
        aot_reset(1, SCE_MESSAGE, 129, 129, 255, 0);
        message(0, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_ROOM, 0, 0);
    set(FG_6, 23, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_STATUS, 15, 0);
        set(FG_6, 23, 1);
    }
    sleep(10);
    run
    {
        cutnext(4);
        dir_set(0, 0, 0, 0, 0, 0, 0);
        effect_kill_b(19, 0, 0);
        effect_kill_b(27, 0, 0);
        effect(19, 8, 0, 3, 31, 38, 248, 56, 21, 0, 0);
        effect(27, 8, 0, 4, 31, 234, 247, 74, 21, 0, 0);
    }
    for (10)
    {
        model_op(0, 0, 0, 255, 2, 0, 0);
        sleep(8);
    }
    evt_nop();
    sleep(30);
    dir_set(0, 0, 3100, 0, 16200, 0, 4900);
    cutnext(1);
    sleep(50);
    run
    {
        eml_state(0, 0, 0, 40);
        eml_state(0, 1, 0, 41);
        eml_state(0, 2, 0, 40);
        eml_state(0, 3, 0, 40);
        eml_state(0, 4, 0, 40);
        eml_state(0, 5, 0, 40);
    }
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(47110, 9252, 8467);
    act_nop();
    act_reset();
    evt_nop();
    sleep(150);
    cutnext(2);
    run
    {
        eml_state(0, 0, 0, 64);
        eml_state(0, 1, 0, 64);
        eml_state(0, 2, 0, 64);
        eml_state(0, 3, 0, 64);
        eml_state(0, 4, 0, 64);
        eml_state(0, 5, 0, 64);
    }
    sleep(150);
    cutnext(0);
    sleep(10);
    run
    {
        set(FG_COMMON, 169, 0);
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event event_02
{
    evt_work_set(WK_AOT, 0);
    evt_tween_begin_alt();
    tw_abs_rot(0, 1010, 20, 1130);
    tw_end();
    evt_nop();
    evt_finish();
}

