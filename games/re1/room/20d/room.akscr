event from_main_2_sub3 when (MANSION1)
{
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_RICHARD);
    evt_actor_begin();
    if (CHRIS)
    {
        act_motion_path(MOTION_13, 4012, 2500, 3200, 25, 25);
        sleep(30);
        act_motion_path(MOTION_13, 4012, 2000, 3200, 25, 25);
        sleep(30);
        act_motion_path(MOTION_13, 4012, 200, 3200, 25, 25);
        act_anim_flags(ANIM_01, F_ROOM_23, 0);
    }
    else
    {
        act_motion_path(MOTION_13, 4012, 8000, 2200, 25, 25);
        sleep(26);
        act_anim_flags(ANIM_01, F_ROOM_22, 0);
    }
    act_flag_op(EF_SET, EF_0002);
    sleep(26);
    act_action_b(15);
    if (CHRIS)
    {
        act_flag_op(EF_SET, EF_0001);
    }
    else
    {
        act_flag_op(EF_SET, EF_0080 | EF_0001);
    }
    sleep(18);
    act_action_b(17);
    if (CHRIS)
    {
        act_flag_op(EF_SET, 0);
    }
    else
    {
        act_flag_op(EF_SET, EF_0080);
    }
    sleep(8);
    act_action_b(20);
    if (CHRIS)
    {
        act_flag_op(EF_SET, EF_0001);
    }
    else
    {
        act_flag_op(EF_SET, EF_0080 | EF_0001);
    }
    sleep(8);
    if (CHRIS)
    {
        act_action_b(17);
        act_flag_op(EF_SET, 0);
        sleep(2);
        act_action_b(23);
        act_flag_op(EF_SET, EF_0001);
        sleep(2);
    }
    else
    {
        act_action_b(16);
        act_flag_op(EF_SET, EF_0080);
        sleep(16);
    }
    act_action_b(17);
    if (JILL)
    {
        act_flag_op(EF_SET, EF_0080 | EF_0001);
        sleep(18);
        act_action_b(10);
        act_flag_op(EF_SET, EF_0080 | EF_0001);
        sleep(26);
        act_action_b(22);
    }
    act_flag_op(EF_SET, 0);
    if (JILL)
    {
        sleep(16);
    }
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        wait_message();
        single(12) effect(FX_00, FX_ROW_05, FX_AT_WORLD, 8900, -300, 3800, 0);
        sleep(10);
        single(12) effect(FX_00, FX_ROW_05, FX_AT_WORLD, 8900, -300, 3800, 0);
        sleep(5);
        single(12) effect(FX_00, FX_ROW_05, FX_AT_WORLD, 8900, -300, 3800, 0);
        sleep(1);
        single(12) effect(FX_00, FX_ROW_05, FX_AT_WORLD, 9000, -400, 3600, 0);
        evt_fork(TASK_05, from_main_2_sub3_sub1, 0);
    }
    else
    {
        evt_fork(TASK_03, from_main_3_sub1_sub1, 0);
    }
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_RICHARD);
    evt_actor_begin();
    act_motion_path(MOTION_31, 300, 100, 0, 50, 50);
    if (CHRIS)
    {
        act_anim_flags(ANIM_01, F_ROOM_23, 0);
    }
    else
    {
        act_anim_flags(ANIM_01, F_ROOM_22, 0);
    }
    act_flag_op(EF_SET, EF_0002 | EF_0001);
    sleep(16);
    act_action_b(25);
    act_flag_op(EF_SET, 0);
    act_motion_path(MOTION_33, 300, 100, 0, 50, 50);
    sleep(4);
    act_motion_path(MOTION_33, 280, 90, 0, 50, 50);
    sleep(4);
    act_motion_path(MOTION_33, 320, 120, 0, 50, 50);
    sleep(4);
    act_motion_path(MOTION_33, 300, 100, 0, 50, 50);
    sleep(4);
    act_motion_path(MOTION_33, 340, 140, 0, 50, 50);
    sleep(4);
    act_motion_path(MOTION_33, 320, 120, 0, 50, 50);
    sleep(4);
    act_motion_path(MOTION_33, 360, 160, 0, 50, 50);
    sleep(4);
    act_motion_path(MOTION_33, 340, 140, 0, 30, 30);
    sleep(4);
    act_motion_path(MOTION_33, 540, -180, 0, 30, 30);
    if (CHRIS)
    {
        sleep(60);
        act_motion_path(MOTION_33, 540, -60, 0, 20, 20);
        sleep(10);
        act_motion_path(MOTION_33, 540, 60, 0, 20, 20);
        sleep(10);
        act_motion_path(MOTION_33, 540, -60, 0, 20, 20);
        sleep(10);
        act_motion_path(MOTION_33, 540, 60, 0, 20, 20);
        sleep(40);
    }
    else
    {
        sleep(170);
    }
    act_motion_path(MOTION_33, 0, 0, 0, 50, 50);
    act_motion(MOTION_10);
    act_flag_op(EF_SET, 0);
    if (CHRIS)
    {
        act_anim_flags(ANIM_02, F_ROOM_23, 0);
    }
    else
    {
        act_anim_flags(ANIM_02, F_ROOM_22, 0);
    }
    act_reset();
    evt_nop();
    sleep(10);
    evt_finish();
}

event on_aot_04_4 when (MANSION1)
{
    run
    {
        cut_auto(CUT_LOCKED);
        cutnext(CAM_04);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        dir_set(0, 0, 3465, 0, 8000, 0, 2440);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_21, 0);
    sleep(26);
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_COMMON, F_COMMON_65, FALSE))
        {
            bgm_play(BGM_MAIN);
            set(FG_COMMON, F_COMMON_65, TRUE);
        }
        if (CHRIS)
        {
            message(MSG_RICHARD_IS_DEAD_17 | MSG_FAST, 0); // "Richard is dead."
        }
        else
        {
            message(MSG_RICHARD_FROM_BRAVO_TEAM_0C | MSG_FAST, 0); // "Richard from Bravo team."
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_71, 300, 128, 2, 23, 23);
    sleep(75);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_21, 0);
    act_flag_op(EF_OR, EF_0001);
    sleep(25);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        cutnext(CAM_03);
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_reset(AOT_02_ITEM, SCE_ITEM, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 1, 0, 0);
        aot_reset(AOT_04_EVENT, SCE_NONE, 0, 0, 0, 0);
    }
    evt_finish();
}

