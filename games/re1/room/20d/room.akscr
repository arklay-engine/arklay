proc init
{
    door_aot_set(AOT_00_DOOR, 1300, 12900, 3400, 2000, 3, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 7, 0, ROOM_204_C_PASSAGE, 12500, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 12000, 1100, 2300, 3100, 2, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_20E_FRONT_OF_ATTIC, 2700, 0, 2900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_ITEM, F_ITEM_28, TRUE))
    {
        if (MANSION1)
        {
            item_aot_set(AOT_02_ITEM, 7500, 2500, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 10, 0, 10, 0, F_ITEM_28, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
            aot_reset(AOT_02_ITEM, SCE_NONE, 0, 0, 0, 0);
        }
        else
        {
            item_aot_set(ITEM_ALT_ROT | AOT_02_ITEM, 7500, 2500, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 8300, 0, 3600, 0, F_ITEM_28, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
    }
    if (ck(FG_ITEM, F_ITEM_C5, TRUE))
    {
        item_aot_set(AOT_03_ITEM, 5800, 6000, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_01, SCA_NONE, 6700, 0, 6900, 0, F_ITEM_C5, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    }
    if (MANSION1)
    {
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_24, TRUE) && ck(FG_COMMON, F_COMMON_62, FALSE))
            {
                set(FG_COMMON, F_COMMON_61, TRUE);
            }
        }
        if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, FALSE))
        {
            if (item_ck(IT_42_KEY_SERUM))
            {
                if (cmpw(0, W_04, CMP_LE, 420))
                {
                    set(FG_COMMON, F_COMMON_63, TRUE);
                    set(FG_COMMON, F_COMMON_64, FALSE);
                    room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 1);
                    if (CHRIS)
                    {
                        aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_3, 0, 0, 0);
                    }
                    else
                    {
                        aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_2_jill_mansion1, 0, 0, 0);
                    }
                }
                else
                {
                    set(FG_COMMON, F_COMMON_63, FALSE);
                    set(FG_COMMON, F_COMMON_64, TRUE);
                    set(FG_SCENARIO, F_SCENARIO_49, TRUE);
                }
            }
            else if (cmpw(0, W_04, CMP_LE, 420))
            {
                set(FG_COMMON, F_COMMON_63, FALSE);
                set(FG_COMMON, F_COMMON_64, FALSE);
                if (CHRIS)
                {
                    aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, on_aot_04_2, 0, 0, 0);
                }
                else
                {
                    aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, on_aot_04_3_jill_mansion1, 0, 0, 0);
                }
            }
            else
            {
                set(FG_COMMON, F_COMMON_63, FALSE);
                set(FG_COMMON, F_COMMON_64, TRUE);
                set(FG_SCENARIO, F_SCENARIO_49, TRUE);
            }
        }
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_61, TRUE))
            {
                enemy(EM_27_NPC_RICHARD, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, ANIM_02, 39, EVAR_00);
                if (ck(FG_COMMON, F_COMMON_63, TRUE) && ck(FG_COMMON, F_COMMON_66, FALSE))
                {
                    enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2560, 0, 9850, 0, 3000, ENEMY_01_NPC_REBECCA, ANIM_3D, 0, EVAR_01);
                    aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_3, 0, 0, 0);
                }
                else if (ck(FG_ITEM, F_ITEM_28, TRUE))
                {
                    aot_set(AOT_04_EVENT, 7400, 2700, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04, 0, 0, 0);
                }
                if (ck(FG_COMMON, F_COMMON_65, FALSE))
                {
                    room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
                }
                else
                {
                    room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_MAIN_ON | 3);
                }
            }
            else if (ck(FG_COMMON, F_COMMON_64, TRUE))
            {
                room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
                aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_4, 0, 0, 0);
                enemy(EM_27_NPC_RICHARD, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, ANIM_02, 39, EVAR_00);
            }
            else
            {
                enemy(EM_27_NPC_RICHARD, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, ANIM_01, 0, EVAR_00);
                enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2560, 0, 9850, 0, 3000, ENEMY_01_NPC_REBECCA, ANIM_3D, 0, EVAR_01);
            }
            if (ck(FG_COMMON, F_COMMON_5F, TRUE) && ck(FG_COMMON, F_COMMON_5E, FALSE))
            {
                if (item_ck(IT_42_KEY_SERUM))
                {
                    aot_reset(AOT_01_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, on_aot_01_door, 0);
                }
                else
                {
                    set(FG_COMMON, F_COMMON_5F, TRUE);
                    aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 148, 127, 0);
                }
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_61, TRUE))
            {
                if (ck(FG_ITEM, F_ITEM_28, TRUE))
                {
                    aot_set(AOT_04_EVENT, 7400, 2700, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04_4, 0, 0, 0);
                }
                enemy(EM_27_NPC_RICHARD, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, ANIM_02, 39, EVAR_00);
                if (ck(FG_COMMON, F_COMMON_65, FALSE))
                {
                    room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
                }
                else
                {
                    room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_MAIN_ON | 3);
                }
            }
            else if (ck(FG_COMMON, F_COMMON_64, TRUE))
            {
                aot_set(AOT_04_EVENT, 7500, 2500, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 7, 0, on_aot_04_4_jill_mansion1, 0, 0, 0);
                enemy(EM_27_NPC_RICHARD, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, ANIM_02, 39, EVAR_00);
                room_bgm_state_set(1, ROOM_20D_PILLAR_PASSAGE, BGM_RELOAD | 2);
            }
            else
            {
                enemy(EM_27_NPC_RICHARD, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 8300, 0, 3600, ENEMY_00_NPC_RICHARD, ANIM_01, 0, EVAR_00);
            }
        }
    }
    if (ck(FG_ITEM, F_ITEM_C6, TRUE))
    {
        if (MANSION1)
        {
            item_aot_set(AOT_05_ITEM, 4100, 6000, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_02, SCA_NONE, 5000, 0, 6900, 0, F_ITEM_C6, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        else
        {
            item_aot_set(AOT_04_ITEM, 4100, 6000, 1800, 1800, IT_44_HEAL_HERB_GREEN, 1, IMDL_02, SCA_NONE, 5000, 0, 6900, 0, F_ITEM_C6, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
    }
}

proc main when (CHRIS && MANSION1)
{
    if (ck(FG_COMMON, F_COMMON_5F, TRUE) && ck(FG_SCENARIO, F_SCENARIO_4E, FALSE))
    {
        set(FG_SCENARIO, F_SCENARIO_4E, TRUE);
        set(FG_STATUS, F_STATUS_16, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_61, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_00, FALSE) && ck(FG_COMMON, F_COMMON_64, FALSE))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
            evt_exec(0, TASK_01, from_main_3);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03) && ck(FG_ROOM, F_ROOM_01, FALSE))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
            if (ck(FG_COMMON, F_COMMON_62, FALSE) && ck(FG_COMMON, F_COMMON_63, FALSE) && ck(FG_COMMON, F_COMMON_64, FALSE))
            {
                set(FG_COMMON, F_COMMON_62, TRUE);
                set(FG_RUN, F_RUN_CONTROLS, FALSE);
                set(FG_STATUS, F_STATUS_0F, TRUE);
                set(FG_COMMON, F_COMMON_2D, TRUE);
                cut_auto(CUT_LOCKED);
                cutnext(CAM_04);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, TASK_00, from_main);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_63, TRUE) && ck(FG_COMMON, F_COMMON_64, FALSE))
            {
                set(FG_COMMON, F_COMMON_61, TRUE);
                set(FG_RUN, F_RUN_CONTROLS, FALSE);
                set(FG_STATUS, F_STATUS_0F, TRUE);
                cut_auto(CUT_LOCKED);
                cutnext(CAM_05);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, TASK_00, from_main_2);
                remove_item(IT_42_KEY_SERUM);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_63, FALSE) && ck(FG_COMMON, F_COMMON_64, TRUE))
            {
                set(FG_COMMON, F_COMMON_61, TRUE);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, FALSE))
            {
                aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 148, 127, 0);
            }
        }
    }
    if (ck(FG_STATUS, F_STATUS_16, FALSE) && ck(FG_ROOM, F_ROOM_03, TRUE))
    {
        set(FG_RUN, F_RUN_18, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
    }
    if (ck(FG_STATUS, F_STATUS_16, FALSE) && ck(FG_ROOM, F_ROOM_02, TRUE))
    {
        set(FG_ROOM, F_ROOM_03, TRUE);
    }
    if (ck(FG_STATUS, F_STATUS_16, TRUE))
    {
        set(FG_ROOM, F_ROOM_02, TRUE);
    }
}

proc main when (JILL && MANSION1)
{
    if (ck(FG_COMMON, F_COMMON_61, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_00, FALSE) && ck(FG_COMMON, F_COMMON_64, FALSE))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
            evt_exec(0, TASK_01, from_main_jill_mansion1);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03) && ck(FG_ROOM, F_ROOM_01, FALSE))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
            if (ck(FG_COMMON, F_COMMON_62, FALSE) && ck(FG_COMMON, F_COMMON_63, FALSE) && ck(FG_COMMON, F_COMMON_64, FALSE))
            {
                set(FG_COMMON, F_COMMON_62, TRUE);
                set(FG_RUN, F_RUN_CONTROLS, FALSE);
                set(FG_STATUS, F_STATUS_0F, TRUE);
                set(FG_COMMON, F_COMMON_23, TRUE);
                cut_auto(CUT_LOCKED);
                cutnext(CAM_04);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, TASK_00, from_main_2_jill_mansion1);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_63, TRUE) && ck(FG_COMMON, F_COMMON_64, FALSE))
            {
                set(FG_COMMON, F_COMMON_61, TRUE);
                set(FG_RUN, F_RUN_CONTROLS, FALSE);
                set(FG_STATUS, F_STATUS_0F, TRUE);
                cut_auto(CUT_LOCKED);
                cutnext(CAM_05);
                dir_set(0, 0, 472, 0, 5596, 0, 3804);
                evt_exec(0, TASK_00, from_main_3_jill_mansion1);
                remove_item(IT_42_KEY_SERUM);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_63, FALSE) && ck(FG_COMMON, F_COMMON_64, TRUE))
            {
                set(FG_COMMON, F_COMMON_61, TRUE);
            }
            if (ck(FG_COMMON, F_COMMON_62, TRUE) && ck(FG_COMMON, F_COMMON_61, FALSE))
            {
                aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 143, 127, 0);
            }
        }
    }
}

event from_main when (CHRIS && MANSION1)
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 9900, -800, 3050, 0, 0);
    act_anim_flags(ANIM_20, F_ROOM_21, 0);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(MOTION_72, 2300, 300, 1, 20, 20);
    sleep(5);
    act_motion_path(MOTION_13, 3990, -4000, 2930, 50, 50);
    sleep(20);
    act_reset();
    evt_nop();
    voice_play(VOICE_PLAY, VO_005_00);
    message(MSG_VO_005_00, 0);
    wait_message();
    run
    {
        cutnext(CAM_03);
        voice_play(VOICE_PLAY, VO_005_01);
        message(MSG_VO_005_01, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_21, 0);
    sleep(15);
    act_anim_flags(ANIM_21, F_ROOM_21, 0);
    sleep(32);
    act_anim_flags(ANIM_23, F_ROOM_21, 0);
    sleep(11);
    act_anim_flags(ANIM_24, F_ROOM_21, 0);
    sleep(8);
    act_anim_flags(ANIM_21, F_ROOM_21, 0);
    sleep(4);
    act_anim_flags(ANIM_23, F_ROOM_21, 0);
    sleep(5);
    act_anim_flags(ANIM_21, F_ROOM_21, 0);
    sleep(4);
    act_anim_flags(ANIM_23, F_ROOM_21, 0);
    sleep(4);
    act_anim_flags(ANIM_21, F_ROOM_21, 0);
    sleep(7);
    act_anim_flags(ANIM_24, F_ROOM_21, 0);
    sleep(23);
    act_anim_flags(ANIM_25, F_ROOM_21, 0);
    sleep(14);
    act_motion_path(MOTION_13, 10000, -800, 4100, 28, 28);
    act_reset();
    evt_nop();
    wait_message();
    bgm_play(BGM_MAIN);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_21, 0);
    sleep(15);
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(MOTION_13, 7380, -4000, 2440, 32, 32);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_03, 7380, 2440, F_ROOM_21);
    act_nop();
    act_param_set(0, 32);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    act_anim_seq(AB_06, 8300, 3600, F_ROOM_21);
    act_nop();
    act_param_set(0, 64);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    act_reset();
    evt_nop();
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(MOTION_13, 7380, -400, 2440, 32, 32);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_21, 0);
    act_reset();
    evt_nop();
    cutnext(CAM_05);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 11000, -800, 5000, 20, 20);
    act_reset();
    evt_nop();
    wait_message();
    evt_fork(TASK_02, from_main_sub1, 0);
    voice_play(VOICE_PLAY, VO_005_02);
    message(MSG_VO_005_02, 0);
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_REBECCA);
    evt_actor_begin();
    act_motion_path(MOTION_13, 8200, 0, 5000, 32, 32);
    act_reset();
    evt_nop();
    sleep(130);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
