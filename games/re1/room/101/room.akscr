event on_aot_05_message_2 when (CHRIS && MANSION2)
{
    run
    {
        bgm_play(BGM_MAIN);
        cutnext(CAM_05);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_COMMON, F_COMMON_31, FALSE);
        set(FG_COMMON, F_COMMON_35, TRUE);
        aot_delete(AOT_05_MESSAGE, SCE_NONE, 0);
        dir_set(0, 0, 592, 0, 12132, 0, 4876);
    }
    sleep(1);
    evt_fork(TASK_09, on_aot_05_message_2_sub1, 0);
    voice_play(VOICE_PLAY, VO_00C_10);
    wait_message();
    sleep(230);
    run
    {
        aot_reset(AOT_05_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 139, 255, 0);
        cutnext(CAM_04);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

