event mourn_rebecca
{
    run
    {
        bgm_play(BGM_MAIN);
        cutnext(CAM_05_REBECCA);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_COMMON, F_COMMON_C_REBECCA_SAVED_TALK, FALSE);
        set(FG_COMMON, F_COMMON_C_REBECCA_BODY_EXAMINED, TRUE);
        aot_delete(AOT_05_MESSAGE_REBECCA, SCE_NONE, 0);
        dir_set(0, 0, 592, 0, 12132, 0, 4876);
    }
    sleep(1);
    evt_fork(TASK_09, mourn_rebecca_chris, 0);
    voice_play(VOICE_PLAY, VO_00C_10);
    wait_message();
    sleep(230);
    run
    {
        aot_reset(AOT_05_MESSAGE_REBECCA, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 139, 255, 0);
        cutnext(CAM_04);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event mourn_rebecca_chris
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_37, F_ROOM_ANIM_DONE, 0);
    sleep(202);
    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_00_REBECCA, 0, 0, 0);
    act_reset();
    evt_nop();
    sys_multi(SYS_FORCE_ACTION);
    sleep(70);
    evt_actor_begin();
    act_nop();
    act_anim_flags(ANIM_09, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0080 | EF_0001);
    sleep(52);
    act_motion(MOTION_10);
    act_idle();
    act_finish();
}

event rebecca_ill_do_my_best
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    evt_fork(TASK_09, rebecca_ill_do_my_best_rebecca, 0);
    voice_play(VOICE_PLAY, VO_007_0D_63);
    message(MSG_VO_007_0D_63, 0);
    wait_message();
    set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

event rebecca_ill_do_my_best_rebecca
{
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_0A, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0080);
    sleep(80);
    act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_finish();
}

event rebecca_hunter_attack_hit
{
    sleep(8);
    se_play_3d(SND_BANK_ROOM, SE_0B, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
    single(10) effect(FX_00, FX_ROW_00, FX_AT_WORLD, 13096, -1000, 0, 0);
    raw(0x48, 0x0B, 0x00, 0x04, 0xFF, 0x00);
}

event rebecca_hunter_attack_footsteps
{
    for (5)
    {
        se_play_3d(SND_BANK_ROOM, SE_0F, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
        sleep(18);
        se_play_3d(SND_BANK_ROOM, SE_0F, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
        sleep(13);
    }
    evt_nop();
    se_play_3d(SND_BANK_ROOM, SE_0F, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
    sleep(60);
    for (6)
    {
        se_play_3d(SND_BANK_ROOM, SE_0F, 0, SND_AT_ENEMY, ENEMY_00_REBECCA, 0, 0);
        sleep(14);
    }
    evt_nop();
    evt_finish();
}

event hunter_dead_stop_music
{
    sleep(1);
    bgm_stop(BGM_MAIN);
    evt_finish();
}
