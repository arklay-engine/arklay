{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE, 0);
    sleep(30);
    act_anim_flags(ANIM_24, F_ROOM_ANIM_DONE, 0);
    sleep(30);
