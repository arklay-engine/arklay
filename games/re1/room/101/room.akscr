#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_100 0x00
#define AOT_01_DOOR_102 0x01
#define AOT_02_DOOR_103 0x02
#define AOT_03_DOOR_201 0x03
#define AOT_05_MESSAGE_REBECCA 0x05                         // Rebecca's spot: her body's "........." or her talk event.
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05_REBECCA 0x05
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_REBECCA 0x00
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_HUNTER 0x01
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define ENEMY_02_HUNTER 0x02
#define ENEMY_02_ZOMBIE_GROUNDSKEEPER 0x02
#define FX_00 0x00
#define F_ROOM_ANIM_DONE 0x3F                               // Raised when an actor's animation ends (one frame); nothing waits for it.
#define F_ROOM_C_ATTACK_AT_CAM_03 0x1E                      // The hunter attack on Rebecca starts when Chris reaches camera 3.
#define F_ROOM_C_HUNTER_ANIM_DONE 0x3E                      // The hunter's animation finished (one frame); nothing waits for it.
#define F_ROOM_C_MOURN_ON_KILL 0x1C                         // Rebecca is dead: when the hunter dies, her body's spot becomes Chris's mourning event.
#define F_ROOM_C_SAVE_ON_KILL 0x1D                          // When the hunter dies, Rebecca counts as saved and her talk spot opens.
#define F_ROOM_C_STOP_MUSIC_ON_KILL 0x1B                    // When the hunter dies, main fades out the attack music.
#define MSG_VO_007_0D_63 0x0A
#define MSG_VO_00C_12 0x00
#define MSG_VO_00C_13 0x01
#define MSG_VO_00C_14 0x02
#define MSG_VO_00C_15 0x03
#define MSG_VO_00C_16 0x04
#define MSG_VO_00C_18 0x05
#define MSG_VO_00C_19 0x06
#define MSG_VO_00C_1A 0x07
#define MSG_VO_00C_1B 0x08
#define MSG_VO_00C_1C 0x09
#define SE_0B 0x0B
#define SE_0F 0x0F
#define VO_007_0D_63 0x63
#define VO_00C_10 0x56
#define VO_00C_11 0x57
#define VO_00C_12 0x58
#define VO_00C_13 0x59
#define VO_00C_14 0x5A
#define VO_00C_15 0x5B
#define VO_00C_16 0x5C
#define VO_00C_18 0x5E
#define VO_00C_19 0x5F
#define VO_00C_1A 0x60
#define VO_00C_1B 0x61
#define VO_00C_1C 0x62

proc init
{
    door_aot_set(AOT_00_DOOR_100, 7600, 7700, 2400, 1500, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_102, 14000, 17200, 2000, 1500, 2, DOOR_SND_00_DR_WD, DOOR_1D_DOOR01K, 5, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_101_102, ROOM_102_VACANT_ROOM, 3400, 0, 9200, 1024, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR_103, 19400, 19000, 2000, 2700, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_103_F_PASSAGE, 2400, 0, 24800, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR_201, 4700, 2500, 2605, 1300, 0, DOOR_SND_05_ST_WD, DOOR_18_KAI02, 96, 0, STAGE_2 | ROOM_201_2F_LEFT_STAIRS, 14100, 0, 11500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (MANSION1)
    {
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_08, F_ENEMY_101_ZOMBIE_GROUNDSKEEPER_0, SPAWN_FORCE, 2, 0, 3136, 0, 9520, 0, 19044, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_04, F_ENEMY_101_ZOMBIE_GROUNDSKEEPER_1, SPAWN_FORCE, 2, 0, 288, 0, 2805, 0, 13359, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_08, F_ENEMY_101_ZOMBIE_GROUNDSKEEPER_2, SPAWN_FORCE, 2, 0, 2144, 0, 13096, 0, 7312, ENEMY_02_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            set(FG_COMMON, F_COMMON_C_REBECCA_OFFERED_HELP, FALSE);
        }
    }
    else
    {
        room_bgm_state_set(5, 1, BGM_OFF);
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_CALL_IN_TIME, FALSE) && ck(FG_COMMON, F_COMMON_C_REBECCA_CALL_TOO_LATE, FALSE))
            {
                if (cmpw(0, W_04, CMP_GT, 180))
                {
                    set(FG_COMMON, F_COMMON_C_REBECCA_CALL_TOO_LATE, TRUE);
                }
                else
                {
                    set(FG_COMMON, F_COMMON_C_REBECCA_CALL_IN_TIME, TRUE);
                }
            }
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_KILLED, TRUE))
            {
                room_bgm_state_set(5, 1, BGM_RELOAD);
                enemy(EM_2C_NPC_REBECCA_2, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2576, 0, 13096, 0, 2888, ENEMY_00_REBECCA, ANIM_04, 29, EVAR_00);
                aot_set(AOT_05_MESSAGE_REBECCA, 12569, 2380, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 139, 0, 255, 0, 0, 0);
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_BODY_EXAMINED, FALSE))
                {
                    set(FG_ROOM, F_ROOM_C_MOURN_ON_KILL, TRUE);
                }
                enemy(EM_06_HUNTER, EB_27, F_ENEMY_101_HUNTER_0, SPAWN_FORCE, 2, 0, 608, 0, 7874, 0, 7822, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
            }
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_SAVED_TALK, TRUE))
            {
                room_bgm_state_set(5, 1, BGM_RELOAD | 1);
                enemy(EM_2C_NPC_REBECCA_2, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2385, 0, 13096, 0, 2888, ENEMY_00_REBECCA, ANIM_31, 1, EVAR_00);
                aot_set(AOT_05_MESSAGE_REBECCA, 12569, 2380, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, rebecca_saved_talk, 0, 0, 0);
            }
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_IN_SAVE_ROOM, TRUE) && ck(FG_COMMON, F_COMMON_C_REBECCA_101_ATTACK_OVER, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_CALL_TOO_LATE, TRUE))
                {
                    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
                    set(FG_ROOM, F_ROOM_C_ATTACK_AT_CAM_03, TRUE);
                    set(FG_ROOM, F_ROOM_C_SAVE_ON_KILL, TRUE);
                    room_bgm_state_set(5, 1, BGM_RELOAD | 1);
                    enemy(EM_2C_NPC_REBECCA_2, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 2385, 0, 9329, 0, 6214, ENEMY_00_REBECCA, ANIM_31, 59, EVAR_00);
                    aot_set(AOT_05_MESSAGE_REBECCA, 12000, 2650, 1800, 1800, SCE_MESSAGE, 0, 139, 0, 255, 0, 0, 0);
                    enemy(EM_06_HUNTER, EB_67, F_ENEMY_101_HUNTER_0, SPAWN_FORCE, 2, 0, 608, 0, 7874, 0, 7822, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
                }
                else
                {
                    enemy(EM_06_HUNTER, EB_17, F_ENEMY_101_HUNTER_0, SPAWN_FORCE, 2, 0, 3000, 0, 4067, 0, 17454, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
                    enemy(EM_06_HUNTER, EB_17, F_ENEMY_101_HUNTER_1, SPAWN_FORCE, 2, 0, 2664, 0, 12480, 0, 3562, ENEMY_02_HUNTER, ANIM_00, 0, EVAR_00);
                }
            }
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_IN_SAVE_ROOM, FALSE))
            {
                enemy(EM_06_HUNTER, EB_17, F_ENEMY_101_HUNTER_0, SPAWN_FORCE, 2, 0, 3000, 0, 4067, 0, 17454, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
                enemy(EM_06_HUNTER, EB_17, F_ENEMY_101_HUNTER_1, SPAWN_FORCE, 2, 0, 2664, 0, 12480, 0, 3562, ENEMY_02_HUNTER, ANIM_00, 0, EVAR_00);
            }
        }
        else
        {
            enemy(EM_06_HUNTER, EB_17, F_ENEMY_101_HUNTER_0, SPAWN_FORCE, 2, 0, 3000, 0, 4067, 0, 17454, ENEMY_00_HUNTER, ANIM_00, 0, EVAR_00);
            enemy(EM_06_HUNTER, EB_17, F_ENEMY_101_HUNTER_1, SPAWN_FORCE, 2, 0, 2664, 0, 12480, 0, 3562, ENEMY_01_HUNTER, ANIM_00, 0, EVAR_00);
        }
    }
}

proc main
{
    if (CHRIS && MANSION2)
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03) && ck(FG_ROOM, F_ROOM_C_ATTACK_AT_CAM_03, TRUE))
        {
            set(FG_ROOM, F_ROOM_C_ATTACK_AT_CAM_03, FALSE);
            set(FG_STATUS, F_STATUS_CAMERA_DEFER, FALSE);
            cutnext(CAM_04);
            evt_exec(0, TASK_09, rebecca_hunter_attack);
        }
        if (ck(FG_ENEMY, F_ENEMY_101_HUNTER_0, TRUE) && ck(FG_ROOM, F_ROOM_C_SAVE_ON_KILL, TRUE))
        {
            set(FG_ROOM, F_ROOM_C_SAVE_ON_KILL, FALSE);
            set(FG_COMMON, F_COMMON_C_REBECCA_UNDER_ATTACK, FALSE);
            set(FG_COMMON, F_COMMON_C_REBECCA_SAVED_TALK, TRUE);
            aot_reset(AOT_05_MESSAGE_REBECCA, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, rebecca_saved_talk, 0);
        }
        if (ck(FG_ENEMY, F_ENEMY_101_HUNTER_0, TRUE) && ck(FG_ROOM, F_ROOM_C_MOURN_ON_KILL, TRUE))
        {
            set(FG_ROOM, F_ROOM_C_MOURN_ON_KILL, FALSE);
            aot_reset(AOT_05_MESSAGE_REBECCA, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, mourn_rebecca, 0);
        }
        if (ck(FG_ENEMY, F_ENEMY_101_HUNTER_0, TRUE) && ck(FG_ROOM, F_ROOM_C_STOP_MUSIC_ON_KILL, TRUE))
        {
            set(FG_ROOM, F_ROOM_C_STOP_MUSIC_ON_KILL, FALSE);
            bgm_volume_ramp(BGM_MAIN, -96, 1);
            evt_exec(0, TASK_09, hunter_dead_stop_music);
        }
    }
}

event rebecca_hunter_attack
{
    run
    {
        set(FG_ROOM, F_ROOM_C_STOP_MUSIC_ON_KILL, TRUE);
        bgm_play(BGM_MAIN);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_COMMON, F_COMMON_C_REBECCA_UNDER_ATTACK, TRUE);
        set(FG_COMMON, F_COMMON_C_REBECCA_101_ATTACK_OVER, TRUE);
        dir_set(0, 0, 272, 0, 2744, 0, 7000);
        pos_set(ENEMY_01_HUNTER, 0, 256, 0, 4219, 0, 7747);
    }
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_fork(TASK_09, rebecca_hunter_attack_rebecca, 0);
    evt_fork(TASK_09, rebecca_hunter_attack_hunter, 0);
    evt_fork(TASK_09, rebecca_hunter_attack_footsteps, 0);
    sleep(100);
    cutnext(CAM_05_REBECCA);
    sleep(200);
    evt_fork(TASK_09, rebecca_hunter_attack_chris, 0);
    voice_play(VOICE_PLAY, VO_00C_11);
    wait_message();
    evt_fork(TASK_09, rebecca_hunter_attack_hunter_slash, 0);
    sleep(40);
    run
    {
        pos_set(ENEMY_01_HUNTER, 0, 2432, 0, 7860, 0, 5845);
        cutnext(CAM_03);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, EB_00);
    evt_finish();
}

event rebecca_hunter_attack_rebecca
{
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_31, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_tween_begin_alt();
    tw_set_pos(10, 0, -20);
    for (100)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    pos_set(ENEMY_00_REBECCA, 0, 2688, 0, 11405, 0, 5254);
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_tween_begin_alt();
    tw_set_pos(10, 0, -30);
    for (70)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_actor_begin();
    act_nop();
    act_anim_flags(ANIM_30, F_ROOM_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    sleep(40);
    evt_actor_begin();
    act_nop();
    act_anim_flags(ANIM_31, F_ROOM_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_tween_begin_alt();
    tw_set_pos(20, 0, -10);
    for (50)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_actor_begin();
    act_nop();
    act_flag_op(EF_SET, EF_8000);
    act_nop();
    act_finish();
}

event rebecca_hunter_attack_hunter
{
    evt_work_set(WK_ENEMY, ENEMY_01_HUNTER);
    evt_actor_begin();
    act_anim_seq(AB_02, 10281, 5748, F_ROOM_C_HUNTER_ANIM_DONE);
    act_reset();
    sleep(100);
    pos_set(ENEMY_01_HUNTER, 0, 808, 0, 9431, 0, 7822);
    sleep(65);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_0D);
    evt_fork(TASK_09, rebecca_hunter_attack_hit, 0);
    sleep(60);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_12);
    evt_finish();
}

event rebecca_hunter_attack_chris
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_flag_op(EF_SET, EF_0002);
    sleep(5);
    act_reset();
    evt_nop();
    sys_multi(SYS_FORCE_ACTION);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event rebecca_hunter_attack_hunter_slash
{
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, AB_16);
    sleep(38);
    evt_finish();
}

event rebecca_saved_talk
{
    run
    {
        bgm_play(BGM_SUB_1);
        cutnext(CAM_05_REBECCA);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_COMMON, F_COMMON_C_REBECCA_SAVED_TALK, FALSE);
        aot_delete(AOT_05_MESSAGE_REBECCA, SCE_NONE, 0);
        dir_set(0, 0, 592, 0, 12132, 0, 4876);
        pos_set(ENEMY_00_REBECCA, 0, 2672, 0, 13096, 0, 2888);
    }
    evt_fork(TASK_09, rebecca_saved_talk_rebecca_1, 0);
    evt_fork(TASK_09, rebecca_saved_talk_chris_1, 0);
    voice_play(VOICE_PLAY, VO_00C_12);
    message(MSG_VO_00C_12, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_rebecca_2, 0);
    voice_play(VOICE_PLAY, VO_00C_13);
    message(MSG_VO_00C_13, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_chris_2, 0);
    voice_play(VOICE_PLAY, VO_00C_14);
    message(MSG_VO_00C_14, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_both, 0);
    voice_play(VOICE_PLAY, VO_00C_15);
    message(MSG_VO_00C_15, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_chris_3, 0);
    voice_play(VOICE_PLAY, VO_00C_16);
    message(MSG_VO_00C_16, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_chris_4, 0);
    voice_play(VOICE_PLAY, VO_00C_18);
    message(MSG_VO_00C_18, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_rebecca_3, 0);
    voice_play(VOICE_PLAY, VO_00C_19);
    message(MSG_VO_00C_19, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_chris_5, 0);
    voice_play(VOICE_PLAY, VO_00C_1A);
    message(MSG_VO_00C_1A, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_rebecca_4, 0);
    voice_play(VOICE_PLAY, VO_00C_1B);
    message(MSG_VO_00C_1B, 0);
    wait_message();
    evt_fork(TASK_09, rebecca_saved_talk_chris_6, 0);
    voice_play(VOICE_PLAY, VO_00C_1C);
    message(MSG_VO_00C_1C, 0);
    wait_message();
    sleep(10);
    run
    {
        aot_reset(AOT_05_MESSAGE_REBECCA, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, rebecca_ill_do_my_best, 0);
        cutnext(CAM_04);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

