event event_00
{
#if CHRIS
    message(142, 127);
#else
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
    }
    evt_exec(0, 6, event_0A);
    evt_exec(0, 7, event_09);
    sleep(30);
    evt_exec(0, 9, event_01);
    sleep(30);
    cutnext(1);
    sleep(15);
    message(0, 0);
    voice_play(1, 30, 0);
    sleep(90);
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, 14, 0));
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    cutcurr(0);
    evt_disable(6);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
        room_bgm_state_set(0, 15, 65);
    }
    evt_exec(0, 9, event_02);
    do
    {
        do
        {
            evt_next();
            evt_nop();
            run noreturn
            {
                asm
                {
                        if                      off_28672 + 1
                        cmpb                    2, 0, 1
                        set                     FG_ROOM, 2, 0

                    off_28672:
                        endif                   0
                        end                     0
                }
            }
            evt_nop();
        }
        while (ck(FG_ROOM, 2, 1));
        set(FG_ROOM, 3, 0);
        evt_nop();
    }
    while (ck(FG_ROOM, 3, 1));
    do
    {
        evt_next();
        evt_nop();
        run noreturn
        {
            asm
            {
                    if                      off_28698 + 1
                    cmpb                    2, 0, 2
                    set                     FG_ROOM, 4, 0

                off_28698:
                    endif                   0
                    end                     0
            }
        }
        evt_nop();
    }
    while (ck(FG_ROOM, 4, 1));
#endif
    evt_finish();
}

