        if (testpickup(ITEM_1F_PUZZLE_EMBLEM_WOOD))
        {
            set(FG_COMMON, FLAG_COMMON_A7, FALSE);
        }
        if (testitem(ITEM_1F_PUZZLE_EMBLEM_WOOD))
        {
            if (ck(FG_ROOM, FLAG_ROOM_21, TRUE))
            {
                set(FG_ITEM, FLAG_ITEM_2A, TRUE);
                set(FG_COMMON, FLAG_COMMON_A7, TRUE);
                objtbl_b_set(1, 1, 1);
                aot_delete(AOT_04_ITEM, SCE_ITEM, 129);
                evt_exec(0, 9, from_main_2);
            }
        }
        if (testitem(ITEM_20_PUZZLE_EMBLEM_GOLD))
        {
            if (ck(FG_ROOM, FLAG_ROOM_20, TRUE))
            {
                set(FG_COMMON, FLAG_COMMON_A8, TRUE);
                objtbl_b_set(1, 2, 1);
                evt_exec(0, 9, from_main);
                evt_exec(0, 9, from_main_3);
            }
        }
        if (cmpb(2, 0, 0))
        {
            snd_pan_vol_set(1, 85, 82);
        }
        if (cmpb(2, 0, 1))
        {
            snd_pan_vol_set(1, 90, 87);
        }
        if (cmpb(2, 0, 2))
        {
            snd_pan_vol_set(1, 87, 90);
        }
        if (cmpb(2, 0, 3))
        {
            snd_pan_vol_set(1, 82, 85);
        }
        if (cmpb(2, 0, 4))
        {
            snd_pan_vol_set(1, 85, 85);
        }
        if (cmpb(2, 0, 5))
        {
            snd_pan_vol_set(1, 95, 95);
        }
        if (cmpb(2, 0, 6))
        {
            snd_pan_vol_set(1, 80, 80);
        }
    }
    else
    {
        aot_delete(AOT_04_ITEM, SCE_NONE, 1);
        aot_delete(AOT_06_USEITEM, SCE_NONE, 1);
        aot_delete(AOT_07_USEITEM, SCE_NONE, 1);
        aot_delete(AOT_08_USEITEM, SCE_NONE, 1);
        aot_delete(AOT_09_USEITEM, SCE_NONE, 1);
