event on_aot_0d
#endif
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        cutnext(6);
        message(144, 0); // "It's the hollow that an emblem was in."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        cutnext(3);
        set(FG_6, FLAG_6_17, TRUE);
        cut_auto(0);
    }
    evt_finish();
}

