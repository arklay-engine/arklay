proc main
{
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_A8, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_A7, TRUE))
        {
            aot_delete(AOT_06_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_08_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_09_USEITEM, SCE_NONE, SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_04_ITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_06_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_08_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_09_USEITEM, SCE_USEITEM, SAT_PLAYER);
        }
        if (testpickup(IT_1F_KEY_EMBLEM_WOOD))
        {
            set(FG_COMMON, F_COMMON_A7, FALSE);
        }
        if (testitem(IT_1F_KEY_EMBLEM_WOOD))
        {
            if (ck(FG_ROOM, F_ROOM_21, TRUE))
            {
                set(FG_ITEM, F_ITEM_2A, TRUE);
                set(FG_COMMON, F_COMMON_A7, TRUE);
                objtbl_b_set(TBL_ITEM, IMDL_01, OF_ACTIVE);
                aot_delete(AOT_04_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                evt_exec(0, TASK_09, from_main_2);
            }
        }
        if (testitem(IT_20_KEY_EMBLEM_GOLD))
        {
            if (ck(FG_ROOM, F_ROOM_20, TRUE))
            {
                set(FG_COMMON, F_COMMON_A8, TRUE);
                objtbl_b_set(TBL_ITEM, IMDL_02, OF_ACTIVE);
                evt_exec(0, TASK_09, from_main);
                evt_exec(0, TASK_09, from_main_3);
            }
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
        {
            snd_pan_vol_set(BGM_SUB_1, 85, 82);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
        {
            snd_pan_vol_set(BGM_SUB_1, 90, 87);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
        {
            snd_pan_vol_set(BGM_SUB_1, 87, 90);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
        {
            snd_pan_vol_set(BGM_SUB_1, 82, 85);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
        {
            snd_pan_vol_set(BGM_SUB_1, 85, 85);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
        {
            snd_pan_vol_set(BGM_SUB_1, 95, 95);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_06))
        {
            snd_pan_vol_set(BGM_SUB_1, 80, 80);
        }
    }
    else
    {
        aot_delete(AOT_04_ITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_06_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_07_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_08_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_09_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_07_USEITEM, SCE_NONE, SAT_PLAYER);
    }
    if (ck(FG_COMMON, F_COMMON_A7, TRUE))
    {
        aot_delete(AOT_0A_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_0A_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_COMMON, F_COMMON_A8, TRUE))
    {
        aot_reset(AOT_0A_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0a_2, 0);
        aot_delete(AOT_10_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_11_NONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_10_NONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_11_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
#else
    if (ck(FG_ROOM, F_ROOM_00, TRUE))
    {
        set(FG_ROOM, F_ROOM_00, FALSE);
        if (ck(FG_ROOM, F_ROOM_04, TRUE))
        {
            evt_exec(0, TASK_09, from_main_2);
        }
        else if (ck(FG_ROOM, F_ROOM_01, TRUE))
        {
            evt_exec(0, TASK_09, from_main);
        }
    }
    if (ck(FG_COMMON, F_COMMON_AD, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_A2, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_08, TRUE))
            {
                aot_delete(AOT_0E_NONE, SCE_EVENT, SAT_UNDER | SAT_PLAYER);
                set(FG_ROOM, F_ROOM_08, FALSE);
            }
        }
    }
    if (ck(FG_COMMON, F_COMMON_AB, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_AA, TRUE))
        {
            aot_delete(AOT_09_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_0A_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_0B_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_0C_USEITEM, SCE_NONE, SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_07_ITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_09_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_0A_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_0B_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_0C_USEITEM, SCE_USEITEM, SAT_PLAYER);
        }
        if (testpickup(IT_1F_KEY_EMBLEM_WOOD))
        {
            set(FG_COMMON, F_COMMON_AA, FALSE);
        }
        if (testitem(IT_1F_KEY_EMBLEM_WOOD))
        {
            if (ck(FG_ROOM, F_ROOM_23, TRUE))
            {
                set(FG_ITEM, F_ITEM_2A, TRUE);
                set(FG_COMMON, F_COMMON_AA, TRUE);
                objtbl_b_set(TBL_ITEM, IMDL_01, OF_ACTIVE);
                aot_delete(AOT_07_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                evt_exec(0, TASK_09, from_main_4);
            }
        }
        if (testitem(IT_20_KEY_EMBLEM_GOLD))
        {
            if (ck(FG_ROOM, F_ROOM_22, TRUE))
            {
                set(FG_COMMON, F_COMMON_AB, TRUE);
                set(FG_COMMON, F_COMMON_AA, TRUE);
                objtbl_b_set(TBL_ITEM, IMDL_02, OF_ACTIVE);
                evt_exec(0, TASK_09, from_main_3);
                evt_exec(0, TASK_09, from_main_5);
            }
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
        {
            snd_pan_vol_set(BGM_SUB_1, 85, 82);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
        {
            snd_pan_vol_set(BGM_SUB_1, 90, 87);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
        {
            snd_pan_vol_set(BGM_SUB_1, 87, 90);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
        {
            snd_pan_vol_set(BGM_SUB_1, 82, 85);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
        {
            snd_pan_vol_set(BGM_SUB_1, 85, 85);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
        {
            snd_pan_vol_set(BGM_SUB_1, 95, 95);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_06))
        {
            snd_pan_vol_set(BGM_SUB_1, 80, 80);
        }
    }
    else
    {
        aot_delete(AOT_07_ITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_09_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_0A_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_0B_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_0C_USEITEM, SCE_NONE, SAT_PLAYER);
    }
    if (ck(FG_COMMON, F_COMMON_AA, TRUE))
    {
        aot_delete(AOT_0D_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_0D_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_COMMON, F_COMMON_AB, TRUE))
    {
        aot_reset(AOT_0D_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0d_2, 0);
        aot_delete(AOT_15_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_16_NONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_15_NONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        aot_delete(AOT_16_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_COMMON, F_COMMON_AD, TRUE))
    {
        aot_delete(AOT_10_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
#endif
}

