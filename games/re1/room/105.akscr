event on_enter_2_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_20, 0);
    act_param_set(0, 2048);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_20, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_05, 6530, 5100, F_ROOM_20);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_23, F_ROOM_20, 0);
    act_reset();
    evt_nop();
    evt_finish();
}

event on_enter_2_sub2
{
    sleep(15);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 6200, 6800, F_ROOM_21);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_06, 6000, 7300, F_ROOM_21);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_finish();
}

event on_enter_2_sub3
{
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    evt_actor_begin();
    act_anim_seq(AB_02, 4200, 8000, F_ROOM_21);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    evt_actor_begin();
    act_anim_seq(AB_06, 6000, 7300, F_ROOM_21);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    evt_actor_begin();
    act_motion_path(MOTION_12, 0, 300, 0, 0, 30);
    act_reset();
    evt_nop();
    evt_finish();
}

event on_aot_0d
#endif
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_06);
        message(MSG_IT_IS_THE_HOLLOW_THAT_AN | MSG_FAST, 0); // "It's the hollow that an emblem was in."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        cutnext(CAM_03);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

#if CHRIS
event on_aot_0a_2
#else
event on_aot_0d_2
#endif
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_AN_EMBLEM_IS_IN_PLACE | MSG_FAST, 0); // "An emblem is in place."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}
