event from_main_4
{
    run
    {
        set(FG_6, F_6_19, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    for (4)
    {
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_anim_flags(32 | 23, 32 | 0, 0 | 0);
        act_flag_op(1, 128, 0);
        act_reset();
        evt_nop();
        evt_fork(TASK_09, from_main_4_sub2, 0);
        evt_fork(TASK_09, from_main_4_sub1, 0);
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_20, FALSE));
    }
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, F_6_19, TRUE);
        set(FG_ROOM, F_ROOM_1D, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_4A, FALSE))
        {
            set(FG_SCENARIO, F_SCENARIO_4A, TRUE);
        }
        else if (ck(FG_SCENARIO, F_SCENARIO_4B, FALSE))
        {
            set(FG_SCENARIO, F_SCENARIO_4A, FALSE);
            set(FG_SCENARIO, F_SCENARIO_4B, TRUE);
        }
        else
        {
            set(FG_SCENARIO, F_SCENARIO_4A, FALSE);
            set(FG_SCENARIO, F_SCENARIO_4B, FALSE);
        }
        eml_pos(3, 0, 0, 0, 0, 0, 0, 1, 0, 1, 0, 1, 0);
        set(FG_STATUS, F_STATUS_11, TRUE);
        set(FG_STATUS, F_STATUS_1A, TRUE);
        set(FG_ROOM, F_ROOM_15, TRUE);
        aot_on(AOT_06_USEITEM, SCE_USEITEM, 1);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    evt_finish();
}

