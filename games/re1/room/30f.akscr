event on_aot_0c
{
    message(MSG_IT_IS_A_MAP_OF_UNDER | MSG_FAST, MSG_PAUSE_0080 | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "It's a map of UNDER GROUND. Will you take it? You got the map of UNDER GROUND."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        require(cmpb(B_MENU_CHOICE, CMP_EQ, 0));
        aot_on(AOT_04_ITEM, SCE_F, 129);
        aot_delete(AOT_0C_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    evt_finish();
}

