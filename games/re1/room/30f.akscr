event from_main
{
    set(FG_ROOM, F_ROOM_11, TRUE);
    evt_disable(TASK_05);
    evt_disable(TASK_06);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 20, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    sleep(15);
    objtbl_b_set(0, 0, 47);
