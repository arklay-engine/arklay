#version 1

proc init
{
    door_aot_set(0, 2300, 4700, 2700, 3000, 2, 0, 0, 9, 0, RDT_000, 16200, 0, 3100, 3072, UNLOCKED, 129);
    door_aot_set(1, 25100, 19800, 2600, 2500, 3, 0, 6, 1, 169, RDT_006, 3000, 0, 3000, 0, ITEM_DORM_KEY_002_, 129);
    door_aot_set(2, 23600, 7300, 2500, 3100, 3, 0, 0, 4, 0, RDT_008, 4200, 0, 3400, 0, UNLOCKED, 129);
    item_aot_set(3, 23900, 27200, 800, 1000, ITEM_GREEN_HERB, 1, 0, 255, 236, 94, 0, 0, 168, 107, 0, 4, 106, 129, 1, 0);
    item_aot_set(4, 22700, 27000, 1000, 1000, ITEM_GREEN_HERB, 1, 1, 255, 0, 90, 0, 0, 214, 106, 0, 4, 107, 129, 1, 0);
    item_aot_set(5, 23000, 26000, 800, 1100, ITEM_GREEN_HERB, 1, 2, 255, 0, 90, 0, 0, 72, 103, 0, 4, 108, 129, 1, 0);
    obj(0, 1, 255, 24390, 0, 24550, 1024, 0, 0, 200, 0, 0, 0, 56, 255, 144, 1, 108, 2, 88, 2, 88, 2);
    evt_exec(0, 9, event_00);
    if (ck(FG_COMMON, 175, 1))
    {
        if (ck(FG_SCENARIO, 0, 0))
        {
            if (ck(FG_COMMON, 178, 1))
            {
                room_bgm_state_set(3, 5, 65);
                evt_exec(0, 9, event_01);
            }
            else
            {
                room_bgm_state_set(3, 5, 65);
                evt_exec(0, 9, event_02);
            }
            set(FG_COMMON, 39, 0);
        }
    }
    if (ck(FG_COMMON, 175, 1))
    {
        if (ck(FG_SCENARIO, 0, 0))
        {
            enemy(ENEMY_WESKER_STARS_, 2, 255, 1, 2, 0, 0, 2000, 0, 0, 16400, 0, 4500, 0, 0, 0, 0);
            enemy(ENEMY_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 11500, 0, 3100, 1, 0, 0, 0);
            enemy(ENEMY_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 9300, 0, 4600, 2, 0, 0, 0);
            enemy(ENEMY_WASP, 19, 255, 1, 2, 0, 0, 2048, 0, 0, 7000, 0, 3600, 3, 0, 0, 0);
        }
    }
}

event event_00
{
    run
    {
        if (ck(FG_COMMON, 7, 1))
        {
            if (ck(FG_COMMON, 174, 1))
            {
                aot_reset(1, SCE_EVENT, 129, 9, event_03, 0);
                room_bgm_state_set(3, 5, 64);
            }
        }
        if (ck(FG_COMMON, 175, 1))
        {
            if (ck(FG_SCENARIO, 0, 0))
            {
                if (ck(FG_COMMON, 178, 1))
                {
                    room_bgm_state_set(3, 5, 65);
                }
                else
                {
                    room_bgm_state_set(3, 5, 65);
                }
            }
        }
    }
    evt_finish();
}

