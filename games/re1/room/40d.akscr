event on_aot_0a
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_THERE_IS_A_LADDER | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a ladder. Will you climb it? Water settles here and I can't pass it."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_on(AOT_00_DOOR, SCE_DOOR, 0);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
        else
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    evt_finish();
}
