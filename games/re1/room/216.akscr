#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_HIKIDASHI 0x05
#define AOT_06_USEITEM 0x06
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08
#define AOT_09_MESSAGE 0x09
#define AOT_0A_MESSAGE 0x0A
#define AOT_0B_MESSAGE 0x0B
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define F_ROOM_18 0x18
#define IMDL_00 0x00
#define IMDL_01 0x01
#define OBJ_00 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 13600, 9500, 1700, 1900, 9, DOOR_SND_00_DR_WD, DOOR_04_DOOR04, 4, 0, ROOM_213_FRONT_ELEVATOR, 15800, 0, 16500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 700, 2900, 1700, 1300, 3, DOOR_SND_00_DR_WD, DOOR_1E_DOOR03K, 5, 0, ROOM_217_LIBRARY_B, 10800, 0, 3700, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 4200, 15300, 1000, 1500, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_218_HIDDEN_LIBRARY, 5000, 0, 2600, 3136, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_03_ITEM, 2600, 8700, 1500, 1500, IT_66_FILE_SCRAPBOOK, 1, IMDL_00, SCA_NONE, 3432, -800, 9407, 1024, F_ITEM_54, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_04_ITEM, 0, 2, 0, 2, IT_0E_AMMO_MAGNUM, 6, IMDL_01, SCA_NONE, 13520, -1440, 14040, -2710, F_ITEM_79, 0, 0);
    setbyte(1, 0, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_4F, TRUE))
    {
        obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 2532, 0, 15307, 1024, 0, -270, 0, 270, 270, 3420, 1260, 540);
    }
    else
    {
        obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 4732, 0, 15307, 1024, 0, -270, 0, 270, 270, 3420, 1260, 540);
    }
    aot_set(AOT_05_HIKIDASHI, 13100, 14000, 1100, 1200, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 32, 0, 4, 0, 6, 0);
    aot_set(AOT_06_USEITEM, 2486, 15307, 500, 500, SCE_USEITEM, SAT_UNDER | SAT_OBJECT, 4, 0, 24, 0, 1, 0);
    aot_set(AOT_07_MESSAGE, 1300, 5300, 1300, 7300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 126, 255, 0, 0);
    aot_set(AOT_08_MESSAGE, 1300, 4400, 3000, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 126, 255, 0, 0);
    aot_set(AOT_09_MESSAGE, 1300, 11600, 3000, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 126, 255, 0, 0);
    aot_set(AOT_0A_MESSAGE, 1300, 1000, 7300, 1700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 126, 255, 0, 0);
    aot_set(AOT_0B_MESSAGE, 5700, 5500, 2200, 7000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 126, 255, 0, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_5A, SPAWN_FORCE, 2, 0, 512, 0, 9325, 0, 12878, ENEMY_00_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_01, F_ENEMY_5B, SPAWN_FORCE, 2, 0, 2048, 0, 4000, 0, 9000, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
    set(FG_SCENARIO, F_SCENARIO_17, TRUE);
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_18, TRUE))
    {
        set(FG_ROOM, F_ROOM_18, FALSE);
        aot_delete(AOT_02_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_02_DOOR, SCE_DOOR, 0);
    }
}
