#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define FLAG_ROOM_18 0x18

proc init
{
    door_aot_set(0, 13600, 9500, 1700, 1900, 9, 0, 4, 4, 0, ROOM_213_FRONT_ELEVATOR, 15800, 0, 16500, 0, UNLOCKED, 129);
    door_aot_set(1, 700, 2900, 1700, 1300, 3, 0, 30, 5, 0, ROOM_217_LIBRARY_B, 10800, 0, 3700, 2048, UNLOCKED, 129);
    door_aot_set(2, 4200, 15300, 1000, 1500, 0, 0, 0, 1, 0, ROOM_218_HIDDEN_LIBRARY, 5000, 0, 2600, 3136, UNLOCKED, 129);
    item_aot_set(3, 2600, 8700, 1500, 1500, ITEM_66_FILE_SCRAPBOOK, 1, 0, 255, 104, 13, 224, 252, 191, 36, 0, 4, 84, 129, 0, 0);
    item_aot_set(4, 0, 2, 0, 2, ITEM_0E_AMMO_MAGNUM, 6, 1, 255, 208, 52, 96, 250, 216, 54, 106, 245, 121, 0, 0, 0);
    setbyte(1, 0, 0);
    if (ck(FG_SCENARIO, FLAG_SCENARIO_4F, TRUE))
    {
        obj(0, 17, 255, 2532, 0, 15307, 1024, 0, 0, 242, 254, 0, 0, 14, 1, 14, 1, 92, 13, 236, 4, 28, 2);
    }
    else
    {
        obj(0, 17, 255, 4732, 0, 15307, 1024, 0, 0, 242, 254, 0, 0, 14, 1, 14, 1, 92, 13, 236, 4, 28, 2);
    }
    aot_set(5, 13100, 14000, 1100, 1200, SCE_HIKIDASHI, 129, 32, 0, 4, 0, 6, 0);
    aot_set(6, 2486, 15307, 500, 500, SCE_USEITEM, 68, 4, 0, 24, 0, 1, 0);
    aot_set(7, 1300, 5300, 1300, 7300, SCE_MESSAGE, 129, 128, 0, 126, 255, 0, 0);
    aot_set(8, 1300, 4400, 3000, 1800, SCE_MESSAGE, 129, 128, 0, 126, 255, 0, 0);
    aot_set(9, 1300, 11600, 3000, 1900, SCE_MESSAGE, 129, 128, 0, 126, 255, 0, 0);
    aot_set(10, 1300, 1000, 7300, 1700, SCE_MESSAGE, 129, 129, 0, 126, 255, 0, 0);
    aot_set(11, 5700, 5500, 2200, 7000, SCE_MESSAGE, 129, 130, 0, 126, 255, 0, 0);
    enemy(ENEMY_00_ZOMBIE_GROUNDSKEEPER, 0, 90, 1, 2, 0, 0, 512, 0, 0, 9325, 0, 12878, 0, 0, 0, 0);
    enemy(ENEMY_00_ZOMBIE_GROUNDSKEEPER, 1, 91, 1, 2, 0, 0, 2048, 0, 0, 4000, 0, 9000, 1, 0, 0, 0);
    set(FG_SCENARIO, FLAG_SCENARIO_17, TRUE);
}

proc main
{
    if (ck(FG_ROOM, FLAG_ROOM_18, TRUE))
    {
        set(FG_ROOM, FLAG_ROOM_18, FALSE);
        aot_delete(2, SCE_DOOR, 129);
    }
    else
    {
        aot_delete(2, SCE_DOOR, 0);
    }
}
