#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_USEITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_ITEM 0x05
#define AOT_06_ITEM 0x06
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define ENEMY_00_CERBERUS 0x00
#define ENEMY_01_CERBERUS 0x01
#define ENEMY_02_CERBERUS 0x02
#define MSG_VO_009_04_22 0x00
#define MSG_VO_009_04_28 0x02
#define MSG_VO_009_05 0x01
#define MSG_VO_A05_05 0x03
#define SE_17_CALL 0x17
#define VO_009_04_22 0x22
#define VO_009_04_28 0x28
#define VO_009_05 0x23
#define VO_A05_05 0x29

proc init
{
    set(FG_STATUS, F_STATUS_1D, TRUE);
    door_aot_set(AOT_00_DOOR, 29200, 2600, 2000, 2600, 1, DOOR_SND_08_DR_GAT, DOOR_0F_MON, 64, 0, ROOM_302_FALLS, 3500, 0, 23300, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 3500, 30200, 1500, 1600, 1, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, STAGE_4 | ROOM_400_ENTER_PASSAGE, 3600, 0, 9900, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_02_USEITEM, 0, 0, 32000, 32000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 9, 0, 63, 0, 1, 0);
    aot_reset(AOT_02_USEITEM, SCE_NONE, 0, 0, 0, 0);
    item_aot_set(AOT_03_ITEM, 27900, 5200, 1700, 1000, IT_44_HEAL_HERB_GREEN, 1, 0, 255, 90, 110, 0, 0, 24, 21, 0, 0, F_ITEM_C1, 129, 1, 0);
    item_aot_set(AOT_04_ITEM, 27900, 5200, 1700, 1000, IT_44_HEAL_HERB_GREEN, 1, 1, 255, 72, 113, 0, 0, 24, 21, 0, 0, F_ITEM_C2, 129, 1, 0);
    item_aot_set(AOT_05_ITEM, 27900, 1800, 1700, 800, IT_45_HEAL_HERB_BLUE, 1, 2, 255, 90, 110, 0, 0, 96, 9, 0, 0, F_ITEM_C3, 129, 1, 0);
    item_aot_set(AOT_06_ITEM, 27900, 1800, 1700, 800, IT_45_HEAL_HERB_BLUE, 1, 3, 255, 72, 113, 0, 0, 96, 9, 0, 0, F_ITEM_C4, 129, 1, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_00, FALSE))
    {
        enemy(EM_02_CERBERUS, 12, F_ENEMY_35, 1, 2, 0, 0, 672, 0, 0, 25657, 0, 11984, ENEMY_00_CERBERUS, 0, 0, 0);
        enemy(EM_02_CERBERUS, 12, F_ENEMY_36, 1, 2, 0, 0, 336, 0, 0, 19483, 0, 16862, ENEMY_01_CERBERUS, 0, 0, 0);
        if (ck(FG_STATUS, F_STATUS_08, FALSE))
        {
            enemy(EM_02_CERBERUS, 12, F_ENEMY_37, 1, 2, 0, 0, 3920, 0, 0, 4200, 0, 21000, ENEMY_02_CERBERUS, 0, 0, 0);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE) && ck(FG_SCENARIO, F_SCENARIO_18, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_7F, TRUE))
        {
            aot_reset(AOT_02_USEITEM, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 9, 63, 1);
            evt_exec(0, TASK_00, on_enter);
        }
        set(FG_SCENARIO, F_SCENARIO_18, TRUE);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_302_FALLS))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 65);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, 31))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 35);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE) && ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        set(FG_COMMON, F_COMMON_3A, TRUE);
    }
}

proc main
{
    if (testitem(IT_4D_KEY_RADIO))
    {
        evt_exec(0, TASK_01, from_main);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 65);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 65);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
    {
        snd_pan_vol_set(BGM_SUB_1, 50, 35);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
    {
        snd_pan_vol_set(BGM_SUB_1, 30, 45);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
    {
        snd_pan_vol_set(BGM_SUB_1, 30, 45);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 35);
    }
}

event on_enter
{
    sleep(30);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(480);
    aot_reset(AOT_02_USEITEM, SCE_NONE, 0, 0, 0, 0);
    evt_finish();
}

event from_main
{
    evt_disable(TASK_00);
    set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
    sleep(10);
    set(FG_STATUS, F_STATUS_0F, TRUE);
#if CHRIS
    voice_play(VOICE_PLAY, VO_009_04_22, 0);
    message(MSG_VO_009_04_22, 0);
#else
    voice_play(VOICE_PLAY, VO_009_04_28, 0);
    message(MSG_VO_009_04_28, 0);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 16, 32 | 0, 0 | 0);
    act_flag_op(0, 2, 0);
    sleep(20);
    act_anim_flags(32 | 17, 32 | 0, 0 | 0);
    act_flag_op(0, 144, 0);
    act_reset();
    evt_nop();
    wait_message();
#if CHRIS
    voice_play(VOICE_PLAY, VO_009_05, 0);
    message(MSG_VO_009_05, 0);
#else
    voice_play(VOICE_PLAY, VO_A05_05, 0);
    message(MSG_VO_A05_05, 0);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 0, 0 | 0);
    act_flag_op(0, 2, 0);
    sleep(15);
    act_anim_flags(32 | 19, 32 | 0, 0 | 0);
    act_flag_op(0, 144, 0);
#if CHRIS
    sleep(65);
#else
    sleep(80);
#endif
    act_motion_path(113, 600, 0, 1, 120, 64);
    sleep(5);
    act_anim_flags(32 | 20, 32 | 0, 0 | 0);
#if CHRIS
    sleep(33);
#else
    sleep(40);
#endif
    act_reset();
    evt_nop();
    sys_multi(SYS_04);
    sleep(40);
    wait_message();
    run
    {
        sys_multi(SYS_07);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_STATUS, F_STATUS_11, TRUE);
        aot_reset(AOT_02_USEITEM, SCE_NONE, 0, 0, 0, 0);
    }
    evt_finish();
}
