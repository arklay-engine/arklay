#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

proc init
{
    set(FG_STATUS, FLAG_STATUS_1D, TRUE);
    door_aot_set(0, 29200, 2600, 2000, 2600, 1, 8, 15, 64, 0, ROOM_302_FALLS, 3500, 0, 23300, 0, UNLOCKED, 129);
    door_aot_set(1, 3500, 30200, 1500, 1600, 1, 0, 3, 1, 0, STAGE_4 | ROOM_400_ENTER_PASSAGE, 3600, 0, 9900, 3072, UNLOCKED, 129);
    aot_set(2, 0, 0, 32000, 32000, SCE_USEITEM, 65, 9, 0, 63, 0, 1, 0);
    aot_reset(2, SCE_NONE, 0, 0, 0, 0);
    item_aot_set(3, 27900, 5200, 1700, 1000, ITEM_44_HEAL_HERB_GREEN, 1, 0, 255, 90, 110, 0, 0, 24, 21, 0, 0, 193, 129, 1, 0);
    item_aot_set(4, 27900, 5200, 1700, 1000, ITEM_44_HEAL_HERB_GREEN, 1, 1, 255, 72, 113, 0, 0, 24, 21, 0, 0, 194, 129, 1, 0);
    item_aot_set(5, 27900, 1800, 1700, 800, ITEM_45_HEAL_HERB_BLUE, 1, 2, 255, 90, 110, 0, 0, 96, 9, 0, 0, 195, 129, 1, 0);
    item_aot_set(6, 27900, 1800, 1700, 800, ITEM_45_HEAL_HERB_BLUE, 1, 3, 255, 72, 113, 0, 0, 96, 9, 0, 0, 196, 129, 1, 0);
    if (ck(FG_SCENARIO, FLAG_SCENARIO_00, FALSE))
    {
        enemy(ENEMY_02_DOG_CERBERUS, 12, 53, 1, 2, 0, 0, 672, 0, 0, 25657, 0, 11984, 0, 0, 0, 0);
        enemy(ENEMY_02_DOG_CERBERUS, 12, 54, 1, 2, 0, 0, 336, 0, 0, 19483, 0, 16862, 1, 0, 0, 0);
        if (ck(FG_STATUS, FLAG_STATUS_08, FALSE))
        {
            enemy(ENEMY_02_DOG_CERBERUS, 12, 55, 1, 2, 0, 0, 3920, 0, 0, 4200, 0, 21000, 2, 0, 0, 0);
        }
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_00, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_18, FALSE))
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_7F, TRUE))
        {
            aot_reset(2, SCE_USEITEM, 65, 9, 63, 1);
            evt_exec(0, 0, event_00);
        }
        set(FG_SCENARIO, FLAG_SCENARIO_18, TRUE);
    }
    if (cmpb(3, 0, 2))
    {
        snd_pan_vol_set(1, 35, 65);
    }
    if (cmpb(3, 0, 31))
    {
        snd_pan_vol_set(1, 35, 35);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_00, TRUE) && ck(FG_STATUS, FLAG_STATUS_08, FALSE))
    {
        set(FG_COMMON, FLAG_COMMON_3A, TRUE);
    }
}

proc main
{
    if (testitem(ITEM_4D_TOOL_RADIO))
    {
        evt_exec(0, 1, event_01);
    }
    if (cmpb(2, 0, 0))
    {
        snd_pan_vol_set(1, 35, 65);
    }
    if (cmpb(2, 0, 1))
    {
        snd_pan_vol_set(1, 35, 65);
    }
    if (cmpb(2, 0, 2))
    {
        snd_pan_vol_set(1, 50, 35);
    }
    if (cmpb(2, 0, 3))
    {
        snd_pan_vol_set(1, 30, 45);
    }
    if (cmpb(2, 0, 4))
    {
        snd_pan_vol_set(1, 30, 45);
    }
    if (cmpb(2, 0, 5))
    {
        snd_pan_vol_set(1, 35, 35);
    }
}

event event_00
{
    sleep(30);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(480);
    aot_reset(2, SCE_NONE, 0, 0, 0, 0);
    evt_finish();
}

event event_01
{
    evt_disable(0);
    set(FG_6, FLAG_6_17, FALSE);
    sleep(10);
    set(FG_STATUS, FLAG_STATUS_0F, TRUE);
#if CHRIS
    voice_play(1, 34, 0);
    message(0, 0);
#else
    voice_play(1, 40, 0);
    message(2, 0);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 16, 32 | 0, 0 | 0);
    act_flag_op(0, 2, 0);
    sleep(20);
    act_anim_flags(32 | 17, 32 | 0, 0 | 0);
    act_flag_op(0, 144, 0);
    act_reset();
    evt_nop();
    wait_message();
#if CHRIS
    voice_play(1, 35, 0);
    message(1, 0);
#else
    voice_play(1, 41, 0);
    message(3, 0);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 0, 0 | 0);
    act_flag_op(0, 2, 0);
    sleep(15);
    act_anim_flags(32 | 19, 32 | 0, 0 | 0);
    act_flag_op(0, 144, 0);
#if CHRIS
    sleep(65);
#else
    sleep(80);
#endif
    act_motion_path(113, 600, 0, 1, 120, 64);
    sleep(5);
    act_anim_flags(32 | 20, 32 | 0, 0 | 0);
#if CHRIS
    sleep(33);
#else
    sleep(40);
#endif
    act_reset();
    evt_nop();
    sys_multi(4);
    sleep(40);
    wait_message();
    run
    {
        sys_multi(7);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        set(FG_STATUS, FLAG_STATUS_11, TRUE);
        aot_reset(2, SCE_NONE, 0, 0, 0, 0);
    }
    evt_finish();
}
