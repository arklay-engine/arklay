#version 1

proc init
{
    door_aot_set(0, 30200, 2500, 2700, 2100, 12, 1, 11, 3, 0, RDT_000, 2500, 0, 9500, 0, UNLOCKED, 129);
    door_aot_set(1, 0, 26600, 2900, 29400, 0, 13, 17, 64, 0, RDT_00D, 4600, 0, 4600, 0, UNLOCKED, 129);
    item_aot_set(2, 7700, 28150, 1000, 1000, ITEM_BATTERY, 1, 0, 255, 8, 32, 0, 0, 234, 111, 224, 6, 69, 129, 1, 0);
    item_aot_set(3, 0, 0, 1, 1, ITEM_BATTERY, 1, 1, 255, 0, 0, 0, 0, 0, 0, 0, 4, 70, 129, 0, 0);
    if (ck(FG_COMMON, 70, 1))
    {
        aot_set(4, 3000, 29700, 2000, 1000, SCE_USEITEM, 1, 9, 0, 12, 0, 1, 0);
        aot_set(5, 3000, 29700, 2000, 1000, SCE_EVENT, 129, 9, 0, event_01, 0, 0, 0);
        aot_reset(1, SCE_MESSAGE, 129, 9, 255, 0);
    }
    if (ck(FG_COMMON, 69, 1))
    {
        aot_set(6, 12500, 7500, 14500, 2000, SCE_EVENT, 65, 9, 0, event_00, 0, 0, 0);
    }
    if (ck(FG_COMMON, 75, 0))
    {
        enemy(ENEMY_JILL_STARS_, 2, 255, 1, 2, 0, 0, 448, 0, 0, 26600, 0, 4300, 0, 0, 0, 0);
        evt_exec(0, 9, event_07);
    }
    if (ck(FG_COMMON, 192, 1))
    {
        enemy(ENEMY_REBECCA_STARS_, 2, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 1, 0, 0, 0);
    }
}

proc main
{
    if (testitem(ITEM_BATTERY))
    {
        aot_delete(4, SCE_NONE, 0);
        aot_delete(5, SCE_NONE, 0);
        evt_exec(0, 9, event_02);
    }
}

event event_00
{
    run
    {
        aot_delete(6, SCE_NONE, 0);
        set(FG_COMMON, 69, 0);
    }
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
    }
    sleep(30);
    run
    {
        voice_play(1, 23, 0);
        message(8, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 300, 0, 0, 40);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(114, 0, 300, 1, 0, 40);
    act_reset();
    evt_nop();
    sleep(40);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 300, 0, 0, 40);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_STATUS, 15, 1);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_6, 23, 1);
        cutnext(7);
    }
    sleep(20);
    message(129, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        cutnext(6);
        cut_auto(0);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_02
{
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        cutnext(7);
    }
    sleep(40);
    evt_work_set(WK_AOT, 1);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3870, -1800, 30780);
    tw_end();
    evt_nop();
    sleep(1);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 3870, 30780);
    }
    sleep(20);
    run
    {
        cutnext(5);
        if (ck(FG_COMMON, 75, 1) && ck(FG_COMMON, 192, 0))
        {
            evt_exec(0, 9, event_03);
        }
        if (ck(FG_COMMON, 75, 0) && ck(FG_COMMON, 192, 1))
        {
            evt_exec(0, 9, event_04);
        }
        if (ck(FG_COMMON, 75, 0) && ck(FG_COMMON, 192, 0))
        {
            evt_exec(0, 9, event_05);
        }
        if (ck(FG_COMMON, 75, 1) && ck(FG_COMMON, 192, 1))
        {
            evt_exec(0, 9, event_06);
        }
    }
    evt_finish();
}

event event_03
{
    run
    {
        cutnext(6);
        set(FG_STATUS, 15, 1);
        dir_set(0, 0, 2400, 0, 4370, 0, 29960);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 1, 0 | 0);
    act_param_set(0, 252);
    act_flag_op(1, 2, 0);
    act_reset();
    evt_nop();
    sleep(16);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(46082, 32778, 8304);
    act_nop();
    act_reset();
    evt_nop();
    sleep(25);
    run
    {
        cut_auto(0);
        setb(9, 0, 0);
        set(FG_6, 23, 0);
        aot_on(1, SCE_DOOR, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

