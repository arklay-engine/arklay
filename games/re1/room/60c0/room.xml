    <language lang="en-US">
      <string key="save_name">M. Room 1F</string>
      <string key="0">An old pump. Water seems\nto be sent from here.{clear 0}\nThe lid is open!</string>
      <string key="1">\n </string>
      <string key="2">\nIt does not seem to cause\nany damage.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}小部屋/{s}1{s}F{s}</string>
      <string key="0">  古びたポンプだ\n  これで水をおくっているようだ{clear 0}\n     フタは開いている!</string>
      <string key="1">\n これで水をおくっているようだ</string>
      <string key="2">\n    効き目がないようだ</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Chambre RdC</string>
      <string key="0">Une vieille pompe. L'eau \nsemble venir d'ici.{clear 0}\nLe couvercle est ouvert!</string>
      <string key="1">\n </string>
      <string key="2">\nRien ne semble être abimé.</string>
    </language>
    <language lang="de-DE">
      <string key="0">Eine alte Pumpe. Von hier wird\nwohl Wasser abgeleitet.{clear 0}\nDer Deckel ist offen!</string>
      <string key="1">Von hier wird wohl Wasser\nabgeleitet.</string>
      <string key="2">Anscheinend verursacht das\nkeinen Schaden.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Villa 1P</string>
      <string key="0">Una vecchia pompa. L'acqua sembra \narrivi da qui.{clear 0}\nIl coperchio è aperto!</string>
      <string key="1">\n</string>
      <string key="2">\nSembra non si sia \ndanneggiato nulla</string>
    </language>
    <language lang="es-ES">
      <string key="0">Una vieja bomba... Parece\nque el agua sale de aquí...{clear 0}\n¡La tapa está abierta!</string>
      <string key="1">Parece que el agua\nsale de aquí...</string>
      <string key="2">No parece que le\nhaga ningún daño...</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Мед. комната 1-эт.</string>
      <string key="0">Старый насос. Кажется, вода \nоткачивается отсюда.{clear 0}\nКрышка открыта!</string>
      <string key="1">\n </string>
      <string key="2">\nКажется, это не наносит\nникакого ущерба.</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Lääkevarasto 1 krs</string>
      <string key="0">Vanha pumppu... Vesi näyttäisi\nkulkevan tämän läpi...{clear 0}Sen kansi on auki!</string>
      <string key="1">Vesi näyttäisi kulkevan tämän\nläpi...</string>
      <string key="2">Se ei näytä aiheuttavan\nyhtään vahinkoa...</string>
