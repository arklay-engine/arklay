#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_03_NONE 0x03
#define AOT_04_NONE 0x04
#define AOT_05_MESSAGE 0x05
#define CAM_03 0x03
#define F_ROOM_18 0x18
#define F_ROOM_19 0x19
#define IMDL_00 0x00
#define MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY 0x00
#define OBJ_00 0x00
#define OBJ_01 0x01
#define SE_17_BATHMIX 0x17

proc init
{
    door_aot_set(AOT_00_DOOR, 1700, 1300, 2000, 900, 3, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 7, 0, ROOM_109_TRAP_PASSAGE, 18000, 0, 8100, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_02, FALSE))
        {
            item_aot_set(AOT_01_ITEM, 20000, 20000, 1, 1, IT_3D_KEY_DESK, 1, IMDL_00, SCA_NONE, 20000, 0, 20000, -2300, F_ITEM_03, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_01_ITEM, 20000, 20000, 1, 1, IT_3D_KEY_DESK, 1, IMDL_00, SCA_NONE, 5850, -70, 6920, -430, F_ITEM_03, SAT_MANUAL | SAT_PLAYER, 0);
            eml_rot(IMDL_00, 0, 2040);
        }
        obj(OBJ_00, OF_ACTIVE, SCA_NONE, 21000, 0, 21000, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
        obj(OBJ_01, OF_ACTIVE, SCA_NONE, 20000, 0, 20000, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
        aot_set(AOT_03_NONE, 4500, 6300, 2000, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 1, 0, 0, 0);
        aot_set(AOT_04_NONE, 4500, 6300, 2000, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 4, 0, 0, 0);
    }
    aot_set(AOT_05_MESSAGE, 8500, 2000, 1500, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    scene_setup(1, 4700, 7000, 1800);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        set(FG_STATUS, F_STATUS_1D, TRUE);
        if (ck(FG_SCENARIO, F_SCENARIO_02, FALSE))
        {
            aot_delete(AOT_03_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            evt_exec(0, TASK_09, on_enter);
        }
        else
        {
            require(ck(FG_ITEM, F_ITEM_03, TRUE));
            aot_delete(AOT_04_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        }
    }
}

proc main
{
    if (testpickup(IT_3D_KEY_DESK))
    {
        aot_delete(AOT_04_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_ROOM, F_ROOM_18, TRUE))
    {
        set(FG_ROOM, F_ROOM_18, FALSE);
        if (ck(FG_ROOM, F_ROOM_19, TRUE))
        {
            set(FG_ROOM, F_ROOM_19, FALSE);
            evt_exec(0, TASK_09, from_main);
        }
        else
        {
            aot_delete(AOT_03_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            evt_exec(0, TASK_09, from_main_2);
            set(FG_STATUS, F_STATUS_0F, FALSE);
        }
    }
}

event on_enter
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 6280, 160, 7920);
    tw_finish();
}

event event_01
{
    run
    {
        aot_delete(AOT_03_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_03);
    }
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 5500, -660, 7070);
    tw_end();
    evt_next();
    sleep(15);
    message(MSG_THE_BATHTUB_IS_FILLED_WITH_MUDDY | MSG_FAST, RUN_READY | RUN_MONSTERS | RUN_PLAYER); // "The bathtub is filled with muddy water. Will you unplug it? Nothing useful."
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_ROOM, F_ROOM_18, TRUE);
        require(cmpb(B_MENU_CHOICE, CMP_EQ, 0));
        set(FG_ROOM, F_ROOM_19, TRUE);
    }
    evt_next();
    evt_finish();
}

event from_main
{
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_17_BATHMIX, 7, SND_AT_POINT, 0, 5500, 7070);
        aot_delete(AOT_03_NONE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        set(FG_SCENARIO, F_SCENARIO_02, TRUE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(0, 1, 0);
    for (15)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    for (29)
    {
        tw_set_pos(0, 6, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 2, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
    }
    tw_end();
    cutcurr(0);
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_end();
    evt_nop();
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 5790, -605, 7150);
    evt_next();
    tw_nop();
    for (33)
    {
        tw_set_pos(0, 6, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 2, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
        tw_set_pos(0, 1, 0);
        tw_pos_add();
        evt_next();
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 21000, 0, 21000);
    tw_end();
    evt_nop();
    evt_work_set(WK_AOT, IMDL_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 5850, -70, 6920);
    tw_abs_rot(0, 0, -430, 2040);
    tw_end();
    evt_next();
    run
    {
        aot_delete(AOT_04_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    evt_finish();
}

event from_main_2
{
    sleep(20);
    cutcurr(0);
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 6280, 160, 7920);
    tw_end();
    evt_next();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    evt_finish();
}

event event_04
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    cutnext(CAM_03);
    evt_next();
    evt_nop();
    sleep(30);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    aot_on(AOT_01_ITEM, SCE_ITEM, 0);
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(20);
    cutcurr(0);
    evt_next();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}
