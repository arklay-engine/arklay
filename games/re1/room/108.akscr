        effect(33, 2, 0, 224, 101, 16, 245, 236, 69, 192, 7);
        effect(33, 3, 0, 224, 101, 16, 245, 236, 69, 192, 7);
        effect(33, 4, 0, 224, 101, 16, 245, 236, 69, 192, 7);
        effect(33, 5, 0, 224, 101, 16, 245, 236, 69, 192, 7);
        effect(33, 6, 0, 224, 101, 16, 245, 236, 69, 192, 7);
        effect(33, 7, 0, 224, 101, 16, 245, 236, 69, 192, 7);
