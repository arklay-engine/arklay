proc main
{
    if (ck(FG_COMMON, 64, 1))
    {
        if (cmpb(2, 0, 1))
        {
            aot_switch(0, 1, 1);
            aot_switch(0, 2, 1);
        }
    }
    else if (cmpb(2, 0, 1))
    {
        aot_switch(0, 1, 0);
        aot_switch(0, 2, 0);
    }
    if (ck(FG_COMMON, 65, 1))
    {
        if (cmpb(2, 0, 2))
        {
            aot_switch(0, 5, 1);
        }
        if (cmpb(2, 0, 3))
        {
            aot_switch(0, 4, 1);
            aot_switch(0, 5, 1);
            aot_switch(0, 6, 1);
        }
    }
    else
    {
        if (cmpb(2, 0, 2))
        {
            aot_switch(0, 5, 0);
        }
        if (cmpb(2, 0, 3))
        {
            aot_switch(0, 4, 0);
            aot_switch(0, 5, 0);
            aot_switch(0, 6, 0);
        }
    }
    if (ck(FG_ENEMY, 0, 0) && ck(FG_ROOM, 9, 0))
    {
        set(FG_ROOM, 9, 1);
        if (ck(FG_ROOM, 10, 1))
        {
            bgm_stop(2);
            bgm_play(0);
        }
    }
    if (ck(FG_ENEMY, 1, 0) && ck(FG_ROOM, 10, 0))
    {
        set(FG_ROOM, 10, 1);
        if (ck(FG_ROOM, 9, 1))
        {
            bgm_stop(2);
            bgm_play(0);
        }
    }
}

