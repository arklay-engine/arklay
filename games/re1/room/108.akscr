        effect(FX_21, FX_ROW_00, FX_AT_WORLD, 26080, -2800, 17900, 1984);
        effect(FX_21, FX_ROW_01, FX_AT_WORLD, 26080, -2800, 17900, 1984);
        effect(FX_21, FX_ROW_02, FX_AT_WORLD, 26080, -2800, 17900, 1984);
        effect(FX_21, FX_ROW_03, FX_AT_WORLD, 26080, -2800, 17900, 1984);
        effect(FX_21, FX_ROW_04, FX_AT_WORLD, 26080, -2800, 17900, 1984);
        effect(FX_21, FX_ROW_05, FX_AT_WORLD, 26080, -2800, 17900, 1984);
        effect(FX_21, FX_ROW_06, FX_AT_WORLD, 26080, -2800, 17900, 1984);
        effect(FX_21, FX_ROW_07, FX_AT_WORLD, 26080, -2800, 17900, 1984);
    }
    sleep(10);
    run
    {
        eml_state(0, ENEMY_01_CERBERUS, EML_BEHAVIOUR, EB_07);
    }
    evt_finish();
}
