proc init
{
    door_aot_set(AOT_00_DOOR, 0, 2900, 3200, 2600, 1, 0, 0, 1, 0, ROOM_107_GALLERY, 15300, 0, 4200, 2048, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 23300, 25500, 3000, 2400, 2, 0, 0, 1, 0, ROOM_109_TRAP_PASSAGE, 24400, 0, 2700, 3072, UNLOCKED, 129);
    item_aot_set(AOT_03_ITEM, 20700, 13200, 1000, 1000, IT_0B_AMMO_HANDGUN, 15, 1, 255, 208, 82, 0, 0, 132, 53, 68, 10, 19, 129, 1, 0);
    obj(0, 1, 255, 14160, 0, 5905, 1024, 0, 0, 64, 2, 0, 0, 192, 253, 88, 2, 32, 2, 120, 5, 138, 2);
    obj(1, 1, 255, 21605, 0, 13970, 0, 0, 0, 64, 2, 0, 0, 192, 253, 88, 2, 32, 2, 138, 2, 120, 5);
#if MANSION1
    if (ck(FG_COMMON, F_COMMON_40, FALSE))
    {
        aot_set(AOT_04_EVENT, 14500, 1560, 800, 5400, SCE_EVENT, 65, 9, 0, on_aot_04, 0, 0, 0);
        aot_set(AOT_05_EVENT, 19420, 1560, 800, 5400, SCE_EVENT, 65, 9, 0, on_aot_04, 0, 0, 0);
        enemy(EM_02_CERBERUS, 128, 0, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 0, 0, 0, 0);
    }
    else
    {
        enemy(EM_02_CERBERUS, 1, 0, 1, 2, 0, 0, 2048, 0, 0, 10000, 0, 3600, 0, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_41, FALSE))
    {
        aot_set(AOT_06_EVENT, 21100, 8360, 5400, 800, SCE_EVENT, 65, 9, 0, on_aot_06, 0, 0, 0);
        aot_set(AOT_07_EVENT, 21100, 13080, 5400, 800, SCE_EVENT, 65, 9, 0, on_aot_06, 0, 0, 0);
        enemy(EM_02_CERBERUS, 128, 1, 1, 2, 0, 0, 2016, 0, 0, 28400, -3000, 16900, 1, 0, 0, 0);
    }
    else
    {
        enemy(EM_02_CERBERUS, 1, 1, 1, 2, 0, 0, 3072, 0, 0, 24000, 0, 15080, 1, 0, 0, 0);
    }
    aot_set(AOT_09_MESSAGE, 4600, 5000, 2000, 1200, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_0A_MESSAGE, 9200, 5000, 2000, 1200, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_0B_MESSAGE, 17500, 5000, 2000, 1200, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_0C_MESSAGE, 21300, 9000, 1200, 2000, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_0D_MESSAGE, 21300, 17600, 1200, 2000, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_0E_MESSAGE, 21300, 22000, 1200, 2000, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
#else
    enemy(EM_03_SPIDER_WEB_SPINNER, 2, 173, 1, 2, 0, 0, 2048, 0, 0, 17700, 0, 3500, 0, 0, 0, 0);
    enemy(EM_03_SPIDER_WEB_SPINNER, 3, 174, 1, 2, 0, 0, 1024, 0, 0, 24000, 0, 20000, 1, 0, 0, 0);
    aot_set(AOT_04_MESSAGE, 4600, 5000, 2000, 1200, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_05_MESSAGE, 9200, 5000, 2000, 1200, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_06_MESSAGE, 17500, 5000, 2000, 1200, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_07_MESSAGE, 21300, 9000, 1200, 2000, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 21300, 17600, 1200, 2000, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    aot_set(AOT_09_MESSAGE, 21300, 22000, 1200, 2000, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
#endif
}
#if MANSION1

proc main
{
    if (ck(FG_COMMON, F_COMMON_40, FALSE))
    {
        if (cmpb(2, 0, 1))
        {
            aot_switch(0, 1, 1);
            aot_switch(0, 2, 1);
        }
    }
    else if (cmpb(2, 0, 1))
    {
        aot_switch(0, 1, 0);
        aot_switch(0, 2, 0);
    }
    if (ck(FG_COMMON, F_COMMON_41, FALSE))
    {
        if (cmpb(2, 0, 2))
        {
            aot_switch(0, 5, 1);
        }
        if (cmpb(2, 0, 3))
        {
            aot_switch(0, 4, 1);
            aot_switch(0, 5, 1);
            aot_switch(0, 6, 1);
        }
    }
    else
    {
        if (cmpb(2, 0, 2))
        {
            aot_switch(0, 5, 0);
        }
        if (cmpb(2, 0, 3))
        {
            aot_switch(0, 4, 0);
            aot_switch(0, 5, 0);
            aot_switch(0, 6, 0);
        }
    }
    if (ck(FG_ENEMY, F_ENEMY_00, TRUE) && ck(FG_ROOM, F_ROOM_09, TRUE))
    {
        set(FG_ROOM, F_ROOM_09, FALSE);
        if (ck(FG_ROOM, F_ROOM_0A, FALSE))
        {
            bgm_stop(2);
            bgm_play(0);
        }
    }
    if (ck(FG_ENEMY, F_ENEMY_01, TRUE) && ck(FG_ROOM, F_ROOM_0A, TRUE))
    {
        set(FG_ROOM, F_ROOM_0A, FALSE);
        if (ck(FG_ROOM, F_ROOM_09, FALSE))
        {
            bgm_stop(2);
            bgm_play(0);
        }
    }
}

event on_aot_04
{
    run
    {
        aot_delete(AOT_04_EVENT, SCE_NONE, 0);
        aot_reset(AOT_05_EVENT, SCE_NONE, 0, 2561, 1028, 266);
        bgm_stop(0);
        bgm_play(2);
        asm
        {
                endif                   0
        }
        set(FG_ROOM, F_ROOM_09, TRUE);
    }
    sleep(1);
    run
    {
        set(FG_COMMON, F_COMMON_40, TRUE);
        se_play_3d(2, 23, 0, 0, 0, 9200, 1620);
        effect(21, 0, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(21, 1, 0, 240, 35, 72, 244, 84, 6, 144, 11);
        effect(21, 2, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(21, 3, 0, 240, 35, 72, 244, 84, 6, 144, 11);
        effect(21, 4, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(21, 5, 0, 240, 35, 72, 244, 84, 6, 144, 11);
        effect(21, 6, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(21, 7, 0, 240, 35, 216, 245, 84, 6, 144, 11);
    }
    sleep(5);
    run
    {
        effect(33, 0, 0, 240, 35, 72, 244, 84, 6, 144, 11);
        effect(33, 1, 0, 240, 35, 72, 244, 84, 6, 144, 11);
        effect(33, 2, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(33, 3, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(33, 4, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(33, 5, 0, 240, 35, 72, 244, 84, 6, 144, 11);
        effect(33, 6, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        effect(33, 7, 0, 240, 35, 216, 245, 84, 6, 144, 11);
        pos_set(0, 0, 3076, 0, 10000, -2000, 0);
    }
    sleep(1);
    run
    {
        eml_state(0, 0, 0, 7);
    }
    evt_finish();
}

