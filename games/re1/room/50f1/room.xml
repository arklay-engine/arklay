  <strings>
    <language lang="en-US">
      <string key="name">MAZE A</string>
      <string key="save_name">Laboratory B3</string>
      <string key="0">A power panel. Some areas\ndo not have power.{scroll 2}{clear 0}Will you activate the\nblacked-out areas?{scroll 1}{branch 0 1 0}It shows the power supply\nstatus.{scroll 2}</string>
      <string key="1">It shows the power supply\nstatus.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}研究所 {s}/{s}B{s}3{s}</string>
      <string key="0">電力を供給するパネルがある\n一部のエリアに電力が供給されていない{scroll 2}{clear 0}未供給のエリアに電力を供給しますか?{scroll 1}{branch 0 1 0}\n   電力の供給状況が分かる{scroll 2}</string>
      <string key="1">\n   電力の供給状況が分かる{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Laboratoire SS3</string>
      <string key="0">Un panneau électrique.\nCertaines zones ne sont pas{scroll 2}{clear 0}raccordées. Raccorder les\nzones sans électricité?{scroll 1}{branch 0 6 0}</string>
      <string key="1">Cela montre le niveau\nd'électricité.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">Eine Stromschalttafel. Einige\nBereiche sind nicht versorgt.{scroll 2}{clear 0}Möchten Sie die abgeschalteten\nBereiche aktivieren?{scroll 1}{branch 0 6 0}</string>
      <string key="1">Hier wird der Zustand der\nStromversorgung angezeigt.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Laboratorio S3</string>
      <string key="0">Un pannello elettrico. Alcune \naree non hanno elettricità.{scroll 2}{clear 0}Vuoi riattivare le \nzone oscurate?{scroll 1}{branch 0 6 0}</string>
      <string key="1">Mostra i livelli di \nelettricità.{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">Un control de energía...\nHay zonas sin suministro {scroll 2}{clear 0}eléctrico... ¿Quieres activar\nlas zonas sin luz?{scroll 1}{branch 0 6 0}</string>
      <string key="1">Muestra el estado del\nsuministro de energía...{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Лаборатория Б3</string>
      <string key="0">Панель управления питанием.\nВ некоторых зонах нет питания.{scroll 2}{clear 0}Включить питание для всех зон?{scroll 1}{branch 0 1 0}Здесь отображается\nсостояние блока питания.{scroll 2}</string>
      <string key="1">Здесь отображается\nсостояние блока питания.{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Laboratorion olohuone -2 krs</string>
      <string key="0">Sähköpaneeli...  Joillakin alueilla\nei ole sähköä...{scroll 2}{clear 0}Kytketäänkö sähköt\nniille alueille?{scroll 1}{branch 0 6 0}</string>
      <string key="1">Se näyttää sähköjärjestelmän\ntilan...{scroll 2}</string>
    </language>
  </strings>
