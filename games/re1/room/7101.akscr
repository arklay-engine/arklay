#version 1

proc init
{
    door_aot_set(0, 3200, 2200, 2400, 2100, 1, 0, 7, 1, 0, RDT_00E, 9400, -1402, 3300, 2048, UNLOCKED, 129);
    item_aot_set(1, 3712, 23040, 1792, 2000, ITEM_MOON_CREST, 1, 0, 255, 62, 18, 0, 0, 80, 95, 0, 0, 129, 0, 32, 128);
    eml_rot(0, 158, 12, 0, 0);
    item_aot_set(2, 3840, 13568, 1280, 1500, ITEM_SHELLS, 7, 1, 255, 18, 17, 252, 249, 40, 55, 80, 251, 130, 129, 0, 0);
    aot_set(3, 2300, 4500, 2000, 1300, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    if (ck(FG_ITEM, 129, 0))
    {
        aot_set(4, 3712, 23040, 1792, 2000, SCE_EVENT, 129, 9, 0, event_01, 0, 0, 0);
    }
    else
    {
        aot_set(4, 3712, 23040, 1792, 2000, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, 0, 1))
    {
        if (ck(FG_SCENARIO, 16, 1))
        {
            enemy(ENEMY_YAWN_1, 128, 24, 1, 2, 0, 0, 0, 0, 0, 4500, 0, 24500, 0, 0, 0, 0);
        }
        else
        {
            enemy(ENEMY_YAWN_1, 2, 24, 1, 2, 0, 0, 1024, 0, 0, 11000, 0, 10000, 0, 0, 0, 0);
            set(FG_ROOM, 30, 0);
            if (ck(FG_ENEMY, 24, 1))
            {
                evt_exec(0, 9, event_02);
            }
        }
    }
    if (ck(FG_ENEMY, 24, 1))
    {
        room_bgm_state_set(1, 16, 64);
    }
    else
    {
        room_bgm_state_set(1, 16, 255);
    }
    set(FG_STATUS, 29, 0);
}

proc main
{
    if (ck(FG_SCENARIO, 0, 1))
    {
        if (ck(FG_ENEMY, 24, 0))
        {
            if (ck(FG_STATUS, 8, 1))
            {
                set(FG_COMMON, 38, 0);
            }
            if (ck(FG_ROOM, 15, 0))
            {
                set(FG_ROOM, 15, 1);
                bgm_volume_ramp(0, 161, 30);
            }
        }
        if (ck(FG_ROOM, 30, 1) && ck(FG_ENEMY, 24, 1) && cmpb(2, 0, 2))
        {
            set(FG_ROOM, 30, 0);
            set(FG_STATUS, 29, 1);
            evt_exec(0, 9, event_00);
        }
    }
    if (ck(FG_ROOM, 31, 0))
    {
        set(FG_ROOM, 31, 1);
        cutnext(4);
    }
}

event event_00
{
    run
    {
        bgm_play(0);
        set(FG_ROOM, 15, 0);
        set(FG_6, 23, 1);
        cutnext(4);
        dir_set(0, 0, 0, 0, 11130, 0, 2640);
    }
    sleep(20);
    eml_state(0, 0, 0, 0);
    sleep(33);
    cutnext(6);
    sleep(200);
    run
    {
        cutnext(1);
        dir_set(0, 0, 2910, 0, 11434, 0, 8043);
        set(FG_6, 23, 0);
        cut_auto(0);
    }
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_STATUS, 29, 1);
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
        cutnext(5);
    }
    sleep(30);
    run
    {
        set(FG_ROOM, 31, 0);
        set(FG_6, 23, 0);
        aot_on(1, SCE_ITEM, 0);
    }
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        if (ck(FG_ITEM, 129, 1))
        {
            aot_reset(4, SCE_MESSAGE, 129, 129, 255, 0);
        }
    }
    sleep(1);
    run
    {
        cut_auto(0);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
    }
    evt_finish();
}

event event_02
{
    sleep(1);
    bgm_play(0);
    set(FG_ROOM, 15, 0);
    evt_finish();
}
