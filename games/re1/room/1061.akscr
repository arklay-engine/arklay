    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 6, 32 | 0, 0 | 0);
    act_flag_op(0, 3, 0);
    act_reset();
    evt_nop();
    sleep(10);
    cutnext(6);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_seq(2835, 8225, 8759);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 34, 1));
    cutnext(2);
    sleep(10);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    sleep(30);
    se_play_3d(2, 25, 0, 0, 0, 15887, 12538);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 2, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    sleep(50);
    se_play_3d(2, 26, 0, 0, 0, 15887, 12538);
    sleep(20);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    run
    {
        pos_set(0, 0, 0, 0, 0, 10000, 0);
        set(FG_STATUS, 15, 1);
        set(FG_6, 23, 0);
        cut_auto(0);
    }
    evt_finish();
}

event event_1F
{
    run
    {
        bgm_stop_all(0);
        movie_on(5);
    }
    evt_next();
    evt_nop();
    run
    {
        bgm_restore(0);
    }
    evt_finish();
}
