#version 1

proc init
{
    set(FG_STATUS, 28, 0);
    door_aot_set(0, 31100, 10000, 2000, 3000, 6, 0, 4, 7, 0, RDT_007, 2700, 0, 6600, 0, UNLOCKED, 129);
    door_aot_set(1, 31100, 18600, 2000, 1200, 2, 0, 3, 1, 197, RDT_011, 2800, 0, 4600, 0, ITEM_ARMOR_KEY, 129);
    door_aot_set(2, 1000, 15000, 1950, 3800, 6, 0, 3, 7, 0, RDT_005, 30900, 0, 8300, 2048, UNLOCKED, 129);
    aot_set(3, 14600, 800, 5200, 2200, SCE_USEITEM, 129, 4, 0, 32, 0, 1, 0);
    door_aot_set(4, 15600, 15900, 2900, 2600, 0, 4, 22, 96, 0, RDT_203, 17100, 0, 25300, 3072, UNLOCKED, 129);
    if (ck(FG_COMMON, 11, 1) && ck(FG_SCENARIO, 123, 0))
    {
        item_aot_set(5, 13000, 16000, 2000, 2000, ITEM_INK_RIBBON, 2, 3, 255, 0, 0, 32, 78, 0, 0, 0, 0, 52, 129, 0, 0);
    }
    else
    {
        aot_set(5, 13000, 16000, 2000, 2000, SCE_TYPEWRITER, 129, 0, 0, 0, 0, 0, 0);
    }
    if (ck(FG_COMMON, 3, 0))
    {
        room_bgm_state_set(0, 6, 8);
    }
    if (ck(FG_COMMON, 10, 1) && ck(FG_COMMON, 7, 1) && ck(FG_ITEM, 13, 1))
    {
        set(FG_COMMON, 7, 0);
        item_aot_set(6, 0, 0, 16, 16, ITEM_ACID_ROUNDS, 6, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, 14, 65, 0, 0);
        enemy(ENEMY_BARRY_STARS_, 4, 255, 1, 2, 0, 0, 1568, 0, 0, 19100, 0, 14600, 0, 0, 0, 0);
        evt_exec(0, 0, event_1B);
    }
    if (ck(FG_COMMON, 5, 1) && ck(FG_COMMON, 7, 0))
    {
        set(FG_COMMON, 7, 1);
        set(FG_COMMON, 5, 0);
        room_bgm_state_set(0, 6, 65);
        item_aot_set(6, 0, 0, 16, 16, ITEM_LOCK_PICK, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 9, 65, 0, 0);
        enemy(ENEMY_BARRY_STARS_, 0, 255, 1, 2, 0, 0, 317, 0, 0, 12609, 0, 5417, 0, 0, 0, 0);
        evt_exec(0, 0, event_15);
        cut_auto(1);
        setb(2, 6, 0);
        set(FG_STATUS, 29, 0);
        set(FG_ROOM, 9, 0);
        set(FG_ROOM, 12, 0);
    }
    if (ck(FG_COMMON, 3, 1) && ck(FG_COMMON, 2, 0))
    {
        room_bgm_state_set(0, 6, 65);
        item_aot_set(6, 0, 0, 16, 16, ITEM_LOCK_PICK, 0, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 9, 65, 0, 0);
        enemy(ENEMY_BARRY_STARS_, 0, 255, 1, 2, 0, 0, 480, 0, 0, 5460, 0, 14767, 0, 0, 0, 0);
        aot_reset(0, SCE_MESSAGE, 129, 162, 255, 0);
        aot_reset(1, SCE_MESSAGE, 129, 162, 255, 0);
        aot_reset(2, SCE_MESSAGE, 129, 162, 255, 0);
        aot_reset(5, SCE_MESSAGE, 129, 174, 255, 0);
        cut_auto(1);
        setb(2, 6, 0);
        evt_exec(0, 0, event_05);
        set(FG_COMMON, 3, 0);
        set(FG_STATUS, 29, 0);
    }
    if (ck(FG_COMMON, 0, 0) && ck(FG_COMMON, 2, 1))
    {
        enemy(ENEMY_WESKER_STARS_, 0, 255, 1, 2, 0, 0, 3888, 0, 0, 19600, 0, 8500, 0, 0, 0, 0);
        cut_auto(1);
        setb(2, 6, 0);
        set(FG_COMMON, 1, 0);
        evt_exec(0, 0, event_04);
    }
    if (ck(FG_COMMON, 95, 0))
    {
        set(FG_COMMON, 94, 0);
    }
    if (ck(FG_COMMON, 0, 1))
    {
        enemy(ENEMY_WESKER_STARS_, 0, 255, 1, 2, 0, 0, 3072, 0, 0, 17000, 0, 2500, 0, 0, 0, 0);
        enemy(ENEMY_BARRY_STARS_, 0, 255, 1, 2, 0, 0, 2816, 0, 0, 15500, 0, 2500, 1, 0, 0, 0);
        dir_set(0, 0, 3200, 0, 18500, 0, 2500);
        set(FG_COMMON, 0, 0);
        evt_exec(0, 0, event_00);
        set(FG_STATUS, 29, 0);
        set(FG_COMMON, 170, 0);
    }
}

proc main
{
    if (ck(FG_COMMON, 3, 0) && ck(FG_COMMON, 5, 1))
    {
        if (cmpb(2, 0, 3) && ck(FG_ROOM, 20, 1))
        {
            set(FG_ROOM, 7, 0);
            set(FG_ROOM, 20, 0);
            evt_exec(0, 3, event_0B);
        }
        if (cmpb(2, 0, 4) && ck(FG_ROOM, 20, 1))
        {
            set(FG_ROOM, 7, 0);
            set(FG_ROOM, 20, 0);
            evt_exec(0, 3, event_0B);
        }
        if (ck(FG_ROOM, 7, 0) && ck(FG_ROOM, 8, 1))
        {
            if (cmpb(2, 0, 2))
            {
                set(FG_ROOM, 8, 0);
                set(FG_COMMON, 5, 0);
                set(FG_ROOM, 9, 0);
                set(FG_ROOM, 10, 0);
                pos_set(0, 0, 1709, 0, 25524, 0, 6371);
                evt_exec(0, 0, event_0C);
            }
            if (cmpb(2, 0, 5))
            {
                set(FG_ROOM, 8, 0);
                set(FG_COMMON, 5, 0);
                set(FG_ROOM, 9, 0);
                set(FG_ROOM, 11, 0);
                pos_set(0, 0, 2488, 0, 8111, 0, 9567);
                evt_exec(0, 0, event_10);
            }
        }
    }
    if (ck(FG_ROOM, 9, 0))
    {
        if (ck(FG_ROOM, 10, 0))
        {
            if (ck(FG_ROOM, 13, 0))
            {
                set(FG_ROOM, 13, 1);
                evt_exec(0, 0, event_19);
            }
            if (ck(FG_ROOM, 14, 0))
            {
                set(FG_ROOM, 14, 1);
                evt_exec(0, 0, event_0D);
            }
            if (ck(FG_ROOM, 15, 0))
            {
                set(FG_ROOM, 15, 1);
                evt_exec(0, 0, event_1A);
            }
            if (ck(FG_ROOM, 16, 0))
            {
                set(FG_ROOM, 16, 1);
                evt_exec(0, 0, event_0E);
            }
        }
        if (ck(FG_ROOM, 11, 0))
        {
            if (ck(FG_ROOM, 13, 0))
            {
                set(FG_ROOM, 13, 1);
                evt_exec(0, 0, event_19);
            }
            if (ck(FG_ROOM, 14, 0))
            {
                set(FG_ROOM, 14, 1);
                evt_exec(0, 0, event_11);
            }
            if (ck(FG_ROOM, 15, 0))
            {
                set(FG_ROOM, 15, 1);
                evt_exec(0, 0, event_1A);
            }
            if (ck(FG_ROOM, 16, 0))
            {
                set(FG_ROOM, 16, 1);
                evt_exec(0, 0, event_12);
            }
        }
        if (ck(FG_ROOM, 12, 0))
        {
            if (ck(FG_ROOM, 13, 0))
            {
                set(FG_ROOM, 13, 1);
                evt_exec(0, 0, event_19);
            }
            if (ck(FG_ROOM, 14, 0))
            {
                set(FG_ROOM, 14, 1);
                evt_exec(0, 0, event_16);
            }
            if (ck(FG_ROOM, 15, 0))
            {
                set(FG_ROOM, 15, 1);
                evt_exec(0, 0, event_1A);
            }
            if (ck(FG_ROOM, 16, 0))
            {
                set(FG_ROOM, 16, 1);
                evt_exec(0, 0, event_17);
            }
        }
    }
    if (ck(FG_ROOM, 1, 1))
    {
        if (cmpb(16, 0, 4))
        {
            if (ck(FG_COMMON, 4, 1))
            {
                set(FG_COMMON, 4, 0);
                set(FG_ROOM, 1, 0);
                evt_exec(0, 7, event_1F);
                set(FG_ROOM, 1, 1);
            }
            else
            {
                set(FG_ROOM, 2, 0);
            }
        }
        if (ck(FG_ROOM, 2, 0))
        {
            set(FG_ROOM, 2, 1);
            set(FG_ROOM, 1, 0);
            message(161, 255);
            set(FG_ROOM, 1, 1);
        }
    }
    if (ck(FG_COMMON, 11, 1) && ck(FG_ITEM, 52, 1))
    {
        set(FG_COMMON, 11, 0);
        aot_reset(5, SCE_TYPEWRITER, 129, 0, 0, 0);
    }
}

