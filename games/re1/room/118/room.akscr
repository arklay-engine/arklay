#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_01_ITEMBOX 0x01
#define AOT_02_ITEM 0x02
#define AOT_02_MESSAGE 0x02
#define AOT_03_ITEMBOX 0x03
#define AOT_03_MESSAGE 0x03
#define AOT_04_ITEM 0x04
#define AOT_04_TYPEWRITER 0x04
#define AOT_05_ITEM 0x05
#define AOT_06_TYPEWRITER 0x06
#define IMDL_00 0x00
#define IMDL_01 0x01
#define IMDL_02 0x02
#define OBJ_00 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 5600, 8200, 1200, 1300, 3, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_10B_1F_RIGHT_STAIRS, 9500, 0, 14300, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (MANSION1)
    {
        item_aot_set(AOT_01_ITEM, 2260, 2469, 1800, 1800, IT_26_KEY_HERBICIDE, 1, IMDL_00, SCA_NONE, 3170, 0, 3339, 0, F_ITEM_0D, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        aot_set(AOT_02_MESSAGE, 1800, 1900, 2800, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
        aot_set(AOT_03_ITEMBOX, 4750, 1900, 2800, 2050, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
        aot_set(AOT_04_TYPEWRITER, 1300, 8000, 1900, 1700, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_01_ITEMBOX, 4750, 1900, 2800, 2050, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
        item_aot_set(AOT_02_ITEM, 4644, 4278, 1800, 1800, IT_41_HEAL_FIRST_AID_SPRAY, 1, IMDL_00, SCA_NONE, 5544, 0, 5178, 0, F_ITEM_A0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        aot_set(AOT_03_MESSAGE, 1800, 1900, 2800, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
        item_aot_set(AOT_04_ITEM, 6234, 4868, 1800, 1800, IT_0C_AMMO_SHOTGUN, 7, IMDL_01, SCA_NONE, 7134, 0, 5768, 0, F_ITEM_DA, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        if (ck(FG_STATUS, F_STATUS_08, FALSE))
        {
            item_aot_set(AOT_05_ITEM, 6084, 3968, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, IMDL_02, SCA_NONE, 6984, 0, 4868, 0, F_ITEM_D9, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        else
        {
            item_aot_set(AOT_05_ITEM, 6084, 3968, 1800, 1800, IT_11_AMMO_GRENADE_ACID, 6, IMDL_02, SCA_NONE, 6984, 0, 4868, 0, F_ITEM_D9, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        aot_set(AOT_06_TYPEWRITER, 1300, 8000, 1900, 1700, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 6320, -1410, 1770, 3072, 0, 0, 0, 0, 0, 0, 0, 0);
}

proc main when (MANSION1)
{
    if (ck(FG_ITEM, F_ITEM_0D, FALSE))
    {
        aot_delete(AOT_02_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_02_MESSAGE, SCE_MESSAGE, 0);
    }
}
