#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_10B 0x00
#define AOT_01_ITEMBOX 0x01
#define AOT_01_ITEM_KEY_HERBICIDE_0 0x01
#define AOT_02_ITEM_HEAL_FIRST_AID_SPRAY_0 0x02
#define AOT_02_MESSAGE_GARDENING_TOOLS 0x02
#define AOT_03_ITEMBOX 0x03
#define AOT_03_MESSAGE_GARDENING_TOOLS 0x03
#define AOT_04_ITEM_AMMO_SHOTGUN_1 0x04
#define AOT_04_TYPEWRITER 0x04
#define AOT_05_ITEM_AMMO_GRENADE_ACID_2 0x05
#define AOT_05_ITEM_AMMO_HANDGUN_2 0x05
#define AOT_06_TYPEWRITER 0x06
#define IMDL_00_HEAL_FIRST_AID_SPRAY 0x00
#define IMDL_00_KEY_HERBICIDE 0x00
#define IMDL_01_AMMO_SHOTGUN 0x01
#define IMDL_02_AMMO_GRENADE_ACID 0x02
#define IMDL_02_AMMO_HANDGUN 0x02
#define OBJ_00 0x00

proc init
{
    door_aot_set(AOT_00_DOOR_10B, 5600, 8200, 1200, 1300, 3, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_10B_1F_RIGHT_STAIRS, 9500, 0, 14300, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        item_aot_set(AOT_01_ITEM_KEY_HERBICIDE_0, 2260, 2469, 1800, 1800, IT_26_KEY_HERBICIDE, 1, IMDL_00_KEY_HERBICIDE, SCA_NONE, 3170, 0, 3339, 0, F_ITEM_118_KEY_HERBICIDE_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        aot_set(AOT_02_MESSAGE_GARDENING_TOOLS, 1800, 1900, 2800, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
        aot_set(AOT_03_ITEMBOX, 4750, 1900, 2800, 2050, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
        aot_set(AOT_04_TYPEWRITER, 1300, 8000, 1900, 1700, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_01_ITEMBOX, 4750, 1900, 2800, 2050, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 1, 0, 0, 0, 0, 0);
        item_aot_set(AOT_02_ITEM_HEAL_FIRST_AID_SPRAY_0, 4644, 4278, 1800, 1800, IT_41_HEAL_FIRST_AID_SPRAY, 1, IMDL_00_HEAL_FIRST_AID_SPRAY, SCA_NONE, 5544, 0, 5178, 0, F_ITEM_118_HEAL_FIRST_AID_SPRAY_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        aot_set(AOT_03_MESSAGE_GARDENING_TOOLS, 1800, 1900, 2800, 1200, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
        item_aot_set(AOT_04_ITEM_AMMO_SHOTGUN_1, 6234, 4868, 1800, 1800, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN, SCA_NONE, 7134, 0, 5768, 0, F_ITEM_118_AMMO_SHOTGUN_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            item_aot_set(AOT_05_ITEM_AMMO_HANDGUN_2, 6084, 3968, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, IMDL_02_AMMO_HANDGUN, SCA_NONE, 6984, 0, 4868, 0, F_ITEM_C_118_AMMO_HANDGUN_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        else
        {
            item_aot_set(AOT_05_ITEM_AMMO_GRENADE_ACID_2, 6084, 3968, 1800, 1800, IT_11_AMMO_GRENADE_ACID, 6, IMDL_02_AMMO_GRENADE_ACID, SCA_NONE, 6984, 0, 4868, 0, F_ITEM_J_118_AMMO_GRENADE_ACID_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
        }
        aot_set(AOT_06_TYPEWRITER, 1300, 8000, 1900, 1700, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    }
    obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 6320, -1410, 1770, 3072, 0, 0, 0, 0, 0, 0, 0, 0);
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        if (ck(FG_ITEM, F_ITEM_118_KEY_HERBICIDE_0, FALSE))
        {
            aot_delete(AOT_02_MESSAGE_GARDENING_TOOLS, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_02_MESSAGE_GARDENING_TOOLS, SCE_MESSAGE, 0);
        }
    }
}
