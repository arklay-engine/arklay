#if CHRIS
event on_enter_2_sub2
{
    se_play_3d(SND_BANK_ROOM, SE_17, 0, SND_AT_POINT, 0, 9424, 12173);
    se_play_3d(SND_BANK_ROOM, SE_18, 0, SND_AT_POINT, 0, 9424, 12173);
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    evt_next();
    tw_nop();
    tw_set_pos(0, -48, 0);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 0, 0, 0);
    tw_end();
    evt_nop();
    evt_finish();
}

