proc init
{
    door_aot_set(AOT_00_DOOR, 13700, 960, 1700, 1900, 1, DOOR_SND_00_DR_WD, DOOR_1F_DOOR05K, 5, DOOR_LOCKED | F_LOCK_06, ROOM_104_TEA_ROOM, 30700, 0, 3900, 1024, IT_33_KEY_MANSION_SWORD, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    aot_set(AOT_01_MESSAGE, 8800, 7200, 1500, 1700, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
#else
    aot_set(AOT_01_NONE, 8800, 7200, 1500, 1700, SCE_NONE, SAT_MANUAL | SAT_UNDER | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
#endif
    aot_set(AOT_02_MESSAGE, 10200, 7300, 600, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_A4, TRUE))
    {
        item_aot_set(AOT_03_ITEM, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, 0, 255, 4, 36, 208, 253, 94, 76, 0, 4, F_ITEM_14, 129, 0, 0);
    }
    else
    {
        item_aot_set(AOT_03_ITEM, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_14, 129, 0, 0);
    }
#else
    if (ck(FG_COMMON, F_COMMON_A7, TRUE))
    {
        item_aot_set(AOT_03_ITEM, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, 0, 255, 4, 36, 208, 253, 94, 76, 0, 4, F_ITEM_14, 129, 0, 0);
    }
    else
    {
        item_aot_set(AOT_03_ITEM, 0, 0, 0, 0, IT_1F_KEY_EMBLEM_WOOD, 1, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, F_ITEM_14, 129, 0, 0);
    }
#endif
    item_aot_set(AOT_04_ITEM, 8100, 18800, 1500, 1000, IT_20_KEY_EMBLEM_GOLD, 1, 1, 255, 4, 36, 208, 253, 94, 76, 0, 4, F_ITEM_15, 129, 0, 0);
    item_aot_set(AOT_05_ITEM, 17000, 11500, 800, 1000, IT_23_KEY_MUSIC_SCORE, 0, 2, 255, 98, 67, 72, 244, 30, 45, 226, 4, F_ITEM_07, 129, 0, 0);
    aot_set(AOT_06_USEITEM, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 4, 0, 1, 0);
#if CHRIS
    aot_set(AOT_07_USEITEM, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 35, 0, 1, 0);
#else
    aot_set(AOT_07_USEITEM, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 34, 0, 1, 0);
#endif
    aot_set(AOT_08_USEITEM, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 5, 0, 1, 0);
#if CHRIS
    aot_set(AOT_09_USEITEM, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 34, 0, 1, 0);
#else
    aot_set(AOT_09_USEITEM, 8100, 18800, 1500, 1000, SCE_USEITEM, SAT_PLAYER, 4, 0, 33, 0, 1, 0);
#endif
    aot_set(AOT_0A_MESSAGE, 8100, 18800, 1500, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 24, 0, 255, 0, 0, 0);
    aot_set(AOT_0B_USEITEM, 7000, 14000, 3000, 1000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 8, 0, 30, 0, 1, 0);
    aot_set(AOT_0C_NONE, 9500, 8200, 500, 800, SCE_NONE, SAT_MANUAL, 0, 0, 0, 0, 0, 0);
#if CHRIS
    aot_set(AOT_0D_EVENT, 9500, 8200, 500, 800, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    aot_set(AOT_0E_USEITEM, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 9, 0, 8, 0, 1, 0);
    aot_set(AOT_0F_USEITEM, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 4, 0, 36, 0, 1, 0);
    obj(OBJ_00, 53, 255, 9100, 0, 12576, 1024, 62, 254, 0, 0, 194, 1, 0, 0, 84, 6, 24, 21, 128, 62, 144, 1);
#else
    aot_set(AOT_0D_USEITEM, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 9, 0, 8, 0, 1, 0);
    aot_set(AOT_0E_USEITEM, 10200, 7300, 600, 1500, SCE_USEITEM, SAT_PLAYER, 4, 0, 35, 0, 1, 0);
    obj(OBJ_00, 53, 255, 9100, 0, 12576, 1024, 62, 254, 0, 0, 194, 1, 0, 0, 84, 6, 24, 21, 128, 62, 194, 1);
#endif
    obj(OBJ_01, 1, 255, 17394, 0, 11190, 1024, 0, 0, 108, 3, 0, 0, 148, 252, 44, 1, 32, 2, 20, 5, 38, 2);
    obj(OBJ_02, 35, 255, 15000, 0, 11200, 1024, 0, 0, 0, 0, 0, 0, 0, 0, 88, 2, 32, 2, 132, 3, 88, 2);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_A2, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_A0, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_A1, TRUE))
            {
                evt_exec(0, TASK_00, on_enter_2);
            }
            else
            {
                evt_exec(0, TASK_09, on_enter);
                aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 146, 125, 0);
            }
        }
    }
    else
    {
        evt_exec(0, TASK_09, on_enter_3);
    }
    evt_exec(0, TASK_09, on_enter_4);
    if (ck(FG_COMMON, F_COMMON_A2, FALSE))
    {
        enemy(EM_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 424, 0, 0, 200, 0, 500, ENEMY_00_NPC_REBECCA, 0, 0, 0);
    }
    else if (ck(FG_COMMON, F_COMMON_A9, FALSE))
    {
        enemy(EM_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 3224, 0, 0, 9600, 0, 8100, ENEMY_00_NPC_REBECCA, 0, 0, 0);
    }
#else
    if (ck(FG_COMMON, F_COMMON_A5, TRUE))
    {
        evt_exec(0, TASK_09, on_enter);
    }
    evt_exec(0, TASK_09, on_enter_2);
#endif
}

proc main
{
    if (testitem(IT_23_KEY_MUSIC_SCORE))
    {
#if CHRIS
        if (ck(FG_ROOM, F_ROOM_24, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_62, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_61, TRUE))
                {
                    if (ck(FG_COMMON, F_COMMON_24, FALSE))
                    {
                        evt_exec(0, TASK_09, from_main);
                    }
                    else
                    {
                        evt_exec(0, TASK_09, from_main_2);
                    }
                }
                else
                {
                    evt_exec(0, TASK_09, from_main_6);
                }
            }
            else if (ck(FG_COMMON, F_COMMON_24, FALSE))
            {
                evt_exec(0, TASK_09, from_main);
            }
            else
            {
                evt_exec(0, TASK_09, from_main_2);
            }
        }
#else
        if (ck(FG_ROOM, F_ROOM_23, TRUE))
        {
            evt_exec(0, TASK_09, from_main);
        }
#endif
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_A4, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_A3, TRUE))
        {
            aot_delete(AOT_06_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM, SCE_USEITEM, SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_06_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM, SCE_NONE, SAT_PLAYER);
        }
        if (testpickup(IT_20_KEY_EMBLEM_GOLD))
        {
            set(FG_COMMON, F_COMMON_A3, TRUE);
            evt_exec(0, TASK_09, from_main_3);
        }
        if (testitem(IT_1F_KEY_EMBLEM_WOOD))
        {
            if (ck(FG_ROOM, F_ROOM_23, TRUE))
            {
                set(FG_ITEM, F_ITEM_14, TRUE);
                set(FG_COMMON, F_COMMON_A4, TRUE);
                objtbl_b_set(1, 0, 1);
                aot_delete(AOT_03_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                evt_exec(0, TASK_09, from_main_4);
                evt_exec(0, TASK_09, from_main_5);
            }
        }
        if (testitem(IT_20_KEY_EMBLEM_GOLD))
        {
            if (ck(FG_ROOM, F_ROOM_22, TRUE))
            {
                set(FG_ITEM, F_ITEM_15, TRUE);
                objtbl_b_set(1, 1, 1);
                aot_delete(AOT_04_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                evt_exec(0, TASK_09, from_main_4);
                set(FG_COMMON, F_COMMON_A3, FALSE);
            }
        }
        if (ck(FG_COMMON, F_COMMON_A2, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_A9, FALSE))
            {
                aot_delete(AOT_01_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                aot_reset(AOT_0D_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0d, 0);
            }
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_A2, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_A9, FALSE))
            {
                aot_delete(AOT_01_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
                aot_reset(AOT_0D_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_0d_2, 0);
            }
        }
        aot_delete(AOT_06_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_07_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_08_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_09_USEITEM, SCE_NONE, SAT_PLAYER);
    }
    if (ck(FG_COMMON, F_COMMON_A4, TRUE))
    {
        aot_reset(AOT_0A_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 255, 0);
    }
    else if (ck(FG_COMMON, F_COMMON_A3, TRUE))
    {
        aot_reset(AOT_0A_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 152, 255, 0);
    }
    else
    {
        aot_delete(AOT_0A_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
#else
    if (ck(FG_COMMON, F_COMMON_A5, TRUE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
        {
            aot_switch(0, 14, 1);
        }
    }
    if (ck(FG_COMMON, F_COMMON_A7, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_A6, TRUE))
        {
            aot_delete(AOT_06_USEITEM, SCE_USEITEM, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM, SCE_USEITEM, SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_06_USEITEM, SCE_NONE, SAT_PLAYER);
            aot_delete(AOT_07_USEITEM, SCE_NONE, SAT_PLAYER);
        }
        if (testpickup(IT_20_KEY_EMBLEM_GOLD))
        {
            set(FG_COMMON, F_COMMON_A6, TRUE);
            evt_exec(0, TASK_09, from_main_2);
        }
        if (testitem(IT_1F_KEY_EMBLEM_WOOD))
        {
            if (ck(FG_ROOM, F_ROOM_22, TRUE))
            {
                set(FG_ITEM, F_ITEM_14, TRUE);
                set(FG_COMMON, F_COMMON_A7, TRUE);
                objtbl_b_set(1, 0, 1);
                aot_delete(AOT_03_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                evt_exec(0, TASK_09, from_main_3);
                evt_exec(0, TASK_09, from_main_4);
            }
        }
        if (testitem(IT_20_KEY_EMBLEM_GOLD))
        {
            if (ck(FG_ROOM, F_ROOM_21, TRUE))
            {
                set(FG_ITEM, F_ITEM_15, TRUE);
                objtbl_b_set(1, 1, 1);
                aot_delete(AOT_04_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
                evt_exec(0, TASK_09, from_main_3);
                set(FG_COMMON, F_COMMON_A6, FALSE);
            }
        }
    }
    else
    {
        aot_delete(AOT_06_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_07_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_08_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_09_USEITEM, SCE_NONE, SAT_PLAYER);
    }
    if (ck(FG_COMMON, F_COMMON_A7, TRUE))
    {
        aot_reset(AOT_0A_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 255, 0);
    }
    else if (ck(FG_COMMON, F_COMMON_A6, TRUE))
    {
        aot_reset(AOT_0A_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 152, 255, 0);
    }
    else
    {
        aot_delete(AOT_0A_MESSAGE, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
    }
#endif
}

#if CHRIS
event on_enter_2_sub1
{
    sleep(100);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 5, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 6, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    evt_finish();
}

#endif
event from_main
{
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
#if CHRIS
        remove_item(IT_23_KEY_MUSIC_SCORE);
        set(FG_COMMON, F_COMMON_A0, TRUE);
        message(MSG_CHRIS_UNFORTUNATELY_CANNOT_READ_MUSIC | MSG_FAST, 0); // "Chris unfortunately can't read music."
#else
        message(MSG_IT_IS_MOONLIGHT_SONATA | MSG_FAST, 0); // "It's “Moonlight Sonata"."
        set(FG_STATUS, F_STATUS_0F, TRUE);
#endif
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
#if CHRIS
    set(FG_STATUS, F_STATUS_0F, TRUE);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_flag_op(0, 0, 0);
    act_reset();
    evt_nop();
    pos_set(ENEMY_00_NPC_REBECCA, 0, 2400, 0, 14000, 0, 3000);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(32770, 8229, 8220);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    set(FG_ROOM, F_ROOM_20, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(57350, 19502, 8221);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 300, 0, 40, 70);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 23, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    sleep(30);
    bgm_play(BGM_SUB_2);
    sleep(9);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 24, 32 | 0, 0 | 0);
#if MANSION1
    sleep(15);
#else
    sleep(55);
#endif
    act_anim_flags(32 | 25, 32 | 0, 0 | 0);
#if MANSION1
    sleep(95);
#else
    sleep(75);
#endif
    act_anim_flags(32 | 24, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_POINT, 0, 14365, 2290);
    sleep(10);
    bgm_stop(BGM_SUB_2);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_reset();
    evt_nop();
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 14, 32 | 0, 0 | 0);
    act_param_set(0, 4);
    act_flag_op(0, 2, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    act_anim_seq(52227, 28709, 8215);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    act_anim_seq(43014, 1071, 8208);
    act_nop();
    act_flag_op(0, 2, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 0, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    sleep(30);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 14365, 2290);
    cutnext(CAM_05);
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_flags(32 | 6, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    voice_play(VOICE_PLAY, VO_006_00, 0);
    message(MSG_VO_006_00, 0);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_flags(32 | 3, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    evt_actor_begin();
    act_anim_flags(32 | 0, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
