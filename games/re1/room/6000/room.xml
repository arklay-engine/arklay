    <language lang="ja-JP">
      <string key="save_name">館 {s}小部屋/{s}1{s}F{s}</string>
      <string key="0">{scroll 0}\n       レベッカ{scroll 2}{timed 105}</string>
      <string key="1">{scroll 0}\n       クリス{scroll 2}{timed 50}</string>
      <string key="2">{scroll 0}\n    ああ! 無事だったか{scroll 2}{timed 80}</string>
      <string key="3">{scroll 0}\n   ごめんなさい 心配かけて{scroll 2}{clear 75}{scroll 0}\n     ここはもうだめだ{scroll 2}{timed 75}</string>
      <string key="4">{scroll 0}  かなり危険だが 仲間を捜し\n  血路を見出すしかなさそうだ{scroll 2}{timed 150}</string>
      <string key="5">{scroll 0}\n       やれるか{scroll 2}{timed 45}</string>
      <string key="6">{scroll 0}\n       はい!{scroll 2}{timed 50}</string>
      <string key="7">{scroll 0}  まず俺が先に行く あとは\n  自分で判断して行動するんだ{scroll 2}{clear 135}{scroll 0}\n       できるな{scroll 2}{timed 60}</string>
      <string key="8">{scroll 0}\n       やります{scroll 2}{timed 60}</string>
      <string key="9">{scroll 0}\n       頼むぞ{scroll 2}{timed 45}</string>
      <string key="10">{scroll 0}\n     がんばります!{scroll 2}{timed 45}</string>
      <string key="11">\n    もう血清は必要ない{scroll 2}</string>
      <string key="12">\n  ビタミン剤や血清が並んでいる{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Chambre RdC</string>
      <string key="0">{scroll 0}\nRebecca!{scroll 2}{timed 105}</string>
      <string key="1">{scroll 0}\nChris!{scroll 2}{timed 50}</string>
      <string key="2">{scroll 0}Dieu merci, \nvous êtes saine et sauve.{scroll 2}{timed 80}</string>
      <string key="3">{scroll 0}Je suis désolée de vous \navoir fait peur.{scroll 2}{clear 75}{scroll 0}\nNous courons un grand danger.{scroll 2}{timed 75}</string>
      <string key="4">{scroll 0}\nIl faut nous organiser pour{scroll 2}{clear 50}{scroll 0}retrouver les autres et\nficher le camp d'ici!{scroll 2}{timed 100}</string>
      <string key="5">{scroll 0}\nCompris?{scroll 2}{timed 45}</string>
      <string key="6">{scroll 0}\nÀ vos ordres!{scroll 2}{timed 50}</string>
      <string key="7">{scroll 0}OK, j'y vais le premier,\nsuivez votre instinct.{scroll 2}{clear 135}{scroll 0}D'accord? \nVous pouvez le faire?{scroll 2}{timed 60}</string>
      <string key="8">{scroll 0}\nOui!{scroll 2}{timed 60}</string>
      <string key="9">{scroll 0}\nBonne chance.{scroll 2}{timed 45}</string>
      <string key="10">{scroll 0}À vos ordres! \nJe ferai de mon mieux!{scroll 2}{timed 45}</string>
      <string key="11">\nJe n'ai plus besoin de sérum.{scroll 2}</string>
      <string key="12">\nDes vitamines et des sérums.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 0}\nRebecca!{scroll 2}{timed 105}</string>
      <string key="1">{scroll 0}\nChris!{scroll 2}{timed 50}</string>
      <string key="2">{scroll 0}\nGott sei Dank bist du wohlauf.{scroll 2}{timed 80}</string>
      <string key="3">{scroll 0}Es tut mir Leid, dass du dir\nwegen mir Sorgen gemacht hast.{scroll 2}{clear 75}{scroll 0}\nWir sind in höchster Gefahr.{scroll 2}{timed 75}</string>
      <string key="4">{scroll 0}Wir müssen die Suche nach den\nanderen organisieren und dann{scroll 2}{clear 45}{scroll 0}verdammt noch mal zusehen,\ndass wir hier rauskommen!{scroll 2}{timed 100}</string>
      <string key="5">{scroll 0}\nKapiert?{scroll 2}{timed 45}</string>
      <string key="6">{scroll 0}\nJa, Sir!{scroll 2}{timed 50}</string>
      <string key="7">{scroll 0}Okay, ich werde vorausgehen,\nob du nachkommst,{scroll 2}{clear 67}{scroll 0}überlass ich deiner\nEntscheidung.{scroll 2}{clear 68}{scroll 0}Alles klar?\nSchaffst du es?{scroll 2}{timed 60}</string>
      <string key="8">{scroll 0}\nJa, tu ich!{scroll 2}{timed 60}</string>
      <string key="9">{scroll 0}\nViel Glück.{scroll 2}{timed 45}</string>
      <string key="10">{scroll 0}Ja, Sir!\nIch werde mein Bestes tun!{scroll 2}{timed 95}</string>
      <string key="11">Ich brauche nichts mehr\nvon dem Serum.{scroll 2}</string>
      <string key="12">\nVitamine und Seren.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Villa 1P</string>
      <string key="0">{scroll 0}\nRebecca!{scroll 2}{timed 105}</string>
      <string key="1">{scroll 0}\nChris!{scroll 2}{timed 50}</string>
      <string key="2">{scroll 0}Grazie a Dio \nsei in salvo.{scroll 2}{timed 80}</string>
      <string key="3">{scroll 0}Mi spiace averti \nspaventato. {scroll 2}{clear 75}{scroll 0}\nSiamo in guai seri.{scroll 2}{timed 75}</string>
      <string key="4">{scroll 0}\nDobbiamo organizzarci per{scroll 2}{clear 45}{scroll 0}trovare gli altri \nè andarcene di qui!{scroll 2}{timed 105}</string>
      <string key="5">{scroll 0}\nCapito?{scroll 2}{timed 45}</string>
      <string key="6">{scroll 0}\nAgli ordini!{scroll 2}{timed 50}</string>
      <string key="7">{scroll 0}OK, andrò per primo. \nSegui il tuo intuito. {scroll 2}{clear 135}{scroll 0}D'accordo? \nPuoi farlo?{scroll 2}{timed 60}</string>
      <string key="8">{scroll 0}\nSi!{scroll 2}{timed 60}</string>
      <string key="9">{scroll 0}\nBuona fortuna.{scroll 2}{timed 45}</string>
      <string key="10">{scroll 0}Agli ordini! \nFarò del mio meglio!{scroll 2}{timed 95}</string>
      <string key="11">\nNon ho più bisogno del siero.{scroll 2}</string>
      <string key="12">\nVitamine e sieri.{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 0}\n¡Rebecca!{scroll 2}{timed 105}</string>
      <string key="1">{scroll 0}\n¡Chris!{scroll 2}{timed 50}</string>
      <string key="2">{scroll 0}\n¡Gracias a Dios estás bien!{scroll 2}{timed 80}</string>
      <string key="3">{scroll 0}Siento que estuvieras\npreocupado por mí.{scroll 2}{clear 75}{scroll 0}\n¡Corremos un gran peligro!{scroll 2}{timed 75}</string>
      <string key="4">{scroll 0}\n¡Tenemos que buscar a los{scroll 2}{clear 45}{scroll 0}otros y salir de aquí\nechando leches!{scroll 2}{timed 100}</string>
      <string key="5">{scroll 0}\n¿Comprendido?{scroll 2}{timed 45}</string>
      <string key="6">{scroll 0}\n¡Sí, señor!{scroll 2}{timed 50}</string>
      <string key="7">{scroll 0}¡Vale, iré primero!\nActúa según tu criterio.{scroll 2}{clear 135}{scroll 0}\n¿Vale? ¿Puedes hacerlo?{scroll 2}{timed 60}</string>
      <string key="8">{scroll 0}\nSí, ¡puedo hacerlo!{scroll 2}{timed 60}</string>
      <string key="9">{scroll 0}\n¡Buena suerte!{scroll 2}{timed 45}</string>
      <string key="10">{scroll 0}¡Sí, señor!\n¡Lo haré lo mejor que pueda!{scroll 2}{timed 95}</string>
      <string key="11">No necesito más\nsuero...{scroll 2}</string>
      <string key="12">\nVitaminas y sueros...{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Мед. комната 1-эт.</string>
      <string key="0">{scroll 0}\n{scroll 2}{timed 105}</string>
      <string key="1">{scroll 0}\n{scroll 2}{timed 50}</string>
      <string key="2">{scroll 0}\n{scroll 2}{timed 80}</string>
      <string key="3">{scroll 0}\n{scroll 2}{clear 75}{scroll 0}\n{scroll 2}{timed 75}</string>
      <string key="4">{scroll 0}\n{scroll 2}{timed 150}</string>
      <string key="5">{scroll 0}\n{scroll 2}{timed 45}</string>
      <string key="6">{scroll 0}\n{scroll 2}{timed 50}</string>
      <string key="7">{scroll 0}\n{scroll 2}{clear 135}{scroll 0}\n{scroll 2}{timed 60}</string>
      <string key="8">{scroll 0}\n{scroll 2}{timed 60}</string>
      <string key="9">{scroll 0}\n{scroll 2}{timed 45}</string>
      <string key="10">{scroll 0}\n{scroll 2}{timed 45}</string>
      <string key="11">Мне больше не нужна\nсыворотка.{scroll 2}</string>
