    <language lang="fi-FI">
      <string key="save_name">Lääkevarasto 1 krs</string>
      <string key="0">{scroll 0}Rebecca!{scroll 2}{timed 105}</string>
      <string key="1">{scroll 0}Chris!{scroll 2}{timed 50}</string>
      <string key="2">{scroll 0}Luojan kiitos olet kunnossa!{scroll 2}{timed 80}</string>
      <string key="3">{scroll 0}Anteeksi että jouduit olemaan\nhuolissasi minusta.{scroll 2}{clear 75}{scroll 0}Täällä on todella vaarallista!{scroll 2}{timed 75}</string>
      <string key="4">{scroll 0}Meidän on pian löydettävä muut{scroll 2}{clear 45}{scroll 0}jotta voimme lähteä helvettiin\ntäältä!{scroll 2}{timed 100}</string>
      <string key="5">{scroll 0}Ymmärretty?{scroll 2}{timed 45}</string>
      <string key="6">{scroll 0}Kyllä, herra!{scroll 2}{timed 50}</string>
      <string key="7">{scroll 0}Minä menen ensin. Jatka etsintöjä\noman harkinnan mukaan.{scroll 2}{clear 135}{scroll 0}Pystytkö siihen?{scroll 2}{timed 60}</string>
      <string key="8">{scroll 0}Kyllä pystyn!{scroll 2}{timed 60}</string>
      <string key="9">{scroll 0}Onnea matkaan!{scroll 2}{timed 45}</string>
      <string key="10">{scroll 0}Kyllä, herra! Teen parhaani!{scroll 2}{timed 95}</string>
      <string key="11">En tarvitse enää seerumia...{scroll 2}</string>
      <string key="12">Vitamiineja ja seerumeita...{scroll 2}</string>
    </language>
