    <language lang="fi-FI">
      <string key="save_name">Asuntolan varasto 1 krs</string>
      <string key="0">{scroll 0}{scroll 1}{clear 20}{scroll 0}Uskomatonta!{scroll 1}{clear 60}{scroll 0}Oletko kunnossa?{scroll 1}{timed 60}</string>
      <string key="1">{scroll 0}Kyllä, toisin kuin tuo.\nTaisimme löytää ongelman juurisyyn.{scroll 1}{clear 155}{scroll 0}Pelastit minut.{scroll 1}{timed 55}</string>
      <string key="2">{scroll 0}Minä, tuota...{scroll 1}{timed 55}</string>
      <string key="3">{scroll 0}Oikeasti, kiitos.{scroll 1}{timed 62}</string>
      <string key="4">{scroll 0}Tekisit saman minulle.{scroll 1}{timed 100}</string>
      <string key="5">{scroll 0}Aivan varmasti.{scroll 1}{timed 62}</string>
      <string key="6">{scroll 0}Pystyn tekemään lisää\nparannustarvikkeita.{scroll 1}{clear 70}{scroll 0}Palaan takaisin lääkehuoneeseen.{scroll 1}{clear 70}{scroll 0}Löydän minut sieltä.{scroll 1}{timed 50}</string>
      <string key="7">{scroll 0}Olen iloinen että olet kunnossa.{scroll 1}{timed 95}</string>
      <string key="8">{scroll 0}Chris, tämä on Richardin radio.{scroll 1}{timed 80}</string>
      <string key="9">{scroll 0}Hän yritti hetki sitten ottaa\nmeihin yhteyttä{scroll 1}{clear 90}{scroll 0}kun olin sisäpihalla.{scroll 1}{clear 40}{scroll 0}Hän vielä lentelee tällä\nalueella.{scroll 1}{clear 60}{scroll 0}Selvästikkään hän ei kuullut\nvastaustani.{scroll 1}{timed 80}</string>
      <string key="10">{scroll 0}Tämä radio taitaa olla rikki.{scroll 1}{timed 80}</string>
      <string key="11">{scroll 0}Ymmärrän. Pidän sitä silmällä.{scroll 1}{clear 100}{scroll 0}Meidän pitää jotenkin antaa\nhänelle merkki että olemme täällä.{scroll 1}{timed 100}</string>
      <string key="12">{scroll 0}Taidan pystyä tekemään\nlääkintätarvikkeita{scroll 1}{clear 100}{scroll 0}aikaisemmin käymässäni\nlääkehuoneessa.{scroll 1}{timed 80}</string>
      <string key="13">Ovi ei liikahdakkaan...{clear 0}Aivan kuin sen taakse olisi\npinottu jotakin painavaa...</string>
      <string key="14">Ovi ei liikahdakkaan...{clear 0}Aivan kuin sen taakse olisi\npinottu jotakin painavaa...</string>
      <string key="15">Se on lukossa...</string>
