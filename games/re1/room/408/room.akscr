#define F_ROOM_20 0x20
#define F_ROOM_21 0x21
#define IMDL_00 0x00
#define IMDL_01 0x01
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_00A_20 0x0E
#define VO_00A_21 0x0F
#define VO_00A_22 0x10
#define VO_00A_23 0x11
#define VO_00A_24 0x12
#define VO_00A_25 0x13
#define VO_00A_26 0x14
#define VO_00A_27 0x15
#define VO_00A_28 0x16
#define VO_00A_29 0x17
#define VO_00A_2A 0x18
#define VO_00A_2B 0x19
#define VO_00A_2C 0x1A

proc init
{
    door_aot_set(AOT_00_DOOR, 0, 2200, 3000, 2100, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, ROOM_405_CENTER_PASSAGE, 23200, 0, 8800, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 5500, 9400, 3000, 1800, 1, DOOR_SND_00_DR_WD, DOOR_07_DOOR07, 1, 0, ROOM_409_DRUG_STOREHOUSE, 9000, 0, 3000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 18200, 6500, 3000, 2000, 1, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, DOOR_LOCKED | F_LOCK_2A, ROOM_40A_ROOM_003, 2900, 0, 2800, 0, IT_3A_KEY_GUARDHOUSE_003, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_SCENARIO, F_SCENARIO_44, TRUE))
    {
        if (CHRIS)
        {
            door_aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, 12, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCK_40, ROOM_40C_PLANT_BOSS_ROOM, 3000, 0, 10200, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            door_aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, 12, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_40C_PLANT_BOSS_ROOM, 3000, 0, 10200, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        }
    }
    else
    {
        if (CHRIS)
        {
            aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 141, 0, 255, 0, 0, 0);
        }
        else
        {
            aot_set(AOT_03_DOOR, 27800, 2100, 3000, 4000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 14, 0, 255, 0, 0, 0);
        }
    }
    aot_set(AOT_04_USEITEM, 7200, 11000, 800, 800, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER, 0, 0, 32, 0, 1, 0);
    item_aot_set(AOT_05_ITEM, 15000, 21700, 2000, 1000, IT_39_KEY_GUARDHOUSE_002, 1, IMDL_00, SCA_NONE, 0, 0, 0, 1024, F_ITEM_48, SAT_MANUAL | SAT_PLAYER, 0);
    if (CHRIS)
    {
        item_aot_set(AOT_06_ITEM, 0, 0, 1, 1, IT_4D_KEY_RADIO, 1, IMDL_01, SCA_NONE, 0, 0, 0, 1024, F_ITEM_08, SAT_MANUAL | SAT_PLAYER, 0);
        if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_3D, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_AA, FALSE))
                {
                    evt_exec(0, TASK_09, on_enter_2);
                }
            }
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_AE, TRUE))
        {
            set(FG_COMMON, F_COMMON_B1, TRUE);
        }
    }
    set(FG_ROOM, F_ROOM_1D, TRUE);
    aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 143, 255, 0);
    evt_exec(0, TASK_09, on_enter);
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_38, TRUE) && ck(FG_COMMON, F_COMMON_AD, FALSE))
        {
            set(FG_COMMON, F_COMMON_AD, TRUE);
            evt_exec(0, TASK_09, on_enter_3);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_00, TRUE))
        {
            if (ck(FG_COMMON, F_COMMON_3D, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_AA, FALSE))
                {
                    enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 3900, 0, 24100, 0, 3200, ENEMY_00_NPC_REBECCA, ANIM_00, 0, EVAR_00);
                }
            }
        }
    }
    else
    {
        enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 17600, -4000, 22700, ENEMY_00_WASP, ANIM_00, 0, EVAR_00);
    }
    enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 17600, -4000, 22700, ENEMY_01_WASP, ANIM_00, 0, EVAR_00);
    enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 17600, -3500, 22600, ENEMY_02_WASP, ANIM_00, 0, EVAR_00);
    enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 17700, -4000, 22700, ENEMY_03_WASP, ANIM_00, 0, EVAR_00);
    enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 17800, -3500, 22800, ENEMY_04_WASP, ANIM_00, 0, EVAR_00);
    enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 17900, -4000, 22800, ENEMY_05_WASP, ANIM_00, 0, EVAR_00);
    enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 18000, -3500, 22900, ENEMY_06_WASP, ANIM_00, 0, EVAR_00);
    enemy(EM_07_WASP, EB_10, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 18000, -4000, 22900, ENEMY_07_WASP, ANIM_00, 0, EVAR_00);
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_21, TRUE))
    {
        aot_delete(AOT_01_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
    }
    return;
}

event on_enter
{
    evt_work_set(WK_AOT, IMDL_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 15520, -1590, 22430);
    tw_abs_rot(0, 1020, 800, -1070);
    tw_end();
    evt_nop();
    evt_finish();
}

