    sleep(10);
    tw_end();
    evt_nop();
    aot_reset(AOT_01_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
    run
    {
        if (ck(FG_STATUS, F_STATUS_08, FALSE))
        {
            voice_play(VOICE_PLAY, VO_016_05, 0);
            message(MSG_VO_016_05, 0);
        }
        else
        {
            voice_play(VOICE_PLAY, VO_11B_03, 0);
            message(MSG_VO_11B_03, 0);
        }
    }
    wait_message();
    run
    {
        set(FG_MESSAGE, F_MESSAGE_PLAYER, TRUE);
        set(FG_MESSAGE, F_MESSAGE_ENTITIES, TRUE);
        set(FG_MESSAGE, F_MESSAGE_MONSTERS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_EFFECTS, TRUE);
        set(FG_MESSAGE, F_MESSAGE_1B, TRUE);
        set(FG_MESSAGE, F_MESSAGE_1A, TRUE);
        set(FG_MESSAGE, F_MESSAGE_READY, TRUE);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        mass_mask(1, 0, 128);
        cutcurr(0);
    }
    evt_finish();
}

event from_main_3_sub2_sub1
{
    run
    {
        objtbl_b_set(0, 1, 15);
        objtbl_b_set(0, 2, 15);
        objtbl_b_set(0, 3, 15);
        objtbl_b_set(0, 4, 15);
    }
    evt_work_set(WK_OBJ, OBJ_01);
    evt_tween_begin_alt();
    tw_set_rot(0, 127, 0);
    tw_rot_add();
    tw_rot_add();
    tw_rot_add();
    tw_end();
    evt_work_set(WK_OBJ, OBJ_02);
    evt_tween_begin_alt();
    tw_set_rot(0, 127, 0);
    tw_rot_add();
    tw_rot_add();
    tw_rot_add();
    tw_end();
    evt_work_set(WK_OBJ, OBJ_03);
    evt_tween_begin_alt();
    tw_set_rot(0, 127, 0);
    tw_rot_add();
    tw_rot_add();
    tw_rot_add();
    tw_end();
    evt_work_set(WK_OBJ, OBJ_04);
    evt_tween_begin_alt();
    tw_set_rot(0, 127, 0);
    tw_rot_add();
    tw_rot_add();
    tw_rot_add();
    tw_end();
    evt_next();
    evt_nop();
    run
    {
        objtbl_b_set(0, 1, 0);
        objtbl_b_set(0, 2, 0);
        objtbl_b_set(0, 3, 0);
        objtbl_b_set(0, 4, 0);
    }
    evt_next();
    evt_nop();
    evt_chain(1);
    evt_finish();
}

event from_main_3_sub2_sub2
{
