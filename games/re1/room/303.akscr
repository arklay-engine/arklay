event from_main_2
{
    set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    sleep(10);
    act_reset();
    evt_nop();
    set(FG_STATUS, F_STATUS_0F, TRUE);
    sleep(15);
    objtbl_b_set(1, 1, 15);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 0);
    act_flag_op(0, 1, 0);
    sleep(25);
    act_motion_path(50, 0, 150, 0, 192, 40);
    act_reset();
    evt_nop();
    sleep(25);
    run
    {
        voice_play(VOICE_PLAY, VO_B00_30, 0);
        effect(FX_0B, 0, 1, 32, 3, 0, 0, 200, 0, 0, 0);
        objtbl_b_set(1, 1, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 65224, 0, 192, 30);
    sleep(30);
    act_motion(16);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_STATUS, F_STATUS_0E, TRUE));
    run
    {
        sys_multi(SYS_07);
        if (ck(FG_ROOM, F_ROOM_00, FALSE))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
        }
        else if (ck(FG_ROOM, F_ROOM_01, FALSE))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
        }
        else if (ck(FG_ROOM, F_ROOM_02, FALSE))
        {
            set(FG_ROOM, F_ROOM_02, TRUE);
        }
        set(FG_ROOM, F_ROOM_05, FALSE);
    }
    evt_finish();
}

event from_main_3
{
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 10, 10);
        bgm_play(BGM_SUB_1);
    }
    sleep(20);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 30, 30);
    }
    sleep(20);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 50, 50);
    }
    sleep(20);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 70, 70);
    }
    sleep(20);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 95, 95);
    }
    sleep(20);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 120, 120);
    }
    sleep(20);
    cut_auto(1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(147, 2, 5, 0, 192, 64);
    sleep(4);
    act_anim_seq(2054, 4178, 8231);
    act_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_20, FALSE));
    act_reset();
    evt_nop();
    sleep(10);
    run
    {
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(180);
    evt_fork(TASK_03, from_main_3_sub2, 0);
    evt_fork(TASK_04, from_main_3_sub1, 0);
    evt_fork(TASK_05, from_main_3_sub4, 0);
    evt_fork(TASK_06, from_main_3_sub5, 0);
    run
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
        {
            set(FG_ROOM, F_ROOM_0F, TRUE);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
        {
            set(FG_ROOM, F_ROOM_10, TRUE);
        }
        bank_bit(255);
