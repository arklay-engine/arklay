  <strings>
    <language lang="en-US">
      <string key="save_name">Hall 1F</string>
      <string key="0">It's dusty. It has not \nbeen used for a long time.{scroll 2}</string>
      <string key="1">A freezer. It has not\nbeen used for a long time.{scroll 2}</string>
      <string key="2">\nAn oven.{clear 0}It's badly rusted and does\nnot seem to work.{scroll 2}</string>
      <string key="3">A gas cooking stove. The\ngas is not supplied.{scroll 2}</string>
      <string key="4">\nWater is not supplied.{scroll 2}</string>
      <string key="5">Dark blood sticks to it.\nWhat did they cook here?{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">館 {s}ホ{s}ー{s}ル{s}/{s}1{s}F{s}</string>
      <string key="0">  やけにほこりっぽい\n  長い間使っていないのだろう{scroll 2}</string>
      <string key="1">  フリーザーが置かれている\n  長い間使われていないようだ{scroll 2}</string>
      <string key="2">\n     オーブンがある{clear 0}  まっ赤にサビてしまっていて\n  使いものになりそうにない{scroll 2}</string>
      <string key="3">\n ガスコンロだ ガスは来ていない{scroll 2}</string>
      <string key="4">\n   水はとまってしまっている{scroll 2}</string>
      <string key="5"> くろずんだ血がこびりついている\n 一体何を調理したのだろう・・・{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Hall RdC</string>
      <string key="0">\nC'est poussiéreux. {scroll 2}{clear 0}Cela n'a pas été utilisé \ndepuis longtemps.{scroll 2}</string>
      <string key="1">Un congélateur. Il n'a pas\nété utilisé depuis longtemps.{scroll 2}</string>
      <string key="2">\nUn four.{clear 0}C'est rouillé et ça ne \nfonctionne pas.{scroll 2}</string>
      <string key="3">Une cuisinière à gaz. Le\ngaz est coupé.{scroll 2}</string>
      <string key="4">\nL'eau est coupée.{scroll 2}</string>
      <string key="5">Il y a du sang séché.\nQu'ont-ils cuisiné ici?{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">Er ist staubig. Er wurde schon\nlange nicht mehr benutzt.{scroll 2}</string>
      <string key="1">Ein Gefrierschrank. War wohl\nlang nicht mehr in Betrieb.{scroll 2}</string>
      <string key="2">\nEin Ofen.{clear 0}Er ist furchtbar rostig\nund funtioniert nicht mehr.{scroll 2}</string>
      <string key="3">Ein Gasherd.\nEs ist kein Gas angeschlossen.{scroll 2}</string>
      <string key="4">\nEs fließt kein Wasser.{scroll 2}</string>
      <string key="5">Dunkles Blut klebt daran.\nWas haben die hier gekocht?{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Atrio 1P</string>
      <string key="0">È polveroso. {scroll 2}{clear 0}Non viene utilizzato \nda parecchio tempo.{scroll 2}</string>
      <string key="1">Un congelatore. Non viene \nutilizzato da tempo.{scroll 2}</string>
      <string key="2">Un forno.{clear 0}È pieno di ruggine e \nsembra non funzionare.{scroll 2}</string>
      <string key="3">Una cucina a gas. \nIl gas non fuoriesce.{scroll 2}</string>
      <string key="4">\nNon c'è acqua.{scroll 2}</string>
      <string key="5">C'è del sangue rappreso. \nCosa cucinavano qui?{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">Están oxidados...\nNo se han usado en mucho tiempo.{scroll 2}</string>
      <string key="1">Un frigorífico...\nNo se ha usado en mucho tiempo.{scroll 2}</string>
      <string key="2">\nUn horno...{clear 0}Está muy oxidado y\nno parece funcionar...{scroll 2}</string>
      <string key="3">Un hornillo de gas... \nPero no hay gas...{scroll 2}</string>
      <string key="4">\nNo hay agua...{scroll 2}</string>
      <string key="5">Tiene pegada sangre oscura...\n¿Qué cocinaban aquí?{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Зал 1-эт.</string>
      <string key="0">Всё в пыли. К шкафам\nдавно не прикасались..{scroll 2}</string>
      <string key="1">\nМорозилка.\nДавно не использовалась.{scroll 2}</string>
      <string key="2">Ржавая печь.\nПохоже уже не работает.{scroll 2}</string>
      <string key="3">Газовая плита для приготовления\nпищи. Газа уже нет.{scroll 2}</string>
      <string key="4">\nВоды нет.{scroll 2}</string>
      <string key="5">Темные кровавые пятна.\nЧто здесь готовили?{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Pääaula 1 krs</string>
      <string key="0">Se on pölyinen...  Sitä ei ole\nkäytetty pitkään aikaan...{scroll 2}</string>
      <string key="1">Jääkaappi... sitä ei ole käytetty \npitkään aikaan...{scroll 2}</string>
      <string key="2">Uuni...{clear 0}Se on pahasti ruostunut eikä\nnäytä toimivan...{scroll 2}</string>
      <string key="3">Kaasuliesi... Siihen ei kulje\nkaasua...{scroll 2}</string>
      <string key="4">Vesi on katkaistu...{scroll 2}</string>
      <string key="5">Pinttyneitä veritahroja...\nMitä täällä on kokkailtu?{scroll 2}</string>
    </language>
  </strings>
</room>
