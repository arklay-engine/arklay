}

event on_aot_03_sub1
{
    run
    {
        cut_auto(1);
        cutnext(4);
        cut_auto(0);
        msg_list(0, 158, 30, 48, 248, 95, 33, 255, 255, 255, 0, 216, 29, 112, 33, 48, 248, 184, 21, 117, 117, 116, 0, 140, 29, 112, 23, 48, 248, 68, 22, 117, 117, 116, 0, 184, 26, 224, 3, 144, 4, 240, 3);
    }
    sleep(1);
    run
    {
        if (ck(FG_ROOM, F_ROOM_19, TRUE))
        {
            evt_exec(0, 9, on_aot_03_sub1_sub1);
        }
        else
        {
            evt_exec(0, 9, on_aot_03_sub1_sub2);
        }
    }
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_1A, FALSE));
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_1A, FALSE));
    run
    {
        set(FG_ROOM, F_ROOM_1A, FALSE);
        set(FG_6, F_6_1F, TRUE);
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        set(FG_6, F_6_19, TRUE);
    }
    evt_finish();
}

event on_aot_03_sub2
{
    run
    {
        cut_auto(1);
        cutnext(0);
        cut_auto(0);
        msg_list(0, 42, 11, 64, 237, 73, 25, 255, 255, 255, 0, 88, 32, 8, 32, 144, 232, 32, 28, 128, 128, 150, 0, 24, 31, 168, 22, 0, 0, 204, 16, 72, 72, 128, 0, 152, 23, 32, 3, 80, 3, 192, 2);
    }
    run
    {
        set(FG_6, F_6_1F, TRUE);
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
        set(FG_6, F_6_19, TRUE);
    }
    evt_finish();
}

event event_06
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(15);
    evt_finish();
}

event on_aot_03_sub1_sub1
{
    run
    {
        set(FG_ROOM, F_ROOM_1A, FALSE);
        timer_setup(1, 16, 39, 1, 0);
    }
    sleep(2);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(1, 16, 39, 1, 0);
    sleep(2);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(1, 16, 39, 1, 0);
    sleep(2);
    run
    {
        setw(2, 0, 0);
        if (ck(FG_ROOM, F_ROOM_19, TRUE))
        {
            setw(1, 16, 39);
        }
        else
        {
            setw(1, 0, 0);
        }
        set(FG_ROOM, F_ROOM_1A, TRUE);
    }
    evt_finish();
}

event on_aot_03_sub1_sub2
{
    run
    {
        set(FG_ROOM, F_ROOM_1A, FALSE);
        require(cmpw(8, 28, 2, 0));
        return;
    }
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    run
    {
        timer_setup(2, 240, 216, 7, 0);
        set(FG_ROOM, F_ROOM_1A, TRUE);
    }
    evt_finish();
}

event from_main
{
    sleep(1);
    message(MSG_JOHN | 0x80, 69); // "John. ADA..."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_finish();
}
