#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_EVENT 0x02
#define AOT_03_EVENT 0x03
#define AOT_04_MESSAGE 0x04
#define AOT_05_USEITEM 0x05
#define AOT_06_ITEM 0x06
#define AOT_07_ITEM 0x07
#define AOT_08_ITEM 0x08
#define AOT_0A_MESSAGE 0x0A
#define AOT_0B_MESSAGE 0x0B
#define F_ROOM_18 0x18
#define F_ROOM_19 0x19
#define F_ROOM_1A 0x1A
#define F_ROOM_1B 0x1B
#define MSG_JOHN 0x01
#define MSG_THERE_IS_A_SWITCH 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 10100, 10400, 1300, 1200, 3, 1, 12, 7, 0, ROOM_508_DOUBLE_LOCK, 18400, 0, 2400, 3072, UNLOCKED, 129);
    item_aot_set(AOT_01_ITEM, 10800, 5000, 2200, 1000, IT_68_FILE_RESEARCHERS_LETTER, 1, 0, 255, 104, 46, 36, 250, 156, 19, 0, 0, 81, 129, 0, 0);
    obj(0, 1, 255, 8200, 0, 2252, 3072, 0, 0, 242, 254, 0, 0, 14, 1, 14, 1, 72, 18, 70, 5, 118, 2);
    aot_set(AOT_02_EVENT, 8200, 1600, 600, 600, SCE_EVENT, 129, 9, 0, on_aot_02, 0, 0, 0);
    aot_set(AOT_03_EVENT, 8200, 10500, 1300, 1000, SCE_EVENT, 129, 9, 0, on_aot_03, 0, 0, 0);
    aot_set(AOT_04_MESSAGE, 1100, 4500, 1000, 3500, SCE_NONE, 129, 130, 0, 68, 1, 0, 0);
    aot_set(AOT_05_USEITEM, 7000, 700, 3000, 2300, SCE_USEITEM, 68, 4, 0, 27, 0, 1, 0);
    item_aot_set(AOT_06_ITEM, 4500, 9700, 1400, 1700, IT_0B_AMMO_HANDGUN, 15, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, 163, 129, 0, 0);
    item_aot_set(AOT_07_ITEM, 4500, 9700, 1400, 1700, IT_0B_AMMO_HANDGUN, 15, 2, 255, 0, 0, 0, 0, 0, 0, 0, 0, 229, 129, 0, 0);
    item_aot_set(AOT_08_ITEM, 2100, 4200, 1000, 600, IT_44_HEAL_HERB_GREEN, 1, 3, 255, 40, 10, 0, 0, 148, 17, 0, 0, 164, 129, 1, 0);
    aot_set(AOT_0A_MESSAGE, 6500, 9600, 2000, 1400, SCE_MESSAGE, 129, 132, 0, 68, 1, 0, 0);
    aot_set(AOT_0B_MESSAGE, 3500, 10600, 900, 1300, SCE_MESSAGE, 129, 133, 0, 68, 1, 0, 0);
    eml_rot(0, 250, 7, 0, 0);
    scene_setup(0, 6400, 8600, 12000);
    set(FG_STATUS, F_STATUS_1F, TRUE);
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_1B, FALSE))
    {
        aot_delete(AOT_02_EVENT, SCE_EVENT, 129);
    }
    else
    {
        aot_delete(AOT_02_EVENT, SCE_NONE, 129);
        set(FG_ROOM, F_ROOM_1B, FALSE);
    }
    if (ck(FG_ROOM, F_ROOM_19, TRUE))
    {
        msgnode_set(22, 6, 7);
    }
    else
    {
        msgnode_set(22, 6, 3);
    }
    if (testpickup(IT_68_FILE_RESEARCHERS_LETTER))
    {
        evt_exec(0, 9, from_main);
    }
    aot_delete(AOT_04_MESSAGE, SCE_NONE, 129);
    if (cmpb(2, 0, 3))
    {
        aot_reset(AOT_04_MESSAGE, SCE_MESSAGE, 129, 130, 255, 0);
    }
    if (cmpb(2, 0, 7))
    {
        aot_reset(AOT_04_MESSAGE, SCE_MESSAGE, 129, 130, 255, 0);
    }
    if (cmpb(2, 0, 2))
    {
        aot_reset(AOT_04_MESSAGE, SCE_MESSAGE, 129, 131, 255, 0);
    }
}

event on_aot_02
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        set(FG_6, F_6_19, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(15);
    message(MSG_THERE_IS_A_SWITCH | 0x80, 69); // "There's a switch. Will you push it? John. ADA..."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            se_play_3d(2, 23, 0, 1, 0, 0, 0);
            if (ck(FG_ROOM, F_ROOM_19, FALSE))
            {
                evt_exec(0, 9, on_aot_02_sub1);
                set(FG_ROOM, F_ROOM_19, TRUE);
            }
            else
            {
                evt_exec(0, 9, on_aot_02_sub2);
                set(FG_ROOM, F_ROOM_19, FALSE);
            }
        }
        else
        {
            set(FG_6, F_6_1F, TRUE);
            set(FG_6, F_6_17, TRUE);
            set(FG_6, F_6_1D, TRUE);
            set(FG_6, F_6_19, TRUE);
        }
    }
    evt_finish();
}

event on_aot_02_sub1
{
    run
    {
        setw(1, 0, 0);
        timer_setup(1, 232, 3, 1, 0);
    }
    sleep(10);
    run
    {
        setw(2, 0, 0);
        setw(1, 16, 39);
        set(FG_6, F_6_1F, TRUE);
        set(FG_6, F_6_1D, TRUE);
        set(FG_6, F_6_19, TRUE);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_02_sub2
{
    run
    {
        setw(1, 16, 39);
        setw(2, 24, 252);
    }
    sleep(10);
    run
    {
        setw(2, 0, 0);
        setw(1, 0, 0);
        set(FG_6, F_6_1F, TRUE);
        set(FG_6, F_6_1D, TRUE);
        set(FG_6, F_6_19, TRUE);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

