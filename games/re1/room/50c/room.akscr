proc init
{
    door_aot_set(AOT_00_DOOR, 100, 16300, 2400, 2000, 8, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_505_O_PASSAGE, 22500, 0, 3100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 4700, 18300, 2500, 2300, 6, DOOR_SND_01_DR_MTL, DOOR_0D_DOOR13, 6, 0, ROOM_507_MORTUARY, 21300, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 14300, 17000, 2500, 1600, 2, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_50E_SAVE_ROOM, 2800, 0, 4200, 3648, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 11400, 400, 2500, 2100, 11, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, 0, ROOM_50F_MAZE_A, 11500, 0, 20800, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_04_DOOR, 16200, 26400, 2500, 2600, 0, DOOR_SND_0D_EV_LAB, DOOR_12_ELE01A, 64, 0, ROOM_515_B4_ELEVATOR, 4600, 0, 4600, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        enemy(EM_23_NPC_REBECCA, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_00_NPC_REBECCA, ANIM_00, 0, EVAR_00);
    }
    else
    {
        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_00_NPC_BARRY, ANIM_00, 0, EVAR_00);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_2D, FALSE))
    {
        if (CHRIS)
        {
            enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_52, SPAWN_FORCE, 2, 0, 1424, 0, 13852, 0, 11708, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
            enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_53, SPAWN_FORCE, 2, 0, 1321, 0, 11312, 0, 19150, ENEMY_02_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
            enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_54, SPAWN_FORCE, 2, 0, 1653, 0, 16243, 0, 29672, ENEMY_03_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_52, SPAWN_FORCE, 2, 0, 1424, 0, 11312, 0, 19150, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
            enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_00, F_ENEMY_53, SPAWN_FORCE, 2, 0, 1653, 0, 16243, 0, 29672, ENEMY_02_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_01, FALSE))
    {
        aot_set(AOT_05_EVENT, 16000, 25000, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
        aot_reset(AOT_04_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_04_door, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_01, TRUE))
    {
        msgnode_set(ZONE_02, CAM_00, CAM_06);
        msgnode_set(ZONE_08, CAM_01, CAM_06);
        msgnode_set(ZONE_10, CAM_04, CAM_06);
        effect(FX_0A, FX_ROW_18, FX_AT_WORLD, 17500, -3000, 25550, 0);
    }
    else
    {
        effect_tracked(FX_0A, FX_ROW_10, FX_AT_WORLD, 17500, 62536, 25550, 0);
    }
    if (CHRIS)
    {
        if (ck(FG_COMMON, F_COMMON_C0, FALSE) && ck(FG_SCENARIO, F_SCENARIO_37, TRUE) && ck(FG_COMMON, F_COMMON_5A, FALSE))
        {
            evt_exec(0, TASK_09, on_enter);
            set(FG_COMMON, F_COMMON_5A, TRUE);
            pos_set(ENEMY_00_NPC_REBECCA, 0, 1780, 0, 16300, 0, 28900);
        }
    }
    else
    {
        if (ck(FG_COMMON, F_COMMON_C0, FALSE) && ck(FG_COMMON, F_COMMON_5B, TRUE) && ck(FG_SCENARIO, F_SCENARIO_37, TRUE) && ck(FG_COMMON, F_COMMON_4D, FALSE))
        {
            evt_exec(0, TASK_09, on_enter);
            set(FG_COMMON, F_COMMON_4D, TRUE);
            pos_set(ENEMY_00_NPC_BARRY, 0, 1608, 0, 14950, 0, 29400);
            dir_set(0, 0, 2500, 0, 16300, 0, 28000);
        }
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_64, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_01, TRUE))
        {
            set(FG_SCENARIO, F_SCENARIO_64, TRUE);
            effect_kill_a(0);
            effect(FX_0A, FX_ROW_18, FX_AT_WORLD, 17500, -3000, 25550, 0);
            msgnode_set(ZONE_02, CAM_00, CAM_06);
            msgnode_set(ZONE_08, CAM_01, CAM_06);
            msgnode_set(ZONE_10, CAM_04, CAM_06);
        }
    }
}

event on_aot_05
{
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    message(MSG_THERE_IS_A_SWITCH | MSG_FAST, 0); // "There's a switch. Will you push it? There's no reaction. It has no power."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_2D, TRUE) && ck(FG_SCENARIO, F_SCENARIO_2E, TRUE))
            {
                set(FG_SCENARIO, F_SCENARIO_01, TRUE);
                aot_delete(AOT_05_EVENT, SCE_NONE, 0);
                if (ck(FG_COMMON, F_COMMON_C0, FALSE))
                {
                    evt_exec(0, TASK_09, on_aot_05_sub2);
                }
                else
                {
                    evt_exec(0, TASK_09, on_aot_05_sub1);
                }
            }
            else
            {
                evt_exec(0, TASK_09, on_aot_04_door);
            }
        }
        else
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    evt_finish();
}

event on_aot_04_door
{
    sleep(1);
    message(MSG_THERE_IS_NO_REACTION | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's no reaction. It has no power."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

event on_aot_05_sub1
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_07);
        se_play_3d(SND_BANK_ROOM, SE_18_SW_BTN, 0, SND_AT_POINT, 0, 16300, 27630);
    }
    sleep(20);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_19_ELV_ON, 0, SND_AT_POINT, 0, 16300, 27630);
    }
    if (CHRIS)
    {
        run
        {
            cut_auto(CUT_FREE);
            msgnode_set(ZONE_0D, CAM_02, CAM_07);
            aot_delete(AOT_04_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    else
    {
        run
        {
            cut_auto(CUT_FREE);
        }
        sleep(20);
        run
        {
            msgnode_set(ZONE_0D, CAM_02, CAM_07);
            aot_delete(AOT_04_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    evt_finish();
}

event on_aot_05_sub2
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        if (CHRIS)
        {
            pos_set(ENEMY_00_NPC_REBECCA, 0, 3920, 0, 7300, 0, 16600);
        }
        else
        {
            pos_set(ENEMY_00_NPC_BARRY, 0, 3920, 0, 7300, 0, 16600);
        }
        cutnext(CAM_07);
        se_play_3d(SND_BANK_ROOM, SE_18_SW_BTN, 0, SND_AT_POINT, 0, 16300, 27630);
    }
    sleep(20);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_19_ELV_ON, 0, SND_AT_POINT, 0, 16300, 27630);
    }
    if (CHRIS)
    {
        sleep(30);
    }
    else
    {
        sleep(5);
    }
    run
    {
        cutnext(CAM_06);
    }
    sleep(10);
    run
    {
        if (CHRIS)
        {
            voice_play(VOICE_PLAY, VO_A09_00);
            message(MSG_VO_A09_00, 0);
        }
        else
        {
            voice_play(VOICE_PLAY, VO_A09_04);
            message(MSG_VO_A09_04, 0);
        }
    }
    if (CHRIS)
    {
        wait_message();
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    }
    else
    {
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_seq(AB_ADDITIVE | AB_03, 10800, 17550, F_ROOM_20);
    }
    else
    {
        act_anim_seq(AB_ADDITIVE | AB_02, 10800, 17550, F_ROOM_20);
    }
    act_nop();
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(30);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    }
    else
    {
        sleep(60);
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    }
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_seq(AB_03, 13150, 26520, F_ROOM_22);
    }
    else
    {
        act_anim_seq(AB_02, 13150, 26520, F_ROOM_23);
    }
    act_nop();
    act_reset();
    evt_nop();
    if (CHRIS)
    {
        sleep(30);
    }
    else
    {
        sleep(50);
        wait_message();
    }
    run
    {
        dir_set(0, 0, 1864, 0, 16280, 0, 27750);
        cutnext(CAM_07);
    }
    if (CHRIS)
    {
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_22, FALSE));
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA);
    }
    else
    {
        do
        {
            evt_next();
        }
        while (ck(FG_ROOM, F_ROOM_23, FALSE));
        evt_work_set(WK_ENEMY, ENEMY_00_NPC_BARRY);
    }
    evt_actor_begin();
    act_anim_flags(ANIM_2E, F_ROOM_20, 0);
    if (CHRIS)
    {
        act_param_set(0, 1024);
    }
    else
    {
        act_param_set(0, 824);
    }
    act_reset();
    evt_nop();
    sleep(40);
    run
    {
        if (CHRIS)
        {
            if (ck(FG_COMMON, F_COMMON_6D, FALSE))
            {
                evt_exec(0, TASK_09, on_aot_05_sub2_sub1);
            }
            else
            {
                evt_exec(0, TASK_09, on_aot_05_sub2_sub2);
            }
        }
        else
        {
            if (ck(FG_COMMON, F_COMMON_25, FALSE))
            {
                evt_exec(0, TASK_09, on_aot_05_sub2_sub1);
            }
            else
            {
                evt_exec(0, TASK_09, on_aot_05_sub2_sub2);
            }
        }
    }
    evt_finish();
}

