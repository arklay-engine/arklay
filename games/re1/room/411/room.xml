    <language lang="en-US">
      <string key="name">CONTROL ROOM</string>
      <string key="save_name">Guardhouse 1F</string>
      <string key="0">{scroll 2}There's a lever. Will you\nmove it?{branch 0 1 1}{scroll 2}There's a button. Will\nyou push it?{branch 0 1 1}{scroll 2}There was a sound from the\nroom next door.{scroll 2}</string>
      <string key="1">{scroll 2}There's a button. Will\nyou push it?{branch 0 1 1}{scroll 2}There was a sound from the\nroom next door.{scroll 2}</string>
      <string key="2">{scroll 2}There was a sound from the\nroom next door.{scroll 2}</string>
      <string key="3">{scroll 2}\nNothing special.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name"> {s}寄宿舎 {s}/{s}1{s}F{s}</string>
      <string key="0">{scroll 2}      レバーがある\n動かしますか?{branch 0 1 1}{scroll 2}      ボタンがある\n押しますか?{branch 0 1 1}{scroll 2}\n  となりの部屋から何か聞こえた{scroll 2}</string>
      <string key="1">{scroll 2}      ボタンがある\n押しますか?{branch 0 1 1}{scroll 2}\n  となりの部屋から何か聞こえた{scroll 2}</string>
      <string key="2">{scroll 2}\n  となりの部屋から何か聞こえた{scroll 2}</string>
      <string key="3">{scroll 2}\n      特に何もない{scroll 2}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Poste de garde RdC</string>
      <string key="0">{scroll 2}Il y a un levier.\nL'actionner?{branch 0 6 1}</string>
      <string key="1">{scroll 2}Il y a un bouton.\nAppuyer dessus?{branch 0 6 1}</string>
      <string key="2">{scroll 2}On entend un bruit de l'autre\npièce.{scroll 2}</string>
      <string key="3">{scroll 2}\nRien de spécial.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}Da ist ein Hebel.\nMöchten Sie ihn bewegen?{branch 0 6 1}</string>
      <string key="1">{scroll 2}Dort ist ein Schaltknopf.\nMöchten Sie draufdrücken?{branch 0 6 1}</string>
      <string key="2">{scroll 2}Aus dem Nebenraum\nwar ein Geräusch zu hören.{scroll 2}</string>
      <string key="3">{scroll 2}\nNichts Besonderes.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Guardiola 1P</string>
      <string key="0">{scroll 2}C'è una leva.\nVuoi azionarla?{branch 0 6 1}</string>
      <string key="1">{scroll 2}C'è un bottone.\nVuoi premerlo?{branch 0 6 1}</string>
      <string key="2">{scroll 2}Il rumore proveniva dalla \nstanza accanto.{scroll 2}</string>
      <string key="3">{scroll 2}\nNiente di speciale.{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}Hay una palanca...\n¿Quieres empujarla?{branch 0 6 1}</string>
      <string key="1">{scroll 2}Hay un botón...\n¿Quieres pulsarlo?{branch 0 6 1}</string>
      <string key="2">{scroll 2}Se ha oído algo en\nla habitación de al lado...{scroll 2}</string>
      <string key="3">{scroll 2}\nNada especial...{scroll 2}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната охраны 1-эт.</string>
      <string key="0">{scroll 2}Здесь есть рычаг.\nОпустить его?{branch 0 1 1}{scroll 2}Здесь кнопка.\nНажать её?{branch 0 1 1}{scroll 2}Из соседней комнаты\nдоносься щелчок.{scroll 2}</string>
      <string key="1">{scroll 2}Здесь кнопка.\nНажать её?{branch 0 1 1}{scroll 2}Из соседней комнаты\nдоносься щелчок.{scroll 2}</string>
      <string key="2">{scroll 2}Из соседней комнаты\nдонёсся щелчок.{scroll 2}</string>
      <string key="3">{scroll 2}\nНичего особенного.{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Asuntolan varasto 1 krs</string>
      <string key="0">{scroll 2}Siinä on vipu...\nVedätkö sitä?{branch 0 6 1}</string>
      <string key="1">{scroll 2}Siinä on painike...\nPainatko sitä?{branch 0 6 1}</string>
      <string key="2">{scroll 2}Viereisestä huoneesta kuului\nääni...{scroll 2}</string>
      <string key="3">{scroll 2}Ei mitään erityistä...{scroll 2}</string>
