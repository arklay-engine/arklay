event on_enter_sub2
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    for (5)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        tw_nop();
    }
    tw_nop();
    for (20)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (5)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    sleep(60);
    for (5)
    {
        tw_set_rot(-1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (20)
    {
        tw_set_rot(-1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (5)
    {
        tw_set_rot(-1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    sleep(60);
    evt_chain(on_enter_sub2);
    evt_finish();
}

event event_09
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    for (20)
    {
        tw_set_rot(0, 0, 1);
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    sleep(30);
    for (20)
    {
        tw_set_rot(0, 0, -1);
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    sleep(30);
    evt_chain(event_09);
    evt_finish();
}

event event_0A
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        message(MSG_THERE_IS_A_BUTTON | MSG_FAST, RUN_PLAYER); // "There's a button. Will you push it? There was a sound from the room next door."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    sleep(1);
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            set(FG_LOCK, F_LOCK_24, TRUE);
            se_play_3d(SND_BANK_ROOM, SE_18_SW_411, 0, SND_AT_PLAYER, 0, 0, 0);
            evt_exec(0, TASK_09, event_0D);
        }
        else
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            set(FG_RUN, F_RUN_MONSTERS, TRUE);
            set(FG_RUN, F_RUN_READY, TRUE);
        }
    }
    evt_finish();
}

event from_main_2
{
    run
    {
        effect_tracked(FX_0A, FX_ROW_00, FX_AT_WORLD, 6900, 64136, 11900, 0);
        set(FG_ROOM, F_ROOM_17, TRUE);
    }
    evt_finish();
}

event from_main_3
{
    run
    {
        effect_kill_a(0);
        set(FG_ROOM, F_ROOM_17, FALSE);
    }
    evt_finish();
}

event event_0D
{
    sleep(20);
    message(MSG_THERE_WAS_A_SOUND_FROM_THE | MSG_FAST, RUN_PLAYER); // "There was a sound from the room next door."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
    }
    evt_finish();
}

