    tw_end();
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    for (5)
    {
        tw_set_pos(0, 3, 0);
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    for (5)
    {
        tw_set_pos(0, 4, 0);
        tw_pos_add();
        evt_next();
