    <language lang="ja-JP">
      <string key="save_name">館 {s}ホ{s}ー{s}ル{s}/{s}1{s}F{s}</string>
      <string key="0">\n 基の下にずらしたような跡がある{scroll 2}</string>
      <string key="1">\n    暗くてよく見えない{scroll 2}</string>
      <string key="2">    暗くてよく見えない\nとび下りますか?{scroll 1}{branch 0 1 0}   ロープが下ろされている\n下りますか?{scroll 1}{branch 0 1 0}{scroll 0}\n  めずらしいものでもあるのか{scroll 2}{timed 95}</string>
      <string key="3">   ロープが下ろされている\n下りますか?{scroll 1}{branch 0 1 0}{scroll 0}\n  めずらしいものでもあるのか{scroll 2}{timed 95}</string>
      <string key="4">{scroll 0}\n  めずらしいものでもあるのか{scroll 2}{timed 95}</string>
      <string key="5">{scroll 0}\n    よく見えないんだけど{scroll 2}{timed 90}</string>
      <string key="6">{scroll 0}     下りてみるか?\n     ロープならあるぜ{scroll 2}{timed 130}</string>
      <string key="7">{scroll 0}\n   そう やってみようかしら{scroll 2}{timed 120}</string>
      <string key="8">{scroll 0}\n       待ってな{scroll 2}{timed 40}</string>
      <string key="9">{scroll 0}   そういえばリチャードから\n   通信機をあずかってたんだ{scroll 2}{timed 160}</string>
      <string key="10">{scroll 0}\n      リチャード…{scroll 2}{timed 40}</string>
      <string key="11">{scroll 0}\n     おまえが持ってろ{scroll 2}{clear 70}{scroll 0}\n       いくぞ{scroll 2}{timed 40}</string>
      <string key="12">{scroll 0}\n    ちょっと 冗談でしょ{scroll 2}{timed 70}</string>
      <string key="13">{scroll 0}\n   やっちまった すまんジル{scroll 2}{clear 85}{scroll 0}   待っててくれ すぐ別の\n   ロープを取ってくる{scroll 2}{timed 90}</string>
      <string key="14">{scroll 0}\n     いるか ジル?{scroll 2}{clear 80}{scroll 0}\n     ロープを下ろすぞ{scroll 2}{timed 70}</string>
      <string key="15">{scroll 0}\n    すまなかった ジル{scroll 2}{timed 50}</string>
      <string key="16">{scroll 0}\n   どうなる事かと思ったわ{scroll 2}{clear 95}{scroll 0}\n   すまん うっかりしてた{scroll 2}{timed 90}</string>
      <string key="17">{scroll 0}\n     本当に大丈夫?{scroll 2}{clear 65}{scroll 0}\n    具合でも悪いんじゃ…{scroll 2}{timed 65}</string>
      <string key="18">{scroll 0}\n     いや 心配無用だ{scroll 2}{timed 95}</string>
      <string key="19">{scroll 0}\n  そうだ これを見つけたんだ{scroll 2}{timed 80}</string>
      <string key="20">{scroll 0}\n  ありがとう もらっておくわ{scroll 2}{timed 90}</string>
      <string key="21"> 何かが刻んである よみますか?{branch 2 9 22}\x09、</string>
