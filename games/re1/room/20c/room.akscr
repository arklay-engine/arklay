    evt_actor_begin();
    act_nop();
    act_anim_seq(AB_05, 9032, 2000, F_ROOM_PLAYER_ANIM_DONE);
    act_reset();
    evt_finish();
}

event jump_into_pit
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_fork(TASK_09, crouch_until_released, 0);
    }
    else
    {
        evt_fork(TASK_09, crouch_until_released, 0);
    }
    timer_setup(LIGHT_FADE_VEIL, 700, FADE_R | FADE_G | FADE_B);
    sleep(47);
    run
    {
        timer_setup(LIGHT_FADE_VEIL, 0, FADE_R | FADE_G | FADE_B);
        dir_set(0, 0, 2048, 0, 23100, 0, 4100);
        msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
        cutnext(CAM_04_PIT_BOTTOM);
        cut_auto(CUT_FREE);
        timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
        se_play_3d(SND_BANK_ROOM, SE_2D, 0, SND_AT_PLAYER, 0, 0, 0);
    }
    sleep(30);
    set(FG_ROOM, F_ROOM_PLAYER_POSE_RELEASE, TRUE);
    timer_setup(LIGHT_FADE_VEIL, -700, FADE_R | FADE_G | FADE_B);
    sleep(47);
    evt_chain(end_cutscene);
}

event crouch_until_released
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_POSE_RELEASE, FALSE));
    set(FG_ROOM, F_ROOM_PLAYER_POSE_RELEASE, FALSE);
    evt_actor_begin();
    act_nop();
    act_anim_flags(ANIM_09, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0001);
    act_reset();
    evt_finish();
}

event fireplace_slides
{
    evt_work_set(WK_OBJ, OBJ_00_FIREPLACE);
    evt_tween_begin_alt();
    tw_set_pos(-10, 0, 0);
    for (20)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    for (50)
    {
        tw_set_pos(-15, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(-10, 0, 0);
        tw_pos_add();
        evt_next();
        tw_set_pos(-12, 0, 0);
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(-7, 0, 0);
    for (20)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        aot_delete(AOT_07_EVENT_LADDER, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_0A_EVENT_LADDER, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    set(FG_SCENARIO, F_SCENARIO_FIREPLACE_LADDER_OPEN, TRUE);
    evt_finish();
}

event examine_fireplace_switch
{
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_fork(TASK_09, crouch_until_released, 0);
    }
    else
    {
        evt_fork(TASK_09, crouch_until_released, 0);
    }
    sleep(40);
    message(MSG_THERE_IS_A_SWITCH_BELOW | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a switch below. Will you push it?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_ROOM, F_ROOM_PLAYER_POSE_RELEASE, TRUE);
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            set(FG_ROOM, F_ROOM_LADDER_OPEN, TRUE);
            aot_delete(AOT_0B_USEITEM_TOMBSTONE_ZONE, SCE_NONE, 0);
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                evt_exec(0, TASK_09, push_fireplace_switch);
            }
            else
            {
                evt_exec(0, TASK_09, push_fireplace_switch);
            }
        }
        else
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                evt_exec(0, TASK_09, leave_pit_or_rope_breaks);
            }
            else
            {
                evt_exec(0, TASK_09, decline_fireplace_switch);
            }
        }
    }
    evt_finish();
}

event end_cutscene
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_idle();
    act_reset();
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event push_fireplace_switch
{
    sleep(20);
    cutnext(CAM_06_FIREPLACE);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_fork(TASK_05, fireplace_slides, 0);
    }
    else
    {
        evt_fork(TASK_05, fireplace_slides, 0);
    }
    voice_play(VOICE_PLAY, VO_B00_02);
    sleep(205);
    wait_message();
    set(FG_ROOM, F_ROOM_PLAYER_POSE_RELEASE, TRUE);
    cutnext(CAM_05);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        set(FG_ROOM, F_ROOM_J_SWITCH_EVENT_RUNNING, FALSE);
    }
    evt_chain(end_cutscene);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        evt_nop();
        evt_nop();
    }
}

event decline_fireplace_switch
{
    sleep(26);
    set(FG_ROOM, F_ROOM_J_SWITCH_EVENT_RUNNING, FALSE);
    evt_chain(end_cutscene);
}

