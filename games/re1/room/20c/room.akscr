event leave_pit_or_rope_breaks
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        sleep(26);
        evt_chain(end_cutscene);
    }
    else
    {
        timer_setup(LIGHT_FADE_VEIL, 700, FADE_R | FADE_G | FADE_B);
        sleep(47);
        run
        {
            msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
            timer_setup(LIGHT_FADE_VEIL, 0, FADE_R | FADE_G | FADE_B);
            dir_set(0, 0, 0, 0, 22400, 0, 4000);
            effect(FX_0D, FX_ROW_00, FX_AT_WORLD, 23500, -2400, 3800, 0);
            cutnext(CAM_04_PIT_BOTTOM);
            cut_auto(CUT_FREE);
            timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
        }
        evt_work_set(WK_PLAYER, 0);
        evt_actor_begin();
        act_motion(MOTION_10);
        act_anim_flags(ANIM_28, F_ROOM_PLAYER_ANIM_DONE, 0);
        act_flag_op(EF_OR, EF_0010);
        act_reset();
    }
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        evt_work_set(WK_ENEMY, ENEMY_0F_BARRY);
        evt_actor_begin();
        act_motion(MOTION_10);
        act_reset();
    }
    evt_nop();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        sleep(30);
        timer_setup(LIGHT_FADE_VEIL, -700, FADE_R | FADE_G | FADE_B);
        sleep(47);
        set(FG_ROOM, F_ROOM_J_ROPE_BROKE, TRUE);
        evt_fork(TASK_09, rope_breaks_jill_0, 0);
        voice_play(VOICE_PLAY, VO_B00_01);
        wait_message();
        bgm_play(BGM_MAIN);
        voice_play(VOICE_PLAY, VO_10D_10);
        message(MSG_VO_10D_10, 0);
        wait_message();
        run
        {
            msg_list(0, 6908, -2000, 3837, 255, 255, 255, LIGHT_KIND_00, 13761, 6558, -2950, 16287, 255, 255, 255, LIGHT_KIND_00, 13321, 0, 347, 0, 230, 230, 230, LIGHT_KIND_01, 9115, 751, 847, 977);
            cutnext(CAM_03);
        }
        evt_fork(TASK_09, rope_breaks_barry, 0);
        voice_play(VOICE_PLAY, VO_10D_11);
        message(MSG_VO_10D_11, 0);
        wait_message();
        run
        {
            msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
            cutnext(CAM_04_PIT_BOTTOM);
        }
        evt_fork(TASK_09, rope_breaks_jill_1, 0);
        voice_play(VOICE_PLAY, VO_10D_12);
        sleep(20);
        sleep(60);
        evt_fork(TASK_09, rope_breaks_raw, 0);
        evt_chain(end_cutscene);
    }
}

