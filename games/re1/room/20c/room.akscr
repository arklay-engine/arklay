event examine_rope_below
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    message(MSG_THERE_IS_A_ROPE_WILL_YOU_CLIMB_IT | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a rope. Will you climb it? There's a ladder. Will you descend it? A hole opens in the fireplace."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, climb_rope);
        }
        else
        {
            evt_exec(0, TASK_09, end_cutscene);
        }
    }
    evt_finish();
}

event climb_rope
{
    timer_setup(LIGHT_FADE_VEIL, 700, FADE_R | FADE_G | FADE_B);
    sleep(47);
    run
    {
        msg_list(0, 6908, -2000, 3837, 255, 255, 255, LIGHT_KIND_00, 13761, 6558, -2950, 16287, 255, 255, 255, LIGHT_KIND_00, 13321, 0, 347, 0, 230, 230, 230, LIGHT_KIND_01, 9115, 751, 847, 977);
        timer_setup(LIGHT_FADE_VEIL, 0, FADE_R | FADE_G | FADE_B);
        dir_set(0, 0, 95, 0, 5320, 0, 4957);
        cutnext(CAM_02);
        cut_auto(CUT_FREE);
        timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    }
    sleep(30);
    timer_setup(LIGHT_FADE_VEIL, -700, FADE_R | FADE_G | FADE_B);
    evt_chain(end_cutscene);
}

event examine_rope_above
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    message(MSG_THERE_IS_A_ROPE_WILL_YOU_DESCEND_IT | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a rope. Will you descend it?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, descend_rope);
        }
        else
        {
            evt_exec(0, TASK_09, end_cutscene);
        }
    }
    evt_finish();
}

event descend_rope
{
    timer_setup(LIGHT_FADE_VEIL, 700, FADE_R | FADE_G | FADE_B);
    sleep(47);
    run
    {
        msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
        timer_setup(LIGHT_FADE_VEIL, 0, FADE_R | FADE_G | FADE_B);
        dir_set(0, 0, 2048, 0, 22400, 0, 4000);
        cutnext(CAM_04_PIT_BOTTOM);
        cut_auto(CUT_FREE);
        timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
