#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_20B 0x00
#define AOT_01_DOOR_21A 0x01                                // The ladder down; descend_ladder turns it on.
#define AOT_02_EVENT_YAWN_AMBUSH 0x02
#define AOT_03_EVENT_PIT 0x03
#define AOT_04_EVENT_SWITCH 0x04
#define AOT_04_USEITEM_SWITCH 0x04                          // Use-item spot with data 4,0,9: raises F_ROOM_J_SWITCH_SPOT_USED.
#define AOT_06_USEITEM_FIREPLACE_ZONE 0x06                  // Under-player spot; raises F_ROOM_PLAYER_AT_FIREPLACE.
#define AOT_07_EVENT_LADDER 0x07
#define AOT_07_ITEM_KEY_RADIO 0x07                          // The radio Barry hands over.
#define AOT_08_ITEM_FILE_PASS_NUMBER 0x08                   // The pass number Barry hands over.
#define AOT_08_MESSAGE_TOMBSTONE 0x08                       // "Someone has moved this tombstone."
#define AOT_09_EVENT_ROPE 0x09
#define AOT_09_USEITEM_HOLE_ZONE 0x09                       // Under-player spot; raises F_ROOM_PLAYER_IN_HOLE_ZONE.
#define AOT_0A_EVENT_LADDER 0x0A
#define AOT_0A_MESSAGE_HOLE_OPENS 0x0A                      // "A hole opens in the fireplace."
#define AOT_0B_USEITEM_TOMBSTONE_ZONE 0x0B                  // Under-player spot; raises F_ROOM_PLAYER_IN_TOMBSTONE_ZONE.
#define AOT_0C_MESSAGE_TOMBSTONE 0x0C                       // "Someone has moved this tombstone."
#define AOT_0D_USEITEM_HOLE_ZONE 0x0D                       // Under-player spot; raises F_ROOM_PLAYER_IN_HOLE_ZONE.
#define AOT_0E_MESSAGE_HOLE_OPENS 0x0E                      // "A hole opens in the fireplace."
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04_PIT_BOTTOM 0x04
#define CAM_05 0x05
#define CAM_06_FIREPLACE 0x06
#define COL_02 0x02
#define ENEMY_00_YAWN 0x00
#define ENEMY_0F_BARRY 0x0F
#define FX_0D 0x0D
#define F_ROOM_J_BARRY_RETURN_STARTED 0x0C                  // Barry's return with the rope has started.
#define F_ROOM_J_CALL_BARRY 0x0A                            // Likely: raised when Jill uses the radio in the pit (nothing in the script sets it); starts Barry's return.
#define F_ROOM_J_ROPE_BROKE 0x00                            // The rope broke; Jill is stuck at the bottom of the pit.
#define F_ROOM_J_SWITCH_EVENT_RUNNING 0x0D                  // The switch event is running; it holds off Barry's return.
#define F_ROOM_J_SWITCH_SPOT_USED 0x09                      // Raised by AOT_04_USEITEM_SWITCH; main starts the switch event.
#define F_ROOM_J_YAWN_DEATH_HANDLED 0x08                    // Main removed the pit event after Yawn died.
#define F_ROOM_LADDER_OPEN 0x0E                             // The fireplace has slid aside; the ladder spot replaces the switch.
#define F_ROOM_PLAYER_ANIM_DONE 0x3F                        // The player's animation finished (one frame).
#define F_ROOM_PLAYER_AT_FIREPLACE 0x3E                     // The player stands by the fireplace (raised each frame); enables the switch or ladder event.
#define F_ROOM_PLAYER_IN_HOLE_ZONE 0x3C                     // The player stands in AOT_09/AOT_0D (raised each frame); enables the hole message.
#define F_ROOM_PLAYER_IN_TOMBSTONE_ZONE 0x3D                // The player stands in AOT_0B (raised each frame); enables the tombstone message.
#define F_ROOM_PLAYER_POSE_RELEASE 0x0F                     // Ends the player's crouching examine pose.
#define F_ROOM_YAWN_BGM_ON 0x07                             // Yawn's music is playing; main fades it when Yawn dies.
#define IMDL_00_BARRY_GIFT 0x00                             // Shared by the radio and the pass number Barry hands over.
#define MSG_IT_IS_TOO_DARK_TO_SEE 0x01
#define MSG_IT_IS_TOO_DARK_TO_SEEWILL 0x02
#define MSG_THERE_IS_A_LADDER 0x1B
#define MSG_THERE_IS_A_ROPE_WILL_YOU_CLIMB_IT 0x1A
#define MSG_THERE_IS_A_ROPE_WILL_YOU_DESCEND_IT 0x03
#define MSG_THERE_IS_A_SWITCH_BELOW 0x17
#define MSG_VO_10D_00 0x04
#define MSG_VO_10D_01 0x05
#define MSG_VO_10D_02 0x06
#define MSG_VO_10D_03 0x07
#define MSG_VO_10D_04 0x08
#define MSG_VO_10D_05 0x09
#define MSG_VO_10D_06 0x0A
#define MSG_VO_10D_07 0x0B
#define MSG_VO_10D_10 0x0C
#define MSG_VO_10D_11 0x0D
#define MSG_VO_10D_13 0x0E
#define MSG_VO_10D_14 0x0F
#define MSG_VO_10D_15 0x10
#define MSG_VO_10D_16 0x11
#define MSG_VO_10D_17 0x12
#define MSG_VO_10D_18 0x13
#define MSG_VO_10D_19 0x14
#define OBJ_00_FIREPLACE 0x00                               // It slides aside when the switch is pushed.
#define SE_19 0x19
#define SE_1B 0x1B
#define SE_2D 0x2D
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define SPR_02 0x02
#define VO_10D_00 0x48
#define VO_10D_01 0x49
#define VO_10D_02 0x4A
#define VO_10D_03 0x4B
#define VO_10D_04 0x4C
#define VO_10D_05 0x4D
#define VO_10D_06 0x4E
#define VO_10D_07 0x4F
#define VO_10D_10 0x50
#define VO_10D_11 0x51
#define VO_10D_12 0x52
#define VO_10D_13 0x53
#define VO_10D_14 0x54
#define VO_10D_15 0x55
#define VO_10D_16 0x56
#define VO_10D_17 0x57
#define VO_10D_18 0x58
#define VO_10D_19 0x59
#define VO_B00_00 0x5A
#define VO_B00_01 0x5B
#define VO_B00_02 0x5C

proc init
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
    {
        door_aot_set(AOT_00_DOOR_20B, 10400, 17500, 2300, 1400, 1, DOOR_SND_00_DR_WD, DOOR_1F_DOOR05K, 5, 0, ROOM_20B_FRONT_LESSON_ROOM, 2500, 0, 7400, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        door_aot_set(AOT_01_DOOR_21A, 16650, 2570, 2400, 2080, 1, DOOR_SND_0B_LADDER, DOOR_1A_LAD00, 64, 0, ROOM_21A_UNDER_PASSAGE_1, 28000, 0, 3550, 2048, UNLOCKED, 0);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            aot_set(AOT_07_EVENT_LADDER, 16650, 2570, 2400, 2080, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, descend_ladder, 0, 0, 0);
        }
        else
        {
            aot_set(AOT_0A_EVENT_LADDER, 16650, 2570, 2400, 2080, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, descend_ladder, 0, 0, 0);
        }
        set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
        {
            room_bgm_state_set(6, 12, BGM_RELOAD | 1);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_YAWN_2_APPEARED, FALSE))
        {
            enemy(EM_12_YAWN_2, EB_84, F_ENEMY_20C_YAWN_2_0, SPAWN_FORCE, 2, 0, 2048, 0, 13000, 0, 11150, ENEMY_00_YAWN, ANIM_00, 0, EVAR_00);
        }
        else
        {
            enemy(EM_12_YAWN_2, EB_06, F_ENEMY_20C_YAWN_2_0, SPAWN_FORCE, 2, 0, 3072, 0, 5300, 0, 17500, ENEMY_00_YAWN, ANIM_00, 0, EVAR_00);
            inst_cfg(COL_LIST_03, COL_02, 0, 252, 1856, 4284, 6008);
            if (ck(FG_ENEMY, F_ENEMY_20C_YAWN_2_0, FALSE))
            {
                evt_exec(0, TASK_09, yawn_bgm);
            }
        }
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            if (ck(FG_ENEMY, F_ENEMY_20C_YAWN_2_0, TRUE))
            {
                room_bgm_state_set(6, 12, BGM_MAIN_ON);
            }
        }
        else
        {
            enemy(EM_2B_NPC_BARRY_2_STARS, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 0, 0, 0, ENEMY_0F_BARRY, ANIM_00, 0, EVAR_00);
        }
        aot_set(AOT_02_EVENT_YAWN_AMBUSH, 1200, 1400, 3000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, yawn_ambush, 0, 0, 0);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            aot_set(AOT_03_EVENT_PIT, 1400, 3400, 3200, 2700, SCE_EVENT, 0, 9, 0, examine_pit, 0, 0, 0);
        }
        else
        {
            if (ck(FG_ENEMY, F_ENEMY_20C_YAWN_2_0, FALSE))
            {
                aot_set(AOT_03_EVENT_PIT, 1400, 3400, 3200, 2700, SCE_EVENT, 0, 9, 0, examine_pit, 0, 0, 0);
            }
            else
            {
                set(FG_ROOM, F_ROOM_J_YAWN_DEATH_HANDLED, TRUE);
                if (ck(FG_COMMON, F_COMMON_J_PIT_SCENE_STARTED, TRUE))
                {
                    if (ck(FG_COMMON, F_COMMON_J_BARRY_RESCUED_FROM_PIT, TRUE))
                    {
                        aot_set(AOT_03_EVENT_PIT, 1400, 3400, 3200, 2700, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_rope_above, 0, 0, 0);
                    }
                    else
                    {
                        aot_set(AOT_03_EVENT_PIT, 1400, 3400, 3200, 2700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
                    }
                }
                else
                {
                    aot_set(AOT_03_EVENT_PIT, 1400, 3400, 3200, 2700, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_pit, 0, 0, 0);
                }
            }
        }
        if (ck(FG_SCENARIO, F_SCENARIO_FIREPLACE_LADDER_OPEN, FALSE))
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                aot_set(AOT_04_EVENT_SWITCH, 16650, 2570, 2400, 2080, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, examine_fireplace_switch, 0, 0, 0);
            }
            else
            {
                aot_set(AOT_04_USEITEM_SWITCH, 16650, 2570, 2400, 2080, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER, 4, 0, 9, 0, 1, 0);
            }
        }
        aot_set(AOT_06_USEITEM_FIREPLACE_ZONE, 19000, 2570, 1400, 2080, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 62, 0, 1, 0);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
        {
            item_aot_set(AOT_07_ITEM_KEY_RADIO, 0, 0, 1, 1, IT_4D_KEY_RADIO, 0, IMDL_00_BARRY_GIFT, SCA_NONE, 0, 0, 0, 0, F_ITEM_20C_KEY_RADIO_0, SAT_UNDER | SAT_PLAYER, 0);
            item_aot_set(AOT_08_ITEM_FILE_PASS_NUMBER, 0, 0, 1, 1, IT_63_FILE_PASS_NUMBER, 0, IMDL_00_BARRY_GIFT, SCA_NONE, 0, 0, 0, 0, F_ITEM_20C_FILE_PASS_NUMBER_0, SAT_UNDER | SAT_PLAYER, 0);
            aot_set(AOT_09_EVENT_ROPE, 23550, 2500, 1000, 2000, SCE_EVENT, 0, 9, 0, examine_rope_below, 0, 0, 0);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_FIREPLACE_LADDER_OPEN, FALSE))
        {
            aot_set(AOT_0B_USEITEM_TOMBSTONE_ZONE, 13800, 1710, 2100, 3700, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
        }
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            aot_set(AOT_08_MESSAGE_TOMBSTONE, 14400, 2810, 1800, 1900, SCE_MESSAGE, 0, 128, 0, 255, 0, 0, 0);
            aot_set(AOT_09_USEITEM_HOLE_ZONE, 8700, 10210, 1800, 1900, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 60, 0, 1, 0);
            aot_set(AOT_0A_MESSAGE_HOLE_OPENS, 9300, 9710, 1800, 2800, SCE_MESSAGE, 0, 156, 0, 255, 0, 0, 0);
            if (ck(FG_SCENARIO, F_SCENARIO_FIREPLACE_LADDER_OPEN, FALSE))
            {
                obj(OBJ_00_FIREPLACE, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 17650, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
            }
            else
            {
                obj(OBJ_00_FIREPLACE, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 15460, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
                set(FG_ROOM, F_ROOM_LADDER_OPEN, TRUE);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_21A_UNDER_PASSAGE_1))
            {
                msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
            }
        }
        else
        {
            aot_set(AOT_0C_MESSAGE_TOMBSTONE, 14400, 2810, 1800, 1900, SCE_MESSAGE, 0, 128, 0, 255, 0, 0, 0);
            aot_set(AOT_0D_USEITEM_HOLE_ZONE, 8700, 10210, 1800, 1900, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 60, 0, 1, 0);
            aot_set(AOT_0E_MESSAGE_HOLE_OPENS, 9300, 9710, 1800, 2800, SCE_MESSAGE, 0, 156, 0, 255, 0, 0, 0);
            if (ck(FG_COMMON, F_COMMON_J_BARRY_RESCUED_FROM_PIT, TRUE))
            {
                effect(FX_0D, FX_ROW_00, FX_AT_WORLD, 23500, -2400, 3800, 0);
                aot_delete(AOT_09_EVENT_ROPE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            }
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_21A_UNDER_PASSAGE_1))
            {
                msg_list(0, 26108, -5000, 3797, 60, 60, 60, LIGHT_KIND_00, 14041, 13438, -5000, 3647, 60, 60, 60, LIGHT_KIND_00, 13561, 12160, -5000, 3680, 60, 60, 60, LIGHT_KIND_00, 13315, 959, 769, 801);
                if (ck(FG_COMMON, F_COMMON_J_BARRY_RESCUED_FROM_PIT, FALSE))
                {
                    room_bgm_state_set(6, 12, BGM_MAIN_ON);
                }
            }
            else if (ck(FG_COMMON, F_COMMON_J_BARRY_RESCUED_FROM_PIT, TRUE))
            {
                room_bgm_state_set(6, 12, BGM_MAIN_ON);
            }
            if (ck(FG_SCENARIO, F_SCENARIO_FIREPLACE_LADDER_OPEN, FALSE))
            {
                obj(OBJ_00_FIREPLACE, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 17650, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
            }
            else
            {
                obj(OBJ_00_FIREPLACE, OF_NOT_PUSHABLE | OF_ACTIVE, SCA_NONE, 15460, 0, 3610, 0, 0, 0, 0, 0, 0, 2160, 1200, 1040);
                set(FG_ROOM, F_ROOM_LADDER_OPEN, TRUE);
            }
        }
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            if (ck(FG_ENEMY, F_ENEMY_20C_YAWN_2_0, TRUE))
            {
                aot_delete(AOT_03_EVENT_PIT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            }
        }
        else
        {
            if (ck(FG_ENEMY, F_ENEMY_20C_YAWN_2_0, TRUE) && ck(FG_ROOM, F_ROOM_J_YAWN_DEATH_HANDLED, FALSE))
            {
                aot_delete(AOT_03_EVENT_PIT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
                set(FG_ROOM, F_ROOM_J_YAWN_DEATH_HANDLED, TRUE);
            }
        }
        if (ck(FG_ENEMY, F_ENEMY_20C_YAWN_2_0, TRUE) && ck(FG_ROOM, F_ROOM_YAWN_BGM_ON, TRUE))
        {
            bgm_volume_ramp(BGM_SUB_1, -96, 30);
            set(FG_ROOM, F_ROOM_YAWN_BGM_ON, FALSE);
        }
        if (ck(FG_ROOM, F_ROOM_PLAYER_AT_FIREPLACE, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_LADDER_OPEN, FALSE))
            {
                if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
                {
                    aot_delete(AOT_07_EVENT_LADDER, SCE_EVENT, 0);
                    aot_delete(AOT_04_EVENT_SWITCH, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
                }
                else
                {
                    aot_delete(AOT_0A_EVENT_LADDER, SCE_EVENT, 0);
                    aot_delete(AOT_04_USEITEM_SWITCH, SCE_USEITEM, SAT_MANUAL | SAT_PLAYER);
                }
            }
            else
            {
                if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
                {
                    aot_delete(AOT_07_EVENT_LADDER, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
                    aot_delete(AOT_04_EVENT_SWITCH, SCE_EVENT, 0);
                }
                else
                {
                    aot_delete(AOT_0A_EVENT_LADDER, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
                    aot_delete(AOT_04_USEITEM_SWITCH, SCE_USEITEM, 0);
                }
            }
        }
        else
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                aot_delete(AOT_07_EVENT_LADDER, SCE_EVENT, 0);
                aot_delete(AOT_04_EVENT_SWITCH, SCE_EVENT, 0);
            }
            else
            {
                aot_delete(AOT_0A_EVENT_LADDER, SCE_EVENT, 0);
                aot_delete(AOT_04_USEITEM_SWITCH, SCE_NONE, 0);
            }
        }
        if (ck(FG_SCENARIO, F_SCENARIO_FIREPLACE_LADDER_OPEN, TRUE))
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                aot_delete(AOT_04_EVENT_SWITCH, SCE_NONE, 0);
            }
            else
            {
                aot_delete(AOT_04_USEITEM_SWITCH, SCE_NONE, 0);
            }
        }
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_J_SWITCH_SPOT_USED, TRUE))
            {
                set(FG_ROOM, F_ROOM_J_SWITCH_SPOT_USED, FALSE);
                if (ck(FG_ROOM, F_ROOM_J_BARRY_RETURN_STARTED, FALSE))
                {
                    evt_exec(0, TASK_09, examine_fireplace_switch);
                    set(FG_ROOM, F_ROOM_J_SWITCH_EVENT_RUNNING, TRUE);
                }
            }
            if (ck(FG_ROOM, F_ROOM_J_CALL_BARRY, TRUE))
            {
                if (ck(FG_ROOM, F_ROOM_J_SWITCH_EVENT_RUNNING, FALSE))
                {
                    evt_exec(0, TASK_09, barry_returns_with_rope);
                    set(FG_ROOM, F_ROOM_J_BARRY_RETURN_STARTED, TRUE);
                    set(FG_ROOM, F_ROOM_J_CALL_BARRY, FALSE);
                }
            }
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_02) && ck(FG_SCENARIO, F_SCENARIO_YAWN_2_APPEARED, FALSE))
        {
            bank_bit(255);
            bank_bit(2);
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_01) && ck(FG_SCENARIO, F_SCENARIO_YAWN_2_APPEARED, FALSE))
        {
            bank_bit(255);
            bank_bit(3);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_YAWN_2_APPEARED, TRUE))
        {
            aot_delete(AOT_02_EVENT_YAWN_AMBUSH, SCE_NONE, 0);
        }
        if (ck(FG_ROOM, F_ROOM_PLAYER_IN_TOMBSTONE_ZONE, FALSE))
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                aot_delete(AOT_08_MESSAGE_TOMBSTONE, SCE_MESSAGE, 0);
            }
            else
            {
                aot_delete(AOT_0C_MESSAGE_TOMBSTONE, SCE_MESSAGE, 0);
            }
        }
        else
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                aot_delete(AOT_08_MESSAGE_TOMBSTONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            }
            else
            {
                aot_delete(AOT_0C_MESSAGE_TOMBSTONE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            }
        }
        if (ck(FG_ROOM, F_ROOM_PLAYER_IN_HOLE_ZONE, FALSE))
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                aot_delete(AOT_0A_MESSAGE_HOLE_OPENS, SCE_MESSAGE, 0);
            }
            else
            {
                aot_delete(AOT_0E_MESSAGE_HOLE_OPENS, SCE_MESSAGE, 0);
            }
        }
        else
        {
            if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
            {
                aot_delete(AOT_0A_MESSAGE_HOLE_OPENS, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            }
            else
            {
                aot_delete(AOT_0E_MESSAGE_HOLE_OPENS, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            }
        }
        if (cmpb(B_CAMERA, CMP_EQ, CAM_04_PIT_BOTTOM))
        {
            set(FG_MAP, F_MAP_VISITED_11F, TRUE);
        }
    }
}

event examine_pit
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_fork(TASK_09, crouch_until_released, 0);
    }
    else
    {
        evt_fork(TASK_09, crouch_until_released, 0);
        run
        {
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
            set(FG_COMMON, F_COMMON_J_PIT_SCENE_STARTED, TRUE);
            aot_reset(AOT_03_EVENT_PIT, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
        }
    }
    sleep(26);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_IT_IS_TOO_DARK_TO_SEEWILL | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's too dark to see.Will you jump down? There's a rope. Will you descend it?"
    }
    else
    {
        message(MSG_IT_IS_TOO_DARK_TO_SEE | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's too dark to see anything."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        run
        {
            if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
            {
                evt_exec(0, TASK_09, jump_into_pit);
            }
            else
            {
                set(FG_ROOM, F_ROOM_PLAYER_POSE_RELEASE, TRUE);
                evt_exec(0, TASK_09, leave_pit_or_rope_breaks);
            }
        }
    }
    else
    {
        pos_set(ENEMY_0F_BARRY, 0, 1240, 0, 8768, 0, 14600);
        se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_ENEMY, ENEMY_00_YAWN, 0, 0);
        evt_fork(TASK_09, barry_at_pit_jill_0, 0);
        sleep(80);
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_ENEMY, ENEMY_00_YAWN, 0, 0);
        sleep(10);
        evt_fork(TASK_09, barry_at_pit_walk_in, 0);
        sleep(10);
        run
        {
            cutnext(CAM_00);
            set(FG_ROOM, F_ROOM_PLAYER_POSE_RELEASE, TRUE);
            dir_set(0, 0, 246, 0, 3796, 0, 6495);
        }
        sleep(60);
        cutnext(CAM_02);
        voice_play(VOICE_PLAY, VO_10D_00);
        message(MSG_VO_10D_00, 0);
        sleep(90);
        wait_message();
        cutnext(CAM_03);
        dir_set(0, 0, 982, 0, 3796, 0, 6495);
        evt_fork(TASK_09, barry_at_pit_jill_1, 0);
        voice_play(VOICE_PLAY, VO_10D_01);
        message(MSG_VO_10D_01, 0);
        wait_message();
        evt_fork(TASK_09, barry_at_pit_barry_1, 0);
        voice_play(VOICE_PLAY, VO_10D_02);
        message(MSG_VO_10D_02, 0);
        wait_message();
        evt_fork(TASK_09, barry_at_pit_jill_2, 0);
        voice_play(VOICE_PLAY, VO_10D_03);
        message(MSG_VO_10D_03, 0);
        wait_message();
        evt_work_set(WK_ENEMY, ENEMY_0F_BARRY);
        evt_actor_begin();
        act_motion_path(MOTION_13, 2634, 0, 4825, 200, 100);
        act_reset();
        evt_nop();
        voice_play(VOICE_PLAY, VO_10D_04);
        message(MSG_VO_10D_04, 0);
        wait_message();
        evt_fork(TASK_09, barry_at_pit_barry_2, 0);
        voice_play(VOICE_PLAY, VO_B00_00);
        wait_message();
        run
        {
            if (ck(FG_SCENARIO, F_SCENARIO_HAS_RADIO, FALSE))
            {
                evt_exec(0, TASK_09, barry_gives_radio);
            }
            else
            {
                evt_exec(0, TASK_09, radio_already_given);
            }
        }
    }
    evt_finish();
}

event yawn_ambush
{
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
    }
    evt_fork(TASK_09, yawn_ambush_player_shakes, 0);
    sleep(100);
    run
    {
        bank_bit(255);
        bank_bit(3);
        bank_bit(2);
        cutnext(CAM_01);
        dir_set(0, 0, 1208, 0, 3607, 0, 5516);
        eml_state(0, ENEMY_00_YAWN, EML_BEHAVIOUR, EB_04);
    }
    evt_fork(TASK_09, yawn_bgm, 0);
    evt_fork(TASK_09, yawn_ambush_player, 0);
    sleep(100);
    bank_bit(2);
    cutnext(CAM_02);
    evt_fork(TASK_09, yawn_ambush_player_dodges, 0);
    sleep(70);
    se_play_3d(SND_BANK_ROOM, SE_19, 0, SND_AT_ENEMY, ENEMY_00_YAWN, 0, 0);
    se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_ENEMY, ENEMY_00_YAWN, 0, 0);
    sleep(1);
    se_play_3d(SND_BANK_ROOM, SE_19, 0, SND_AT_ENEMY, ENEMY_00_YAWN, 0, 0);
    se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_ENEMY, ENEMY_00_YAWN, 0, 0);
    sleep(1);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        sleep(98);
    }
    else
    {
        sleep(99);
    }
    evt_chain(end_cutscene);
    evt_nop();
    evt_nop();
}

event yawn_ambush_player_shakes
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_33, 300, 200, 0, 15, 30);
    sleep(40);
    act_motion_path(MOTION_33, -300, 200, 0, 15, 30);
    sleep(40);
    act_motion_path(MOTION_33, 300, 200, 0, 15, 30);
    sleep(40);
    act_motion(MOTION_10);
    act_finish();
}

