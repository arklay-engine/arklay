event yawn_bgm
{
    sleep(1);
    set(FG_ROOM, F_ROOM_YAWN_BGM_ON, TRUE);
    bgm_play(BGM_SUB_1);
    evt_finish();
}

event camera_defer_off
{
    sleep(1);
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, FALSE);
    evt_finish();
}

event descend_ladder
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        message(MSG_THERE_IS_A_LADDER | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "There's a ladder. Will you descend it? A hole opens in the fireplace."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_on(AOT_01_DOOR_21A, SCE_DOOR, 0);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
        else
        {
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
        }
    }
    evt_finish();
}

event yawn_ambush_player
{
    sleep(55);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_param_set(0, 2048);
    sleep(41);
    act_anim_flags(ANIM_06, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_finish();
}
