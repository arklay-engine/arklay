#version 1

proc init
{
    door_aot_set(0, 13700, 960, 1700, 1900, 1, 0, 31, 5, 134, RDT_004, 30700, 0, 3900, 1024, ITEM_SWORD_KEY, 129);
    aot_set(1, 8800, 7200, 1500, 1700, SCE_NONE, 193, 0, 0, 0, 0, 0, 0);
    aot_set(2, 10200, 7300, 600, 1500, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    if (ck(FG_COMMON, 164, 0))
    {
        item_aot_set(3, 0, 0, 0, 0, ITEM_WOOD_EMBLEM, 1, 0, 255, 4, 36, 208, 253, 94, 76, 0, 4, 20, 129, 0, 0);
    }
    else
    {
        item_aot_set(3, 0, 0, 0, 0, ITEM_WOOD_EMBLEM, 1, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 20, 129, 0, 0);
    }
    item_aot_set(4, 8100, 18800, 1500, 1000, ITEM_GOLD_EMBLEM, 1, 1, 255, 4, 36, 208, 253, 94, 76, 0, 4, 21, 129, 0, 0);
    item_aot_set(5, 17000, 11500, 800, 1000, ITEM_MUSIC_NOTES, 0, 2, 255, 98, 67, 72, 244, 30, 45, 226, 4, 7, 129, 0, 0);
    aot_set(6, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 9, 0, 4, 0, 1, 0);
    aot_set(7, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 4, 0, 35, 0, 1, 0);
    aot_set(8, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 9, 0, 5, 0, 1, 0);
    aot_set(9, 8100, 18800, 1500, 1000, SCE_USEITEM, 1, 4, 0, 34, 0, 1, 0);
    aot_set(10, 8100, 18800, 1500, 1000, SCE_MESSAGE, 129, 24, 0, 255, 0, 0, 0);
    aot_set(11, 7000, 14000, 3000, 1000, SCE_USEITEM, 65, 8, 0, 30, 0, 1, 0);
    aot_set(12, 9500, 8200, 500, 800, SCE_NONE, 128, 0, 0, 0, 0, 0, 0);
    aot_set(13, 9500, 8200, 500, 800, SCE_NONE, 129, 0, 0, 0, 0, 0, 0);
    aot_set(14, 10200, 7300, 600, 1500, SCE_USEITEM, 1, 9, 0, 8, 0, 1, 0);
    aot_set(15, 10200, 7300, 600, 1500, SCE_USEITEM, 1, 4, 0, 36, 0, 1, 0);
    obj(0, 53, 255, 9100, 0, 12576, 1024, 62, 254, 0, 0, 194, 1, 0, 0, 84, 6, 24, 21, 128, 62, 144, 1);
    obj(1, 1, 255, 17394, 0, 11190, 1024, 0, 0, 108, 3, 0, 0, 148, 252, 44, 1, 32, 2, 20, 5, 38, 2);
    obj(2, 35, 255, 15000, 0, 11200, 1024, 0, 0, 0, 0, 0, 0, 0, 0, 88, 2, 32, 2, 132, 3, 88, 2);
    if (ck(FG_COMMON, 162, 1))
    {
        if (ck(FG_COMMON, 160, 0))
        {
            if (ck(FG_COMMON, 161, 0))
            {
                evt_exec(0, 0, event_08);
            }
            else
            {
                evt_exec(0, 9, event_06);
                aot_reset(1, SCE_MESSAGE, 129, 146, 125, 0);
            }
        }
    }
    else
    {
        evt_exec(0, 9, event_0C);
    }
    evt_exec(0, 9, event_0E);
    if (ck(FG_COMMON, 162, 1))
    {
        enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 424, 0, 0, 200, 0, 500, 0, 0, 0, 0);
    }
    else if (ck(FG_COMMON, 169, 1))
    {
        enemy(ENEMY_REBECCA_STARS_, 0, 255, 1, 2, 0, 0, 3224, 0, 0, 9600, 0, 8100, 0, 0, 0, 0);
    }
}

proc main
{
    if (testitem(ITEM_MUSIC_NOTES))
    {
        if (ck(FG_ROOM, 36, 0))
        {
            if (ck(FG_COMMON, 98, 0))
            {
                if (ck(FG_COMMON, 97, 0))
                {
                    if (ck(FG_COMMON, 36, 1))
                    {
                        evt_exec(0, 9, event_01);
                    }
                    else
                    {
                        evt_exec(0, 9, event_02);
                    }
                }
                else
                {
                    evt_exec(0, 9, event_11);
                }
            }
            else if (ck(FG_COMMON, 36, 1))
            {
                evt_exec(0, 9, event_01);
            }
            else
            {
                evt_exec(0, 9, event_02);
            }
        }
    }
    if (ck(FG_COMMON, 164, 1))
    {
        if (ck(FG_COMMON, 163, 0))
        {
            aot_delete(6, SCE_USEITEM, 1);
            aot_delete(7, SCE_USEITEM, 1);
        }
        else
        {
            aot_delete(6, SCE_NONE, 1);
            aot_delete(7, SCE_NONE, 1);
        }
        if (testpickup(ITEM_GOLD_EMBLEM))
        {
            set(FG_COMMON, 163, 0);
            evt_exec(0, 9, event_0A);
        }
        if (testitem(ITEM_WOOD_EMBLEM))
        {
            if (ck(FG_ROOM, 35, 0))
            {
                set(FG_ITEM, 20, 0);
                set(FG_COMMON, 164, 0);
                objtbl_b_set(1, 0, 1);
                aot_delete(3, SCE_ITEM, 129);
                evt_exec(0, 9, event_0B);
                evt_exec(0, 9, event_0D);
            }
        }
        if (testitem(ITEM_GOLD_EMBLEM))
        {
            if (ck(FG_ROOM, 34, 0))
            {
                set(FG_ITEM, 21, 0);
                objtbl_b_set(1, 1, 1);
                aot_delete(4, SCE_ITEM, 129);
                evt_exec(0, 9, event_0B);
                set(FG_COMMON, 163, 1);
            }
        }
        if (ck(FG_COMMON, 162, 0))
        {
            if (ck(FG_COMMON, 169, 1))
            {
                aot_delete(1, SCE_NONE, 129);
                aot_reset(13, SCE_EVENT, 129, 9, event_0F, 0);
            }
        }
    }
    else
    {
        if (ck(FG_COMMON, 162, 0))
        {
            if (ck(FG_COMMON, 169, 1))
            {
                aot_delete(1, SCE_NONE, 129);
                aot_reset(13, SCE_EVENT, 129, 9, event_10, 0);
            }
        }
        aot_delete(6, SCE_NONE, 1);
        aot_delete(7, SCE_NONE, 1);
        aot_delete(8, SCE_NONE, 1);
        aot_delete(9, SCE_NONE, 1);
    }
    if (ck(FG_COMMON, 164, 0))
    {
        aot_reset(10, SCE_MESSAGE, 129, 153, 255, 0);
    }
    else if (ck(FG_COMMON, 163, 0))
    {
        aot_reset(10, SCE_MESSAGE, 129, 152, 255, 0);
    }
    else
    {
        aot_delete(10, SCE_NONE, 129);
    }
}

event event_00
{
    sleep(100);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 5, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 32, 1));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 6, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    evt_finish();
}

