#if CHRIS
    room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_MAIN_ON);
    set(FG_ROOM, F_ROOM_0A, TRUE);
    if (ck(FG_COMMON, F_COMMON_37, FALSE))
    {
        enemy(EM_08_PLANT_42, 64, F_ENEMY_60, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 0, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 2048, 0, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 69, 255, 1, 2, 0, 0, 500, 0, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 1500, 0, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, 0, 0, 0);
        enemy(EM_23_NPC_REBECCA, 2, 255, 1, 2, 0, 0, 2500, 0, 0, 27200, 0, 13500, ENEMY_06_NPC_REBECCA, 42, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_37, TRUE) && ck(FG_ENEMY, F_ENEMY_60, TRUE))
    {
        enemy(EM_08_PLANT_42, 4, 255, 1, 2, 0, 0, 1024, 0, 0, 10800, 200, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
        room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_OFF);
        set(FG_ROOM, F_ROOM_0A, FALSE);
    }
    if (ck(FG_COMMON, F_COMMON_37, TRUE) && ck(FG_ENEMY, F_ENEMY_60, FALSE) && ck(FG_COMMON, F_COMMON_38, TRUE))
    {
        enemy(EM_08_PLANT_42, 70, F_ENEMY_60, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 1524, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 0, 0, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 512, 0, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 69, 255, 1, 2, 0, 0, 3072, 0, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, 0, 0, 0);
        enemy(EM_08_PLANT_42, 65, 255, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_37, TRUE) && ck(FG_ENEMY, F_ENEMY_60, FALSE) && ck(FG_COMMON, F_COMMON_38, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_29, TRUE))
        {
            enemy(EM_08_PLANT_42, 8, F_ENEMY_60, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 2024, 0, 0, 10800, -7000, 11200, ENEMY_01_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 5, 255, 1, 2, 0, 0, 3572, 0, 0, 10400, -7000, 10400, ENEMY_02_PLANT_42, 0, 0, 0);
        }
        else
        {
            enemy(EM_08_PLANT_42, 0, F_ENEMY_60, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 1524, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 0, 0, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 512, 0, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 5, 255, 1, 2, 0, 0, 3072, 0, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, 0, 0, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_37, FALSE))
    {
        set(FG_COMMON, F_COMMON_37, TRUE);
        if (ck(FG_COMMON, F_COMMON_22, FALSE) && ck(FG_COMMON, F_COMMON_64, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_59, TRUE))
            {
                if (ck(FG_COMMON, F_COMMON_5D, TRUE))
                {
                    room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD | 1);
                    set(FG_ROOM, F_ROOM_0A, FALSE);
                    evt_exec(0, TASK_09, on_enter);
                }
                else
                {
                    evt_exec(0, TASK_09, on_enter_2);
                }
            }
            else
            {
                room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD | 1);
                set(FG_ROOM, F_ROOM_0A, FALSE);
                evt_exec(0, TASK_09, on_enter);
            }
        }
        else
        {
            evt_exec(0, TASK_09, on_enter_2);
        }
    }
    else if (ck(FG_COMMON, F_COMMON_38, TRUE))
    {
        set(FG_COMMON, F_COMMON_38, FALSE);
        set(FG_SCENARIO, F_SCENARIO_29, TRUE);
        room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD);
        set(FG_ROOM, F_ROOM_0A, FALSE);
        evt_exec(0, TASK_09, on_enter_3);
    }
#else
    aot_set(AOT_07_EVENT, 3229, 10452, 1800, 1800, SCE_EVENT, 0, 9, 0, on_aot_07, 0, 0, 0);
    aot_set(AOT_08_USEITEM, 3800, 12000, 1300, 800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
    aot_set(AOT_09_USEITEM, 4800, 11100, 1500, 1300, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
    if (ck(FG_COMMON, F_COMMON_B2, FALSE))
    {
        set(FG_ROOM, F_ROOM_0F, TRUE);
    }
    if (ck(FG_COMMON, F_COMMON_07, TRUE))
    {
        set(FG_ROOM, F_ROOM_0F, TRUE);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_13, TRUE))
    {
        set(FG_ROOM, F_ROOM_0F, FALSE);
        set(FG_SCENARIO, F_SCENARIO_29, TRUE);
    }
    if (ck(FG_ENEMY, F_ENEMY_60, FALSE))
    {
        room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_MAIN_ON);
        set(FG_ROOM, F_ROOM_0A, TRUE);
    }
    if (ck(FG_ENEMY, F_ENEMY_60, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_29, FALSE))
        {
            if (ck(FG_ROOM, F_ROOM_0F, TRUE))
            {
                room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD | 1);
                set(FG_ROOM, F_ROOM_0A, FALSE);
                enemy(EM_2B_NPC_BARRY_2_STARS, 5, 255, 1, 2, 0, 0, 0, 0, 0, 10000, 0, 30000, ENEMY_06_NPC_BARRY_2_STARS, 42, 0, 0);
                evt_exec(0, TASK_09, on_enter_2);
            }
            enemy(EM_08_PLANT_42, 0, F_ENEMY_60, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 0, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 2048, 0, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 5, 255, 1, 2, 0, 0, 500, 0, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 1500, 0, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, 0, 0, 0);
        }
        else
        {
            enemy(EM_08_PLANT_42, 8, F_ENEMY_60, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 1, 255, 1, 2, 0, 0, 0, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, 0, 0, 0);
            enemy(EM_08_PLANT_42, 5, 255, 1, 2, 0, 0, 1024, 0, 0, 10400, -7000, 11200, ENEMY_02_PLANT_42, 0, 0, 0);
        }
    }
    else
    {
        enemy(EM_08_PLANT_42, 4, 255, 1, 2, 0, 0, 1024, 0, 0, 10800, 200, 10800, ENEMY_00_PLANT_42, 0, 0, 0);
        room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_OFF);
        set(FG_ROOM, F_ROOM_0A, FALSE);
        if (ck(FG_ROOM, F_ROOM_0F, TRUE) && ck(FG_COMMON, F_COMMON_27, FALSE))
        {
            aot_set(AOT_07_EVENT, 6862, 8109, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_07, 0, 0, 0);
            aot_set(AOT_08_USEITEM, 7600, 9900, 1300, 800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
            aot_set(AOT_09_USEITEM, 8300, 8800, 1500, 1300, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
            enemy(EM_2B_NPC_BARRY_2_STARS, 5, 255, 1, 2, 0, 0, 3873, 0, 0, 7762, 0, 9009, ENEMY_06_NPC_BARRY_2_STARS, 42, 0, 0);
            set(FG_ROOM, F_ROOM_0C, TRUE);
            evt_exec(0, TASK_09, on_enter);
        }
    }
