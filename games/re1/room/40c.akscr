    set(FG_SCENARIO, F_SCENARIO_44, TRUE);
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_3E, TRUE) && ck(FG_ITEM, F_ITEM_58, TRUE))
    {
        if (ck(FG_ENEMY, F_ENEMY_60, TRUE))
        {
            aot_delete(AOT_06_MESSAGE, SCE_MESSAGE, 0);
            aot_delete(AOT_03_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_06_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_03_ITEM, SCE_ITEM, 0);
        }
    }
    if (ck(FG_ENEMY, F_ENEMY_60, TRUE))
    {
        set(FG_SCENARIO, F_SCENARIO_00, TRUE);
    }
    if (ck(FG_ENEMY, F_ENEMY_60, TRUE) && ck(FG_ROOM, F_ROOM_0A, TRUE) && ck(FG_ROOM, F_ROOM_0B, FALSE))
    {
        set(FG_ROOM, F_ROOM_0B, TRUE);
#if CHRIS
        evt_exec(0, TASK_09, from_main);
#else
        evt_exec(0, TASK_09, from_main_2);
#endif
    }
    if (ck(FG_ENEMY, F_ENEMY_60, TRUE) && ck(FG_ROOM, F_ROOM_09, TRUE) && ck(FG_ROOM, F_ROOM_0B, FALSE))
    {
        set(FG_ROOM, F_ROOM_0B, TRUE);
#if CHRIS
        evt_exec(0, TASK_09, from_main_2);
#else
        evt_exec(0, TASK_09, from_main_3);
#endif
    }
#if CHRIS
    if (ck(FG_ENEMY, F_ENEMY_60, TRUE) && ck(FG_ROOM, F_ROOM_0D, FALSE))
    {
        if (ck(FG_ITEM, F_ITEM_58, TRUE))
        {
            aot_delete(AOT_05_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_00_DOOR, SCE_DOOR, 0);
        }
        else
        {
            aot_delete(AOT_00_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_05_EVENT, SCE_EVENT, 0);
        }
    }
#else
    if (ck(FG_ENEMY, F_ENEMY_60, TRUE) && ck(FG_ROOM, F_ROOM_0D, FALSE))
    {
        if (ck(FG_ITEM, F_ITEM_58, TRUE))
        {
            aot_delete(AOT_05_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_00_DOOR, SCE_DOOR, 0);
        }
        else
        {
            aot_delete(AOT_00_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_05_EVENT, SCE_EVENT, 0);
        }
    }
    if (ck(FG_ROOM, F_ROOM_0F, TRUE) && ck(FG_ENEMY, F_ENEMY_60, FALSE) && ck(FG_SCENARIO, F_SCENARIO_29, TRUE) && ck(FG_ROOM, F_ROOM_0E, FALSE))
    {
        set(FG_ROOM, F_ROOM_0E, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        evt_exec(0, TASK_09, from_main);
    }
    if (ck(FG_ROOM, F_ROOM_0C, TRUE) && ck(FG_ROOM, F_ROOM_3D, TRUE))
    {
        aot_delete(AOT_07_EVENT, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        aot_delete(AOT_07_EVENT, SCE_EVENT, 0);
    }
#endif
}

#if CHRIS
event on_enter
#else
event on_aot_05
#endif
{
#if CHRIS
    run
    {
        set(FG_COMMON, F_COMMON_3D, TRUE);
        set(FG_COMMON, F_COMMON_38, TRUE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        dir_set(0, 0, 0, 0, 2622, 0, 14077);
        eml_state(0, ENEMY_00_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_01_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_02_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_03_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_04_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_05_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
    }
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        bgm_play(BGM_SUB_1);
        set(FG_ROOM, F_ROOM_09, TRUE);
    }
    evt_fork(TASK_09, on_enter_sub1, 0);
    sleep(160);
    eml_state(0, ENEMY_00_PLANT_42, EML_ACTION, 10);
    sleep(120);
    eml_state(0, ENEMY_00_PLANT_42, EML_ACTION, 11);
    sleep(40);
    run
    {
        msg_list(0, 168, 42, 48, 248, 8, 47, 210, 240, 210, 0, 184, 41, 152, 38, 48, 248, 8, 42, 100, 120, 100, 0, 247, 42, 160, 45, 48, 248, 8, 42, 130, 140, 100, 0, 143, 41, 208, 3, 240, 3, 16, 3);
        cutnext(CAM_07);
        bgm_stop(BGM_SUB_1);
        bgm_play(BGM_MAIN);
        set(FG_ROOM, F_ROOM_09, FALSE);
        set(FG_ROOM, F_ROOM_0A, TRUE);
    }
    evt_fork(TASK_09, on_enter_sub2, 0);
    voice_play(VOICE_PLAY, VO_00A_00, 0);
    sleep(115);
    sleep(20);
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_ENEMY, ENEMY_06_NPC_REBECCA, 0, 0);
    sleep(60);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_ENEMY, ENEMY_06_NPC_REBECCA, 0, 0);
        pos_set(ENEMY_06_NPC_REBECCA, 0, 3824, 0, 2500, 0, 11000);
        msg_list(0, 168, 42, 192, 224, 8, 47, 80, 60, 60, 0, 184, 41, 152, 38, 192, 224, 8, 42, 80, 60, 60, 0, 247, 42, 160, 45, 192, 224, 8, 42, 80, 60, 60, 0, 143, 41, 240, 4, 0, 4, 240, 3);
        cutnext(CAM_00);
    }
    evt_fork(TASK_09, on_enter_sub3, 0);
    sleep(10);
    voice_play(VOICE_PLAY, VO_00A_10, 0);
    message(MSG_VO_00A_10, 0);
    wait_message();
    evt_fork(TASK_09, on_enter_sub4, 0);
    voice_play(VOICE_PLAY, VO_00A_11, 0);
    message(MSG_VO_00A_11, 0);
    wait_message();
    evt_fork(TASK_09, on_enter_sub5, 0);
    voice_play(VOICE_PLAY, VO_00A_12, 0);
    message(MSG_VO_00A_10, 0);
    wait_message();
#else
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 1716, 0, 2439, 0, 9876);
        cutnext(CAM_06);
    }
    effect(FX_0B, 21, 0, 156, 49, 0, 0, 120, 80, 0, 0);
#endif
    sleep(30);
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_PLANT_42);
    evt_tween_begin_alt();
    tw_abs_rot(0, 0, 2600, 65036);
    tw_end();
    evt_nop();
    cutnext(CAM_05);
    evt_fork(TASK_09, on_enter_sub6, 0);
    voice_play(VOICE_PLAY, VO_00A_13, 0);
    message(MSG_VO_00A_13, 0);
    wait_message();
    cutnext(CAM_04);
    evt_fork(TASK_09, on_enter_sub7, 0);
    sleep(25);
    cutnext(CAM_00);
    effect_kill_a(0);
    sleep(35);
