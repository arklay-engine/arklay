#define AOT_00_DOOR_408 0x00
#define AOT_01_ITEM_CHEMICAL_EMPTY_BOTTLE_0 0x01
#define AOT_02_ITEM_CHEMICAL_EMPTY_BOTTLE_1 0x02
#define AOT_03_ITEM_CHEMICAL_EMPTY_BOTTLE_2 0x03
#define AOT_04_ITEM_CHEMICAL_EMPTY_BOTTLE_3 0x04
#define AOT_05_ITEM_CHEMICAL_WATER_4 0x05
#define AOT_06_ITEM_CHEMICAL_UMB_2_5 0x06
#define AOT_07_ITEM_CHEMICAL_UMB_4_6 0x07
#define AOT_08_MESSAGE_FAUCET 0x08                          // "A faucet."; an event that fills an empty bottle while one is carried.
#define AOT_09_MESSAGE_WALL_COLOURS 0x09                    // "Water=1, Red=2, Purple=3, Green=4"
#define AOT_0A_MESSAGE_WALL_SUMS 0x0A                       // "1+2=3, 3+4=7, 2+4=6, 6+7=13, 13+3=16"
#define AOT_0B_MESSAGE_UMB_NO2 0x0B
#define AOT_0C_MESSAGE_UMB_NO4 0x0C
#define AOT_0D_EVENT_REBECCA 0x0D
#define AOT_0E_MESSAGE_USELESS_BOTTLE_0 0x0E                // "It's useless. Chris can't handle chemicals."
#define AOT_0F_MESSAGE_USELESS_BOTTLE_1 0x0F
#define AOT_10_MESSAGE_USELESS_BOTTLE_2 0x10
#define AOT_11_MESSAGE_USELESS_BOTTLE_3 0x11
#define CAM_00_REBECCA 0x00
#define ENEMY_00_REBECCA 0x00
#define FX_09 0x09
#define F_ROOM_ANIM_DONE_IGNORED 0x3F                       // Raised when a scene animation ends; nothing waits on it.
#define F_ROOM_FUMES_PLAYED 0x18                            // The fumes scene after a chemical mix played this visit.
#define F_ROOM_PLAYER_ANIM_DONE 0x19                        // The player's animation finished in the fumes scene.
#define F_ROOM_UNUSED_00 0x00                               // Never set; would replay the fumes scene after a mix.
#define F_ROOM_UNUSED_01 0x01                               // Never set; would flicker the light.
#define F_ROOM_UNUSED_02 0x02                               // Never set; would make the fumes fade stronger.
#define IMDL_00_CHEMICAL_EMPTY_BOTTLE 0x00
#define IMDL_01_CHEMICAL_EMPTY_BOTTLE 0x01
#define IMDL_02_CHEMICAL_EMPTY_BOTTLE 0x02
#define IMDL_03_CHEMICAL_EMPTY_BOTTLE 0x03
#define IMDL_04_CHEMICAL_WATER 0x04
#define IMDL_05_CHEMICAL_UMB_2 0x05
#define IMDL_06_CHEMICAL_UMB_4 0x06
#define MSG_DO_YOU_WANT_ME_TO_HEAL 0x0D
#define MSG_PERHAPS_I_SHOULD_LEAVE_FOR_A 0x0B
#define MSG_REBECCA_TREATS_CHRIS 0x16
#define MSG_THERE_IS_A_UMBNO2_WILL_YOU_PUT_UMB_NO2_IN 0x06
#define MSG_THERE_IS_A_UMBNO4_WILL_YOU_PUT_UMB_NO4_IN 0x07
#define MSG_VO_A08_00 0x0C
#define MSG_VO_A08_01 0x0E
#define MSG_VO_A08_02 0x0F
#define MSG_VO_A08_03 0x10
#define MSG_VO_A08_04 0x11
#define MSG_VO_A08_05 0x12
#define MSG_VO_A08_07 0x14
#define MSG_VO_A08_08 0x15
#define MSG_VO_A08_09 0x13
#define MSG_VO_A08_0A 0x17
#define MSG_WILL_YOU_PUT_WATER_IN_THE 0x05
#define SE_PL_00 0x00
#define VO_A08_00 0x3B
#define VO_A08_01 0x3C
#define VO_A08_02 0x3D
#define VO_A08_03 0x3E
#define VO_A08_04 0x3F
#define VO_A08_05 0x40
#define VO_A08_07 0x42
#define VO_A08_08 0x43
#define VO_A08_09 0x44
#define VO_A08_0A 0x45

proc init
{
    door_aot_set(AOT_00_DOOR_408, 9600, 2300, 1800, 1700, 2, DOOR_SND_00_DR_WD, DOOR_07_DOOR07, 1, 0, ROOM_408_HONEYCOMB_PASSAGE, 8500, 0, 10200, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (cmpb(B_CHARACTER_MODEL, CMP_NE, 3))
        {
            item_aot_set(AOT_01_ITEM_CHEMICAL_EMPTY_BOTTLE_0, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_00_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 4740, -1620, 2500, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_0, SAT_MANUAL | SAT_PLAYER, 0);
            item_aot_set(AOT_02_ITEM_CHEMICAL_EMPTY_BOTTLE_1, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_01_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 3270, -2916, 5800, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_1, SAT_MANUAL | SAT_PLAYER, 0);
            item_aot_set(AOT_03_ITEM_CHEMICAL_EMPTY_BOTTLE_2, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_02_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 6640, -3010, 6220, 900, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_2, SAT_MANUAL | SAT_PLAYER, 0);
            item_aot_set(AOT_04_ITEM_CHEMICAL_EMPTY_BOTTLE_3, 0, 0, 1, 1, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_03_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 2540, -1566, 3130, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_3, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_01_ITEM_CHEMICAL_EMPTY_BOTTLE_0, 4300, 1500, 1100, 1500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_00_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 4740, -1620, 2500, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4);
            item_aot_set(AOT_02_ITEM_CHEMICAL_EMPTY_BOTTLE_1, 1900, 5400, 1200, 1000, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_01_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 3270, -2916, 5800, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_1, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4);
            item_aot_set(AOT_03_ITEM_CHEMICAL_EMPTY_BOTTLE_2, 5100, 6000, 2200, 1100, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_02_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 6640, -3010, 6220, 900, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_2, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4);
            item_aot_set(AOT_04_ITEM_CHEMICAL_EMPTY_BOTTLE_3, 2200, 2800, 850, 500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_03_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 2540, -1566, 3130, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_3, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4);
        }
    }
    else
    {
        item_aot_set(AOT_01_ITEM_CHEMICAL_EMPTY_BOTTLE_0, 4300, 1500, 1100, 1500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_00_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 4740, -1620, 2500, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_0, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4 | 16);
        item_aot_set(AOT_02_ITEM_CHEMICAL_EMPTY_BOTTLE_1, 1900, 5400, 1200, 1000, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_01_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 3270, -2916, 5800, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_1, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4 | 16);
        item_aot_set(AOT_03_ITEM_CHEMICAL_EMPTY_BOTTLE_2, 5100, 6000, 2200, 1100, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_02_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 6640, -3010, 6220, 900, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_2, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4 | 16);
        item_aot_set(AOT_04_ITEM_CHEMICAL_EMPTY_BOTTLE_3, 2200, 2800, 850, 500, IT_13_CHEMICAL_EMPTY_BOTTLE, 1, IMDL_03_CHEMICAL_EMPTY_BOTTLE, SCA_NONE, 2540, -1566, 3130, 0, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_3, SAT_MANUAL | SAT_PLAYER, ITEM_SPARKLE | ITEM_FX_4 | 16);
    }
    item_aot_set(AOT_05_ITEM_CHEMICAL_WATER_4, 0, 0, 1, 1, IT_14_CHEMICAL_WATER, 1, IMDL_04_CHEMICAL_WATER, SCA_NONE, 0, 0, 0, 0, F_ITEM_409_CHEMICAL_WATER_4, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_06_ITEM_CHEMICAL_UMB_2_5, 0, 0, 1, 1, IT_15_CHEMICAL_UMB_2, 1, IMDL_05_CHEMICAL_UMB_2, SCA_NONE, 0, 0, 0, 0, F_ITEM_409_CHEMICAL_UMB_2_5, SAT_MANUAL | SAT_PLAYER, 0);
    item_aot_set(AOT_07_ITEM_CHEMICAL_UMB_4_6, 0, 0, 1, 1, IT_16_CHEMICAL_UMB_4, 1, IMDL_06_CHEMICAL_UMB_4, SCA_NONE, 0, 0, 0, 0, F_ITEM_409_CHEMICAL_UMB_4_6, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        aot_set(AOT_08_MESSAGE_FAUCET, 5900, 1400, 1100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 77, 0, 0, 0);
        aot_set(AOT_09_MESSAGE_WALL_COLOURS, 3000, 1500, 1200, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 77, 0, 0, 0);
        aot_set(AOT_0A_MESSAGE_WALL_SUMS, 9800, 4400, 700, 1700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 77, 0, 0, 0);
        aot_set(AOT_0B_MESSAGE_UMB_NO2, 7300, 6000, 2200, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 0, 77, 0, 0, 0);
        aot_set(AOT_0C_MESSAGE_UMB_NO4, 1900, 3500, 1200, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 0, 77, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_C_PLANT42_INTRO_SEEN, TRUE) && ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE) && ck(FG_COMMON, F_COMMON_C_BACK_AT_GUARDHOUSE_GATE, FALSE))
        {
            enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1300, 0, 7446, 0, 5874, ENEMY_00_REBECCA, ANIM_2A, 0, EVAR_00);
            evt_exec(0, TASK_09, rebecca_idle);
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_STOREROOM_TALK, FALSE))
            {
                aot_set(AOT_0D_EVENT_REBECCA, 6548, 4974, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, rebecca_first_talk, 0, 0, 0);
            }
            else
            {
                aot_set(AOT_0D_EVENT_REBECCA, 6548, 4974, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, rebecca_heal_offer, 0, 0, 0);
            }
        }
        if (cmpb(B_CHARACTER_MODEL, CMP_NE, 3))
        {
            if (ck(FG_ITEM, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_0, TRUE))
            {
                aot_set(AOT_0E_MESSAGE_USELESS_BOTTLE_0, 4300, 1500, 1100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
            }
            if (ck(FG_ITEM, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_1, TRUE))
            {
                aot_set(AOT_0F_MESSAGE_USELESS_BOTTLE_1, 1900, 5400, 1200, 1000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
            }
            if (ck(FG_ITEM, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_2, TRUE))
            {
                aot_set(AOT_10_MESSAGE_USELESS_BOTTLE_2, 5100, 6000, 2200, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
            }
            if (ck(FG_ITEM, F_ITEM_409_CHEMICAL_EMPTY_BOTTLE_3, TRUE))
            {
                aot_set(AOT_11_MESSAGE_USELESS_BOTTLE_3, 2200, 2800, 850, 500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 154, 0, 77, 0, 0, 0);
            }
        }
    }
    else
    {
        aot_set(AOT_0B_MESSAGE_UMB_NO2, 7300, 6000, 2200, 1100, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 0, 255, 0, 0, 0);
        aot_set(AOT_0C_MESSAGE_UMB_NO4, 1900, 3500, 1200, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 0, 255, 0, 0, 0);
        aot_set(AOT_08_MESSAGE_FAUCET, 5900, 1400, 1100, 1500, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 0, 255, 0, 0, 0);
        aot_set(AOT_09_MESSAGE_WALL_COLOURS, 3000, 1500, 1200, 600, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
        aot_set(AOT_0A_MESSAGE_WALL_SUMS, 9800, 4400, 700, 1700, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
    }
}

proc main
{
    set(FG_ITEM, F_ITEM_409_CHEMICAL_WATER_4, TRUE);
    set(FG_ITEM, F_ITEM_409_CHEMICAL_UMB_2_5, TRUE);
    set(FG_ITEM, F_ITEM_409_CHEMICAL_UMB_4_6, TRUE);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        if (cmpb(B_CHARACTER_MODEL, CMP_EQ, 3))
        {
            if (item_ck(IT_13_CHEMICAL_EMPTY_BOTTLE))
            {
                aot_reset(AOT_08_MESSAGE_FAUCET, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fill_bottle_with_water, 0);
                aot_reset(AOT_0B_MESSAGE_UMB_NO2, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fill_bottle_with_umb_no2, 0);
                aot_reset(AOT_0C_MESSAGE_UMB_NO4, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fill_bottle_with_umb_no4, 0);
            }
            else
            {
                aot_reset(AOT_08_MESSAGE_FAUCET, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 77, 0);
                aot_reset(AOT_0B_MESSAGE_UMB_NO2, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 77, 0);
                aot_reset(AOT_0C_MESSAGE_UMB_NO4, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 77, 0);
            }
        }
        else if (ck(FG_ITEM, F_ITEM_40A_FILE_V_JOLT_REPORT_0, FALSE))
        {
            aot_reset(AOT_0B_MESSAGE_UMB_NO2, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 152, 77, 0);
            aot_reset(AOT_0C_MESSAGE_UMB_NO4, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 153, 77, 0);
        }
        else
        {
            aot_reset(AOT_0B_MESSAGE_UMB_NO2, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 152, 77, 0);
            aot_reset(AOT_0C_MESSAGE_UMB_NO4, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 153, 77, 0);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_CHEMICAL_MIXED, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_FUMES_PLAYED, FALSE))
            {
                evt_exec(0, TASK_09, mixing_fumes);
            }
            else if (ck(FG_ROOM, F_ROOM_UNUSED_00, TRUE))
            {
                evt_exec(0, TASK_09, mixing_fumes);
            }
            set(FG_SCENARIO, F_SCENARIO_CHEMICAL_MIXED, FALSE);
            set(FG_ROOM, F_ROOM_FUMES_PLAYED, TRUE);
        }
        if (ck(FG_ROOM, F_ROOM_UNUSED_01, TRUE))
        {
            set(FG_ROOM, F_ROOM_UNUSED_01, FALSE);
            evt_exec(0, TASK_09, fumes_light_flicker);
        }
    }
    else
    {
        if (ck(FG_ITEM, F_ITEM_40A_FILE_V_JOLT_REPORT_0, TRUE))
        {
            if (item_ck(IT_13_CHEMICAL_EMPTY_BOTTLE))
            {
                aot_reset(AOT_08_MESSAGE_FAUCET, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fill_bottle_with_water, 0);
            }
            else
            {
                aot_reset(AOT_08_MESSAGE_FAUCET, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 77, 0);
            }
            aot_delete(AOT_0B_MESSAGE_UMB_NO2, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_0C_MESSAGE_UMB_NO4, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
        else if (item_ck(IT_13_CHEMICAL_EMPTY_BOTTLE))
        {
            aot_reset(AOT_08_MESSAGE_FAUCET, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fill_bottle_with_water, 0);
            aot_reset(AOT_0B_MESSAGE_UMB_NO2, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fill_bottle_with_umb_no2, 0);
            aot_reset(AOT_0C_MESSAGE_UMB_NO4, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, fill_bottle_with_umb_no4, 0);
        }
        else
        {
            aot_reset(AOT_08_MESSAGE_FAUCET, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 132, 77, 0);
            aot_reset(AOT_0B_MESSAGE_UMB_NO2, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 136, 77, 0);
            aot_reset(AOT_0C_MESSAGE_UMB_NO4, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 137, 77, 0);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_CHEMICAL_MIXED, TRUE))
        {
            if (ck(FG_ROOM, F_ROOM_FUMES_PLAYED, FALSE))
            {
                evt_exec(0, TASK_09, mixing_fumes);
            }
            else if (ck(FG_ROOM, F_ROOM_UNUSED_00, TRUE))
            {
                evt_exec(0, TASK_09, mixing_fumes);
            }
            set(FG_SCENARIO, F_SCENARIO_CHEMICAL_MIXED, FALSE);
            set(FG_ROOM, F_ROOM_FUMES_PLAYED, TRUE);
        }
    }
}

event fill_bottle_with_water
{
    run
    {
        set(FG_RUN, F_RUN_PLAYER, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_EFFECTS, FALSE);
        message(MSG_WILL_YOU_PUT_WATER_IN_THE | MSG_FAST, 0); // "Will you put water in the empty bottle? There's a UMB.No2. Will you put UMB No.2 in the empty bottle? There's a UMB.No4. Will you put UMB No.4 in the empty bottle? There's UMB No.2. You need a container to obtain it."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            remove_item(IT_13_CHEMICAL_EMPTY_BOTTLE);
            give_item(AOT_05_ITEM_CHEMICAL_WATER_4, 4, 0);
        }
        set(FG_RUN, F_RUN_PLAYER, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_EFFECTS, TRUE);
    }
    evt_finish();
}

