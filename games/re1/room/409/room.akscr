event mixing_fumes
{
    run
    {
        set(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_01, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_reset();
    evt_nop();
    se_play_3d(SND_BANK_PLAYER, SE_PL_00, 0, SND_AT_PLAYER, 0, 0, 0);
    single(12) effect(FX_09, FX_ROW_19, FX_AT_PLAYER, 600, -2400, 0, 0);
    evt_nop();
    evt_nop();
    sleep(4);
    single(12) effect(FX_09, FX_ROW_19, FX_AT_PLAYER, 600, -2400, 0, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ROOM, F_ROOM_UNUSED_02, TRUE))
        {
            timer_setup(LIGHT_FADE_HALF, 1600, FADE_R | FADE_G);
        }
        else
        {
            timer_setup(LIGHT_FADE_HALF, 1200, FADE_R | FADE_G);
        }
        set(FG_ROOM, F_ROOM_PLAYER_ANIM_DONE, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_PLAYER, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
    }
    sleep(20);
    setw(W_LIGHT_DELTA, 0);
    message(MSG_PERHAPS_I_SHOULD_LEAVE_FOR_A | MSG_FAST, 0); // "Perhaps I should leave for a moment."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_PLAYER, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        sys_multi(SYS_HEALTH_STATUS, SYS_OR | HS_40);
    }
    evt_finish();
}

event fumes_light_flicker
{
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, 0, 0);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -1, FADE_R | FADE_G | FADE_B);
    sleep(1);
    timer_setup(LIGHT_FADE_VEIL, -10000, FADE_R | FADE_G | FADE_B);
    evt_finish();
}

event rebecca_idle
{
    sleep(1);
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_PLAYER, 0, 0, 150, 75);
    act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE_IGNORED, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0010);
    act_finish();
}

event rebecca_first_talk
{
    run
    {
        cutnext(CAM_00_REBECCA);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        set(FG_COMMON, F_COMMON_C_REBECCA_STOREROOM_TALK, TRUE);
    }
    evt_fork(TASK_09, rebecca_first_talk_anim, 0);
    voice_play(VOICE_PLAY, VO_A08_00);
    message(MSG_VO_A08_00, 0);
    wait_message();
    message(MSG_DO_YOU_WANT_ME_TO_HEAL, 0); // "Do you want me to heal your wounds?"
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            evt_exec(0, TASK_09, rebecca_first_heal);
        }
        else
        {
            evt_exec(0, TASK_09, rebecca_first_heal_declined);
        }
    }
    evt_finish();
}

