{
    run
    {
        set(FG_RUN, F_RUN_PLAYER, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_EFFECTS, FALSE);
        message(MSG_THERE_IS_A_UMBNO4_WILL_YOU_PUT_UMB_NO4_IN | MSG_FAST, 0); // "There's a UMB.No4. Will you put UMB No.4 in the empty bottle? There's UMB No.2. You need a container to obtain it."
    }
    do
    {
        evt_next();
    }
