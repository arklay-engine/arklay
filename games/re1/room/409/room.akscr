    timer_setup(LIGHT_FADE_VEIL, 256, FADE_R | FADE_G | FADE_B);
    sleep(120);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_sel(TW_HEALTH, 140);
    tw_end();
    evt_nop();
    timer_setup(LIGHT_FADE_VEIL, 0, FADE_R | FADE_G | FADE_B);
    message(MSG_REBECCA_TREATS_CHRIS, 0); // "Rebecca treats Chris."
    wait_message();
    timer_setup(LIGHT_FADE_VEIL, -256, FADE_R | FADE_G | FADE_B);
    sleep(150);
    timer_setup(LIGHT_FADE_VEIL, 0, FADE_R | FADE_G | FADE_B);
    evt_chain(rebecca_first_talk_end);
    evt_nop();
    evt_nop();
}

