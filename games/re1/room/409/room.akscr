    act_flag_op(EF_OR, EF_0004);
    act_reset();
    evt_nop();
    eml_state(0, ENEMY_00_REBECCA, EML_STATUS, EML_STATUS_OR | 2);
    evt_work_set(WK_ENEMY, ENEMY_00_REBECCA);
    evt_actor_begin();
    act_anim_flags(ANIM_20, F_ROOM_ANIM_DONE_IGNORED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_22, F_ROOM_ANIM_DONE_IGNORED, AFL_02 | AFL_01);
    sleep(20);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_IGNORED, AFL_02 | AFL_01);
    sleep(50);
    act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE_IGNORED, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0010);
    act_reset();
    evt_nop();
    sleep(10);
    eml_state(0, ENEMY_00_REBECCA, EML_STATUS, EML_STATUS_XOR | 2);
    evt_finish();
