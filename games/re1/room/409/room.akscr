    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            remove_item(IT_13_CHEMICAL_EMPTY_BOTTLE);
            give_item(AOT_07_ITEM_CHEMICAL_UMB_4_6, 4, 0);
        }
        set(FG_RUN, F_RUN_PLAYER, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_EFFECTS, TRUE);
    }
    evt_finish();
