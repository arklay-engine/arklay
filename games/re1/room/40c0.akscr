#version 1

proc init
{
    door_aot_set(0, 1100, 8000, 1500, 3900, 11, 0, 0, 1, 0, RDT_008, 26000, 0, 4000, 2048, UNLOCKED, 129);
    aot_set(1, 1000, 12400, 1500, 3000, SCE_MESSAGE, 129, 140, 0, 255, 0, 0, 0);
    aot_set(2, 9800, 16600, 2200, 1200, SCE_USEITEM, 65, 4, 0, 62, 0, 1, 0);
    item_aot_set(3, 9800, 17700, 2200, 1800, ITEM_HELMET_KEY, 3, 0, 255, 54, 41, 52, 254, 90, 70, 0, 4, 88, 0, 0, 0);
    eml_rot(0, 250, 0, 28, 248);
    aot_set(5, 1100, 8000, 1500, 3900, SCE_EVENT, 0, 9, 0, event_0B, 0, 0, 0);
    aot_set(6, 9800, 17200, 1700, 1100, SCE_MESSAGE, 0, 139, 0, 255, 0, 0, 0);
    room_bgm_state_set(3, 12, 8);
    set(FG_ROOM, 10, 0);
    if (ck(FG_COMMON, 55, 1))
    {
        enemy(ENEMY_PLANT_42, 64, 96, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10800, 0, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 0, 0, 0, 11200, -7000, 10800, 1, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 11200, 2, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 2048, 0, 0, 11200, -7000, 11200, 3, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 69, 255, 1, 2, 0, 0, 500, 0, 0, 10400, -7000, 10800, 4, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 1500, 0, 0, 10800, -7000, 10400, 5, 0, 0, 0);
        enemy(ENEMY_REBECCA_STARS_, 2, 255, 1, 2, 0, 0, 2500, 0, 0, 27200, 0, 13500, 6, 42, 0, 0);
    }
    if (ck(FG_COMMON, 55, 0) && ck(FG_ENEMY, 96, 0))
    {
        enemy(ENEMY_PLANT_42, 4, 255, 1, 2, 0, 0, 1024, 0, 0, 10800, 200, 10800, 0, 0, 0, 0);
        room_bgm_state_set(3, 12, 255);
        set(FG_ROOM, 10, 1);
    }
    if (ck(FG_COMMON, 55, 0) && ck(FG_ENEMY, 96, 1) && ck(FG_COMMON, 56, 0))
    {
        enemy(ENEMY_PLANT_42, 70, 96, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 10800, 0, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 1524, 0, 0, 11200, -7000, 10800, 1, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 0, 0, 0, 10800, -7000, 11200, 2, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 512, 0, 0, 11200, -7000, 11200, 3, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 69, 255, 1, 2, 0, 0, 3072, 0, 0, 10400, -7000, 10800, 4, 0, 0, 0);
        enemy(ENEMY_PLANT_42, 65, 255, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10400, 5, 0, 0, 0);
    }
    if (ck(FG_COMMON, 55, 0) && ck(FG_ENEMY, 96, 1) && ck(FG_COMMON, 56, 1))
    {
        if (ck(FG_SCENARIO, 41, 0))
        {
            enemy(ENEMY_PLANT_42, 8, 96, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 10800, 0, 0, 0, 0);
            enemy(ENEMY_PLANT_42, 1, 255, 1, 2, 0, 0, 2024, 0, 0, 10800, -7000, 11200, 1, 0, 0, 0);
            enemy(ENEMY_PLANT_42, 5, 255, 1, 2, 0, 0, 3572, 0, 0, 10400, -7000, 10400, 2, 0, 0, 0);
        }
        else
        {
            enemy(ENEMY_PLANT_42, 0, 96, 1, 2, 0, 0, 1024, 0, 0, 10800, -7000, 10800, 0, 0, 0, 0);
            enemy(ENEMY_PLANT_42, 1, 255, 1, 2, 0, 0, 1524, 0, 0, 11200, -7000, 10800, 1, 0, 0, 0);
            enemy(ENEMY_PLANT_42, 1, 255, 1, 2, 0, 0, 0, 0, 0, 10800, -7000, 11200, 2, 0, 0, 0);
            enemy(ENEMY_PLANT_42, 1, 255, 1, 2, 0, 0, 512, 0, 0, 11200, -7000, 11200, 3, 0, 0, 0);
            enemy(ENEMY_PLANT_42, 5, 255, 1, 2, 0, 0, 3072, 0, 0, 10400, -7000, 10800, 4, 0, 0, 0);
            enemy(ENEMY_PLANT_42, 1, 255, 1, 2, 0, 0, 3572, 0, 0, 10800, -7000, 10400, 5, 0, 0, 0);
        }
    }
    if (ck(FG_COMMON, 55, 1))
    {
        set(FG_COMMON, 55, 0);
        if (ck(FG_COMMON, 34, 1) && ck(FG_COMMON, 100, 1))
        {
            if (ck(FG_COMMON, 89, 0))
            {
                if (ck(FG_COMMON, 93, 0))
                {
                    room_bgm_state_set(3, 12, 65);
                    set(FG_ROOM, 10, 1);
                    evt_exec(0, 9, event_00);
                }
                else
                {
                    evt_exec(0, 9, event_09);
                }
            }
            else
            {
                room_bgm_state_set(3, 12, 65);
                set(FG_ROOM, 10, 1);
                evt_exec(0, 9, event_00);
            }
        }
        else
        {
            evt_exec(0, 9, event_09);
        }
    }
    else if (ck(FG_COMMON, 56, 0))
    {
        set(FG_COMMON, 56, 1);
        set(FG_SCENARIO, 41, 0);
        room_bgm_state_set(3, 12, 64);
        set(FG_ROOM, 10, 1);
        evt_exec(0, 9, event_0A);
    }
    set(FG_SCENARIO, 68, 0);
}

proc main
{
    if (ck(FG_ROOM, 62, 0) && ck(FG_ITEM, 88, 0))
    {
        if (ck(FG_ENEMY, 96, 0))
        {
            aot_delete(6, SCE_MESSAGE, 0);
            aot_delete(3, SCE_ITEM, 129);
        }
        else
        {
            aot_delete(6, SCE_MESSAGE, 129);
            aot_delete(3, SCE_ITEM, 0);
        }
    }
    if (ck(FG_ENEMY, 96, 0))
    {
        set(FG_SCENARIO, 0, 0);
    }
    if (ck(FG_ENEMY, 96, 0) && ck(FG_ROOM, 10, 0) && ck(FG_ROOM, 11, 1))
    {
        set(FG_ROOM, 11, 0);
        evt_exec(0, 9, event_0C);
    }
    if (ck(FG_ENEMY, 96, 0) && ck(FG_ROOM, 9, 0) && ck(FG_ROOM, 11, 1))
    {
        set(FG_ROOM, 11, 0);
        evt_exec(0, 9, event_0D);
    }
    if (ck(FG_ENEMY, 96, 0) && ck(FG_ROOM, 13, 1))
    {
        if (ck(FG_ITEM, 88, 0))
        {
            aot_delete(5, SCE_EVENT, 129);
            aot_delete(0, SCE_DOOR, 0);
        }
        else
        {
            aot_delete(0, SCE_DOOR, 129);
            aot_delete(5, SCE_EVENT, 0);
        }
    }
}

