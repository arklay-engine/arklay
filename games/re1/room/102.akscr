#version 1

proc init
{
#if MANSION1
    door_aot_set(0, 2500, 9400, 1700, 2000, 1, 0, 29, 5, 0, RDT_001, 15000, 0, 18800, 3072, UNLOCKED, 129);
#else
    door_aot_set(0, 2900, 9000, 1200, 1300, 1, 0, 29, 5, 0, RDT_001, 15000, 0, 18800, 3072, UNLOCKED, 129);
#endif
    item_aot_set(1, 6500, 9100, 500, 900, ITEM_BROKEN_SHOTGUN, 1, 0, 255, 184, 26, 54, 247, 198, 37, 48, 248, 48, 129, 0, 0);
    eml_rot(0, 156, 255, 180, 251);
#if MANSION1
    item_aot_set(2, 0, 0, 0, 0, ITEM_SHELLS, 7, 1, 255, 24, 11, 102, 254, 22, 8, 232, 3, 49, 0, 0, 0);
#else
    item_aot_set(2, 0, 0, 0, 0, ITEM_SHELLS, 7, 1, 255, 24, 11, 102, 254, 22, 8, 232, 3, 49, 129, 0, 0);
#endif
    eml_rot(1, 0, 0, 180, 251);
    setbyte(1, 0, 0);
    item_aot_set(3, 4540, 8470, 1800, 1800, ITEM_CLIP, 15, 2, 255, 64, 21, 204, 247, 154, 36, 0, 0, 50, 129, 0, 0);
    aot_set(4, 2000, 2237, 1750, 700, SCE_HIKIDASHI, 129, 30, 0, 2, 0, 3, 0);
#if MANSION2
    if (ck(FG_STATUS, 8, 1))
    {
        if (ck(FG_COMMON, 47, 0))
        {
            set(FG_COMMON, 48, 0);
            set(FG_COMMON, 192, 0);
            set(FG_COMMON, 47, 1);
            evt_exec(0, 9, event_01);
        }
    }
#endif
}
#if MANSION2

event event_00
{
    evt_work_set(WK_AOT, 0);
    evt_tween_begin_alt();
    tw_abs_rot(0, 65436, 63536, 64436);
    tw_end();
    evt_nop();
    evt_finish();
}

event event_01
{
    set(FG_STATUS, 15, 0);
    sleep(1);
    set(FG_6, 23, 1);
    set(FG_6, 29, 1);
    voice_play(1, 133, 0);
    wait_message();
    evt_fork(9, event_02, 0);
    sleep(100);
    run
    {
        cut_auto(0);
        set(FG_STATUS, 15, 1);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
    }
    evt_finish();
}

event event_02
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 31, 0 | 0);
    act_param_set(0, 8);
    sleep(42);
    act_idle();
    act_finish();
}
#endif
