#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_HIKIDASHI 0x04
#define VO_A00_00 0x85

proc init
{
#if MANSION1
    door_aot_set(AOT_00_DOOR, 2500, 9400, 1700, 2000, 1, DOOR_SND_00_DR_WD, DOOR_1D_DOOR01K, 5, 0, ROOM_101_1F_LEFT_STAIRS, 15000, 0, 18800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#else
    door_aot_set(AOT_00_DOOR, 2900, 9000, 1200, 1300, 1, DOOR_SND_00_DR_WD, DOOR_1D_DOOR01K, 5, 0, ROOM_101_1F_LEFT_STAIRS, 15000, 0, 18800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#endif
    item_aot_set(AOT_01_ITEM, 6500, 9100, 500, 900, IT_1C_KEY_BROKEN_SHOTGUN, 1, 0, 255, 184, 26, 54, 247, 198, 37, 48, 248, F_ITEM_30, 129, 0, 0);
    eml_rot(0, 156, 255, 180, 251);
#if MANSION1
    item_aot_set(AOT_02_ITEM, 0, 0, 0, 0, IT_0C_AMMO_SHOTGUN, 7, 1, 255, 24, 11, 102, 254, 22, 8, 232, 3, F_ITEM_31, 0, 0, 0);
#else
    item_aot_set(AOT_02_ITEM, 0, 0, 0, 0, IT_0C_AMMO_SHOTGUN, 7, 1, 255, 24, 11, 102, 254, 22, 8, 232, 3, F_ITEM_31, 129, 0, 0);
#endif
    eml_rot(1, 0, 0, 180, 251);
    setbyte(1, 0, 0);
    item_aot_set(AOT_03_ITEM, 4540, 8470, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, 2, 255, 64, 21, 204, 247, 154, 36, 0, 0, F_ITEM_32, 129, 0, 0);
    aot_set(AOT_04_HIKIDASHI, 2000, 2237, 1750, 700, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 30, 0, 2, 0, 3, 0);
#if MANSION2
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_2F, TRUE))
        {
            set(FG_COMMON, F_COMMON_30, TRUE);
            set(FG_COMMON, F_COMMON_C0, TRUE);
            set(FG_COMMON, F_COMMON_2F, FALSE);
            evt_exec(0, TASK_09, on_enter);
        }
    }
#endif
}
#if MANSION2

event event_00
{
    evt_work_set(WK_AOT, AOT_00_DOOR);
    evt_tween_begin_alt();
    tw_abs_rot(0, 65436, 63536, 64436);
    tw_end();
    evt_nop();
    evt_finish();
}

event on_enter
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    set(FG_6, F_6_1D, FALSE);
    voice_play(VOICE_PLAY, VO_A00_00, 0);
    wait_message();
    evt_fork(TASK_09, on_enter_sub1, 0);
    sleep(100);
    run
    {
        cut_auto(0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
    }
    evt_finish();
}

event on_enter_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 31, 0 | 0);
    act_param_set(0, 8);
    sleep(42);
    act_idle();
    act_finish();
}
#endif
