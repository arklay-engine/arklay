#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_EVENT 0x05
#define AOT_06_HIKIDASHI 0x06
#define AOT_07_MESSAGE 0x07
#define AOT_08_MESSAGE 0x08
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define MSG_THERE_IS_A_KEY_IN_THE 0x00

proc init
{
    door_aot_set(AOT_00_DOOR, 8800, 400, 1600, 2100, 2, 0, 6, 1, 0, ROOM_400_ENTER_PASSAGE, 13300, 0, 13600, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 7300, 2200, 1600, 2200, 1, 0, 33, 1, 0, ROOM_402_ROOM_001_BATHROOM, 6300, 0, 3300, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_02_ITEM, 9500, 12900, 1000, 1000, IT_3E_KEY_BOOK_BLANK, 1, 0, 255, 16, 39, 42, 254, 88, 52, 0, 0, 99, 129, 0, 0);
#if CHRIS
    item_aot_set(AOT_03_ITEM, 2300, 13500, 1000, 1000, IT_3D_KEY_DESK, 1, 1, 255, 54, 11, 96, 250, 120, 55, 0, 0, 100, 129, 0, 0);
    eml_rot(1, 0, 8, 150, 0);
    aot_delete(AOT_03_ITEM, SCE_NONE, 0);
#endif
    item_aot_set(AOT_04_ITEM, 0, 0, 1, 1, IT_0C_AMMO_SHOTGUN, 7, 2, 255, 106, 39, 60, 0, 42, 38, 240, 251, 165, 129, 0, 0);
    eml_rot(2, 116, 255, 186, 255);
    setbyte(2, 0, 0);
#if CHRIS
    if (ck(FG_ITEM, F_ITEM_64, TRUE))
    {
        aot_set(AOT_05_EVENT, 2300, 13500, 1000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
    }
#endif
    if (ck(FG_ITEM, F_ITEM_A5, TRUE))
    {
        aot_set(AOT_06_HIKIDASHI, 9600, 10600, 1000, 1500, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 33, 0, 4, 0, 3, 0);
    }
    aot_set(AOT_07_MESSAGE, 1700, 10800, 1100, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 0, 255, 0, 0, 0);
    aot_set(AOT_08_MESSAGE, 5000, 15100, 1500, 300, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 0, 255, 0, 0, 0);
#if JILL
    set(FG_STATUS, F_STATUS_3C, TRUE);
#endif
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 0, 183, 1, 2, 0, 0, 413, 0, 0, 4463, 0, 12506, ENEMY_00_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 0, 184, 1, 2, 0, 0, 773, 0, 0, 8350, 0, 11866, ENEMY_01_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
#if CHRIS
    set(FG_STATUS, F_STATUS_3C, TRUE);
#endif
}

#if CHRIS
event on_aot_05
#else
event event_00
#endif
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        cutnext(4);
#if CHRIS
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
#else
        aot_delete(5, SCE_NONE, 0);
#endif
    }
    sleep(1);
    run
    {
        message(MSG_THERE_IS_A_KEY_IN_THE | MSG_FAST, 255); // "There's a key in the cup."
    }
    wait_message();
    run
    {
#if CHRIS
        aot_delete(AOT_03_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
#else
        aot_delete(3, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
#endif
        cutcurr(0);
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}
