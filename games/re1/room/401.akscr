#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

proc init
{
    door_aot_set(0, 8800, 400, 1600, 2100, 2, 0, 6, 1, 0, ROOM_400_ENTER_PASSAGE, 13300, 0, 13600, 1024, UNLOCKED, 129);
    door_aot_set(1, 7300, 2200, 1600, 2200, 1, 0, 33, 1, 0, ROOM_402_ROOM_001_BATHROOM, 6300, 0, 3300, 2048, UNLOCKED, 129);
    item_aot_set(2, 9500, 12900, 1000, 1000, ITEM_3E_PUZZLE_BOOK_BLANK, 1, 0, 255, 16, 39, 42, 254, 88, 52, 0, 0, 99, 129, 0, 0);
#if CHRIS
    item_aot_set(3, 2300, 13500, 1000, 1000, ITEM_3D_KEY_DESK, 1, 1, 255, 54, 11, 96, 250, 120, 55, 0, 0, 100, 129, 0, 0);
    eml_rot(1, 0, 8, 150, 0);
    aot_delete(3, SCE_NONE, 0);
#endif
    item_aot_set(4, 0, 0, 1, 1, ITEM_0C_AMMO_SHOTGUN, 7, 2, 255, 106, 39, 60, 0, 42, 38, 240, 251, 165, 129, 0, 0);
    eml_rot(2, 116, 255, 186, 255);
    setbyte(2, 0, 0);
#if CHRIS
    if (ck(FG_ITEM, FLAG_ITEM_64, TRUE))
    {
        aot_set(5, 2300, 13500, 1000, 1000, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    }
#endif
    if (ck(FG_ITEM, FLAG_ITEM_A5, TRUE))
    {
        aot_set(6, 9600, 10600, 1000, 1500, SCE_HIKIDASHI, 129, 33, 0, 4, 0, 3, 0);
    }
    aot_set(7, 1700, 10800, 1100, 2000, SCE_MESSAGE, 129, 130, 0, 255, 0, 0, 0);
    aot_set(8, 5000, 15100, 1500, 300, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
#if JILL
    set(FG_STATUS, FLAG_STATUS_3C, TRUE);
#endif
    enemy(ENEMY_00_ZOMBIE_GROUNDSKEEPER, 0, 183, 1, 2, 0, 0, 413, 0, 0, 4463, 0, 12506, 0, 0, 0, 0);
    enemy(ENEMY_00_ZOMBIE_GROUNDSKEEPER, 0, 184, 1, 2, 0, 0, 773, 0, 0, 8350, 0, 11866, 1, 0, 0, 0);
#if CHRIS
    set(FG_STATUS, FLAG_STATUS_3C, TRUE);
#endif
}

event event_00
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        cutnext(4);
        aot_delete(5, SCE_NONE, 0);
    }
    sleep(1);
    run
    {
        message(128, 255);
    }
    wait_message();
    run
    {
        aot_delete(3, SCE_ITEM, 129);
        cutcurr(0);
        cut_auto(0);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}
