        eml_state(0, 1, 8);
#endif
        cutnext(0);
        cut_auto(0);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
#if CHRIS
        eml_state(0, 0, 8);
#else
        set(FG_6, FLAG_6_17, TRUE);
#endif
    }
#if CHRIS
    sleep(20);
    set(FG_6, FLAG_6_17, TRUE);
#endif
    evt_finish();
}

#if CHRIS
event on_enter_2
#else
event on_enter_3
#endif
{
#if CHRIS
    sleep(5);
    run
    {
        eml_state(0, 0, 8);
    }
#else
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(10);
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_anim_seq(35843, 45076, 8733);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_22, FALSE));
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_anim_flags(32 | 6, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    sleep(35);
    run
    {
        voice_play(1, 69, 0);
        message(8, 0);
    }
    wait_message();
    run
    {
        cutnext(0);
        cut_auto(0);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        eml_state(0, 1, 8);
        set(FG_6, FLAG_6_17, TRUE);
    }
#endif
    evt_finish();
}

event on_aot_00_door
{
    message(138, 255); // "There's a ladder. Will you climb it?He must have been attacked by those monsters."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            aot_on(AOT_00_DOOR, SCE_DOOR, 0);
        }
    }
    evt_finish();
}
