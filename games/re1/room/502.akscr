    wait_message();
    run
    {
        cutnext(0);
        cut_auto(0);
        set(FG_STATUS, 15, 1);
        eml_state(0, 1, 8);
        set(FG_6, 23, 0);
    }
#endif
    evt_finish();
}

#if CHRIS
event event_02
#else
event event_03
#endif
{
    message(138, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            aot_on(0, SCE_DOOR, 0);
        }
    }
    evt_finish();
}
#if JILL

event event_04
{
    sleep(1);
    run
    {
        eml_state(0, 1, 8);
    }
    evt_finish();
}
