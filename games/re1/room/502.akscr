#if CHRIS
event on_enter_2
#else
event on_enter_3
#endif
{
#if CHRIS
    sleep(5);
    run
    {
        eml_state(0, ENEMY_00_NPC_JILL, EML_08);
    }
#else
    sleep(1);
    run
    {
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(10);
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
    evt_actor_begin();
    act_anim_seq(35843, 45076, 8733);
    act_nop();
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_22, FALSE));
    evt_work_set(WK_ENEMY, ENEMY_01_NPC_CHRIS);
    evt_actor_begin();
    act_anim_flags(32 | 6, 32 | 0, 0 | 1);
    act_reset();
    evt_nop();
    sleep(35);
    run
    {
        voice_play(VOICE_PLAY, VO_A00_04_45, 0);
        message(MSG_VO_A00_04_45, 0);
    }
    wait_message();
    run
    {
        cutnext(CAM_00);
        cut_auto(0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        eml_state(0, ENEMY_01_NPC_CHRIS, EML_08);
        set(FG_MESSAGE, F_MESSAGE_CONTROLS, TRUE);
    }
#endif
    evt_finish();
}

event on_aot_00_door
{
    message(MSG_THERE_IS_A_LADDER | MSG_FAST, MSG_PAUSE_0080 | MSG_PAUSE_0040 | MSG_PAUSE_0020 | MSG_PAUSE_0010 | MSG_PAUSE_EFFECTS | MSG_PAUSE_MONSTERS | MSG_PAUSE_ENTITIES | MSG_PAUSE_PLAYER); // "There's a ladder. Will you climb it? He must have been attacked by those monsters."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            aot_on(AOT_00_DOOR, SCE_DOOR, 0);
        }
    }
    evt_finish();
}
