event on_enter
#else
event on_enter
{
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    evt_work_set(WK_ENEMY, 0);
