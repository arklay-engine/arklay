event event_05
{
    run
    {
        require(item_ck(IT_03_WEAPON_SHOTGUN));
        swap_var(2, 1, 12);
        setb(B_SELECTED_ITEM, IT_03_WEAPON_SHOTGUN, 0);
        set(FG_STATUS, F_STATUS_12, TRUE);
    }
    evt_finish();
}

event on_enter_2
{
    sleep(10);
    run
    {
        se_play_3d(2, 25, 6, SND_AT_POINT, 0, 4700, 10380);
        se_play_3d(2, 26, 6, SND_AT_POINT, 0, 4700, 10380);
    }
    evt_finish();
}
