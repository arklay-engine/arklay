event event_05
{
    run
    {
        require(item_ck(ITEM_03_WEAPON_SHOTGUN));
        swap_var(2, 1, 12);
        setb(6, 3, 0);
        set(FG_STATUS, FLAG_STATUS_12, TRUE);
    }
    evt_finish();
}

event on_enter_2
{
    sleep(10);
    run
    {
        se_play_3d(2, 25, 6, 0, 0, 4700, 10380);
        se_play_3d(2, 26, 6, 0, 0, 4700, 10380);
    }
    evt_finish();
}
