event on_enter
{
    evt_fork(0, on_enter_sub1, 0);
    evt_fork(1, on_enter_sub2, 0);
    evt_fork(2, on_enter_sub3, 0);
    evt_fork(3, on_enter_sub4, 0);
    evt_finish();
}

event on_aot_02
{
    se_play_3d(2, 20, 0, 0, 0, 1250, 26900);
    message(128, 255); // "It's locked. There's no key hole."
    evt_finish();
}

#if CHRIS
event event_06
#else
event from_main
#endif
{
    run
    {
        bgm_stop_all(0);
        movie_on(7);
    }
    evt_next();
    evt_nop();
    run
    {
        bgm_restore(0);
    }
    evt_finish();
}
