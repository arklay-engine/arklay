#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_400 0x00
#define AOT_01_TYPEWRITER 0x01
#define AOT_02_ITEMBOX 0x02
#define AOT_03_ITEM_AMMO_GRENADE_EXPLOSIVE_0 0x03           // Jill: Explosive rounds.
#define AOT_03_ITEM_AMMO_HANDGUN_0 0x03                     // Chris: Handgun bullets.
#define AOT_04_ITEM_HEAL_FIRST_AID_SPRAY_1 0x04
#define AOT_05_MESSAGE_NOTHING 0x05                         // "Nothing special."
#define IMDL_00_AMMO_GRENADE_EXPLOSIVE 0x00                 // Jill: Explosive rounds model.
#define IMDL_00_AMMO_HANDGUN 0x00                           // Chris: Handgun bullets model.
#define IMDL_01_HEAL_FIRST_AID_SPRAY 0x01
#define OBJ_00 0x00

proc init
{
    door_aot_set(AOT_00_DOOR_400, 7400, 9200, 2400, 2300, 0, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 4, 0, ROOM_400_ENTER_PASSAGE, 11100, 0, 11700, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_TYPEWRITER, 3800, 2000, 1100, 1650, SCE_TYPEWRITER, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
    if (cmpb(B_CHARACTER_MODEL, CMP_NE, 3))
    {
        aot_set(AOT_02_ITEMBOX, 8600, 4500, 2000, 3150, SCE_ITEMBOX, SAT_MANUAL | SAT_PLAYER, 3, 0, 0, 0, 0, 0);
    }
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        item_aot_set(AOT_03_ITEM_AMMO_GRENADE_EXPLOSIVE_0, 1800, 6800, 1000, 1800, IT_10_AMMO_GRENADE_EXPLOSIVE, 6, IMDL_00_AMMO_GRENADE_EXPLOSIVE, SCA_NONE, 2700, -270, 7440, -300, F_ITEM_403_AMMO_GRENADE_EXPLOSIVE_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        item_aot_set(AOT_03_ITEM_AMMO_HANDGUN_0, 1800, 6800, 1000, 1800, IT_0B_AMMO_HANDGUN, 15, IMDL_00_AMMO_HANDGUN, SCA_NONE, 2700, -300, 7400, -1300, F_ITEM_403_AMMO_HANDGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
    }
    item_aot_set(AOT_04_ITEM_HEAL_FIRST_AID_SPRAY_1, 1800, 4800, 1000, 1800, IT_41_HEAL_FIRST_AID_SPRAY, 1, IMDL_01_HEAL_FIRST_AID_SPRAY, SCA_NONE, 2470, -3230, 6000, -400, F_ITEM_403_HEAL_FIRST_AID_SPRAY_1, SAT_MANUAL | SAT_PLAYER, 0);
    aot_set(AOT_05_MESSAGE_NOTHING, 6700, 1600, 3850, 1900, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    obj(OBJ_00, OF_10 | OF_ACTIVE, SCA_NONE, 10600, -1440, 6000, 2048, 0, 0, 0, 0, 0, 0, 0, 0);
}
