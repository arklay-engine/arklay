  <strings>
    <language lang="en-US">
      <string key="name">FOUNTAIN</string>
      <string key="save_name">Courtyard Room B1</string>
      <string key="0">{scroll 2}\nThe medal is in place.{scroll 2}</string>
      <string key="1">{scroll 2}A picture of an eagle is\ncarved in a round hollow.{scroll 2}</string>
      <string key="2">{scroll 2}A picture of a wolf is\ncarved in a round hollow.{scroll 2}</string>
      <string key="3">{scroll 2}It's welded and does not\nopen.{scroll 2}</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">中庭 {s}部屋/{s}B{s}1{s}</string>
      <string key="0">{scroll 2}\n   メダルがはめこまれている{scroll 2}</string>
      <string key="1">{scroll 2}  丸いくぼみがあり、中に\n  オオワシの形が刻まれている{scroll 2}</string>
      <string key="2">{scroll 2}  丸いくぼみがあり、中に\n  オオカミの形が刻まれている{scroll 2}</string>
      <string key="3">{scroll 2}\n   溶接されていて開かない{scroll 2}</string>
      <string key="4">{scroll 2}\n わしのメダルをはめた{scroll 2}{timed 60}</string>
      <string key="5">{scroll 2}\n おおかみのメダルをはめた{scroll 2}{timed 60}</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Salle de la cour SS1</string>
      <string key="0">{scroll 2}\nIl y a une médaille.{scroll 2}</string>
      <string key="1">{scroll 2}Un aigle est gravé dans\nla cavité ronde.{scroll 2}</string>
      <string key="2">{scroll 2}Un loup est gravé dans\nla cavité ronde.{scroll 2}</string>
      <string key="3">{scroll 2}C'est soudé et ne peut\nêtre ouvert.{scroll 2}</string>
    </language>
    <language lang="de-DE">
      <string key="0">{scroll 2}\nDie Medaille ist am Platz.{scroll 2}</string>
      <string key="1">{scroll 2}In den runden Hohlraum ist das\nBild eines Adlersgraviert.{scroll 2}</string>
      <string key="2">{scroll 2}In den runden Hohlraum ist das\nBild eines Wolfs graviert.{scroll 2}</string>
      <string key="3">{scroll 2}Sie ist zugeschweißt\nund lässt sich nicht öffnen.{scroll 2}</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Cortile S1</string>
      <string key="0">{scroll 2}Il medaglione è al \nsuo posto.{scroll 2}</string>
      <string key="1">{scroll 2}L'immagine di un'aquila è \nincisa in una cavità rotonda.{scroll 2}</string>
      <string key="2">{scroll 2}L'immagine di un lupo è \nincisa in una cavità rotonda.{scroll 2}</string>
      <string key="3">{scroll 2}È saldata e \nnon si apre.{scroll 2}</string>
    </language>
    <language lang="es-ES">
      <string key="0">{scroll 2}\nLa medalla está en su sitio...{scroll 2}</string>
      <string key="1">{scroll 2}En un hueco redondo hay\nuna imagen de un águila...{scroll 2}</string>
      <string key="2">{scroll 2}En un hueco redondo hay\nuna imagen de un lobo...{scroll 2}</string>
      <string key="3">{scroll 2}Está soldada, no\nse abre...{scroll 2}</string>
      <string key="4">{scroll 2}\n_Has insertado la MEDALLA ÁGUILA.{scroll 2}{timed 60}</string>
      <string key="5">{scroll 2}\n_Has insertado la MEDALLA LOBO.{scroll 2}{timed 60}</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната внутр. двора Б1</string>
      <string key="0">{scroll 2}\nМедаль на месте.{scroll 2}</string>
      <string key="1">{scroll 2}В круглом углублении\nизображён орёл.{scroll 2}</string>
      <string key="2">{scroll 2}В круглом углублении\nизображён волк.{scroll 2}</string>
      <string key="3">{scroll 2}Дверь заварена,\nоткрыть не получится.{scroll 2}</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Maanalainen varasto 0 krs</string>
      <string key="0">{scroll 2}Mitali on paikallaan...{scroll 2}</string>
      <string key="1">{scroll 2}Pyöreässä kolossa on kaiverrus\nkotkasta...{scroll 2}</string>
      <string key="2">{scroll 2}Pyöreässä kolossa on kaiverrus\nsudesta......{scroll 2}</string>
      <string key="3">{scroll 2}Se on hitsattu kiinni...{scroll 2}</string>
      <string key="4">{scroll 2}Asetit kotka-mitalin.{scroll 2}{timed 60}</string>
      <string key="5">{scroll 2}Asetit susi-mitalin.{scroll 2}{timed 60}</string>
    </language>
  </strings>
