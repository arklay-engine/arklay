#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_109 0x00
#define AOT_01_DOOR_116 0x01
#define CAM_00_CEILING_OVERHEAD 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03_CEILING_FROM_FLOOR 0x03
#define CAM_04_BARRY_OUTSIDE 0x04
#define ENEMY_00_BARRY_OUTSIDE 0x00                         // Barry in the passage: he talks, bangs and kicks the door in.
#define ENEMY_01_BARRY_AT_DOOR 0x01                         // Guess: the Barry who shows in the broken doorway.
#define FX_08 0x08
#define F_ROOM_ANIM_DONE_UNUSED 0x3F                        // An animation-finished pulse no script waits on.
#define F_ROOM_J_STEP_BACK_DONE 0x04                        // Jill stepped back from the door for Barry's kick.
#define F_ROOM_J_WALK_OUT_DONE 0x03                         // Jill's walk out of the trap finished; nothing waits on it.
#define MSG_VO_105_00 0x00
#define MSG_VO_105_01 0x01
#define MSG_VO_105_02 0x02
#define MSG_VO_105_03 0x03
#define MSG_VO_105_04 0x04
#define OBJ_00_CEILING 0x00
#define OBJ_01_DOOR_109 0x01                                // The door Barry kicks open.
#define OBJ_02 0x02
#define SE_17_KICKDOOR 0x17
#define SE_18_LOCK_MIX 0x18
#define SE_19_CEILPRES 0x19
#define SE_1A 0x1A
#define SE_1B 0x1B
#define SE_1C 0x1C
#define SE_1D_TAO_WALL 0x1D
#define VO_105_00 0x30
#define VO_105_01 0x31
#define VO_105_02 0x32
#define VO_105_03 0x33
#define VO_105_04 0x34

proc init
{
    door_aot_set(AOT_00_DOOR_109, 900, 4000, 1350, 2500, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, DOOR_LOCKED | F_LOCK_109_115, ROOM_109_TRAP_PASSAGE, 6700, 0, 9800, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_116, 5300, 1400, 2400, 1000, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, DOOR_LOCKED | F_LOCK_115_116, ROOM_116_LIVING_ROOM, 4850, 0, 10250, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    obj(OBJ_00_CEILING, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 4860, -10280, 4860, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_01_DOOR_109, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 1760, 0, 3960, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    obj(OBJ_02, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 7590, 0, 8680, 0, 0, 0, 0, 0, 0, 0, 0, 0);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        set(FG_LOCK, F_LOCK_115_116, TRUE);
        if (ck(FG_ITEM, F_ITEM_116_WEAPON_SHOTGUN_0, FALSE) && ck(FG_ITEM, F_ITEM_116_KEY_BROKEN_SHOTGUN_1, FALSE) && ck(FG_COMMON, F_COMMON_CEILING_TRAP_SPRUNG, FALSE))
        {
            set(FG_LOCK, F_LOCK_109_115, FALSE);
            set(FG_LOCK, F_LOCK_115_TRAP, FALSE);
            cut_auto(CUT_LOCKED);
            setb(B_CAMERA, CAM_03_CEILING_FROM_FLOOR, 0);
            evt_exec(0, TASK_09, ceiling_trap_no_rescue);
            dir_set(0, 0, 3072, 0, 5200, 0, 2500);
        }
        else
        {
            set(FG_LOCK, F_LOCK_109_115, TRUE);
            set(FG_LOCK, F_LOCK_115_TRAP, TRUE);
        }
    }
    else
    {
        enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 6900, 0, 9600, ENEMY_00_BARRY_OUTSIDE, ANIM_00, 0, EVAR_00);
        enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 450, 0, 5000, ENEMY_01_BARRY_AT_DOOR, ANIM_00, 0, EVAR_00);
        if (ck(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, TRUE))
        {
            set(FG_COMMON, F_COMMON_J_BARRY_SANDWICH_TALK_DONE, TRUE);
        }
        if (ck(FG_COMMON, F_COMMON_J_BARRY_MET_ON_TERRACE, TRUE))
        {
            set(FG_COMMON, F_COMMON_J_BARRY_SANDWICH_TALK_DONE, TRUE);
        }
        if (ck(FG_ITEM, F_ITEM_116_WEAPON_SHOTGUN_0, FALSE) && ck(FG_ITEM, F_ITEM_116_KEY_BROKEN_SHOTGUN_1, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, FALSE) && ck(FG_COMMON, F_COMMON_J_BARRY_MET_ON_TERRACE, FALSE))
            {
                set(FG_LOCK, F_LOCK_109_115, FALSE);
                set(FG_LOCK, F_LOCK_115_116, FALSE);
                cut_auto(CUT_LOCKED);
                setb(B_CAMERA, CAM_03_CEILING_FROM_FLOOR, 0);
                dir_set(0, 0, 3072, 0, 5200, -400, 2500);
                evt_exec(0, TASK_09, jill_trap_start);
            }
            else if (ck(FG_COMMON, F_COMMON_J_CEILING_TRAP_SPRUNG, FALSE))
            {
                set(FG_LOCK, F_LOCK_109_115, FALSE);
                set(FG_LOCK, F_LOCK_115_116, FALSE);
                cut_auto(CUT_LOCKED);
                setb(B_CAMERA, CAM_03_CEILING_FROM_FLOOR, 0);
                dir_set(0, 0, 3072, 0, 5200, -400, 2500);
                set(FG_LOCK, F_LOCK_115_116, TRUE);
                evt_exec(0, TASK_09, ceiling_trap_no_rescue);
            }
            else
            {
                set(FG_LOCK, F_LOCK_109_115, TRUE);
                set(FG_LOCK, F_LOCK_115_116, TRUE);
            }
        }
        else
        {
            set(FG_LOCK, F_LOCK_109_115, TRUE);
            set(FG_LOCK, F_LOCK_115_116, TRUE);
        }
    }
}

event barry_answers_through_door
{
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_22, F_ROOM_ANIM_DONE_UNUSED, 0);
    act_reset();
    evt_nop();
    sleep(10);
    voice_play(VOICE_PLAY, VO_105_00);
    message(MSG_VO_105_00, 0);
    wait_message();
    dir_set(0, 0, 1648, 0, 12700, 0, 15500);
    cutnext(CAM_04_BARRY_OUTSIDE);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY_OUTSIDE);
    evt_actor_begin();
    act_anim_flags(ANIM_28, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(30);
    act_reset();
    evt_nop();
    voice_play(VOICE_PLAY, VO_105_01);
    message(MSG_VO_105_01, 0);
    evt_fork(TASK_09, barry_bangs_on_door, 0);
    evt_work_set(WK_ENEMY, ENEMY_00_BARRY_OUTSIDE);
    evt_actor_begin();
    act_anim_flags(ANIM_26, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_20, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_26, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_20, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(10);
    act_anim_flags(ANIM_22, F_ROOM_ANIM_DONE_UNUSED, AFL_02 | AFL_01);
    sleep(30);
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        dir_set(0, 0, 1648, 0, 2700, 0, 5500);
        cutnext(CAM_01);
        voice_play(VOICE_PLAY, VO_105_02);
        message(MSG_VO_105_02, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_20, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(14);
    act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(8);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(20);
    act_anim_flags(ANIM_24, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(15);
    act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(10);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE_UNUSED, 0);
    sleep(10);
    act_anim_flags(ANIM_20, F_ROOM_ANIM_DONE_UNUSED, 0);
    act_reset();
    evt_nop();
    wait_message();
    evt_chain(barry_kicks_door_in);
}

event barry_kicks_door_in
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        voice_play(VOICE_PLAY, VO_105_03);
        message(MSG_VO_105_03, 0);
    }
    sleep(50);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_04, 4900, 6900, F_ROOM_J_STEP_BACK_DONE);
    act_reset();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_J_STEP_BACK_DONE, FALSE));
    evt_fork(TASK_09, barry_at_door_anim, 0);
    sleep(20);
    se_play_3d(SND_BANK_ROOM, SE_17_KICKDOOR, 0, SND_AT_ENEMY, ENEMY_00_BARRY_OUTSIDE, 0, 0);
    evt_work_set(WK_OBJ, OBJ_01_DOOR_109);
    evt_tween_begin_alt();
    tw_set_rot(0, 80, 0);
    for (18)
    {
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_set_rot(0, 78, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 76, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 74, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 72, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 70, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 68, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 66, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, 64, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -62, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -60, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -58, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -56, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -54, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -52, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -50, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -48, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -46, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -44, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -42, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -40, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -38, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -36, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -34, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -32, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -30, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -28, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -26, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -24, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -22, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -20, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -18, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -16, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -14, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -12, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -10, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -8, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -6, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -4, 0);
    tw_rot_add();
    evt_next();
    tw_set_rot(0, -2, 0);
    tw_rot_add();
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        door_aot_set(AOT_00_DOOR_109, 900, 4000, 1350, 2500, 4, DOOR_SND_02_DR_BRK, DOOR_00_DOOR00, 0, DOOR_LOCKED | F_LOCK_109_115, ROOM_109_TRAP_PASSAGE, 6700, 0, 9800, 2048, UNLOCKED, SAT_UNDER | SAT_PLAYER);
        voice_play(VOICE_PLAY, VO_105_04);
        message(MSG_VO_105_04, 0);
    }
    wait_message();
    set(FG_LOCK, F_LOCK_109_115, TRUE);
    set(FG_COMMON, F_COMMON_CEILING_TRAP_SPRUNG, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_03, 2000, 5400, F_ROOM_J_WALK_OUT_DONE);
    act_reset();
    evt_finish();
}

event jill_trap_start
{
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -8690, 4860);
    tw_end();
    evt_nop();
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    evt_nop();
    evt_nop();
}

event jill_trap_ceiling_starts
{
    set(FG_LOCK, F_LOCK_115_TRAP, FALSE);
    sleep(15);
    se_play_3d(SND_BANK_ROOM, SE_18_LOCK_MIX, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(5);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 6600, 0, 2300, 100, 100);
    act_reset();
    evt_nop();
    snd_pan_vol_set(BGM_MAIN, 30, 30);
    bgm_play(BGM_SUB_1);
    sleep(45);
    snd_pan_vol_set(BGM_MAIN, 110, 110);
    bgm_play(BGM_MAIN);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_exec(0, TASK_09, ceiling_starts_lowering);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 4900, -8000, 4900, 100, 100);
    sleep(40);
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    sleep(10);
    evt_nop();
    evt_nop();
}

event jill_trap_ceiling_lowers
{
    run
    {
        dir_set(0, 0, 3072, 0, 5200, 0, 2500);
        cutnext(CAM_02);
        cut_auto(CUT_FREE);
    }
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -10500, 4860);
    tw_end();
    evt_nop();
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        evt_exec(0, TASK_09, jill_pushes_ceiling);
    }
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_set_pos(0, 7, 0);
    for (450)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_fork(TASK_09, barry_answers_through_door, 0);
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_set_pos(0, 5, 0);
    for (10000)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event ceiling_trap_no_rescue
{
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -8690, 4860);
    tw_end();
    evt_nop();
    sleep(1);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(10);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        snd_pan_vol_set(BGM_MAIN, 30, 30);
        bgm_play(BGM_SUB_1);
        sleep(45);
        snd_pan_vol_set(BGM_MAIN, 110, 110);
        bgm_play(BGM_MAIN);
    }
    sleep(1);
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            set(FG_COMMON, F_COMMON_CEILING_TRAP_SPRUNG, TRUE);
        }
        else
        {
            set(FG_COMMON, F_COMMON_J_CEILING_TRAP_SPRUNG, TRUE);
        }
        set(FG_LOCK, F_LOCK_115_TRAP, FALSE);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            evt_exec(0, TASK_09, ceiling_starts_lowering);
        }
        else
        {
            evt_exec(0, TASK_09, jill_ceiling_starts_lowering);
        }
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    sleep(60);
    act_motion_path(MOTION_13, 4900, -8000, 4900, 100, 100);
    sleep(40);
    act_motion(MOTION_10);
    sleep(40);
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
        {
            dir_set(0, 0, 3072, 0, 5200, 0, 2500);
        }
        cutnext(CAM_02);
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    }
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -8600, 4860);
    tw_end();
    evt_nop();
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_set_pos(0, 10, 0);
    for (500)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_00_CEILING_OVERHEAD);
    }
    evt_disable(TASK_06);
    evt_disable(TASK_07);
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_abs_pos(0, 4860, -6000, 4860);
    for (80)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        bgm_stop(BGM_MAIN);
        bgm_stop(BGM_SUB_1);
        se_play_3d(SND_BANK_ROOM, SE_19_CEILPRES, 0, SND_AT_PLAYER, 0, 0, 0);
        se_play_3d(SND_BANK_ROOM, SE_1A, 0, SND_AT_PLAYER, 0, 0, 0);
        se_play_3d(SND_BANK_ROOM, SE_1B, 0, SND_AT_PLAYER, 0, 0, 0);
        se_play_3d(SND_BANK_ROOM, SE_1C, 0, SND_AT_PLAYER, 0, 0, 0);
    }
    sleep(1);
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_sel(TW_HEALTH, -1);
    tw_set_sel(TW_POS_X, 4860);
    tw_set_sel(TW_POS_Z, 4860);
    tw_end();
    evt_nop();
    set(FG_STATUS, F_STATUS_PLAYER_DEAD, TRUE);
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    for (30)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 8, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 6, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    sleep(1);
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_end();
    evt_finish();
}

event jill_ceiling_lowers_unused
{
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_set_pos(0, 5, 0);
    for (450)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

event ceiling_starts_lowering
{
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_fork(TASK_07, ceiling_dust_corners, 0);
        evt_fork(TASK_06, ceiling_dust_wait, 0);
    }
    else
    {
        evt_fork(TASK_06, ceiling_dust_corners, 0);
        evt_fork(TASK_07, ceiling_dust_wait, 0);
    }
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        tw_set_pos(0, 7, 0);
    }
    else
    {
        tw_set_pos(0, 10, 0);
    }
    for (140)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, TRUE))
    {
        evt_nop();
    }
    evt_finish();
}

event jill_pushes_ceiling
{
    sleep(100);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_13, 4900, -8000, 4900, 100, 100);
    sleep(20);
    act_motion(MOTION_10);
    sleep(10);
    act_end();
    evt_nop();
    evt_chain(jill_pushes_ceiling);
}

event barry_at_door_anim
{
    evt_work_set(WK_ENEMY, ENEMY_01_BARRY_AT_DOOR);
    evt_actor_begin();
    sleep(1);
    act_anim_flags(ANIM_32, F_ROOM_ANIM_DONE_UNUSED, AFL_01);
    sleep(40);
    act_motion_path(MOTION_13, 4900, -8000, 4900, 100, 100);
    sleep(20);
    act_motion(MOTION_10);
    act_anim_flags(ANIM_30, F_ROOM_ANIM_DONE_UNUSED, 0);
    act_reset();
    evt_nop();
    evt_finish();
}

event ceiling_dust_corners
{
    run
    {
        effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -3060, 20, -3010, 0);
        effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -3060, 20, 3140, 0);
        effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, 2940, 20, 3140, 0);
        effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, 2940, 20, -3010, 0);
    }
    sleep(20);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_chain(ceiling_dust_corners);
    }
    else
    {
        evt_chain(ceiling_dust_corners);
    }
    evt_nop();
    evt_nop();
}

event ceiling_dust_wait
{
    sleep(30);
}

event ceiling_dust_random
{
    run
    {
        if (cmpw(0, W_RANDOM, CMP_GT, 10000))
        {
            if (cmpw(0, W_RANDOM, CMP_LT, 20000))
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -560, 20, -3010, 0);
            }
            else
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, 690, 20, -3010, 0);
            }
        }
        else
        {
            effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -1810, 20, -3010, 0);
        }
    }
    sleep(1);
    run
    {
        if (cmpw(0, W_RANDOM, CMP_GT, 10000))
        {
            if (cmpw(0, W_RANDOM, CMP_LT, 20000))
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -560, 20, 3140, 0);
            }
            else
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, 690, 20, 3140, 0);
            }
        }
        else
        {
            effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -1810, 20, 3140, 0);
        }
    }
    sleep(1);
    run
    {
        if (cmpw(0, W_RANDOM, CMP_GT, 10000))
        {
            if (cmpw(0, W_RANDOM, CMP_LT, 20000))
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -3060, 20, -1550, 0);
            }
            else
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -3060, 20, 0, 0);
            }
        }
        else
        {
            effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, -3060, 20, 1550, 0);
        }
    }
    sleep(1);
    run
    {
        if (cmpw(0, W_RANDOM, CMP_GT, 10000))
        {
            if (cmpw(0, W_RANDOM, CMP_LT, 20000))
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, 2920, 20, -1550, 0);
            }
            else
            {
                effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, 2920, 20, 0, 0);
            }
        }
        else
        {
            effect(FX_08, FX_ROW_14, FX_AT_OBJ | OBJ_00_CEILING, 2920, 20, 1550, 0);
        }
    }
    sleep(10);
    if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        evt_chain(ceiling_dust_wait);
    }
    else
    {
        evt_chain(ceiling_dust_random);
    }
    evt_nop();
    evt_nop();
}

event barry_bangs_on_door
{
    sleep(10);
    se_play_3d(SND_BANK_ROOM, SE_1D_TAO_WALL, 0, SND_AT_ENEMY, ENEMY_00_BARRY_OUTSIDE, 0, 0);
    sleep(30);
    se_play_3d(SND_BANK_ROOM, SE_1D_TAO_WALL, 0, SND_AT_ENEMY, ENEMY_00_BARRY_OUTSIDE, 0, 0);
    sleep(30);
    se_play_3d(SND_BANK_ROOM, SE_1D_TAO_WALL, 0, SND_AT_ENEMY, ENEMY_00_BARRY_OUTSIDE, 0, 0);
    evt_finish();
}

event jill_ceiling_starts_lowering
{
    snd_pan_vol_set(BGM_MAIN, 30, 30);
    bgm_play(BGM_SUB_1);
    sleep(45);
    snd_pan_vol_set(BGM_MAIN, 110, 110);
    bgm_play(BGM_MAIN);
    evt_fork(TASK_06, ceiling_dust_corners, 0);
    evt_fork(TASK_07, ceiling_dust_wait, 0);
    evt_work_set(WK_OBJ, OBJ_00_CEILING);
    evt_tween_begin_alt();
    tw_set_pos(0, 7, 0);
    for (140)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_finish();
}
