event event_0A
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 10, 32 | 4, 0 | 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 36, 1));
    evt_chain(10);
    evt_finish();
}

event event_0B
{
    set(FG_6, 23, 1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    sleep(10);
    sleep(15);
    message(173, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, 23, 0);
        aot_reset(6, SCE_ITEM, 129, 0, 2, 0);
        aot_on(6, SCE_ITEM, 0);
    }
    evt_next();
    evt_nop();
    run
    {
        if (ck(FG_ROOM, 3, 0))
        {
            aot_reset(6, SCE_NONE, 0, 0, 0, 0);
        }
        else
        {
            aot_reset(6, SCE_EVENT, 129, 0, event_0B, 0);
        }
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_0C
{
    sleep(200);
    evt_finish();
}

event event_0D
{
    run
    {
        bgm_stop_all(0);
        movie_on(9);
    }
    evt_next();
    evt_nop();
    run
    {
        bgm_restore(0);
    }
    evt_finish();
}

event event_0E
{
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
    }
    evt_next();
    evt_nop();
    run
    {
        set(FG_6, 23, 0);
        aot_on(6, SCE_ITEM, 0);
    }
    evt_next();
    evt_nop();
    run
    {
        set(FG_6, 23, 1);
        aot_reset(6, SCE_NONE, 0, 0, 0, 0);
    }
    sleep(50);
    run
    {
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
    }
    evt_finish();
}
