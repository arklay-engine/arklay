#version 1

proc init
{
    set(FG_STATUS, 28, 0);
    door_aot_set(0, 31100, 10000, 2000, 3000, 6, 0, 4, 7, 0, RDT_007, 2700, 0, 6600, 0, UNLOCKED, 129);
    door_aot_set(1, 31100, 18600, 2000, 1200, 2, 0, 3, 1, 197, RDT_011, 2800, 0, 4600, 0, ITEM_ARMOR_KEY, 129);
    door_aot_set(2, 1000, 15000, 1950, 3800, 6, 0, 3, 7, 0, RDT_005, 30900, 0, 8300, 2048, UNLOCKED, 129);
    if (cmpb(9, 0, 3))
    {
        door_aot_set(3, 14600, 800, 5200, 2200, 2, 0, 3, 1, 197, RDT_011, 2800, 0, 4600, 0, ITEM_ARMOR_KEY, 129);
    }
    else
    {
        aot_set(3, 14600, 800, 5200, 2200, SCE_SAVE, 129, 4, 0, 0, 0, 1, 0);
    }
    door_aot_set(4, 15600, 15900, 2900, 2600, 0, 4, 22, 96, 0, RDT_203, 17100, 0, 25300, 3072, UNLOCKED, 129);
    if (ck(FG_COMMON, 8, 1))
    {
        item_aot_set(5, 13000, 16000, 2000, 2000, ITEM_INK_RIBBON, 3, 3, 255, 0, 0, 32, 78, 0, 0, 0, 0, 52, 129, 0, 0);
        if (ck(FG_ITEM, 52, 0))
        {
            if (cmpb(9, 0, 3))
            {
                aot_reset(5, SCE_MESSAGE, 129, 174, 255, 0);
            }
        }
    }
    else
    {
        aot_set(5, 13000, 16000, 2000, 2000, SCE_TYPEWRITER, 129, 0, 0, 0, 0, 0, 0);
    }
    if (ck(FG_COMMON, 3, 0))
    {
        room_bgm_state_set(0, 6, 8);
    }
    if (ck(FG_ITEM, 26, 0) && ck(FG_COMMON, 2, 0))
    {
        item_aot_set(6, 24100, 10100, 1800, 1800, ITEM_BERETTA, 15, 2, 255, 168, 97, 0, 0, 248, 42, 0, 0, 26, 129, 0, 0);
        if (cmpb(9, 0, 3))
        {
            aot_reset(6, SCE_MESSAGE, 129, 174, 255, 0);
        }
        else
        {
            aot_reset(6, SCE_EVENT, 129, 0, event_0B, 0);
        }
    }
    if (ck(FG_COMMON, 3, 1) && ck(FG_COMMON, 2, 0))
    {
        set(FG_COMMON, 3, 0);
        evt_exec(0, 0, event_09);
    }
    if (ck(FG_COMMON, 0, 0) && ck(FG_COMMON, 2, 1))
    {
        enemy(ENEMY_WESKER_STARS_, 0, 255, 1, 2, 0, 0, 1920, 0, 0, 16000, 0, 9000, 0, 0, 0, 0);
        enemy(ENEMY_JILL_STARS_, 2, 255, 1, 2, 0, 0, 3328, 0, 0, 20000, 0, 11000, 1, 0, 0, 0);
        cut_auto(1);
        setb(2, 6, 0);
        set(FG_COMMON, 1, 0);
        evt_exec(0, 0, event_08);
    }
    if (ck(FG_COMMON, 0, 1))
    {
        enemy(ENEMY_WESKER_STARS_, 0, 255, 1, 2, 0, 0, 2304, 0, 0, 18700, 0, 3000, 0, 0, 0, 0);
        enemy(ENEMY_JILL_STARS_, 2, 255, 1, 2, 0, 0, 1300, 0, 0, 20800, 0, 8500, 1, 18, 0, 0);
        dir_set(0, 0, 0, 0, 14600, 0, 5000);
        set(FG_COMMON, 0, 0);
        evt_exec(0, 0, event_00);
        set(FG_STATUS, 29, 0);
        set(FG_COMMON, 167, 0);
    }
    if (ck(FG_COMMON, 160, 0))
    {
        if (ck(FG_COMMON, 161, 1))
        {
            set(FG_COMMON, 161, 0);
            room_bgm_state_set(0, 4, 10);
            room_bgm_state_set(0, 15, 65);
        }
    }
}

proc main
{
    if (cmpb(9, 5, 3))
    {
        if (ck(FG_ROOM, 1, 1))
        {
            if (cmpb(16, 0, 4))
            {
                if (ck(FG_COMMON, 4, 1))
                {
                    set(FG_COMMON, 4, 0);
                    set(FG_ROOM, 1, 0);
                    evt_exec(0, 7, event_0D);
                    set(FG_ROOM, 1, 1);
                }
                else
                {
                    set(FG_ROOM, 2, 0);
                }
            }
            if (ck(FG_ROOM, 2, 0))
            {
                set(FG_ROOM, 2, 1);
                set(FG_ROOM, 1, 0);
                message(161, 255);
                set(FG_ROOM, 1, 1);
            }
        }
    }
    if (testpickup(ITEM_BERETTA))
    {
        set(FG_ROOM, 3, 0);
    }
    if (ck(FG_COMMON, 8, 1) && ck(FG_ITEM, 52, 1))
    {
        set(FG_COMMON, 8, 0);
        aot_reset(5, SCE_TYPEWRITER, 129, 0, 0, 0);
    }
    return;
    if (testpickup(ITEM_54))
    {
        evt_exec(0, 9, event_0C);
    }
    if (ck(FG_ROOM, 0, 0))
    {
        evt_exec(0, 9, event_0E);
        set(FG_ROOM, 0, 1);
    }
}

