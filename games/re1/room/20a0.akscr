event event_00
{
    message(131, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 1, event_01);
        }
    }
    evt_finish();
}

event event_01
{
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 3200, 1800);
        set(FG_6, 23, 1);
        cutnext(5);
        set(FG_ROOM, 10, 0);
    }
    sleep(10);
    evt_fork(2, event_04, 0);
    set(FG_STATUS, 15, 0);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(113, 400, 0, 1, 100, 64);
    sleep(16);
    act_motion_path(17, 6565, 62936, 5035, 180, 64);
    sleep(8);
    act_motion(16);
    act_anim_flags(32 | 13, 32 | 4, 0 | 0);
    act_flag_op(0, 2, 0);
    act_param_set(0, 252);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 36, 1));
    act_motion_path(17, 6565, 62936, 5035, 240, 64);
    act_reset();
    evt_nop();
    sleep(10);
    cutnext(4);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 2, 1));
    cutnext(5);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_abs_pos(0, 0, 20000, 0);
    tw_end();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_reset();
    evt_nop();
    run
    {
        aot_reset(2, SCE_NONE, 0, 0, 0, 0);
        aot_reset(6, SCE_NONE, 0, 0, 0, 0);
        set(FG_SCENARIO, 18, 0);
        set(FG_STATUS, 15, 1);
        set(FG_6, 23, 0);
        cut_auto(0);
        sys_multi(7);
    }
    evt_finish();
}

event event_02
{
    run
    {
        aot_reset(1, SCE_MESSAGE, 129, 133, 255, 0);
        aot_reset(8, SCE_DOCUMENT, 129, 0, 0, 0);
        aot_on(8, SCE_DOCUMENT, 0);
        set(FG_COMMON, 7, 0);
    }
    evt_finish();
}

event event_03
{
    objtbl_b_set(0, 0, 17);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 16, 32 | 4, 0 | 0);
    sleep(10);
    act_anim_flags(32 | 17, 32 | 4, 0 | 0);
    act_flag_op(0, 16, 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck_bits(0, 1, 0));
    set(FG_6, 23, 1);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 4, 0 | 0);
    sleep(10);
    act_idle();
    act_reset();
    run
    {
        objtbl_b_set(0, 0, 1);
        set(FG_ROOM, 1, 1);
        message(129, 255);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_6, 25, 0);
    set(FG_6, 23, 0);
    evt_finish();
}

event event_04
{
    se_play_3d(2, 25, 0, 0, 0, 7470, 5980);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 10, 0);
    for (120)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    set(FG_ROOM, 2, 0);
    evt_work_set(WK_OBJ, 1);
    evt_tween_begin_alt();
    tw_set_pos(0, 10, 0);
    for (5)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_finish();
}
