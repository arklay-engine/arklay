proc init
{
    door_aot_set(AOT_00_DOOR, 1600, 22700, 3800, 6200, 0, DOOR_SND_09_ST_MTL, DOOR_19_KAI04, 96, 0, ROOM_503_STAIRS, 19100, 0, 16600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
