    if (ck(FG_SCENARIO, FLAG_SCENARIO_37, TRUE))
    {
        enemy(ENEMY_09_CHIMERA, 3, 164, 1, 2, 0, 0, 0, 0, 0, 13100, 0, 3070, 0, 0, 0, 1);
        enemy(ENEMY_09_CHIMERA, 3, 165, 1, 2, 0, 0, 2072, 0, 0, 10250, 0, 18760, 1, 0, 0, 1);
    }
}

proc main
{
    if (ck(FG_SCENARIO, FLAG_SCENARIO_63, FALSE))
    {
        if (ck(FG_LOCK, FLAG_LOCK_1D, TRUE))
        {
            set(FG_SCENARIO, FLAG_SCENARIO_63, TRUE);
            effect_kill_a(0);
            effect(10, 24, 0, 228, 87, 40, 241, 252, 8, 0, 0);
        }
    }
}

#if CHRIS
event on_enter
#else
event event_00
#endif
{
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
    }
    set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    run
    {
        snd_pan_vol_set(1, 112, 112);
        snd_pan_vol_set(2, 112, 112);
        bgm_play(0);
        bgm_play(1);
        bgm_play(2);
        message(1, 0);
    }
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 7, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 400, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 65136, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 400, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 65136, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    cut_auto(0);
    set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    run
    {
        room_bgm_state_set(4, 5, 57);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_6, FLAG_6_1D, TRUE);
    }
    evt_finish();
}

event on_aot_06
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    sleep(25);
    message(0, 65535); // "It's too dark to see anything..."
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 3);
    act_flag_op(1, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_6, FLAG_6_1D, TRUE);
    }
    evt_finish();
}
