proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_63, FALSE))
    {
        if (ck(FG_LOCK, F_LOCK_1D, TRUE))
        {
            set(FG_SCENARIO, F_SCENARIO_63, TRUE);
            effect_kill_a(0);
            effect(FX_0A, 24, 0, 228, 87, 40, 241, 252, 8, 0, 0);
        }
    }
}

#if CHRIS
event on_enter
#else
event event_00
#endif
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
    }
    set(FG_STATUS, F_STATUS_0F, TRUE);
    run
    {
        snd_pan_vol_set(BGM_SUB_1, 112, 112);
        snd_pan_vol_set(BGM_SUB_2, 112, 112);
        bgm_play(BGM_MAIN);
        bgm_play(BGM_SUB_1);
        bgm_play(BGM_SUB_2);
        message(1, 0);
    }
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 7, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 400, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 65136, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 400, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 65136, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    cut_auto(0);
    set(FG_STATUS, F_STATUS_0F, FALSE);
    run
    {
        room_bgm_state_set(4, ROOM_505_O_PASSAGE, BGM_SUB_2_ON | BGM_SUB_1_ON | BGM_MAIN_ON | 1);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_finish();
}

event on_aot_06
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    sleep(25);
    message(MSG_IT_IS_TOO_DARK_TO_SEE, RUN_8000 | RUN_4000 | RUN_2000 | RUN_1000 | RUN_0800 | RUN_0400 | RUN_DEMO | RUN_CONTROLS | RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It's too dark to see anything..."
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 3);
    act_flag_op(1, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_finish();
}
