#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_DOOR 0x04
#define AOT_05_ITEM 0x05
#define AOT_06_EVENT 0x06

proc init
{
    door_aot_set(AOT_00_DOOR, 1600, 22700, 3800, 6200, 0, 9, 25, 96, 0, ROOM_503_STAIRS, 19100, 0, 16600, 3072, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 20300, 21300, 2400, 2200, 10, 12, 13, 64, 0, ROOM_506_SMALL_LABORATORY, 15200, 0, 4300, 2712, UNLOCKED, 129);
    door_aot_set(AOT_02_DOOR, 15700, 4300, 2800, 1500, 9, 1, 13, 6, 173, ROOM_507_MORTUARY, 12100, 0, 2500, 3072, LOCKED, 129);
    door_aot_set(AOT_03_DOOR, 0, 16100, 2700, 3400, 9, 1, 12, 7, 0, ROOM_508_DOUBLE_LOCK, 19500, 0, 3500, 2048, UNLOCKED, 129);
    door_aot_set(AOT_04_DOOR, 22600, 2200, 2700, 2300, 7, 1, 12, 7, 157, ROOM_50C_FRONT_OF_ELEVATOR, 2500, 0, 17300, 0, ITEM_3C_KEY_LAB_POWER_ROOM, 129);
#if JILL
    item_aot_set(AOT_05_ITEM, 10520, 1390, 1000, 1000, ITEM_2F_TOOL_INK_RIBBON, 3, 0, 255, 12, 43, 0, 0, 98, 7, 0, 0, 201, 129, 1, 0);
#endif
    aot_set(AOT_06_EVENT, 10600, 1000, 1000, 1000, SCE_EVENT, 129, 9, 0, on_aot_06, 0, 0, 0);
    if (ck(FG_LOCK, FLAG_LOCK_1D, TRUE))
    {
        effect(10, 24, 0, 228, 87, 40, 241, 252, 8, 0, 0);
    }
    else
    {
        effect_tracked(10, 16, 0, 228, 87, 40, 241, 252, 8, 0, 0);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_37, FALSE))
    {
        enemy(ENEMY_01_ZOMBIE_NAKED, 4, 63, 1, 2, 0, 0, 15, 0, 0, 4174, 0, 12125, 0, 0, 0, 0);
        if (ck(FG_ENEMY, FLAG_ENEMY_3F, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 64, 1, 2, 0, 0, 2048, 0, 0, 12430, 0, 18600, 0, 0, 0, 0);
        }
        if (ck(FG_ENEMY, FLAG_ENEMY_40, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 65, 1, 2, 0, 0, 2048, 0, 0, 12430, 0, 18600, 0, 0, 0, 0);
        }
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_37, FALSE))
    {
        enemy(ENEMY_01_ZOMBIE_NAKED, 4, 66, 1, 2, 0, 0, 495, 0, 0, 11847, 0, 3599, 1, 0, 0, 0);
        if (ck(FG_ENEMY, FLAG_ENEMY_42, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 67, 1, 2, 0, 0, 512, 0, 0, 10316, 0, 6022, 1, 0, 0, 0);
        }
        if (ck(FG_ENEMY, FLAG_ENEMY_43, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 68, 1, 2, 0, 0, 512, 0, 0, 10316, 0, 6022, 1, 0, 0, 0);
        }
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_37, FALSE))
    {
        enemy(ENEMY_01_ZOMBIE_NAKED, 4, 69, 1, 2, 0, 0, 2871, 0, 0, 11775, 0, 1457, 2, 0, 0, 0);
        if (ck(FG_ENEMY, FLAG_ENEMY_45, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 70, 1, 2, 0, 0, 1536, 0, 0, 13096, 0, 4926, 2, 0, 0, 0);
        }
        if (ck(FG_ENEMY, FLAG_ENEMY_46, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 71, 1, 2, 0, 0, 1536, 0, 0, 13096, 0, 4926, 2, 0, 0, 0);
        }
    }
#if CHRIS
    if (ck(FG_SCENARIO, FLAG_SCENARIO_37, FALSE))
    {
        enemy(ENEMY_01_ZOMBIE_NAKED, 4, 72, 1, 2, 0, 0, 3103, 0, 0, 21765, 0, 10142, 3, 0, 0, 0);
        if (ck(FG_ENEMY, FLAG_ENEMY_48, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 73, 1, 2, 0, 0, 896, 0, 0, 21004, 0, 8192, 3, 0, 0, 0);
        }
        if (ck(FG_ENEMY, FLAG_ENEMY_49, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 74, 1, 2, 0, 0, 896, 0, 0, 21004, 0, 8192, 3, 0, 0, 0);
        }
    }
    if (ck(FG_COMMON, FLAG_COMMON_5C, FALSE) && ck(FG_SCENARIO, FLAG_SCENARIO_37, TRUE) && ck(FG_COMMON, FLAG_COMMON_C0, FALSE))
    {
        evt_exec(0, 9, on_enter);
        set(FG_COMMON, FLAG_COMMON_5C, TRUE);
        room_bgm_state_set(4, 0, 57);
        room_bgm_state_set(4, 1, 56);
        room_bgm_state_set(4, 2, 57);
        room_bgm_state_set(4, 3, 57);
        room_bgm_state_set(4, 4, 57);
        room_bgm_state_set(4, 5, 65);
        room_bgm_state_set(4, 6, 57);
        room_bgm_state_set(4, 7, 57);
        room_bgm_state_set(4, 8, 57);
        room_bgm_state_set(4, 9, 57);
        room_bgm_state_set(4, 10, 57);
        room_bgm_state_set(4, 11, 57);
        room_bgm_state_set(4, 12, 57);
        room_bgm_state_set(4, 13, 56);
        room_bgm_state_set(4, 14, 57);
        room_bgm_state_set(4, 15, 57);
        room_bgm_state_set(4, 16, 57);
        room_bgm_state_set(4, 17, 57);
        room_bgm_state_set(4, 18, 57);
        room_bgm_state_set(4, 19, 57);
        room_bgm_state_set(4, 20, 58);
        room_bgm_state_set(4, 21, 56);
        set(FG_SCENARIO, FLAG_SCENARIO_2B, TRUE);
    }
#else
    if (ck(FG_SCENARIO, FLAG_SCENARIO_37, FALSE))
    {
        enemy(ENEMY_01_ZOMBIE_NAKED, 4, 72, 1, 2, 0, 0, 3103, 0, 0, 21765, 0, 10142, 3, 0, 0, 0);
        if (ck(FG_ENEMY, FLAG_ENEMY_48, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 73, 1, 2, 0, 0, 896, 0, 0, 21004, 0, 8192, 3, 0, 0, 0);
        }
        if (ck(FG_ENEMY, FLAG_ENEMY_49, TRUE))
        {
            enemy(ENEMY_01_ZOMBIE_NAKED, 4, 74, 1, 2, 0, 0, 896, 0, 0, 21004, 0, 8192, 3, 0, 0, 0);
