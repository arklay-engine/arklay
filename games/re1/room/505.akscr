    door_aot_set(AOT_02_DOOR, 15700, 4300, 2800, 1500, 9, DOOR_SND_01_DR_MTL, DOOR_0D_DOOR13, 6, DOOR_LOCKED | F_LOCK_2D, ROOM_507_MORTUARY, 12100, 0, 2500, 3072, LOCKED, SAT_MANUAL | SAT_PLAYER);
