proc main
{
    if (ck(FG_SCENARIO, 99, 1))
    {
        if (ck(FG_LOCK, 29, 0))
        {
            set(FG_SCENARIO, 99, 0);
            effect_kill_a(0);
            effect(10, 24, 0, 228, 87, 40, 241, 252, 8, 0, 0);
        }
    }
}

event event_00
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
    }
    set(FG_STATUS, 15, 0);
    run
    {
        snd_pan_vol_set(1, 112, 112);
        snd_pan_vol_set(2, 112, 112);
        bgm_play(0);
        bgm_play(1);
        bgm_play(2);
        message(1, 0);
    }
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 7, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 400, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 65136, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 400, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(51, 65136, 65436, 0, 30, 10);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    cut_auto(0);
    set(FG_STATUS, 15, 1);
    run
    {
        room_bgm_state_set(4, 5, 57);
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
    }
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    sleep(25);
    message(0, 65535);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 3);
    act_flag_op(1, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
    }
    evt_finish();
}
