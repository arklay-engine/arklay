#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_MESSAGE 0x01
#define AOT_02_USEITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_ITEM 0x04
#define AOT_05_ITEM 0x05
#define F_ROOM_00 0x00
#define F_ROOM_01 0x01

proc init
{
    door_aot_set(AOT_00_DOOR, 4000, 11800, 1300, 1400, 1, 0, 1, 4, 0, ROOM_20E_FRONT_OF_ATTIC, 4900, 0, 12500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_MESSAGE, 7300, 6700, 2700, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_02_USEITEM, 7300, 6700, 2700, 2000, SCE_USEITEM, SAT_PLAYER, 9, 0, 21, 0, 1, 0);
    item_aot_set(AOT_03_ITEM, 10000, 11300, 1700, 1000, IT_0B_AMMO_HANDGUN, 15, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 11, 129, 0, 0);
#if CHRIS
    item_aot_set(AOT_04_ITEM, 3200, 1900, 1200, 2400, IT_0C_AMMO_SHOTGUN, 7, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, 12, 129, 0, 0);
#else
    item_aot_set(AOT_04_ITEM, 3200, 1900, 1200, 2400, IT_11_AMMO_GRENADE_ACID, 6, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, 12, 129, 0, 0);
    item_aot_set(AOT_05_ITEM, 4800, 7000, 1100, 3400, IT_2F_KEY_INK_RIBBON, 2, 2, 255, 192, 23, 50, 251, 116, 34, 0, 0, 89, 129, 0, 0);
#endif
    obj(0, 17, 255, 7872, 0, 5192, 3072, 0, 0, 106, 4, 0, 0, 150, 251, 40, 0, 232, 3, 146, 4, 28, 2);
    if (ck(FG_SCENARIO, F_SCENARIO_0A, FALSE))
    {
        aot_reset(AOT_04_ITEM, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 255, 0);
    }
    else
    {
        cut_auto(1);
        setb(B_CAMERA, 3, 0);
        aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
        if (ck(FG_ITEM, F_ITEM_0C, TRUE))
        {
            aot_reset(AOT_04_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
        }
        else
        {
            aot_reset(AOT_04_ITEM, SCE_NONE, 0, 0, 0, 0);
        }
        effect(15, 0, 0, 254, 31, 194, 248, 200, 31, 0, 0);
        effect(15, 0, 0, 124, 32, 122, 248, 70, 32, 0, 0);
        effect(15, 0, 0, 12, 33, 194, 248, 196, 32, 0, 0);
        msg_list(0, 190, 20, 48, 248, 187, 34, 200, 200, 160, 0, 123, 21, 22, 34, 48, 248, 154, 34, 200, 200, 160, 0, 63, 21, 0, 35, 48, 248, 202, 11, 160, 160, 240, 0, 223, 16, 204, 4, 204, 4, 236, 3);
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_0A, FALSE))
    {
        if (testitem(IT_30_KEY_LIGHTER))
        {
            cutnext(4);
            cut_auto(0);
            aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
            aot_reset(AOT_04_ITEM, SCE_ITEM, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
            effect(15, 0, 0, 254, 31, 194, 248, 200, 31, 0, 0);
            effect(15, 0, 0, 124, 32, 122, 248, 70, 32, 0, 0);
            effect(15, 0, 0, 12, 33, 194, 248, 196, 32, 0, 0);
            set(FG_ROOM, F_ROOM_00, TRUE);
            set(FG_SCENARIO, F_SCENARIO_0A, TRUE);
            msg_list(0, 190, 20, 48, 248, 187, 34, 200, 200, 160, 0, 123, 21, 22, 34, 48, 248, 154, 34, 200, 200, 160, 0, 63, 21, 0, 35, 48, 248, 202, 11, 160, 160, 240, 0, 223, 16, 204, 4, 204, 4, 236, 3);
        }
    }
    else if (ck(FG_ROOM, F_ROOM_01, FALSE))
    {
        cut_auto(0);
        set(FG_ROOM, F_ROOM_01, TRUE);
    }
    if (cmpb(B_CAMERA, CMP_EQ, 2))
    {
        set(FG_MAP, F_MAP_3D, TRUE);
    }
    if (cmpb(B_CAMERA, CMP_EQ, 5))
    {
        set(FG_MAP, F_MAP_3D, TRUE);
    }
}
