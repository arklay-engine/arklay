#version 1

proc init
{
    door_aot_set(0, 4000, 11800, 1300, 1400, 1, 0, 1, 4, 0, RDT_00E, 4900, 0, 12500, 0, UNLOCKED, 129);
    aot_set(1, 7300, 6700, 2700, 2000, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    aot_set(2, 7300, 6700, 2700, 2000, SCE_USEITEM, 1, 9, 0, 21, 0, 1, 0);
    item_aot_set(3, 10000, 11300, 1700, 1000, ITEM_CLIP, 15, 0, 255, 0, 0, 0, 0, 0, 0, 0, 0, 11, 129, 0, 0);
#if CHRIS
    item_aot_set(4, 3200, 1900, 1200, 2400, ITEM_SHELLS, 7, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, 12, 129, 0, 0);
#else
    item_aot_set(4, 3200, 1900, 1200, 2400, ITEM_ACID_ROUNDS, 6, 1, 255, 0, 0, 0, 0, 0, 0, 0, 0, 12, 129, 0, 0);
    item_aot_set(5, 4800, 7000, 1100, 3400, ITEM_INK_RIBBON, 2, 2, 255, 192, 23, 50, 251, 116, 34, 0, 0, 89, 129, 0, 0);
#endif
    obj(0, 17, 255, 7872, 0, 5192, 3072, 0, 0, 106, 4, 0, 0, 150, 251, 40, 0, 232, 3, 146, 4, 28, 2);
    if (ck(FG_SCENARIO, 10, 1))
    {
        aot_reset(4, SCE_MESSAGE, 129, 130, 255, 0);
    }
    else
    {
        cut_auto(1);
        setb(2, 3, 0);
        aot_reset(1, SCE_MESSAGE, 129, 129, 255, 0);
        if (ck(FG_ITEM, 12, 0))
        {
            aot_reset(4, SCE_ITEM, 129, 0, 0, 0);
        }
        else
        {
            aot_reset(4, SCE_NONE, 0, 0, 0, 0);
        }
        effect(15, 0, 0, 254, 31, 194, 248, 200, 31, 0, 0);
        effect(15, 0, 0, 124, 32, 122, 248, 70, 32, 0, 0);
        effect(15, 0, 0, 12, 33, 194, 248, 196, 32, 0, 0);
        msg_list(0, 190, 20, 48, 248, 187, 34, 200, 200, 160, 0, 123, 21, 22, 34, 48, 248, 154, 34, 200, 200, 160, 0, 63, 21, 0, 35, 48, 248, 202, 11, 160, 160, 240, 0, 223, 16, 204, 4, 204, 4, 236, 3);
    }
}

proc main
{
    if (ck(FG_SCENARIO, 10, 1))
    {
        if (testitem(ITEM_LIGHTER))
        {
            cutnext(4);
            cut_auto(0);
            aot_reset(1, SCE_MESSAGE, 129, 129, 255, 0);
            aot_reset(4, SCE_ITEM, 129, 0, 0, 0);
            effect(15, 0, 0, 254, 31, 194, 248, 200, 31, 0, 0);
            effect(15, 0, 0, 124, 32, 122, 248, 70, 32, 0, 0);
            effect(15, 0, 0, 12, 33, 194, 248, 196, 32, 0, 0);
            set(FG_ROOM, 0, 0);
            set(FG_SCENARIO, 10, 0);
            msg_list(0, 190, 20, 48, 248, 187, 34, 200, 200, 160, 0, 123, 21, 22, 34, 48, 248, 154, 34, 200, 200, 160, 0, 63, 21, 0, 35, 48, 248, 202, 11, 160, 160, 240, 0, 223, 16, 204, 4, 204, 4, 236, 3);
        }
    }
    else if (ck(FG_ROOM, 1, 1))
    {
        cut_auto(0);
        set(FG_ROOM, 1, 0);
    }
    if (cmpb(2, 0, 2))
    {
        set(FG_MAP, 61, 0);
    }
    if (cmpb(2, 0, 5))
    {
        set(FG_MAP, 61, 0);
    }
}
