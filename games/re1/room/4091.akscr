#version 1

proc init
{
    door_aot_set(0, 9600, 2300, 1800, 1700, 2, 0, 7, 1, 0, RDT_008, 8500, 0, 10200, 0, UNLOCKED, 129);
    item_aot_set(1, 4300, 1500, 1100, 1500, ITEM_EMPTY_BOTTLE, 1, 0, 255, 132, 18, 172, 249, 196, 9, 0, 0, 60, 129, 16, 132);
    item_aot_set(2, 1900, 5400, 1200, 1000, ITEM_EMPTY_BOTTLE, 1, 1, 255, 198, 12, 156, 244, 168, 22, 0, 0, 61, 129, 16, 132);
    item_aot_set(3, 5100, 6000, 2200, 1100, ITEM_EMPTY_BOTTLE, 1, 2, 255, 240, 25, 62, 244, 76, 24, 132, 3, 62, 129, 16, 132);
    item_aot_set(4, 2200, 2800, 850, 500, ITEM_EMPTY_BOTTLE, 1, 3, 255, 236, 9, 226, 249, 58, 12, 0, 0, 63, 129, 16, 132);
    item_aot_set(5, 0, 0, 1, 1, ITEM_WATER, 1, 4, 255, 0, 0, 0, 0, 0, 0, 0, 0, 64, 129, 0, 0);
    item_aot_set(6, 0, 0, 1, 1, ITEM_UMB_NO_2, 1, 5, 255, 0, 0, 0, 0, 0, 0, 0, 0, 65, 129, 0, 0);
    item_aot_set(7, 0, 0, 1, 1, ITEM_UMB_NO_4, 1, 6, 255, 0, 0, 0, 0, 0, 0, 0, 0, 66, 129, 0, 0);
    aot_set(11, 7300, 6000, 2200, 1100, SCE_MESSAGE, 129, 136, 0, 255, 0, 0, 0);
    aot_set(12, 1900, 3500, 1200, 1900, SCE_MESSAGE, 129, 137, 0, 255, 0, 0, 0);
    aot_set(8, 5900, 1400, 1100, 1500, SCE_MESSAGE, 129, 132, 0, 255, 0, 0, 0);
    aot_set(9, 3000, 1500, 1200, 600, SCE_MESSAGE, 129, 128, 0, 255, 0, 0, 0);
    aot_set(10, 9800, 4400, 700, 1700, SCE_MESSAGE, 129, 129, 0, 255, 0, 0, 0);
}

proc main
{
    set(FG_ITEM, 64, 0);
    set(FG_ITEM, 65, 0);
    set(FG_ITEM, 66, 0);
    if (ck(FG_ITEM, 78, 0))
    {
        if (item_ck(ITEM_EMPTY_BOTTLE))
        {
            aot_reset(8, SCE_EVENT, 129, 9, event_00, 0);
        }
        else
        {
            aot_reset(8, SCE_MESSAGE, 129, 132, 77, 0);
        }
        aot_delete(11, SCE_NONE, 129);
        aot_delete(12, SCE_NONE, 129);
    }
    else if (item_ck(ITEM_EMPTY_BOTTLE))
    {
        aot_reset(8, SCE_EVENT, 129, 9, event_00, 0);
        aot_reset(11, SCE_EVENT, 129, 9, event_01, 0);
        aot_reset(12, SCE_EVENT, 129, 9, event_02, 0);
    }
    else
    {
        aot_reset(8, SCE_MESSAGE, 129, 132, 77, 0);
        aot_reset(11, SCE_MESSAGE, 129, 136, 77, 0);
        aot_reset(12, SCE_MESSAGE, 129, 137, 77, 0);
    }
    if (ck(FG_SCENARIO, 22, 0))
    {
        if (ck(FG_ROOM, 24, 1))
        {
            evt_exec(0, 9, event_03);
        }
        else if (ck(FG_ROOM, 0, 0))
        {
            evt_exec(0, 9, event_03);
        }
        set(FG_SCENARIO, 22, 1);
        set(FG_ROOM, 24, 0);
    }
}

event event_00
{
    run
    {
        set(FG_6, 31, 1);
        set(FG_6, 25, 1);
        set(FG_6, 29, 1);
        set(FG_6, 28, 1);
        message(133, 0);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            remove_item(ITEM_EMPTY_BOTTLE);
            give_item(5, 4, 0);
        }
        set(FG_6, 31, 0);
        set(FG_6, 25, 0);
        set(FG_6, 29, 0);
        set(FG_6, 28, 0);
    }
    evt_finish();
}

