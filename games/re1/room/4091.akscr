event event_03
{
    run
    {
        set(FG_ROOM, 25, 1);
        set(FG_6, 23, 1);
        set(FG_6, 29, 1);
        set(FG_6, 25, 1);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 1, 0 | 25, 0 | 0);
    act_reset();
    evt_nop();
    se_play_3d(3, 0, 0, 1, 0, 0, 0);
    single(12) effect(9, 25, 1, 88, 2, 160, 246, 0, 0);
    evt_nop();
    evt_nop();
    sleep(4);
    single(12) effect(9, 25, 1, 88, 2, 160, 246, 0, 0);
    evt_nop();
    evt_nop();
    sleep(5);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 25, 1));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        if (ck(FG_ROOM, 2, 0))
        {
            timer_setup(3, 64, 6, 6, 0);
        }
        else
        {
            timer_setup(3, 176, 4, 6, 0);
        }
        set(FG_ROOM, 25, 1);
        set(FG_6, 23, 0);
        set(FG_6, 31, 1);
        set(FG_6, 25, 1);
    }
    sleep(20);
    setw(2, 0, 0);
    message(139, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, 31, 0);
        set(FG_6, 25, 0);
        set(FG_6, 29, 0);
        sys_multi(8, 320);
    }
    evt_finish();
}

event event_04
{
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 0, 0, 0, 0);
    sleep(1);
    timer_setup(2, 255, 255, 7, 0);
    sleep(1);
    timer_setup(2, 240, 216, 7, 0);
    evt_finish();
}
