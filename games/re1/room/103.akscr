#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_DOOR 0x04
#define AOT_05_USEITEM 0x05
#define AOT_06_USEITEM 0x06
#define ENEMY_00_HUNTER 0x00
#define ENEMY_00_ZOMBIE_GROUNDSKEEPER 0x00
#define ENEMY_01_HUNTER 0x01
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define ENEMY_02_ZOMBIE_GROUNDSKEEPER 0x02
#define F_ROOM_00 0x00
#define F_ROOM_01 0x01
#define F_ROOM_02 0x02
#define F_ROOM_03 0x03
#define VO_A00_00 0x85

proc init
{
#if MANSION1
    door_aot_set(AOT_00_DOOR, 0, 23700, 2500, 2100, 2, 0, 0, 1, 0, ROOM_101_1F_LEFT_STAIRS, 19000, 0, 20500, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 800, 500, 3200, 2500, 1, 0, 1, 1, 146, ROOM_104_TEA_ROOM, 15800, 0, 3700, 1024, LOCK, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 19000, 17700, 2500, 2400, 2, 0, 2, 1, 64, ROOM_10C_GREEN_HOUSE, 13600, 0, 7400, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 7500, 15100, 2300, 2000, 3, 0, 0, 4, 64, ROOM_10D_TIGER_STATUE_ROOM, 5600, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_04_DOOR, 0, 10100, 2400, 1600, 2, 0, 28, 3, 203, ROOM_10E_EMPLOYEE_ROOM, 7400, 0, 10700, 2048, IT_33_KEY_MANSION_SWORD, SAT_MANUAL | SAT_PLAYER);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 0, 41, 1, 2, 0, 0, 1024, 0, 0, 8380, 0, 25515, ENEMY_00_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
#if CHRIS
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 0, 42, 1, 2, 0, 0, 2177, 0, 0, 14813, 0, 22274, ENEMY_01_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
#endif
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 1, 40, 1, 2, 0, 0, 2025, 0, 0, 4210, 0, 14400, ENEMY_02_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_A4, TRUE))
    {
        set(FG_COMMON, F_COMMON_A9, TRUE);
    }
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        set(FG_COMMON, F_COMMON_2C, FALSE);
    }
#endif
#else
    door_aot_set(AOT_00_DOOR, 0, 23700, 2400, 2700, 2, 0, 0, 1, 0, ROOM_101_1F_LEFT_STAIRS, 19000, 0, 20500, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 2300, 1600, 1500, 1000, 1, 0, 1, 1, 146, ROOM_104_TEA_ROOM, 15800, 0, 3700, 1024, LOCK, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 19600, 18200, 1900, 1000, 2, 0, 2, 1, 0, ROOM_10C_GREEN_HOUSE, 13600, 0, 7400, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 7900, 15300, 3100, 2200, 3, 0, 0, 4, 0, ROOM_10D_TIGER_STATUE_ROOM, 5600, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_04_DOOR, 0, 10700, 2300, 1300, 2, 0, 28, 3, 139, ROOM_10E_EMPLOYEE_ROOM, 7400, 0, 10700, 2048, IT_33_KEY_MANSION_SWORD, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_05_USEITEM, 0, 9300, 6400, 6800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 2, 0, 1, 0);
    aot_set(AOT_06_USEITEM, 0, 11700, 6400, 6800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 3, 0, 1, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_5D, TRUE))
    {
        enemy(EM_06_HUNTER, 16, 59, 1, 2, 0, 0, 1152, 0, 0, 5219, 0, 15022, ENEMY_00_HUNTER, 0, 0, 0);
    }
    else
    {
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_104_TEA_ROOM))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
        }
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_10E_EMPLOYEE_ROOM))
        {
            set(FG_ROOM, F_ROOM_00, TRUE);
        }
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_101_1F_LEFT_STAIRS))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
        }
        if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_10C_GREEN_HOUSE))
        {
            set(FG_ROOM, F_ROOM_01, TRUE);
        }
    }
    if (ck(FG_ROOM, F_ROOM_00, TRUE))
    {
        enemy(EM_06_HUNTER, 136, 59, 1, 2, 0, 0, 2048, 0, 0, 6819, 0, 14176, ENEMY_00_HUNTER, 0, 0, 0);
    }
    if (ck(FG_ROOM, F_ROOM_01, TRUE))
    {
        enemy(EM_06_HUNTER, 137, 59, 1, 2, 0, 0, 2048, 0, 0, 6819, 0, 14176, ENEMY_00_HUNTER, 0, 0, 0);
    }
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        enemy(EM_06_HUNTER, 0, 58, 1, 2, 0, 0, 2192, 0, 0, 15874, 0, 22102, ENEMY_01_HUNTER, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_2F, TRUE))
        {
            set(FG_COMMON, F_COMMON_30, TRUE);
            set(FG_COMMON, F_COMMON_C0, TRUE);
            set(FG_COMMON, F_COMMON_2F, FALSE);
#if CHRIS
            evt_exec(0, 9, on_enter);
#else
            evt_exec(0, 9, event_00);
#endif
        }
    }
#endif
}
#if MANSION2

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_5D, FALSE))
    {
        if (ck(FG_ROOM, F_ROOM_00, TRUE) && ck(FG_ROOM, F_ROOM_02, TRUE))
        {
            set(FG_SCENARIO, F_SCENARIO_5D, TRUE);
            eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, 8);
        }
        if (ck(FG_ROOM, F_ROOM_01, TRUE) && ck(FG_ROOM, F_ROOM_03, TRUE))
        {
            set(FG_SCENARIO, F_SCENARIO_5D, TRUE);
            eml_state(0, ENEMY_00_HUNTER, EML_BEHAVIOUR, 9);
        }
    }
}
#if CHRIS

event on_enter
{
    set(FG_STATUS, F_STATUS_0F, TRUE);
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    set(FG_6, F_6_1D, FALSE);
    voice_play(VOICE_PLAY, VO_A00_00, 0);
    wait_message();
    evt_fork(9, on_enter_sub1, 0);
    sleep(100);
    run
    {
        cut_auto(0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_6, F_6_17, TRUE);
        set(FG_6, F_6_1D, TRUE);
    }
    evt_finish();
}

event on_enter_sub1
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 31, 0 | 0);
    act_param_set(0, 8);
    sleep(42);
    act_idle();
    act_finish();
}
#endif
#endif
