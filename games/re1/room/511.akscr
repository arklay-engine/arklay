    set(FG_ROOM, FLAG_ROOM_19, FALSE);
    evt_fork(9, event_05, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_19, FALSE));
    sleep(10);
