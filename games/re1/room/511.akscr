#if CHRIS
event on_enter_3_sub1
#else
event event_05
#endif
{
    se_play_3d(2, 23, 0, 0, 0, 6500, 4100);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 4, 0 | 24, 0 | 0);
    act_flag_op(1, 1, 0);
    act_action_a(11);
    sleep(2);
    act_idle();
    act_nop();
    sleep(2);
    act_anim_flags(32 | 4, 0 | 24, 0 | 0);
    act_flag_op(1, 0, 0);
    act_action_a(6);
    sleep(2);
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_ROOM, FLAG_ROOM_19, TRUE);
    evt_finish();
}

