#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_MESSAGE 0x01
#define AOT_02_MESSAGE 0x02
#define AOT_03_MESSAGE 0x03
#define FLAG_ROOM_19 0x19

proc init
{
    door_aot_set(AOT_00_DOOR, 11300, 15800, 3000, 2900, 12, 1, 11, 3, 0, ROOM_510_MAZE_B, 12200, 0, 2500, 3072, UNLOCKED, 129);
    aot_set(AOT_01_MESSAGE, 17700, 8300, 2100, 1600, SCE_NONE, 129, 9, 0, 0, 0, 0, 0);
    aot_set(AOT_02_MESSAGE, 5800, 4400, 2100, 1700, SCE_NONE, 129, 9, 0, 0, 0, 0, 0);
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_5A, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_2B, FALSE))
    {
        aot_set(AOT_03_MESSAGE, 6000, 3600, 1000, 1000, SCE_MESSAGE, 129, 135, 0, 69, 0, 0, 0);
        enemy(ENEMY_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 3072, 0, 0, 6500, 0, 4100, 0, 32, 1, 0);
        evt_exec(0, 9, on_enter_3);
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_C0, FALSE) && ck(FG_COMMON, FLAG_COMMON_5B, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_37, TRUE))
    {
        aot_set(AOT_03_MESSAGE, 8500, 3226, 1000, 1000, SCE_MESSAGE, 129, 130, 0, 71, 0, 0, 0);
        enemy(ENEMY_24_NPC_WESKER, 2, 255, 1, 2, 0, 0, 2000, 0, 0, 9000, 0, 3726, 0, 0, 0, 0);
        enemy(ENEMY_09_CHIMERA, 3, 181, 1, 2, 0, 0, 2048, 0, 0, 10600, 0, 4000, 1, 0, 0, 0);
    }
#endif
    evt_exec(0, 9, on_enter);
    evt_exec(0, 9, on_enter_2);
}

proc main
{
    if (ck(FG_SCENARIO, FLAG_SCENARIO_2B, TRUE))
    {
        aot_reset(AOT_02_MESSAGE, SCE_MESSAGE, 129, 128, 69, 0);
    }
    else
    {
        aot_reset(AOT_02_MESSAGE, SCE_MESSAGE, 129, 129, 69, 0);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_2D, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_2E, TRUE))
    {
        aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, 129, 134, 69, 0);
    }
    else if (ck(FG_SCENARIO, FLAG_SCENARIO_2D, FALSE))
    {
        aot_reset(AOT_01_MESSAGE, SCE_EVENT, 129, 9, on_aot_01_message, 0);
    }
    else
    {
        aot_reset(AOT_01_MESSAGE, SCE_MESSAGE, 129, 133, 69, 0);
    }
}

event on_aot_01_message
{
    run
    {
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_19, FALSE);
        set(FG_6, FLAG_6_17, FALSE);
        message(131, 70); // "A power connection switch. The elevator power is off.Will you connect it?The power isn't supplied to the elevator."
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    sleep(15);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 9, on_aot_01_message_sub1);
            set(FG_SCENARIO, FLAG_SCENARIO_2D, TRUE);
        }
    }
    run
    {
        set(FG_6, FLAG_6_1D, TRUE);
        set(FG_6, FLAG_6_19, TRUE);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_01_message_sub1
{
    run
    {
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_19, FALSE);
        set(FG_6, FLAG_6_17, FALSE);
    }
    sleep(10);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(10);
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_2E, TRUE))
        {
            message(134, 70); // "The power for the elevator is activated as the powersupply and the circuit have been connected."
        }
        else
        {
            message(132, 70); // "The power isn't supplied to the elevator."
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_6, FLAG_6_1D, TRUE);
        set(FG_6, FLAG_6_19, TRUE);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}

event on_enter
{
    sleep(119);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 6600, 11600);
    }
    for (8)
    {
        effect(31, 0, 0, 200, 25, 196, 240, 80, 45, 188, 7);
        sleep(3);
    }
    evt_nop();
    evt_chain(2);
    evt_finish();
}

event on_enter_2
{
    sleep(240);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 13200, 5600);
    }
    for (8)
    {
        effect(31, 0, 0, 144, 51, 60, 246, 224, 21, 2, 3);
        sleep(3);
    }
    evt_chain(3);
    evt_finish();
}

