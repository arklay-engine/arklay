#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_NONE 0x04
#define AOT_05_NONE 0x05
#define AOT_06_NONE 0x06
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_04 0x04
#define ENEMY_00_ADDER 0x00
#define ENEMY_01_ADDER 0x01
#define ENEMY_02_ADDER 0x02
#define ENEMY_03_ADDER 0x03
#define ENEMY_04_ADDER 0x04
#define ENEMY_05_ADDER 0x05
#define ENEMY_06_ADDER 0x06
#define ENEMY_07_ADDER 0x07
#define F_ROOM_18 0x18
#define IMDL_00 0x00
#define MSG_IT_LOOKS_LIKE_A_HOOK 0x00
#define OBJ_00 0x00
#define SE_17_HOOKMIX 0x17
#define SE_18_LOCKOUTA 0x18
#define SE_19_LOCKOUTB 0x19

proc init
{
    door_aot_set(AOT_00_DOOR, 11700, 7100, 5100, 2200, 11, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30C_BLACK_TIGER_ROOM, 11000, 0, 3500, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 27400, 6800, 2800, 2200, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30E_SAVE_ROOM, 4600, 0, 2800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (CHRIS)
    {
        door_aot_set(AOT_02_DOOR, 0, 3600, 2400, 1900, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, DOOR_LOCKED | F_LOCK_2F, ROOM_30F_CRANK_PASSAGE, 28000, 0, 15400, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        item_aot_set(AOT_03_ITEM, 0, 0, 1, 1, IT_06_WEAPON_FLAMETHROWER, 240, IMDL_00, SCA_NONE, 3760, -2300, 7060, 1024, F_ITEM_AC, SAT_MANUAL | SAT_PLAYER, 0);
        swap_var(XFER_RESTORE, AOT_03_ITEM, B_0D);
        aot_set(AOT_04_NONE, 3000, 6600, 2000, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 3, 0, 0, 0);
        aot_set(AOT_05_NONE, 3000, 6600, 2000, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 4, 0, 0, 0);
        aot_set(AOT_06_NONE, 3000, 6600, 2000, 2000, SCE_NONE, SAT_MANUAL | SAT_PLAYER, 9, 0, 7, 0, 0, 0);
        obj(OBJ_00, OF_NO_COLLISION | OF_NO_FLOOR_PROBE | OF_INTANGIBLE | OF_ACTIVE, SCA_NONE, 3300, -2090, 7450, 1024, 0, 0, 0, 0, 0, 0, 0, 0);
    }
    else
    {
        door_aot_set(AOT_02_DOOR, 0, 3600, 2400, 1900, 0, DOOR_SND_01_DR_MTL, DOOR_08_DOOR08, 0, 0, ROOM_30F_CRANK_PASSAGE, 28000, 0, 15400, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_42, TRUE))
    {
        enemy(EM_0A_ADDER, EB_00, F_ENEMY_92, SPAWN_FORCE, 2, 0, 0, 0, 6500, 0, 4500, ENEMY_00_ADDER, ANIM_00, 0, EVAR_00);
        enemy(EM_0A_ADDER, EB_01, F_ENEMY_93, SPAWN_FORCE, 2, 0, 0, 0, 10000, 0, 5000, ENEMY_01_ADDER, ANIM_00, 0, EVAR_00);
        enemy(EM_0A_ADDER, EB_01, F_ENEMY_94, SPAWN_FORCE, 2, 0, 0, 0, 12000, 0, 5000, ENEMY_02_ADDER, ANIM_00, 0, EVAR_00);
        enemy(EM_0A_ADDER, EB_01, F_ENEMY_95, SPAWN_FORCE, 2, 0, 0, 0, 14000, 0, 5000, ENEMY_03_ADDER, ANIM_00, 0, EVAR_00);
        enemy(EM_0A_ADDER, EB_02, F_ENEMY_96, SPAWN_FORCE, 2, 0, 0, 0, 11000, 0, 4000, ENEMY_04_ADDER, ANIM_00, 0, EVAR_00);
        enemy(EM_0A_ADDER, EB_02, F_ENEMY_97, SPAWN_FORCE, 2, 0, 0, 0, 13000, 0, 4000, ENEMY_05_ADDER, ANIM_00, 0, EVAR_00);
        enemy(EM_0A_ADDER, EB_03, F_ENEMY_98, SPAWN_FORCE, 2, 0, 2048, 0, 30000, 0, 4000, ENEMY_06_ADDER, ANIM_00, 0, EVAR_00);
        enemy(EM_0A_ADDER, EB_03, F_ENEMY_99, SPAWN_FORCE, 2, 0, 2048, 0, 30000, 0, 5000, ENEMY_07_ADDER, ANIM_00, 0, EVAR_00);
    }
    if (CHRIS)
    {
        if (ck(FG_ITEM, F_ITEM_AC, FALSE))
        {
            if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_30F_CRANK_PASSAGE))
            {
                eml_pos(OBJ_00, 0, 1024, 0, 4260, -2210, 6910);
            }
            else
            {
                eml_pos(OBJ_00, 0, 1024, 0, 4370, -2340, 7020);
            }
            if (item_ck(IT_06_WEAPON_FLAMETHROWER))
            {
                aot_delete(AOT_04_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            }
            else
            {
                aot_delete(AOT_06_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            }
            set(FG_LOCK, F_LOCK_2F, FALSE);
        }
        else
        {
            aot_delete(AOT_05_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
            set(FG_LOCK, F_LOCK_2F, TRUE);
        }
        set(FG_STATUS, F_STATUS_1D, TRUE);
    }
}

proc main when (CHRIS)
{
    if (ck(FG_ROOM, F_ROOM_18, TRUE))
    {
        set(FG_ROOM, F_ROOM_18, FALSE);
        if (testpickup(IT_06_WEAPON_FLAMETHROWER))
        {
            set(FG_ROOM, F_ROOM_18, FALSE);
        }
        else if (testitem(IT_06_WEAPON_FLAMETHROWER))
        {
            set(FG_ROOM, F_ROOM_18, FALSE);
        }
        else
        {
            cutcurr(0);
            set(FG_STATUS, F_STATUS_1A, TRUE);
        }
    }
    if (testpickup(IT_06_WEAPON_FLAMETHROWER))
    {
        set(FG_ITEM, F_ITEM_99, FALSE);
        evt_exec(0, TASK_09, from_main);
    }
    if (testitem(IT_06_WEAPON_FLAMETHROWER))
    {
        set(FG_ITEM, F_ITEM_99, FALSE);
        set(FG_ITEM, F_ITEM_AC, TRUE);
        setbyte(0, 1, 0);
        evt_exec(0, TASK_09, from_main_2);
        evt_exec(0, TASK_09, from_main_3);
    }
    if (ck(FG_STATUS, F_STATUS_1A, TRUE))
    {
        if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
        {
            evt_exec(0, TASK_09, from_main_4);
            if (ck(FG_ITEM, F_ITEM_AC, FALSE))
            {
                eml_pos(OBJ_00, 0, 1024, 0, 4370, -2180, 7020);
            }
            else
            {
                eml_pos(OBJ_00, 0, 1024, 0, 4370, -2340, 7020);
            }
        }
        else
        {
            require(cmpb(B_CAMERA, CMP_EQ, CAM_01));
            evt_exec(0, TASK_09, from_main_5);
            if (ck(FG_ITEM, F_ITEM_AC, FALSE))
            {
                eml_pos(OBJ_00, 0, 1024, 0, 4370, -2340, 7020);
            }
            else
            {
                eml_pos(OBJ_00, 0, 1024, 0, 4260, -2210, 6910);
            }
        }
    }
}

event from_main when (CHRIS)
{
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3960, -2560, 7270);
    tw_end();
    evt_nop();
    run
    {
        aot_delete(AOT_05_NONE, SCE_NONE, 0);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
    }
    evt_next();
    evt_nop();
    se_play_3d(SND_BANK_ROOM, SE_17_HOOKMIX, 0, SND_AT_POINT, 0, 3810, 7180);
    sleep(5);
    evt_work_set(WK_OBJ, OBJ_00);
    evt_tween_begin_alt();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -6, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -10, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -13, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -18, 0);
    for (4)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, -13, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -10, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -6, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 8, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -1, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_end();
    evt_nop();
    run
    {
        eml_pos(OBJ_00, 0, 1024, 0, 4370, -2340, 7020);
        aot_delete(AOT_04_NONE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        se_play_3d(SND_BANK_ROOM, SE_18_LOCKOUTA, 0, SND_AT_POINT, 0, 1200, 2750);
        set(FG_LOCK, F_LOCK_2F, FALSE);
        cutcurr(0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_STATUS, F_STATUS_1A, TRUE);
    }
    evt_finish();
}

