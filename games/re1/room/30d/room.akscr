event hang_flamethrower
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        eml_pos(OBJ_00_HOOK, 0, 1024, 0, 3960, -2670, 7270);
        cutnext(CAM_04_HOOK);
    }
    evt_work_set(WK_AOT, IMDL_00_WEAPON_FLAMETHROWER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3810, -2640, 7270);
    tw_end();
    evt_nop();
    sleep(20);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        setb(B_SELECTED_ITEM, IT_06_WEAPON_FLAMETHROWER, 0);
        swap_var(XFER_HELD, AOT_03_ITEM_WEAPON_FLAMETHROWER_0, B_0D);
        set(FG_STATUS, F_STATUS_MENU_KEY_DEPLETED, TRUE);
        set(FG_ROOM, F_ROOM_HOOK_CLOSEUP, TRUE);
    }
    evt_finish();
}

event reach_for_flamethrower
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        eml_pos(OBJ_00_HOOK, 0, 1024, 0, 3960, -2560, 7270);
        cutnext(CAM_04_HOOK);
    }
    evt_work_set(WK_AOT, IMDL_00_WEAPON_FLAMETHROWER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3810, -2525, 7270);
    tw_end();
    evt_nop();
    sleep(20);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        aot_on(AOT_03_ITEM_WEAPON_FLAMETHROWER_0, SCE_ITEM, 0);
        set(FG_ROOM, F_ROOM_HOOK_CLOSEUP, TRUE);
    }
    evt_next();
    evt_nop();
    evt_work_set(WK_AOT, IMDL_00_WEAPON_FLAMETHROWER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3760, -2300, 7060);
    tw_finish();
}

event flamethrower_pos_cam_00
{
    evt_work_set(WK_AOT, IMDL_00_WEAPON_FLAMETHROWER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3580, -2430, 7140);
    tw_finish();
}

event flamethrower_pos_cam_01
{
    evt_work_set(WK_AOT, IMDL_00_WEAPON_FLAMETHROWER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3760, -2300, 7060);
    tw_finish();
}

event examine_hook
{
    run
    {
        message(MSG_IT_LOOKS_LIKE_A_HOOK | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It looks like a hook."
        eml_pos(OBJ_00_HOOK, 0, 1024, 0, 3960, -2670, 7270);
        cutnext(CAM_04_HOOK);
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        eml_pos(OBJ_00_HOOK, 0, 1024, 0, 3300, -2090, 7450);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        cutcurr(0);
    }
    evt_finish();
}
