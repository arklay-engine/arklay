        se_play_3d(SND_BANK_ROOM, SE_17_HOOKMIX, 0, SND_AT_POINT, 0, 3810, 7180);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
    }
    evt_work_set(WK_OBJ, OBJ_00_HOOK);
    evt_tween_begin_alt();
    evt_next();
    tw_nop();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 5, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 8, 0);
    for (4)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 10, 0);
    for (6)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_set_pos(0, 5, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 4, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -4, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, -8, 0);
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 3, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 2, 0);
    tw_pos_add();
    evt_next();
    tw_pos_add();
    evt_next();
    tw_set_pos(0, 1, 0);
    for (4)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    run
    {
        eml_pos(OBJ_00_HOOK, 0, 1024, 0, 4370, -2340, 7020);
        aot_delete(AOT_05_EVENT_TAKE_FLAMETHROWER, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        se_play_3d(SND_BANK_ROOM, SE_19_LOCKOUTB, 0, SND_AT_POINT, 0, 1200, 2750);
        set(FG_LOCK, F_LOCK_30D_30F, TRUE);
        cutcurr(0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_STATUS, F_STATUS_CAMERA_REDRAW, TRUE);
    }
    evt_work_set(WK_AOT, IMDL_00_WEAPON_FLAMETHROWER);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3760, -2300, 7060);
    tw_finish();
}

