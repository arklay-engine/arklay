event event_07 when (CHRIS)
{
    run
    {
        message(MSG_IT_LOOKS_LIKE_A_HOOK | MSG_FAST, RUN_0080 | RUN_READY | RUN_0020 | RUN_0010 | RUN_EFFECTS | RUN_MONSTERS | RUN_ENTITIES | RUN_PLAYER); // "It looks like a hook."
        eml_pos(OBJ_00, 0, 1024, 0, 3960, -2670, 7270);
        cutnext(CAM_04);
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        eml_pos(OBJ_00, 0, 1024, 0, 3300, -2090, 7450);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        cutcurr(0);
    }
    evt_finish();
}
