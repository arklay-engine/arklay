event event_03 when (CHRIS)
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        eml_pos(OBJ_00, 0, 1024, 0, 3960, -2670, 7270);
        cutnext(CAM_04);
    }
    evt_work_set(WK_AOT, IMDL_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3810, -2640, 7270);
    tw_end();
    evt_nop();
    sleep(20);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        setb(B_SELECTED_ITEM, IT_06_WEAPON_FLAMETHROWER, 0);
        swap_var(XFER_HELD, AOT_03_ITEM, B_0D);
        set(FG_STATUS, F_STATUS_12, TRUE);
        set(FG_ROOM, F_ROOM_18, TRUE);
    }
    evt_finish();
}

event event_04 when (CHRIS)
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        eml_pos(OBJ_00, 0, 1024, 0, 3960, -2560, 7270);
        cutnext(CAM_04);
    }
    evt_work_set(WK_AOT, IMDL_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3810, -2525, 7270);
    tw_end();
    evt_nop();
    sleep(20);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        aot_on(AOT_03_ITEM, SCE_ITEM, 0);
        set(FG_ROOM, F_ROOM_18, TRUE);
    }
    evt_next();
    evt_nop();
    evt_work_set(WK_AOT, IMDL_00);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3760, -2300, 7060);
    tw_finish();
}

