#if MANSION1
event on_aot_05_sub1
{
    evt_fork(TASK_09, on_aot_05_sub1_sub1, 0);
    sleep(20);
    evt_chain(5);
    evt_finish();
}

event on_aot_05_sub2
{
    evt_fork(TASK_09, on_aot_05_sub2_sub3, 0);
    sleep(40);
    bgm_play(BGM_MAIN);
    evt_fork(TASK_09, on_aot_05_sub2_sub2, 0);
    sleep(80);
    voice_play(VOICE_PLAY, VO_A06_00);
    evt_fork(TASK_09, on_aot_05_sub2_sub1, 0);
    sleep(15);
    message(MSG_VO_A06_00, 0);
    wait_message();
    sleep(100);
    run
    {
        set(FG_COMMON, F_COMMON_5E, TRUE);
        set(FG_COMMON, F_COMMON_2E, TRUE);
    }
    evt_chain(8);
    evt_finish();
