#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_5 0x04
#define AOT_05_EVENT 0x05
#define CAM_00 0x00
#define ENEMY_00 0x00
#define ENEMY_00_NPC_REBECCA 0x00
#define ENEMY_01_ZOMBIE_GROUNDSKEEPER 0x01
#define F_ROOM_20 0x20
#define MSG_VO_008_10 0x01
#define MSG_VO_008_11 0x02
#define MSG_VO_008_12 0x04
#define MSG_VO_008_13 0x05
#define MSG_VO_008_14 0x06
#define MSG_VO_008_15 0x08
#define MSG_VO_008_16 0x09
#define MSG_VO_008_17 0x0B
#define MSG_VO_008_18 0x0A
#define MSG_VO_A06_00 0x00
#define MSG_VO_A07_00 0x0C
#define SE_2C_TAORE_ST 0x2C
#define SE_DOOR_01 0x01
#define VO_008_10 0x0F
#define VO_008_11 0x10
#define VO_008_12 0x11
#define VO_008_13 0x12
#define VO_008_14 0x13
#define VO_008_15 0x14
#define VO_008_16 0x15
#define VO_008_17 0x16
#define VO_008_18 0x17
#define VO_008_19 0x18
#define VO_A06_00 0x0D
#define VO_A07_00 0x0E

#if MANSION1
proc init
#else
proc init noreturn
#endif
{
    door_aot_set(AOT_00_DOOR, 500, 2500, 1700, 3800, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_20D_PILLAR_PASSAGE, 11500, 0, 3100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 3200, 11400, 1700, 1600, 2, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 4, 0, ROOM_20F_DINING, 4800, 0, 11600, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if MANSION1
    door_aot_set(AOT_02_DOOR, 9200, 2500, 1700, 1300, 2, DOOR_SND_00_DR_WD, DOOR_07_DOOR07, 1, DOOR_LOCKED | F_LOCK_07, ROOM_210_ATTIC, 6100, 0, 3600, 0, IT_35_KEY_MANSION_SHIELD, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    door_aot_set(AOT_03_DOOR, 0, 0, 1, 1, 5, DOOR_SND_03_DR_REB, DOOR_00_DOOR00, 64, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#else
    door_aot_set(AOT_03_DOOR, 0, 0, 1, 1, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#endif
    aot_set(AOT_04_5, 6800, 2100, 1400, 1700, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
#if CHRIS
    enemy(EM_23_NPC_REBECCA, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_00_NPC_REBECCA, ANIM_00, 0, EVAR_00);
#endif
    if (ck(FG_COMMON, F_COMMON_43, FALSE))
    {
        room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_OFF);
#if CHRIS
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_04, F_ENEMY_58, SPAWN_FORCE, 2, 0, 1024, 0, 5300, 0, 5800, ENEMY_01_ZOMBIE_GROUNDSKEEPER, ANIM_00, 0, EVAR_00);
#else
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, EB_04, F_ENEMY_58, SPAWN_FORCE, 2, 0, 1024, 0, 5300, 0, 5800, ENEMY_00, ANIM_00, 0, EVAR_00);
#endif
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_43, TRUE) && ck(FG_SCENARIO, F_SCENARIO_47, FALSE))
    {
        aot_set(AOT_05_EVENT, 5460, 1700, 1300, 3100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_24, TRUE))
        {
            room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD);
        }
        else if (ck(FG_COMMON, F_COMMON_63, TRUE))
        {
            room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD);
        }
        else
        {
            room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 1);
        }
    }
    if (ck(FG_COMMON, F_COMMON_5F, TRUE) && ck(FG_COMMON, F_COMMON_5E, FALSE))
    {
        room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 2);
        dir_set(0, 0, 2448, 0, 5070, 0, 3100);
        plw_anim(PLW_00, ANIM_04, 27);
        pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
        if (cmpw(0, W_04, CMP_LT, 300))
        {
            if (cmpw(0, W_04, CMP_LT, 200))
            {
                set(FG_COMMON, F_COMMON_5D, TRUE);
            }
            evt_exec(0, TASK_09, on_enter);
        }
        else
        {
            evt_exec(0, TASK_09, on_enter_2);
        }
    }
    set(FG_COMMON, F_COMMON_66, TRUE);
#else
    if (ck(FG_COMMON, F_COMMON_43, TRUE) && ck(FG_SCENARIO, F_SCENARIO_47, FALSE) && ck(FG_COMMON, F_COMMON_56, FALSE))
    {
        room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 1);
        enemy(EM_22_NPC_BARRY, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_00, ANIM_00, 0, EVAR_00);
        aot_set(AOT_05_EVENT, 5460, 1700, 1300, 3100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
    }
#endif
#else
    door_aot_set(AOT_02_DOOR, 8900, 2500, 1700, 1300, 2, DOOR_SND_00_DR_WD, DOOR_07_DOOR07, 1, DOOR_LOCKED | F_LOCK_07, ROOM_210_ATTIC, 6100, 0, 3600, 0, IT_35_KEY_MANSION_SHIELD, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 0, 0, 1, 1, 5, DOOR_SND_03_DR_REB, DOOR_00_DOOR00, 64, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_04_5, 6600, 2600, 1900, 2400, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
#endif
}
#if MANSION1

proc main
{
    if (ck(FG_COMMON, F_COMMON_43, FALSE))
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
    }
}

event on_aot_05
{
#if CHRIS
    run
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
    }
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_SCENARIO, F_SCENARIO_47, TRUE);
    }
#else
    run
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_56, TRUE);
        set(FG_SCENARIO, F_SCENARIO_47, TRUE);
    }
#endif
    sleep(20);
    run
    {
#if CHRIS
        if (ck(FG_COMMON, F_COMMON_24, TRUE))
        {
            evt_exec(0, TASK_09, on_aot_05_sub3);
        }
        else if (ck(FG_COMMON, F_COMMON_63, TRUE))
        {
            evt_exec(0, TASK_09, on_aot_05_sub1);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_05_sub2);
        }
#else
        if (ck(FG_COMMON, F_COMMON_07, TRUE))
        {
            evt_exec(0, TASK_09, on_aot_05_sub2);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_05_sub1);
        }
#endif
    }
    evt_finish();
}

#endif
