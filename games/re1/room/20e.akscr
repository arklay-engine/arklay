event on_aot_05_sub3_sub1
{
    run
    {
        cut_auto(1);
        bgm_play(0);
    }
    evt_fork(9, on_aot_05_sub3_sub1_sub1, 0);
    sleep(80);
    voice_play(VOICE_PLAY, VO_A06_00, 0);
    sleep(15);
    message(MSG_VO_A06_00, 0);
    evt_fork(9, on_aot_05_sub3_sub1_sub2, 0);
    for (3)
    {
        evt_fork(9, on_aot_05_sub3_sub1_sub4, 0);
        sleep(30);
    }
    evt_nop();
    evt_fork(9, on_aot_05_sub3_sub1_sub3, 0);
    sleep(25);
    evt_fork(9, on_aot_05_sub3_sub1_sub7, 0);
    sleep(10);
    evt_fork(9, on_aot_05_sub3_sub1_sub5, 0);
    sleep(33);
    run
    {
        se_play_3d(2, 44, 0, SND_AT_PLAYER, 0, 0, 0);
        bgm_stop(0);
    }
    sleep(140);
    run
    {
        se_play_3d(0, 1, 0, SND_AT_POINT, 0, 500, 2500);
    }
    sleep(20);
    evt_fork(9, on_aot_05_sub3_sub1_sub8, 0);
    evt_fork(9, on_aot_05_sub3_sub1_sub6, 0);
    sleep(100);
    wait_message();
    run
    {
        set(FG_COMMON, F_COMMON_27, TRUE);
        set(FG_COMMON, F_COMMON_5E, TRUE);
        sys_multi(8, 544);
        cut_auto(0);
        aot_on(AOT_03_DOOR, SCE_DOOR, 0);
    }
    evt_finish();
}

