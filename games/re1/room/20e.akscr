event on_aot_05_sub3
{
    evt_fork(TASK_09, on_aot_05_sub1_sub1, 0);
    sleep(20);
    run
    {
        if (ck(FG_COMMON, F_COMMON_22, TRUE))
        {
            evt_exec(0, TASK_09, on_aot_05_sub3_sub1);
        }
        else
        {
            evt_exec(0, TASK_09, on_aot_05_sub3_sub2);
        }
    }
    evt_finish();
}

event on_aot_05_sub3_sub1
{
    run
    {
        cut_auto(CUT_LOCKED);
        bgm_play(BGM_MAIN);
    }
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub1, 0);
    sleep(80);
    voice_play(VOICE_PLAY, VO_A06_00);
    sleep(15);
    message(MSG_VO_A06_00, 0);
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub2, 0);
    for (3)
    {
        evt_fork(TASK_09, on_aot_05_sub3_sub1_sub4, 0);
        sleep(30);
    }
    evt_nop();
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub3, 0);
    sleep(25);
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub7, 0);
    sleep(10);
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub5, 0);
    sleep(33);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_2C_TAORE_ST, 0, SND_AT_PLAYER, 0, 0, 0);
        bgm_stop(BGM_MAIN);
    }
    sleep(140);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 500, 2500);
    }
    sleep(20);
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub8, 0);
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub6, 0);
    sleep(100);
    wait_message();
    run
    {
        set(FG_COMMON, F_COMMON_27, TRUE);
        set(FG_COMMON, F_COMMON_5E, TRUE);
        sys_multi(SYS_HEALTH_STATUS, SYS_XOR | HS_20);
        cut_auto(CUT_FREE);
        aot_on(AOT_03_DOOR, SCE_DOOR, 0);
    }
    evt_finish();
}

event on_aot_05_sub3_sub2
{
    run
    {
        pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
    }
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub1, 0);
    sleep(80);
    bgm_play(BGM_MAIN);
    evt_fork(TASK_09, on_aot_05_sub3_sub2_sub5, 0);
    sleep(20);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 500, 2500);
    }
    sleep(30);
    cutnext(CAM_00);
    evt_fork(TASK_09, on_aot_05_sub3_sub2_sub6, 0);
    sleep(5);
    voice_play(VOICE_PLAY, VO_008_10);
    sleep(15);
    message(MSG_VO_008_10, 0);
    evt_fork(TASK_09, on_aot_05_sub3_sub2_sub1, 0);
    wait_message();
    voice_play(VOICE_PLAY, VO_A06_00);
    sleep(15);
    message(MSG_VO_A06_00, 0);
    evt_fork(TASK_09, on_aot_05_sub3_sub1_sub2, 0);
    for (3)
    {
        evt_fork(TASK_09, on_aot_05_sub3_sub1_sub4, 0);
        sleep(48);
    }
    evt_nop();
    wait_message();
    voice_play(VOICE_PLAY, VO_008_11);
    sleep(15);
    message(MSG_VO_008_11, 0);
    evt_fork(TASK_09, on_aot_05_sub3_sub2_sub2, 0);
    sleep(80);
    message(3, 0);
    evt_fork(TASK_09, on_aot_05_sub3_sub2_sub3, 0);
    sleep(61);
    evt_fork(TASK_09, on_aot_05_sub3_sub2_sub4, 0);
    sleep(25);
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_COMMON, F_COMMON_2E, TRUE);
        set(FG_COMMON, F_COMMON_5F, TRUE);
        set(FG_COMMON, F_COMMON_59, TRUE);
        setb(B_CHARACTER_MODEL, 3, 0);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        setw(W_04, 0);
        aot_on(AOT_00_DOOR, SCE_DOOR, 0);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event on_enter
{
    sleep(1);
    run
    {
        pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
    }
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(20);
    evt_chain(7);
    evt_finish();
}

