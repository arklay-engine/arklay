    door_aot_set(3, 0, 0, 1, 1, 5, 3, 0, 64, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, 129);
    aot_set(4, 6600, 2600, 1900, 2400, SCE_5, 129, 0, 0, 0, 0, 0, 0);
#endif
}
