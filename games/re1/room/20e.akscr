    enemy(ENEMY_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 0, 0, 0, 0);
#endif
    if (ck(FG_COMMON, FLAG_COMMON_43, FALSE))
    {
        room_bgm_state_set(1, 14, 255);
#if CHRIS
        enemy(ENEMY_00_ZOMBIE_GROUNDSKEEPER, 4, 88, 1, 2, 0, 0, 1024, 0, 0, 5300, 0, 5800, 1, 0, 0, 0);
#else
        enemy(ENEMY_00_ZOMBIE_GROUNDSKEEPER, 4, 88, 1, 2, 0, 0, 1024, 0, 0, 5300, 0, 5800, 0, 0, 0, 0);
#endif
    }
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_43, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_47, FALSE))
    {
        aot_set(5, 5460, 1700, 1300, 3100, SCE_EVENT, 65, 9, 0, event_00, 0, 0, 0);
        if (ck(FG_COMMON, FLAG_COMMON_24, TRUE))
        {
            room_bgm_state_set(1, 14, 64);
        }
        else if (ck(FG_COMMON, FLAG_COMMON_63, TRUE))
        {
            room_bgm_state_set(1, 14, 64);
        }
        else
        {
            room_bgm_state_set(1, 14, 65);
        }
    }
    if (ck(FG_COMMON, FLAG_COMMON_5F, TRUE) && ck(FG_COMMON, FLAG_COMMON_5E, FALSE))
    {
        room_bgm_state_set(1, 14, 66);
        dir_set(0, 0, 2448, 0, 5070, 0, 3100);
        plw_anim(0, 4, 27);
        pos_set(0, 0, 0, 0, 2260, 0, 3340);
        if (cmpw(0, 4, 3, 300))
        {
            if (cmpw(0, 4, 3, 200))
            {
                set(FG_COMMON, FLAG_COMMON_5D, TRUE);
            }
            evt_exec(0, 9, event_06);
        }
        else
        {
            evt_exec(0, 9, event_23);
        }
    }
    set(FG_COMMON, FLAG_COMMON_66, TRUE);
#else
    if (ck(FG_COMMON, FLAG_COMMON_43, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_47, FALSE) && ck(FG_COMMON, FLAG_COMMON_56, FALSE))
    {
        room_bgm_state_set(1, 14, 65);
        enemy(ENEMY_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 0, 0, 0, 0);
        aot_set(5, 5460, 1700, 1300, 3100, SCE_EVENT, 65, 9, 0, event_00, 0, 0, 0);
