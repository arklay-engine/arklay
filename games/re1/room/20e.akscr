#define VO_A07_00 0x0E

#if MANSION1
proc init
#else
proc init noreturn
#endif
{
    door_aot_set(AOT_00_DOOR, 500, 2500, 1700, 3800, 1, 0, 0, 1, 0, ROOM_20D_PILLAR_PASSAGE, 11500, 0, 3100, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 3200, 11400, 1700, 1600, 2, 0, 1, 4, 0, ROOM_20F_DINING, 4800, 0, 11600, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if MANSION1
    door_aot_set(AOT_02_DOOR, 9200, 2500, 1700, 1300, 2, 0, 7, 1, 135, ROOM_210_ATTIC, 6100, 0, 3600, 0, IT_35_KEY_MANSION_SHIELD, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    door_aot_set(AOT_03_DOOR, 0, 0, 1, 1, 5, 3, 0, 64, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#else
    door_aot_set(AOT_03_DOOR, 0, 0, 1, 1, 0, 0, 0, 4, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#endif
    aot_set(AOT_04_5, 6800, 2100, 1400, 1700, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
#if CHRIS
    enemy(EM_23_NPC_REBECCA, 0, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, ENEMY_00_NPC_REBECCA, 0, 0, 0);
#endif
    if (ck(FG_COMMON, F_COMMON_43, FALSE))
    {
        room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_OFF);
#if CHRIS
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 4, 88, 1, 2, 0, 0, 1024, 0, 0, 5300, 0, 5800, ENEMY_01_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
#else
        enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 4, 88, 1, 2, 0, 0, 1024, 0, 0, 5300, 0, 5800, ENEMY_00, 0, 0, 0);
#endif
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_43, TRUE) && ck(FG_SCENARIO, F_SCENARIO_47, FALSE))
    {
        aot_set(AOT_05_EVENT, 5460, 1700, 1300, 3100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_24, TRUE))
        {
            room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD);
        }
        else if (ck(FG_COMMON, F_COMMON_63, TRUE))
        {
            room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD);
        }
        else
        {
            room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 1);
        }
    }
    if (ck(FG_COMMON, F_COMMON_5F, TRUE) && ck(FG_COMMON, F_COMMON_5E, FALSE))
    {
        room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 2);
        dir_set(0, 0, 2448, 0, 5070, 0, 3100);
        plw_anim(0, 4, 27);
        pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
        if (cmpw(0, 4, CMP_LT, 300))
        {
            if (cmpw(0, 4, CMP_LT, 200))
            {
                set(FG_COMMON, F_COMMON_5D, TRUE);
            }
            evt_exec(0, 9, on_enter);
        }
        else
        {
            evt_exec(0, 9, on_enter_2);
        }
    }
    set(FG_COMMON, F_COMMON_66, TRUE);
#else
    if (ck(FG_COMMON, F_COMMON_43, TRUE) && ck(FG_SCENARIO, F_SCENARIO_47, FALSE) && ck(FG_COMMON, F_COMMON_56, FALSE))
    {
        room_bgm_state_set(1, ROOM_20E_FRONT_OF_ATTIC, BGM_RELOAD | 1);
        enemy(EM_22_NPC_BARRY, 0, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, ENEMY_00, 0, 0, 0);
        aot_set(AOT_05_EVENT, 5460, 1700, 1300, 3100, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
    }
#endif
#else
    door_aot_set(AOT_02_DOOR, 8900, 2500, 1700, 1300, 2, 0, 7, 1, 135, ROOM_210_ATTIC, 6100, 0, 3600, 0, IT_35_KEY_MANSION_SHIELD, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 0, 0, 1, 1, 5, 3, 0, 64, 0, STAGE_1 | ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_04_5, 6600, 2600, 1900, 2400, SCE_5, SAT_MANUAL | SAT_PLAYER, 0, 0, 0, 0, 0, 0);
#endif
}
#if MANSION1

proc main
{
    if (ck(FG_COMMON, F_COMMON_43, FALSE))
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
    }
}

event on_aot_05
{
#if CHRIS
    run
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
    }
    sleep(1);
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_SCENARIO, F_SCENARIO_47, TRUE);
    }
#else
    run
    {
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_56, TRUE);
        set(FG_SCENARIO, F_SCENARIO_47, TRUE);
    }
#endif
    sleep(20);
    run
    {
#if CHRIS
        if (ck(FG_COMMON, F_COMMON_24, TRUE))
        {
            evt_exec(0, 9, on_aot_05_sub3);
        }
        else if (ck(FG_COMMON, F_COMMON_63, TRUE))
        {
            evt_exec(0, 9, on_aot_05_sub1);
        }
        else
        {
            evt_exec(0, 9, on_aot_05_sub2);
        }
#else
        if (ck(FG_COMMON, F_COMMON_07, TRUE))
        {
            evt_exec(0, 9, on_aot_05_sub2);
        }
        else
        {
            evt_exec(0, 9, on_aot_05_sub1);
        }
#endif
    }
    evt_finish();
}

#endif
