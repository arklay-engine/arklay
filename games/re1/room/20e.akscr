        set(FG_6, F_6_17, TRUE);
    }
    evt_finish();
}

event on_enter
{
    sleep(1);
    run
    {
        pos_set(ENEMY_00_NPC_REBECCA, 0, 0, 0, 2260, 0, 3340);
    }
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(20);
    evt_chain(7);
    evt_finish();
}

