        inst_cfg(1, 6, 0, 184, 8, 58, 35, 233, 16, 208, 56);
        inst_cfg(3, 4, 0, 184, 8, 58, 35, 233, 16, 208, 56);
    }
    enemy(ENEMY_CERBERUS, 12, 48, 1, 2, 0, 0, 744, 0, 0, 23945, 0, 20792, 0, 0, 0, 0);
    enemy(ENEMY_CERBERUS, 12, 49, 1, 2, 0, 0, 1464, 0, 0, 29528, 0, 23029, 1, 0, 0, 0);
    if (ck(FG_STATUS, 8, 1))
    {
