    act_flag_op(0, 1, 0);
    sleep(15);
    act_anim_flags(32 | 17, 32 | 0, 0 | 0);
    act_flag_op(0, 144, 0);
    act_reset();
    evt_nop();
    sleep(60);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 0, 0 | 0);
    act_reset();
    evt_nop();
    sleep(15);
    voice_play(1, 38, 0);
    message(6, 0);
    sleep(10);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 0, 0 | 0);
    act_flag_op(0, 3, 0);
    sleep(15);
    act_anim_flags(32 | 17, 32 | 0, 0 | 0);
    act_flag_op(0, 144, 0);
    act_reset();
    evt_nop();
    wait_message();
    voice_play(1, 39, 0);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 18, 32 | 0, 0 | 0);
    sleep(15);
    act_anim_flags(32 | 19, 32 | 0, 0 | 0);
    act_flag_op(0, 144, 0);
    sleep(40);
    act_motion_path(113, 600, 0, 1, 120, 64);
    sleep(5);
    act_anim_flags(32 | 20, 32 | 0, 0 | 0);
    sleep(40);
    act_reset();
    evt_nop();
    sys_multi(4);
    sleep(40);
    wait_message();
    run
    {
        sys_multi(7);
        set(FG_6, 23, 0);
        set(FG_STATUS, 15, 1);
        set(FG_STATUS, 17, 0);
        aot_reset(3, SCE_NONE, 0, 0, 0, 0);
    }
    evt_finish();
}

event event_02
{
    message(137, 255);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (cmpb(5, 0, 0))
        {
            evt_exec(0, 3, event_03);
        }
    }
    evt_finish();
}

event event_03
{
    run
    {
        aot_reset(4, SCE_F, 129, 0, 0, 0);
        aot_on(4, SCE_F, 0);
    }
    evt_next();
    evt_nop();
    message(138, 255);
    evt_finish();
}

event event_04
{
    run
    {
        set(FG_6, 23, 1);
        sys_multi(1, 128);
        se_play_3d(2, 33, 0, 1, 0, 0, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    sleep(15);
    run
    {
        set(FG_6, 31, 1);
        evt_exec(0, 4, event_05);
        evt_exec(0, 5, event_06);
    }
    for (39)
    {
        spd_add(25);
        evt_next();
    }
    timer_setup(2, 128, 8, 7, 0);
    for (15)
    {
        spd_add(25);
        evt_next();
    }
    run
    {
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        set(FG_SCENARIO, 49, 1);
        setw(2, 0, 0);
        aot_on(1, SCE_DOOR, 129);
    }
    evt_finish();
}

event event_05
{
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_set_pos(0, 25, 0);
    for (54)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    evt_finish();
}

