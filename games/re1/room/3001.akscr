    item_aot_set(6, 25700, 1100, 1800, 1800, ITEM_GREEN_HERB, 1, 1, 255, 232, 103, 0, 0, 208, 7, 0, 0, 185, 129, 1, 0);
    item_aot_set(7, 26200, 1100, 1800, 1800, ITEM_GREEN_HERB, 1, 2, 255, 220, 105, 0, 0, 208, 7, 0, 0, 186, 129, 1, 0);
    item_aot_set(8, 26700, 1100, 1800, 1800, ITEM_GREEN_HERB, 1, 3, 255, 208, 107, 0, 0, 208, 7, 0, 0, 187, 129, 1, 0);
    item_aot_set(9, 29000, 1100, 1800, 1800, ITEM_RED_HERB, 1, 4, 255, 204, 116, 0, 0, 208, 7, 0, 0, 188, 129, 1, 0);
    item_aot_set(10, 29500, 1100, 1800, 1800, ITEM_RED_HERB, 1, 5, 255, 192, 118, 0, 0, 208, 7, 0, 0, 189, 129, 1, 0);
    item_aot_set(11, 22000, 8500, 2000, 1200, ITEM_BLUE_HERB, 1, 6, 255, 172, 88, 0, 0, 28, 37, 0, 0, 191, 129, 1, 0);
    item_aot_set(12, 22000, 8500, 2000, 1200, ITEM_BLUE_HERB, 1, 7, 255, 104, 91, 0, 0, 28, 37, 0, 0, 192, 129, 1, 0);
    if (ck(FG_SCENARIO, 49, 0))
    {
        if (cmpb(3, 0, 2))
