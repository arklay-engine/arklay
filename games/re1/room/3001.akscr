proc main
{
    if (ck(FG_STATUS, 8, 1))
    {
        if (ck(FG_ROOM, 0, 0) && ck(FG_ROOM, 1, 1))
        {
            if (ck(FG_ENEMY, 48, 0) && ck(FG_ENEMY, 49, 0) && ck(FG_ENEMY, 50, 0))
            {
                set(FG_ROOM, 1, 0);
                aot_reset(3, SCE_USEITEM, 65, 9, 63, 1);
                evt_exec(0, 0, event_00);
            }
        }
    }
    else if (ck(FG_ROOM, 0, 0) && ck(FG_ROOM, 1, 1))
    {
        if (ck(FG_ENEMY, 48, 0) && ck(FG_ENEMY, 49, 0))
        {
            set(FG_ROOM, 1, 0);
            aot_reset(3, SCE_USEITEM, 65, 9, 63, 1);
            evt_exec(0, 0, event_00);
        }
    }
    if (testitem(ITEM_4D))
    {
        aot_reset(5, SCE_NONE, 0, 0, 0, 0);
        evt_exec(0, 1, event_01);
    }
    if (cmpb(2, 0, 0))
    {
        snd_pan_vol_set(1, 30, 30);
    }
    if (cmpb(2, 0, 1))
    {
        snd_pan_vol_set(1, 30, 30);
    }
    if (cmpb(2, 0, 2))
    {
        snd_pan_vol_set(1, 45, 30);
    }
    if (cmpb(2, 0, 3))
    {
        snd_pan_vol_set(1, 30, 30);
    }
    if (cmpb(2, 0, 4))
    {
        snd_pan_vol_set(1, 30, 30);
    }
    if (cmpb(2, 0, 5))
    {
        snd_pan_vol_set(1, 30, 30);
    }
    if (cmpb(2, 0, 6))
    {
        snd_pan_vol_set(1, 30, 35);
    }
}

event event_00
{
    sleep(30);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(180);
    se_play_3d(2, 23, 0, 1, 0, 0, 0);
    sleep(480);
    aot_reset(3, SCE_NONE, 0, 0, 0, 0);
    evt_finish();
}

