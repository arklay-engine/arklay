event event_07
{
    evt_next();
    evt_nop();
    run
    {
        set(FG_6, 23, 1);
        sys_multi(1, 128);
    }
    se_play_3d(2, 34, 0, 1, 0, 0, 0);
    run
    {
        evt_exec(0, 1, event_08);
        evt_exec(0, 2, event_09);
    }
    setw(2, 128, 247);
    sleep(130);
    run
    {
        set(FG_6, 23, 0);
        set(FG_6, 29, 0);
        setw(2, 0, 0);
        setw(1, 0, 0);
        sys_multi(7);
    }
    evt_finish();
}

event event_08
{
    for (100)
    {
        spd_add(231);
        evt_work_set(WK_PLAYER, 0);
        evt_tween_begin_alt();
        tw_set_pos(0, 231, 0);
        tw_pos_add();
        evt_next();
        tw_end();
        evt_nop();
    }
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3200, 0, 12000);
    tw_end();
    evt_nop();
    evt_finish();
}

event event_09
{
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    tw_abs_pos(0, 2946, 2500, 11736);
    tw_set_pos(0, 231, 0);
    for (100)
    {
        tw_pos_add();
        evt_next();
    }
    tw_nop();
    tw_abs_pos(0, 2946, 0, 11736);
    tw_end();
    evt_nop();
    evt_finish();
}
