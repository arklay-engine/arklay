#version 1

proc init
{
    set(FG_STATUS, 61, 0);
    door_aot_set(0, 0, 0, 1, 1, 0, 10, 16, 64, 0, RDT_013, 16000, 0, 7600, 0, UNLOCKED, 129);
    door_aot_set(1, 0, 0, 1, 1, 0, 10, 16, 64, 0, RDT_01C, 19600, 0, 6800, 0, UNLOCKED, 129);
    dir_set(0, 0, 0, 0, 2500, 0, 3300);
    if (cmpb(3, 0, 19))
    {
        evt_exec(0, 9, event_00);
    }
    else
    {
        evt_exec(0, 9, event_01);
    }
}

event event_00
{
    sleep(1);
    set(FG_6, 23, 1);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 24, 1));
    run
    {
        set(FG_6, 23, 0);
        aot_on(1, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_01
{
    sleep(1);
    set(FG_6, 23, 1);
    evt_fork(9, event_02, 0);
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, 24, 1));
    run
    {
        set(FG_6, 23, 0);
        aot_on(0, SCE_DOOR, 0);
    }
    evt_finish();
}

event event_02
{
    bgm_play(0);
    sleep(5);
    set(FG_STATUS, 62, 0);
    sleep(10);
    set(FG_STATUS, 62, 1);
    sleep(150);
    set(FG_STATUS, 62, 0);
    sleep(40);
    set(FG_STATUS, 62, 1);
    sleep(30);
    set(FG_ROOM, 24, 0);
    evt_finish();
}
