    act_anim_flags(32 | 3, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_anim_flags(32 | 9, 32 | 1, 0 | 0);
#else
    act_motion_path(114, 0, 300, 1, 0, 30);
#endif
    act_reset();
    evt_nop();
    wait_message();
    run
    {
        cutnext(6);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#if CHRIS
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_anim_seq(46082, 32778, 8304);
    act_nop();
#else
    act_anim_flags(32 | 14, 32 | 1, 0 | 0);
    act_param_set(0, 4);
    act_flag_op(1, 2, 0);
#endif
    act_reset();
    evt_nop();
#if CHRIS
    evt_work_set(WK_ENEMY, 1);
#else
    sleep(16);
    evt_work_set(WK_PLAYER, 0);
#endif
    evt_actor_begin();
#if CHRIS
    act_anim_flags(32 | 6, 32 | 0, 0 | 1);
#else
    act_anim_seq(46082, 32778, 8304);
    act_nop();
#endif
    act_reset();
    evt_nop();
#if CHRIS
    sleep(50);
#else
    sleep(25);
#endif
    run
    {
        cut_auto(0);
        set(FG_6, FLAG_6_17, TRUE);
        aot_on(AOT_01_DOOR, SCE_DOOR, 0);
#if CHRIS
        setb(9, 0, 0);
#else
        setb(9, 1, 0);
#endif
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

event on_enter
{
    sleep(5);
    run
    {
        eml_state(0, 0, 8);
    }
    evt_finish();
}
