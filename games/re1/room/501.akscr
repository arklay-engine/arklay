#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_USEITEM 0x04
#define AOT_05_EVENT 0x05
#define AOT_06_EVENT 0x06

proc init
{
    door_aot_set(AOT_00_DOOR, 30200, 2500, 2700, 2100, 12, 1, 11, 3, 0, ROOM_500_UNDER_FOUNTAIN, 2500, 0, 9500, 0, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 0, 26600, 2900, 29400, 0, 13, 17, 64, 0, ROOM_50D_ESCAPE_ELEVATOR, 4600, 0, 4600, 0, UNLOCKED, 129);
    item_aot_set(AOT_02_ITEM, 7700, 28150, 1000, 1000, ITEM_27_PUZZLE_BATTERY, 1, 0, 255, 8, 32, 0, 0, 234, 111, 224, 6, 69, 129, 1, 0);
    item_aot_set(AOT_03_ITEM, 0, 0, 1, 1, ITEM_27_PUZZLE_BATTERY, 1, 1, 255, 0, 0, 0, 0, 0, 0, 0, 4, 70, 129, 0, 0);
    if (ck(FG_COMMON, FLAG_COMMON_46, FALSE))
    {
        aot_set(AOT_04_USEITEM, 3000, 29700, 2000, 1000, SCE_USEITEM, 1, 9, 0, 12, 0, 1, 0);
        aot_set(AOT_05_EVENT, 3000, 29700, 2000, 1000, SCE_EVENT, 129, 9, 0, on_aot_05, 0, 0, 0);
        aot_reset(AOT_01_DOOR, SCE_MESSAGE, 129, 9, 255, 0);
    }
    if (ck(FG_COMMON, FLAG_COMMON_45, FALSE))
    {
        aot_set(AOT_06_EVENT, 12500, 7500, 14500, 2000, SCE_EVENT, 65, 9, 0, on_aot_06, 0, 0, 0);
    }
    if (ck(FG_COMMON, FLAG_COMMON_4B, TRUE))
    {
#if CHRIS
        enemy(ENEMY_21_NPC_JILL, 2, 255, 1, 2, 0, 0, 448, 0, 0, 26600, 0, 4300, 0, 0, 0, 0);
#else
        enemy(ENEMY_20_NPC_CHRIS, 2, 255, 1, 2, 0, 0, 448, 0, 0, 26600, 0, 4300, 0, 0, 0, 0);
#endif
        evt_exec(0, 9, on_enter);
    }
    if (ck(FG_COMMON, FLAG_COMMON_C0, FALSE))
    {
#if CHRIS
        enemy(ENEMY_23_NPC_REBECCA, 2, 255, 1, 2, 0, 0, 0, 0, 0, 30000, 30000, 30000, 1, 0, 0, 0);
#else
        enemy(ENEMY_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 3616, 0, 0, 26950, 0, 2500, 1, 0, 0, 0);
        evt_exec(0, 9, on_enter_2);
#endif
    }
#if JILL
    set(FG_COMMON, FLAG_COMMON_51, TRUE);
#endif
}

proc main
{
    if (testitem(ITEM_27_PUZZLE_BATTERY))
    {
#if CHRIS
        aot_delete(AOT_04_USEITEM, SCE_NONE, 0);
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
#else
        aot_delete(AOT_04_USEITEM, SCE_NONE, 1);
        aot_delete(AOT_05_EVENT, SCE_NONE, 129);
#endif
        evt_exec(0, 9, from_main);
    }
}

event on_aot_06
{
#if CHRIS
    run
    {
        aot_delete(AOT_06_EVENT, SCE_NONE, 0);
        set(FG_COMMON, FLAG_COMMON_45, TRUE);
    }
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(30);
#else
    run
    {
        aot_delete(AOT_06_EVENT, SCE_NONE, 0);
        set(FG_COMMON, FLAG_COMMON_45, TRUE);
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(1);
#endif
    run
    {
#if CHRIS
        voice_play(1, 23, 0);
        message(8, 0);
#else
        voice_play(1, 20, 0);
        message(0, 0);
#endif
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 300, 0, 0, 40);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(114, 0, 300, 1, 0, 40);
    act_reset();
    evt_nop();
#if CHRIS
    sleep(40);
#else
    sleep(30);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(50, 0, 300, 0, 0, 40);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(16);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
#if CHRIS
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#endif
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}

event on_aot_05
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        cutnext(7);
    }
    sleep(20);
#if CHRIS
    message(129, 0); // "The battery is pulled out."
#else
    message(1, 0); // "The battery is pulled out."
#endif
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        cutnext(6);
        cut_auto(0);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}

event from_main
{
#if CHRIS
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        cutnext(7);
    }
    sleep(40);
#else
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        set(FG_COMMON, FLAG_COMMON_46, TRUE);
    }
    sleep(20);
    run
    {
        cutnext(7);
    }
    sleep(20);
#endif
    evt_work_set(WK_AOT, 1);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3870, -1800, 30780);
    tw_end();
    evt_nop();
    sleep(1);
    run
    {
        se_play_3d(2, 24, 0, 0, 0, 3870, 30780);
    }
    sleep(20);
    run
    {
        cutnext(5);
#if CHRIS
        if (ck(FG_COMMON, FLAG_COMMON_4B, FALSE) && ck(FG_COMMON, FLAG_COMMON_C0, TRUE))
        {
            evt_exec(0, 9, from_main_sub1);
        }
#endif
        if (ck(FG_COMMON, FLAG_COMMON_4B, TRUE) && ck(FG_COMMON, FLAG_COMMON_C0, FALSE))
        {
            evt_exec(0, 9, from_main_sub2);
        }
        if (ck(FG_COMMON, FLAG_COMMON_4B, TRUE) && ck(FG_COMMON, FLAG_COMMON_C0, TRUE))
        {
            evt_exec(0, 9, from_main_sub3);
        }
#if CHRIS
        if (ck(FG_COMMON, FLAG_COMMON_4B, FALSE) && ck(FG_COMMON, FLAG_COMMON_C0, FALSE))
        {
            evt_exec(0, 9, from_main_sub4);
        }
#else
        if (ck(FG_COMMON, FLAG_COMMON_4B, FALSE) && ck(FG_COMMON, FLAG_COMMON_C0, FALSE))
        {
            evt_exec(0, 9, from_main_sub4);
        }
        if (ck(FG_COMMON, FLAG_COMMON_4B, FALSE) && ck(FG_COMMON, FLAG_COMMON_C0, TRUE))
        {
            evt_exec(0, 9, from_main_sub1);
        }
#endif
    }
    evt_finish();
}

event from_main_sub1
{
    run
    {
        cutnext(6);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        dir_set(0, 0, 2400, 0, 4370, 0, 29960);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 1, 0 | 0);
    act_param_set(0, 252);
    act_flag_op(1, 2, 0);
    act_reset();
    evt_nop();
    sleep(16);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(46082, 32778, 8304);
    act_nop();
    act_reset();
    evt_nop();
    sleep(25);
    run
    {
        cut_auto(0);
#if CHRIS
        setb(9, 0, 0);
#else
        setb(9, 1, 0);
#endif
        set(FG_6, FLAG_6_17, TRUE);
        aot_on(AOT_01_DOOR, SCE_DOOR, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

