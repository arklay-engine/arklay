#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_ITEM 0x02
#define AOT_03_ITEM 0x03
#define AOT_04_USEITEM 0x04
#define AOT_05_EVENT 0x05
#define AOT_06_EVENT 0x06
#define CAM_05 0x05
#define CAM_06 0x06
#define CAM_07 0x07
#define ENEMY_00_NPC_CHRIS 0x00
#define ENEMY_00_NPC_JILL 0x00
#define ENEMY_01_NPC_BARRY 0x01
#define ENEMY_01_NPC_REBECCA 0x01
#define F_ROOM_20 0x20
#define F_ROOM_21 0x21
#define F_ROOM_22 0x22
#define F_ROOM_23 0x23
#define IMDL_00 0x00
#define IMDL_01 0x01
#define MSG_THE_BATTERY_IS_PULLED_OUT 0x01
#define MSG_VO_016_00 0x08
#define MSG_VO_016_01 0x04
#define MSG_VO_016_02 0x05
#define MSG_VO_016_03 0x06
#define MSG_VO_016_04 0x07
#define MSG_VO_016_06 0x0A
#define MSG_VO_11B_00 0x00
#define MSG_VO_11B_01 0x02
#define MSG_VO_11B_02 0x03
#define SE_17_HUNTER 0x17
#define SE_18_BATTERY 0x18
#define VO_016_00 0x17
#define VO_016_01 0x18
#define VO_016_02 0x19
#define VO_016_03 0x1A
#define VO_016_04 0x1B
#define VO_016_06 0x52
#define VO_11B_00 0x14
#define VO_11B_01 0x15
#define VO_11B_02 0x16

proc init
{
    door_aot_set(AOT_00_DOOR, 30200, 2500, 2700, 2100, 12, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, 0, ROOM_500_UNDER_FOUNTAIN, 2500, 0, 9500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 0, 26600, 2900, 29400, 0, DOOR_SND_0D_EV_LAB, DOOR_11_ELE01, 64, 0, ROOM_50D_ESCAPE_ELEVATOR, 4600, 0, 4600, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    item_aot_set(AOT_02_ITEM, 7700, 28150, 1000, 1000, IT_27_KEY_BATTERY, 1, IMDL_00, SCA_NONE, 8200, 0, 28650, 1760, F_ITEM_45, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_03_ITEM, 0, 0, 1, 1, IT_27_KEY_BATTERY, 1, IMDL_01, SCA_NONE, 0, 0, 0, 1024, F_ITEM_46, SAT_MANUAL | SAT_PLAYER, 0);
    if (ck(FG_COMMON, F_COMMON_46, FALSE))
    {
        aot_set(AOT_04_USEITEM, 3000, 29700, 2000, 1000, SCE_USEITEM, SAT_PLAYER, 9, 0, 12, 0, 1, 0);
        aot_set(AOT_05_EVENT, 3000, 29700, 2000, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_05, 0, 0, 0);
        aot_reset(AOT_01_DOOR, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 9, 255, 0);
    }
    if (ck(FG_COMMON, F_COMMON_45, FALSE))
    {
        aot_set(AOT_06_EVENT, 12500, 7500, 14500, 2000, SCE_EVENT, SAT_UNDER | SAT_PLAYER, 9, 0, on_aot_06, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_4B, TRUE))
    {
#if CHRIS
        enemy(EM_21_NPC_JILL, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 448, 0, 26600, 0, 4300, ENEMY_00_NPC_JILL, ANIM_00, 0, EVAR_00);
#else
        enemy(EM_20_NPC_CHRIS, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 448, 0, 26600, 0, 4300, ENEMY_00_NPC_CHRIS, ANIM_00, 0, EVAR_00);
#endif
        evt_exec(0, TASK_09, on_enter);
    }
    if (ck(FG_COMMON, F_COMMON_C0, FALSE))
    {
#if CHRIS
        enemy(EM_23_NPC_REBECCA, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 30000, 30000, 30000, ENEMY_01_NPC_REBECCA, ANIM_00, 0, EVAR_00);
#else
        enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 3616, 0, 26950, 0, 2500, ENEMY_01_NPC_BARRY, ANIM_00, 0, EVAR_00);
        evt_exec(0, TASK_09, on_enter_2);
#endif
    }
#if JILL
    set(FG_COMMON, F_COMMON_51, TRUE);
#endif
}

proc main
{
    if (testitem(IT_27_KEY_BATTERY))
    {
#if CHRIS
        aot_delete(AOT_04_USEITEM, SCE_NONE, 0);
        aot_delete(AOT_05_EVENT, SCE_NONE, 0);
#else
        aot_delete(AOT_04_USEITEM, SCE_NONE, SAT_PLAYER);
        aot_delete(AOT_05_EVENT, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
#endif
        evt_exec(0, TASK_09, from_main);
    }
}

event on_aot_06
{
#if CHRIS
    run
    {
        aot_delete(AOT_06_EVENT, SCE_NONE, 0);
        set(FG_COMMON, F_COMMON_45, TRUE);
    }
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(30);
#else
    run
    {
        aot_delete(AOT_06_EVENT, SCE_NONE, 0);
        set(FG_COMMON, F_COMMON_45, TRUE);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(1);
#endif
    run
    {
#if CHRIS
        voice_play(VOICE_PLAY, VO_016_00);
        message(MSG_VO_016_00, 0);
#else
        voice_play(VOICE_PLAY, VO_11B_00);
        message(MSG_VO_11B_00, 0);
#endif
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 300, 0, 0, 40);
    act_reset();
    evt_nop();
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_72, 0, 300, 1, 0, 40);
    act_reset();
    evt_nop();
#if CHRIS
    sleep(40);
#else
    sleep(30);
#endif
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_32, 0, 300, 0, 0, 40);
    act_reset();
    evt_nop();
    wait_message();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
    act_nop();
#if CHRIS
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
#endif
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    run
    {
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event on_aot_05
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        cutnext(CAM_07);
    }
    sleep(20);
#if CHRIS
    message(MSG_THE_BATTERY_IS_PULLED_OUT | MSG_FAST, 0); // "The battery is pulled out."
#else
    message(MSG_THE_BATTERY_IS_PULLED_OUT, 0); // "The battery is pulled out."
#endif
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        cutnext(CAM_06);
        cut_auto(CUT_FREE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event from_main
{
#if CHRIS
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        cutnext(CAM_07);
    }
    sleep(40);
#else
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_46, TRUE);
    }
    sleep(20);
    run
    {
        cutnext(CAM_07);
    }
    sleep(20);
#endif
    evt_work_set(WK_AOT, IMDL_01);
    evt_tween_begin_alt();
    tw_abs_pos(0, 3870, -1800, 30780);
    tw_end();
    evt_nop();
    sleep(1);
    run
    {
        se_play_3d(SND_BANK_ROOM, SE_18_BATTERY, 0, SND_AT_POINT, 0, 3870, 30780);
    }
    sleep(20);
    run
    {
        cutnext(CAM_05);
#if CHRIS
        if (ck(FG_COMMON, F_COMMON_4B, FALSE) && ck(FG_COMMON, F_COMMON_C0, TRUE))
        {
            evt_exec(0, TASK_09, from_main_sub1);
        }
#endif
        if (ck(FG_COMMON, F_COMMON_4B, TRUE) && ck(FG_COMMON, F_COMMON_C0, FALSE))
        {
            evt_exec(0, TASK_09, from_main_sub2);
        }
        if (ck(FG_COMMON, F_COMMON_4B, TRUE) && ck(FG_COMMON, F_COMMON_C0, TRUE))
        {
            evt_exec(0, TASK_09, from_main_sub3);
        }
#if CHRIS
        if (ck(FG_COMMON, F_COMMON_4B, FALSE) && ck(FG_COMMON, F_COMMON_C0, FALSE))
        {
            evt_exec(0, TASK_09, from_main_sub4);
        }
#else
        if (ck(FG_COMMON, F_COMMON_4B, FALSE) && ck(FG_COMMON, F_COMMON_C0, FALSE))
        {
            evt_exec(0, TASK_09, from_main_sub4);
        }
        if (ck(FG_COMMON, F_COMMON_4B, FALSE) && ck(FG_COMMON, F_COMMON_C0, TRUE))
        {
            evt_exec(0, TASK_09, from_main_sub1);
        }
#endif
    }
    evt_finish();
}

event from_main_sub1
{
    run
    {
        cutnext(CAM_06);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        dir_set(0, 0, 2400, 0, 4370, 0, 29960);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2D, F_ROOM_21, 0);
    act_param_set(0, 64512);
    act_flag_op(EF_SET, EF_0002);
    act_reset();
    evt_nop();
    sleep(16);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_seq(AB_02, 2740, 28800, F_ROOM_20);
    act_nop();
    act_reset();
    evt_nop();
    sleep(25);
    run
    {
        cut_auto(CUT_FREE);
#if CHRIS
        setb(B_CHARACTER_MODEL, 0, 0);
#else
        setb(B_CHARACTER_MODEL, 1, 0);
#endif
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        aot_on(AOT_01_DOOR, SCE_DOOR, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    evt_finish();
}

