#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_03_EVENT 0x03
#define FLAG_ROOM_20 0x20
#define FLAG_ROOM_21 0x21
#define FLAG_ROOM_22 0x22
#define FLAG_ROOM_23 0x23
#define FLAG_ROOM_24 0x24
#define FLAG_ROOM_25 0x25
#define FLAG_ROOM_26 0x26
#define FLAG_ROOM_27 0x27
#define FLAG_ROOM_28 0x28
#define FLAG_ROOM_29 0x29

proc init
{
    door_aot_set(AOT_00_DOOR, 16800, 26400, 2200, 2200, 3, 0, 6, 4, 0, ROOM_211_TERRACE_PASSAGE, 3000, 0, 12000, 1024, UNLOCKED, 129);
#if CHRIS
    item_aot_set(AOT_01_ITEM, 23500, 19770, 1000, 1000, ITEM_0B_AMMO_HANDGUN, 15, 0, 255, 192, 93, 0, 0, 46, 79, 6, 6, 6, 129, 1, 0);
#if MANSION1
    if (ck(FG_COMMON, FLAG_COMMON_42, FALSE))
    {
        aot_set(AOT_03_EVENT, 22600, 18000, 2900, 2250, SCE_EVENT, 129, 9, 0, on_aot_03, 0, 0, 0);
    }
#endif
#else
    item_aot_set(AOT_01_ITEM, 23500, 19770, 1000, 1000, ITEM_07_WEAPON_GRENADE_LAUNCHER_ACID, 6, 0, 255, 192, 93, 0, 0, 46, 79, 6, 6, 6, 129, 1, 0);
#endif
#if MANSION1
    enemy(ENEMY_26_NPC_FORREST, 0, 255, 1, 2, 0, 0, 1936, 0, 0, 25150, 0, 18700, 0, 0, 0, 0);
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_42, FALSE))
    {
        enemy(ENEMY_05_BIRD_CROW, 130, 255, 1, 2, 0, 0, 3000, 0, 0, 19000, -3000, 20000, 1, 0, 0, 0);
        enemy(ENEMY_05_BIRD_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19000, -4000, 20000, 2, 0, 0, 0);
        enemy(ENEMY_05_BIRD_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19000, -3500, 20000, 3, 0, 0, 0);
    }
    else
    {
        room_bgm_state_set(1, 18, 32);
        enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
        enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
        enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
    }
    evt_exec(0, 9, on_enter);
    evt_exec(0, 9, on_enter_2);
#else
    if (ck(FG_COMMON, FLAG_COMMON_07, FALSE) && ck(FG_COMMON, FLAG_COMMON_21, FALSE) && ck(FG_COMMON, FLAG_COMMON_4F, TRUE) && ck(FG_SCENARIO, FLAG_SCENARIO_67, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_5E, FALSE))
        {
            enemy(ENEMY_22_NPC_BARRY, 4, 255, 1, 2, 0, 0, 52, 0, 0, 22680, 0, 26170, 1, 0, 0, 0);
            if (ck(FG_COMMON, FLAG_COMMON_5F, FALSE))
            {
                set(FG_COMMON, FLAG_COMMON_5F, TRUE);
                evt_exec(0, 9, on_enter_2);
            }
            else
            {
                room_bgm_state_set(1, 18, 32);
                pos_set(1, 0, 900, 0, 24000, 0, 21000);
                evt_exec(0, 9, on_enter);
                aot_set(AOT_03_EVENT, 23000, 20000, 2000, 2000, SCE_EVENT, 129, 9, 0, on_aot_03_2, 0, 0, 0);
            }
        }
        else
        {
            room_bgm_state_set(1, 18, 32);
            evt_exec(0, 9, on_enter_3);
            evt_exec(0, 9, on_enter_4);
            room_bgm_state_set(1, 18, 32);
            enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
            enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
            enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
        }
    }
    else
    {
        set(FG_SCENARIO, FLAG_SCENARIO_67, TRUE);
        evt_exec(0, 9, on_enter_3);
        evt_exec(0, 9, on_enter_4);
        if (ck(FG_COMMON, FLAG_COMMON_5E, FALSE))
        {
            enemy(ENEMY_05_BIRD_CROW, 130, 255, 1, 2, 0, 0, 3000, 0, 0, 19000, -3000, 20000, 1, 0, 0, 0);
            enemy(ENEMY_05_BIRD_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19100, -4000, 21000, 2, 0, 0, 0);
            enemy(ENEMY_05_BIRD_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19200, -3500, 20000, 3, 0, 0, 0);
            aot_set(AOT_03_EVENT, 22600, 18000, 2900, 2250, SCE_EVENT, 129, 9, 0, on_aot_03, 0, 0, 0);
        }
        else
        {
            room_bgm_state_set(1, 18, 32);
            enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
            enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
            enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
        }
    }
#endif
#else
    room_bgm_state_set(1, 18, 32);
    enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
    enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
    enemy(ENEMY_05_BIRD_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
    evt_exec(0, 9, on_enter);
    evt_exec(0, 9, on_enter_2);
#endif
}

#if MANSION1
event on_aot_03
{
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        bgm_stop(0);
    }
#if CHRIS
    sleep(1);
#else
    sleep(2);
#endif
    run
    {
        set(FG_COMMON, FLAG_COMMON_42, TRUE);
#if JILL
        set(FG_COMMON, FLAG_COMMON_5E, TRUE);
#endif
        aot_reset(AOT_03_EVENT, SCE_NONE, 0, 0, 0, 0);
        cutnext(3);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 31, 0 | 3);
    act_reset();
    evt_nop();
    sleep(30);
    run
    {
        bgm_play(1);
    }
    message(143, 0); // "It's Forest...! He's been pecked to death by crows."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    evt_fork(9, on_aot_03_sub1, 0);
    evt_fork(9, on_aot_03_sub2, 0);
    evt_fork(9, on_aot_03_sub3, 0);
    cutnext(4);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    sleep(20);
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        cutnext(2);
        cut_auto(0);
    }
    evt_finish();
}

event event_01
{
    evt_finish();
}

#if JILL
event on_aot_03_2
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(20);
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_motion_path(113, 400, 0, 2, 40, 0);
    act_reset();
    evt_nop();
    sleep(20);
    run
    {
        voice_play(1, 10, 0);
        message(13, 0);
    }
    wait_message();
    run
    {
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
    }
    evt_finish();
}

event on_enter
{
    sleep(1);
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 0, 0 | 3);
    act_reset();
    evt_nop();
    evt_finish();
}

event event_04
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
    }
    sleep(20);
    message(14, 0); // "Forest..."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        set(FG_6, FLAG_6_17, TRUE);
    }
    evt_finish();
}

event on_enter_2
{
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
        set(FG_COMMON, FLAG_COMMON_42, TRUE);
        set(FG_COMMON, FLAG_COMMON_0A, TRUE);
    }
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_anim_flags(32 | 15, 32 | 1, 0 | 3);
    act_param_set(0, 8);
    act_flag_op(1, 2, 0);
    act_reset();
    evt_nop();
    sleep(21);
    evt_chain(6);
    evt_finish();
}

