#define AOT_00_DOOR 0x00
#define AOT_01_ITEM 0x01
#define AOT_03_EVENT 0x03
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define ENEMY_00_NPC_FORREST 0x00
#define ENEMY_01 0x01
#define ENEMY_01_CROW 0x01
#define ENEMY_02_CROW 0x02
#define ENEMY_03_CROW 0x03
#define F_ROOM_20 0x20
#define F_ROOM_21 0x21
#define F_ROOM_22 0x22
#define F_ROOM_23 0x23
#define F_ROOM_24 0x24
#define F_ROOM_25 0x25
#define F_ROOM_26 0x26
#define F_ROOM_27 0x27
#define F_ROOM_28 0x28
#define F_ROOM_29 0x29
#define F_ROOM_3F 0x3F
#define IMDL_00 0x00
#define MSG_FOREST 0x0E
#define MSG_IT_IS_FOREST 0x0F
#define MSG_VO_104_00 0x00
#define MSG_VO_104_01 0x01
#define MSG_VO_104_02 0x02
#define MSG_VO_104_03 0x04
#define MSG_VO_104_04 0x05
#define MSG_VO_104_05 0x06
#define MSG_VO_104_06 0x07
#define MSG_VO_104_07 0x09
#define MSG_VO_104_09 0x0B
#define MSG_VO_104_0A 0x0D
#define SE_17 0x17
#define SE_18_RVPATA 0x18
#define SE_19_RVPATB 0x19
#define VO_104_00 0x00
#define VO_104_01 0x01
#define VO_104_02 0x02
#define VO_104_03 0x03
#define VO_104_04 0x04
#define VO_104_05 0x05
#define VO_104_06 0x06
#define VO_104_07 0x07
#define VO_104_08 0x08
#define VO_104_09 0x09
#define VO_104_0A 0x0A

proc init
{
    door_aot_set(AOT_00_DOOR, 16800, 26400, 2200, 2200, 3, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 4, 0, ROOM_211_TERRACE_PASSAGE, 3000, 0, 12000, 1024, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if CHRIS
    item_aot_set(AOT_01_ITEM, 23500, 19770, 1000, 1000, IT_0B_AMMO_HANDGUN, 15, IMDL_00, SCA_NONE, 24000, 0, 20270, 1542, F_ITEM_06, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
#if MANSION1
    if (ck(FG_COMMON, F_COMMON_42, FALSE))
    {
        aot_set(AOT_03_EVENT, 22600, 18000, 2900, 2250, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
    }
#endif
#else
    item_aot_set(AOT_01_ITEM, 23500, 19770, 1000, 1000, IT_07_WEAPON_GL_ACID, 6, IMDL_00, SCA_NONE, 24000, 0, 20270, 1542, F_ITEM_06, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
#endif
#if MANSION1
    enemy(EM_26_NPC_FORREST, EB_00, NO_FLAG, SPAWN_FORCE, 2, 0, 1936, 0, 25150, 0, 18700, ENEMY_00_NPC_FORREST, ANIM_00, 0, EVAR_00);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_42, FALSE))
    {
        enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 3000, 0, 19000, -3000, 20000, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19000, -4000, 20000, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19000, -3500, 20000, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
    }
    else
    {
        room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
        enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
        enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
    }
    evt_exec(0, TASK_09, on_enter);
    evt_exec(0, TASK_09, on_enter_2);
#else
    if (ck(FG_COMMON, F_COMMON_07, FALSE) && ck(FG_COMMON, F_COMMON_21, FALSE) && ck(FG_COMMON, F_COMMON_4F, TRUE) && ck(FG_SCENARIO, F_SCENARIO_67, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_5E, FALSE))
        {
            enemy(EM_22_NPC_BARRY, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 52, 0, 22680, 0, 26170, ENEMY_01, ANIM_00, 0, EVAR_00);
            if (ck(FG_COMMON, F_COMMON_5F, FALSE))
            {
                set(FG_COMMON, F_COMMON_5F, TRUE);
                evt_exec(0, TASK_09, on_enter_2);
            }
            else
            {
                room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
                pos_set(ENEMY_01, 0, 900, 0, 24000, 0, 21000);
                evt_exec(0, TASK_09, on_enter);
                aot_set(AOT_03_EVENT, 23000, 20000, 2000, 2000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03_2, 0, 0, 0);
            }
        }
        else
        {
            room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
            evt_exec(0, TASK_09, on_enter_3);
            evt_exec(0, TASK_09, on_enter_4);
            room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
            enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01, ANIM_00, 0, EVAR_00);
            enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
            enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
        }
    }
    else
    {
        set(FG_SCENARIO, F_SCENARIO_67, TRUE);
        evt_exec(0, TASK_09, on_enter_3);
        evt_exec(0, TASK_09, on_enter_4);
        if (ck(FG_COMMON, F_COMMON_5E, FALSE))
        {
            enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 3000, 0, 19000, -3000, 20000, ENEMY_01, ANIM_00, 0, EVAR_00);
            enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19100, -4000, 21000, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
            enemy(EM_05_CROW, EB_82, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 19200, -3500, 20000, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
            aot_set(AOT_03_EVENT, 22600, 18000, 2900, 2250, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_03, 0, 0, 0);
        }
        else
        {
            room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
            enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01, ANIM_00, 0, EVAR_00);
            enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
            enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
        }
    }
#endif
#else
    room_bgm_state_set(1, ROOM_212_TERRACE, BGM_SUB_2_ON);
    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 24000, -2000, 17800, ENEMY_01_CROW, ANIM_00, 0, EVAR_00);
    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 21400, ENEMY_02_CROW, ANIM_00, 0, EVAR_00);
    enemy(EM_05_CROW, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 22460, -2000, 18020, ENEMY_03_CROW, ANIM_00, 0, EVAR_00);
    evt_exec(0, TASK_09, on_enter);
    evt_exec(0, TASK_09, on_enter_2);
#endif
}

#if MANSION1
event on_aot_03
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        bgm_stop(BGM_MAIN);
    }
#if CHRIS
    sleep(1);
#else
    sleep(2);
#endif
    run
    {
        set(FG_COMMON, F_COMMON_42, TRUE);
#if JILL
        set(FG_COMMON, F_COMMON_5E, TRUE);
#endif
        aot_reset(AOT_03_EVENT, SCE_NONE, 0, 0, 0, 0);
        cutnext(CAM_03);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_3F, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    sleep(30);
    run
    {
        bgm_play(BGM_SUB_1);
    }
    message(MSG_IT_IS_FOREST | MSG_FAST, 0); // "It's Forest...! He's been pecked to death by crows."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_3F, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0001);
    act_reset();
    evt_nop();
    sleep(30);
    evt_fork(TASK_09, on_aot_03_sub1, 0);
    evt_fork(TASK_09, on_aot_03_sub2, 0);
    evt_fork(TASK_09, on_aot_03_sub3, 0);
    cutnext(CAM_04);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_STATUS, F_STATUS_0F, FALSE);
    sleep(20);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cutnext(CAM_02);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}

event event_01
{
    evt_finish();
}

#if JILL
event on_aot_03_2
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(20);
    evt_work_set(WK_ENEMY, ENEMY_01);
    evt_actor_begin();
    act_motion_path(MOTION_71, 400, 0, 2, 40, 0);
    act_reset();
    evt_nop();
    sleep(20);
    run
    {
        voice_play(VOICE_PLAY, VO_104_0A);
        message(MSG_VO_104_0A, 0);
    }
    wait_message();
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    evt_finish();
}

event on_enter
{
    sleep(1);
    evt_work_set(WK_ENEMY, ENEMY_01);
    evt_actor_begin();
    act_anim_flags(ANIM_09, F_ROOM_20, AFL_02 | AFL_01);
    act_reset();
    evt_nop();
    evt_finish();
}

event event_04
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
    }
    sleep(20);
    message(MSG_FOREST, 0); // "Forest..."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event on_enter_2
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_42, TRUE);
        set(FG_COMMON, F_COMMON_0A, TRUE);
    }
    evt_work_set(WK_ENEMY, ENEMY_01);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_21, AFL_02 | AFL_01);
    act_param_set(0, 2048);
    act_flag_op(EF_SET, EF_0002);
    act_reset();
    evt_nop();
    sleep(21);
    evt_chain(6);
    evt_finish();
}

