#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_213 0x00
#define AOT_01_ITEM_AMMO_GRENADE_EXPLOSIVE_1 0x01
#define AOT_01_ITEM_AMMO_SHOTGUN_1 0x01
#define AOT_02_ITEM_AMMO_GRENADE_EXPLOSIVE_2 0x02
#define AOT_02_ITEM_AMMO_SHOTGUN_2 0x02
#define AOT_03_ITEM_KEY_BATTERY_0 0x03
#define AOT_04_EVENT_BATTERY 0x04
#define IMDL_00_KEY_BATTERY 0x00
#define IMDL_01_AMMO_GRENADE_EXPLOSIVE 0x01
#define IMDL_01_AMMO_SHOTGUN 0x01
#define IMDL_02_AMMO_GRENADE_EXPLOSIVE 0x02
#define IMDL_02_AMMO_SHOTGUN 0x02
#define MSG_A_BATTERY 0x00

proc init
{
    if (MANSION2)
    {
        door_aot_set(AOT_00_DOOR_213, 7800, 2000, 1000, 1800, 2, DOOR_SND_00_DR_WD, DOOR_06_DOOR06, 1, 0, ROOM_213_FRONT_ELEVATOR, 9800, 0, 2900, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
        if (CHRIS)
        {
            item_aot_set(AOT_01_ITEM_AMMO_SHOTGUN_1, 1800, 3200, 1100, 800, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN, SCA_NONE, 2240, -2270, 3670, 3930, F_ITEM_C_219_AMMO_SHOTGUN_1, SAT_MANUAL | SAT_PLAYER, 0);
            item_aot_set(AOT_02_ITEM_AMMO_SHOTGUN_2, 3200, 4100, 600, 1400, IT_0C_AMMO_SHOTGUN, 7, IMDL_02_AMMO_SHOTGUN, SCA_NONE, 3500, -2270, 4610, -3072, F_ITEM_C_219_AMMO_SHOTGUN_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_01_ITEM_AMMO_GRENADE_EXPLOSIVE_1, 1800, 3200, 1100, 800, IT_10_AMMO_GRENADE_EXPLOSIVE, 6, IMDL_01_AMMO_GRENADE_EXPLOSIVE, SCA_NONE, 2240, -2270, 3670, 3930, F_ITEM_J_219_AMMO_GRENADE_EXPLOSIVE_1, SAT_MANUAL | SAT_PLAYER, 0);
            item_aot_set(AOT_02_ITEM_AMMO_GRENADE_EXPLOSIVE_2, 3200, 4100, 600, 1400, IT_10_AMMO_GRENADE_EXPLOSIVE, 6, IMDL_02_AMMO_GRENADE_EXPLOSIVE, SCA_NONE, 3500, -2270, 4610, -3072, F_ITEM_J_219_AMMO_GRENADE_EXPLOSIVE_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
        item_aot_set(AOT_03_ITEM_KEY_BATTERY_0, 0, 0, 1, 1, IT_27_KEY_BATTERY, 1, IMDL_00_KEY_BATTERY, SCA_NONE, 2650, -900, 2600, 0, F_ITEM_219_KEY_BATTERY_0, SAT_MANUAL | SAT_PLAYER, 0);
        if (ck(FG_ITEM, F_ITEM_219_KEY_BATTERY_0, TRUE))
        {
            aot_set(AOT_04_EVENT_BATTERY, 2200, 1500, 1000, 1900, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, battery_message, 0, 0, 0);
        }
    }
}

proc main
{
    if (MANSION2)
    {
        if (testpickup(IT_27_KEY_BATTERY))
        {
            aot_delete(AOT_04_EVENT_BATTERY, SCE_NONE, SAT_MANUAL | SAT_PLAYER);
        }
    }
}

event battery_message
{
    run
    {
        set(FG_RUN, F_RUN_PLAYER, FALSE);
        set(FG_RUN, F_RUN_READY, FALSE);
        set(FG_RUN, F_RUN_MONSTERS, FALSE);
        set(FG_RUN, F_RUN_EFFECTS, FALSE);
        message(MSG_A_BATTERY | MSG_FAST, 0); // "A battery. Now I can move the elevator in the courtyard."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        set(FG_RUN, F_RUN_PLAYER, TRUE);
        set(FG_RUN, F_RUN_READY, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
        set(FG_RUN, F_RUN_EFFECTS, TRUE);
        aot_on(AOT_03_ITEM_KEY_BATTERY_0, SCE_ITEM, 0);
    }
    evt_finish();
}
