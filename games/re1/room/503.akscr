#version 1

proc init
{
    door_aot_set(0, 26000, 5900, 1800, 2300, 3, 1, 10, 8, 0, RDT_002, 5600, 0, 3100, 3072, UNLOCKED, 129);
    door_aot_set(1, 6600, 13600, 3800, 2800, 8, 1, 12, 7, 0, RDT_004, 7300, 0, 13800, 1024, UNLOCKED, 129);
    door_aot_set(2, 18100, 13995, 2800, 2605, 1, 9, 25, 96, 0, RDT_005, 3500, 0, 23100, 1024, UNLOCKED, 129);
    item_aot_set(3, 2330, 15950, 1000, 1000, ITEM_MO_DISK, 1, 0, 255, 130, 10, 30, 251, 66, 64, 0, 0, 176, 129, 0, 0);
    item_aot_set(4, 16700, 7600, 1000, 1000, ITEM_GREEN_HERB, 1, 1, 255, 48, 67, 0, 0, 164, 31, 0, 0, 177, 129, 1, 0);
    item_aot_set(5, 16700, 8500, 1000, 1000, ITEM_GREEN_HERB, 1, 2, 255, 48, 67, 0, 0, 40, 35, 0, 0, 178, 129, 1, 0);
    if (ck(FG_SCENARIO, 55, 1))
    {
        enemy(ENEMY_ZOMBIE_GROUNDSKEEPER_, 4, 160, 1, 2, 0, 0, 1024, 0, 0, 16050, 0, 16450, 0, 0, 0, 0);
        enemy(ENEMY_ZOMBIE_GROUNDSKEEPER_, 4, 161, 1, 2, 0, 0, 0, 0, 0, 16050, 0, 3550, 1, 0, 0, 0);
        if (ck(FG_STATUS, 8, 1))
        {
            enemy(ENEMY_ZOMBIE_GROUNDSKEEPER_, 4, 176, 1, 2, 0, 0, 3971, 0, 0, 3500, 0, 16841, 2, 0, 0, 0);
        }
    }
    else
    {
        enemy(ENEMY_ZOMBIE_RESEARCHER_, 4, 162, 1, 2, 0, 0, 3475, 0, 0, 23684, 0, 2872, 0, 0, 0, 0);
        enemy(ENEMY_ZOMBIE_RESEARCHER_, 4, 163, 1, 2, 0, 0, 3831, 0, 0, 15161, 0, 7764, 1, 0, 0, 0);
        enemy(ENEMY_ZOMBIE_RESEARCHER_, 4, 177, 1, 2, 0, 0, 3541, 0, 0, 16473, 0, 12762, 2, 0, 0, 0);
    }
    if (ck(FG_LOCK, 37, 1))
    {
        aot_reset(1, SCE_EVENT, 129, 9, event_01, 0);
    }
    aot_set(8, 10000, 15500, 2000, 500, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    set(FG_ENEMY, 82, 1);
    set(FG_ENEMY, 83, 1);
    set(FG_COMMON, 78, 1);
}

event event_00
{
    run
    {
        set(FG_6, 23, 1);
        cutnext(4);
    }
    sleep(20);
    run
    {
        message(129, 255);
    }
    wait_message();
    run
    {
        cutcurr(0);
        cut_auto(0);
        set(FG_6, 23, 0);
    }
    evt_finish();
}

event event_01
{
    run
    {
        set(FG_6, 23, 1);
        se_play_3d(2, 20, 0, 0, 0, 7300, 13800);
    }
    sleep(20);
    run
    {
        message(128, 255);
    }
    wait_message();
    run
    {
        set(FG_6, 23, 0);
    }
    evt_finish();
}
