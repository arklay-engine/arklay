#version 1

proc init
{
    door_aot_set(0, 16800, 26400, 2200, 2200, 3, 0, 6, 4, 0, RDT_011, 3000, 0, 12000, 1024, UNLOCKED, 129);
    item_aot_set(1, 23500, 19770, 1000, 1000, ITEM_CLIP, 15, 0, 255, 192, 93, 0, 0, 46, 79, 6, 6, 6, 129, 1, 0);
    if (ck(FG_COMMON, 66, 1))
    {
        aot_set(3, 22600, 18000, 2900, 2250, SCE_EVENT, 129, 9, 0, event_00, 0, 0, 0);
    }
    enemy(ENEMY_FORREST, 0, 255, 1, 2, 0, 0, 1936, 0, 0, 25150, 0, 18700, 0, 0, 0, 0);
    if (ck(FG_COMMON, 66, 1))
    {
        enemy(ENEMY_CROW, 130, 255, 1, 2, 0, 0, 3000, 0, 0, 19000, -3000, 20000, 1, 0, 0, 0);
        enemy(ENEMY_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19000, -4000, 20000, 2, 0, 0, 0);
        enemy(ENEMY_CROW, 130, 255, 1, 2, 0, 0, 0, 0, 0, 19000, -3500, 20000, 3, 0, 0, 0);
    }
    else
    {
        room_bgm_state_set(1, 18, 32);
        enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 3072, 0, 0, 24000, -2000, 17800, 1, 0, 0, 0);
        enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 21400, 2, 0, 0, 0);
        enemy(ENEMY_CROW, 1, 255, 1, 2, 0, 0, 0, 0, 0, 22460, -2000, 18020, 3, 0, 0, 0);
    }
    evt_exec(0, 9, event_05);
    evt_exec(0, 9, event_06);
}

event event_00
{
    sleep(1);
    run
    {
        set(FG_6, 23, 1);
        set(FG_STATUS, 15, 0);
        bgm_stop(0);
    }
    sleep(1);
    run
    {
        set(FG_COMMON, 66, 0);
        aot_reset(3, SCE_NONE, 0, 0, 0, 0);
        cutnext(3);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 31, 0 | 3);
    act_reset();
    evt_nop();
    sleep(30);
    run
    {
        bgm_play(1);
    }
    message(143, 0);
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(0 | 9, 32 | 31, 0 | 3);
    act_flag_op(0, 1, 0);
    act_reset();
    evt_nop();
    sleep(30);
    evt_fork(9, event_02, 0);
    evt_fork(9, event_03, 0);
    evt_fork(9, event_04, 0);
    cutnext(4);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_nop();
    act_reset();
    evt_nop();
    set(FG_STATUS, 15, 1);
    sleep(20);
    run
    {
        set(FG_6, 23, 0);
        cutnext(2);
        cut_auto(0);
    }
    evt_finish();
}

event event_01
{
    evt_finish();
}

event event_02
{
    sleep(1);
    eml_state(0, 1, 0, 2);
    evt_work_set(WK_ENEMY, 1);
    evt_actor_begin();
    act_anim_seq(35842, 30810, 8277);
    act_nop();
    act_reset();
    evt_nop();
    sleep(100);
    eml_state(0, 1, 2, 1);
    evt_finish();
}

event event_03
{
    sleep(10);
    eml_state(0, 2, 0, 2);
    evt_work_set(WK_ENEMY, 2);
    evt_actor_begin();
    act_anim_seq(61442, 24661, 8301);
    act_nop();
    act_reset();
    evt_nop();
    sleep(100);
    eml_state(0, 2, 2, 1);
    evt_finish();
}

event event_04
{
    sleep(10);
    eml_state(0, 3, 0, 2);
    evt_work_set(WK_ENEMY, 3);
    evt_actor_begin();
    act_anim_seq(55298, 8281, 8270);
    act_nop();
    act_reset();
    evt_nop();
    sleep(100);
    eml_state(0, 3, 2, 1);
    evt_finish();
}

event event_05
{
    sleep(50);
    se_play_3d(2, 24, 0, 0, 0, 3000, 3000);
    sleep(80);
    se_play_3d(2, 24, 0, 0, 0, 25000, 3000);
    sleep(120);
    se_play_3d(2, 24, 0, 0, 0, 3000, 12000);
    sleep(300);
    se_play_3d(2, 24, 0, 0, 0, 13000, 13000);
    sleep(90);
    se_play_3d(2, 24, 0, 0, 0, 32000, 23000);
    sleep(400);
    se_play_3d(2, 24, 0, 0, 0, 8000, 15000);
    evt_chain(5);
    evt_finish();
}

event event_06
{
    sleep(30);
    se_play_3d(2, 25, 0, 0, 0, 8000, 3000);
    sleep(120);
    se_play_3d(2, 25, 0, 0, 0, 20000, 8000);
    sleep(420);
    se_play_3d(2, 25, 0, 0, 0, 13000, 12000);
    sleep(20);
    se_play_3d(2, 25, 0, 0, 0, 10000, 23000);
    sleep(90);
    se_play_3d(2, 25, 0, 0, 0, 2000, 22000);
    sleep(400);
    se_play_3d(2, 25, 0, 0, 0, 8000, 15000);
    evt_chain(6);
    evt_finish();
}
