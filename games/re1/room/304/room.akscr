#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_302 0x00
#define AOT_01_DOOR_400 0x01
#define AOT_02_USEITEM_RADIO 0x02                           // Whole-room spot, on while the radio rings.
#define AOT_03_ITEM_HEAL_HERB_GREEN_0 0x03
#define AOT_04_ITEM_HEAL_HERB_GREEN_1 0x04
#define AOT_05_ITEM_HEAL_HERB_BLUE_2 0x05
#define AOT_06_ITEM_HEAL_HERB_BLUE_3 0x06
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define CAM_05 0x05
#define ENEMY_00_CERBERUS 0x00
#define ENEMY_01_CERBERUS 0x01
#define ENEMY_02_CERBERUS 0x02
#define F_ROOM_PLAYER_ANIM_DONE 0x20                        // The player's animation finished (one frame).
#define IMDL_00_HEAL_HERB_GREEN 0x00
#define IMDL_01_HEAL_HERB_GREEN 0x01
#define IMDL_02_HEAL_HERB_BLUE 0x02
#define IMDL_03_HEAL_HERB_BLUE 0x03
#define MSG_VO_009_04_22 0x00
#define MSG_VO_009_04_28 0x02
#define MSG_VO_009_05 0x01
#define MSG_VO_A05_05 0x03
#define SE_17_CALL 0x17
#define VO_009_04_22 0x22
#define VO_009_04_28 0x28
#define VO_009_05 0x23
#define VO_A05_05 0x29

proc init
{
    set(FG_STATUS, F_STATUS_CAMERA_DEFER, TRUE);
    door_aot_set(AOT_00_DOOR_302, 29200, 2600, 2000, 2600, 1, DOOR_SND_08_DR_GAT, DOOR_0F_MON, 64, 0, ROOM_302_FALLS, 3500, 0, 23300, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR_400, 3500, 30200, 1500, 1600, 1, DOOR_SND_00_DR_WD, DOOR_03_DOOR03, 1, 0, STAGE_4 | ROOM_400_ENTER_PASSAGE, 3600, 0, 9900, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_02_USEITEM_RADIO, 0, 0, 32000, 32000, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 9, 0, 63, 0, 1, 0);
    aot_reset(AOT_02_USEITEM_RADIO, SCE_NONE, 0, 0, 0, 0);
    item_aot_set(AOT_03_ITEM_HEAL_HERB_GREEN_0, 27900, 5200, 1700, 1000, IT_44_HEAL_HERB_GREEN, 1, IMDL_00_HEAL_HERB_GREEN, SCA_NONE, 28250, 0, 5400, 0, F_ITEM_304_HEAL_HERB_GREEN_0, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_04_ITEM_HEAL_HERB_GREEN_1, 27900, 5200, 1700, 1000, IT_44_HEAL_HERB_GREEN, 1, IMDL_01_HEAL_HERB_GREEN, SCA_NONE, 29000, 0, 5400, 0, F_ITEM_304_HEAL_HERB_GREEN_1, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_05_ITEM_HEAL_HERB_BLUE_2, 27900, 1800, 1700, 800, IT_45_HEAL_HERB_BLUE, 1, IMDL_02_HEAL_HERB_BLUE, SCA_NONE, 28250, 0, 2400, 0, F_ITEM_304_HEAL_HERB_BLUE_2, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    item_aot_set(AOT_06_ITEM_HEAL_HERB_BLUE_3, 27900, 1800, 1700, 800, IT_45_HEAL_HERB_BLUE, 1, IMDL_03_HEAL_HERB_BLUE, SCA_NONE, 29000, 0, 2400, 0, F_ITEM_304_HEAL_HERB_BLUE_3, SAT_MANUAL | SAT_PLAYER, ITEM_REACH);
    if (ck(FG_SCENARIO, F_SCENARIO_STAGE_VARIANT, FALSE))
    {
        enemy(EM_02_CERBERUS, EB_0C, F_ENEMY_304_CERBERUS_0, SPAWN_FORCE, 2, 0, 672, 0, 25657, 0, 11984, ENEMY_00_CERBERUS, ANIM_00, 0, EVAR_00);
        enemy(EM_02_CERBERUS, EB_0C, F_ENEMY_304_CERBERUS_1, SPAWN_FORCE, 2, 0, 336, 0, 19483, 0, 16862, ENEMY_01_CERBERUS, ANIM_00, 0, EVAR_00);
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            enemy(EM_02_CERBERUS, EB_0C, F_ENEMY_304_CERBERUS_2, SPAWN_FORCE, 2, 0, 3920, 0, 4200, 0, 21000, ENEMY_02_CERBERUS, ANIM_00, 0, EVAR_00);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_STAGE_VARIANT, TRUE) && ck(FG_SCENARIO, F_SCENARIO_304_VARIANT_VISITED, FALSE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_HAS_RADIO, TRUE))
        {
            aot_reset(AOT_02_USEITEM_RADIO, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 9, 63, 1);
            evt_exec(0, TASK_00, radio_rings);
        }
        set(FG_SCENARIO, F_SCENARIO_304_VARIANT_VISITED, TRUE);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, ROOM_302_FALLS))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 65);
    }
    if (cmpb(B_PREV_ROOM, CMP_EQ, 31))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 35);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_STAGE_VARIANT, TRUE) && ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
    {
        set(FG_COMMON, F_COMMON_C_BACK_AT_GUARDHOUSE_GATE, TRUE);
    }
}

proc main
{
    if (testitem(IT_4D_KEY_RADIO))
    {
        evt_exec(0, TASK_01, brad_radio_call);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_00))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 65);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_01))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 65);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_02))
    {
        snd_pan_vol_set(BGM_SUB_1, 50, 35);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_03))
    {
        snd_pan_vol_set(BGM_SUB_1, 30, 45);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_04))
    {
        snd_pan_vol_set(BGM_SUB_1, 30, 45);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05))
    {
        snd_pan_vol_set(BGM_SUB_1, 35, 35);
    }
}

event radio_rings
{
    sleep(30);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(180);
    se_play_3d(SND_BANK_ROOM, SE_17_CALL, 0, SND_AT_PLAYER, 0, 0, 0);
    sleep(480);
    aot_reset(AOT_02_USEITEM_RADIO, SCE_NONE, 0, 0, 0, 0);
    evt_finish();
}

event brad_radio_call
{
    evt_disable(TASK_00);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    sleep(10);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    if (CHRIS)
    {
        voice_play(VOICE_PLAY, VO_009_04_22);
        message(MSG_VO_009_04_22, 0);
    }
    else
    {
        voice_play(VOICE_PLAY, VO_009_04_28);
        message(MSG_VO_009_04_28, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_30, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0002);
    sleep(20);
    act_anim_flags(ANIM_31, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0080 | EF_0010);
    act_reset();
    evt_nop();
    wait_message();
    if (CHRIS)
    {
        voice_play(VOICE_PLAY, VO_009_05);
        message(MSG_VO_009_05, 0);
    }
    else
    {
        voice_play(VOICE_PLAY, VO_A05_05);
        message(MSG_VO_A05_05, 0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_32, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0002);
    sleep(15);
    act_anim_flags(ANIM_33, F_ROOM_PLAYER_ANIM_DONE, 0);
    act_flag_op(EF_OR, EF_0080 | EF_0010);
    if (CHRIS)
    {
        sleep(65);
    }
    else
    {
        sleep(80);
    }
    act_motion_path(MOTION_71, 600, 0, 1, 120, 64);
    sleep(5);
    act_anim_flags(ANIM_34, F_ROOM_PLAYER_ANIM_DONE, 0);
    if (CHRIS)
    {
        sleep(33);
    }
    else
    {
        sleep(40);
    }
    act_reset();
    evt_nop();
    sys_multi(SYS_FORCE_ACTION);
    sleep(40);
    wait_message();
    run
    {
        sys_multi(SYS_IDLE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_STATUS, F_STATUS_SCRIPT_ONLY_11, TRUE);
        aot_reset(AOT_02_USEITEM_RADIO, SCE_NONE, 0, 0, 0, 0);
    }
    evt_finish();
}
