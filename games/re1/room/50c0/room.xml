    <language lang="fi-FI">
      <string key="save_name">Laboratorion olohuone -2 krs</string>
      <string key="0">{scroll 2}Siinä on painike...\nPainatko sitä?{scroll 1}{branch 0 6 0}</string>
      <string key="1">{scroll 2}Ei tapahtunut mitään...\nHissiin ei kulje sähkö...{scroll 1}</string>
      <string key="2">{scroll 0}Chris!{scroll 1}{timed 30}</string>
      <string key="3">{scroll 0}Jill!{scroll 1}{timed 30}</string>
      <string key="4">{scroll 0}Anteeksi, Chris.{scroll 1}{timed 60}</string>
      <string key="5">{scroll 0}Mitä, Rebecca?{scroll 1}{timed 50}</string>
      <string key="6">{scroll 0}Luin tutkimusraportin jonka löysin\ntäältä laboratoriosta. Sen mukaan{scroll 1}{clear 110}{scroll 0}suuri osa Tyranni-viruksen\ntutkimusdatasta sijaitsee täällä.{scroll 1}{clear 95}{scroll 0}Meidän tulisi räjäyttää tämä\npaikka taivaan tuuliin!{scroll 1}{timed 100}</string>
      <string key="7">{scroll 0}Meillä on riittänyt tehtävää\nkerrakseen.{scroll 1}{clear 90}{scroll 0}Pystytkö siihen?{scroll 1}{timed 50}</string>
      <string key="8">{scroll 0}Kyllä herra! Minä käynnistän\nlaitoksen itsetuhojärjestelmän.{scroll 1}{timed 130}</string>
      <string key="9">{scroll 0}Selvä! Nyt meillä on mahdollisuus\npaeta.{scroll 1}{clear 102}{scroll 0}Nähdään ulkona.{scroll 1}{timed 90}</string>
      <string key="10">{scroll 0}Rebecca, olet kunnossa!{scroll 1}{clear 85}{scroll 0}Näin sinut sisäpihalla. Sain\nsinut vihdoin kiinni.{scroll 1}{timed 110}</string>
      <string key="11">{scroll 0}Rebecca, olet kunnossa!{scroll 1}{clear 80}{scroll 0}Olen pahoillani.{scroll 1}{timed 50}</string>
      <string key="12">{scroll 0}Olen iloinen että voit hyvin.\nÄlä mene ulos yksin.{scroll 1}{clear 140}{scroll 0}Kyllä herra!{scroll 1}{timed 40}</string>
      <string key="13">{scroll 0}Minä etsin sinua.{scroll 1}{timed 50}</string>
      <string key="14">{scroll 0}Barry!{scroll 1}{timed 50}</string>
