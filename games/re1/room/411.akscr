event on_enter_sub2
{
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    for (5)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        tw_nop();
    }
    tw_nop();
    for (20)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (5)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    sleep(60);
    for (5)
    {
        tw_set_rot(255, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (20)
    {
        tw_set_rot(255, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (5)
    {
        tw_set_rot(255, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    sleep(60);
    evt_chain(8);
    evt_finish();
}

event event_09
{
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    for (20)
    {
        tw_set_rot(0, 0, 1);
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    sleep(30);
    for (20)
    {
        tw_set_rot(0, 0, 255);
        tw_rot_add();
        evt_next();
    }
    tw_nop();
    tw_end();
    evt_nop();
    sleep(30);
    evt_chain(9);
    evt_finish();
}

event event_0A
{
    run
    {
        set(FG_6, F_6_17, FALSE);
        set(FG_6, F_6_1D, FALSE);
        set(FG_6, F_6_19, FALSE);
        message(MSG_THERE_IS_A_BUTTON | MSG_FAST, 1); // "There's a button. Will you push it? There was a sound from the room next door."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    sleep(1);
    run
    {
        if (cmpb(B_MENU_CHOICE, CMP_EQ, 0))
        {
            set(FG_LOCK, F_LOCK_24, TRUE);
            se_play_3d(2, 24, 0, SND_AT_PLAYER, 0, 0, 0);
            evt_exec(0, 9, event_0D);
        }
        else
        {
            set(FG_6, F_6_17, TRUE);
            set(FG_6, F_6_1D, TRUE);
            set(FG_6, F_6_19, TRUE);
        }
    }
    evt_finish();
}

