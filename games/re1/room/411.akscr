event event_08
{
    evt_work_set(WK_OBJ, 0);
    evt_tween_begin_alt();
    for (5)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        tw_nop();
    }
    tw_nop();
    for (20)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (5)
    {
        tw_set_rot(1, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    sleep(60);
    for (5)
    {
        tw_set_rot(255, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
    }
    tw_nop();
    for (20)
    {
        tw_set_rot(255, 0, 0);
        tw_rot_add();
        evt_next();
        evt_next();
        evt_next();
