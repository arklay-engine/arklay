event event_0A
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_6, FLAG_6_1D, FALSE);
        set(FG_6, FLAG_6_19, FALSE);
        message(129, 1);
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    sleep(1);
    run
    {
        if (cmpb(5, 0, 0))
        {
            set(FG_LOCK, FLAG_LOCK_24, TRUE);
            se_play_3d(2, 24, 0, 1, 0, 0, 0);
            evt_exec(0, 9, event_0D);
        }
        else
        {
            set(FG_6, FLAG_6_17, TRUE);
            set(FG_6, FLAG_6_1D, TRUE);
            set(FG_6, FLAG_6_19, TRUE);
        }
    }
    evt_finish();
}

