proc init
{
    door_aot_set(AOT_00_DOOR, 7600, 7700, 2400, 1500, 0, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 4, 0, ROOM_100_SAVE_ROOM, 3500, 0, 2600, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 14000, 17200, 2000, 1500, 2, DOOR_SND_00_DR_WD, DOOR_1D_DOOR01K, 5, DOOR_LOCKED | DOOR_LOCK_40 | F_LOCK_0A, ROOM_102_VACANT_ROOM, 3400, 0, 9200, 1024, IT_34_KEY_MANSION_ARMOR, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 19400, 19000, 2000, 2700, 1, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_103_F_PASSAGE, 2400, 0, 24800, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 4700, 2500, 2605, 1300, 0, DOOR_SND_05_ST_WD, DOOR_18_KAI02, 96, 0, STAGE_2 | ROOM_201_2F_LEFT_STAIRS, 14100, 0, 11500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
#if MANSION1
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 8, F_ENEMY_09, 1, 2, 0, 0, 3136, 0, 0, 9520, 0, 19044, ENEMY_00_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 4, F_ENEMY_0A, 1, 2, 0, 0, 288, 0, 0, 2805, 0, 13359, ENEMY_01_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
    enemy(EM_00_ZOMBIE_GROUNDSKEEPER, 8, F_ENEMY_0B, 1, 2, 0, 0, 2144, 0, 0, 13096, 0, 7312, ENEMY_02_ZOMBIE_GROUNDSKEEPER, 0, 0, 0);
    if (ck(FG_STATUS, F_STATUS_08, FALSE))
    {
        set(FG_COMMON, F_COMMON_3C, FALSE);
    }
#else
    room_bgm_state_set(5, 1, BGM_OFF);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_32, FALSE) && ck(FG_COMMON, F_COMMON_33, FALSE))
    {
        if (cmpw(0, W_04, CMP_GT, 180))
        {
            set(FG_COMMON, F_COMMON_33, TRUE);
        }
        else
        {
            set(FG_COMMON, F_COMMON_32, TRUE);
        }
    }
    if (ck(FG_COMMON, F_COMMON_30, TRUE))
    {
        room_bgm_state_set(5, 1, BGM_RELOAD);
        enemy(EM_2C_NPC_REBECCA_2, 0, 255, 1, 2, 0, 0, 2576, 0, 0, 13096, 0, 2888, ENEMY_00_NPC_REBECCA_2, 4, 29, 0);
        aot_set(AOT_05_MESSAGE, 12569, 2380, 1800, 1800, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 139, 0, 255, 0, 0, 0);
        if (ck(FG_COMMON, F_COMMON_35, FALSE))
        {
            set(FG_ROOM, F_ROOM_1C, TRUE);
        }
        enemy(EM_06_HUNTER, 39, F_ENEMY_0E, 1, 2, 0, 0, 608, 0, 0, 7874, 0, 7822, ENEMY_01_HUNTER, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_31, TRUE))
    {
        room_bgm_state_set(5, 1, BGM_RELOAD | 1);
        enemy(EM_2C_NPC_REBECCA_2, 0, 255, 1, 2, 0, 0, 2385, 0, 0, 13096, 0, 2888, ENEMY_00_NPC_REBECCA_2, 49, 1, 0);
        aot_set(AOT_05_MESSAGE, 12569, 2380, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, on_aot_05_message, 0, 0, 0);
    }
    if (ck(FG_COMMON, F_COMMON_22, TRUE) && ck(FG_COMMON, F_COMMON_23, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_33, TRUE))
        {
            set(FG_STATUS, F_STATUS_1D, TRUE);
            set(FG_ROOM, F_ROOM_1E, TRUE);
            set(FG_ROOM, F_ROOM_1D, TRUE);
            room_bgm_state_set(5, 1, BGM_RELOAD | 1);
            enemy(EM_2C_NPC_REBECCA_2, 0, 255, 1, 2, 0, 0, 2385, 0, 0, 9329, 0, 6214, ENEMY_00_NPC_REBECCA_2, 49, 59, 0);
            aot_set(AOT_05_MESSAGE, 12000, 2650, 1800, 1800, SCE_MESSAGE, 0, 139, 0, 255, 0, 0, 0);
            enemy(EM_06_HUNTER, 103, F_ENEMY_0E, 1, 2, 0, 0, 608, 0, 0, 7874, 0, 7822, ENEMY_01_HUNTER, 0, 0, 0);
        }
        else
        {
            enemy(EM_06_HUNTER, 23, F_ENEMY_0E, 1, 2, 0, 0, 3000, 0, 0, 4067, 0, 17454, ENEMY_01_HUNTER, 0, 0, 0);
            enemy(EM_06_HUNTER, 23, F_ENEMY_0F, 1, 2, 0, 0, 2664, 0, 0, 12480, 0, 3562, ENEMY_02_HUNTER, 0, 0, 0);
        }
    }
    if (ck(FG_COMMON, F_COMMON_22, FALSE))
    {
        enemy(EM_06_HUNTER, 23, F_ENEMY_0E, 1, 2, 0, 0, 3000, 0, 0, 4067, 0, 17454, ENEMY_01_HUNTER, 0, 0, 0);
        enemy(EM_06_HUNTER, 23, F_ENEMY_0F, 1, 2, 0, 0, 2664, 0, 0, 12480, 0, 3562, ENEMY_02_HUNTER, 0, 0, 0);
    }
#else
    enemy(EM_06_HUNTER, 23, F_ENEMY_0E, 1, 2, 0, 0, 3000, 0, 0, 4067, 0, 17454, ENEMY_00_HUNTER, 0, 0, 0);
    enemy(EM_06_HUNTER, 23, F_ENEMY_0F, 1, 2, 0, 0, 2664, 0, 0, 12480, 0, 3562, ENEMY_01_HUNTER, 0, 0, 0);
#endif
#endif
}
#if MANSION2
#if CHRIS

proc main
{
    if (cmpb(B_CAMERA, CMP_EQ, CAM_03) && ck(FG_ROOM, F_ROOM_1E, TRUE))
    {
        set(FG_ROOM, F_ROOM_1E, FALSE);
        set(FG_STATUS, F_STATUS_1D, FALSE);
        cutnext(CAM_04);
        evt_exec(0, TASK_09, from_main);
    }
    if (ck(FG_ENEMY, F_ENEMY_0E, TRUE) && ck(FG_ROOM, F_ROOM_1D, TRUE))
    {
        set(FG_ROOM, F_ROOM_1D, FALSE);
        set(FG_COMMON, F_COMMON_2F, FALSE);
        set(FG_COMMON, F_COMMON_31, TRUE);
        aot_reset(AOT_05_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_05_message, 0);
    }
    if (ck(FG_ENEMY, F_ENEMY_0E, TRUE) && ck(FG_ROOM, F_ROOM_1C, TRUE))
    {
        set(FG_ROOM, F_ROOM_1C, FALSE);
        aot_reset(AOT_05_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_05_message_2, 0);
    }
    if (ck(FG_ENEMY, F_ENEMY_0E, TRUE) && ck(FG_ROOM, F_ROOM_1B, TRUE))
    {
        set(FG_ROOM, F_ROOM_1B, FALSE);
        bgm_volume_ramp(BGM_MAIN, 160, 1);
        evt_exec(0, TASK_09, from_main_2);
    }
}

event from_main
{
    run
    {
        set(FG_ROOM, F_ROOM_1B, TRUE);
        bgm_play(BGM_MAIN);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_COMMON, F_COMMON_2F, TRUE);
        set(FG_COMMON, F_COMMON_23, TRUE);
        dir_set(0, 0, 272, 0, 2744, 0, 7000);
        pos_set(ENEMY_01_HUNTER, 0, 256, 0, 4219, 0, 7747);
    }
    sleep(1);
    set(FG_6, F_6_17, FALSE);
    evt_fork(TASK_09, from_main_sub1, 0);
    evt_fork(TASK_09, from_main_sub2, 0);
    evt_fork(TASK_09, from_main_sub5, 0);
    sleep(100);
    cutnext(CAM_05);
    sleep(200);
    evt_fork(TASK_09, from_main_sub3, 0);
    voice_play(VOICE_PLAY, VO_00C_11, 0);
    wait_message();
    evt_fork(TASK_09, from_main_sub4, 0);
    sleep(40);
    run
    {
        pos_set(ENEMY_01_HUNTER, 0, 2432, 0, 7860, 0, 5845);
        cutnext(CAM_03);
        cut_auto(0);
        set(FG_6, F_6_17, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
    }
    eml_state(0, ENEMY_01_HUNTER, EML_BEHAVIOUR, 0);
    evt_finish();
}

event from_main_sub1
{
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA_2);
    evt_actor_begin();
    act_anim_flags(32 | 17, 32 | 31, 0 | 0);
    act_flag_op(0, 16, 0);
    act_reset();
    evt_tween_begin_alt();
    tw_set_pos(10, 0, 236);
    for (100)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    pos_set(ENEMY_00_NPC_REBECCA_2, 0, 2688, 0, 11405, 0, 5254);
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_REBECCA_2);
    evt_tween_begin_alt();
    tw_set_pos(10, 0, 226);
    for (70)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_actor_begin();
    act_nop();
    act_anim_flags(32 | 16, 32 | 31, 0 | 0);
    act_reset();
    evt_nop();
    sleep(40);
    evt_actor_begin();
    act_nop();
    act_anim_flags(32 | 17, 32 | 31, 0 | 0);
    act_flag_op(0, 16, 0);
    act_reset();
    evt_tween_begin_alt();
    tw_set_pos(20, 0, 246);
    for (50)
    {
        tw_pos_add();
        evt_next();
    }
    tw_end();
    evt_actor_begin();
    act_nop();
    act_flag_op(1, 0, 128);
    act_nop();
    act_finish();
}

event from_main_sub2
{
    evt_work_set(WK_ENEMY, ENEMY_01_HUNTER);
    evt_actor_begin();
    act_anim_seq(10498, 29736, 15894);
    act_reset();
    sleep(100);
    pos_set(ENEMY_01_HUNTER, 0, 808, 0, 9431, 0, 7822);
    sleep(65);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, 13);
    evt_fork(TASK_09, from_main_sub2_sub1, 0);
    sleep(60);
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, 18);
    evt_finish();
}

event from_main_sub3
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(32 | 1, 32 | 31, 0 | 3);
    act_flag_op(1, 2, 0);
    sleep(5);
    act_reset();
    evt_nop();
    sys_multi(SYS_04);
    sleep(30);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event from_main_sub4
{
    eml_state(0, ENEMY_01_HUNTER, EML_ACTION, 22);
    sleep(38);
    evt_finish();
}

event on_aot_05_message
{
    run
    {
        bgm_play(BGM_SUB_1);
        cutnext(CAM_05);
        set(FG_STATUS, F_STATUS_0F, TRUE);
        set(FG_6, F_6_17, FALSE);
        set(FG_COMMON, F_COMMON_31, FALSE);
        aot_delete(AOT_05_MESSAGE, SCE_NONE, 0);
        dir_set(0, 0, 592, 0, 12132, 0, 4876);
        pos_set(ENEMY_00_NPC_REBECCA_2, 0, 2672, 0, 13096, 0, 2888);
    }
    evt_fork(TASK_09, on_aot_05_message_sub1, 0);
    evt_fork(TASK_09, on_aot_05_message_sub2, 0);
    voice_play(VOICE_PLAY, VO_00C_12, 0);
    message(MSG_VO_00C_12, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub3, 0);
    voice_play(VOICE_PLAY, VO_00C_13, 0);
    message(MSG_VO_00C_13, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub4, 0);
    voice_play(VOICE_PLAY, VO_00C_14, 0);
    message(MSG_VO_00C_14, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub5, 0);
    voice_play(VOICE_PLAY, VO_00C_15, 0);
    message(MSG_VO_00C_15, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub6, 0);
    voice_play(VOICE_PLAY, VO_00C_16, 0);
    message(MSG_VO_00C_16, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub7, 0);
    voice_play(VOICE_PLAY, VO_00C_18, 0);
    message(MSG_VO_00C_18, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub8, 0);
    voice_play(VOICE_PLAY, VO_00C_19, 0);
    message(MSG_VO_00C_19, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub9, 0);
    voice_play(VOICE_PLAY, VO_00C_1A, 0);
    message(MSG_VO_00C_1A, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub10, 0);
    voice_play(VOICE_PLAY, VO_00C_1B, 0);
    message(MSG_VO_00C_1B, 0);
    wait_message();
    evt_fork(TASK_09, on_aot_05_message_sub11, 0);
    voice_play(VOICE_PLAY, VO_00C_1C, 0);
    message(MSG_VO_00C_1C, 0);
    wait_message();
    sleep(10);
    run
    {
        aot_reset(AOT_05_MESSAGE, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_05_message_3, 0);
        cutnext(CAM_04);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        set(FG_6, F_6_17, TRUE);
        cut_auto(0);
    }
    evt_finish();
}

