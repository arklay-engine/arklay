#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_20E 0x00
#define AOT_01_MESSAGE_CANDLE 0x01
#define AOT_02_USEITEM_CANDLE 0x02
#define AOT_03_ITEM_AMMO_HANDGUN_0 0x03
#define AOT_04_ITEM_AMMO_SHOTGUN_OR_GRENADE_ACID_1 0x04     // A "too dark" message spot until the candle is lit.
#define AOT_05_ITEM_INK_2 0x05
#define CAM_02_DARK_NOOK 0x02                               // Likely: the corner the map counts as 21D, while dark.
#define CAM_03_LIT_FRONT 0x03                               // Camera 0 once the candle is lit.
#define CAM_04_LIT_CANDLE 0x04                              // Camera 1 once the candle is lit.
#define CAM_05_LIT_NOOK 0x05                                // Camera 2 once the candle is lit.
#define FX_0F 0x0F
#define F_ROOM_CAMERA_FREED 0x01                            // The camera lock set on entering the lit room was lifted (once).
#define F_ROOM_CANDLE_JUST_LIT 0x00                         // The candle was lit this visit; nothing reads it.
#define IMDL_00_AMMO_HANDGUN 0x00
#define IMDL_01_AMMO_SHOTGUN_OR_GRENADE_ACID 0x01
#define IMDL_02_INK 0x02
#define OBJ_00_CANDLE 0x00                                  // Likely.

proc init
{
    door_aot_set(AOT_00_DOOR_20E, 4000, 11800, 1300, 1400, 1, DOOR_SND_00_DR_WD, DOOR_01_DOOR01, 4, 0, ROOM_20E_FRONT_OF_ATTIC, 4900, 0, 12500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_MESSAGE_CANDLE, 7300, 6700, 2700, 2000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 128, 0, 255, 0, 0, 0);
    aot_set(AOT_02_USEITEM_CANDLE, 7300, 6700, 2700, 2000, SCE_USEITEM, SAT_PLAYER, 9, 0, 21, 0, 1, 0);
    item_aot_set(AOT_03_ITEM_AMMO_HANDGUN_0, 10000, 11300, 1700, 1000, IT_0B_AMMO_HANDGUN, 15, IMDL_00_AMMO_HANDGUN, SCA_NONE, 0, 0, 0, 0, F_ITEM_20F_AMMO_HANDGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
    if (CHRIS)
    {
        item_aot_set(AOT_04_ITEM_AMMO_SHOTGUN_OR_GRENADE_ACID_1, 3200, 1900, 1200, 2400, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN_OR_GRENADE_ACID, SCA_NONE, 0, 0, 0, 0, F_ITEM_20F_AMMO_SHOTGUN_OR_GRENADE_ACID_1, SAT_MANUAL | SAT_PLAYER, 0);
    }
    else
    {
        item_aot_set(AOT_04_ITEM_AMMO_SHOTGUN_OR_GRENADE_ACID_1, 3200, 1900, 1200, 2400, IT_11_AMMO_GRENADE_ACID, 6, IMDL_01_AMMO_SHOTGUN_OR_GRENADE_ACID, SCA_NONE, 0, 0, 0, 0, F_ITEM_20F_AMMO_SHOTGUN_OR_GRENADE_ACID_1, SAT_MANUAL | SAT_PLAYER, 0);
        if (USA)
        {
            item_aot_set(AOT_05_ITEM_INK_2, 4800, 7000, 1100, 3400, IT_2F_KEY_INK_RIBBON, 2, IMDL_02_INK, SCA_NONE, 6080, -1230, 8820, 0, F_ITEM_20F_INK_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
        else
        {
            item_aot_set(AOT_05_ITEM_INK_2, 4800, 7000, 1100, 3400, IT_2F_KEY_INK_RIBBON, 3, IMDL_02_INK, SCA_NONE, 6080, -1230, 8820, 0, F_ITEM_20F_INK_2, SAT_MANUAL | SAT_PLAYER, 0);
        }
    }
    obj(OBJ_00_CANDLE, OF_10 | OF_ACTIVE, SCA_NONE, 7872, 0, 5192, 3072, 0, 1130, 0, -1130, 40, 1000, 1170, 540);
    if (ck(FG_SCENARIO, F_SCENARIO_CANDLE_LIT, FALSE))
    {
        aot_reset(AOT_04_ITEM_AMMO_SHOTGUN_OR_GRENADE_ACID_1, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 130, 255, 0);
    }
    else
    {
        cut_auto(CUT_LOCKED);
        setb(B_CAMERA, CAM_03_LIT_FRONT, 0);
        aot_reset(AOT_01_MESSAGE_CANDLE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
        if (ck(FG_ITEM, F_ITEM_20F_AMMO_SHOTGUN_OR_GRENADE_ACID_1, TRUE))
        {
            aot_reset(AOT_04_ITEM_AMMO_SHOTGUN_OR_GRENADE_ACID_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
        }
        else
        {
            aot_reset(AOT_04_ITEM_AMMO_SHOTGUN_OR_GRENADE_ACID_1, SCE_NONE, 0, 0, 0, 0);
        }
        effect(FX_0F, FX_ROW_00, FX_AT_WORLD, 8190, -1854, 8136, 0);
        effect(FX_0F, FX_ROW_00, FX_AT_WORLD, 8316, -1926, 8262, 0);
        effect(FX_0F, FX_ROW_00, FX_AT_WORLD, 8460, -1854, 8388, 0);
        msg_list(0, 5310, -2000, 8891, 200, 200, 160, LIGHT_KIND_00, 5499, 8726, -2000, 8858, 200, 200, 160, LIGHT_KIND_00, 5439, 8960, -2000, 3018, 160, 160, 240, LIGHT_KIND_00, 4319, 1228, 1228, 1004);
    }
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_CANDLE_LIT, FALSE))
    {
        if (testitem(IT_30_KEY_LIGHTER))
        {
            cutnext(CAM_04_LIT_CANDLE);
            cut_auto(CUT_FREE);
            aot_reset(AOT_01_MESSAGE_CANDLE, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 129, 255, 0);
            aot_reset(AOT_04_ITEM_AMMO_SHOTGUN_OR_GRENADE_ACID_1, SCE_ITEM, SAT_MANUAL | SAT_PLAYER, 0, 0, 0);
            effect(FX_0F, FX_ROW_00, FX_AT_WORLD, 8190, -1854, 8136, 0);
            effect(FX_0F, FX_ROW_00, FX_AT_WORLD, 8316, -1926, 8262, 0);
            effect(FX_0F, FX_ROW_00, FX_AT_WORLD, 8460, -1854, 8388, 0);
            set(FG_ROOM, F_ROOM_CANDLE_JUST_LIT, TRUE);
            set(FG_SCENARIO, F_SCENARIO_CANDLE_LIT, TRUE);
            msg_list(0, 5310, -2000, 8891, 200, 200, 160, LIGHT_KIND_00, 5499, 8726, -2000, 8858, 200, 200, 160, LIGHT_KIND_00, 5439, 8960, -2000, 3018, 160, 160, 240, LIGHT_KIND_00, 4319, 1228, 1228, 1004);
        }
    }
    else if (ck(FG_ROOM, F_ROOM_CAMERA_FREED, FALSE))
    {
        cut_auto(CUT_FREE);
        set(FG_ROOM, F_ROOM_CAMERA_FREED, TRUE);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_02_DARK_NOOK))
    {
        set(FG_MAP, F_MAP_VISITED_21D, TRUE);
    }
    if (cmpb(B_CAMERA, CMP_EQ, CAM_05_LIT_NOOK))
    {
        set(FG_MAP, F_MAP_VISITED_21D, TRUE);
    }
}
