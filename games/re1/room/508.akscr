#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_EVENT 0x04
#define CAM_00 0x00
#define CAM_01 0x01
#define CAM_02 0x02
#define CAM_03 0x03
#define CAM_04 0x04
#define ENEMY_00_NPC_CHRIS 0x00
#define ENEMY_00_NPC_JILL 0x00
#define FX_0A 0x0A
#define F_ROOM_05 0x05
#define F_ROOM_06 0x06
#define F_ROOM_07 0x07
#define F_ROOM_21 0x21
#define MSG_A_PASS_CODE_PANEL 0x00
#define MSG_IT_IS_ELECTRONICALLY_LOCKED 0x04
#define MSG_IT_IS_LOCKED_05 0x05
#define MSG_YOU_DO_NOT_HAVE_THE_PASS 0x01
#define MSG_YOU_HAVE_ENTERED_THE_PASS_CODE 0x02
#define SE_14_DM_GACHA 0x14
#define SE_17_DLBEEP 0x17
#define SE_18_DBROCK 0x18
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_A00_04_5A 0x5A
#define VO_A00_05_5B 0x5B

proc init
{
    door_aot_set(AOT_00_DOOR, 19500, 2400, 2100, 2500, 6, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_505_O_PASSAGE, 2900, 0, 17500, 0, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_01_DOOR, 10700, 4800, 2300, 1600, 0, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_509_PRIVATE_ROOM_A, 3600, 0, 2700, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_02_DOOR, 17700, 800, 1400, 1600, 0, DOOR_SND_01_DR_MTL, DOOR_0C_DOOR12, 7, 0, ROOM_50A_PRIVATE_ROOM_B, 10800, 0, 10200, 1576, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    door_aot_set(AOT_03_DOOR, 200, 2500, 2100, 2200, 11, DOOR_SND_01_DR_MTL, DOOR_0B_DOOR11, 3, 0, ROOM_50B_FRONT_OF_CELL, 5300, 0, 4000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    if (ck(FG_ITEM, F_ITEM_52, TRUE))
    {
        if (ck(FG_ITEM, F_ITEM_62, TRUE))
        {
            if (ck(FG_ITEM, F_ITEM_5A, TRUE))
            {
                aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04_2, 0, 0, 0);
            }
            else
            {
                aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04, 0, 0, 0);
            }
        }
        else
        {
            aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04, 0, 0, 0);
        }
    }
    else
    {
        aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 0, 0, on_aot_04, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_34, FALSE))
    {
        effect(FX_0A, 0, 0, 182, 8, 72, 244, 180, 20, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_35, FALSE))
    {
        effect(FX_0A, 1, 0, 136, 9, 72, 244, 180, 20, 0, 0);
    }
    if (ck(FG_SCENARIO, F_SCENARIO_36, FALSE))
    {
        effect(FX_0A, 2, 0, 90, 10, 72, 244, 180, 20, 0, 0);
    }
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_AC, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_4B, TRUE))
        {
            dir_set(0, 0, 4056, 0, 2600, 0, 2500);
            evt_exec(0, TASK_09, on_enter);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_B3, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_4B, TRUE))
        {
            dir_set(0, 0, 4056, 0, 2600, 0, 2500);
            evt_exec(0, TASK_09, on_enter);
        }
    }
#endif
    if (ck(FG_LOCK, F_LOCK_26, FALSE))
    {
        aot_reset(AOT_01_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_01_door, 0);
    }
    aot_reset(AOT_03_DOOR, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, on_aot_03_door, 0);
#if CHRIS
    if (ck(FG_COMMON, F_COMMON_AC, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_4B, TRUE))
        {
            enemy(EM_21_NPC_JILL, 0, 255, 1, 1, 0, 0, 4056, 0, 0, 3100, 0, 4300, ENEMY_00_NPC_JILL, 0, 0, 0);
        }
    }
#else
    if (ck(FG_COMMON, F_COMMON_B3, FALSE))
    {
        if (ck(FG_COMMON, F_COMMON_4B, TRUE))
        {
            enemy(EM_20_NPC_CHRIS, 0, 255, 1, 1, 0, 0, 4056, 0, 0, 3100, 0, 4300, ENEMY_00_NPC_CHRIS, 0, 0, 0);
        }
    }
#endif
}

proc main
{
    if (ck(FG_SCENARIO, F_SCENARIO_34, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_05, FALSE))
        {
            set(FG_ROOM, F_ROOM_05, TRUE);
            effect(FX_0A, 8, 0, 182, 8, 72, 244, 180, 20, 0, 0);
            effect_kill_b(FX_0A, 0, 0);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_35, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_06, FALSE))
        {
            set(FG_ROOM, F_ROOM_06, TRUE);
            effect(FX_0A, 9, 0, 136, 9, 72, 244, 180, 20, 0, 0);
            effect_kill_b(FX_0A, 1, 0);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_36, TRUE))
    {
        if (ck(FG_ROOM, F_ROOM_07, FALSE))
        {
            set(FG_ROOM, F_ROOM_07, TRUE);
            effect(FX_0A, 10, 0, 90, 10, 72, 244, 180, 20, 0, 0);
            effect_kill_b(FX_0A, 2, 0);
        }
    }
    if (ck(FG_SCENARIO, F_SCENARIO_34, TRUE))
    {
        if (ck(FG_SCENARIO, F_SCENARIO_35, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_36, TRUE))
            {
                aot_delete(AOT_03_DOOR, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
            }
        }
    }
}

event event_00
{
    evt_finish();
}

event on_enter
{
    sleep(1);
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        set(FG_STATUS, F_STATUS_0F, TRUE);
#if CHRIS
        set(FG_COMMON, F_COMMON_AC, TRUE);
#else
        set(FG_COMMON, F_COMMON_B3, TRUE);
#endif
    }
    sleep(20);
    cutnext(CAM_02);
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
#else
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
#endif
    evt_actor_begin();
#if CHRIS
    act_anim_seq(43011, 25135, 8465);
#else
    act_anim_seq(43011, 52296, 8464);
#endif
    act_reset();
#if JILL
    sleep(40);
    cutnext(CAM_01);
    sleep(30);
    cutnext(CAM_00);
#endif
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
#else
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
#endif
    evt_actor_begin();
    act_anim_flags(32 | 14, 32 | 1, 0 | 0);
    act_param_set(0, 4);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
#else
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
#endif
    evt_actor_begin();
    act_motion_path(49, 710, 0, 0, 80, 0);
    act_reset();
    evt_nop();
#if CHRIS
    sleep(20);
#else
    sleep(30);
#endif
    run
    {
        message(3, 0);
#if CHRIS
        voice_play(VOICE_PLAY, VO_A00_05_5B, 0);
#else
        voice_play(VOICE_PLAY, VO_A00_04_5A, 0);
#endif
    }
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
#else
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_CHRIS);
#endif
    evt_actor_begin();
    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    wait_message();
#if CHRIS
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 1, 0 | 0);
    act_param_set(0, 252);
    act_motion(16);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    evt_work_set(WK_ENEMY, ENEMY_00_NPC_JILL);
    evt_actor_begin();
    act_anim_seq(43011, 52296, 8464);
    act_reset();
#endif
    sleep(20);
#if CHRIS
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, F_ROOM_21, FALSE));
    sleep(20);
#else
    cutnext(CAM_03);
    sleep(10);
#endif
    se_play_3d(SND_BANK_DOOR, SE_DOOR_00, 0, SND_AT_POINT, 0, 6388, 14000);
    sleep(30);
    run
    {
        se_play_3d(SND_BANK_DOOR, SE_DOOR_01, 0, SND_AT_POINT, 0, 6388, 14000);
#if CHRIS
        pos_set(ENEMY_00_NPC_JILL, 0, 4056, 0, 0, 0, 0);
#else
        pos_set(ENEMY_00_NPC_CHRIS, 0, 4056, 0, 0, 0, 0);
#endif
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_STATUS, F_STATUS_0F, FALSE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_aot_04
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 4056, 0, 2600, 0, 2500);
        cutnext(CAM_04);
        message(MSG_A_PASS_CODE_PANEL | MSG_FAST, 0); // "A pass code panel."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_34, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_52, FALSE))
            {
                message(MSG_YOU_HAVE_ENTERED_THE_PASS_CODE | MSG_FAST, 0); // "You've entered the pass code."
                set(FG_SCENARIO, F_SCENARIO_34, TRUE);
                se_play_3d(SND_BANK_ROOM, SE_17_DLBEEP, 0, SND_AT_POINT, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_35, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_62, FALSE))
            {
                message(MSG_YOU_HAVE_ENTERED_THE_PASS_CODE | MSG_FAST, 0); // "You've entered the pass code."
                set(FG_SCENARIO, F_SCENARIO_35, TRUE);
                se_play_3d(SND_BANK_ROOM, SE_17_DLBEEP, 0, SND_AT_POINT, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_36, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_5A, FALSE))
            {
                message(MSG_YOU_HAVE_ENTERED_THE_PASS_CODE | MSG_FAST, 0); // "You've entered the pass code."
                set(FG_SCENARIO, F_SCENARIO_36, TRUE);
                se_play_3d(SND_BANK_ROOM, SE_17_DLBEEP, 0, SND_AT_POINT, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        if (ck(FG_SCENARIO, F_SCENARIO_34, TRUE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_35, TRUE))
            {
                if (ck(FG_SCENARIO, F_SCENARIO_36, TRUE))
                {
                    if (ck(FG_SCENARIO, F_SCENARIO_50, FALSE))
                    {
                        set(FG_SCENARIO, F_SCENARIO_50, TRUE);
                        se_play_3d(SND_BANK_ROOM, SE_18_DBROCK, 0, SND_AT_POINT, 0, 2300, 4850);
                    }
                }
            }
        }
        dir_set(0, 0, 3056, 0, 2280, 0, 4850);
        cutnext(CAM_03);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_aot_04_2
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 4056, 0, 2600, 0, 2500);
        cutnext(CAM_04);
        message(MSG_A_PASS_CODE_PANEL | MSG_FAST, 0); // "A pass code panel."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    message(MSG_YOU_DO_NOT_HAVE_THE_PASS | MSG_FAST, 0); // "You don't have the pass code."
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    run
    {
        dir_set(0, 0, 3056, 0, 2280, 0, 4850);
        cutnext(CAM_03);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_aot_01_door
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        se_play_3d(SND_BANK_ROOM, SE_14_DM_GACHA, 0, SND_AT_POINT, 0, 11300, 4850);
        message(MSG_IT_IS_ELECTRONICALLY_LOCKED | MSG_FAST, 0); // "It's electronically locked."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}

event on_aot_03_door
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        se_play_3d(SND_BANK_ROOM, SE_14_DM_GACHA, 0, SND_AT_POINT, 0, 11300, 4850);
        message(MSG_IT_IS_LOCKED_05 | MSG_FAST, 0); // "It's locked."
    }
    do
    {
        evt_next();
    }
    while (cmpb(B_MENU_CHOICE, CMP_GE, 128));
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}
