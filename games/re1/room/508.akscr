#version 1

#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR 0x00
#define AOT_01_DOOR 0x01
#define AOT_02_DOOR 0x02
#define AOT_03_DOOR 0x03
#define AOT_04_EVENT 0x04
#define FLAG_ROOM_05 0x05
#define FLAG_ROOM_06 0x06
#define FLAG_ROOM_07 0x07
#define FLAG_ROOM_21 0x21

proc init
{
    door_aot_set(AOT_00_DOOR, 19500, 2400, 2100, 2500, 6, 1, 12, 7, 0, ROOM_505_O_PASSAGE, 2900, 0, 17500, 0, UNLOCKED, 129);
    door_aot_set(AOT_01_DOOR, 10700, 4800, 2300, 1600, 0, 1, 12, 7, 0, ROOM_509_PRIVATE_ROOM_A, 3600, 0, 2700, 3072, UNLOCKED, 129);
    door_aot_set(AOT_02_DOOR, 17700, 800, 1400, 1600, 0, 1, 12, 7, 0, ROOM_50A_PRIVATE_ROOM_B, 10800, 0, 10200, 1576, UNLOCKED, 129);
    door_aot_set(AOT_03_DOOR, 200, 2500, 2100, 2200, 11, 1, 11, 3, 0, ROOM_50B_FRONT_OF_CELL, 5300, 0, 4000, 2048, UNLOCKED, 129);
    if (ck(FG_ITEM, FLAG_ITEM_52, TRUE))
    {
        if (ck(FG_ITEM, FLAG_ITEM_62, TRUE))
        {
            if (ck(FG_ITEM, FLAG_ITEM_5A, TRUE))
            {
                aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, 129, 0, 0, on_aot_04_2, 0, 0, 0);
            }
            else
            {
                aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, 129, 0, 0, on_aot_04, 0, 0, 0);
            }
        }
        else
        {
            aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, 129, 0, 0, on_aot_04, 0, 0, 0);
        }
    }
    else
    {
        aot_set(AOT_04_EVENT, 2000, 4900, 800, 1000, SCE_EVENT, 129, 0, 0, on_aot_04, 0, 0, 0);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_34, FALSE))
    {
        effect(10, 0, 0, 182, 8, 72, 244, 180, 20, 0, 0);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_35, FALSE))
    {
        effect(10, 1, 0, 136, 9, 72, 244, 180, 20, 0, 0);
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_36, FALSE))
    {
        effect(10, 2, 0, 90, 10, 72, 244, 180, 20, 0, 0);
    }
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_AC, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_4B, TRUE))
        {
            dir_set(0, 0, 4056, 0, 2600, 0, 2500);
            evt_exec(0, 9, on_enter);
        }
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_B3, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_4B, TRUE))
        {
            dir_set(0, 0, 4056, 0, 2600, 0, 2500);
            evt_exec(0, 9, on_enter);
        }
    }
#endif
    if (ck(FG_LOCK, FLAG_LOCK_26, FALSE))
    {
        aot_reset(AOT_01_DOOR, SCE_EVENT, 129, 9, on_aot_01_door, 0);
    }
    aot_reset(AOT_03_DOOR, SCE_EVENT, 129, 9, on_aot_03_door, 0);
#if CHRIS
    if (ck(FG_COMMON, FLAG_COMMON_AC, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_4B, TRUE))
        {
            enemy(ENEMY_21_NPC_JILL, 0, 255, 1, 1, 0, 0, 4056, 0, 0, 3100, 0, 4300, 0, 0, 0, 0);
        }
    }
#else
    if (ck(FG_COMMON, FLAG_COMMON_B3, FALSE))
    {
        if (ck(FG_COMMON, FLAG_COMMON_4B, TRUE))
        {
            enemy(ENEMY_20_NPC_CHRIS, 0, 255, 1, 1, 0, 0, 4056, 0, 0, 3100, 0, 4300, 0, 0, 0, 0);
        }
    }
#endif
}

proc main
{
    if (ck(FG_SCENARIO, FLAG_SCENARIO_34, TRUE))
    {
        if (ck(FG_ROOM, FLAG_ROOM_05, FALSE))
        {
            set(FG_ROOM, FLAG_ROOM_05, TRUE);
            effect(10, 8, 0, 182, 8, 72, 244, 180, 20, 0, 0);
            effect_kill_b(10, 0, 0);
        }
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_35, TRUE))
    {
        if (ck(FG_ROOM, FLAG_ROOM_06, FALSE))
        {
            set(FG_ROOM, FLAG_ROOM_06, TRUE);
            effect(10, 9, 0, 136, 9, 72, 244, 180, 20, 0, 0);
            effect_kill_b(10, 1, 0);
        }
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_36, TRUE))
    {
        if (ck(FG_ROOM, FLAG_ROOM_07, FALSE))
        {
            set(FG_ROOM, FLAG_ROOM_07, TRUE);
            effect(10, 10, 0, 90, 10, 72, 244, 180, 20, 0, 0);
            effect_kill_b(10, 2, 0);
        }
    }
    if (ck(FG_SCENARIO, FLAG_SCENARIO_34, TRUE))
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_35, TRUE))
        {
            if (ck(FG_SCENARIO, FLAG_SCENARIO_36, TRUE))
            {
                aot_delete(AOT_03_DOOR, SCE_DOOR, 129);
            }
        }
    }
}

event event_00
{
    evt_finish();
}

event on_enter
{
    sleep(1);
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        set(FG_STATUS, FLAG_STATUS_0F, TRUE);
#if CHRIS
        set(FG_COMMON, FLAG_COMMON_AC, TRUE);
#else
        set(FG_COMMON, FLAG_COMMON_B3, TRUE);
#endif
    }
    sleep(20);
    cutnext(2);
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
#if CHRIS
    act_anim_seq(43011, 25135, 8465);
#else
    act_anim_seq(43011, 52296, 8464);
#endif
    act_reset();
#if JILL
    sleep(40);
    cutnext(1);
    sleep(30);
    cutnext(0);
#endif
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 14, 32 | 1, 0 | 0);
    act_param_set(0, 4);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_motion_path(49, 710, 0, 0, 80, 0);
    act_reset();
    evt_nop();
#if CHRIS
    sleep(20);
#else
    sleep(30);
#endif
    run
    {
        message(3, 0);
#if CHRIS
        voice_play(1, 91, 0);
#else
        voice_play(1, 90, 0);
#endif
    }
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 1, 32 | 1, 0 | 0);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
    wait_message();
#if CHRIS
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_flags(32 | 13, 32 | 1, 0 | 0);
    act_param_set(0, 252);
    act_motion(16);
    act_reset();
    evt_nop();
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
    evt_work_set(WK_ENEMY, 0);
    evt_actor_begin();
    act_anim_seq(43011, 52296, 8464);
    act_reset();
#endif
    sleep(20);
#if CHRIS
    do
    {
        evt_next();
    }
    while (ck(FG_ROOM, FLAG_ROOM_21, FALSE));
    sleep(20);
#else
    cutnext(3);
    sleep(10);
#endif
    se_play_3d(0, 0, 0, 0, 0, 6388, 14000);
    sleep(30);
    run
    {
        se_play_3d(0, 1, 0, 0, 0, 6388, 14000);
        pos_set(0, 0, 4056, 0, 0, 0, 0);
        set(FG_6, FLAG_6_17, TRUE);
        set(FG_STATUS, FLAG_STATUS_0F, FALSE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_aot_04
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        dir_set(0, 0, 4056, 0, 2600, 0, 2500);
        cutnext(4);
        message(128, 0); // "A pass code panel."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_34, FALSE))
        {
            if (ck(FG_ITEM, FLAG_ITEM_52, FALSE))
            {
                message(130, 0); // "You've entered the pass code."
                set(FG_SCENARIO, FLAG_SCENARIO_34, TRUE);
                se_play_3d(2, 23, 0, 0, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_35, FALSE))
        {
            if (ck(FG_ITEM, FLAG_ITEM_62, FALSE))
            {
                message(130, 0); // "You've entered the pass code."
                set(FG_SCENARIO, FLAG_SCENARIO_35, TRUE);
                se_play_3d(2, 23, 0, 0, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_36, FALSE))
        {
            if (ck(FG_ITEM, FLAG_ITEM_5A, FALSE))
            {
                message(130, 0); // "You've entered the pass code."
                set(FG_SCENARIO, FLAG_SCENARIO_36, TRUE);
                se_play_3d(2, 23, 0, 0, 0, 2300, 4850);
            }
        }
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        if (ck(FG_SCENARIO, FLAG_SCENARIO_34, TRUE))
        {
            if (ck(FG_SCENARIO, FLAG_SCENARIO_35, TRUE))
            {
                if (ck(FG_SCENARIO, FLAG_SCENARIO_36, TRUE))
                {
                    if (ck(FG_SCENARIO, FLAG_SCENARIO_50, FALSE))
                    {
                        set(FG_SCENARIO, FLAG_SCENARIO_50, TRUE);
                        se_play_3d(2, 24, 0, 0, 0, 2300, 4850);
                    }
                }
            }
        }
        dir_set(0, 0, 3056, 0, 2280, 0, 4850);
        cutnext(3);
        set(FG_6, FLAG_6_17, TRUE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_aot_04_2
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        dir_set(0, 0, 4056, 0, 2600, 0, 2500);
        cutnext(4);
        message(128, 0); // "A pass code panel."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    message(129, 0); // "You don't have the pass code."
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    run
    {
        dir_set(0, 0, 3056, 0, 2280, 0, 4850);
        cutnext(3);
        set(FG_6, FLAG_6_17, TRUE);
        cut_auto(0);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_idle();
    act_reset();
    evt_finish();
}

event on_aot_01_door
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        se_play_3d(2, 20, 0, 0, 0, 11300, 4850);
        message(132, 0); // "It's electronically locked."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_6, FLAG_6_17, TRUE);
    evt_finish();
}

event on_aot_03_door
{
    run
    {
        set(FG_6, FLAG_6_17, FALSE);
        se_play_3d(2, 20, 0, 0, 0, 11300, 4850);
        message(133, 0); // "It's locked."
    }
    do
    {
        evt_next();
    }
    while (cmpb(5, 2, 128));
    set(FG_6, FLAG_6_17, TRUE);
    evt_finish();
}
