#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_101 0x00
#define AOT_01_ITEM_KEY_BROKEN_SHOTGUN_0 0x01
#define AOT_02_ITEM_AMMO_SHOTGUN_1 0x02                     // In the desk drawer.
#define AOT_03_ITEM_AMMO_HANDGUN_2 0x03
#define AOT_04_HIKIDASHI_DESK 0x04                          // The desk drawer with the shotgun shells.
#define F_ROOM_ANIM_DONE 0x3F                               // Raised when an actor's animation ends (one frame); nothing waits for it.
#define IMDL_00_KEY_BROKEN_SHOTGUN 0x00
#define IMDL_01_AMMO_SHOTGUN 0x01
#define IMDL_02_AMMO_HANDGUN 0x02
#define VO_A00_00 0x85

proc init
{
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        door_aot_set(AOT_00_DOOR_101, 2500, 9400, 1700, 2000, 1, DOOR_SND_00_DR_WD, DOOR_1D_DOOR01K, 5, 0, ROOM_101_1F_LEFT_STAIRS, 15000, 0, 18800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    else
    {
        door_aot_set(AOT_00_DOOR_101, 2900, 9000, 1200, 1300, 1, DOOR_SND_00_DR_WD, DOOR_1D_DOOR01K, 5, 0, ROOM_101_1F_LEFT_STAIRS, 15000, 0, 18800, 3072, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    }
    item_aot_set(AOT_01_ITEM_KEY_BROKEN_SHOTGUN_0, 6500, 9100, 500, 900, IT_1C_KEY_BROKEN_SHOTGUN, 1, IMDL_00_KEY_BROKEN_SHOTGUN, SCA_NONE, 6840, -2250, 9670, -2000, F_ITEM_102_KEY_BROKEN_SHOTGUN_0, SAT_MANUAL | SAT_PLAYER, 0);
    eml_rot(IMDL_00_KEY_BROKEN_SHOTGUN, -100, -1100);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, FALSE))
    {
        item_aot_set(AOT_02_ITEM_AMMO_SHOTGUN_1, 0, 0, 0, 0, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN, SCA_NONE, 2840, -410, 2070, 1000, F_ITEM_102_AMMO_SHOTGUN_1, 0, 0);
    }
    else
    {
        item_aot_set(AOT_02_ITEM_AMMO_SHOTGUN_1, 0, 0, 0, 0, IT_0C_AMMO_SHOTGUN, 7, IMDL_01_AMMO_SHOTGUN, SCA_NONE, 2840, -410, 2070, 1000, F_ITEM_102_AMMO_SHOTGUN_1, SAT_MANUAL | SAT_PLAYER, 0);
    }
    eml_rot(IMDL_01_AMMO_SHOTGUN, 0, -1100);
    setbyte(1, 0, 0);
    item_aot_set(AOT_03_ITEM_AMMO_HANDGUN_2, 4540, 8470, 1800, 1800, IT_0B_AMMO_HANDGUN, 15, IMDL_02_AMMO_HANDGUN, SCA_NONE, 5440, -2100, 9370, 0, F_ITEM_102_AMMO_HANDGUN_2, SAT_MANUAL | SAT_PLAYER, 0);
    aot_set(AOT_04_HIKIDASHI_DESK, 2000, 2237, 1750, 700, SCE_HIKIDASHI, SAT_MANUAL | SAT_PLAYER, 30, 0, 2, 0, 3, 0);
    if (ck(FG_SCENARIO, F_SCENARIO_MANSION2, TRUE))
    {
        if (ck(FG_STATUS, F_STATUS_PLAYER_JILL, FALSE))
        {
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_UNDER_ATTACK, TRUE))
            {
                set(FG_COMMON, F_COMMON_C_REBECCA_KILLED, TRUE);
                set(FG_COMMON, F_COMMON_PARTNER_LOST, TRUE);
                set(FG_COMMON, F_COMMON_C_REBECCA_UNDER_ATTACK, FALSE);
                evt_exec(0, TASK_09, rebecca_scream_heard);
            }
        }
    }
}

event tilt_broken_shotgun
{
    evt_work_set(WK_AOT, IMDL_00_KEY_BROKEN_SHOTGUN);
    evt_tween_begin_alt();
    tw_abs_rot(0, -100, -2000, -1100);
    tw_end();
    evt_nop();
    evt_finish();
}

event rebecca_scream_heard
{
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_RUN, F_RUN_MONSTERS, FALSE);
    voice_play(VOICE_PLAY, VO_A00_00);
    wait_message();
    evt_fork(TASK_09, rebecca_scream_heard_chris, 0);
    sleep(100);
    run
    {
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_RUN, F_RUN_MONSTERS, TRUE);
    }
    evt_finish();
}

event rebecca_scream_heard_chris
{
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_anim_flags(ANIM_2F, F_ROOM_ANIM_DONE, 0);
    act_param_set(0, 2048);
    sleep(42);
    act_idle();
    act_finish();
}
