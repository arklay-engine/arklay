#version 1

#include "inc/doors.akinc"
#include "inc/enemies.akinc"
#include "inc/flags.akinc"
#include "inc/items.akinc"
#include "inc/messages.akinc"
#include "inc/movies.akinc"
#include "inc/rooms.akinc"

#define AOT_00_DOOR_408 0x00
#define AOT_01_MESSAGE_LOCKED_AGAIN 0x01
#define AOT_02_USEITEM_VINES 0x02                           // Raises F_ROOM_PLAYER_AT_VINES while the player is inside.
#define AOT_03_ITEM_KEY_MANSION_HELMET_0 0x03
#define AOT_05_EVENT_DOOR_VINES 0x05                        // Over the 408 door while the vines block it.
#define AOT_06_MESSAGE_SHINING_OUT_OF_REACH 0x06
#define AOT_07_EVENT_BARRY 0x07
#define AOT_08_USEITEM_NEAR_BARRY 0x08                      // Raises F_ROOM_J_PLAYER_NEAR_BARRY while Jill is inside.
#define AOT_09_USEITEM_NEAR_BARRY 0x09                      // Raises F_ROOM_J_PLAYER_NEAR_BARRY while Jill is inside.
#define CAM_00 0x00
#define CAM_04 0x04
#define CAM_05 0x05
#define CAM_06_DOOR_VINES 0x06                              // Likely: shows the vines closing on the 408 door.
#define CAM_07_REBECCA_ENTERS 0x07
#define ENEMY_00_PLANT_42 0x00
#define ENEMY_01_PLANT_42 0x01
#define ENEMY_02_PLANT_42 0x02
#define ENEMY_03_PLANT_42 0x03
#define ENEMY_04_PLANT_42 0x04
#define ENEMY_05_PLANT_42 0x05
#define ENEMY_06_NPC_BARRY_2_STARS 0x06
#define ENEMY_06_NPC_REBECCA 0x06
#define FX_0B 0x0B
#define FX_14 0x14
#define F_ROOM_ANIM_DONE 0x3F                               // Every actor's animation-finished bit here; nothing waits on it.
#define F_ROOM_BGM_FADE_STARTED 0x0B                        // Run-once guard for the music fade after Plant 42 dies.
#define F_ROOM_BOSS_BGM_ON 0x0A                             // The boss music (BGM_MAIN) is playing; main fades it when Plant 42 dies.
#define F_ROOM_DOOR_VINES_DONE 0x0D                         // Likely: the vines-on-the-door scene played; main stops swapping the 408 door and its vine event.
#define F_ROOM_J_BARRY_COMES 0x0F                           // Barry joins the Plant 42 fight in this game.
#define F_ROOM_J_BARRY_HERE 0x0C                            // Barry stays in the room after the fight: his talk spot can open.
#define F_ROOM_J_PLAYER_NEAR_BARRY 0x3D                     // Likely: Jill stands by Barry (raised while she is inside AOT_08/09).
#define F_ROOM_J_RESCUE_STARTED 0x0E                        // Run-once guard for Barry's rescue scene.
#define F_ROOM_PLAYER_AT_VINES 0x3E                         // Likely: the player stands at the vines before the helmet key (raised while inside AOT_02).
#define F_ROOM_SUB_BGM_ON 0x09                              // BGM_SUB_1 (the intro or Barry music) is playing; main fades it when Plant 42 dies.
#define IMDL_00_KEY_MANSION_HELMET 0x00
#define MSG_VO_00A_10 0x00
#define MSG_VO_00A_11 0x01
#define MSG_VO_00A_13 0x02
#define MSG_VO_00A_14 0x03
#define MSG_VO_10C_01 0x04
#define MSG_VO_10C_02 0x05
#define MSG_VO_10C_03 0x06
#define MSG_VO_10C_04 0x07
#define MSG_VO_10C_06 0x09
#define MSG_VO_10C_07 0x0A
#define MSG_VO_10C_08 0x08
#define SE_DOOR_00 0x00
#define SE_DOOR_01 0x01
#define VO_00A_00 0x07
#define VO_00A_10 0x09
#define VO_00A_11 0x0A
#define VO_00A_12 0x0B
#define VO_00A_13 0x0C
#define VO_00A_14 0x0D
#define VO_10C_01 0x1C
#define VO_10C_02 0x1D
#define VO_10C_03 0x1E
#define VO_10C_04 0x1F
#define VO_10C_06 0x21
#define VO_10C_07 0x22
#define VO_10C_08 0x20

proc init
{
    door_aot_set(AOT_00_DOOR_408, 1100, 8000, 1500, 3900, 11, DOOR_SND_00_DR_WD, DOOR_00_DOOR00, 1, 0, ROOM_408_HONEYCOMB_PASSAGE, 26000, 0, 4000, 2048, UNLOCKED, SAT_MANUAL | SAT_PLAYER);
    aot_set(AOT_01_MESSAGE_LOCKED_AGAIN, 1000, 12400, 1500, 3000, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER, 140, 0, 255, 0, 0, 0);
    aot_set(AOT_02_USEITEM_VINES, 9800, 16600, 2200, 1200, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 62, 0, 1, 0);
    item_aot_set(AOT_03_ITEM_KEY_MANSION_HELMET_0, 9800, 17700, 2200, 1800, IT_36_KEY_MANSION_HELMET, 3, IMDL_00_KEY_MANSION_HELMET, SCA_NONE, 10550, -460, 18010, 1024, F_ITEM_40C_KEY_MANSION_HELMET_0, 0, 0);
    eml_rot(IMDL_00_KEY_MANSION_HELMET, 250, -2020);
    if (CHRIS)
    {
        aot_set(AOT_05_EVENT_DOOR_VINES, 1100, 8000, 1500, 3900, SCE_EVENT, 0, 9, 0, vines_block_door, 0, 0, 0);
    }
    else
    {
        aot_set(AOT_05_EVENT_DOOR_VINES, 1100, 8000, 1500, 3900, SCE_EVENT, 0, 9, 0, rebecca_intro_or_vines_block_door, 0, 0, 0);
    }
    aot_set(AOT_06_MESSAGE_SHINING_OUT_OF_REACH, 9800, 17200, 1700, 1100, SCE_MESSAGE, 0, 139, 0, 255, 0, 0, 0);
    if (CHRIS)
    {
        room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_MAIN_ON);
        set(FG_ROOM, F_ROOM_BOSS_BGM_ON, TRUE);
        if (ck(FG_COMMON, F_COMMON_C_PLANT42_ROOM_ENTERED, FALSE))
        {
            enemy(EM_08_PLANT_42, EB_40, F_ENEMY_40C_PLANT_42_0, SPAWN_FORCE, 2, 0, 3572, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_45, NO_FLAG, SPAWN_FORCE, 2, 0, 500, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 1500, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_23_NPC_REBECCA, EB_02, NO_FLAG, SPAWN_FORCE, 2, 0, 2500, 0, 27200, 0, 13500, ENEMY_06_NPC_REBECCA, ANIM_2A, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_C_PLANT42_ROOM_ENTERED, TRUE) && ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, TRUE))
        {
            enemy(EM_08_PLANT_42, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 10800, 200, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
            room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_OFF);
            set(FG_ROOM, F_ROOM_BOSS_BGM_ON, FALSE);
        }
        if (ck(FG_COMMON, F_COMMON_C_PLANT42_ROOM_ENTERED, TRUE) && ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, FALSE) && ck(FG_COMMON, F_COMMON_PLANT42_OBJ, TRUE))
        {
            enemy(EM_08_PLANT_42, EB_46, F_ENEMY_40C_PLANT_42_0, SPAWN_FORCE, 2, 0, 1024, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 1524, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 512, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_45, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, ANIM_00, 0, EVAR_00);
            enemy(EM_08_PLANT_42, EB_41, NO_FLAG, SPAWN_FORCE, 2, 0, 3572, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, ANIM_00, 0, EVAR_00);
        }
        if (ck(FG_COMMON, F_COMMON_C_PLANT42_ROOM_ENTERED, TRUE) && ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, FALSE) && ck(FG_COMMON, F_COMMON_PLANT42_OBJ, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_PLANT42_DEAD, TRUE))
            {
                enemy(EM_08_PLANT_42, EB_08, F_ENEMY_40C_PLANT_42_0, SPAWN_FORCE, 2, 0, 1024, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 2024, 0, 10800, -7000, 11200, ENEMY_01_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_05, NO_FLAG, SPAWN_FORCE, 2, 0, 3572, 0, 10400, -7000, 10400, ENEMY_02_PLANT_42, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_08_PLANT_42, EB_00, F_ENEMY_40C_PLANT_42_0, SPAWN_FORCE, 2, 0, 1024, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 1524, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 512, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_05, NO_FLAG, SPAWN_FORCE, 2, 0, 3072, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 3572, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, ANIM_00, 0, EVAR_00);
            }
        }
        if (ck(FG_COMMON, F_COMMON_C_PLANT42_ROOM_ENTERED, FALSE))
        {
            set(FG_COMMON, F_COMMON_C_PLANT42_ROOM_ENTERED, TRUE);
            if (ck(FG_COMMON, F_COMMON_C_REBECCA_IN_SAVE_ROOM, FALSE) && ck(FG_COMMON, F_COMMON_RICHARD_DIED, FALSE))
            {
                if (ck(FG_COMMON, F_COMMON_C_REBECCA_RAN_FOR_SERUM, TRUE))
                {
                    if (ck(FG_COMMON, F_COMMON_C_REBECCA_SERUM_QUICK, TRUE))
                    {
                        room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD | 1);
                        set(FG_ROOM, F_ROOM_BOSS_BGM_ON, FALSE);
                        evt_exec(0, TASK_09, rebecca_intro_or_vines_block_door);
                    }
                    else
                    {
                        evt_exec(0, TASK_09, plant42_wakes_alone);
                    }
                }
                else
                {
                    room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD | 1);
                    set(FG_ROOM, F_ROOM_BOSS_BGM_ON, FALSE);
                    evt_exec(0, TASK_09, rebecca_intro_or_vines_block_door);
                }
            }
            else
            {
                evt_exec(0, TASK_09, plant42_wakes_alone);
            }
        }
        else if (ck(FG_COMMON, F_COMMON_PLANT42_OBJ, TRUE))
        {
            set(FG_COMMON, F_COMMON_PLANT42_OBJ, FALSE);
            set(FG_SCENARIO, F_SCENARIO_PLANT42_DEAD, TRUE);
            room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD);
            set(FG_ROOM, F_ROOM_BOSS_BGM_ON, FALSE);
            evt_exec(0, TASK_09, plant42_withers_or_jill_talk_gestures);
        }
    }
    else
    {
        aot_set(AOT_07_EVENT_BARRY, 3229, 10452, 1800, 1800, SCE_EVENT, 0, 9, 0, talk_to_barry, 0, 0, 0);
        aot_set(AOT_08_USEITEM_NEAR_BARRY, 3800, 12000, 1300, 800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
        aot_set(AOT_09_USEITEM_NEAR_BARRY, 4800, 11100, 1500, 1300, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
        if (ck(FG_COMMON, F_COMMON_J_BARRY_002_TALK, FALSE))
        {
            set(FG_ROOM, F_ROOM_J_BARRY_COMES, TRUE);
        }
        if (ck(FG_COMMON, F_COMMON_J_BARRY_ACID_ROUNDS, TRUE))
        {
            set(FG_ROOM, F_ROOM_J_BARRY_COMES, TRUE);
        }
        if (ck(FG_SCENARIO, F_SCENARIO_V_JOLT_ON_ROOTS, TRUE))
        {
            set(FG_ROOM, F_ROOM_J_BARRY_COMES, FALSE);
            set(FG_SCENARIO, F_SCENARIO_PLANT42_DEAD, TRUE);
        }
        if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, FALSE))
        {
            room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_MAIN_ON);
            set(FG_ROOM, F_ROOM_BOSS_BGM_ON, TRUE);
        }
        if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, FALSE))
        {
            if (ck(FG_SCENARIO, F_SCENARIO_PLANT42_DEAD, FALSE))
            {
                if (ck(FG_ROOM, F_ROOM_J_BARRY_COMES, TRUE))
                {
                    room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_RELOAD | 1);
                    set(FG_ROOM, F_ROOM_BOSS_BGM_ON, FALSE);
                    enemy(EM_2B_NPC_BARRY_2_STARS, EB_05, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 10000, 0, 30000, ENEMY_06_NPC_BARRY_2_STARS, ANIM_2A, 0, EVAR_00);
                    evt_exec(0, TASK_09, barry_rescue_bgm);
                }
                enemy(EM_08_PLANT_42, EB_00, F_ENEMY_40C_PLANT_42_0, SPAWN_FORCE, 2, 0, 3572, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 10800, -7000, 11200, ENEMY_02_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 2048, 0, 11200, -7000, 11200, ENEMY_03_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_05, NO_FLAG, SPAWN_FORCE, 2, 0, 500, 0, 10400, -7000, 10800, ENEMY_04_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 1500, 0, 10800, -7000, 10400, ENEMY_05_PLANT_42, ANIM_00, 0, EVAR_00);
            }
            else
            {
                enemy(EM_08_PLANT_42, EB_08, F_ENEMY_40C_PLANT_42_0, SPAWN_FORCE, 2, 0, 3572, 0, 10800, -7000, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_01, NO_FLAG, SPAWN_FORCE, 2, 0, 0, 0, 11200, -7000, 10800, ENEMY_01_PLANT_42, ANIM_00, 0, EVAR_00);
                enemy(EM_08_PLANT_42, EB_05, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 10400, -7000, 11200, ENEMY_02_PLANT_42, ANIM_00, 0, EVAR_00);
            }
        }
        else
        {
            enemy(EM_08_PLANT_42, EB_04, NO_FLAG, SPAWN_FORCE, 2, 0, 1024, 0, 10800, 200, 10800, ENEMY_00_PLANT_42, ANIM_00, 0, EVAR_00);
            room_bgm_state_set(3, ROOM_40C_PLANT_BOSS_ROOM, BGM_OFF);
            set(FG_ROOM, F_ROOM_BOSS_BGM_ON, FALSE);
            if (ck(FG_ROOM, F_ROOM_J_BARRY_COMES, TRUE) && ck(FG_COMMON, F_COMMON_J_BARRY_405_SCENE, FALSE))
            {
                aot_set(AOT_07_EVENT_BARRY, 6862, 8109, 1800, 1800, SCE_EVENT, SAT_MANUAL | SAT_PLAYER, 9, 0, talk_to_barry, 0, 0, 0);
                aot_set(AOT_08_USEITEM_NEAR_BARRY, 7600, 9900, 1300, 800, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
                aot_set(AOT_09_USEITEM_NEAR_BARRY, 8300, 8800, 1500, 1300, SCE_USEITEM, SAT_UNDER | SAT_PLAYER, 4, 0, 61, 0, 1, 0);
                enemy(EM_2B_NPC_BARRY_2_STARS, EB_05, NO_FLAG, SPAWN_FORCE, 2, 0, 3873, 0, 7762, 0, 9009, ENEMY_06_NPC_BARRY_2_STARS, ANIM_2A, 0, EVAR_00);
                set(FG_ROOM, F_ROOM_J_BARRY_HERE, TRUE);
                evt_exec(0, TASK_09, barry_idle);
            }
        }
    }
    set(FG_SCENARIO, F_SCENARIO_PLANT42_ROOM_ENTERED, TRUE);
}

proc main
{
    if (ck(FG_ROOM, F_ROOM_PLAYER_AT_VINES, TRUE) && ck(FG_ITEM, F_ITEM_40C_KEY_MANSION_HELMET_0, TRUE))
    {
        if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, TRUE))
        {
            aot_delete(AOT_06_MESSAGE_SHINING_OUT_OF_REACH, SCE_MESSAGE, 0);
            aot_delete(AOT_03_ITEM_KEY_MANSION_HELMET_0, SCE_ITEM, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_06_MESSAGE_SHINING_OUT_OF_REACH, SCE_MESSAGE, SAT_MANUAL | SAT_PLAYER);
            aot_delete(AOT_03_ITEM_KEY_MANSION_HELMET_0, SCE_ITEM, 0);
        }
    }
    if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, TRUE))
    {
        set(FG_SCENARIO, F_SCENARIO_STAGE_VARIANT, TRUE);
    }
    if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, TRUE) && ck(FG_ROOM, F_ROOM_BOSS_BGM_ON, TRUE) && ck(FG_ROOM, F_ROOM_BGM_FADE_STARTED, FALSE))
    {
        set(FG_ROOM, F_ROOM_BGM_FADE_STARTED, TRUE);
        if (CHRIS)
        {
            evt_exec(0, TASK_09, fade_boss_bgm);
        }
        else
        {
            evt_exec(0, TASK_09, fade_boss_bgm);
        }
    }
    if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, TRUE) && ck(FG_ROOM, F_ROOM_SUB_BGM_ON, TRUE) && ck(FG_ROOM, F_ROOM_BGM_FADE_STARTED, FALSE))
    {
        set(FG_ROOM, F_ROOM_BGM_FADE_STARTED, TRUE);
        if (CHRIS)
        {
            evt_exec(0, TASK_09, fade_sub_bgm);
        }
        else
        {
            evt_exec(0, TASK_09, fade_sub_bgm);
        }
    }
    if (CHRIS)
    {
        if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, TRUE) && ck(FG_ROOM, F_ROOM_DOOR_VINES_DONE, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_40C_KEY_MANSION_HELMET_0, TRUE))
            {
                aot_delete(AOT_05_EVENT_DOOR_VINES, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_00_DOOR_408, SCE_DOOR, 0);
            }
            else
            {
                aot_delete(AOT_00_DOOR_408, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_05_EVENT_DOOR_VINES, SCE_EVENT, 0);
            }
        }
    }
    else
    {
        if (ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, TRUE) && ck(FG_ROOM, F_ROOM_DOOR_VINES_DONE, FALSE))
        {
            if (ck(FG_ITEM, F_ITEM_40C_KEY_MANSION_HELMET_0, TRUE))
            {
                aot_delete(AOT_05_EVENT_DOOR_VINES, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_00_DOOR_408, SCE_DOOR, 0);
            }
            else
            {
                aot_delete(AOT_00_DOOR_408, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
                aot_delete(AOT_05_EVENT_DOOR_VINES, SCE_EVENT, 0);
            }
        }
        if (ck(FG_ROOM, F_ROOM_J_BARRY_COMES, TRUE) && ck(FG_ENEMY, F_ENEMY_40C_PLANT_42_0, FALSE) && ck(FG_SCENARIO, F_SCENARIO_PLANT42_DEAD, TRUE) && ck(FG_ROOM, F_ROOM_J_RESCUE_STARTED, FALSE))
        {
            set(FG_ROOM, F_ROOM_J_RESCUE_STARTED, TRUE);
            set(FG_RUN, F_RUN_CONTROLS, FALSE);
            evt_exec(0, TASK_09, barry_rescues_jill);
        }
        if (ck(FG_ROOM, F_ROOM_J_BARRY_HERE, TRUE) && ck(FG_ROOM, F_ROOM_J_PLAYER_NEAR_BARRY, TRUE))
        {
            aot_delete(AOT_07_EVENT_BARRY, SCE_EVENT, SAT_MANUAL | SAT_PLAYER);
        }
        else
        {
            aot_delete(AOT_07_EVENT_BARRY, SCE_EVENT, 0);
        }
    }
}

