{
    if (CHRIS)
    {
        sleep(30);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_30, F_ROOM_ANIM_DONE, 0);
        act_reset();
        evt_nop();
        sleep(10);
        effect_tracked(FX_14, FX_ROW_00, FX_AT_WORLD, 6800, 60736, 14000, 2048);
        sleep(55);
        effect_kill_a(0);
        effect_tracked(FX_14, FX_ROW_00, FX_AT_WORLD, 3000, 0, 11500, 0);
        evt_actor_begin();
        act_nop();
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        sleep(75);
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        sleep(20);
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        sleep(60);
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        sleep(70);
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE, 0);
        sleep(30);
        act_anim_flags(ANIM_23, F_ROOM_ANIM_DONE, 0);
    }
    sleep(20);
    if (CHRIS)
    {
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        sleep(60);
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        sleep(70);
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        sleep(80);
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
    }
    else
    {
        act_anim_flags(ANIM_24, F_ROOM_ANIM_DONE, 0);
        sleep(12);
        act_anim_flags(ANIM_22, F_ROOM_ANIM_DONE, 0);
        sleep(10);
        act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    }
    act_flag_op(EF_OR, EF_0010);
    act_finish();
}

