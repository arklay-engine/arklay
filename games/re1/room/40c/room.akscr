event intro_rebecca_leaves
{
    evt_work_set(WK_ENEMY, ENEMY_06_NPC_REBECCA);
    evt_actor_begin();
    act_anim_seq(AB_05, 2438, 11055, F_ROOM_ANIM_DONE);
    act_nop();
    sleep(60);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    sleep(25);
    act_motion_path(MOTION_71, 400, 0, 2, 150, 50);
    act_anim_flags(ANIM_22, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    sleep(15);
    act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    sleep(35);
    act_anim_flags(ANIM_2F, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_param_set(0, 2048);
    act_flag_op(EF_OR, EF_0002);
    act_finish();
}
event talk_to_barry
{
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion_path(MOTION_TARGET, LOOK_AT_ENEMY, ENEMY_06_NPC_BARRY_2_STARS, 0, 150, 75);
    act_reset();
    evt_nop();
    evt_fork(TASK_09, talk_to_barry_gestures, 0);
    voice_play(VOICE_PLAY, VO_10C_06);
    message(MSG_VO_10C_06, 0);
    wait_message();
    evt_fork(TASK_09, plant42_withers_or_jill_talk_gestures, 0);
    voice_play(VOICE_PLAY, VO_10C_07);
    message(MSG_VO_10C_07, 0);
    wait_message();
    evt_work_set(WK_ENEMY, ENEMY_06_NPC_BARRY_2_STARS);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_reset();
    evt_nop();
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    act_motion(MOTION_10);
    act_idle();
    act_reset();
    run
    {
        cut_auto(CUT_FREE);
        set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
    }
    evt_finish();
}

event plant42_wakes_alone
{
    run
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
        dir_set(0, 0, 0, 0, 2622, 0, 14077);
        eml_state(0, ENEMY_00_PLANT_42, EML_STATUS, EML_STATUS_OR | 2);
        eml_state(0, ENEMY_01_PLANT_42, EML_STATUS, EML_STATUS_OR | 2);
        eml_state(0, ENEMY_02_PLANT_42, EML_STATUS, EML_STATUS_OR | 2);
        eml_state(0, ENEMY_03_PLANT_42, EML_STATUS, EML_STATUS_OR | 2);
        eml_state(0, ENEMY_04_PLANT_42, EML_STATUS, EML_STATUS_OR | 2);
        eml_state(0, ENEMY_05_PLANT_42, EML_STATUS, EML_STATUS_OR | 2);
    }
    sleep(1);
    set(FG_RUN, F_RUN_CONTROLS, FALSE);
    evt_fork(TASK_09, plant42_wakes_actors, 0);
    sleep(160);
    eml_state(0, ENEMY_00_PLANT_42, EML_ACTION, AB_0A);
    sleep(100);
    eml_state(0, ENEMY_00_PLANT_42, EML_ACTION, AB_0C);
    sleep(200);
    run
    {
        eml_state(0, ENEMY_00_PLANT_42, EML_BEHAVIOUR, EB_00);
        eml_state(0, ENEMY_01_PLANT_42, EML_BEHAVIOUR, EB_01);
        eml_state(0, ENEMY_02_PLANT_42, EML_BEHAVIOUR, EB_01);
        eml_state(0, ENEMY_03_PLANT_42, EML_BEHAVIOUR, EB_01);
        eml_state(0, ENEMY_04_PLANT_42, EML_BEHAVIOUR, EB_01);
        eml_state(0, ENEMY_05_PLANT_42, EML_BEHAVIOUR, EB_01);
        eml_state(0, ENEMY_00_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_01_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_02_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_03_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_04_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
        eml_state(0, ENEMY_05_PLANT_42, EML_STATUS, EML_STATUS_XOR | 2);
    }
    set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
    set(FG_RUN, F_RUN_CONTROLS, TRUE);
    evt_finish();
}
