event plant42_withers_or_jill_talk_gestures
{
    if (CHRIS)
    {
        set(FG_STATUS, F_STATUS_LETTERBOX, TRUE);
    }
    evt_work_set(WK_PLAYER, 0);
    evt_actor_begin();
    if (CHRIS)
    {
        act_anim_flags(ANIM_3F, F_ROOM_ANIM_DONE, 0);
        act_flag_op(EF_OR, EF_0010);
        act_reset();
        evt_nop();
        evt_work_set(WK_ENEMY, ENEMY_00_PLANT_42);
        evt_tween_begin_alt();
        tw_abs_rot(0, 0, 2600, -500);
        tw_end();
        evt_nop();
        sleep(1);
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        sleep(100);
        eml_state(0, ENEMY_00_PLANT_42, EML_ACTION, AB_0C);
        sleep(30);
        eml_state(0, ENEMY_01_PLANT_42, EML_ACTION, AB_0E);
        sleep(30);
        eml_state(0, ENEMY_03_PLANT_42, EML_ACTION, AB_0E);
        sleep(30);
        eml_state(0, ENEMY_05_PLANT_42, EML_ACTION, AB_0E);
    }
    else
    {
        act_anim_flags(ANIM_21, F_ROOM_ANIM_DONE, 0);
    }
    sleep(20);
    if (CHRIS)
    {
        cutnext(CAM_05);
        run
        {
            eml_state(0, ENEMY_00_PLANT_42, EML_ACTION, AB_0F);
            eml_state(0, ENEMY_02_PLANT_42, EML_ACTION, AB_0F);
            eml_state(0, ENEMY_04_PLANT_42, EML_ACTION, AB_0F);
        }
        sleep(340);
        run
        {
            bgm_play(BGM_MAIN);
            set(FG_ROOM, F_ROOM_BOSS_BGM_ON, TRUE);
            eml_state(0, ENEMY_00_PLANT_42, EML_BEHAVIOUR, EB_08);
            eml_state(0, ENEMY_02_PLANT_42, EML_BEHAVIOUR, EB_01);
            eml_state(0, ENEMY_04_PLANT_42, EML_BEHAVIOUR, EB_01);
            set(FG_STATUS, F_STATUS_LETTERBOX, FALSE);
            set(FG_RUN, F_RUN_CONTROLS, TRUE);
            cutnext(CAM_00);
            cut_auto(CUT_FREE);
        }
        evt_finish();
    }
    else
    {
        act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE, 0);
        act_flag_op(EF_OR, EF_0010);
        act_finish();
    }
}

event vines_block_door
{
    run
    {
        set(FG_RUN, F_RUN_CONTROLS, FALSE);
        dir_set(0, 0, 1716, 0, 2439, 0, 9876);
        cutnext(CAM_06_DOOR_VINES);
    }
    effect(FX_0B, FX_ROW_15, FX_AT_WORLD, 12700, 0, 20600, 0);
    sleep(30);
    effect(FX_0B, FX_ROW_15, FX_AT_WORLD, 12700, 0, 20600, 0);
    sleep(30);
    aot_delete(AOT_00_DOOR_408, SCE_DOOR, SAT_MANUAL | SAT_PLAYER);
    aot_delete(AOT_05_EVENT_DOOR_VINES, SCE_EVENT, 0);
    run
    {
        cutnext(CAM_00);
        set(FG_RUN, F_RUN_CONTROLS, TRUE);
        set(FG_ROOM, F_ROOM_DOOR_VINES_DONE, TRUE);
        cut_auto(CUT_FREE);
    }
    evt_finish();
}
event barry_idle
{
    sleep(1);
    evt_work_set(WK_ENEMY, ENEMY_06_NPC_BARRY_2_STARS);
    evt_actor_begin();
    act_anim_flags(ANIM_2A, F_ROOM_ANIM_DONE, AFL_02 | AFL_01);
    act_flag_op(EF_OR, EF_0010);
    act_finish();
}

event barry_rescue_bgm
{
    sleep(1);
    bgm_play(BGM_SUB_1);
    set(FG_ROOM, F_ROOM_SUB_BGM_ON, TRUE);
    evt_finish();
}

event fade_boss_bgm
{
    bgm_volume_ramp(BGM_MAIN, -96, 30);
    sleep(30);
    bgm_stop(BGM_MAIN);
    set(FG_ROOM, F_ROOM_BOSS_BGM_ON, FALSE);
    evt_finish();
}

event fade_sub_bgm
{
    bgm_volume_ramp(BGM_SUB_1, -96, 30);
    sleep(30);
    bgm_stop(BGM_SUB_1);
    set(FG_ROOM, F_ROOM_SUB_BGM_ON, FALSE);
    evt_finish();
}
