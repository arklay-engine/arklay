  <strings>
    <language lang="en-US">
      <string key="name">FALLS</string>
      <string key="save_name">Courtyard Room B1</string>
      <string key="0">The water is running from\nthe upper water passage.{clear 0}There's something in the\nback.</string>
      <string key="1">\nThe battery is pulled out.</string>
      <string key="2">\nNothing major.</string>
      <string key="3">There's a ladder. Will\nyou descend it?{branch 0 1 0}I've got to get power to\nthe elevator.</string>
      <string key="4">I've got to get power to\nthe elevator.</string>
    </language>
    <language lang="ja-JP">
      <string key="save_name">中庭 {s}部屋/{s}B{s}1{s}</string>
      <string key="0">\n 上の用水路から流れてきている{clear 0}{scroll 2}\n   滝の奥には何かがあるようだ</string>
      <string key="1">\n   バッテリーが抜かれている</string>
      <string key="2">\n      特に何もない</string>
      <string key="3">      ハシゴがある\n下りますか?{branch 0 1 0}\n エレベーターの電力を確保しなければ</string>
      <string key="4">\n エレベーターの電力を確保しなければ</string>
    </language>
    <language lang="fr-FR">
      <string key="save_name">Salle de la cour SS1</string>
      <string key="0">L'eau vient du conduit \nd'eau en haut.{clear 0}\nIl y a quelque chose au fond.</string>
      <string key="1">\nLa batterie a été arrachée.</string>
      <string key="2">\nRien d'important.</string>
      <string key="3">Il y a une échelle.\nDescendre?{branch 0 6 0}</string>
      <string key="4">Il faut que je branche\nl'ascenseur.</string>
    </language>
    <language lang="de-DE">
      <string key="0">Das Wasser fließt vom\noberen Wasserlauf herunter.{clear 0}\nDa ist etwas dahinter.</string>
      <string key="1">\nDie Batterie wurde entfernt.</string>
      <string key="2">\nNichts von Bedeutung.</string>
      <string key="3">\nDa ist eine Leiter.{clear 0}Möchten Sie hinuntersteigen?{branch 0 6 0}</string>
      <string key="4">Ich muss irgendwoher Strom\nfür den Aufzug bekommen.</string>
    </language>
    <language lang="it-IT">
      <string key="save_name">Cortile S1</string>
      <string key="0">L'acqua sta scorrendo dal \npassaggio superiore.{clear 0}\nC'è qualcosa dietro.</string>
      <string key="1">\nLa batteria è stata rimossa.</string>
      <string key="2">\nNiente di importante.</string>
      <string key="3">C'è una scala.\nVuoi scendere?{branch 0 6 0}</string>
      <string key="4">Devo dare energia \nall'ascensore.</string>
    </language>
    <language lang="es-ES">
      <string key="0">El agua viene del\nconducto de arriba...{clear 0}{scroll 2}\nHay algo detrás...</string>
      <string key="1">\nHan quitado la batería...</string>
      <string key="2">\nAhora la batería está en su sitio...</string>
      <string key="3">Hay una escalera...\n¿quieres bajar?{branch 0 6 0}</string>
      <string key="4">Tengo que conectar \nla corriente del ascensor...</string>
    </language>
    <language lang="ru-RU">
      <string key="save_name">Комната внутр. двора Б1</string>
      <string key="0">Сверху льётся\nвода.{clear 0}\nЗа ней что-то есть.</string>
      <string key="1">\nБатарея отсутствует.</string>
      <string key="2">\nНичего особенного.</string>
      <string key="3">Здесь лестница.\nСпуститься по ней?{branch 0 1 0}Мне нужно найти\nбатарею для лифта.</string>
      <string key="4">Мне нужно найти\nбатарею для лифта.</string>
    </language>
    <language lang="fi-FI">
      <string key="save_name">Maanalainen varasto 0 krs</string>
      <string key="0">Vesi virtaa yläpuolelta...{clear 0}Virtauksen takana on jotakin...</string>
      <string key="1">Akku on irroitettu...</string>
      <string key="2">Ei mitään merkittävää...</string>
      <string key="3">Siinä on tikkaat...\nLaskeudutko niitä?{branch 0 6 0}</string>
      <string key="4">Sinun on saatava hissiin virtaa...</string>
    </language>
  </strings>
</room>
