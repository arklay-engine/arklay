// Flag bits by group: `ck(FG_COMMON, F_COMMON_INTRO_SEEN, TRUE)`.
// F_<group>_<bit> is a bit not yet named; a room's own FG_ROOM bits are
// defined in its script. Named bits say what they mean when set:
// - F_ITEM_<room>_<item>_<model>: the pickup with that IT_ name (less its
//   id) and IMDL slot, set while it is still there;
// - F_ENEMY_<room>_<type>_<slot>: the enemy with that EM_ name (less its id)
//   in that room's ENEMY_ slot, set once it is dead;
// - F_LOCK_<room>_<room>: the door between the two rooms, set once unlocked;
// - _J_ / _C_ after the group: the bit means this only in Jill's / Chris's
//   game. A bit both games use for different things has a define for each,
//   and each use takes the name of its player's branch.

#define F_SCENARIO_STAGE_VARIANT 0x00                       // Stage changes go to the +5 stage variants while set (engine).
#define F_SCENARIO_LAB_ELEVATOR_POWERED 0x01                // The B4 elevator switch was pushed with both power bits set (50c); the elevator to 515 works.
#define F_SCENARIO_113_BATHTUB_DRAINED 0x02                 // Chris drained the bathtub and the desk key is out (113); Jill's bathroom has no such scene.
#define F_SCENARIO_GALLERY_PUZZLE_SOLVED 0x03               // The large gallery's picture switches were pressed in order: the frame fell and the star crest is out (117).
#define F_SCENARIO_BOILER_DOGS_SCENE 0x04                   // Likely: the scripted Cerberus attack in 114 has played; the dogs then spawn in place.
#define F_SCENARIO_DEER_ROOM_ZOMBIE_IN 0x05                 // A zombie from 207 burst into 208 (Jill; Chris's game sets it in 204 to skip the scene).
#define F_SCENARIO_STOVE_LIT 0x08                           // The lighter lit 20B's stove and burned the paper off the 2F map.
#define F_SCENARIO_RIGHT_STAIRS_VISITED 0x09                // Guess: set on entering 10B in the first mansion; lighting the 20B fireplace clears it, and once it is set again 20B has its zombies and no fire.
#define F_SCENARIO_CANDLE_LIT 0x0A                          // The candle in 20F was lit with the lighter: the room is lit and its item can be taken.
#define F_SCENARIO_BALCONY_STATUE_PUSHED 0x0B               // Statue pushed off the 2F balcony (202); the blue jewel lies by it in 105.
#define F_SCENARIO_TIGER_MAGNUM_TAKEN 0x0C                  // The magnum was taken from the tiger statue (10D) after the red jewel went in.
#define F_SCENARIO_TIGER_WIND_CREST_TAKEN 0x0D              // The wind crest was taken from the tiger statue (10D) after the blue jewel went in.
#define F_SCENARIO_TIGER_RED_JEWEL_SET 0x0E                 // The red jewel is in the tiger's eye and the statue has turned to offer the magnum (10D); cleared when it is taken.
#define F_SCENARIO_TIGER_BLUE_JEWEL_SET 0x0F                // The blue jewel is in the tiger's eye and the statue has turned to offer the wind crest (10D); cleared when it is taken.
#define F_SCENARIO_YAWN_BITE 0x10                           // Set by the Yawn's bite (engine).
#define F_SCENARIO_KENNETH_EXAMINED 0x11                    // Removes Kenneth's examine spot in 104. Never set: no script or engine code writes it.
#define F_SCENARIO_AQUARIUM_DRAINED 0x12                    // The switch behind 20A's shelf drained the aquarium; it can now be pushed.
#define F_SCENARIO_V_JOLT_ON_ROOTS 0x13                     // The V-JOLT was used on the roots (40F); the engine then rejects item 0x13, the empty bottle.
#define F_SCENARIO_300_VISITED 0x14                         // Room 300 was entered; Brad's first radio call rings only on that first visit, with the radio.
#define F_SCENARIO_CHEMICAL_MIXED 0x16                      // A chemical combine was done (engine).
#define F_SCENARIO_LIBRARY_ENTERED 0x17                     // The library (216) was entered; a hunter now waits in 11A.
#define F_SCENARIO_304_VARIANT_VISITED 0x18                 // Room 304 was entered in the stage variant; Brad's second radio call rings only on that visit, with the radio.
#define F_SCENARIO_EAGLE_MEDAL_PLACED 0x1B                  // The eagle medal is in the fountain (305).
#define F_SCENARIO_WOLF_MEDAL_PLACED 0x1C                   // The wolf medal is in the fountain (305).
#define F_SCENARIO_FOUNTAIN_OPEN 0x1D                       // Both medals placed: the fountain has opened onto the stairs down (305).
#define F_SCENARIO_PANEL_VARIANT_A 0x1E                     // Picks the passcode panel's starting state (engine).
#define F_SCENARIO_PANEL_VARIANT_B 0x1F                     // Picks the passcode panel's starting state (engine).
#define F_SCENARIO_INTERACTIVE_SCREEN 0x20                  // An interactive screen is up (engine).
#define F_SCENARIO_PANEL_SOLVED 0x21                        // The lab passcode panel is solved (engine).
#define F_SCENARIO_WATER_DRAINED 0x23                       // The 411 lever drained the guardhouse water (40D, 40E, 40F, 411).
#define F_SCENARIO_BLANK_BOOK_SHELVED 0x24                  // The blank book was put in the V-JOLT report's gap on room 003's shelf (40A).
#define F_SCENARIO_BOOKCASE_SLID_ASIDE 0x25                 // Likely: room 003's bookcase stands slid aside (40A); cleared when the player steps into the gap toward 40C.
#define F_SCENARIO_BOOKCASE_SLIDE_PLAYED 0x26               // The bookcase slide scene in room 003 has played (40A).
#define F_SCENARIO_YAWN_2_APPEARED 0x27                     // Yawn burst into 20C (its second appearance).
#define F_SCENARIO_FIREPLACE_LADDER_OPEN 0x28               // The switch in 20C's fireplace slid it aside: the ladder down to 21A is open.
#define F_SCENARIO_PLANT42_DEAD 0x29                        // Plant 42 is dead (engine).
#define F_SCENARIO_ALT_OUTFIT 0x2A                          // The alternate outfit (engine).
#define F_SCENARIO_SELF_DESTRUCT_ON 0x2B                    // The lab's self-destruct sequence is running (511's panel, 505 for Chris alone, 514 for Jill).
#define F_SCENARIO_ELEVATOR_POWER_CONNECTED 0x2D            // The elevator power connection switch was connected (511).
#define F_SCENARIO_POWER_PANEL_ON 0x2E                      // The power panel turned on the blacked-out areas (50f).
#define F_SCENARIO_WATER_GATE_OPEN 0x2F                     // The water gate is open (301 crank): the channel there is drained and the water runs down the 302 falls.
#define F_SCENARIO_ELEVATOR_301_DOWN 0x30                   // The 301-302 elevator is down at 302.
#define F_SCENARIO_ELEVATOR_300_UP 0x31                     // The 300-302 elevator is up at 300.
#define F_SCENARIO_ELEVATOR_BATTERY_IN 0x32                 // The battery is in the 300-302 elevator's winch (302).
#define F_SCENARIO_KITCHEN_DOOR_FILM_SEEN 0x33              // The film at the 21C door to 110 has played; that door is open.
#define F_SCENARIO_PASS_CODE_1_ENTERED 0x34                 // Pass code 01 was entered at 508's double lock panel.
#define F_SCENARIO_PASS_CODE_2_ENTERED 0x35                 // Pass code 02 was entered at 508's double lock panel.
#define F_SCENARIO_PASS_CODE_3_ENTERED 0x36                 // Pass code 03 was entered at 508's double lock panel.
#define F_SCENARIO_TYRANT_1_DEAD 0x37                       // The first Tyrant died (513); the engine then gives Wesker his later animation (larger shadow, anim 0x30).
#define F_SCENARIO_BOXES_SUNK_BIT1 0x38                     // Boxes pushed into the 40D channel, high bit of a 0-3 count (with F_SCENARIO_BOXES_SUNK_BIT0).
#define F_SCENARIO_BOXES_SUNK_BIT0 0x39                     // Boxes pushed into the 40D channel, low bit of a 0-3 count (with F_SCENARIO_BOXES_SUNK_BIT1).
#define F_SCENARIO_ARMOR_SHOWCASE_OPEN 0x3A                 // Both armors cover 205's gas holes and the switch opened the showcase with the sun crest.
#define F_SCENARIO_ITEM_PASSAGE_WALL_MOVED 0x3C             // Likely: the crank slid the wall in the item passage (306) across; cranking again slides it back.
#define F_SCENARIO_30B_BOULDER_ROLLED 0x3D                  // The boulder in the rock passage (30B) has rolled.
#define F_SCENARIO_GUARDHOUSE_MAP_TAKEN 0x3E                // The dormitory map was taken from the sketch in room 002 (406).
#define F_SCENARIO_SLIDES_SHOWN 0x3F                        // The slides were shown on 504's projector.
#define F_SCENARIO_STUDY_VISITED 0x40                       // Set on the first visit to the study (119); nothing reads it.
#define F_SCENARIO_LIBRARY_SWITCH_ON 0x41                   // The wall switch in 217 is on (it toggles): sprite 7 shows and the floor spot can be examined.
#define F_SCENARIO_ADDERS_IN_30D 0x42                       // Reached the cave save room (30E) or the crank passage (30F): adders now appear in 30D.
#define F_SCENARIO_402_BATHTUB_DRAINED 0x43                 // The bathtub in room 001's bathroom was unplugged; the control room key lies in it (402).
#define F_SCENARIO_PLANT42_ROOM_ENTERED 0x44                // 40C has been entered: the 408 door to it opens instead of showing a message.
#define F_SCENARIO_UNDER_PASSAGE_ENTERED 0x45               // 40D has been entered: 406 keeps its shelves pushed off the ladder.
#define F_SCENARIO_J_PASS_NUMBER_ENTERED 0x46               // Jill entered the pass number at 201's keypad: the door to 214 opens.
#define F_SCENARIO_YAWN_SERUM 0x47                          // Serum marker: the first Yawn poisons only while clear (engine).
#define F_SCENARIO_PLANT42_OBJ_ACK 0x48                     // Plant 42 objective seen: stops the guardhouse map highlight.
#define F_SCENARIO_SERUM1_OBJ_ACK 0x49                      // Serum objective 1 seen: stops the mansion map highlight.
#define F_SCENARIO_SERUM2_OBJ_ACK 0x4A                      // Serum objective 2 seen: stops the mansion map highlight.
#define F_SCENARIO_CRANK_TURNS_BIT0 0x4A                    // Bit 0 of the crank passage's (30F) wall rotation count; 30F's reuse of F_SCENARIO_SERUM2_OBJ_ACK.
#define F_SCENARIO_CRANK_TURNS_BIT1 0x4B                    // Bit 1 of the crank passage's (30F) wall rotation count; bit 0 is 0x4A.
#define F_SCENARIO_30F_BOULDER_ROLLED 0x4C                  // The crank passage's (30F) boulder has rolled down the corridor.
#define F_SCENARIO_204_MAP_SHOWN 0x4D                       // Likely: after Richard was found, entering 204 opened the map-item display once.
#define F_SCENARIO_C_REBECCA_MAP_SHOWN 0x4E                 // Chris: Likely: the map screen opened once as Rebecca's serum run began (20D).
#define F_SCENARIO_HIDDEN_LIBRARY_ENTERED 0x4F              // The hidden library (218) was entered; 216's bookshelf stays pushed aside.
#define F_SCENARIO_DOUBLE_LOCK_OPENED 0x50                  // All three pass codes were entered and 508's double lock opened (plays its sound once).
#define F_SCENARIO_PLANT_HOLE_BLOCKED 0x51                  // Likely: the pushable block stands over the plant tentacle's hole in the entrance passage (400); rewritten every frame there.
#define F_SCENARIO_WATER_GATE_OPENED_ONCE 0x52              // The water gate was opened once; its "water is running down the opposite side" message has played (301).
#define F_SCENARIO_MONSTER_PLANT_HITS 0x5B                  // The monster plant took three or more hits (engine).
#define F_SCENARIO_PLANT_NO_DAMAGE_SHOWN 0x5C               // The greenhouse plant's "It does not seem to cause any damage" message was shown (10C).
#define F_SCENARIO_F_PASSAGE_HUNTER_AMBUSH 0x5D             // The hunter's ambush in the F passage (103) has played; it then spawns awake.
#define F_SCENARIO_TRAP_PASSAGE_HUNTER_AMBUSH 0x5E          // The hunter's ambush in the trap passage (109) has played; it then spawns awake.
#define F_SCENARIO_HELIPORT_SEEN 0x60                       // The heliport was seen from the 218 window.
#define F_SCENARIO_ROCK_PASSAGE_AMBUSH 0x61                 // The hunters' ambush in the rock passage (30B) has started.
#define F_SCENARIO_BOULDER_BGM 0x62                         // The boulder chase just ended: 30B keeps the after-chase music until 30C clears it.
#define F_SCENARIO_505_50C_LAMP_UNLOCKED 0x63               // The lamp at 505's power room door shows it unlocked (set once F_LOCK_505_50C is set).
#define F_SCENARIO_LAB_ELEVATOR_LIGHT_SET 0x64              // Guess: 50c swapped the elevator switch's light effect and camera nodes once after the elevator was powered.
#define F_SCENARIO_CELL_DOOR_TALK 0x65                      // The player talked to the captive partner through 50B's cell door.
#define F_SCENARIO_504_PILLAR_MOVED 0x66                    // The switch behind 504's wall panel was pushed; the pillar moved, freeing the power room key.
#define F_SCENARIO_J_BARRY_TERRACE_MISSED 0x67              // Jill: Jill reached the terrace when Barry's scene was not due; it can no longer play (212).
#define F_SCENARIO_LIBRARY_STATUE_PLACED 0x68               // The statue was pushed onto its spot in 217; the bookshelf slid aside to show the MO disk.
#define F_SCENARIO_SUN_CREST_PLACED 0x69                    // The sun crest is in the roofed passage's panel (11A).
#define F_SCENARIO_STAR_CREST_PLACED 0x6A                   // The star crest is in the roofed passage's panel (11A).
#define F_SCENARIO_MOON_CREST_PLACED 0x6B                   // The moon crest is in the roofed passage's panel (11A).
#define F_SCENARIO_WIND_CREST_PLACED 0x6C                   // The wind crest is in the roofed passage's panel (11A).
#define F_SCENARIO_DC_BEST_ENDING 0x7A                      // Director's Cut: ADVANCED cleared with the best ending; the Colt Python is unlimited (engine).
#define F_SCENARIO_SECOND_PLAYTHROUGH 0x7B                  // A run has been cleared; enemies, damage and endings use their second-playthrough variants.
#define F_SCENARIO_HAS_LOCKPICK 0x7C                        // Jill took Barry's lockpick (106); desks take it instead of the small key.
#define F_SCENARIO_FADE_MENU_LATCH 0x7D                     // Picks the fade-in at gameplay entry; cleared when the menu closes (engine).
#define F_SCENARIO_ROCKET_UNLOCK 0x7E                       // The rocket launcher is unlocked for the next run (engine).
#define F_SCENARIO_HAS_RADIO 0x7F                           // The radio was picked up (engine).

#define F_COMMON_INTRO_SEEN 0x00                            // The opening main hall scene has played (106).
#define F_COMMON_HALL_EARLY_RETURN 0x01                     // Came back to the hall before seeing Kenneth's zombie: Wesker's reminder played (106), and the dining room only says there is more to investigate (105).
#define F_COMMON_KENNETH_ZOMBIE_SEEN 0x02                   // The zombie eating Kenneth has been seen (film in 104, or Barry shooting it at the 104 door in 105).
#define F_COMMON_WESKER_GONE_SEEN 0x03                      // The empty hall scene after the zombie: Wesker has gone missing (106).
#define F_COMMON_FRONT_DOOR_FILM_SEEN 0x04                  // The front door was tried once and its film played (106); later tries say it is too dangerous.
#define F_COMMON_J_BARRY_LOCKPICK_SCENE 0x05                // Barry's lockpick scene in the hall has started (106).
#define F_COMMON_J_BARRY_ACID_ROUNDS 0x07                   // Jill: Barry's acid rounds scene (106 or 203); also briefly set by 203 when Jill goes upstairs before the lockpick scene.
#define F_COMMON_C_RESEARCHER_WILL_TAKEN 0x07               // Chris: the Researcher's Will was taken (20A).
#define F_COMMON_J_RESEARCHER_WILL_TAKEN 0x08               // Jill: the Researcher's Will was taken (20A).
#define F_COMMON_C_HALL_RIBBON_TAKEN 0x08                   // Chris: the hall ink ribbon was taken; the spot is a typewriter (106).
#define F_COMMON_J_TANK_NEPTUNES_SHOWN 0x09                 // Jill: the Neptunes have shown up in the 40E tank (on reaching its south end, or by the film at the west doors).
#define F_COMMON_J_BARRY_FOREST_SCENE 0x0A                  // Likely: the terrace scene with Barry and Forest's body (212); blocks the hall acid rounds scene.
#define F_COMMON_J_HALL_RIBBON_GONE 0x0B                    // No ink ribbon in the hall: taken (106), or set at a first Jill new game.
#define F_COMMON_CEILING_TRAP_SPRUNG 0x20                   // The ceiling trap in 115 went off and the player got out: Chris ran, Jill was saved by Barry (109 then plays Barry's scenes); Chris clears it by putting a shotgun back on 116's rack. 303 also clears it, in dead code.
#define F_COMMON_J_BARRY_SANDWICH_TALK_DONE 0x21            // Jill: Barry's "Jill sandwich" talk in 109 has played, or 115 skipped it after an earlier Barry scene; 212 needs it clear.
#define F_COMMON_C_REBECCA_RADIO_CALL_DUE 0x21              // Chris: Rebecca's radio call is due: armed by the hunter film in 10A, played and cleared on the next room or 10A hunter kill.
#define F_COMMON_J_CARRIED_TO_SAVE_ROOM 0x22                // Jill: Barry carried the poisoned Jill to the save room (20E); 100 plays her waking and clears it. The engine reads it for the radio tab.
#define F_COMMON_C_REBECCA_IN_SAVE_ROOM 0x22                // Chris: Rebecca waits in the save room (100) instead of coming along; her radio calls (101, 109, 117, 119, 11A) need it. The engine reads it for the radio tab.
#define F_COMMON_J_RICHARD_NEEDS_SERUM 0x23                 // Jill: Richard needs the serum (20D); cleared when it is taken in 100. Drives the 1F map highlight (engine).
#define F_COMMON_C_REBECCA_101_ATTACK_OVER 0x23             // Chris: Likely: Rebecca's Hunter attack in 101 is over, or she was lost to it (307).
#define F_COMMON_J_JILL_NEEDS_SERUM 0x24                    // Jill: Jill was poisoned alone (20E) and needs the serum from 100.
#define F_COMMON_C_REBECCA_MET 0x24                         // Chris: Chris met Rebecca in the save room (100).
#define F_COMMON_J_BARRY_RESCUED_FROM_PIT 0x25              // Barry came back to 20C's pit with a rope and gave Jill the pass number (opens 201's keypad door).
#define F_COMMON_J_PIT_SCENE_STARTED 0x26                   // Jill: Jill looked into 20C's pit and Barry's rope scene began.
#define F_COMMON_C_YAWN_1_DEAD 0x26                         // Chris: Set in 210 once Yawn is dead; nothing in Chris's game reads it.
#define F_COMMON_J_BARRY_405_SCENE 0x27                     // Jill: Guess: Barry's guardhouse passage scene (405) has played; 40C then skips his Plant 42 talk.
#define F_COMMON_C_YAWN_WAKE_UP_DUE 0x27                    // Chris: the Yawn knocked Chris out (20E); he wakes in 100 to Rebecca's treatment scene.
#define F_COMMON_J_HUNTER_FILM_SEEN 0x28                    // Jill: the hunter film in the back passage (10A) has played.
#define F_COMMON_C_REBECCA_HEAL_COUNT_0 0x28                // Chris: bit 0 of how often Rebecca treated Chris in 100 (bit 1 is F_COMMON_C_REBECCA_HEAL_COUNT_1); at three she says it was the last dose.
#define F_COMMON_J_CEILING_TRAP_SPRUNG 0x29                 // Jill: Likely: the 115 ceiling trap was set off; cleared when a shotgun goes back on the 116 rack.
#define F_COMMON_C_REBECCA_HEAL_COUNT_1 0x29                // Chris: bit 1 of how often Rebecca treated Chris in 100.
#define F_COMMON_C_REBECCA_FIRST_HEAL_OFFER 0x2A            // Rebecca's first offer to treat Chris (100) has been armed; later visits get the shorter offer.
#define F_COMMON_C_HUNTER_FILM_SEEN 0x2B                    // The hunter film in the back passage (10A) has played.
#define F_COMMON_C_REBECCA_JUST_SPOKE 0x2C                  // Likely: Rebecca has just answered Chris (take-along question, or the second-mansion reunion); she repeats it until Chris reaches 103 or 201.
#define F_COMMON_C_RICHARD_NEEDS_SERUM 0x2D                 // Chris: Richard needs the serum (20D); cleared when it is taken in 100. Drives the 1F map highlight (engine).
#define F_COMMON_C_CHRIS_NEEDS_SERUM 0x2E                   // Chris: Chris was poisoned (20E) and needs the serum from 100 (map highlight, engine).
#define F_COMMON_C_REBECCA_UNDER_ATTACK 0x2F                // The hunter is attacking Rebecca in 101; leaving for 100, 102, 103 or 201 before killing it gets her killed.
#define F_COMMON_C_REBECCA_KILLED 0x30                      // The hunter killed Rebecca (Chris left 101 during the attack, or 307 found the call unanswered); 101 shows her body.
#define F_COMMON_C_REBECCA_SAVED_TALK 0x31                  // The hunter attacking Rebecca in 101 is dead; her thank-you talk there is pending.
#define F_COMMON_C_REBECCA_CALL_IN_TIME 0x32                // Chris reached 101 in time after Rebecca's radio call (W_04 180 or less); she is safe in 100.
#define F_COMMON_C_REBECCA_CALL_TOO_LATE 0x33               // Chris reached 101 too late after Rebecca's radio call (or 307 found it unanswered): the hunter attack plays.
#define F_COMMON_C_REBECCA_REUNION_DONE 0x34                // Rebecca's reunion talk in 100 (Chris came in time) has played.
#define F_COMMON_C_REBECCA_BODY_EXAMINED 0x35               // Chris examined Rebecca's body in 101 after killing the hunter.
#define F_COMMON_C_REBECCA_UPSTAIRS_CALL 0x36               // Likely: the radio call says Rebecca is upstairs (set in 10A after the Richard rooms 20D/20E); her 2F rescue (206, 307) follows.
#define F_COMMON_C_PLANT42_ROOM_ENTERED 0x37                // Chris: 40C has been entered once; its first entry starts the Plant 42 scene.
#define F_COMMON_PLANT42_OBJ 0x38                           // Plant 42 objective open: the guardhouse map highlight.
#define F_COMMON_C_REBECCA_ASK_PENDING 0x39                 // Chris has met Rebecca (100); she waits by the door until he answers whether to take her along.
#define F_COMMON_C_BACK_AT_GUARDHOUSE_GATE 0x3A             // Chris reached the guardhouse gate (304) in the stage variant; Rebecca no longer waits in the drug storehouse (409).
#define F_COMMON_C_REBECCA_STOREROOM_TALK 0x3B              // Chris: Rebecca's first talk and heal offer in the drug storeroom has played (409); later visits get the short offer.
#define F_COMMON_C_REBECCA_OFFERED_HELP 0x3C                // Rebecca already offered treatment on this visit to 100; cleared on entering 101.
#define F_COMMON_C_PLANT42_INTRO_SEEN 0x3D                  // Chris: the Plant 42 scene with Rebecca played (40C); 408 and 409 then place Rebecca.
#define F_COMMON_L_PASSAGE_WINDOW_1_BROKEN 0x40             // The first Cerberus has jumped in through the L passage's north window (108).
#define F_COMMON_L_PASSAGE_WINDOW_2_BROKEN 0x41             // The second Cerberus has jumped in through the L passage's east window (108).
#define F_COMMON_FOREST_FOUND 0x42                          // Forest's body on the terrace was found: Chris's crow attack or Jill's scene with Barry (212); 211 then calls the blood Forest's.
#define F_COMMON_YAWN_POISONED 0x43                         // Poisoned by the Yawn; cleared by the serum (engine).
#define F_COMMON_STUFFED_ROOM_LIGHTS_OFF 0x44               // The stuffed room's light switch is off: the cameras go dark and the red jewel glints in the deer head (215).
#define F_COMMON_HELIPORT_PASSAGE_TALK 0x45                 // The player's voice line on first entering 501's passage has played.
#define F_COMMON_ELEVATOR_BATTERY_SET 0x46                  // The battery is in 501's elevator socket; only Jill's script sets it.
#define F_COMMON_CAVE_BRIDGE_TURNED 0x47                    // The crank turned the bridge over the hole in the ladder passage (307); cranking again reopens the hole.
#define F_COMMON_ENRICO_SHOT 0x48                           // Enrico was shot (30A); the engine also reads it for 207's music.
