#define F_COMMON_500_501_LAMP_UNLOCKED 0x4A                 // The lamp at 500's door to 501 shows it unlocked (set once F_LOCK_500_501 is set).
#define F_COMMON_CELL_RESCUED 0x4B                          // Jill (Chris's game) or Chris (Jill's game) was freed from the cell (512); the ending takes them along (engine).
#define F_COMMON_TYRANT_PARTNER_SCENE_DONE 0x4C             // The partner's scene in 514 after the first Tyrant fight played (Chris: Rebecca gets up; Jill: Barry and the self-destruct).
#define F_COMMON_J_BARRY_SPLIT_AFTER_TYRANT 0x4D            // Jill: after the Tyrant, Barry rode up with Jill and left her at the elevator (50c); 515 stops spawning him.
#define F_COMMON_J_CAME_FROM_500 0x4E                       // Jill: Jill last came this way from 500 (set there late in the game, cleared in 503); 502's Chris then waits instead of walking in.
#define F_COMMON_J_BARRY_TERRACE_READY 0x4F                 // Guess: arms Barry's terrace event (212); set in 105 after the lockpick scene, and in 107 and 204.
#define F_COMMON_J_BACK_IN_308_AFTER_ENRICO 0x50            // Likely: Jill came back to 308 after Enrico's death; Barry no longer waits investigating in 30A.
#define F_COMMON_J_BEEN_TO_501 0x51                         // Jill: Jill has been to 501 (set there, cleared in 502); 500's Barry then waits instead of calling out.
#define F_COMMON_J_WAITED_FOR_BARRY 0x52                    // Jill chose to stay behind while Barry went on alone (308); he turns up again in 502.
#define F_COMMON_J_BARRY_FOLLOWS_FROM_30A 0x53              // Jill left 30A with Barry following: he enters 309 by the 30A door.
#define F_COMMON_J_BARRY_PHOTO_SCENE 0x54                   // Jill: Barry's scene with his family photo at the 502 ladder has played; nothing tests it.
#define F_COMMON_J_BARRY_DIED 0x55                          // Jill: Barry died in the caves (307); the engine also reads it for 207's music.
#define F_COMMON_J_POISON_COLLAPSE_DONE 0x56                // Jill: Jill's Yawn-poison collapse in front of the attic has played (20E).
