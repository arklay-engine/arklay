#define F_STATUS_PLAYER_DEAD 0x07                           // The player is dead or an ending fade runs (msf bit 24).
#define F_STATUS_PLAYER_JILL 0x08                           // The player is Jill: picks the room file variant (msf bit 23).
#define F_STATUS_VOICE_PLAYING 0x0E                         // A voice line is playing (msf bit 17).
#define F_STATUS_LETTERBOX 0x0F                             // Cutscene letterbox bars fade in while set (msf bit 16).
#define F_STATUS_SCRIPT_ONLY_11 0x11                        // Set by stage 3 scripts; outside the menu-mode ladder, no engine reader (msf bit 14).
#define F_STATUS_MENU_KEY_DEPLETED 0x12                     // Menu mode 1: the "you can drop it now" prompt after a key's last use (msf bit 13).
#define F_STATUS_MENU_MAP_ITEM 0x16                         // Menu mode 5: the map-item display (msf bit 9).
#define F_STATUS_DOOR_TRANSITION 0x18                       // A door transition is running (msf bit 7).
#define F_STATUS_OBJECT_PUSH 0x19                           // An object push is running (msf bit 6).
#define F_STATUS_CAMERA_REDRAW 0x1A                         // A deferred camera switch is waiting to redraw (msf bit 5).
#define F_STATUS_SCRIPT_ONLY_1C 0x1C                        // Set by many room inits; nothing in the engine reads it (msf bit 3).
#define F_STATUS_CAMERA_DEFER 0x1D                          // Camera switches wait for the script (F_STATUS_CAMERA_REDRAW) instead of redrawing (msf bit 2).
#define F_STATUS_MIRROR_ENABLE 0x1F                         // The mirror pass is on (msf bit 0).
#define F_STATUS_DEATH_VARIANT 0x20                         // Picks the death fade and whether dying offers continue (msf2 bit 31).
#define F_STATUS_COUNTDOWN_ACTIVE 0x24                      // The self-destruct countdown is running (msf2 bit 27).
#define F_STATUS_ROOM_SPRITES_OFF 0x26                      // Room sprites are not drawn (msf2 bit 25).
#define F_STATUS_DOOR_ANGLE_STEP 0x27                       // The door animation steps the player's facing (msf2 bit 24).
#define F_STATUS_FADE_NO_DEPTH_CLAMP 0x3C                   // The fade sprite skips its depth clamp (msf2 bit 3).
#define F_STATUS_SCREEN_BORDER 0x3D                         // Backgrounds load 316x236 with a border (msf2 bit 2).
#define F_STATUS_SCREEN_SHAKE 0x3E                          // The screen shakes (msf2 bit 1).
#define F_STATUS_40 0x40                                    // Past the 64-bit status bank: the byte after it.

// FG_RUN gates which systems run each frame (the reference's
// g_message_flags; a message's pause word clears the same bits as RUN_*):
// bit 0x10+n is mask 0x8000 >> n, and 0x00-0x0F the adjacent backup word.
#define F_RUN_00 0x00
#define F_RUN_CONTROLS 0x17
#define F_RUN_0080 0x18                                     // The run word's 0x0080 bit (RUN_0080 in messages); not traced.
#define F_RUN_READY 0x19
#define F_RUN_0020 0x1A                                     // The run word's 0x0020 bit (RUN_0020 in messages); not traced.
#define F_RUN_0010 0x1B                                     // The run word's 0x0010 bit (RUN_0010 in messages); not traced.
#define F_RUN_EFFECTS 0x1C
#define F_RUN_MONSTERS 0x1D
#define F_RUN_ENTITIES 0x1E
#define F_RUN_PLAYER 0x1F

