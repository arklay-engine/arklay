// Rooms as door targets. A door names a room of its own stage alone and
// any other stage's room as `STAGE_n | ROOM_n..`.
// ROOM_<stage><room>_<name>; ids never change.

#define STAGE_1 0x20
#define STAGE_2 0x40
#define STAGE_3 0x60
#define STAGE_4 0x80
#define STAGE_5 0xA0
#define STAGE_6 0xC0
#define STAGE_7 0xE0

